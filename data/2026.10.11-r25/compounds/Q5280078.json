{"version":"2026.10.11-r25","id":"Q5280078","formula":"C₁₂H₁₄N₂O₃","hill":"C12H14N2O3","elements":["H","C","N","O"],"composition":{"C":12.0,"H":14.0,"N":2.0,"O":3.0},"names":{"en":"Diproqualone"},"descriptions":{"en":"Diproqualone is a quinazolinone class GABAergic and is an analogue of methaqualone developed in the late 1950s by a team at Nogentaise de Produits Chimique. It was marketed primarily in France and some other European countries. It has sedative, anxiolytic, antihistamine and analgesic properties, resulting from its agonist activity at the β subtype of the GABAa receptor, antagonist activity at all histamine receptors, inhibition of the cyclooxygenase-1 enzyme, and possibly its agonist activity at both the sigma-1 receptor and sigma-2 receptor (the function of these receptors and their clinical relevance has not yet been determined)."},"fame":7,"pubchemCid":64112,"mass":234.25,"charge":0,"smiles":"CC1=NC2=CC=CC=C2C(=O)N1CC(CO)O","inchikey":"NTGLQWGMESPVBV-UHFFFAOYSA-N","iupac":"3-(2,3-dihydroxypropyl)-2-methylquinazolin-4-one","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"64112","atoms":31,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-2.448,"y":1.298,"z":-0.86,"el":"O"},{"x":-5.102,"y":0.589,"z":-1.063,"el":"O"},{"x":-0.171,"y":1.894,"z":0.905,"el":"O"},{"x":-0.619,"y":-0.38,"z":0.572,"el":"N"},{"x":1.117,"y":-1.83,"z":-0.161,"el":"N"},{"x":-2.019,"y":-0.229,"z":0.965,"el":"C"},{"x":-2.902,"y":0.095,"z":-0.24,"el":"C"},{"x":-0.111,"y":-1.622,"z":0.198,"el":"C"},{"x":0.192,"y":0.765,"z":0.587,"el":"C"},{"x":1.597,"y":0.547,"z":0.18,"el":"C"},{"x":1.999,"y":-0.742,"z":-0.176,"el":"C"},{"x":-4.375,"y":0.265,"z":0.118,"el":"C"},{"x":-1.049,"y":-2.807,"z":0.209,"el":"C"},{"x":2.503,"y":1.614,"z":0.153,"el":"C"},{"x":3.328,"y":-0.953,"z":-0.562,"el":"C"},{"x":3.824,"y":1.388
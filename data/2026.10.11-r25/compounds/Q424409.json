{"version":"2026.10.11-r25","id":"Q424409","formula":"CH₄NO₅P","hill":"CH4NO5P","elements":["H","C","N","O","P"],"composition":{"C":1.0,"H":4.0,"N":1.0,"O":5.0,"P":1.0},"names":{"en":"Carbamoyl phosphate"},"descriptions":{"en":"Carbamoyl phosphate is a biologically important anion. In terrestrial animals, carbamoyl phosphate serves as a metabolic intermediate in both nitrogen disposal through the urea cycle and pyrimidine synthesis. Its enzymatic counterpart, carbamoyl phosphate synthetase I (CPS I), interacts with a class of molecules called sirtuins, NAD dependent protein deacetylases, and ATP to form carbamoyl phosphate."},"fame":26,"pubchemCid":278,"mass":141.02,"charge":0,"smiles":"C(=O)(N)OP(=O)(O)O","inchikey":"FFQKYPRQEYGKAF-UHFFFAOYSA-N","iupac":"phosphono carbamate","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"278","atoms":12,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-1.145,"y":0.01,"z":-0.081,"el":"P"},{"x":0.317,"y":-0.683,"z":-0.108,"el":"O"},{"x":-2.148,"y":-1.258,"z":-0.063,"el":"O"},{"x":-1.261,"y":0.599,"z":1.421,"el":"O"},{"x":-1.393,"y":1.0,"z":-1.181,"el":"O"},{"x":1.581,"y":1.21,"z":0.097,"el":"O"},{"x":2.557,"y":-0.871,"z":-0.069,"el":"N"},{"x":1.493,"y":-0.007,"z":-0.017,"el":"C"},{"x":-3.113,"y":-1.101,"z":-0.138,"el":"H"},{"x":-2.046,"y":1.137,"z":1.66,"el":"H"},{"x":3.513,"y":-0.536,"z":-0.015,"el":"H"},{"x":2.421,"y":-1.872,"z":-0.164,"el":"H"}],"bonds":[[0,1,1],[0,2,1],[0,3,1],[0,4,2],[1,7,1],[2,8,1],[3,9,1],[5,7,2],[6,7,1],[6,10,1],[6,11,1]]},"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q424409","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Carbamoyl_phosphate","license":"CC BY-SA 4.0"},{"role":"properties","name":"PubChem","url":"https://pubchem.ncbi.
{"version":"2026.10.11-r25","id":"Q130467159","formula":"C₁₆H₁₅ClN₄O₂","hill":"C16H15ClN4O2","elements":["H","C","N","O","Cl"],"composition":{"C":16.0,"H":15.0,"N":4.0,"O":2.0,"Cl":1.0},"names":{"en":"3-chlorostyrylcaffeine"},"descriptions":{"en":"3-Chlorostyrylcaffeine (CSC), or 8-(3-chlorostyryl)caffeine (8-CSC), is a potent and selective adenosine A2A receptor antagonist which is used in scientific research. It has 520-fold selectivity for the adenosine A2A receptor over the adenosine A1 receptor (Ki = 54 nM and 28,000 nM for the rat receptors, respectively). Its affinities for the adenosine A2B and A3 receptors are similarly low (Ki = 8,200 nM and >10,000 nM, respectively)."},"fame":1,"pubchemCid":129730232,"mass":330.77,"charge":0,"smiles":"CN1C=NC2=C1C(=O)N(C(=O)N2C)CC=CC3=CC(=CC=C3)Cl","inchikey":"VYLMWABBINHTEH-UHFFFAOYSA-N","iupac":"1-[3-(3-chlorophenyl)prop-2-enyl]-3,7-dimethylpurine-2,6-dione","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"rdkit","ref":"129730232","atoms":38,"license":"Computed with RDKit from SMILES (PubChem, Wikidata)"},"structure":{"kind":"molecule","atoms":[{"x":-2.122,"y":3.027,"z":-1.354,"el":"C"},{"x":-2.781,"y":1.766,"z":-1.122,"el":"N"},{"x":-4.129,"y":1.532,"z":-1.194,"el":"C"},{"x":-4.418,"y":0.274,"z":-0.927,"el":"N"},{"x":-3.211,"y":-0.306,"z":-0.679,"el":"C"},{"x":-2.187,"y":0.583,"z":-0.791,"el":"C"},{"x":-0.826,"y":0.233,"z":-0.584,"el":"C"},{"x":0.087,"y":1.044,"z":-0.708,"el":"O"},{"x":-0.655,"y":-1.113,"z":-0.241,"el":"N"},{"x":-1.69,"y":-2.064,"z":-0.121,"el":"C"},{"x":-1.451,"y":-3.236,"z":0.183,"el":"O"},{"x":-2.994,"y":-1.623,"z":-0.354,"el":"N"},{"x":-4.116,"y":-2.537,"z":-0.245,"el":"C"},{"x":0.705,"y":-1.571,"z":0.001,"el":"C"},{"x":0.998,"y":-1.498,"z":1.478,"el":"C"},{"x":2.01,"y":-0.854,"z":2.083,"el":"C"},{"x":3.044,"y":-0.087,"z":1.39,"el":"C"},{"x":2.823,"y":1.248,"z":1.041,"el
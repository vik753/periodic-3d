{"version":"2026.10.11-r25","id":"Q3640516","formula":"LiCaAl₂(AlBeSi₂O₁₀)(OH)₂","hill":"Al3BeCaH2LiO12Si2","elements":["H","Li","Be","O","Al","Si","Ca"],"composition":{"H":2.0,"O":12.0,"Al":3.0,"Be":1.0,"Ca":1.0,"Li":1.0,"Si":2.0},"names":{"en":"Bityite"},"descriptions":{"en":"Bityite is considered a rare mineral, and it is an endmember to the margarite mica sub-group found within the phyllosilicate group. The mineral was first described by Antoine François Alfred Lacroix in 1908, and later its chemical composition was concluded by Professor Hugo Strunz. Bityite has a close association with beryl, and it generally crystallizes in pseudomorphs after it, or in cavities associated with reformed beryl crystals."},"fame":7,"pubchemCid":null,"mass":null,"charge":0,"smiles":null,"inchikey":null,"iupac":null,"classes":[{"qid":"Q12089225","names":{"en":"mineral species","ru":"действительный вид минералов","uk":"мінеральний вид"}}],"structureInfo":null,"structure":null,"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q3640516","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Bityite","license":"CC BY-SA 4.0"}],"similar":[{"id":"Q3726806","formula":"LiNaAl₂(Al₂Si₂O₁₀)(OH)₂","names":{"en":"Ephesite"},"elements":["H","Li","O","Na","Al","Si"],"fame":5,"kind":null},{"id":"Q3680824","formula":"CaAlMg₂(SiAl₃)O₁₀(OH)₂","names":{"en":"Clintonite"},"elements":["H","O","Mg","Al","Si","Ca"],"fame":9,"kind":null},{"id":"Q424245","formula":"BeAlSiO₄(OH)","names":{"en":"Euclase","ru":"Эвклаз","uk":"Евклаз"},"elements":["H","Be","O","Al","Si"],"fame":26,"kind":"crystal"},{"id":"Q2481488","formula":"CaAl₂(Si₂Al₂)O₁₀(OH)₂","names":{"en":"Margarite","ru":"Маргарит","uk":"Маргарит"},"elements":["H","O","Al","Si","Ca"],"fame":16,"kind":"crystal"},{"id":"Q2482759","formula":"NaMg₃Al₆(Si₆O₁₈)(BO₃)₃(OH)₃OH","names":{"en":"Dravite","uk":"Дравіт"},"elements":["H","B","O","Na","Mg","Al","Si"],"fame":16,"kind":nu
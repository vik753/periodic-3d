{"version":"2026.10.11-r25","id":"Q19861028","formula":"Ni(UO₂)₂(AsO₄)₂·8H₂O","hill":"As2H16NiO20U2","elements":["H","O","Ni","As","U"],"composition":{"H":16.0,"O":20.0,"U":2.0,"As":2.0,"Ni":1.0},"names":{"en":"Metarauchite"},"descriptions":{"en":"Metarauchite is a member of the autunite group, found at the Jáchymov ore district (type locality), Czech Republic and in Schneeberg, Germany. The autunite group is a group of structured uranyl phosphates and arsenates; the other members of the group are autunite, bassetite, heinrichite, kahlerite, nováčekite-I, nováčekite-II, rauchite, sabugalite, saléeite, torbernite, uranocircite, uranospinite, and zeunerite. The mineral is named after Czech mineral collector Luděk Rauch, who died in the Jáchymov mines during mineral prospecting."},"fame":6,"pubchemCid":null,"mass":null,"charge":0,"smiles":null,"inchikey":null,"iupac":null,"classes":[{"qid":"Q12089225","names":{"en":"mineral species","ru":"действительный вид минералов","uk":"мінеральний вид"}}],"structureInfo":null,"structure":null,"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q19861028","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Metarauchite","license":"CC BY-SA 4.0"},{"role":"photo","name":"Wikimedia Commons","url":"https://commons.wikimedia.org/wiki/File:Metarauchit-345903.jpg","license":"CC BY-SA 3.0"}],"similar":[{"id":"Q1067068","formula":"Cu(UO₂)₂(AsO₄)₂·8H₂O","names":{"en":"Metazeunerite","uk":"Метацейнерит"},"elements":["H","O","Cu","As","U"],"fame":9,"kind":"crystal"},{"id":"Q946311","formula":"Cu(UO₂)₂(PO₄)₂·8H₂O","names":{"en":"Metatorbernite","uk":"Метаторберніт"},"elements":["H","O","P","Cu","U"],"fame":12,"kind":"crystal"},{"id":"Q419960","formula":"Fe₂(PO₄)(SO₄)(OH)·6H₂O","names":{"en":"Diadochite","ru":"Диадохит"},"elements":["H","O","P","S","Fe"],"fame":11,"kind":null},{"id":"Q429570","formula":"Ba(UO₂)₂(AsO₄)₂·10H₂O","names":{"en":"Heinrichite","uk":"Ге
{"version":"2026.10.11-r25","id":"Q19903610","formula":"CHBrClF","hill":"CHBrClF","elements":["H","C","F","Cl","Br"],"composition":{"C":1.0,"F":1.0,"H":1.0,"Br":1.0,"Cl":1.0},"names":{"en":"Bromochlorofluoromethane"},"descriptions":{"en":"Bromochlorofluoromethane or fluorochlorobromomethane, is a chemical compound and trihalomethane derivative with the chemical formula CHBrClF. As one of the simplest possible stable chiral compounds, it is useful for fundamental research into this area of chemistry. However, its relative instability to hydrolysis, and lack of suitable functional groups, made separation of the enantiomers of bromochlorofluoromethane especially challenging, and this was not accomplished until almost a century after it was first synthesised, in March 2005, though it has now been done by a variety of methods."},"fame":7,"pubchemCid":79058,"mass":147.37,"charge":0,"smiles":"C(F)(Cl)Br","inchikey":"YNKZSBSRKWVMEZ-UHFFFAOYSA-N","iupac":"bromo-chloro-fluoromethane","classes":[{"qid":"Q59199015","names":{"en":"group of stereoisomers","ru":"группа стереоизомеров","uk":"група стереоізомерів"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"79058","atoms":5,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-1.666,"y":-0.556,"z":0.106,"el":"Br"},{"x":1.344,"y":-0.956,"z":0.12,"el":"Cl"},{"x":0.255,"y":1.366,"z":0.169,"el":"F"},{"x":0.068,"y":0.146,"z":-0.395,"el":"C"},{"x":0.086,"y":0.251,"z":-1.483,"el":"H"}],"bonds":[[0,3,1],[1,3,1],[2,3,1],[3,4,1]]},"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q19903610","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Bromochlorofluoromethane","license":"CC BY-SA 4.0"},{"role":"properties","name":"PubChem","url":"https://pubchem.ncbi.nlm.nih.gov/compound/79058","license":"PubChem (NIH), public data"},{"role":"structure","name":"PubChem 3D","url":"https://pubchem.ncbi.nlm.nih.gov/com
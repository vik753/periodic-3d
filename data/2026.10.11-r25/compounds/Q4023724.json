{"version":"2026.10.11-r25","id":"Q4023724","formula":"Al₁₂(SO₄)₅(OH)₂₆·20H₂O","hill":"Al12H66O66S5","elements":["H","O","Al","S"],"composition":{"H":66.0,"O":66.0,"S":5.0,"Al":12.0},"names":{"en":"Zaherite"},"descriptions":{"en":"Zaherite is a mineral, a complex sulfate of aluminium, formula Al12(OH)26(SO4)5·20H2O. It was discovered in the Salt range, Punjab, Pakistan by M. A. Zaher of the Bangladesh Geological Survey after whom it is named in 1977. This mineral would be extremely soluble in water and unlikely to persist anywhere except in the most arid of environments. It spontaneously, and reversibly dehydrates around room temperature."},"fame":10,"pubchemCid":null,"mass":null,"charge":0,"smiles":null,"inchikey":null,"iupac":null,"classes":[{"qid":"Q12089225","names":{"en":"mineral species","ru":"действительный вид минералов","uk":"мінеральний вид"}}],"structureInfo":null,"structure":null,"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q4023724","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Zaherite","license":"CC BY-SA 4.0"},{"role":"photo","name":"Wikimedia Commons","url":"https://commons.wikimedia.org/wiki/File:Zaherite.jpg","license":"CC BY-SA 4.0"}],"similar":[{"id":"Q3742338","formula":"Al₄(SO₄)(OH)₁₀·4H₂O","names":{"en":"Felsőbányaite","uk":"Фельшебаніїт"},"elements":["H","O","Al","S"],"fame":8,"kind":null},{"id":"Q19862339","formula":"Al₆(AsO₄)₃(OH)₉·16H₂O","names":{"en":"Bettertonite"},"elements":["H","O","Al","As"],"fame":4,"kind":null},{"id":"Q409918","formula":"Cu(UO₂)₂(PO₄)₂·12H₂O","names":{"en":"Torbernite","ru":"Торбернит","uk":"Торберніт"},"elements":["H","O","P","Cu","U"],"fame":30,"kind":"crystal"},{"id":"Q183103","formula":"[(UO₂)(O₂)(H₂O)₂]*H₂O","names":{"en":"Studtite"},"elements":["H","O","U"],"fame":13,"kind":null},{"id":"Q422895","formula":"Ba(UO₂)₂(PO₄)₂·10H₂O","names":{"en":"Uranocircite","ru":"Ураноцирцит","uk":"Ураноцирцит-II"},"elements":["H
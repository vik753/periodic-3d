{"version":"2026.10.11-r25","id":"Q481822","formula":"C₂H₅NO₂","hill":"C2H5NO2","elements":["H","C","N","O"],"composition":{"C":2.0,"H":5.0,"N":1.0,"O":2.0},"names":{"en":"Acetohydroxamic acid"},"descriptions":{"en":"Acetohydroxamic acid (also known as AHA or by the trade name Lithostat) is a drug that is a potent and irreversible enzyme inhibitor of the urease enzyme in various bacteria and plants; it is usually used for urinary tract infections and urinary stone disease. The molecule is similar to urea but is not hydrolyzable by urease; it thus disrupts the bacteria's metabolism through competitive inhibition. It is particularly effective for the prevention and treatment of infection stones (struvite stones)."},"fame":13,"pubchemCid":1990,"mass":75.07,"charge":0,"smiles":"CC(=O)NO","inchikey":"RRUDCFGSUDOHDG-UHFFFAOYSA-N","iupac":"N-hydroxyacetamide","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"1990","atoms":10,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":1.909,"y":-0.043,"z":0.003,"el":"O"},{"x":-0.424,"y":1.328,"z":0.0,"el":"O"},{"x":0.674,"y":-0.707,"z":-0.003,"el":"N"},{"x":-0.434,"y":0.098,"z":-0.004,"el":"C"},{"x":-1.725,"y":-0.676,"z":0.003,"el":"C"},{"x":-2.154,"y":-0.645,"z":1.008,"el":"H"},{"x":-2.421,"y":-0.219,"z":-0.706,"el":"H"},{"x":-1.572,"y":-1.719,"z":-0.287,"el":"H"},{"x":0.688,"y":-1.717,"z":0.084,"el":"H"},{"x":2.423,"y":-0.637,"z":0.577,"el":"H"}],"bonds":[[0,2,1],[0,9,1],[1,3,2],[2,3,1],[2,8,1],[3,4,1],[4,5,1],[4,6,1],[4,7,1]]},"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q481822","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Acetohydroxamic_acid","license":"CC BY-SA 4.0"},{"role":"properties","name":"PubChem","url":"https://pubchem.ncbi.nlm.nih.gov/compound/
{"version":"2026.10.11-r25","id":"Q4652499","formula":"C₂₃H₂₅IN₂O₃","hill":"C23H25IN2O3","elements":["H","C","N","O","I"],"composition":{"C":23.0,"H":25.0,"I":1.0,"N":2.0,"O":3.0},"names":{"en":"6-iodopravadoline"},"descriptions":{"en":"AM-630 (6-Iodopravadoline) is a drug that acts as a potent and selective inverse agonist for the cannabinoid receptor CB2, with a Ki of 32.1 nM at CB2 and 165x selectivity over CB1, at which it acted as a weak partial agonist. It is used in the study of CB2 mediated responses and has been used to investigate the possible role of CB2 receptors in the brain. AM-630 is significant as one of the first indole derived cannabinoid ligands substituted on the 6-position of the indole ring, a position that has subsequently been found to be important in determining affinity and efficacy at both the CB1 and CB2 receptors, and has led to the development of many related derivatives."},"fame":4,"pubchemCid":4302963,"mass":504.4,"charge":0,"smiles":"CC1=C(C2=C(N1CCN3CCOCC3)C=C(C=C2)I)C(=O)C4=CC=C(C=C4)OC","inchikey":"JHOTYHDSLIUKCJ-UHFFFAOYSA-N","iupac":"[6-iodo-2-methyl-1-(2-morpholin-4-ylethyl)indol-3-yl]-(4-methoxyphenyl)methanone","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"4302963","atoms":54,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":2.439,"y":-4.971,"z":-2.081,"el":"I"},{"x":6.791,"y":2.251,"z":-0.737,"el":"O"},{"x":-2.879,"y":-1.045,"z":2.511,"el":"O"},{"x":-5.844,"y":2.322,"z":-1.833,"el":"O"},{"x":4.136,"y":1.675,"z":0.111,"el":"N"},{"x":1.176,"y":-0.484,"z":0.913,"el":"N"},{"x":2.814,"y":1.082,"z":-0.082,"el":"C"},{"x":2.501,"y":0.112,"z":1.054,"el":"C"},{"x":5.179,"y":0.64,"z":0.095,"el":"C"},{"x":4.411,"y":2.683,"z":-0.923,"el":"C"},{"x":0.917,"y":-1.648,"z":0.239,"el":"C"},{"x":0.033,"y":0.04,"z":1.437,"el":"C"},{"x":-0.457,"y":-1.874,"z":0.339,"
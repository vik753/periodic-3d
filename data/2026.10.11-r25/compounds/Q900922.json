{"version":"2026.10.11-r25","id":"Q900922","formula":"C₁₆H₂₅NO₂","hill":"C16H25NO2","elements":["H","C","N","O"],"composition":{"C":16.0,"H":25.0,"N":1.0,"O":2.0},"names":{"en":"Hydroxy alpha sanshool"},"descriptions":{"en":"Hydroxy-α-sanshool (), also known as simply sanshool is a molecule found in plants from the genus Zanthoxylum. It is believed to be responsible for the numbing and tingling sensation caused by eating food cooked with Sichuan peppercorns and Uzazi. The term sanshool in the compound's name is derived from the Japanese term for the Japanese pepper, sanshō (山椒) (lit. 'mountain pepper'), to which was appended the suffix -ol, indicating an alcohol."},"fame":12,"pubchemCid":10084135,"mass":263.37,"charge":0,"smiles":"C/C=C/C=C/C=C\\CC/C=C/C(=O)NCC(C)(C)O","inchikey":"LHFKHAVGGJJQFF-UEOYEZOQSA-N","iupac":"(2E,6Z,8E,10E)-N-(2-hydroxy-2-methylpropyl)dodeca-2,6,8,10-tetraenamide","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"10084135","atoms":44,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":4.563,"y":-0.498,"z":1.356,"el":"O"},{"x":3.28,"y":1.774,"z":-0.212,"el":"O"},{"x":3.126,"y":-0.337,"z":-1.166,"el":"N"},{"x":4.877,"y":-1.369,"z":0.267,"el":"C"},{"x":4.527,"y":-0.671,"z":-1.055,"el":"C"},{"x":4.086,"y":-2.664,"z":0.464,"el":"C"},{"x":6.378,"y":-1.664,"z":0.32,"el":"C"},{"x":2.623,"y":0.876,"z":-0.726,"el":"C"},{"x":-0.986,"y":2.269,"z":-0.782,"el":"C"},{"x":1.155,"y":0.982,"z":-0.952,"el":"C"},{"x":-1.736,"y":2.521,"z":0.531,"el":"C"},{"x":0.494,"y":2.087,"z":-0.583,"el":"C"},{"x":-1.633,"y":1.371,"z":1.494,"el":"C"},{"x":-2.506,"y":0.352,"z":1.531,"el":"C"},{"x":-3.642,"y":0.258,"z":0.64,"el":"C"},{"x":-4.568,"y":-0.713,"z":0.596,"el":"C"},{"x":-5.705,"y":-0.807,"z":-0.296,"el":"C"},{"x":-6.577,"y":-1.826,"z":-0.259,"el":"C"},{"x":-7.755,"y":-1.942,"z":-1.169,"el":"
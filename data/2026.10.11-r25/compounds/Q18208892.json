{"version":"2026.10.11-r25","id":"Q18208892","formula":"C₂₀H₂₈N₄O₂","hill":"C20H28N4O2","elements":["H","C","N","O"],"composition":{"C":20.0,"H":28.0,"N":4.0,"O":2.0},"names":{"en":"AB-CHMINACA"},"descriptions":{"en":"AB-CHMINACA is an indazole-based synthetic cannabinoid. It is a potent agonist of the CB1 receptor (Ki = 0.78 nM) and CB2 receptor (Ki = 0.45 nM) and fully substitutes for Δ9-THC in rat discrimination studies, while being 16x more potent. Continuing the trend seen in other cannabinoids of this generation, such as AB-FUBINACA and AB-PINACA, it contains a valine amino acid amide residue as part of its structure, where older cannabinoids contained a naphthyl or adamantane residue."},"fame":2,"pubchemCid":44206133,"mass":356.5,"charge":0,"smiles":"CC(C)[C@@H](C(=O)N)NC(=O)C1=NN(C2=CC=CC=C21)CC3CCCCC3","inchikey":"KJNZIEGLNLCWTQ-KRWDZBQOSA-N","iupac":"N-[(2S)-1-amino-3-methyl-1-oxobutan-2-yl]-1-(cyclohexylmethyl)indazole-3-carboxamide","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"44206133","atoms":54,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-2.519,"y":-1.729,"z":0.969,"el":"O"},{"x":-4.427,"y":0.187,"z":-1.912,"el":"O"},{"x":1.374,"y":-0.492,"z":-0.774,"el":"N"},{"x":0.139,"y":0.006,"z":-0.591,"el":"N"},{"x":-2.498,"y":0.408,"z":0.07,"el":"N"},{"x":-5.981,"y":-0.239,"z":-0.276,"el":"N"},{"x":3.407,"y":0.937,"z":-0.436,"el":"C"},{"x":4.684,"y":1.412,"z":-1.143,"el":"C"},{"x":2.766,"y":2.08,"z":0.362,"el":"C"},{"x":5.67,"y":2.041,"z":-0.161,"el":"C"},{"x":3.756,"y":2.708,"z":1.341,"el":"C"},{"x":5.027,"y":3.171,"z":0.636,"el":"C"},{"x":2.415,"y":0.361,"z":-1.445,"el":"C"},{"x":1.539,"y":-1.768,"z":-0.307,"el":"C"},{"x":0.306,"y":-2.126,"z":0.224,"el":"C"},{"x":-0.507,"y":-0.991,"z":0.017,"el":"C"},{"x":2.646,"y":-2.62,"z":-0.307,"el":"C"},{"x":-3.868,"y":0.739,"z":0.39
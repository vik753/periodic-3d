{"version":"2026.10.11-r25","id":"Q14664566","formula":"C₁₁H₁₆N₂O","hill":"C11H16N2O","elements":["H","C","N","O"],"composition":{"C":11.0,"H":16.0,"N":2.0,"O":1.0},"names":{"en":"Pozanicline"},"descriptions":{"en":"Pozanicline (INN, codenamed ABT-089) is a drug developed by Abbott, that has nootropic and neuroprotective effects. Animal studies suggested it useful for the treatment of ADHD and subsequent human trials have shown ABT-089 to be effective for this application. It binds with high affinity subtype-selective to the α4β2 nicotinic acetylcholine receptors and has partial agonism to the α6β2 subtype, but not the α7 and α3β4 subtypes familiar to nicotine."},"fame":7,"pubchemCid":178052,"mass":192.26,"charge":0,"smiles":"CC1=C(C=CC=N1)OC[C@@H]2CCCN2","inchikey":"YRVIKLBSVVNSHF-JTQLQIEISA-N","iupac":"2-methyl-3-[[(2S)-pyrrolidin-2-yl]methoxy]pyridine","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"178052","atoms":30,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-0.061,"y":0.093,"z":0.954,"el":"O"},{"x":3.426,"y":-1.022,"z":0.363,"el":"N"},{"x":-3.364,"y":0.772,"z":-0.45,"el":"N"},{"x":2.303,"y":-0.123,"z":0.669,"el":"C"},{"x":2.385,"y":1.024,"z":-0.337,"el":"C"},{"x":3.821,"y":0.975,"z":-0.814,"el":"C"},{"x":4.101,"y":-0.513,"z":-0.832,"el":"C"},{"x":0.96,"y":-0.838,"z":0.635,"el":"C"},{"x":-1.294,"y":-0.119,"z":0.391,"el":"C"},{"x":-2.141,"y":0.93,"z":0.104,"el":"C"},{"x":-1.704,"y":-1.408,"z":0.103,"el":"C"},{"x":-1.736,"y":2.336,"z":0.402,"el":"C"},{"x":-2.956,"y":-1.611,"z":-0.467,"el":"C"},{"x":-3.741,"y":-0.498,"z":-0.721,"el":"C"},{"x":2.463,"y":0.289,"z":1.674,"el":"H"},{"x":2.138,"y":1.991,"z":0.112,"el":"H"},{"x":1.712,"y":0.861,"z":-1.188,"el":"H"},{"x":3.951,"y":1.439,"z":-1.795,"el":"H"},{"x":4.478,"y":1.484,"z":-0.098,"el":"H"},{"x":3.668,"y":-0.972,"z":-1.728,"el"
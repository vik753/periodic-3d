{"version":"2026.10.11-r25","id":"Q413024","formula":"Cu₉Fe₈S₁₆","hill":"Cu9Fe8S16","elements":["S","Fe","Cu"],"composition":{"S":16.0,"Cu":9.0,"Fe":8.0},"names":{"en":"Talnakhite","ru":"Талнахит"},"descriptions":{"en":"Talnakhite is a mineral of chalcopyrite group with formula: Cu9(Fe, Ni)8S16. It was named after the Talnakh ore deposit, near Norilsk in Western Siberia, Russia where it was discovered as reported in 1963 by I. Budko and E. Kulagov. It was officially named \"talnakhite\" in 1968.","ru":"Талнахи́т — минерал, принадлежащий группе халькопиритов. Он был назван в честь российского города Талнах около Норильска (ныне Талнах — это один из районов Норильска) в Восточной Сибири, где геологи Будко И. А. и Кулагов Э. А. обнаружили этот минерал в виде рудного депозита в 1963 году. Официальное название Талнахит было присвоено в 1968 году."},"fame":11,"pubchemCid":null,"mass":null,"charge":0,"smiles":null,"inchikey":null,"iupac":null,"classes":[{"qid":"Q12089225","names":{"en":"mineral species","ru":"действительный вид минералов","uk":"мінеральний вид"}}],"structureInfo":null,"structure":null,"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q413024","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Talnakhite","license":"CC BY-SA 4.0"},{"role":"description","name":"Wikipedia (ru)","url":"https://ru.wikipedia.org/wiki/%D0%A2%D0%B0%D0%BB%D0%BD%D0%B0%D1%85%D0%B8%D1%82","license":"CC BY-SA 4.0"},{"role":"photo","name":"Wikimedia Commons","url":"https://commons.wikimedia.org/wiki/File:Putoranite,_Talnakhite_-_Mineralogisches_Museum_Bonn3.jpg","license":"CC BY-SA 3.0"}],"similar":[{"id":"Q111044","formula":"CuFeS₂","names":{"en":"Chalcopyrite","ru":"Халькопирит","uk":"Халькопірит"},"elements":["S","Fe","Cu"],"fame":61,"kind":"crystal"},{"id":"Q414879","formula":"Cu₉Fe₉S₁₆","names":{"en":"Mooihoekite","uk":"Моїхукіт"},"elements":["S","Fe","Cu"],"fame":7,"kind":"crystal"},{"id":"Q182
{"version":"2026.10.11-r25","id":"Q76621035","formula":"C₃₁H₃₈N₂O₁₁","hill":"C31H38N2O11","elements":["H","C","N","O"],"composition":{"C":31.0,"H":38.0,"N":2.0,"O":11.0},"names":{"en":"Fenpicoxamid"},"descriptions":{"en":"Fenpicoxamid is a picolinamide fungicide used to control fungal pathogens in cereal crops, particularly Zymoseptoria tritici in wheat. It is derived from a naturally occurring substance called UK-2A produced by a Streptomyces bacteria and is structurally related to the piscicide antimycin A. When absorbed by fungi or plants it is converted to UK-2A. It was authorised for use in the United Kingdom in 2021 and by 2022 was used on 670,000 hectares."},"fame":3,"pubchemCid":51039126,"mass":614.6,"charge":0,"smiles":"C[C@H]1[C@@H]([C@H](C(=O)OC[C@@H](C(=O)O1)NC(=O)C2=NC=CC(=C2OCOC(=O)C(C)C)OC)CC3=CC=CC=C3)OC(=O)C(C)C","inchikey":"QGTOTYJSCYHYFK-RBODFLQRSA-N","iupac":"[2-[[(3S,7R,8R,9S)-7-benzyl-9-methyl-8-(2-methylpropanoyloxy)-2,6-dioxo-1,5-dioxonan-3-yl]carbamoyl]-4-methoxy-3-pyridinyl]oxymethyl 2-methylpropanoate","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"51039126","atoms":82,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-4.522,"y":-1.619,"z":-0.722,"el":"O"},{"x":-0.936,"y":-1.042,"z":-0.369,"el":"O"},{"x":-1.574,"y":1.735,"z":-0.351,"el":"O"},{"x":-1.956,"y":1.004,"z":1.804,"el":"O"},{"x":0.134,"y":-0.387,"z":-2.311,"el":"O"},{"x":-4.87,"y":-2.882,"z":1.176,"el":"O"},{"x":2.916,"y":1.235,"z":1.479,"el":"O"},{"x":5.499,"y":0.517,"z":1.553,"el":"O"},{"x":7.915,"y":0.991,"z":0.263,"el":"O"},{"x":4.29,"y":-1.448,"z":0.988,"el":"O"},{"x":4.969,"y":-3.599,"z":1.47,"el":"O"},{"x":1.985,"y":0.882,"z":-0.615,"el":"N"},{"x":4.319,"y":1.911,"z":-1.608,"el":"N"},{"x":-3.521,"y":0.468,"z":0.015,"el":"C"},{"x":-3.34,"y":-1.067,"z":-0.141,"el":"C"},{"x":-2.139,"y":-1.477,"z":
{"version":"2026.10.11-r25","id":"Q15409403","formula":"C₁₃H₁₈ClNO","hill":"C13H18ClNO","elements":["H","C","N","O","Cl"],"composition":{"C":13.0,"H":18.0,"N":1.0,"O":1.0,"Cl":1.0},"names":{"en":"Lometraline"},"descriptions":{"en":"Lometraline (INN; developmental code name CP-14,368) is a drug and an aminotetralin derivative. A structural modification of tricyclic neuroleptics, lometraline was originally patented by Pfizer as an antipsychotic, tranquilizer, and antiparkinsonian agent. However, it was instead later studied as a potential antidepressant and/or anxiolytic agent, though clinical studies revealed no psychoactivity at the doses used and further investigation was suspended."},"fame":6,"pubchemCid":34789,"mass":239.74,"charge":0,"smiles":"CN(C)C1CCCC2=C(C=CC(=C12)Cl)OC","inchikey":"MTWNWMGGMZUIMZ-UHFFFAOYSA-N","iupac":"8-chloro-5-methoxy-N,N-dimethyl-1,2,3,4-tetrahydronaphthalen-1-amine","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"34789","atoms":34,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":1.575,"y":-2.716,"z":-0.455,"el":"Cl"},{"x":-3.321,"y":0.512,"z":-0.044,"el":"O"},{"x":2.611,"y":-0.209,"z":0.391,"el":"N"},{"x":1.618,"y":0.393,"z":-0.477,"el":"C"},{"x":1.583,"y":1.899,"z":-0.186,"el":"C"},{"x":0.382,"y":2.551,"z":-0.856,"el":"C"},{"x":0.269,"y":-0.284,"z":-0.319,"el":"C"},{"x":-0.91,"y":1.976,"z":-0.283,"el":"C"},{"x":-0.922,"y":0.468,"z":-0.26,"el":"C"},{"x":0.183,"y":-1.688,"z":-0.31,"el":"C"},{"x":-2.155,"y":-0.192,"z":-0.132,"el":"C"},{"x":2.199,"y":-0.089,"z":1.786,"el":"C"},{"x":3.911,"y":0.419,"z":0.178,"el":"C"},{"x":-1.049,"y":-2.332,"z":-0.195,"el":"C"},{"x":-2.217,"y":-1.584,"z":-0.1,"el":"C"},{"x":-3.758,"y":0.877,"z":1.262,"el":"C"},{"x":1.903,"y":0.252,"z":-1.53,"el":"H"},{"x":2.477,"y":2.397,"z":-0.581,"el":"H"},{"x":1.514,"y":2.157,"z":0.875,"el"
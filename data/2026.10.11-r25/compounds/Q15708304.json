{"version":"2026.10.11-r25","id":"Q15708304","formula":"C₂₃H₃₂N₂O","hill":"C23H32N2O","elements":["H","C","N","O"],"composition":{"C":23.0,"H":32.0,"N":2.0,"O":1.0},"names":{"en":"AB-005"},"descriptions":{"en":"AB-005 or [1-[(1-methylpiperidin-2-yl)methyl]-1H-indol-3-yl](2,2,3,3-tetramethylcyclopropyl)-methanone is a designer drug offered by online vendors as a cannabimimetic agent. The structure and pharmacological activity of AB-005 was published in 2010, prior to its commercial availability in 2012, where it was reported to have high affinity for both CB1 (Ki = 5.5 nM) and CB2 receptors (Ki = 0.48 nM). AB-005 features groups found in other previously reported synthetic cannabinoids: the tetramethylcyclopropane group of UR-144 and XLR-11 as well as the (1-methyl-2-piperidinyl)methyl substituent of AM-1248 and AM-1220."},"fame":1,"pubchemCid":11537652,"mass":352.5,"charge":0,"smiles":"CC1(C(C1(C)C)C(=O)C2=CN(C3=CC=CC=C32)CC4CCCCN4C)C","inchikey":"MOBWRRIAIHYXLB-UHFFFAOYSA-N","iupac":"[1-[(1-methylpiperidin-2-yl)methyl]indol-3-yl]-(2,2,3,3-tetramethylcyclopropyl)methanone","classes":[{"qid":"Q59199015","names":{"en":"group of stereoisomers","ru":"группа стереоизомеров","uk":"група стереоізомерів"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"11537652","atoms":58,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":2.429,"y":1.145,"z":-2.335,"el":"O"},{"x":-1.163,"y":-0.636,"z":-1.0,"el":"N"},{"x":-4.711,"y":0.432,"z":-0.213,"el":"N"},{"x":3.275,"y":0.575,"z":1.044,"el":"C"},{"x":4.093,"y":1.47,"z":0.159,"el":"C"},{"x":3.462,"y":0.255,"z":-0.38,"el":"C"},{"x":1.962,"y":1.071,"z":1.554,"el":"C"},{"x":3.976,"y":-0.326,"z":2.007,"el":"C"},{"x":3.511,"y":2.765,"z":-0.3,"el":"C"},{"x":5.569,"y":1.54,"z":0.37,"el":"C"},{"x":2.263,"y":0.416,"z":-1.324,"el":"C"},{"x":1.016,"y":-0.24,"z":-1.051,"el":"C"},{"x":0.802,"y":-1.473,"z":-0.372,"el":"C"},{"x":-0.213,"y":0.25,"z":-1.425,"el":"C"},{"x":-0.576,"y":-1.697,"z":-0.354,"el":
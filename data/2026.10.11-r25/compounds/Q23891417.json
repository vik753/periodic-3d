{"version":"2026.10.11-r25","id":"Q23891417","formula":"Cu₅(CO₃)₂(OH)₆*6H₂O","hill":"C2H18Cu5O18","elements":["H","C","O","Cu"],"composition":{"C":2.0,"H":18.0,"O":18.0,"Cu":5.0},"names":{"en":"Marklite","uk":"Маркліт"},"descriptions":{"en":"Marklite is a hydrated copper carbonate mineral named after Gregor Markl, a German mineralogist at the University of Tübingen. Markl found the type specimen of marklite in the dumps of the Friedrich-Christian mine in the Black Forest Mountains in southwestern Germany. Markl specializes in crustal petrology and geochemistry and has studied the hydrothermal ore deposits of the Black Forest area.","uk":"Маркліт — гідратований мінерал, карбонат міді, названий на честь Грегора Маркла, німецького мінералога з Тюбінгенського університету. Маркл знайшов типовий зразок маркліту у відвалах копальні «Фрідріх-Крістіан» в горах Шварцвальд на південному заході Німеччини. Маркл спеціалізується на петрології та геохімії земної кори, а також вивчав гідротермальні рудні родовища району Шварцвальд."},"fame":5,"pubchemCid":null,"mass":null,"charge":0,"smiles":null,"inchikey":null,"iupac":null,"classes":[{"qid":"Q12089225","names":{"en":"mineral species","ru":"действительный вид минералов","uk":"мінеральний вид"}}],"structureInfo":null,"structure":null,"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q23891417","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Marklite","license":"CC BY-SA 4.0"},{"role":"description","name":"Wikipedia (uk)","url":"https://uk.wikipedia.org/wiki/%D0%9C%D0%B0%D1%80%D0%BA%D0%BB%D1%96%D1%82","license":"CC BY-SA 4.0"}],"similar":[{"id":"Q420293","formula":"Cu₁₈Al₂(AsO₄)₄(SO₄)₃(OH)₂₄·36H₂O","names":{"en":"Chalcophyllite","ru":"Халькофиллит","uk":"Халькофіліт"},"elements":["H","O","Al","S","Cu","As"],"fame":15,"kind":null},{"id":"Q3832326","formula":"Cu₃(NO₃)(OH)₅*2H₂O","names":{"en":"Likasite","uk":"Ліказит"},"elements":["H","N","O","
{"version":"2026.10.11-r25","id":"Q131762398","formula":"C₁₂H₁₉NS","hill":"C12H19NS","elements":["H","C","N","S"],"composition":{"C":12.0,"H":19.0,"N":1.0,"S":1.0},"names":{"en":"N,N-dimethyl-4-methylthioamphetamine"},"descriptions":{"en":"N,N-Dimethyl-4-methylthioamphetamine (DMMTA or N,N-dimethyl-4-MTA; code name PAL-1062), also known as 4-methylthio-N,N-dimethylamphetamine (4-MTDMA), is a monoamine releasing agent (MRA) of the amphetamine family related to 4-methylthioamphetamine (4-MTA) and 4-methylthiomethamphetamine (4-MTMA or NMMTA). It has been described as an MRA of serotonin and dopamine that lacks induction of aortic contraction in vitro and hence may lack concomitant norepinephrine release (i.e., it may be a serotonin–dopamine releasing agent (SDRA)). However, EC50 values for monoamine release by 4-MTDMA were not reported."},"fame":1,"pubchemCid":46882974,"mass":209.35,"charge":0,"smiles":"CC(CC1=CC=C(C=C1)SC)N(C)C","inchikey":"NFRBJBFYUNQIQP-UHFFFAOYSA-N","iupac":"N,N-dimethyl-1-(4-methylsulfanylphenyl)propan-2-amine","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"46882974","atoms":33,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-4.524,"y":0.424,"z":-0.005,"el":"S"},{"x":3.649,"y":0.018,"z":0.497,"el":"N"},{"x":2.248,"y":-0.41,"z":0.549,"el":"C"},{"x":1.509,"y":0.094,"z":-0.704,"el":"C"},{"x":0.011,"y":0.175,"z":-0.531,"el":"C"},{"x":2.215,"y":-1.933,"z":0.677,"el":"C"},{"x":3.761,"y":1.432,"z":0.849,"el":"C"},{"x":4.206,"y":-0.227,"z":-0.831,"el":"C"},{"x":-0.789,"y":-0.924,"z":-0.844,"el":"C"},{"x":-0.573,"y":1.35,"z":-0.058,"el":"C"},{"x":-2.172,"y":-0.848,"z":-0.684,"el":"C"},{"x":-1.956,"y":1.426,"z":0.103,"el":"C"},{"x":-2.756,"y":0.327,"z":-0.211,"el":"C"},{"x":-4.829,"y":-0.905,"z":1.193,"el":"C"},{"x":1.78,"y":-0.009,"z":1.459,"el":"H"},{"x":1.822,"y":1.1,"z":
{"version":"2026.10.11-r25","id":"Q12746853","formula":"C₁₉H₂₀ClNO₂","hill":"C19H20ClNO2","elements":["H","C","N","O","Cl"],"composition":{"C":19.0,"H":20.0,"N":1.0,"O":2.0,"Cl":1.0},"names":{"en":"SKF-82958"},"descriptions":{"en":"SKF-82,958 is a synthetic compound of the 3-benzazepine family that acts as a dopamine D1 and D5 receptor full agonist. SKF-82,958 and similar D1-like-selective full agonists like SKF-81,297 and 6-Br-APB produce characteristic anorectic effects, hyperactivity and self-administration in animals, with a similar but not identical profile to that of dopaminergic stimulants such as amphetamine. SKF-82,958 was also subsequently found to act as an agonist of ERα with negligible activity at ERβ, making it a subtype-selective estrogen."},"fame":3,"pubchemCid":1225,"mass":329.8,"charge":0,"smiles":"C=CCN1CCC2=C(C(=C(C=C2C(C1)C3=CC=CC=C3)O)O)Cl","inchikey":"HJWHHQIVUHOBQN-UHFFFAOYSA-N","iupac":"9-chloro-5-phenyl-3-prop-2-enyl-1,2,4,5-tetrahydro-3-benzazepine-7,8-diol","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"1225","atoms":43,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-2.118,"y":3.063,"z":1.86,"el":"Cl"},{"x":1.206,"y":3.711,"z":-1.894,"el":"O"},{"x":-0.594,"y":4.639,"z":-0.043,"el":"O"},{"x":-1.827,"y":-1.678,"z":-0.26,"el":"N"},{"x":0.53,"y":-0.939,"z":-0.555,"el":"C"},{"x":-0.428,"y":-2.032,"z":-0.013,"el":"C"},{"x":0.172,"y":0.534,"z":-0.345,"el":"C"},{"x":-2.417,"y":-0.914,"z":0.85,"el":"C"},{"x":-1.483,"y":0.085,"z":1.547,"el":"C"},{"x":-0.757,"y":1.006,"z":0.603,"el":"C"},{"x":1.957,"y":-1.255,"z":-0.116,"el":"C"},{"x":-2.642,"y":-2.857,"z":-0.549,"el":"C"},{"x":0.818,"y":1.475,"z":-1.177,"el":"C"},{"x":-1.007,"y":2.388,"z":0.697,"el":"C"},{"x":0.557,"y":2.841,"z":-1.072,"el":"C"},{"x":2.432,"y":-0.752,"z":1.089,"el":"C"},{"x":2.766,"y":-2.043,"z":-0.
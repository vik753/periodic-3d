{"version":"2026.10.11-r25","id":"Q15311877","formula":"C₃H₅I","hill":"C3H5I","elements":["H","C","I"],"composition":{"C":3.0,"H":5.0,"I":1.0},"names":{"en":"Allyl iodide"},"descriptions":{"en":"Allyl iodide (3-iodopropene) is an organic halide used in synthesis of other organic compounds such as N-alkyl-2-pyrrolidones, sorbic acid esters, 5,5-disubstituted barbituric acids, and organometallic catalysts. Allyl iodide can be synthesized from allyl alcohol and methyl iodide on triphenyl phosphite, Finkelstein reaction on allyl halides, or by the action of elemental phosphorus and iodine on glycerol. Allyl iodide dissolved in hexane can be stored for up to three months in a dark freezer at −5 °C (23 °F) before decomposition into free iodine becomes apparent."},"fame":12,"pubchemCid":11166,"mass":167.98,"charge":0,"smiles":"C=CCI","inchikey":"HFEHLDPGIKPNKL-UHFFFAOYSA-N","iupac":"3-iodoprop-1-ene","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"11166","atoms":9,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-2.172,"y":0.425,"z":-0.046,"el":"I"},{"x":-0.408,"y":-0.764,"z":-0.13,"el":"C"},{"x":0.74,"y":0.012,"z":0.435,"el":"C"},{"x":1.84,"y":0.328,"z":-0.259,"el":"C"},{"x":-0.544,"y":-1.679,"z":0.457,"el":"H"},{"x":-0.214,"y":-1.07,"z":-1.164,"el":"H"},{"x":0.689,"y":0.307,"z":1.481,"el":"H"},{"x":2.647,"y":0.878,"z":0.212,"el":"H"},{"x":1.955,"y":0.046,"z":-1.3,"el":"H"}],"bonds":[[0,1,1],[1,2,1],[1,4,1],[1,5,1],[2,3,2],[2,6,1],[3,7,1],[3,8,1]]},"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q15311877","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Allyl_iodide","license":"CC BY-SA 4.0"},{"role":"properties","name":"PubChem","url":"https://pubchem.ncbi.nlm.nih.gov/compound/11166","license":"PubCh
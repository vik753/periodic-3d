{"version":"2026.10.11-r25","id":"Q81984408","formula":"C₂₁H₁₅F₂N₅O","hill":"C21H15F2N5O","elements":["H","C","N","O","F"],"composition":{"C":21.0,"F":2.0,"H":15.0,"N":5.0,"O":1.0},"names":{"en":"PharmaGSID_47330"},"descriptions":{"en":"ENX-102, also known as TPA-023B, is a GABAA receptor positive allosteric modulator, nonbenzodiazepine, and investigational anxiolytic which is under development for the treatment of generalized anxiety disorder and social phobia (social anxiety disorder). It is taken orally. The drug is a selective and partial positive allosteric modulator of α2, α3, and α5 subunit-containing GABAA receptors, whereas it shows no activity at α1 subunit-containing GABAA receptors, and is potentially \"anxioselective\", producing anxiolytic effects with little or no sedation, in contrast to existing agents like benzodiazepines and Z-drugs."},"fame":1,"pubchemCid":9865233,"mass":391.4,"charge":0,"smiles":"CC(C)(C1=NC2=NC=C(N2N=C1)C3=CC(=C(C=C3)F)C4=C(C=CC=C4F)C#N)O","inchikey":"PCZLQMGFNUNVOM-UHFFFAOYSA-N","iupac":"3-fluoro-2-[2-fluoro-5-[3-(2-hydroxypropan-2-yl)imidazo[1,2-b][1,2,4]triazin-7-yl]phenyl]benzonitrile","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"9865233","atoms":44,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-3.909,"y":0.873,"z":2.233,"el":"F"},{"x":-4.294,"y":1.705,"z":-1.329,"el":"F"},{"x":6.609,"y":-0.634,"z":-0.962,"el":"O"},{"x":2.114,"y":0.75,"z":-0.061,"el":"N"},{"x":4.357,"y":0.611,"z":-0.841,"el":"N"},{"x":2.134,"y":-0.372,"z":0.695,"el":"N"},{"x":2.793,"y":2.365,"z":-1.424,"el":"N"},{"x":-2.005,"y":-2.969,"z":1.441,"el":"N"},{"x":5.697,"y":-1.278,"z":-0.08,"el":"C"},{"x":4.437,"y":-0.472,"z":-0.134,"el":"C"},{"x":1.046,"y":1.591,"z":-0.216,"el":"C"},{"x":-0.238,"y":1.404,"z":0.413,"el":"C"},{"x":3.161,"y":1.254,"z":-0.811,"el":"C"},{"x":5.445
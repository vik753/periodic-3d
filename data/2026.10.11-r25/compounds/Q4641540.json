{"version":"2026.10.11-r25","id":"Q4641540","formula":"C₈H₁₀FNO₃","hill":"C8H10FNO3","elements":["H","C","N","O","F"],"composition":{"C":8.0,"F":1.0,"H":10.0,"N":1.0,"O":3.0},"names":{"en":"6-fluoro-noradrenaline"},"descriptions":{"en":"6-Fluoronorepinephrine (6-FNE) is a selective α1- and α2-adrenergic receptor full agonist related to norepinephrine. It is the only selective full agonist for the α-adrenergic receptors known to date and has been used to study their function in scientific research. Infusion of 6-FNE into the locus coeruleus of rodents produces marked hyperactivity and behavioral disinhibition by suppressing activity in the area via stimulation of α1-adrenergic receptors."},"fame":5,"pubchemCid":1862,"mass":187.17,"charge":0,"smiles":"C1=C(C(=CC(=C1O)O)F)C(CN)O","inchikey":"SBUQBFTXTZSRMH-UHFFFAOYSA-N","iupac":"4-(2-amino-1-hydroxyethyl)-5-fluorobenzene-1,2-diol","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"1862","atoms":23,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":0.982,"y":-2.153,"z":0.692,"el":"F"},{"x":2.136,"y":1.762,"z":1.102,"el":"O"},{"x":-2.552,"y":1.892,"z":-0.457,"el":"O"},{"x":-3.448,"y":-0.73,"z":-0.236,"el":"O"},{"x":2.734,"y":-0.854,"z":-1.48,"el":"N"},{"x":2.017,"y":0.469,"z":0.496,"el":"C"},{"x":0.573,"y":0.153,"z":0.3,"el":"C"},{"x":2.803,"y":0.453,"z":-0.831,"el":"C"},{"x":-0.329,"y":1.176,"z":0.009,"el":"C"},{"x":0.123,"y":-1.163,"z":0.411,"el":"C"},{"x":-1.681,"y":0.883,"z":-0.173,"el":"C"},{"x":-1.229,"y":-1.455,"z":0.229,"el":"C"},{"x":-2.131,"y":-0.432,"z":-0.063,"el":"C"},{"x":2.462,"y":-0.241,"z":1.204,"el":"H"},{"x":3.85,"y":0.716,"z":-0.64,"el":"H"},{"x":2.413,"y":1.218,"z":-1.512,"el":"H"},{"x":0.004,"y":2.206,"z":-0.094,"el":"H"},{"x":-1.565,"y":-2.485,"z":0.319,"el":"H"},{"x":3.084,"y":1.938,"z":1.229,"el":"H"},{"x":3.131,"y":-1.56
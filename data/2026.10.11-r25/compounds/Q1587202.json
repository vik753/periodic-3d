{"version":"2026.10.11-r25","id":"Q1587202","formula":"AsH₉N₂O₄","hill":"AsH9N2O4","elements":["H","N","O","As"],"composition":{"H":9.0,"N":2.0,"O":4.0,"As":1.0},"names":{"en":"Ammonium arsenate","ru":"Арсенат аммония"},"descriptions":{"en":"Ammonium arsenate is an inorganic compound with the formula (NH4)3AsO4, typically encountered as a trihydrate, (NH4)3AsO4·3H2O. It is a colorless, water-soluble crystalline solid that decomposes upon heating, releasing ammonia and forming arsenic-containing residues. Like arsenic and all inorganic arsenic compounds, it is classified as an IARC Group 1 carcinogen. It is highly toxic and poses significant health and environmental risks.","ru":"Арсенат аммония — неорганическое соединение, соль аммония и мышьяковой кислоты с формулой (NH4)3AsO4, бесцветные кристаллы, растворяется в воде, образует кристаллогидрат."},"fame":13,"pubchemCid":24574,"mass":176.0,"charge":0,"smiles":"[NH4+].[NH4+].O[As](=O)([O-])[O-]","inchikey":"XPVHUBFHKQQSDA-UHFFFAOYSA-N","iupac":"diazanium;hydrogen arsorate","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"crystal","source":"materialsproject","ref":"mp-1203108","atoms":64,"license":"CC BY 4.0, Materials Project"},"structure":{"cell":[[10.95,0.0,0.0],[0.0,6.836,0.0],[-2.572,0.0,7.708]],"kind":"crystal","atoms":[{"x":1.902,"y":2.667,"z":2.466,"el":"As"},{"x":7.762,"y":6.086,"z":1.388,"el":"As"},{"x":6.476,"y":4.169,"z":5.242,"el":"As"},{"x":0.616,"y":0.751,"z":6.32,"el":"As"},{"x":3.657,"y":4.37,"z":5.516,"el":"H"},{"x":3.434,"y":0.951,"z":6.047,"el":"H"},{"x":4.72,"y":2.467,"z":2.193,"el":"H"},{"x":4.944,"y":5.885,"z":1.662,"el":"H"},{"x":2.475,"y":3.353,"z":6.243,"el":"H"},{"x":4.616,"y":6.771,"z":5.319,"el":"H"},{"x":5.902,"y":3.484,"z":1.465,"el":"H"},{"x":3.761,"y":0.066,"z":2.389,"el":"H"},{"x":2.124,"y":4.99,"z":5.892,"el":"H"},{"x":4.967,"y":1.571,"z":5.67,"el":"H"},{"x":6.253,"y":1.847,"
{"version":"2026.10.11-r25","id":"Q5896650","formula":"C₁₈H₁₈O₂","hill":"C18H18O2","elements":["H","C","O"],"composition":{"C":18.0,"H":18.0,"O":2.0},"names":{"en":"Honokiol"},"descriptions":{"en":"Honokiol is a lignan isolated from the bark, seed cones, and leaves of trees belonging to the genus Magnolia. It has been identified as one of the chemical compounds in some traditional Eastern herbal medicines along with magnolol, 4-O-methylhonokiol, and obovatol. Honokiol, a compound with a spicy odor extracted from various Magnolia species worldwide, including those native to the Southeastern United States and Mexico, can readily cross the blood-brain and cerebrospinal fluid barriers, making it a highly bioavailable and potentially effective therapeutic agent."},"fame":6,"pubchemCid":72303,"mass":266.3,"charge":0,"smiles":"C=CCC1=CC(=C(C=C1)O)C2=CC(=C(C=C2)O)CC=C","inchikey":"FVYXIJYOAGAUQK-UHFFFAOYSA-N","iupac":"2-(4-hydroxy-3-prop-2-enylphenyl)-4-prop-2-enylphenol","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"72303","atoms":38,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":0.29,"y":2.692,"z":-1.032,"el":"O"},{"x":-4.311,"y":-0.426,"z":1.636,"el":"O"},{"x":0.964,"y":0.699,"z":0.131,"el":"C"},{"x":-0.4,"y":0.406,"z":0.516,"el":"C"},{"x":-2.52,"y":-0.66,"z":0.06,"el":"C"},{"x":-1.205,"y":-0.378,"z":-0.311,"el":"C"},{"x":3.307,"y":0.102,"z":0.169,"el":"C"},{"x":1.986,"y":-0.165,"z":0.53,"el":"C"},{"x":1.267,"y":1.83,"z":-0.629,"el":"C"},{"x":-0.909,"y":0.906,"z":1.714,"el":"C"},{"x":-3.029,"y":-0.16,"z":1.258,"el":"C"},{"x":-3.368,"y":-1.5,"z":-0.838,"el":"C"},{"x":4.397,"y":-0.822,"z":0.595,"el":"C"},{"x":3.608,"y":1.232,"z":-0.591,"el":"C"},{"x":-2.224,"y":0.624,"z":2.085,"el":"C"},{"x":2.588,"y":2.096,"z":-0.99,"el":"C"},{"x":-4.133,"y":-0.69,"z":-1.851,"el":"C"},{"x":4.66,"y":-1.924
{"version":"2026.10.11-r25","id":"Q416655","formula":"C₄H₁₁N","hill":"C4H11N","elements":["H","C","N"],"composition":{"C":4.0,"H":11.0,"N":1.0},"names":{"en":"Isobutylamine"},"descriptions":{"en":"Isobutylamine is an organic chemical compound (specifically, an amine) with the formula (CH3)2CHCH2NH2, and occurs as a colorless liquid. Isobutylamine is one of the four isomeric amines of butane, the others being n-butylamine, sec-butylamine and tert-butylamine. It is the decarboxylated form of the amino acid valine, and the product of the metabolism thereof by the enzyme valine decarboxylase."},"fame":15,"pubchemCid":6558,"mass":73.14,"charge":0,"smiles":"CC(C)CN","inchikey":"KDSNLYIMUZNERS-UHFFFAOYSA-N","iupac":"2-methylpropan-1-amine","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"6558","atoms":16,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-2.009,"y":0.003,"z":-0.104,"el":"N"},{"x":0.473,"y":-0.013,"z":-0.333,"el":"C"},{"x":-0.776,"y":-0.69,"z":0.257,"el":"C"},{"x":0.545,"y":1.441,"z":0.141,"el":"C"},{"x":1.767,"y":-0.741,"z":0.04,"el":"C"},{"x":0.395,"y":-0.013,"z":-1.428,"el":"H"},{"x":-0.838,"y":-1.721,"z":-0.11,"el":"H"},{"x":-0.705,"y":-0.746,"z":1.349,"el":"H"},{"x":0.515,"y":1.508,"z":1.234,"el":"H"},{"x":1.476,"y":1.909,"z":-0.196,"el":"H"},{"x":-0.273,"y":2.044,"z":-0.265,"el":"H"},{"x":1.916,"y":-0.752,"z":1.125,"el":"H"},{"x":2.635,"y":-0.256,"z":-0.419,"el":"H"},{"x":1.739,"y":-1.778,"z":-0.308,"el":"H"},{"x":-2.025,"y":0.178,"z":-1.108,"el":"H"},{"x":-2.046,"y":0.914,"z":0.348,"el":"H"}],"bonds":[[0,2,1],[0,14,1],[0,15,1],[1,2,1],[1,3,1],[1,4,1],[1,5,1],[2,6,1],[2,7,1],[3,8,1],[3,9,1],[3,10,1],[4,11,1],[4,12,1],[4,13,1]]},"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q416655","license":"CC0 1.0"},{"role":"description","name":"Wiki
{"version":"2026.10.11-r25","id":"Q3333706","formula":"CH₃⁺","hill":"CH3","elements":["H","C"],"composition":{"C":1.0,"H":3.0},"names":{"en":"Methenium"},"descriptions":{"en":"In organic chemistry, methenium (also called methylium, carbenium, methyl cation, or protonated methylene) is a cation with the formula CH+3. It can be viewed as a methylene radical (:CH2) with an added proton (H+), or as a methyl radical (•CH3) with one electron removed. It is a carbocation and an enium ion, making it the simplest of the carbenium ions."},"fame":11,"pubchemCid":644094,"mass":15.035,"charge":1,"smiles":"[CH3+]","inchikey":"JUHDUIDUEUEQND-UHFFFAOYSA-N","iupac":"carbanylium","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"644094","atoms":4,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":0.0,"y":0.0,"z":0.0,"el":"C"},{"x":-0.987,"y":0.39,"z":0.215,"el":"H"},{"x":0.819,"y":0.68,"z":-0.197,"el":"H"},{"x":0.168,"y":-1.069,"z":-0.019,"el":"H"}],"bonds":[[0,1,1],[0,2,1],[0,3,1]]},"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q3333706","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Methenium","license":"CC BY-SA 4.0"},{"role":"properties","name":"PubChem","url":"https://pubchem.ncbi.nlm.nih.gov/compound/644094","license":"PubChem (NIH), public data"},{"role":"structure","name":"PubChem 3D","url":"https://pubchem.ncbi.nlm.nih.gov/compound/644094#section=3D-Conformer","license":"PubChem (NIH), public data"}],"similar":[{"id":"Q52858","formula":"C₂H₆","names":{"en":"Ethane","ru":"Этан","uk":"Етан"},"elements":["H","C"],"fame":82,"kind":"molecule"},{"id":"Q131189","formula":"C₃H₈","names":{"en":"Propane","ru":"Пропан","uk":"Пропан"},"elements":["H","C"],"fame":76,"kind":"molecule"},{"id":"Q6823951","formula":"CH₃",
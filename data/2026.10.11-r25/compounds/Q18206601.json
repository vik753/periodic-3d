{"version":"2026.10.11-r25","id":"Q18206601","formula":"C₁₃H₁₈ClNO₂","hill":"C13H18ClNO2","elements":["H","C","N","O","Cl"],"composition":{"C":13.0,"H":18.0,"N":1.0,"O":2.0,"Cl":1.0},"names":{"en":"(+/-)-hydroxybupropion"},"descriptions":{"en":"Hydroxybupropion (code name BW 306U), or 6-hydroxybupropion, is the major active metabolite of the antidepressant and smoking cessation drug bupropion. It is formed from bupropion by the liver enzyme CYP2B6 during first-pass metabolism. With oral bupropion treatment, hydroxybupropion is present in plasma at area under the curve concentrations that are as many as 16 to 20 times greater than those of bupropion itself, demonstrating extensive conversion of bupropion into hydroxybupropion in humans."},"fame":2,"pubchemCid":446,"mass":255.74,"charge":0,"smiles":"CC(C(=O)C1=CC(=CC=C1)Cl)NC(C)(C)CO","inchikey":"AKOAEVOSDHIVFX-UHFFFAOYSA-N","iupac":"1-(3-chlorophenyl)-2-[(1-hydroxy-2-methylpropan-2-yl)amino]propan-1-one","classes":[{"qid":"Q15711994","names":{"en":"group of isomeric entities","ru":"семейство химических соединений","uk":"родина хімічних сполук"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"446","atoms":35,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-3.0,"y":-3.1,"z":0.122,"el":"Cl"},{"x":3.774,"y":-2.256,"z":-0.689,"el":"O"},{"x":-0.363,"y":2.485,"z":0.656,"el":"O"},{"x":1.762,"y":0.503,"z":0.755,"el":"N"},{"x":3.001,"y":-0.158,"z":0.327,"el":"C"},{"x":0.865,"y":0.682,"z":-0.373,"el":"C"},{"x":2.627,"y":-1.53,"z":-0.263,"el":"C"},{"x":3.911,"y":-0.308,"z":1.554,"el":"C"},{"x":3.7,"y":0.717,"z":-0.724,"el":"C"},{"x":1.536,"y":1.551,"z":-1.428,"el":"C"},{"x":-0.395,"y":1.364,"z":0.149,"el":"C"},{"x":-1.706,"y":0.655,"z":0.063,"el":"C"},{"x":-1.718,"y":-0.72,"z":0.126,"el":"C"},{"x":-2.852,"y":1.404,"z":-0.074,"el":"C"},{"x":-2.943,"y":-1.382,"z":0.047,"el":"C"},{"x":-4.077,"y":0.742,"z":-0.153,"el":"C"},{"x":-4.122,"y":-0.651,"z":-0.093,"el":"C"},{"x":1.303,"y":
{"version":"2026.10.11-r25","id":"Q416861","formula":"Br₂CaO₆","hill":"Br2CaO6","elements":["O","Ca","Br"],"composition":{"O":6.0,"Br":2.0,"Ca":1.0},"names":{"en":"Calcium bromate","ru":"Бромат кальция"},"descriptions":{"en":"Calcium bromate, Ca(BrO3)2, is a calcium salt of bromic acid. It is most commonly encountered as the monohydrate, Ca(BrO3)2•H2O. It can be prepared by reacting calcium hydroxide with sodium bromate or calcium sulfate with barium bromate. Above 180 °C, calcium bromate decomposes to form calcium bromide and oxygen.","ru":"Бромат кальция — неорганическое соединение, соль кальция и бромноватой кислоты с формулой Ca(BrO3)2, бесцветные кристаллы, растворяется в воде, образует кристаллогидраты."},"fame":20,"pubchemCid":61478,"mass":295.88,"charge":0,"smiles":"[O-]Br(=O)=O.[O-]Br(=O)=O.[Ca+2]","inchikey":"GROPHIUSZODNGU-UHFFFAOYSA-L","iupac":"calcium dibromate","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"rdkit","ref":"61478","atoms":9,"license":"Computed with RDKit from SMILES (PubChem, Wikidata)"},"structure":{"kind":"molecule","atoms":[{"x":-0.631,"y":1.582,"z":0.808,"el":"O"},{"x":0.652,"y":-0.64,"z":0.807,"el":"Br"},{"x":3.469,"y":-0.641,"z":0.81,"el":"O"},{"x":-0.674,"y":-2.937,"z":0.803,"el":"O"},{"x":-1.688,"y":2.063,"z":-1.405,"el":"O"},{"x":-0.405,"y":-0.159,"z":-1.406,"el":"Br"},{"x":2.412,"y":-0.16,"z":-1.403,"el":"O"},{"x":-1.731,"y":-2.456,"z":-1.41,"el":"O"},{"x":-1.404,"y":3.35,"z":2.397,"el":"Ca"}],"bonds":[[0,1,1.0],[1,2,1.0],[1,3,1.0],[4,5,1.0],[5,6,1.0],[5,7,1.0]]},"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q416861","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Calcium_bromate","license":"CC BY-SA 4.0"},{"role":"description","name":"Wikipedia (ru)","url":"https://ru.wikipedia.org/wiki/%D0%91%D1%80%D0%BE
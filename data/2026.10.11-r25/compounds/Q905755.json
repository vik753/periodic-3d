{"version":"2026.10.11-r25","id":"Q905755","formula":"C₁₅H₁₂ClNO₂","hill":"C15H12ClNO2","elements":["H","C","N","O","Cl"],"composition":{"C":15.0,"H":12.0,"N":1.0,"O":2.0,"Cl":1.0},"names":{"en":"Carprofen"},"descriptions":{"en":"Carprofen is a nonsteroidal anti-inflammatory drug (NSAID) of the carbazole and propionic acid class that was previously for use in humans and animals but is now only available to veterinarians for prescribing as a supportive treatment for various conditions in animals. Carprofen reduces inflammation by inhibition of COX-1 and COX-2; its specificity for COX-2 varies from species to species. Marketed under many brand names worldwide, carprofen is used as a treatment for inflammation and pain, including joint pain and postoperative pain."},"fame":15,"pubchemCid":2581,"mass":273.71,"charge":0,"smiles":"CC(C1=CC2=C(C=C1)C3=C(N2)C=CC(=C3)Cl)C(=O)O","inchikey":"PUXBGTOOZJQSKH-UHFFFAOYSA-N","iupac":"2-(6-chloro-9H-carbazol-2-yl)propanoic acid","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"2581","atoms":31,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":5.867,"y":-1.289,"z":-0.427,"el":"Cl"},{"x":-5.693,"y":0.275,"z":-0.639,"el":"O"},{"x":-3.733,"y":0.875,"z":-1.606,"el":"O"},{"x":0.854,"y":1.611,"z":0.335,"el":"N"},{"x":0.619,"y":-0.589,"z":0.059,"el":"C"},{"x":-0.077,"y":0.601,"z":0.27,"el":"C"},{"x":2.012,"y":-0.265,"z":-0.002,"el":"C"},{"x":-2.176,"y":-0.549,"z":0.273,"el":"C"},{"x":2.126,"y":1.114,"z":0.173,"el":"C"},{"x":-3.664,"y":-0.539,"z":0.385,"el":"C"},{"x":-1.471,"y":0.654,"z":0.381,"el":"C"},{"x":-0.115,"y":-1.79,"z":-0.046,"el":"C"},{"x":-1.509,"y":-1.754,"z":0.063,"el":"C"},{"x":3.188,"y":-1.021,"z":-0.19,"el":"C"},{"x":3.358,"y":1.778,"z":0.17,"el":"C"},{"x":-4.184,"y":-0.025,"z":1.743,"el":"C"},{"x":4.427,"y":-0.371,"z":-0.197,"el":"C"},{"x":-4.336
{"version":"2026.10.11-r25","id":"Q65046130","formula":"C₄H₂F₉NO₂S","hill":"C4H2F9NO2S","elements":["H","C","N","O","F","S"],"composition":{"C":4.0,"F":9.0,"H":2.0,"N":1.0,"O":2.0,"S":1.0},"names":{"en":"Perfluorobutane sulfonamide"},"descriptions":{"en":"Perfluorobutane sulfonamide, also known as FBSA or H-FBSA, is a perfluorinated surfactant. FBSA and its N-alkylated derivatives have been patented by 3M for use in acid etch solutions with low surface tension. According to the inventors, FBSA and derivatives are expected to biomagnify less than the older surfactant PFOS. Nevertheless, a 2015 study found FBSA in 32 out of 33 samples of Canadian fish."},"fame":4,"pubchemCid":10958205,"mass":299.12,"charge":0,"smiles":"C(C(C(F)(F)S(=O)(=O)N)(F)F)(C(F)(F)F)(F)F","inchikey":"FUVKFLJWBHVMHX-UHFFFAOYSA-N","iupac":"1,1,2,2,3,3,4,4,4-nonafluorobutane-1-sulfonamide","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"10958205","atoms":19,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-2.088,"y":0.635,"z":-0.444,"el":"S"},{"x":-0.411,"y":-1.877,"z":-0.996,"el":"F"},{"x":0.642,"y":-1.896,"z":0.904,"el":"F"},{"x":-0.629,"y":0.404,"z":1.681,"el":"F"},{"x":-1.864,"y":-1.319,"z":1.219,"el":"F"},{"x":0.728,"y":0.495,"z":-1.675,"el":"F"},{"x":2.105,"y":-1.107,"z":-1.175,"el":"F"},{"x":2.551,"y":-0.022,"z":1.294,"el":"F"},{"x":1.16,"y":1.603,"z":0.864,"el":"F"},{"x":2.93,"y":1.336,"z":-0.369,"el":"F"},{"x":-1.298,"y":1.757,"z":-0.911,"el":"O"},{"x":-2.765,"y":-0.249,"z":-1.371,"el":"O"},{"x":-3.228,"y":1.217,"z":0.684,"el":"N"},{"x":0.085,"y":-1.061,"z":-0.022,"el":"C"},{"x":-1.082,"y":-0.355,"z":0.65,"el":"C"},{"x":1.204,"y":-0.235,"z":-0.635,"el":"C"},{"x":1.959,"y":0.676,"z":0.301,"el":"C"},{"x":-3.913,"y":0.549,"z":1.059,"el":"H"},{"x":-2.909,"y":1.912,"z":1.37,"el":"H"}],"bonds":[[0,10,2],[0,11,2],[0,
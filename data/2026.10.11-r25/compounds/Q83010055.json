{"version":"2026.10.11-r25","id":"Q83010055","formula":"C₁₂H₁₅NS","hill":"C12H15NS","elements":["H","C","N","S"],"composition":{"C":12.0,"H":15.0,"N":1.0,"S":1.0},"names":{"en":"N,N-dimethyl-3-(2-aminoethyl)benzothiophene"},"descriptions":{"en":"S-DMT, also known as 1-thia-DMT or as N,N-dimethyl-3-(2-aminoethyl)benzo[β]thiophene (N,N-dimethyl-3-AEBT), is a serotonin receptor modulator of the benzothiophene family related to the psychedelic tryptamine dimethyltryptamine (DMT). It is the analogue and bioisostere of DMT in which the nitrogen atom of the indole ring has been replaced with a sulfur atom, making the drug a benzothiophene rather than indole or tryptamine derivative. The drug shows about the same activity at the serotonin receptors in the rat fundus strip as DMT. These receptors may correspond to the serotonin 5-HT2B receptor."},"fame":1,"pubchemCid":25118,"mass":205.32,"charge":0,"smiles":"CN(C)CCC1=CSC2=CC=CC=C21","inchikey":"QAPUMUJBYRYLGE-UHFFFAOYSA-N","iupac":"2-(1-benzothiophen-3-yl)-N,N-dimethylethanamine","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"25118","atoms":29,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":1.994,"y":-2.335,"z":0.189,"el":"S"},{"x":-3.678,"y":0.09,"z":0.019,"el":"N"},{"x":-1.416,"y":-0.505,"z":-0.8,"el":"C"},{"x":-0.036,"y":-0.898,"z":-0.42,"el":"C"},{"x":-2.322,"y":-0.268,"z":0.418,"el":"C"},{"x":1.033,"y":0.034,"z":-0.199,"el":"C"},{"x":2.217,"y":-0.626,"z":0.146,"el":"C"},{"x":0.35,"y":-2.206,"z":-0.243,"el":"C"},{"x":1.053,"y":1.448,"z":-0.278,"el":"C"},{"x":-3.677,"y":1.341,"z":-0.741,"el":"C"},{"x":-4.546,"y":0.209,"z":1.191,"el":"C"},{"x":3.405,"y":0.083,"z":0.411,"el":"C"},{"x":2.23,"y":2.154,"z":-0.016,"el":"C"},{"x":3.393,"y":1.477,"z":0.325,"el":"C"},{"x":-1.351,"y":0.384,"z":-1.435,"el":"H"},{"x":-1.857,"y":-1.289,"z":-1.431,"el":
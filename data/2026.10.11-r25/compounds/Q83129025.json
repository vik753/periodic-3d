{"version":"2026.10.11-r25","id":"Q83129025","formula":"C₁₆H₂₂Cl₂N₂O","hill":"C16H22Cl2N2O","elements":["H","C","N","O","Cl"],"composition":{"C":16.0,"H":22.0,"N":2.0,"O":1.0,"Cl":2.0},"names":{"en":"U-47700"},"descriptions":{"en":"U-47700, also known as U4, pink heroin, pinky, and pink, is an opioid analgesic drug developed by a team at Upjohn in the 1970s which has around 7.5 times the potency of morphine in animal models. U-47700 is a structural isomer of the earlier opioid AH-7921 and the result of a great deal of work elucidating the quantitative structure–activity relationship of the scaffold. Upjohn looked for the key moieties which gave the greatest activity and posted over a dozen patents on related compounds, each optimizing one moiety until they discovered that U-47700 was the most active."},"fame":5,"pubchemCid":13544016,"mass":329.3,"charge":0,"smiles":"CN(C)[C@@H]1CCCC[C@H]1N(C)C(=O)C2=CC(=C(C=C2)Cl)Cl","inchikey":"JGPNMZWFVRQNGU-HUUCEWRRSA-N","iupac":"3,4-dichloro-N-[(1R,2R)-2-(dimethylamino)cyclohexyl]-N-methylbenzamide","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"13544016","atoms":43,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":4.417,"y":-2.404,"z":0.456,"el":"Cl"},{"x":6.115,"y":0.345,"z":0.647,"el":"Cl"},{"x":0.075,"y":0.375,"z":-2.031,"el":"O"},{"x":-2.313,"y":-1.833,"z":-0.022,"el":"N"},{"x":-0.625,"y":0.562,"z":0.192,"el":"N"},{"x":-2.805,"y":-0.551,"z":0.488,"el":"C"},{"x":-2.03,"y":0.62,"z":-0.145,"el":"C"},{"x":-4.308,"y":-0.443,"z":0.2,"el":"C"},{"x":-2.612,"y":1.97,"z":0.29,"el":"C"},{"x":-4.87,"y":0.906,"z":0.641,"el":"C"},{"x":-4.108,"y":2.063,"z":0.005,"el":"C"},{"x":-2.537,"y":-1.925,"z":-1.462,"el":"C"},{"x":-2.968,"y":-2.939,"z":0.673,"el":"C"},{"x":-0.304,"y":0.636,"z":1.619,"el":"C"},{"x":0.329,"y":0.44,"z":-0.829,"el":"C"},{"x":1.754,"y":0.401
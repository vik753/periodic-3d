{"version":"2026.10.11-r25","id":"Q4652500","formula":"C₂₀H₂₀INO","hill":"C20H20INO","elements":["H","C","N","O","I"],"composition":{"C":20.0,"H":20.0,"I":1.0,"N":1.0,"O":1.0},"names":{"en":"1-pentyl-3-(2-iodobenzoyl)indole"},"descriptions":{"en":"AM-679 (part of the AM cannabinoid series) is a drug that acts as a moderately potent agonist for the cannabinoid receptors, with a Ki of 13.5 nM at CB1 and 49.5 nM at CB2. AM-679 was one of the first 3-(2-iodobenzoyl)indole derivatives that was found to have significant cannabinoid receptor affinity, and while AM-679 itself has only modest affinity for these receptors, it was subsequently used as a base to develop several more specialised cannabinoid ligands that are now widely used in research, including the potent CB1 agonists AM-694 and AM-2233, and the selective CB2 agonist AM-1241."},"fame":3,"pubchemCid":57458891,"mass":417.3,"charge":0,"smiles":"CCCCCN1C=C(C2=CC=CC=C21)C(=O)C3=CC=CC=C3I","inchikey":"GAJBHYUAJOTAEW-UHFFFAOYSA-N","iupac":"(2-iodophenyl)-(1-pentylindol-3-yl)methanone","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"rdkit","ref":"57458891","atoms":43,"license":"Computed with RDKit from SMILES (PubChem, Wikidata)"},"structure":{"kind":"molecule","atoms":[{"x":6.668,"y":0.454,"z":0.581,"el":"C"},{"x":5.158,"y":0.621,"z":0.496,"el":"C"},{"x":4.492,"y":-0.625,"z":-0.09,"el":"C"},{"x":2.985,"y":-0.463,"z":-0.299,"el":"C"},{"x":2.208,"y":-0.314,"z":1.009,"el":"C"},{"x":0.77,"y":-0.266,"z":0.785,"el":"N"},{"x":-0.053,"y":-1.352,"z":0.872,"el":"C"},{"x":-1.351,"y":-0.958,"z":0.593,"el":"C"},{"x":-1.301,"y":0.461,"z":0.356,"el":"C"},{"x":-2.258,"y":1.458,"z":0.057,"el":"C"},{"x":-1.861,"y":2.788,"z":-0.127,"el":"C"},{"x":-0.525,"y":3.147,"z":-0.016,"el":"C"},{"x":0.446,"y":2.192,"z":0.288,"el":"C"},{"x":0.039,"y":0.859,"z":0.475,"el":"C"},{"x":-2.464,"y":-1.906,"z":0.583,"el":"C"},{
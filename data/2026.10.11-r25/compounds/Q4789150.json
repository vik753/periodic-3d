{"version":"2026.10.11-r25","id":"Q4789150","formula":"C₁₈H₁₇ClN₂O₃","hill":"C18H17ClN2O3","elements":["H","C","N","O","Cl"],"composition":{"C":18.0,"H":17.0,"N":2.0,"O":3.0,"Cl":1.0},"names":{"en":"Arfendazam"},"descriptions":{"en":"Arfendazam (INN) is a drug which is a benzodiazepine derivative. Arfendazam is a 1,5-benzodiazepine, with the nitrogen atoms located at positions 1 and 5 of the diazepine ring, and so is most closely related to other 1,5-benzodiazepines such as clobazam. Arfendazam has sedative and anxiolytic effects similar to those produced by other benzodiazepine derivatives, but is a partial agonist at GABAA receptors, so the sedative effects are relatively mild and it produces muscle relaxant effects only at very high doses."},"fame":8,"pubchemCid":65803,"mass":344.8,"charge":0,"smiles":"CCOC(=O)N1CCC(=O)N(C2=C1C=CC(=C2)Cl)C3=CC=CC=C3","inchikey":"NXJWVCHVPUCWJS-UHFFFAOYSA-N","iupac":"ethyl 7-chloro-4-oxo-5-phenyl-2,3-dihydro-1,5-benzodiazepine-1-carboxylate","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"65803","atoms":41,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":2.173,"y":-4.428,"z":0.267,"el":"Cl"},{"x":0.739,"y":2.736,"z":1.501,"el":"O"},{"x":-3.883,"y":0.867,"z":-0.371,"el":"O"},{"x":-2.978,"y":-0.857,"z":-1.566,"el":"O"},{"x":-1.878,"y":-0.041,"z":0.339,"el":"N"},{"x":1.038,"y":0.582,"z":0.625,"el":"N"},{"x":-1.93,"y":0.931,"z":1.435,"el":"C"},{"x":-0.698,"y":1.041,"z":2.306,"el":"C"},{"x":-0.858,"y":-1.047,"z":0.334,"el":"C"},{"x":0.519,"y":-0.756,"z":0.478,"el":"C"},{"x":0.436,"y":1.542,"z":1.449,"el":"C"},{"x":2.231,"y":0.913,"z":-0.12,"el":"C"},{"x":-1.254,"y":-2.388,"z":0.144,"el":"C"},{"x":1.437,"y":-1.833,"z":0.462,"el":"C"},{"x":-2.922,"y":-0.084,"z":-0.611,"el":"C"},{"x":-0.327,"y":-3.428,"z":0.118,"el":"C"},{"x":1.02,"y":-3.151,"z":0.282,"el":"C
{"version":"2026.10.11-r25","id":"Q28131985","formula":"C₂₀H₃₁ClO₂","hill":"C20H31ClO2","elements":["H","C","O","Cl"],"composition":{"C":20.0,"H":31.0,"O":2.0,"Cl":1.0},"names":{"en":"Chloromethylandrostenediol"},"descriptions":{"en":"Chloromethylandrostenediol (CMA), also known as 4-chloro-17α-methyl-androst-4-ene-3β,17β-diol, is a synthetic, orally active anabolic-androgenic steroid (AAS) and a 17α-alkylated derivative of 4-androstenediol that was never marketed. It was first encountered in 2005 when it was introduced as a \"dietary supplement\" and putative prohormone under the name Promagnon by an online vendor called Peak Performance Laboratories. CMA was voluntarily discontinued by Gaspari Nutrition in late 2006, likely fearing government sanctions if it continued to sell the product."},"fame":1,"pubchemCid":101548739,"mass":338.9,"charge":0,"smiles":"C[C@]12CCC(C(=C1CC[C@@H]3[C@@H]2CC[C@]4([C@H]3CC[C@]4(C)O)C)Cl)O","inchikey":"FWWFNYYTZPIJFZ-KYPBWNNHSA-N","iupac":"(8R,9S,10R,13S,14S,17S)-4-chloro-10,13,17-trimethyl-1,2,3,6,7,8,9,11,12,14,15,16-dodecahydrocyclopenta[a]phenanthrene-3,17-diol","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"rdkit","ref":"101548739","atoms":54,"license":"Computed with RDKit from SMILES (PubChem, Wikidata)"},"structure":{"kind":"molecule","atoms":[{"x":-2.137,"y":2.011,"z":0.358,"el":"C"},{"x":-2.063,"y":0.559,"z":-0.175,"el":"C"},{"x":-2.831,"y":0.502,"z":-1.532,"el":"C"},{"x":-4.346,"y":0.483,"z":-1.362,"el":"C"},{"x":-4.776,"y":-0.731,"z":-0.548,"el":"C"},{"x":-3.912,"y":-0.956,"z":0.668,"el":"C"},{"x":-2.71,"y":-0.373,"z":0.877,"el":"C"},{"x":-1.893,"y":-0.569,"z":2.14,"el":"C"},{"x":-0.475,"y":-1.038,"z":1.832,"el":"C"},{"x":0.242,"y":-0.065,"z":0.888,"el":"C"},{"x":-0.575,"y":0.104,"z":-0.43,"el":"C"},{"x":0.183,"y":0.976,"z":-1.468,"el":"C"},{"x":1.636,"y":0.522,"z":-1.7,"el":"C"},{"x":2.421,"y"
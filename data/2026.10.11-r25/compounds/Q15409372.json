{"version":"2026.10.11-r25","id":"Q15409372","formula":"C₁₄H₁₆N₂","hill":"C14H16N2","elements":["H","C","N"],"composition":{"C":14.0,"H":16.0,"N":2.0},"names":{"en":"1-naphthylpiperazine"},"descriptions":{"en":"1-(1-Naphthyl)piperazine (1-NP) is a drug which is a phenylpiperazine derivative. It acts as a non-selective, mixed serotonergic agent, exerting partial agonism at the 5-HT1A, 5-HT1B, 5-HT1D, 5-HT1E, and 5-HT1F receptors, while antagonizing the 5-HT2A, 5-HT2B, and 5-HT2C receptors. It has also been shown to possess high affinity for the 5-HT3, 5-HT5A, 5-HT6, and 5-HT7 receptors, and may bind to 5-HT4 and the SERT as well."},"fame":4,"pubchemCid":1342,"mass":212.29,"charge":0,"smiles":"C1CN(CCN1)C2=CC=CC3=CC=CC=C32","inchikey":"VNICFCQJUVFULD-UHFFFAOYSA-N","iupac":"1-naphthalen-1-ylpiperazine","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"1342","atoms":32,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-1.407,"y":0.24,"z":-0.005,"el":"N"},{"x":-4.161,"y":-0.508,"z":0.054,"el":"N"},{"x":-2.059,"y":-0.067,"z":1.276,"el":"C"},{"x":-2.302,"y":0.647,"z":-1.093,"el":"C"},{"x":-3.234,"y":-1.021,"z":1.062,"el":"C"},{"x":-3.469,"y":-0.331,"z":-1.221,"el":"C"},{"x":-0.09,"y":0.714,"z":0.024,"el":"C"},{"x":1.007,"y":-0.162,"z":-0.023,"el":"C"},{"x":0.103,"y":2.093,"z":0.103,"el":"C"},{"x":2.319,"y":0.37,"z":0.009,"el":"C"},{"x":0.832,"y":-1.553,"z":-0.102,"el":"C"},{"x":1.393,"y":2.616,"z":0.134,"el":"C"},{"x":2.494,"y":1.761,"z":0.087,"el":"C"},{"x":3.416,"y":-0.506,"z":-0.039,"el":"C"},{"x":1.934,"y":-2.408,"z":-0.149,"el":"C"},{"x":3.223,"y":-1.885,"z":-0.117,"el":"C"},{"x":-2.407,"y":0.865,"z":1.739,"el":"H"},{"x":-1.349,"y":-0.533,"z":1.97,"el":"H"},{"x":-1.757,"y":0.671,"z":-2.045,"el":"H"},{"x":-2.683,"y":1.659,"z":-0.903,"el":"H"},{"x":-2.867,"y":-2.011,"z":0.764,"el":"H"},{"x":-3
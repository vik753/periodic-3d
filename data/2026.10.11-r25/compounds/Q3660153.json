{"version":"2026.10.11-r25","id":"Q3660153","formula":"K₃Na₂Na₃Mg₅(IO₃)₆(SeO₄)₆·6H₂O","hill":"H12I6K3Mg5Na5O48Se6","elements":["H","O","Na","Mg","K","Se","I"],"composition":{"H":12.0,"I":6.0,"K":3.0,"O":48.0,"Mg":5.0,"Na":5.0,"Se":6.0},"names":{"en":"Carlosruizite"},"descriptions":{"en":"Carlosruizite is a sulfate or selenate–iodate mineral with chemical formula: K6(Na,K)4Na6Mg10(SeO4)12(IO3)12·12H2O. It has a low density (specific gravity of 3.36), colorless to pale yellow, transparent mineral which crystallizes in the trigonal crystal system. It forms a series with fuenzalidaite. It was first discovered in 1994 in the locality of Zapiga, Tarapacá Region of Chile."},"fame":5,"pubchemCid":null,"mass":null,"charge":0,"smiles":null,"inchikey":null,"iupac":null,"classes":[{"qid":"Q12089225","names":{"en":"mineral species","ru":"действительный вид минералов","uk":"мінеральний вид"}}],"structureInfo":null,"structure":null,"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q3660153","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Carlosruizite","license":"CC BY-SA 4.0"}],"similar":[{"id":"Q414567","formula":"BrNaO₃","names":{"en":"Sodium bromate","ru":"Бромат натрия"},"elements":["O","Na","Br"],"fame":31,"kind":"crystal"},{"id":"Q27279756","formula":"BrNaO₂","names":{"en":"Sodium bromite","uk":"Броміт натрію"},"elements":["O","Na","Br"],"fame":9,"kind":"crystal"},{"id":"Q411126","formula":"INaO₃","names":{"en":"Sodium iodate","ru":"Иодат натрия","uk":"Йодат натрію"},"elements":["O","Na","I"],"fame":29,"kind":"crystal"},{"id":"Q63441402","formula":"BrNaO₄","names":{"en":"Sodium perbromate"},"elements":["O","Na","Br"],"fame":8,"kind":"molecule"},{"id":"Q15926183","formula":"LiIO₄","names":{"en":"Lithium periodate"},"elements":["Li","O","I"],"fame":5,"kind":"crystal"},{"id":"Q415049","formula":"H₂KO₄P","names":{"en":"Monobasic potassium phosphate","ru":"Дигидроортофосфат калия","uk":"Ди
{"version":"2026.10.11-r25","id":"Q5961470","formula":"C₂₀H₂₂O₆","hill":"C20H22O6","elements":["H","C","O"],"composition":{"C":20.0,"H":22.0,"O":6.0},"names":{"en":"Miroestrol"},"descriptions":{"en":"Miroestrol is a phytoestrogen, a plant-derived chemical that mimics the biological activity of the hormone estrogen. Miroestrol was first reportedly isolated from the Thai herb Pueraria mirifica in 1960 and thought to be responsible for the supposed rejuvenating properties of the plant. However, more recent studies have suggested that the active ingredient may actually be the closely related chemical compound deoxymiroestrol (shown below), and the reported presence of miroestrol may only have been an artifact of the isolation procedure."},"fame":10,"pubchemCid":165001,"mass":358.4,"charge":0,"smiles":"CC1([C@H]2C[C@]3(CC(=O)[C@]([C@@H]2[C@H]3O)(C4=COC5=C([C@H]41)C=CC(=C5)O)O)O)C","inchikey":"RJKLDOLOCIQYFS-PRTISISMSA-N","iupac":"(1S,3R,13S,16R,17R,18S)-7,13,16,17-tetrahydroxy-2,2-dimethyl-10-oxapentacyclo[14.2.1.03,12.04,9.013,18]nonadeca-4(9),5,7,11-tetraen-14-one","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"165001","atoms":48,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-5.076,"y":0.687,"z":-0.727,"el":"O"},{"x":-1.623,"y":-2.032,"z":1.684,"el":"O"},{"x":-3.949,"y":1.537,"z":1.679,"el":"O"},{"x":-1.638,"y":-2.547,"z":-1.272,"el":"O"},{"x":2.216,"y":-2.031,"z":-0.139,"el":"O"},{"x":6.407,"y":0.163,"z":-0.188,"el":"O"},{"x":-1.577,"y":1.398,"z":0.049,"el":"C"},{"x":-1.948,"y":0.293,"z":1.082,"el":"C"},{"x":-0.093,"y":1.358,"z":-0.492,"el":"C"},{"x":-3.737,"y":0.34,"z":-0.417,"el":"C"},{"x":-1.385,"y":-1.074,"z":0.656,"el":"C"},{"x":-3.48,"y":0.331,"z":1.084,"el":"C"},{"x":-2.742,"y":1.38,"z":-0.969,"el":"C"},{"x":0.742,"y":0.428,"z":0.474,"el":"C"},{"x":0.118,"y":-0.97,"z":0.434,"el
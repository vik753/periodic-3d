{"version":"2026.10.11-r25","id":"Q617949","formula":"CuS₂","hill":"CuS2","elements":["S","Cu"],"composition":{"S":2.0,"Cu":1.0},"names":{"en":"Villamanínite"},"descriptions":{"en":"Villamanínite is a copper sulfide mineral with small amounts of other elements, belonging to group II according to the Strunz classification. It was discovered in 1920 when studying the copper minerals of the Providencia mine in the municipality of Cármenes, León (Spain). The English researchers who identified it gave it the name of villamaninite when they confused the municipality in which the mine was actually located, because Villamanín is where the ore was loaded onto the railroad for export."},"fame":9,"pubchemCid":null,"mass":null,"charge":0,"smiles":null,"inchikey":null,"iupac":null,"classes":[{"qid":"Q12089225","names":{"en":"mineral species","ru":"действительный вид минералов","uk":"мінеральний вид"}}],"structureInfo":{"kind":"crystal","source":"materialsproject","ref":"mp-1068","atoms":22,"license":"CC BY 4.0, Materials Project"},"structure":{"cell":[[5.779,0.0,0.0],[0.0,5.779,0.0],[0.0,0.0,5.779]],"kind":"crystal","atoms":[{"x":2.89,"y":0.0,"z":2.89,"el":"Cu"},{"x":2.89,"y":5.779,"z":2.89,"el":"Cu"},{"x":0.0,"y":0.0,"z":0.0,"el":"Cu"},{"x":0.0,"y":0.0,"z":5.779,"el":"Cu"},{"x":0.0,"y":5.779,"z":0.0,"el":"Cu"},{"x":0.0,"y":5.779,"z":5.779,"el":"Cu"},{"x":5.779,"y":0.0,"z":0.0,"el":"Cu"},{"x":5.779,"y":0.0,"z":5.779,"el":"Cu"},{"x":5.779,"y":5.779,"z":0.0,"el":"Cu"},{"x":5.779,"y":5.779,"z":5.779,"el":"Cu"},{"x":0.0,"y":2.89,"z":2.89,"el":"Cu"},{"x":5.779,"y":2.89,"z":2.89,"el":"Cu"},{"x":2.89,"y":2.89,"z":0.0,"el":"Cu"},{"x":2.89,"y":2.89,"z":5.779,"el":"Cu"},{"x":5.197,"y":0.582,"z":3.472,"el":"S"},{"x":0.582,"y":5.197,"z":2.308,"el":"S"},{"x":5.197,"y":2.308,"z":0.582,"el":"S"},{"x":3.472,"y":5.197,"z":0.582,"el":"S"},{"x":3.472,"y":3.472,"z":3.472,"el":"S"},{"x":2.308,"y":2.308,"z":2.308,"el":"S"},{"x":2.308,"y":0.582,"z":5.197,"el":"S"},{"x":0.582,"y":3.472,"z":5.197,"el":"
{"version":"2026.10.11-r25","id":"Q27105763","formula":"C₁₆H₁₈N₂O","hill":"C16H18N2O","elements":["H","C","N","O"],"composition":{"C":16.0,"H":18.0,"N":2.0,"O":1.0},"names":{"en":"Amphenone B"},"descriptions":{"en":"Amphenone B, or simply amphenone, also known as 3,3-bis(p-aminophenyl)butan-2-one, is an inhibitor of steroid hormone and thyroid hormone biosynthesis which was never marketed but has been used as a tool in scientific research to study corticosteroids and the adrenal glands. It acts as competitive inhibitor of 11β-hydroxylase, 17α-hydroxylase, 17,20-lyase, 21-hydroxylase, and 3β-hydroxysteroid dehydrogenase, as well as of cholesterol side-chain cleavage enzyme, thereby inhibiting the production of steroid hormones including glucocorticoids, mineralocorticoids, androgens, and estrogens."},"fame":1,"pubchemCid":17591,"mass":254.33,"charge":0,"smiles":"CC(=O)C(C)(C1=CC=C(C=C1)N)C2=CC=C(C=C2)N","inchikey":"MKBVGNJXUNEBAL-UHFFFAOYSA-N","iupac":"3,3-bis(4-aminophenyl)butan-2-one","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"17591","atoms":37,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-0.449,"y":-2.171,"z":1.654,"el":"O"},{"x":-4.767,"y":2.032,"z":0.241,"el":"N"},{"x":4.721,"y":2.015,"z":0.466,"el":"N"},{"x":-0.009,"y":-1.011,"z":-0.466,"el":"C"},{"x":-1.307,"y":-0.18,"z":-0.273,"el":"C"},{"x":1.276,"y":-0.188,"z":-0.213,"el":"C"},{"x":-0.102,"y":-1.566,"z":-1.912,"el":"C"},{"x":0.038,"y":-2.223,"z":0.521,"el":"C"},{"x":-1.251,"y":1.158,"z":-0.535,"el":"C"},{"x":1.449,"y":0.367,"z":1.025,"el":"C"},{"x":-2.426,"y":-0.839,"z":0.148,"el":"C"},{"x":2.17,"y":-0.061,"z":-1.241,"el":"C"},{"x":0.769,"y":-3.474,"z":0.087,"el":"C"},{"x":-2.417,"y":1.903,"z":-0.362,"el":"C"},{"x":2.609,"y":1.109,"z":1.253,"el":"C"},{"x":-3.593,"y":-0.094,"z":0.321,"el":"C"},{"x":3.329,"y":0.681,"z":-
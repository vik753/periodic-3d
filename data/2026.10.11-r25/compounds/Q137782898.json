{"version":"2026.10.11-r25","id":"Q137782898","formula":"C₁₄H₁₉NO","hill":"C14H19NO","elements":["H","C","N","O"],"composition":{"C":14.0,"H":19.0,"N":1.0,"O":1.0},"names":{"en":"N-methyl-N-isopropyl-3-(2-aminoethyl)benzofuran"},"descriptions":{"en":"MiPBF, also known as N-methyl-N-isopropyl-3-(2-aminoethyl)benzofuran or as 1-oxa-N-methyl-N-isopropyltryptamine (1-oxa-MiPT), is a serotonin receptor modulator of the benzofuran family related to the psychedelic tryptamine methylisopropyltryptamine (MiPT). It is the analogue and bioisostere of MiPT in which the indole nitrogen has been replaced with an oxygen atom, making it a benzofuran rather than tryptamine derivative. The drug shows affinity for serotonin receptors, including the serotonin 5-HT1A, 5-HT2A, and 5-HT2B receptors (IC50Tooltip half-maximal inhibitory concentration = 5,000 nM, 500 nM, and 800 nM, respectively)."},"fame":1,"pubchemCid":117044241,"mass":217.31,"charge":0,"smiles":"CC(C)N(C)CCC1=COC2=CC=CC=C21","inchikey":"HNYJKEQVSSYBRE-UHFFFAOYSA-N","iupac":"N-[2-(1-benzofuran-3-yl)ethyl]-N-methylpropan-2-amine","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"rdkit","ref":"117044241","atoms":35,"license":"Computed with RDKit from SMILES (PubChem, Wikidata)"},"structure":{"kind":"molecule","atoms":[{"x":-4.133,"y":-1.436,"z":-0.763,"el":"C"},{"x":-2.858,"y":-0.59,"z":-0.589,"el":"C"},{"x":-2.355,"y":-0.239,"z":-2.001,"el":"C"},{"x":-1.78,"y":-1.262,"z":0.185,"el":"N"},{"x":-2.292,"y":-2.0,"z":1.346,"el":"C"},{"x":-0.752,"y":-0.287,"z":0.628,"el":"C"},{"x":0.607,"y":-0.949,"z":0.926,"el":"C"},{"x":1.658,"y":0.058,"z":1.264,"el":"C"},{"x":2.055,"y":0.452,"z":2.527,"el":"C"},{"x":3.032,"y":1.391,"z":2.462,"el":"O"},{"x":3.281,"y":1.614,"z":1.143,"el":"C"},{"x":4.22,"y":2.511,"z":0.638,"el":"C"},{"x":4.321,"y":2.591,"z":-0.755,"el":"C"},{"x":3.515,"y":1.806,"z":-1.583,"el":"C"},{"x"
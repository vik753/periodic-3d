{"version":"2026.10.11-r25","id":"Q3827022","formula":"Na₄CeTiPO₄Si₇O₁₈*5H₂O","hill":"CeH10Na4O27PSi7Ti","elements":["H","O","Na","Si","P","Ti","Ce"],"composition":{"H":10.0,"O":27.0,"P":1.0,"Ce":1.0,"Na":4.0,"Si":7.0,"Ti":1.0},"names":{"en":"Laplandite-(Ce)"},"descriptions":{"en":"Laplandite has a general formula of Na4CeTiPO4Si7O18•5H2O, and is found primarily in igneous rocks. This silicate mineral has been found as inclusions in pegmatites, primarily in the Kola Peninsula in Lappland, where the mineral's name gets its origin. Laplandite is orthorhombic, which states that crystallographically, it contains three axes of unequal lengths that all intersect at 90 degrees, perpendicular to one another."},"fame":6,"pubchemCid":null,"mass":null,"charge":0,"smiles":null,"inchikey":null,"iupac":null,"classes":[{"qid":"Q12089225","names":{"en":"mineral species","ru":"действительный вид минералов","uk":"мінеральний вид"}}],"structureInfo":null,"structure":null,"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q3827022","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Laplandite-%28Ce%29","license":"CC BY-SA 4.0"},{"role":"photo","name":"Wikimedia Commons","url":"https://commons.wikimedia.org/wiki/File:Laplandite-(Ce).jpg","license":"CC BY-SA 4.0"}],"similar":[{"id":"Q3780191","formula":"NaCa₁₆(Si₂₃Al)O₆₀(OH)₈·14H₂O","names":{"en":"Gyrolite","uk":"Гіроліт"},"elements":["H","O","Na","Al","Si","Ca"],"fame":14,"kind":null},{"id":"Q1936803","formula":"Na₂ZrSi₃O₉·2H₂O","names":{"en":"Catapleiite","ru":"Катаплеит","uk":"Катаплеїт"},"elements":["H","O","Na","Si","Zr"],"fame":13,"kind":null},{"id":"Q411794","formula":"BaCa₄Si₁₆O₃₆(OH)₂·10H₂O","names":{"en":"Macdonaldite","uk":"Макдональдит"},"elements":["H","O","Si","Ca","Ba"],"fame":11,"kind":null},{"id":"Q4000408","formula":"Na₂Zr(Si₄O₁₁)·2H₂O","names":{"en":"Tumchaite"},"elements":["H","O","Na","Si","Zr"],"fame":5,"kind":"crystal"},{"id":"Q2
{"version":"2026.10.11-r25","id":"Q420481","formula":"Cu₂PO₄(OH)","hill":"Cu2HO5P","elements":["H","O","P","Cu"],"composition":{"H":1.0,"O":5.0,"P":1.0,"Cu":2.0},"names":{"en":"Libethenite","ru":"Либетенит","uk":"Лібетеніт"},"descriptions":{"en":"Libethenite is a rare copper phosphate hydroxide mineral. It forms striking, dark green orthorhombic crystals. It was discovered in 1823 in Ľubietová, Slovakia and is named after the German name of that locality (Libethen).","ru":"Либетенит — редкий вторичный минерал из класса фосфатов, относится к группе оливенита. Открыт в 1823 году в шахтёрском городе Любетова (Словакия), в честь немецкого названия которого (Libethen) и получил своё имя. Растворим в кислотах и аммиаке.","uk":"Лібетені́т — рідкісний мінерал, гідроксилфосфат міді острівної будови, групи олівеніту. Вперше знайдений в 1823 році (J.F.A.Breithaupt) біля словацького міста Люб'єтова. Назва мінералу походить від німецького варіанта назви цього населеного пункту — Лібетен (Libethen)."},"fame":17,"pubchemCid":null,"mass":null,"charge":0,"smiles":null,"inchikey":null,"iupac":null,"classes":[{"qid":"Q12089225","names":{"en":"mineral species","ru":"действительный вид минералов","uk":"мінеральний вид"}}],"structureInfo":{"kind":"crystal","source":"materialsproject","ref":"mp-510654","atoms":52,"license":"CC BY 4.0, Materials Project"},"structure":{"cell":[[8.136,0.0,0.0],[0.0,8.522,0.0],[0.0,0.0,5.967]],"kind":"crystal","atoms":[{"x":0.0,"y":4.261,"z":1.485,"el":"Cu"},{"x":8.136,"y":4.261,"z":1.485,"el":"Cu"},{"x":4.068,"y":0.0,"z":1.499,"el":"Cu"},{"x":4.068,"y":8.522,"z":1.499,"el":"Cu"},{"x":0.0,"y":4.261,"z":4.482,"el":"Cu"},{"x":8.136,"y":4.261,"z":4.482,"el":"Cu"},{"x":4.068,"y":0.0,"z":4.468,"el":"Cu"},{"x":4.068,"y":8.522,"z":4.468,"el":"Cu"},{"x":5.195,"y":3.165,"z":2.983,"el":"Cu"},{"x":2.941,"y":5.357,"z":2.983,"el":"Cu"},{"x":1.127,"y":1.096,"z":0.0,"el":"Cu"},{"x":1.127,"y":1.096,"z":5.967,"el":"Cu"},{"x":7.009,"y":7.426,"z":0.0,"el":"Cu"},{"x":7.009,"y":7
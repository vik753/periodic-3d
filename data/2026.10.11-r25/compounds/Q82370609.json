{"version":"2026.10.11-r25","id":"Q82370609","formula":"C₃H₅K","hill":"C3H5K","elements":["H","C","K"],"composition":{"C":3.0,"H":5.0,"K":1.0},"names":{"en":"Potassium prop-2-en-1-ide"},"descriptions":{"en":"Allylpotassium is an organopotassium compound with the molecular formula CH2=CHCH2K. It is a colorless, extremely air-sensitive compound that is usually generated and handled in solution. It is synthesized by metalation of propylene with Schlosser's base, a mixture of potassium tert-butoxide and butyl lithium: CH2=CHCH3 + LiC4H9 + KOC(CH3)3 → KCH2CHCH2 + C4H10 + LiOC(CH3)3 Consistent with its extreme air-sensitivity, allylpotassium is highly nucleophilic. For example, it adds to pyridine, allowing the synthesis of 4-allyl-1,4-dihydropyridines."},"fame":6,"pubchemCid":12859842,"mass":80.17,"charge":0,"smiles":"[CH2-]C=C.[K+]","inchikey":"ZPQJASJRBFXYKB-UHFFFAOYSA-N","iupac":"potassium prop-1-ene","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"rdkit","ref":"12859842","atoms":9,"license":"Computed with RDKit from SMILES (PubChem, Wikidata)"},"structure":{"kind":"molecule","atoms":[{"x":0.951,"y":-0.034,"z":0.281,"el":"C"},{"x":-0.292,"y":0.624,"z":0.003,"el":"C"},{"x":-1.481,"y":0.049,"z":0.211,"el":"C"},{"x":1.882,"y":0.486,"z":0.091,"el":"H"},{"x":0.977,"y":-1.042,"z":0.678,"el":"H"},{"x":-0.24,"y":1.635,"z":-0.394,"el":"H"},{"x":-1.575,"y":-0.957,"z":0.606,"el":"H"},{"x":-2.398,"y":0.584,"z":-0.013,"el":"H"},{"x":2.175,"y":-1.341,"z":-1.464,"el":"K"}],"bonds":[[0,1,1.0],[1,2,2.0],[0,3,1.0],[0,4,1.0],[1,5,1.0],[2,6,1.0],[2,7,1.0]]},"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q82370609","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Allylpotassium","license":"CC BY-SA 4.0"},{"role":"properties","name":"PubChem","url":"https://pubchem.ncbi
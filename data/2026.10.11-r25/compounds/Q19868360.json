{"version":"2026.10.11-r25","id":"Q19868360","formula":"C₄H₉P","hill":"C4H9P","elements":["H","C","P"],"composition":{"C":4.0,"H":9.0,"P":1.0},"names":{"en":"Phospholane"},"descriptions":{"en":"Phospholane is the organophosphorus compound with the formula (CH2)4PH. This colorless liquid is the parent member of a family of five-membered, saturated rings containing phosphorus. Although phospholane itself is only of minor academic interest, the class of C- and P-substituted phospholanes are valued ligands in asymmetric hydrogenation and related areas of homogeneous catalysis. Phospholane is prepared by reduction of 1-chlorophospholane, which in turn is obtained by the reaction of 1-phenylphospholane and phosphorus trichloride."},"fame":5,"pubchemCid":77013,"mass":88.09,"charge":0,"smiles":"C1CCPC1","inchikey":"GWLJTAJEHRYMCA-UHFFFAOYSA-N","iupac":"phospholane","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"77013","atoms":14,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-1.554,"y":-0.004,"z":-0.034,"el":"P"},{"x":1.062,"y":-0.699,"z":0.259,"el":"C"},{"x":1.034,"y":0.72,"z":-0.297,"el":"C"},{"x":-0.266,"y":-1.354,"z":-0.111,"el":"C"},{"x":-0.276,"y":1.336,"z":0.183,"el":"C"},{"x":1.906,"y":-1.271,"z":-0.139,"el":"H"},{"x":1.175,"y":-0.667,"z":1.35,"el":"H"},{"x":1.893,"y":1.302,"z":0.051,"el":"H"},{"x":1.071,"y":0.696,"z":-1.394,"el":"H"},{"x":-0.232,"y":-1.75,"z":-1.131,"el":"H"},{"x":-0.508,"y":-2.172,"z":0.573,"el":"H"},{"x":-0.21,"y":1.591,"z":1.246,"el":"H"},{"x":-0.534,"y":2.238,"z":-0.379,"el":"H"},{"x":-1.697,"y":0.15,"z":-1.434,"el":"H"}],"bonds":[[0,3,1],[0,4,1],[0,13,1],[1,2,1],[1,3,1],[1,5,1],[1,6,1],[2,4,1],[2,7,1],[2,8,1],[3,9,1],[3,10,1],[4,11,1],[4,12,1]]},"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q19868360","license":"CC0 1.0"},
{"version":"2026.10.11-r25","id":"Q5014875","formula":"C₁₄H₁₅N₃O","hill":"C14H15N3O","elements":["H","C","N","O"],"composition":{"C":14.0,"H":15.0,"N":3.0,"O":1.0},"names":{"en":"Cx516"},"descriptions":{"en":"CX-516 is an ampakine and nootropic that acts as an AMPA receptor positive allosteric modulator and had been undergoing development by a collaboration between Cortex, Shire, and Servier. It was studied as a potential treatment for Alzheimer's disease under the brand name Ampalex, and was also being examined as a treatment for ADHD. CX-516 was the first ampakine compound developed by Cortex and while it showed good in vitro activity and positive results in animal tests, the human trials proved disappointing due mainly to low potency and short half-life."},"fame":5,"pubchemCid":148184,"mass":241.29,"charge":0,"smiles":"C1CCN(CC1)C(=O)C2=CC3=NC=CN=C3C=C2","inchikey":"ANDGGVOPIJEHOF-UHFFFAOYSA-N","iupac":"piperidin-1-yl(quinoxalin-6-yl)methanone","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"148184","atoms":33,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-1.603,"y":2.094,"z":-1.367,"el":"O"},{"x":-2.442,"y":0.46,"z":0.079,"el":"N"},{"x":2.706,"y":-1.232,"z":-1.206,"el":"N"},{"x":3.885,"y":0.142,"z":0.902,"el":"N"},{"x":-4.181,"y":-1.808,"z":0.486,"el":"C"},{"x":-4.5,"y":-0.734,"z":-0.554,"el":"C"},{"x":-2.677,"y":-1.896,"z":0.744,"el":"C"},{"x":-3.884,"y":0.607,"z":-0.165,"el":"C"},{"x":-2.094,"y":-0.53,"z":1.099,"el":"C"},{"x":-1.433,"y":1.206,"z":-0.534,"el":"C"},{"x":-0.041,"y":0.928,"z":-0.157,"el":"C"},{"x":0.693,"y":-0.025,"z":-0.855,"el":"C"},{"x":0.542,"y":1.615,"z":0.894,"el":"C"},{"x":2.014,"y":-0.307,"z":-0.518,"el":"C"},{"x":2.611,"y":0.389,"z":0.549,"el":"C"},{"x":1.864,"y":1.341,"z":1.24,"el":"C"},{"x":3.979,"y":-1.464,"z":-0.838,"el":"C"},{"x":4.56,"y":-0.787,"z":0
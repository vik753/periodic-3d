{"version":"2026.10.11-r25","id":"Q5135150","formula":"C₁₆H₁₂Cl₂N₂O","hill":"C16H12Cl2N2O","elements":["H","C","N","O","Cl"],"composition":{"C":16.0,"H":12.0,"N":2.0,"O":1.0,"Cl":2.0},"names":{"en":"Cloroqualone"},"descriptions":{"en":"Cloroqualone is a quinazolinone-class GABAergic and is an analogue of methaqualone developed in the 1980s and marketed mainly in France and some other European countries. It has sedative and antitussive properties resulting from its agonist activity at the β subtype of the GABAa receptor and sigma-1 receptor, and was sold either alone or in combination with other ingredients as a cough medicine. Cloroqualone has weaker sedative properties than methaqualone and was sold for its useful cough-suppressing effects, but was withdrawn from the French market in 1994 because of concerns about its potential for abuse and overdose."},"fame":9,"pubchemCid":63338,"mass":319.2,"charge":0,"smiles":"CCC1=NC2=CC=CC=C2C(=O)N1C3=C(C=CC=C3Cl)Cl","inchikey":"SONHVLIDLXLSOL-UHFFFAOYSA-N","iupac":"3-(2,6-dichlorophenyl)-2-ethylquinazolin-4-one","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"63338","atoms":33,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":1.471,"y":0.269,"z":-2.675,"el":"Cl"},{"x":1.673,"y":-0.661,"z":2.702,"el":"Cl"},{"x":-0.236,"y":-2.233,"z":-0.255,"el":"O"},{"x":0.285,"y":0.036,"z":0.102,"el":"N"},{"x":-1.493,"y":1.607,"z":0.288,"el":"N"},{"x":-0.227,"y":1.321,"z":0.3,"el":"C"},{"x":-2.022,"y":-0.756,"z":-0.042,"el":"C"},{"x":-0.577,"y":-1.069,"z":-0.057,"el":"C"},{"x":0.706,"y":2.474,"z":0.608,"el":"C"},{"x":1.696,"y":-0.217,"z":0.005,"el":"C"},{"x":-2.417,"y":0.573,"z":0.106,"el":"C"},{"x":-2.973,"y":-1.772,"z":-0.198,"el":"C"},{"x":-3.783,"y":0.879,"z":0.096,"el":"C"},{"x":0.291,"y":3.693,"z":-0.178,"el":"C"},{"x":2.331,"y":-0.134,"z":-1.231,"el":"C"},
{"version":"2026.10.11-r25","id":"Q82360007","formula":"C₄F₇N","hill":"C4F7N","elements":["C","N","F"],"composition":{"C":4.0,"F":7.0,"N":1.0},"names":{"en":"Perfluoroisobutyronitrile"},"descriptions":{"en":"C4-FN (C4-fluoronitrile, C4FN) is a perfluorinated compound developed as an extremely high-dielectric gas for high-voltage switchgear. It has the structure (CF3)2CFC≡N, which can be described as perfluoroisobutyronitrile, falling under the category of PFAS, or per- and polyfluoroalkyl substances. It is promoted as an alternative to sulfur hexafluoride (SF6) for interruption and insulation applications, as it has insulation properties twice that of SF6 and a relatively low global warming potential (GWP) compared to SF6, which is the most potent known greenhouse gas."},"fame":3,"pubchemCid":12633773,"mass":195.04,"charge":0,"smiles":"C(#N)C(C(F)(F)F)(C(F)(F)F)F","inchikey":"AASDJASZOZGYMM-UHFFFAOYSA-N","iupac":"2,3,3,3-tetrafluoro-2-(trifluoromethyl)propanenitrile","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"12633773","atoms":12,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":0.0,"y":-0.203,"z":-1.742,"el":"F"},{"x":2.373,"y":-0.126,"z":-0.415,"el":"F"},{"x":1.269,"y":1.748,"z":-0.242,"el":"F"},{"x":1.366,"y":0.382,"z":1.451,"el":"F"},{"x":-1.364,"y":0.391,"z":1.452,"el":"F"},{"x":-2.364,"y":-0.13,"z":-0.412,"el":"F"},{"x":-1.275,"y":1.752,"z":-0.252,"el":"F"},{"x":-0.007,"y":-2.787,"z":0.317,"el":"N"},{"x":0.0,"y":-0.25,"z":-0.378,"el":"C"},{"x":1.263,"y":0.442,"z":0.104,"el":"C"},{"x":-1.257,"y":0.449,"z":0.105,"el":"C"},{"x":-0.004,"y":-1.667,"z":0.011,"el":"C"}],"bonds":[[0,8,1],[1,9,1],[2,9,1],[3,9,1],[4,10,1],[5,10,1],[6,10,1],[7,11,3],[8,9,1],[8,10,1],[8,11,1]]},"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q82360007","license":"CC0 1
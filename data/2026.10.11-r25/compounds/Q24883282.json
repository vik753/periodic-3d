{"version":"2026.10.11-r25","id":"Q24883282","formula":"C₂₀H₂₄O₂","hill":"C20H24O2","elements":["H","C","O"],"composition":{"C":20.0,"H":24.0,"O":2.0},"names":{"en":"Dimestrol"},"descriptions":{"en":"Dimestrol (brand names Depot-Cyren, Depot-Oestromon), also known as dianisylhexene, 4,4'-dimethoxy-α,α'-diethylstilbene, diethylstilbestrol dimethyl ether, and dimethoxydiethylstilbestrol, is a synthetic nonsteroidal estrogen of the stilbestrol group which is related to diethylstilbestrol. It has been used clinically as a hormonal therapy in cases of delayed female puberty, hypogonadism, menopausal, and postmenopausal symptoms. It is known to induce the development of female secondary sexual characteristics in the case of female delayed puberty or hypogonadism."},"fame":3,"pubchemCid":3032539,"mass":296.4,"charge":0,"smiles":"CC/C(=C(/CC)\\C1=CC=C(C=C1)OC)/C2=CC=C(C=C2)OC","inchikey":"VQOAQMIKPYNCMV-FMQUCBEESA-N","iupac":"1-methoxy-4-[(E)-4-(4-methoxyphenyl)hex-3-en-3-yl]benzene","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"3032539","atoms":46,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-5.989,"y":-0.153,"z":0.232,"el":"O"},{"x":5.989,"y":0.153,"z":0.231,"el":"O"},{"x":-0.425,"y":0.529,"z":0.232,"el":"C"},{"x":0.425,"y":-0.528,"z":0.233,"el":"C"},{"x":0.016,"y":1.979,"z":0.285,"el":"C"},{"x":-0.016,"y":-1.978,"z":0.287,"el":"C"},{"x":-1.897,"y":0.349,"z":0.232,"el":"C"},{"x":1.896,"y":-0.349,"z":0.233,"el":"C"},{"x":0.232,"y":2.568,"z":-1.103,"el":"C"},{"x":-0.231,"y":-2.569,"z":-1.101,"el":"C"},{"x":-2.562,"y":0.269,"z":1.44,"el":"C"},{"x":2.561,"y":-0.267,"z":1.44,"el":"C"},{"x":-2.561,"y":0.266,"z":-0.976,"el":"C"},{"x":2.561,"y":-0.268,"z":-0.976,"el":"C"},{"x":-3.946,"y":0.099,"z":1.44,"el":"C"},{"x":3.946,"y":-0.097,"z":1.44,"el":"C"},{"x":-3.945,"y":0.097,"z":-0.976,"el":"C"}
{"version":"2026.10.11-r25","id":"Q21099654","formula":"C₁₈H₁₄O₃","hill":"C18H14O3","elements":["H","C","O"],"composition":{"C":18.0,"H":14.0,"O":3.0},"names":{"en":"Dihydrotanshinone I"},"descriptions":{"en":"Dihydrotanshinone I (DI) is a naturally occurring compound extracted from Salvia miltiorrhiza Bunge, also known as Chinese sage, red sage root, and the Chinese herbal Dan Shen. It belongs to a class of lipophilic abietane diterpenoids and has been reported to have cytotoxicity to a variety of tumor cells, as well as antiviral effects in vitro. In a study Dihydrotanshinone I inhibited the 17,20-lyase activity of CYP17A1 while having minor impact on 17α-hydroxylase and CYP21A2 activities ."},"fame":3,"pubchemCid":11425923,"mass":278.3,"charge":0,"smiles":"C[C@H]1COC2=C1C(=O)C(=O)C3=C2C=CC4=C(C=CC=C43)C","inchikey":"HARGZZNYNSYSGJ-JTQLQIEISA-N","iupac":"(1R)-1,6-dimethyl-1,2-dihydronaphtho[1,2-g][1]benzofuran-10,11-dione","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"11425923","atoms":35,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":2.486,"y":-2.152,"z":-0.111,"el":"O"},{"x":2.826,"y":2.481,"z":-0.208,"el":"O"},{"x":0.222,"y":2.793,"z":-0.034,"el":"O"},{"x":4.062,"y":-0.306,"z":-0.16,"el":"C"},{"x":2.651,"y":0.131,"z":-0.137,"el":"C"},{"x":1.846,"y":-0.92,"z":-0.108,"el":"C"},{"x":3.857,"y":-1.807,"z":-0.424,"el":"C"},{"x":0.39,"y":-0.835,"z":-0.058,"el":"C"},{"x":-0.259,"y":0.424,"z":-0.046,"el":"C"},{"x":2.123,"y":1.485,"z":-0.147,"el":"C"},{"x":-1.691,"y":0.511,"z":-0.004,"el":"C"},{"x":4.773,"y":-0.047,"z":1.164,"el":"C"},{"x":0.625,"y":1.641,"z":-0.073,"el":"C"},{"x":-2.428,"y":-0.704,"z":0.03,"el":"C"},{"x":-0.376,"y":-2.002,"z":-0.025,"el":"C"},{"x":-1.764,"y":-1.935,"z":0.02,"el":"C"},{"x":-3.833,"y":-0.697,"z":0.073,"el":"C"},{"x":-2.462,"y":1.705,"z":0.004,"el":"C"},{"
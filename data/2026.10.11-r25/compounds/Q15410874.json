{"version":"2026.10.11-r25","id":"Q15410874","formula":"C₂₃H₂₁F₆NO₃","hill":"C23H21F6NO3","elements":["H","C","N","O","F"],"composition":{"C":23.0,"F":6.0,"H":21.0,"N":1.0,"O":3.0},"names":{"en":"CI-966"},"descriptions":{"en":"CI-966 is a central nervous system depressant acting as a GABA reuptake inhibitor, specifically a highly potent and selective blocker of the GABA transporter 1 (GAT-1) (IC50 = 0.26 μM), and hence indirect and non-selective GABA receptor full agonist. It was investigated as a potential anticonvulsant, anxiolytic, and neuroprotective therapeutic but was discontinued during clinical development due to the incidence of severe adverse effects at higher doses and hence was never marketed. In a phase I human clinical trial while under development for the treatment of epilepsy, CI-966 was assessed at doses of 1 to 10 mg, 25 mg, and 50 mg."},"fame":4,"pubchemCid":198693,"mass":473.4,"charge":0,"smiles":"C1CN(CC(=C1)C(=O)O)CCOC(C2=CC=C(C=C2)C(F)(F)F)C3=CC=C(C=C3)C(F)(F)F","inchikey":"CMHQDSBIBSKHFP-UHFFFAOYSA-N","iupac":"1-[2-[bis[4-(trifluoromethyl)phenyl]methoxy]ethyl]-3,6-dihydro-2H-pyridine-5-carboxylic acid","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"198693","atoms":54,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":0.166,"y":-5.84,"z":-0.895,"el":"F"},{"x":1.512,"y":-5.313,"z":0.722,"el":"F"},{"x":-0.591,"y":-5.678,"z":1.137,"el":"F"},{"x":-7.291,"y":1.678,"z":-0.972,"el":"F"},{"x":-7.174,"y":0.956,"z":1.07,"el":"F"},{"x":-6.747,"y":3.043,"z":0.631,"el":"F"},{"x":-0.104,"y":1.326,"z":0.236,"el":"O"},{"x":6.059,"y":-0.668,"z":0.612,"el":"O"},{"x":7.452,"y":0.264,"z":-0.943,"el":"O"},{"x":3.38,"y":2.517,"z":0.068,"el":"N"},{"x":4.022,"y":3.711,"z":0.634,"el":"C"},{"x":2.029,"y":2.345,"z":0.601,"el":"C"},{"x":4.196,"y":1.314,"z":0.323,"el":"C"},{"x":5.38,"y":3.963,
{"version":"2026.10.11-r25","id":"Q18358912","formula":"C₇H₁₁N₃O₂S","hill":"C7H11N3O2S","elements":["H","C","N","O","S"],"composition":{"C":7.0,"H":11.0,"N":3.0,"O":2.0,"S":1.0},"names":{"en":"Ovothiol A"},"descriptions":{"en":"Ovothiol A (N1-methyl-4-mercaptohistidine) is a highly reducing antioxidant which accumulates to very high levels in the eggs of certain marine invertebrates, including sea urchins, scallops and starfish, where it acts to quench the hydrogen peroxide released during fertilization. This thiol-type antioxidant is also found in some human pathogens such as Trypanosoma cruzi and Leishmania donovani. It is synthesized by the addition and oxidation of cysteine to histidine by 5-histidylcysteine sulfoxide synthase, followed by methylation and further reduction."},"fame":3,"pubchemCid":130131,"mass":201.25,"charge":0,"smiles":"CN1C=NC(=C1C[C@@H](C(=O)O)N)S","inchikey":"XWKKYVJREGXHFO-BYPYZUCNSA-N","iupac":"(2S)-2-amino-3-(3-methyl-5-sulfanylimidazol-4-yl)propanoic acid","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"130131","atoms":24,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":0.399,"y":-2.562,"z":0.777,"el":"S"},{"x":-1.704,"y":-1.088,"z":-1.402,"el":"O"},{"x":-3.223,"y":-0.779,"z":0.262,"el":"O"},{"x":1.844,"y":0.936,"z":-0.09,"el":"N"},{"x":-2.497,"y":1.895,"z":0.277,"el":"N"},{"x":2.519,"y":-1.173,"z":-0.256,"el":"N"},{"x":-0.427,"y":0.758,"z":0.932,"el":"C"},{"x":0.856,"y":0.162,"z":0.399,"el":"C"},{"x":-1.504,"y":0.908,"z":-0.151,"el":"C"},{"x":1.265,"y":-1.121,"z":0.299,"el":"C"},{"x":2.838,"y":0.082,"z":-0.478,"el":"C"},{"x":1.881,"y":2.375,"z":-0.2,"el":"C"},{"x":-2.249,"y":-0.394,"z":-0.37,"el":"C"},{"x":-0.797,"y":0.148,"z":1.766,"el":"H"},{"x":-0.2,"y":1.738,"z":1.374,"el":"H"},{"x":-1.082,"y":1.253,"z":-1.102,"el":"H"},{"x":3.767,"y":0.427,"z":-0.913,
{"version":"2026.10.11-r25","id":"Q4802769","formula":"C₂₈H₂₉NO₄S","hill":"C28H29NO4S","elements":["H","C","N","O","S"],"composition":{"C":28.0,"H":29.0,"N":1.0,"O":4.0,"S":1.0},"names":{"en":"Arzoxifene"},"descriptions":{"en":"Arzoxifene (INNTooltip International Nonproprietary Name; developmental code name LY-353381) is a selective estrogen receptor modulator (SERM) of the benzothiophene group which was never marketed. It is a potent estrogen antagonist in mammary and uterine tissue while acting as an estrogen agonist to maintain bone density and lower serum cholesterol. Arzoxifene is a highly effective agent for prevention of mammary cancer induced in the rat by the carcinogen nitrosomethylurea and is significantly more potent than raloxifene in this regard."},"fame":6,"pubchemCid":179337,"mass":475.6,"charge":0,"smiles":"COC1=CC=C(C=C1)C2=C(C3=C(S2)C=C(C=C3)O)OC4=CC=C(C=C4)OCCN5CCCCC5","inchikey":"MCGDSOGUHLTADD-UHFFFAOYSA-N","iupac":"2-(4-methoxyphenyl)-3-[4-(2-piperidin-1-ylethoxy)phenoxy]-1-benzothiophen-6-ol","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"179337","atoms":63,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":4.259,"y":-1.603,"z":-0.996,"el":"S"},{"x":-2.608,"y":2.351,"z":-0.298,"el":"O"},{"x":2.382,"y":0.753,"z":1.413,"el":"O"},{"x":8.412,"y":1.512,"z":-1.093,"el":"O"},{"x":-1.652,"y":-4.196,"z":0.275,"el":"O"},{"x":-5.965,"y":0.847,"z":-0.527,"el":"N"},{"x":-6.97,"y":0.833,"z":-1.599,"el":"C"},{"x":-6.537,"y":1.345,"z":0.731,"el":"C"},{"x":-8.164,"y":-0.048,"z":-1.225,"el":"C"},{"x":-7.717,"y":0.482,"z":1.181,"el":"C"},{"x":-8.784,"y":0.391,"z":0.096,"el":"C"},{"x":-4.81,"y":1.654,"z":-0.919,"el":"C"},{"x":-3.714,"y":1.567,"z":0.131,"el":"C"},{"x":-1.367,"y":1.953,"z":0.127,"el":"C"},{"x":3.271,"y":0.124,"z":0.58,"el":"C"},{"x":4.56,"y":0.635,"z":0.264,"el":"C"},
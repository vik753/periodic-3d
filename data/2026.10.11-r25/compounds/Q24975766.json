{"version":"2026.10.11-r25","id":"Q24975766","formula":"C₂₉H₃₇N₅O₃","hill":"C29H37N5O3","elements":["H","C","N","O"],"composition":{"C":29.0,"H":37.0,"N":5.0,"O":3.0},"names":{"en":"Filibuvir"},"descriptions":{"en":"Filibuvir (also known as PF-00868554, PF-868554) was a non-nucleoside orally available NS5B inhibitor developed by Pfizer for the treatment of hepatitis C. It binds to the non-catalytic Thumb II allosteric pocket of NS5B viral polymerase and causes a decrease in viral RNA synthesis. It is a potent and selective inhibitor, with a mean IC50 of 0.019 μM against genotype 1 polymerases. Several filibuvir-resistant mutations have been identified, M423 being the most common that occurred after filibuvir monotherapy."},"fame":3,"pubchemCid":54708673,"mass":503.6,"charge":0,"smiles":"CCC1=CC(=CC(=N1)CC)CC[C@@]2(CC(=C(C(=O)O2)CC3=NN4C(=CC(=NC4=N3)C)C)O)C5CCCC5","inchikey":"SLVAPEZTBDBAPI-GDLZYMKVSA-N","iupac":"(2R)-2-cyclopentyl-2-[2-(2,6-diethyl-4-pyridinyl)ethyl]-5-[(5,7-dimethyl-[1,2,4]triazolo[1,5-a]pyrimidin-2-yl)methyl]-4-hydroxy-3H-pyran-6-one","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"rdkit","ref":"54708673","atoms":74,"license":"Computed with RDKit from SMILES (PubChem, Wikidata)"},"structure":{"kind":"molecule","atoms":[{"x":-6.367,"y":2.239,"z":0.313,"el":"C"},{"x":-6.663,"y":0.955,"z":1.071,"el":"C"},{"x":-5.628,"y":-0.104,"z":0.796,"el":"C"},{"x":-4.452,"y":-0.155,"z":1.54,"el":"C"},{"x":-3.496,"y":-1.129,"z":1.242,"el":"C"},{"x":-3.776,"y":-2.039,"z":0.22,"el":"C"},{"x":-4.971,"y":-1.925,"z":-0.484,"el":"C"},{"x":-5.886,"y":-0.965,"z":-0.216,"el":"N"},{"x":-5.278,"y":-2.857,"z":-1.626,"el":"C"},{"x":-4.668,"y":-2.36,"z":-2.928,"el":"C"},{"x":-2.205,"y":-1.204,"z":2.01,"el":"C"},{"x":-1.257,"y":-0.006,"z":1.853,"el":"C"},{"x":-0.543,"y":0.21,"z":0.476,"el":"C"},{"x":0.102,"y":-1.069,"z":-0.089,"el":"C"},{"x":1.243,"y
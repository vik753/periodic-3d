{"version":"2026.10.11-r25","id":"Q3758030","formula":"BiF₃","hill":"BiF3","elements":["F","Bi"],"composition":{"F":3.0,"Bi":1.0},"names":{"en":"Gananite"},"descriptions":{"en":"Gananite (simplified Chinese: 赣南矿; traditional Chinese: 贛南礦; pinyin: gànnánkuàng) is a rare bismuth fluoride mineral form of bismuth trifluoride with a general formula of BiF3. Gananite is an isotropic mineral that belongs to the space group P43m. This means that gananite does not show any colors in cross polarized light, because when polarized light passes through it, it does not split into two perpendicular rays."},"fame":5,"pubchemCid":null,"mass":null,"charge":0,"smiles":null,"inchikey":null,"iupac":null,"classes":[{"qid":"Q12089225","names":{"en":"mineral species","ru":"действительный вид минералов","uk":"мінеральний вид"}}],"structureInfo":{"kind":"crystal","source":"materialsproject","ref":"mp-23237","atoms":16,"license":"CC BY 4.0, Materials Project"},"structure":{"cell":[[6.548,0.0,0.0],[0.0,7.068,0.0],[0.0,0.0,4.675]],"kind":"crystal","atoms":[{"x":4.16,"y":5.301,"z":4.47,"el":"Bi"},{"x":5.662,"y":1.767,"z":2.133,"el":"Bi"},{"x":0.886,"y":5.301,"z":2.542,"el":"Bi"},{"x":2.388,"y":1.767,"z":0.205,"el":"Bi"},{"x":1.084,"y":3.101,"z":1.723,"el":"F"},{"x":2.19,"y":3.967,"z":4.06,"el":"F"},{"x":4.358,"y":0.433,"z":0.615,"el":"F"},{"x":5.464,"y":6.635,"z":2.952,"el":"F"},{"x":3.47,"y":1.767,"z":2.843,"el":"F"},{"x":6.352,"y":5.301,"z":0.506,"el":"F"},{"x":0.196,"y":1.767,"z":4.169,"el":"F"},{"x":3.078,"y":5.301,"z":1.832,"el":"F"},{"x":1.084,"y":0.433,"z":1.723,"el":"F"},{"x":2.19,"y":6.635,"z":4.06,"el":"F"},{"x":4.358,"y":3.101,"z":0.615,"el":"F"},{"x":5.464,"y":3.967,"z":2.952,"el":"F"}],"bonds":[[2,11,1],[1,8,1],[1,15,1],[2,4,1],[3,4,1],[3,12,1],[0,15,1],[1,6,1],[1,14,1],[2,5,1],[2,13,1],[0,7,1],[0,5,1],[0,13,1],[3,6,1],[3,14,1]],"cellOrigin":[0,0,0]},"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q3758030","license":"CC0 1.0"},{"role":"descripti
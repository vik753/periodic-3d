{"version":"2026.10.11-r25","id":"Q409470","formula":"Al₂Si₄O₁₀(OH)₂","hill":"Al2H2O12Si4","elements":["H","O","Al","Si"],"composition":{"H":2.0,"O":12.0,"Al":2.0,"Si":4.0},"names":{"en":"Pyrophyllite","ru":"Пирофиллит","uk":"Пірофіліт"},"descriptions":{"en":"Pyrophyllite is a phyllosilicate mineral composed of aluminium silicate hydroxide: Al2Si4O10(OH)2. It occurs in two forms (habits): crystalline folia and compact masses; distinct crystals are not known. The folia have a pronounced pearly luster, owing to the presence of a perfect cleavage parallel to their surfaces: they are flexible but not elastic, and are usually arranged radially in fan-like or spherical groups.","ru":"Пирофилли́т — (англ. pyrofylite) минерал класса силикатов слоистого строения. Название — от др.-греч.","uk":"Пірофілі́т — мінерал класу силікатів шаруватої будови. Від пір… і грецьк. «філлон» — лист (має властивість розщеплюватися на листочки при нагріванні)."},"fame":27,"pubchemCid":null,"mass":null,"charge":0,"smiles":null,"inchikey":null,"iupac":null,"classes":[{"qid":"Q12089225","names":{"en":"mineral species","ru":"действительный вид минералов","uk":"мінеральний вид"}}],"structureInfo":null,"structure":null,"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q409470","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Pyrophyllite","license":"CC BY-SA 4.0"},{"role":"description","name":"Wikipedia (ru)","url":"https://ru.wikipedia.org/wiki/%D0%9F%D0%B8%D1%80%D0%BE%D1%84%D0%B8%D0%BB%D0%BB%D0%B8%D1%82","license":"CC BY-SA 4.0"},{"role":"description","name":"Wikipedia (uk)","url":"https://uk.wikipedia.org/wiki/%D0%9F%D1%96%D1%80%D0%BE%D1%84%D1%96%D0%BB%D1%96%D1%82","license":"CC BY-SA 4.0"},{"role":"photo","name":"Wikimedia Commons","url":"https://commons.wikimedia.org/wiki/File:Pyrophyllite-386094.jpg","license":"Public domain"}],"similar":[{"id":"Q2631888","formula":"NaAl₂(Si₃Al)O₁₀(OH)₂","names":{"en":"Paragonite","ru":"Парагонит","uk":"Парагоніт"},"elements":["H","O","Na","Al","Si"],"fame":19,"kind":"crystal"},{"id":"Q106532","formula":"KAl₂(Si₃Al)O₁₀(OH)₂","names":{"en":"Muscovite","ru":"Мусковит","uk":"Мусковіт"},"elements":["H","O","Al","Si","K"],"fame":51,"kind":"crystal"},{"id":"Q1920794","formula":"Na(Li₁.₅Al₁.₅)Al₆(Si₆O₁₈)(BO₃)₃(OH)₃(OH)","names":{"en":"Elbaite","ru":"Эльбаит","uk":"Ельбаїт"},"elements":["H","Li","B","O","Na","Al","Si"],"fame":23,"kind":null},{"id":"Q2482759","formula":"NaMg₃Al₆(Si₆O₁₈)(BO₃)₃(OH)₃OH","names":{"en":"Dravite","uk":"Дравіт"},"elements":["H","B","O","Na","Mg","Al","Si"],"fame":16,"kind":null},{"id":"Q2411340","formula":"Na(Fe₃)Al₆(Si₆O₁₈)(BO₃)₃(OH)₃(OH)","names":{"en":"Schorl","ru":"Чёрный турмалин","uk":"Шерл"},"elements":["H","B","O","Na","Al","Si","Fe"],"fame":22,"kind":null},{"id":"Q2481488","formula":"CaAl₂(Si₂Al₂)O₁₀(OH)₂","names":{"en":"Margarite","ru":"Маргарит","uk":"Маргарит"},"elements":["H","O","Al","Si","Ca"],"fame":16,"kind":"crystal"},{"id":"Q1077246","formula":"CaMg₃(Al₅Mg)(Si₆O₁₈)(BO₃)₃(OH)₃F","names":{"en":"Fluor-uvite"},"elements":["H","B","O","F","Mg","Al","Si","Ca"],"fame":11,"kind":null},{"id":"Q926914","formula":"Mn₂Al₃(SiO₄)(Si₂O₇)(OH)₃","names":{"en":"Sursassite"},"elements":["H","O","Al","Si","Mn"],"fame":8,"kind":null}],"photo":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/3/36/Pyrophyllite-386094.jpg/960px-Pyrophyllite-386094.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Pyrophyllite-386094.jpg","license":"Public domain","author":"John Krygier","licenseUrl":null}}
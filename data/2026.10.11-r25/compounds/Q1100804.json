{"version":"2026.10.11-r25","id":"Q1100804","formula":"CD₄O","hill":"CH4O","elements":["H","C","O"],"composition":{"C":1.0,"H":4.0,"O":1.0},"names":{"en":"Deuterated methanol"},"descriptions":{"en":"Deuterated methanol (CD3OD) is a form (called an isotopologue) of methanol (CH3OH) in which the hydrogen atoms (\"H\") are replaced with deuterium (heavy hydrogen) isotope (\"D\"). Deuterated methanol is a common solvent used in NMR spectroscopy. Deuterated methanol was first detected in interstellar space in the Kleinmann–Low Nebula in 1988 by scientists at the Max Planck Institute for Radio Astronomy."},"fame":14,"pubchemCid":71568,"mass":36.066,"charge":0,"smiles":"[2H]C([2H])([2H])O[2H]","inchikey":"OKKJLVBELUTLKV-MZCSYVLQSA-N","iupac":"trideuterio(deuteriooxy)methane","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"71568","atoms":6,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":0.708,"y":0.0,"z":0.0,"el":"O"},{"x":-0.708,"y":0.0,"z":0.0,"el":"C"},{"x":-1.073,"y":-0.769,"z":0.685,"el":"H"},{"x":-1.073,"y":-0.195,"z":-1.011,"el":"H"},{"x":-1.063,"y":0.979,"z":0.331,"el":"H"},{"x":0.994,"y":-0.88,"z":-0.298,"el":"H"}],"bonds":[[0,1,1],[0,5,1],[1,2,1],[1,3,1],[1,4,1]]},"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q1100804","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Deuterated_methanol","license":"CC BY-SA 4.0"},{"role":"properties","name":"PubChem","url":"https://pubchem.ncbi.nlm.nih.gov/compound/71568","license":"PubChem (NIH), public data"},{"role":"structure","name":"PubChem 3D","url":"https://pubchem.ncbi.nlm.nih.gov/compound/71568#section=3D-Conformer","license":"PubChem (NIH), public data"}],"similar":[{"id":"Q14982","formula":"CH₄O","names":{"en":"Methanol","ru":"Метанол","uk":"Мета
{"version":"2026.10.11-r25","id":"Q905989","formula":"Bi·Cd·Pb·Sn","hill":"BiCdPbSn","elements":["Cd","Sn","Pb","Bi"],"composition":{"Bi":1.0,"Cd":1.0,"Pb":1.0,"Sn":1.0},"names":{"en":"Wood's metal","ru":"Сплав Вуда","uk":"Сплав Вуда"},"descriptions":{"en":"Wood's metal, also known as Lipowitz's alloy or by the commercial names Cerrobend, Bendalloy, Pewtalloy and MCP 158, is a fusible metal alloy (having a low melting point) that is useful for soldering and making custom metal parts. The alloy is named for Barnabas Wood, who invented and patented the alloy in 1860. It is a eutectic alloy of 50% bismuth, 26.7% lead, 13.3% tin, and 10% cadmium by mass.","ru":"Сплав Вуда — легкоплавкий сплав, изобретённый в 1860 году американским дантистом Барнабасом Вудом (Barnabas Wood). Температура плавления — 60—68,5 °C, плотность — 9720 кг/м³. Как и чистый висмут, сплав Вуда обладает температурной аномалией, т.е.","uk":"Сплав Вуда — легкоплавкий сплав на основі вісмуту, винайдений в 1860 році Б. Вудом. Температура плавлення 68,5 °C, густина 9720 кг/м³."},"fame":23,"pubchemCid":null,"mass":null,"charge":0,"smiles":null,"inchikey":null,"iupac":null,"classes":[{"qid":"Q37756","names":{"en":"alloy","ru":"сплав","uk":"сплави"}}],"structureInfo":null,"structure":null,"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q905989","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Wood%27s_metal","license":"CC BY-SA 4.0"},{"role":"description","name":"Wikipedia (ru)","url":"https://ru.wikipedia.org/wiki/%D0%A1%D0%BF%D0%BB%D0%B0%D0%B2_%D0%92%D1%83%D0%B4%D0%B0","license":"CC BY-SA 4.0"},{"role":"description","name":"Wikipedia (uk)","url":"https://uk.wikipedia.org/wiki/%D0%A1%D0%BF%D0%BB%D0%B0%D0%B2_%D0%92%D1%83%D0%B4%D0%B0","license":"CC BY-SA 4.0"},{"role":"photo","name":"Wikimedia Commons","url":"https://commons.wikimedia.org/wiki/File:Wood%27s_alloy_2.JPG","license":"CC BY-SA 3.0"}],"similar":[{"id":"Q901189","formula":"Bi·Pb·Sn","names":{"en":"Rose's metal","ru":"Сплав Розе","uk":"Сплав Розе"},"elements":["Sn","Pb","Bi"],"fame":16,"kind":null},{"id":"Q3817032","formula":"Bi·Pb·Sn","names":{"en":"Newton's metal","ru":"Металл Ньютона","uk":"Сплав Ньютона"},"elements":["Sn","Pb","Bi"],"fame":9,"kind":null},{"id":"Q15627949","formula":"CdSb","names":{"ru":"Антимонид кадмия"},"elements":["Cd","Sb"],"fame":1,"kind":"crystal"},{"id":"Q1427612","formula":"Cu·Pb·Sn","names":{"en":"Potin","ru":"Потин","uk":"Потін (сплав)"},"elements":["Cu","Sn","Pb"],"fame":8,"kind":null},{"id":"Q852372","formula":"Pb·Sn","names":{"en":"Pewter","ru":"Пьютер","uk":"П’ютер"},"elements":["Sn","Pb"],"fame":35,"kind":"crystal"},{"id":"Q131298597","formula":"Bi·In·Pb·Sn","names":{"en":"Cerrolow 136"},"elements":["In","Sn","Pb","Bi"],"fame":2,"kind":null},{"id":"Q34095","formula":"Cu·Sn","names":{"en":"Bronze","ru":"Бронза","uk":"Бронза"},"elements":["Cu","Sn"],"fame":135,"kind":"crystal"},{"id":"Q1014287","formula":"Cd₃As₂","names":{"en":"Cadmium arsenide","ru":"Диарсенид трикадмия"},"elements":["As","Cd"],"fame":17,"kind":"crystal"}],"photo":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/43/Wood%27s_alloy_2.JPG/960px-Wood%27s_alloy_2.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Wood%27s_alloy_2.JPG","license":"CC BY-SA 3.0","author":"GOKLuLe","licenseUrl":"https://creativecommons.org/licenses/by-sa/3.0"}}
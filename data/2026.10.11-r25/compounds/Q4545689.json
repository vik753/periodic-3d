{"version":"2026.10.11-r25","id":"Q4545689","formula":"C₂H₃NS₂","hill":"C2H3NS2","elements":["H","C","N","S"],"composition":{"C":2.0,"H":3.0,"N":1.0,"S":2.0},"names":{"en":"1,4,2-Dithiazole"},"descriptions":{"en":"1,4,2-Dithiazole is a heterocyclic compound consisting of an unsaturated five-membered ring containing two carbon atoms, one nitrogen atom, and two sulfur atoms. 1,4,2-Dithiazole compounds may be formed by the reaction of nitrile sulfide (formed by the thermolysis of oxathiazolone) with various reactive species; for instance thiocarbonyls via a 1,3-dipolar cycloaddition reaction. These compounds may be protonated by strong acids to give synthetically useful aromatic cations."},"fame":8,"pubchemCid":21943157,"mass":105.19,"charge":0,"smiles":"C1SC=NS1","inchikey":"MNNJLAZJQBWSST-UHFFFAOYSA-N","iupac":"1,4,2-dithiazole","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"21943157","atoms":8,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-1.54,"y":0.042,"z":-0.17,"el":"S"},{"x":1.309,"y":0.719,"z":-0.189,"el":"S"},{"x":0.917,"y":-0.893,"z":0.086,"el":"N"},{"x":-0.348,"y":1.325,"z":0.216,"el":"C"},{"x":-0.338,"y":-1.193,"z":0.056,"el":"C"},{"x":-0.565,"y":2.234,"z":-0.351,"el":"H"},{"x":-0.394,"y":1.559,"z":1.284,"el":"H"},{"x":-0.667,"y":-2.235,"z":0.188,"el":"H"}],"bonds":[[0,3,1],[0,4,1],[1,2,1],[1,3,1],[2,4,2],[3,5,1],[3,6,1],[4,7,1]]},"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q4545689","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/1%2C4%2C2-Dithiazole","license":"CC BY-SA 4.0"},{"role":"properties","name":"PubChem","url":"https://pubchem.ncbi.nlm.nih.gov/compound/21943157","license":"PubChem (NIH), public data"},{"role":"structure","name":"PubChem 3D","url":"https://pubchem.ncbi
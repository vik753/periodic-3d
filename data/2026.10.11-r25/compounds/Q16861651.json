{"version":"2026.10.11-r25","id":"Q16861651","formula":"BaCa₆[(SiO₄)(PO₄)](PO₄)₂F","hill":"BaCa6FO16P3Si","elements":["O","F","Si","P","Ca","Ba"],"composition":{"F":1.0,"O":16.0,"P":3.0,"Ba":1.0,"Ca":6.0,"Si":1.0},"names":{"en":"Zadovite"},"descriptions":{"en":"Zadovite is an extremely rare mineral with formula BaCa6[(SiO4)(PO4)](PO4)2F. Together with its vanadium-analogue, aradite, zadovite occur in paralavas (type of pyrometamorphic rocks). Both minerals have structures similar to nabimusaite, and these three minerals occur in the Hatrurim Formation of Israel. Structure of all three minerals is related to that of hatrurite."},"fame":5,"pubchemCid":null,"mass":null,"charge":0,"smiles":null,"inchikey":null,"iupac":null,"classes":[{"qid":"Q12089225","names":{"en":"mineral species","ru":"действительный вид минералов","uk":"мінеральний вид"}}],"structureInfo":null,"structure":null,"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q16861651","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Zadovite","license":"CC BY-SA 4.0"},{"role":"photo","name":"Wikimedia Commons","url":"https://commons.wikimedia.org/wiki/File:BSE_images_of_paralava_with_walstromite_(B).png","license":"CC BY 4.0"}],"similar":[{"id":"Q413478","formula":"Ca₅(PO₄)₃(OH)","names":{"en":"Hydroxylapatite","ru":"Гидроксиапатит","uk":"Гідроксилапатит"},"elements":["H","O","P","Ca"],"fame":37,"kind":"crystal"},{"id":"Q278387","formula":"Ca₃O₈P₂","names":{"en":"Tricalcium phosphate","ru":"Фосфат кальция","uk":"Ортофосфат кальцію"},"elements":["O","P","Ca"],"fame":32,"kind":"crystal"},{"id":"Q416275","formula":"Ca₅(PO₄)₃F","names":{"en":"Fluorapatite","ru":"Фторапатит","uk":"Флуорапатит"},"elements":["O","F","P","Ca"],"fame":13,"kind":"crystal"},{"id":"Q422362","formula":"Ca₉Mg(PO₄)₆(PO₃OH)","names":{"en":"Whitlockite","ru":"Витлокит","uk":"Вітлокіт"},"elements":["H","O","Mg","P","Ca"],"fame":12,"kind":null},{"id":"Q3746845
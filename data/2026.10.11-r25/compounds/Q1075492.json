{"version":"2026.10.11-r25","id":"Q1075492","formula":"C₁₀H₆O₃","hill":"C10H6O3","elements":["H","C","O"],"composition":{"C":10.0,"H":6.0,"O":3.0},"names":{"en":"Lawsone"},"descriptions":{"en":"Lawsone (2-hydroxy-1,4-naphthoquinone), also known as hennotannic acid, is a red-orange dye present in the leaves of the henna plant (Lawsonia inermis), for which it is named, as well as in the common walnut (Juglans regia) and water hyacinth (Pontederia crassipes). Humans have used henna extracts containing lawsone as hair and skin dyes for more than 5,000 years. Lawsone reacts chemically with the protein keratin in skin and hair via a Michael addition reaction, resulting in a strong permanent stain that lasts until the skin or hair is shed."},"fame":13,"pubchemCid":6755,"mass":174.15,"charge":0,"smiles":"C1=CC=C2C(=C1)C(=CC(=O)C2=O)O","inchikey":"WVCHIGAIXREVNS-UHFFFAOYSA-N","iupac":"4-hydroxynaphthalene-1,2-dione","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"6755","atoms":19,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-0.18,"y":2.997,"z":0.02,"el":"O"},{"x":-1.333,"y":-2.357,"z":0.006,"el":"O"},{"x":-3.285,"y":-0.538,"z":-0.001,"el":"O"},{"x":0.64,"y":0.669,"z":-0.005,"el":"C"},{"x":0.375,"y":-0.709,"z":0.001,"el":"C"},{"x":-0.467,"y":1.643,"z":-0.009,"el":"C"},{"x":-1.023,"y":-1.177,"z":0.002,"el":"C"},{"x":1.982,"y":1.081,"z":-0.007,"el":"C"},{"x":1.412,"y":-1.65,"z":0.004,"el":"C"},{"x":-1.754,"y":1.269,"z":-0.007,"el":"C"},{"x":-2.124,"y":-0.157,"z":-0.003,"el":"C"},{"x":3.021,"y":0.146,"z":-0.003,"el":"C"},{"x":2.736,"y":-1.217,"z":0.002,"el":"C"},{"x":2.241,"y":2.138,"z":-0.011,"el":"H"},{"x":1.207,"y":-2.716,"z":0.008,"el":"H"},{"x":-2.565,"y":1.988,"z":-0.001,"el":"H"},{"x":4.053,"y":0.484,"z":-0.005,"el":"H"},{"x":3.545,"y":-1.942,"z":0.005,"el":"H"},{"x":-1.015,"y":3.497,"z":
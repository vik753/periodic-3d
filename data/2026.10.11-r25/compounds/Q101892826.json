{"version":"2026.10.11-r25","id":"Q101892826","formula":"C₁₉H₂₅NO₃","hill":"C19H25NO3","elements":["H","C","N","O"],"composition":{"C":19.0,"H":25.0,"N":1.0,"O":3.0},"names":{"en":"25E-NBOH"},"descriptions":{"en":"25E-NBOH (2C-E-NBOH, NBOH-2C-E) is a derivative of the phenethylamine derived hallucinogen 2C-E. It was first developed by Martin Hansen at the University of Copenhagen in 2010 as a brain imaging agent, but has subsequently been sold as a designer drug, first being identified in Brazil in 2018 on seized blotter paper, as well as in Slovenia and France. It acts as a potent serotonin receptor agonist with similar affinity to better-known compounds such as 25I-NBOMe at 5-HT2A and 5-HT2C receptors."},"fame":2,"pubchemCid":135391539,"mass":315.4,"charge":0,"smiles":"CCC1=CC(=C(C=C1OC)CCNCC2=CC=CC=C2O)OC","inchikey":"SYBINTRPEZWFLZ-UHFFFAOYSA-N","iupac":"2-[[2-(4-ethyl-2,5-dimethoxyphenyl)ethylamino]methyl]phenol","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"rdkit","ref":"135391539","atoms":48,"license":"Computed with RDKit from SMILES (PubChem, Wikidata)"},"structure":{"kind":"molecule","atoms":[{"x":-5.579,"y":-1.044,"z":0.611,"el":"C"},{"x":-4.623,"y":-0.984,"z":-0.571,"el":"C"},{"x":-3.263,"y":-0.456,"z":-0.171,"el":"C"},{"x":-2.25,"y":-1.371,"z":0.171,"el":"C"},{"x":-0.981,"y":-0.933,"z":0.563,"el":"C"},{"x":-0.707,"y":0.445,"z":0.604,"el":"C"},{"x":-1.729,"y":1.358,"z":0.276,"el":"C"},{"x":-2.999,"y":0.921,"z":-0.111,"el":"C"},{"x":-4.043,"y":1.746,"z":-0.44,"el":"O"},{"x":-3.782,"y":3.142,"z":-0.494,"el":"C"},{"x":0.645,"y":0.977,"z":1.034,"el":"C"},{"x":1.372,"y":1.877,"z":0.015,"el":"C"},{"x":1.486,"y":1.408,"z":-1.369,"el":"N"},{"x":2.075,"y":0.08,"z":-1.553,"el":"C"},{"x":3.473,"y":-0.09,"z":-1.008,"el":"C"},{"x":4.5,"y":0.734,"z":-1.513,"el":"C"},{"x":5.82,"y":0.598,"z":-1.078,"el":"C"},{"x":6.144,"y":-0.375,"z":-0.138
{"version":"2026.10.11-r25","id":"Q15708035","formula":"C₂₁H₂₀N₂O₃","hill":"C21H20N2O3","elements":["H","C","N","O"],"composition":{"C":21.0,"H":20.0,"N":2.0,"O":3.0},"names":{"en":"Alstonine"},"descriptions":{"en":"Alstonine is a pentacyclic alkaloid and putative antipsychotic constituent of various plant species including Alstonia boonei, Catharanthus roseus, Picralima nitida, Rauvolfia afra and Rauvolfia vomitoria. In preclinical studies alstonine attenuates MK-801-induced hyperlocomotion, working memory deficit and social withdrawal. It also possesses anxiolytic-like effects in preclinical studies, attenuates amphetamine-induced lethality and stereotypy as well as apomorphine-induced stereotypy, and attenuates haloperidol-induced catalepsy."},"fame":4,"pubchemCid":441979,"mass":348.4,"charge":0,"smiles":"C[C@H]1[C@@H]2CN3C=CC4=C5C=CC=CC5=NC4=C3C[C@@H]2C(=CO1)C(=O)OC","inchikey":"WYTGDNHDOZPMIW-RCBQFDQVSA-N","iupac":"methyl (15S,16S,20S)-16-methyl-17-oxa-3,13-diazapentacyclo[11.8.0.02,10.04,9.015,20]henicosa-1,3,5,7,9,11,18-heptaene-19-carboxylate","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"441979","atoms":46,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":3.099,"y":-1.389,"z":-1.895,"el":"O"},{"x":3.796,"y":2.127,"z":1.058,"el":"O"},{"x":3.789,"y":2.667,"z":-1.194,"el":"O"},{"x":-0.059,"y":-1.758,"z":1.059,"el":"N"},{"x":-1.784,"y":1.416,"z":0.158,"el":"N"},{"x":2.312,"y":-1.679,"z":0.442,"el":"C"},{"x":2.382,"y":-0.151,"z":0.69,"el":"C"},{"x":1.263,"y":-2.302,"z":1.375,"el":"C"},{"x":1.012,"y":0.509,"z":0.997,"el":"C"},{"x":2.08,"y":-1.976,"z":-1.064,"el":"C"},{"x":-0.205,"y":-0.368,"z":0.822,"el":"C"},{"x":3.112,"y":0.523,"z":-0.435,"el":"C"},{"x":-1.402,"y":0.13,"z":0.449,"el":"C"},{"x":2.086,"y":-3.47,"z":-1.377,"el":"C"},{"x":3.43,"y":-0.1,"z":-1.575,"el":"C"},{"x":-1.178
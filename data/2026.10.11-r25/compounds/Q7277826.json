{"version":"2026.10.11-r25","id":"Q7277826","formula":"C₂₁H₂₂ClNO₂","hill":"C21H22ClNO2","elements":["H","C","N","O","Cl"],"composition":{"C":21.0,"H":22.0,"N":1.0,"O":2.0,"Cl":1.0},"names":{"en":"RTI-113"},"descriptions":{"en":"RTI(-4229)-113 (2β-carbophenoxy-3β-(4-chlorophenyl)tropane) is a stimulant drug which acts as a potent and fully selective dopamine reuptake inhibitor (DRI). It has been suggested as a possible substitute drug for the treatment of cocaine addiction. \"RTI-113 has properties that make it an ideal medication for cocaine abusers, such as an equivalent efficacy, a higher potency, and a longer duration of action as compared to cocaine.\" Replacing the methyl ester in RTI-31 with a phenyl ester makes the resultant RTI-113 fully DAT specific."},"fame":4,"pubchemCid":9886801,"mass":355.9,"charge":0,"smiles":"CN1C2CCC1[C@H]([C@H](C2)C3=CC=C(C=C3)Cl)C(=O)OC4=CC=CC=C4","inchikey":"AAEKULYONKUBOZ-MLFFRYNPSA-N","iupac":"phenyl (2S,3S)-3-(4-chlorophenyl)-8-methyl-8-azabicyclo[3.2.1]octane-2-carboxylate","classes":[{"qid":"Q59199015","names":{"en":"group of stereoisomers","ru":"группа стереоизомеров","uk":"група стереоізомерів"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"9886801","atoms":47,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-3.152,"y":-4.694,"z":-0.195,"el":"Cl"},{"x":-0.883,"y":1.147,"z":1.101,"el":"O"},{"x":0.073,"y":1.268,"z":-1.017,"el":"O"},{"x":2.92,"y":1.406,"z":-0.692,"el":"N"},{"x":2.541,"y":1.281,"z":0.729,"el":"C"},{"x":3.619,"y":0.137,"z":-0.955,"el":"C"},{"x":1.338,"y":0.303,"z":0.813,"el":"C"},{"x":1.661,"y":-1.083,"z":0.19,"el":"C"},{"x":2.519,"y":-0.94,"z":-1.093,"el":"C"},{"x":3.79,"y":0.692,"z":1.398,"el":"C"},{"x":4.499,"y":-0.078,"z":0.281,"el":"C"},{"x":0.446,"y":-1.996,"z":0.093,"el":"C"},{"x":3.749,"y":2.578,"z":-0.959,"el":"C"},{"x":0.14,"y":0.953,"z":0.171,"el":"C"},{"x":-0.002,"y":-2.677,"z":1.222,"el":"C"},{"x":-0.213,"y":-2.145,"z":-1.125,"el":"C"},{"x":-1.11
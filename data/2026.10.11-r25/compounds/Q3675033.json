{"version":"2026.10.11-r25","id":"Q3675033","formula":"Na₅Al₃F₁₄","hill":"Al3F14Na5","elements":["F","Na","Al"],"composition":{"F":14.0,"Al":3.0,"Na":5.0},"names":{"en":"Chiolite","ru":"Хиолит","uk":"Хіоліт"},"descriptions":{"en":"Chiolite is a tetragonal-ditetragonal dipyramidal mineral, composed of sodium, fluorine, and aluminium. The name originates from the combination of the Greek words for snow (χιώυ) and stone (λίθος). It is an allusion to its similarity and appearance to cryolite (ice stone).","ru":"Хиоли́т — минерал, алюмофторид натрия. Название происходит от сочетания греческих слов, обозначающих снег (χιώυ) и камень (λίθος), и указывает на сходство минерала с криолитом («ледяным камнем»).","uk":"Хіоліт — мінерал, алюмофлуорид натрію шаруватої будови. Назва утворена від двох давньогрецьких слів хіон — сніг і літос — камінь (Р. Ф. Герман, І. Б. Ауербах, 1846)."},"fame":10,"pubchemCid":null,"mass":null,"charge":0,"smiles":null,"inchikey":null,"iupac":null,"classes":[{"qid":"Q12089225","names":{"en":"mineral species","ru":"действительный вид минералов","uk":"мінеральний вид"}}],"structureInfo":{"kind":"crystal","source":"materialsproject","ref":"mp-4752","atoms":73,"license":"CC BY 4.0, Materials Project"},"structure":{"cell":[[6.921,0.0,0.0],[0.0,6.921,0.0],[0.0,0.0,10.341]],"kind":"crystal","atoms":[{"x":0.0,"y":0.0,"z":5.171,"el":"Na"},{"x":0.0,"y":6.921,"z":5.171,"el":"Na"},{"x":6.921,"y":0.0,"z":5.171,"el":"Na"},{"x":6.921,"y":6.921,"z":5.171,"el":"Na"},{"x":3.46,"y":3.46,"z":0.0,"el":"Na"},{"x":3.46,"y":3.46,"z":10.341,"el":"Na"},{"x":1.949,"y":5.409,"z":2.585,"el":"Na"},{"x":1.511,"y":1.949,"z":2.585,"el":"Na"},{"x":5.409,"y":4.972,"z":2.585,"el":"Na"},{"x":4.972,"y":1.511,"z":2.585,"el":"Na"},{"x":1.949,"y":5.409,"z":7.756,"el":"Na"},{"x":1.511,"y":1.949,"z":7.756,"el":"Na"},{"x":5.409,"y":4.972,"z":7.756,"el":"Na"},{"x":4.972,"y":1.511,"z":7.756,"el":"Na"},{"x":0.0,"y":0.0,"z":0.0,"el":"Al"},{"x":0.0,"y":0.0,"z":10.341,"el":"Al"},{"x":0.0,"y":6.921,"
{"version":"2026.10.11-r25","id":"Q5732050","formula":"C₄₀H₅₂ClN₂","hill":"C40H52ClN2","elements":["H","C","N","Cl"],"composition":{"C":40.0,"H":52.0,"N":2.0,"Cl":1.0},"names":{"en":"Heptamethine dyes"},"descriptions":{"en":"Heptamethine dyes are a subclass of chemical compounds within the cyanine dye family and have many uses as fluorescent dyes, particularly in biomedical imaging, the development of theranostics, the individualized treatment of cancerous patients with the aid of PDT, co-administration with other drugs, and irradiation. The characteristics of heptamethine dyes can be understood by comparing research data on different dyes within the family. For example, the IR-780 dye exhibits a peak spectral absorption of around 780 nm."},"fame":1,"pubchemCid":null,"mass":null,"charge":0,"smiles":null,"inchikey":null,"iupac":null,"classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":null,"structure":null,"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q5732050","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Heptamethine_dyes","license":"CC BY-SA 4.0"}],"similar":[{"id":"Q422438","formula":"C₁₈H₂₆ClN₃","names":{"en":"Chloroquine","ru":"Хлорохин","uk":"Хлорохін"},"elements":["H","C","N","Cl"],"fame":54,"kind":"molecule"},{"id":"Q208366","formula":"C₈H₁₀","names":{"en":"Xylene","ru":"Ксилолы","uk":"Ксилени"},"elements":["H","C"],"fame":50,"kind":"molecule"},{"id":"Q409184","formula":"C₈H₁₀","names":{"en":"Ethylbenzene","ru":"Этилбензол","uk":"Етилбензен"},"elements":["H","C"],"fame":45,"kind":"molecule"},{"id":"Q424390","formula":"C₅H₆","names":{"en":"Cyclopentadiene","ru":"Циклопентадиен","uk":"Циклопентадієн"},"elements":["H","C"],"fame":30,"kind":"molecule"},{"id":"Q2988108","formula":"C₈H₁₀","names":{"en":"o-xylene","ru":"Ортоксилол","uk":"О-Ксилен"},"elements":["H","C"],"fame
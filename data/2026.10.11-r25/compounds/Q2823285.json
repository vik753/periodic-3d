{"version":"2026.10.11-r25","id":"Q2823285","formula":"AsHO₂","hill":"AsHO2","elements":["H","O","As"],"composition":{"H":1.0,"O":2.0,"As":1.0},"names":{"en":"Arsenious acid","ru":"Мышьяковистая кислота"},"descriptions":{"ru":"Мышьяко́вистая кислота́ — слабая неорганическая кислота, с химической формулой HAsO2 (ме́тамышьяко́вистая кислота) или H3AsO3 (о́ртомышьяко́вистая кислота), существующая только в растворе: при выпаривании образуется ангидрид — оксид мышьяка(III), и вода. Высокотоксична, как и многие другие неорганические соединения мышьяка. Оказывает некротизирующее действие на ткани живых организмов, поэтому в виде сильно разбавленных растворов применяется в стоматологии, как правило, для «убивания нерва зуба»."},"fame":3,"pubchemCid":24577,"mass":107.928,"charge":0,"smiles":"O[As]=O","inchikey":"XHTRYVMKFMUJLU-UHFFFAOYSA-N","iupac":"arsenous acid","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"rdkit","ref":"24577","atoms":4,"license":"Computed with RDKit from SMILES (PubChem, Wikidata)"},"structure":{"kind":"molecule","atoms":[{"x":-1.332,"y":0.111,"z":0.707,"el":"O"},{"x":0.601,"y":0.721,"z":0.52,"el":"As"},{"x":1.95,"y":-0.358,"z":0.018,"el":"O"},{"x":-1.218,"y":-0.244,"z":-0.21,"el":"H"}],"bonds":[[0,1,1.0],[1,2,2.0],[0,3,1.0]]},"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q2823285","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (ru)","url":"https://ru.wikipedia.org/wiki/%D0%9C%D1%8B%D1%88%D1%8C%D1%8F%D0%BA%D0%BE%D0%B2%D0%B8%D1%81%D1%82%D0%B0%D1%8F_%D0%BA%D0%B8%D1%81%D0%BB%D0%BE%D1%82%D0%B0","license":"CC BY-SA 4.0"},{"role":"properties","name":"PubChem","url":"https://pubchem.ncbi.nlm.nih.gov/compound/24577","license":"PubChem (NIH), public data"},{"role":"structure","name":"RDKit","url":null,"license":"Computed with RDKit from SMILES (PubChem, Wikidata)"}],"similar":[{"i
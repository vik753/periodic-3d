{"version":"2026.10.11-r25","id":"Q6460436","formula":"C₂₀H₂₅FN₂O₃S","hill":"C20H25FN2O3S","elements":["H","C","N","O","F","S"],"composition":{"C":20.0,"F":1.0,"H":25.0,"N":2.0,"O":3.0,"S":1.0},"names":{"en":"LY-503,430"},"descriptions":{"en":"LY-503430 is an AMPA receptor positive allosteric modulator developed by Eli Lilly. LY-503430 produces both nootropic and neuroprotective effects, reducing brain damage caused by 6-hydroxydopamine or MPTP and also increasing levels of the neurotrophic factor BDNF in the brain, particularly in the substantia nigra, hippocampus, and striatum. It is orally active and the main application it is currently being developed for is treatment of Parkinson's disease, although it has also been proposed to be useful in the treatment of Alzheimer's disease, depression, and schizophrenia."},"fame":3,"pubchemCid":9952446,"mass":392.5,"charge":0,"smiles":"CC(C)S(=O)(=O)NC[C@@](C)(C1=CC=C(C=C1)C2=CC=C(C=C2)C(=O)NC)F","inchikey":"MFJKNXILEXBWNQ-FQEVSTJZSA-N","iupac":"4-[4-[(2R)-2-fluoro-1-(propan-2-ylsulfonylamino)propan-2-yl]phenyl]-N-methylbenzamide","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"9952446","atoms":52,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-4.367,"y":-1.736,"z":0.046,"el":"S"},{"x":-3.497,"y":2.492,"z":-1.236,"el":"F"},{"x":-3.652,"y":-2.015,"z":1.278,"el":"O"},{"x":-4.285,"y":-2.651,"z":-1.078,"el":"O"},{"x":6.788,"y":-1.868,"z":-0.897,"el":"O"},{"x":-3.972,"y":-0.169,"z":-0.506,"el":"N"},{"x":7.331,"y":-0.256,"z":0.678,"el":"N"},{"x":-3.072,"y":2.074,"z":0.003,"el":"C"},{"x":-4.039,"y":0.962,"z":0.437,"el":"C"},{"x":-6.083,"y":-1.525,"z":0.44,"el":"C"},{"x":-1.621,"y":1.615,"z":-0.02,"el":"C"},{"x":-3.228,"y":3.291,"z":0.921,"el":"C"},{"x":-6.667,"y":-2.827,"z":0.967,"el":"C"},{"x":-6.846,"y":-1.026,"z":-0.778,"el":"C"},{"x":-1.027,"y":
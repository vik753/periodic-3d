{"version":"2026.10.11-r25","id":"Q18210861","formula":"C₂₂H₃₁ClO₂","hill":"C22H31ClO2","elements":["H","C","O","Cl"],"composition":{"C":22.0,"H":31.0,"O":2.0,"Cl":1.0},"names":{"en":"Clometherone"},"descriptions":{"en":"Clometerone (INNTooltip International Nonproprietary Name; developmental code L-38000; also known as clometherone (USANTooltip United States Adopted Name) or 6α-chloro-16α-methylprogesterone) is a synthetic pregnane steroid and derivative of progesterone which was reported in 1962 and is described as an antiestrogen and antiandrogen but was never marketed. Clometerone has been found to suppress estrone-induced uterine hypertrophy in mice at oral and parenteral doses in which progesterone is inactive (active at 10 μg with clometerone and progesterone inactive at 10–100 μg in the case of both routes)."},"fame":1,"pubchemCid":14515731,"mass":362.9,"charge":0,"smiles":"C[C@@H]1C[C@H]2[C@@H]3C[C@@H](C4=CC(=O)CC[C@@]4([C@H]3CC[C@@]2([C@H]1C(=O)C)C)C)Cl","inchikey":"UMRURYMAPMZKQO-NDKKBYRMSA-N","iupac":"(6S,8S,9S,10R,13S,14S,16R,17S)-17-acetyl-6-chloro-10,13,16-trimethyl-1,2,6,7,8,9,11,12,14,15,16,17-dodecahydrocyclopenta[a]phenanthren-3-one","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"14515731","atoms":56,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-3.06,"y":3.419,"z":-0.282,"el":"Cl"},{"x":5.449,"y":-0.532,"z":-0.84,"el":"O"},{"x":-6.1,"y":-0.499,"z":1.168,"el":"O"},{"x":2.253,"y":-0.48,"z":-0.151,"el":"C"},{"x":1.392,"y":0.749,"z":0.207,"el":"C"},{"x":-0.015,"y":0.69,"z":-0.401,"el":"C"},{"x":-0.741,"y":-0.581,"z":0.13,"el":"C"},{"x":3.567,"y":-0.074,"z":0.554,"el":"C"},{"x":2.296,"y":1.933,"z":-0.129,"el":"C"},{"x":1.565,"y":-1.718,"z":0.439,"el":"C"},{"x":-2.22,"y":-0.712,"z":-0.408,"el":"C"},{"x":3.717,"y":1.436,"z":0.232,"el":"C"},{"x":0.119,"y":-1.861,"z":-0.0
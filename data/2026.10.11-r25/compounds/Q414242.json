ine","ru":"Хинидин","uk":"Хінідин"},"elements":["H","C","N","O"],"fame":32,"kind":"molecule"},{"id":"Q425654","formula":"C₂₄H₂₈N₂O₃","names":{"en":"Indacaterol","uk":"Індакатерол"},"elements":["H","C","N","O"],"fame":21,"kind":"molecule"},{"id":"Q424442","formula":"C₂₁H₂₇N₃O₂","names":{"en":"Methysergide","ru":"Метисергид"},"elements":["H","C","N","O"],"fame":15,"kind":"molecule"},{"id":"Q4875166","formula":"C₃₀H₃₄N₂O₃","names":{"en":"Bazedoxifene"},"elements":["H","C","N","O"],"fame":15,"kind":"molecule"},{"id":"Q6095693","formula":"C₂₄H₂₈N₂O₃","names":{"en":"Ivacaftor"},"elements":["H","C","N","O"],"fame":15,"kind":"molecule"},{"id":"Q1225737","formula":"C₉H₁₁NO","names":{"en":"p-dimethylaminobenzaldehyde","ru":"4-Диметиламинобензальдегид"},"elements":["H","C","N","O"],"fame":12,"kind":"molecule"},{"id":"Q4015903","formula":"C₄₃H₅₂N₄O₅","names":{"en":"Voacamine"},"elements":["H","C","N","O"],"fame":7,"kind":"molecule"}],"photo":null}
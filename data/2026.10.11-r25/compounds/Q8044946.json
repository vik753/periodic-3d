{"version":"2026.10.11-r25","id":"Q8044946","formula":"C₂₃H₃₁NO","hill":"C23H31NO","elements":["H","C","N","O"],"composition":{"C":23.0,"H":31.0,"N":1.0,"O":1.0},"names":{"en":"Xorphanol"},"descriptions":{"en":"Xorphanol (INN; also known as xorphanol mesylate (USAN); developmental codes TR-5379 or TR-5379M) is an opioid analgesic of the morphinan family that was never marketed. Xorphanol is a mixed agonist–antagonist of opioid receptors, acting preferentially as a high-efficacy partial agonist/near-full agonist of the κ-opioid receptor (Ki = 0.4 nM; EC50 = 3.3 nM; Imax = 49%; IA = 0.84) and to a lesser extent as a partial agonist of the μ-opioid receptor (Ki = 0.25 nM; IC50 = 3.4 nM; Imax = 29%) with lower relative intrinsic activity and marked antagonistic potential (including the ability to antagonize morphine-induced effects and induce opioid withdrawal in opioid-dependent individuals)."},"fame":5,"pubchemCid":5488631,"mass":337.5,"charge":0,"smiles":"C[C@H]1CC(=C)C[C@@]23[C@@H]1[C@@H](CC4=C2C=C(C=C4)O)N(CC3)CC5CCC5","inchikey":"AZJPPZHRNFQRRE-AZIXLERZSA-N","iupac":"(1R,9R,10R,11S)-17-(cyclobutylmethyl)-11-methyl-13-methylidene-17-azatetracyclo[7.5.3.01,10.02,7]heptadeca-2(7),3,5-trien-4-ol","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"5488631","atoms":56,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-4.76,"y":2.364,"z":0.147,"el":"O"},{"x":1.869,"y":0.421,"z":0.943,"el":"N"},{"x":-0.873,"y":-0.604,"z":0.974,"el":"C"},{"x":0.263,"y":-1.249,"z":0.112,"el":"C"},{"x":1.251,"y":-0.128,"z":-0.285,"el":"C"},{"x":-0.299,"y":-2.084,"z":-1.085,"el":"C"},{"x":-0.212,"y":0.024,"z":2.232,"el":"C"},{"x":-1.833,"y":-1.736,"z":1.438,"el":"C"},{"x":-1.568,"y":0.533,"z":0.199,"el":"C"},{"x":0.92,"y":1.002,"z":1.893,"el":"C"},{"x":0.549,"y":0.897,"z":-1.199,"el":"C"},{"x":-1.295,"y":-3.149,"z":-
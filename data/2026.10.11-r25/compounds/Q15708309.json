{"version":"2026.10.11-r25","id":"Q15708309","formula":"C₂₃H₂₂N₂O₂","hill":"C23H22N2O2","elements":["H","C","N","O"],"composition":{"C":23.0,"H":22.0,"N":2.0,"O":2.0},"names":{"en":"PB-22"},"descriptions":{"en":"PB-22 (QUPIC, SGT-21 or 1-pentyl-1H-indole-3-carboxylic acid 8-quinolinyl ester) is a designer drug offered by online vendors as a cannabimimetic agent, and detected being sold in synthetic cannabis products in Japan in 2013. PB-22 represents a structurally unique synthetic cannabinoid chemotype, since it contains an ester linker at the indole 3-position, rather than the precedented ketone of JWH-018 and its analogs, or the amide of APICA and its analogs. PB-22 has an EC50 of 5.1 nM for human CB1 receptors, and 37 nM for human CB2 receptors."},"fame":2,"pubchemCid":71604304,"mass":358.4,"charge":0,"smiles":"CCCCCN1C=C(C2=CC=CC=C21)C(=O)OC3=CC=CC4=C3N=CC=C4","inchikey":"ZAVGICCEAOUWFM-UHFFFAOYSA-N","iupac":"quinolin-8-yl 1-pentylindole-3-carboxylate","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"rdkit","ref":"71604304","atoms":49,"license":"Computed with RDKit from SMILES (PubChem, Wikidata)"},"structure":{"kind":"molecule","atoms":[{"x":5.93,"y":-1.236,"z":1.202,"el":"C"},{"x":5.151,"y":-0.413,"z":2.218,"el":"C"},{"x":4.734,"y":0.963,"z":1.69,"el":"C"},{"x":3.31,"y":1.029,"z":1.128,"el":"C"},{"x":3.086,"y":0.162,"z":-0.107,"el":"C"},{"x":1.781,"y":0.399,"z":-0.709,"el":"N"},{"x":0.66,"y":-0.335,"z":-0.422,"el":"C"},{"x":-0.396,"y":0.156,"z":-1.172,"el":"C"},{"x":0.13,"y":1.24,"z":-1.951,"el":"C"},{"x":-0.432,"y":2.13,"z":-2.893,"el":"C"},{"x":0.367,"y":3.107,"z":-3.494,"el":"C"},{"x":1.715,"y":3.213,"z":-3.172,"el":"C"},{"x":2.3,"y":2.348,"z":-2.243,"el":"C"},{"x":1.49,"y":1.368,"z":-1.645,"el":"C"},{"x":-1.769,"y":-0.347,"z":-1.156,"el":"C"},{"x":-2.669,"y":0.135,"z":-1.838,"el":"O"},{"x":-1.902,"y":-1.458,"z":-0.325,"el":"O"}
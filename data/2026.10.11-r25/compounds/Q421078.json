{"version":"2026.10.11-r25","id":"Q421078","formula":"KMg(SO₄)Cl·3H₂O","hill":"ClH6KMgO7S","elements":["H","O","Mg","S","Cl","K"],"composition":{"H":6.0,"K":1.0,"O":7.0,"S":1.0,"Cl":1.0,"Mg":1.0},"names":{"en":"Kainite","ru":"Каинит","uk":"Каїніт"},"descriptions":{"en":"Kainite ( or ) (KMg(SO4)Cl·3H2O) is an evaporite mineral in the class of \"Sulfates (selenates, etc.) with additional anions, with H2O\" according to the Nickel–Strunz classification. It is a hydrated potassium-magnesium sulfate-chloride, naturally occurring in irregular granular masses or as crystalline coatings in cavities or fissures. This mineral is dull and soft, and is colored white, yellowish, grey, reddish, or blue to violet.","ru":"Каини́т (от др.-греч. καινός — «новый») — минерал, двойная соль магния и калия KCl·MgSO4·3H2O. Цвет — серый, желтый, красный. Используют для получения калийных удобрений, металлического магния.","uk":"Каїніт — мінерал класу сульфатів."},"fame":27,"pubchemCid":null,"mass":null,"charge":0,"smiles":null,"inchikey":null,"iupac":null,"classes":[{"qid":"Q12089225","names":{"en":"mineral species","ru":"действительный вид минералов","uk":"мінеральний вид"}}],"structureInfo":null,"structure":null,"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q421078","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Kainite","license":"CC BY-SA 4.0"},{"role":"description","name":"Wikipedia (ru)","url":"https://ru.wikipedia.org/wiki/%D0%9A%D0%B0%D0%B8%D0%BD%D0%B8%D1%82","license":"CC BY-SA 4.0"},{"role":"description","name":"Wikipedia (uk)","url":"https://uk.wikipedia.org/wiki/%D0%9A%D0%B0%D1%97%D0%BD%D1%96%D1%82","license":"CC BY-SA 4.0"},{"role":"photo","name":"Wikimedia Commons","url":"https://commons.wikimedia.org/wiki/File:Kainite_-_Grube_Brefeld,_Tarthun,_Sta%C3%9Ffurt,_Sachsen-Anhalt.jpg","license":"CC BY-SA 3.0 de"}],"similar":[{"id":"Q3902692","formula":"K₂Mg(SO₄)₂·6H₂O","names":{"en":"Picromerite","ru":"Шёнит","uk":"Шеніт"},"elements":["H","O","Mg","S","K"],"fame":13,"kind":"crystal"},{"id":"Q415950","formula":"Cu(UO₂)₂(SO₄)₂(OH)₂·8H₂O","names":{"en":"Johannite","uk":"Йоганніт"},"elements":["H","O","S","Cu","U"],"fame":13,"kind":null},{"id":"Q3830636","formula":"K₂Mg(SO₄)₂·4H₂O","names":{"en":"Leonite","ru":"Леонит","uk":"Леоніт"},"elements":["H","O","Mg","S","K"],"fame":10,"kind":"crystal"},{"id":"Q3980574","formula":"NaAl(SO₄)₂·6H₂O","names":{"en":"Tamarugite","uk":"Тамаругіт"},"elements":["H","O","Na","Al","S"],"fame":10,"kind":"crystal"},{"id":"Q3788200","formula":"Mg₃(AsO₄)₂·8H₂O","names":{"en":"Hörnesite"},"elements":["H","O","Mg","As"],"fame":9,"kind":null},{"id":"Q973557","formula":"NaMg(SO₄)F·2H₂O","names":{"en":"Uklonskovite"},"elements":["H","O","F","Na","Mg","S"],"fame":7,"kind":"crystal"},{"id":"Q3951862","formula":"Ca₃Ge(SO₄)₂(OH)₆*4H₂O","names":{"en":"Schaurteite","uk":"Шауртеїт"},"elements":["H","O","S","Ca","Ge"],"fame":6,"kind":null},{"id":"Q19833340","formula":"Na₂Co(SO₄)₂·4H₂O","names":{"en":"Cobaltoblödite"},"elements":["H","O","Na","S","Co"],"fame":4,"kind":"crystal"}],"photo":{"url":"https://upload.wikimedia.org/wikipedia/commons/c/ca/Kainite_-_Grube_Brefeld%2C_Tarthun%2C_Sta%C3%9Ffurt%2C_Sachsen-Anhalt.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","page":"https://commons.wikimedia.org/wiki/File:Kainite_-_Grube_Brefeld,_Tarthun,_Sta%C3%9Ffurt,_Sachsen-Anhalt.jpg","license":"CC BY-SA 3.0 de","author":"Thomas Witzke","licenseUrl":"https://creativecommons.org/licenses/by-sa/3.0/de/deed.en"}}
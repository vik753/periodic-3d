{"version":"2026.10.11-r25","id":"Q27089037","formula":"C₂₃H₂₁FO₃","hill":"C23H21FO3","elements":["H","C","O","F"],"composition":{"C":23.0,"F":1.0,"H":21.0,"O":3.0},"names":{"en":"TUG-891"},"descriptions":{"en":"TUG-891 is an experimental drug which acts as a potent and selective agonist for the free fatty acid receptor FFAR4 (GPR120). It has antiinflammatory effects and regulates metabolism, gastric peptide release and glucose homeostasis, and has been researched in animal models of conditions such as obesity, diabetes and atherosclerosis, as well as cancer. TUG-891 was one of the first selective FFAR4 agonists developed and while it is useful for in vitro research, it has poor stability in vivo, and so numerous compounds have been developed with improved properties using TUG-891 as the parent compound."},"fame":1,"pubchemCid":57522038,"mass":364.4,"charge":0,"smiles":"CC1=CC=C(C=C1)C2=C(C=C(C=C2)F)COC3=CC=C(C=C3)CCC(=O)O","inchikey":"LPGBXHWIQNZEJB-UHFFFAOYSA-N","iupac":"3-[4-[[5-fluoro-2-(4-methylphenyl)phenyl]methoxy]phenyl]propanoic acid","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"rdkit","ref":"57522038","atoms":48,"license":"Computed with RDKit from SMILES (PubChem, Wikidata)"},"structure":{"kind":"molecule","atoms":[{"x":-4.593,"y":3.985,"z":1.134,"el":"C"},{"x":-4.11,"y":2.63,"z":0.711,"el":"C"},{"x":-3.217,"y":2.497,"z":-0.357,"el":"C"},{"x":-2.791,"y":1.232,"z":-0.772,"el":"C"},{"x":-3.255,"y":0.074,"z":-0.132,"el":"C"},{"x":-4.167,"y":0.212,"z":0.924,"el":"C"},{"x":-4.594,"y":1.477,"z":1.339,"el":"C"},{"x":-2.8,"y":-1.255,"z":-0.564,"el":"C"},{"x":-1.828,"y":-1.994,"z":0.155,"el":"C"},{"x":-1.473,"y":-3.278,"z":-0.301,"el":"C"},{"x":-2.041,"y":-3.799,"z":-1.457,"el":"C"},{"x":-2.976,"y":-3.076,"z":-2.18,"el":"C"},{"x":-3.355,"y":-1.811,"z":-1.734,"el":"C"},{"x":-1.683,"y":-5.02,"z":-1.877,"el":"F"},{"x":-1.208,"y":-1.452,
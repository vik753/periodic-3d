{"version":"2026.10.11-r25","id":"Q15726011","formula":"H₂Se₂","hill":"H2Se2","elements":["H","Se"],"composition":{"H":2.0,"Se":2.0},"names":{"en":"Diselane"},"descriptions":{"en":"Hydrogen diselenide is an inorganic selenium compound with a chemical formula H2Se2 or (SeH)2. At room temperature, hydrogen diselenide dissociates easily to hydrogen selenide (H2Se) and elemental selenium, and is therefore not stable. When an aluminum-reduced hydrochloric acid solution of selenium dioxide is reacted with lead acetate, the resulting black precipitate contains lead diselenide (PbSe2)，this proves that hydrogen diselenide exists in the gas mixture.However, hydrogen diselenide can be stable in some solutions."},"fame":7,"pubchemCid":5248613,"mass":159.96,"charge":0,"smiles":"[SeH][SeH]","inchikey":"AVJWYAUVPWRPJX-UHFFFAOYSA-N","iupac":null,"classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"rdkit","ref":"5248613","atoms":4,"license":"Computed with RDKit from SMILES (PubChem, Wikidata)"},"structure":{"kind":"molecule","atoms":[{"x":-0.978,"y":0.743,"z":-0.257,"el":"Se"},{"x":0.889,"y":-0.721,"z":-0.442,"el":"Se"},{"x":-1.568,"y":-0.125,"z":0.865,"el":"H"},{"x":1.657,"y":0.103,"z":0.603,"el":"H"}],"bonds":[[0,1,1.0],[0,2,1.0],[1,3,1.0]]},"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q15726011","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Hydrogen_diselenide","license":"CC BY-SA 4.0"},{"role":"properties","name":"PubChem","url":"https://pubchem.ncbi.nlm.nih.gov/compound/5248613","license":"PubChem (NIH), public data"},{"role":"structure","name":"RDKit","url":null,"license":"Computed with RDKit from SMILES (PubChem, Wikidata)"}],"similar":[{"id":"Q12858523","formula":"HSe⁻","names":{"en":"Hydroselenide"},"elements":["H","Se"],"fame":4,"kind":"molecule"},{"id"
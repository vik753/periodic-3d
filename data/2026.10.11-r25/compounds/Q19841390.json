{"version":"2026.10.11-r25","id":"Q19841390","formula":"Na₁₀Ca₉Zr₃Fe₂SiNb(Si₃O₉)₂(Si₉O₂₇)₂(OH)₃(CO₃)·H₂O","hill":"CH5Ca9Fe2Na10NbO79Si25Zr3","elements":["H","C","O","Na","Si","Ca","Fe","Zr","Nb"],"composition":{"C":1.0,"H":5.0,"O":79.0,"Ca":9.0,"Fe":2.0,"Na":10.0,"Nb":1.0,"Si":25.0,"Zr":3.0},"names":{"en":"Golyshevite"},"descriptions":{"en":"Golyshevite is a rare mineral of the eudialyte group, with the formula Na10Ca3Ca6Zr3Fe2SiNb(Si3O9)2(Si9O27)2CO3(OH)3•H2O. The original formula was extended to show both the presence of cyclic silicate groups and silicon at the M4 site, according to the nomenclature of the eudialyte group. The characteristic feature of golyshevite is calcium-rich composition, with calcium at two main sites instead of one site. Together with feklichevite, fengchengite, ikranite and mogovidite it is a ferric-iron-dominant representative of the group."},"fame":4,"pubchemCid":null,"mass":null,"charge":0,"smiles":null,"inchikey":null,"iupac":null,"classes":[{"qid":"Q12089225","names":{"en":"mineral species","ru":"действительный вид минералов","uk":"мінеральний вид"}}],"structureInfo":null,"structure":null,"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q19841390","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Golyshevite","license":"CC BY-SA 4.0"},{"role":"photo","name":"Wikimedia Commons","url":"https://commons.wikimedia.org/wiki/File:Golyshevite.jpg","license":"CC BY-SA 4.0"}],"similar":[{"id":"Q19860860","formula":"Na₁₂Ce₃Ca₆Mn₃Zr₃WSi₂₅O₇₃(CO₃)(OH)₂","names":{"en":"Johnsenite-(Ce)"},"elements":["H","C","O","Na","Si","Ca","Mn","Zr","Ce","W"],"fame":3,"kind":null},{"id":"Q423058","formula":"NaCa₂Si₃O₈(OH)","names":{"en":"Pectolite","uk":"Пектоліт"},"elements":["H","O","Na","Si","Ca"],"fame":22,"kind":"crystal"},{"id":"Q4006642","formula":"Na₂AlSi₃O₈(OH)","names":{"en":"Ussingite"},"elements":["H","O","Na","Al","Si"],"fame":11,"kind":"crystal"},{"id":"Q365511
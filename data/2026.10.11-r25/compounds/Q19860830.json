{"version":"2026.10.11-r25","id":"Q19860830","formula":"Th(MoO₄)₂·3H₂O","hill":"H6Mo2O11Th","elements":["H","O","Mo","Th"],"composition":{"H":6.0,"O":11.0,"Mo":2.0,"Th":1.0},"names":{"en":"Ichnusaite","uk":"Ікнузаїт"},"descriptions":{"en":"Ichnusaite (pronounced iknusa-ait) is a very rarely found mineral. Ichnusaite is a natural compound of thorium and molybdenum with the formula Th(MoO4)2·3H2O. It was discovered in Su Seinargiu, Sarroch, Cagliari, Sardegna, Italy in 2013. The name is from the old Greek name of Sardinia, Ιχνουσσα, Ichnusa.","uk":"Ікнузаїт — вкрай рідкісний мінерал, природна сполука торію і молібдену з формулою Th(MoO4)2·3H2O. Його було виявлено в Су Сейнаргіу (Саррок, Кальярі, Сардинія, Італія) в 2013 році. Назва походить від старогрецької назви Сардинії — грец. Ιχνουσσα (Ікнуза)."},"fame":7,"pubchemCid":null,"mass":null,"charge":0,"smiles":null,"inchikey":null,"iupac":null,"classes":[{"qid":"Q12089225","names":{"en":"mineral species","ru":"действительный вид минералов","uk":"мінеральний вид"}}],"structureInfo":null,"structure":null,"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q19860830","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Ichnusaite","license":"CC BY-SA 4.0"},{"role":"description","name":"Wikipedia (uk)","url":"https://uk.wikipedia.org/wiki/%D0%86%D0%BA%D0%BD%D1%83%D0%B7%D0%B0%D1%97%D1%82","license":"CC BY-SA 4.0"}],"similar":[{"id":"Q412950","formula":"H₂MoO₄","names":{"en":"Molybdic acid","ru":"Молибденовая кислота"},"elements":["H","O","Mo"],"fame":24,"kind":"crystal"},{"id":"Q4003542","formula":"(UO₂)(MoO₄)(H₂O)·H₂O","names":{"en":"Umohoite"},"elements":["H","O","Mo","U"],"fame":9,"kind":null},{"id":"Q319661","formula":"K(UO₂)(AsO₄)·3H₂O","names":{"en":"Abernathyite","ru":"Абернатиит","uk":"Абернатіїт"},"elements":["H","O","K","As","U"],"fame":24,"kind":null},{"id":"Q3816233","formula":"ScPO₄·2H₂O","names":{"en":"Kolbeckite","uk":"Стерети
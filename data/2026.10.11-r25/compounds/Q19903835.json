{"version":"2026.10.11-r25","id":"Q19903835","formula":"C₂₀H₁₇ClN₂O₂S","hill":"C20H17ClN2O2S","elements":["H","C","N","O","S","Cl"],"composition":{"C":20.0,"H":17.0,"N":2.0,"O":2.0,"S":1.0,"Cl":1.0},"names":{"en":"PSB-CB5"},"descriptions":{"en":"PSB-CB5 (CID-85469571) is a compound which acts as an antagonist at the former orphan receptor GPR18, and is the first selective antagonist characterised for this receptor, with an IC50 of 279nM, and good selectivity over related receptors (over 36x selectivity vs CB1 and GPR55, and 14x vs CB2.) As all previously known antagonists for GPR18 also antagonise GPR55, it has been difficult to separate the effects of these two receptor targets, so the discovery of a selective GPR18 antagonist is expected to be useful in research into the actions of this receptor."},"fame":1,"pubchemCid":85469571,"mass":384.9,"charge":0,"smiles":"C1CN2C(=O)/C(=C/C3=CC(=CC=C3)OCC4=CC=C(C=C4)Cl)/N=C2SC1","inchikey":"XJBQRMOGMULGPP-PDGQHHTCSA-N","iupac":"(2Z)-2-[[3-[(4-chlorophenyl)methoxy]phenyl]methylidene]-6,7-dihydro-5H-imidazo[2,1-b][1,3]thiazin-3-one","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"rdkit","ref":"85469571","atoms":43,"license":"Computed with RDKit from SMILES (PubChem, Wikidata)"},"structure":{"kind":"molecule","atoms":[{"x":-6.776,"y":1.113,"z":2.092,"el":"C"},{"x":-6.289,"y":1.06,"z":0.656,"el":"C"},{"x":-4.885,"y":0.737,"z":0.549,"el":"N"},{"x":-4.164,"y":0.928,"z":-0.593,"el":"C"},{"x":-4.504,"y":1.444,"z":-1.64,"el":"O"},{"x":-2.848,"y":0.307,"z":-0.262,"el":"C"},{"x":-1.823,"y":0.331,"z":-1.123,"el":"C"},{"x":-0.475,"y":-0.227,"z":-0.922,"el":"C"},{"x":0.602,"y":0.367,"z":-1.597,"el":"C"},{"x":1.904,"y":-0.136,"z":-1.482,"el":"C"},{"x":2.137,"y":-1.246,"z":-0.674,"el":"C"},{"x":1.074,"y":-1.858,"z":-0.008,"el":"C"},{"x":-0.224,"y":-1.357,"z":-0.138,"el":"C"},{"x":2.847,"y":0.562,"z":-2.185,"el":
{"version":"2026.10.11-r25","id":"Q3637404","formula":"Ca(UO₂)₆O₄(OH)₆·8(H₂O)","hill":"CaH22O30U6","elements":["H","O","Ca","U"],"composition":{"H":22.0,"O":30.0,"U":6.0,"Ca":1.0},"names":{"en":"Becquerelite","ru":"Беккерелит","uk":"Бекереліт"},"descriptions":{"en":"Becquerelite is a uranium mineral with the chemical formula: Ca(UO2)6O4(OH)6·8(H2O). It is a secondary mineral which contains calcium and is a bright yellow colour. It has a Mohs hardness of about 2.","ru":"Беккерелит — урановый минерал, представляющий собой гидратированную форму оксида урана — гидроксоуранат кальция с химической формулой Ca(UO2)6O4(OH)6·8(H2O) и структурной формулой Ca[(UO2)6|O4|(OH)6]·8H2O. Это вторичный минерал, который содержит кальций и имеет ярко-жёлтый цвет. Имеет твёрдость по шкале Мооса около 2. В основном образует прозрачные кристаллы пластинчатой, призматической и псевдогексагональной формы, а также гранулированные агрегаты и корки от коричнево-жёлтого, янтарно-жёлтого до лимонно-жёлтого и жёлто-оранжевого с жёлтой полосой цвета.","uk":"Бекерелі́т (рос. беккерелит; англ. becquerelite; нім."},"fame":17,"pubchemCid":null,"mass":null,"charge":0,"smiles":null,"inchikey":null,"iupac":null,"classes":[{"qid":"Q12089225","names":{"en":"mineral species","ru":"действительный вид минералов","uk":"мінеральний вид"}}],"structureInfo":null,"structure":null,"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q3637404","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Becquerelite","license":"CC BY-SA 4.0"},{"role":"description","name":"Wikipedia (ru)","url":"https://ru.wikipedia.org/wiki/%D0%91%D0%B5%D0%BA%D0%BA%D0%B5%D1%80%D0%B5%D0%BB%D0%B8%D1%82","license":"CC BY-SA 4.0"},{"role":"description","name":"Wikipedia (uk)","url":"https://uk.wikipedia.org/wiki/%D0%91%D0%B5%D0%BA%D0%B5%D1%80%D0%B5%D0%BB%D1%96%D1%82","license":"CC BY-SA 4.0"},{"role":"photo","name":"Wikimedia Commons","url":"https://commons.wikimedia.org/wiki/File:Becquerelite-Uranophane-Uraninite-201144.jpg","license":"CC BY-SA 3.0"}],"similar":[{"id":"Q3791507","formula":"U₆H₂₂O₂₇","names":{"en":"Ianthinite","uk":"Іантиніт"},"elements":["H","O","U"],"fame":9,"kind":null},{"id":"Q4008527","formula":"Pb₁.₆(UO₂)₁₀O₆(OH)₁₁·11H₂O","names":{"en":"Vandendriesscheite","ru":"Вандендрисшеит","uk":"Вандендрисшеїт"},"elements":["H","O","Pb","U"],"fame":8,"kind":null},{"id":"Q3895292","formula":"UO₃*2H₂O","names":{"en":"Paraschoepite","uk":"Параскупіт"},"elements":["H","O","U"],"fame":5,"kind":null},{"id":"Q408600","formula":"(UO₂)₈O₂(OH)₁₂*12H₂O","names":{"en":"Schoepite","ru":"Скупит","uk":"Скупіт"},"elements":["H","O","U"],"fame":15,"kind":null},{"id":"Q2479128","formula":"Cu(UO₂)₂(SiO₃OH)₂·6H₂O","names":{"en":"Cuprosklodowskite","uk":"Купросклодовськіт"},"elements":["H","O","Si","Cu","U"],"fame":14,"kind":null},{"id":"Q1075665","formula":"Mg(UO₂)₂(SiO₃OH)₂·6H₂O","names":{"en":"Sklodowskite","ru":"Склодовскит","uk":"Склодовськіт"},"elements":["H","O","Mg","Si","U"],"fame":13,"kind":null},{"id":"Q3749147","formula":"Pb(UO₂)₄O₃(OH)₄·4H₂O","names":{"en":"Fourmarierite","uk":"Фурмар'єрит"},"elements":["H","O","Pb","U"],"fame":12,"kind":null},{"id":"Q4008654","formula":"Al(UO₂)₂(VO₄)₂(OH)·8.5H₂O","names":{"en":"Vanuralite","ru":"Вануралит","uk":"Ванураніліт"},"elements":["H","O","Al","V","U"],"fame":11,"kind":null}],"photo":{"url":"https://upload.wikimedia.org/wikipedia/commons/4/48/Becquerelite-Uranophane-Uraninite-201144.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","page":"https://commons.wikimedia.org/wiki/File:Becquerelite-Uranophane-Uraninite-201144.jpg","license":"CC BY-SA 3.0","author":"Robert M. Lavinsky","licenseUrl":"https://creativecommons.org/licenses/by-sa/3.0"}}
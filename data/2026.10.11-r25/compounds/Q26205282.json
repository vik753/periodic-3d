{"version":"2026.10.11-r25","id":"Q26205282","formula":"KPb[(UO₂)₇O₅(OH)₇]·8H₂O","hill":"H23KO34PbU7","elements":["H","O","K","Pb","U"],"composition":{"H":23.0,"K":1.0,"O":34.0,"U":7.0,"Pb":1.0},"names":{"en":"Gauthierite","ru":"Готиерит"},"descriptions":{"en":"Gauthierite is a very rare mineral with the idealised chemical sum formula KPb[(UO2)7O5(OH)7]·8H2O. It is a radioactive, hydrated orange-coloured lead potassium uranyl oxide hydroxide. It was found by analysing old mineral specimens, and is only known from one locality, the Shinkolobwe Mine in the Democratic Republic of the Congo. The mineral was named in honour of Gilbert Gauthier, a Belgian collector of uranium minerals, who provided a sample to one of the co-authors of the study that first identified it in 2017."},"fame":8,"pubchemCid":null,"mass":null,"charge":0,"smiles":null,"inchikey":null,"iupac":null,"classes":[{"qid":"Q12089225","names":{"en":"mineral species","ru":"действительный вид минералов","uk":"мінеральний вид"}}],"structureInfo":null,"structure":null,"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q26205282","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Gauthierite","license":"CC BY-SA 4.0"},{"role":"photo","name":"Wikimedia Commons","url":"https://commons.wikimedia.org/wiki/File:Gauthierite.jpg","license":"CC BY-SA 4.0"}],"similar":[{"id":"Q3749147","formula":"Pb(UO₂)₄O₃(OH)₄·4H₂O","names":{"en":"Fourmarierite","uk":"Фурмар'єрит"},"elements":["H","O","Pb","U"],"fame":12,"kind":null},{"id":"Q4008527","formula":"Pb₁.₆(UO₂)₁₀O₆(OH)₁₁·11H₂O","names":{"en":"Vandendriesscheite","ru":"Вандендрисшеит","uk":"Вандендрисшеїт"},"elements":["H","O","Pb","U"],"fame":8,"kind":null},{"id":"Q3637404","formula":"Ca(UO₂)₆O₄(OH)₆·8(H₂O)","names":{"en":"Becquerelite","ru":"Беккерелит","uk":"Бекереліт"},"elements":["H","O","Ca","U"],"fame":17,"kind":null},{"id":"Q769232","formula":"Pb(UO₂)₃O₃(OH)₂*3H₂O","names":{"en":"M
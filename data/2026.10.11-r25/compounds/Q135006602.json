{"version":"2026.10.11-r25","id":"Q135006602","formula":"C₂H₅OP","hill":"C2H5OP","elements":["H","C","O","P"],"composition":{"C":2.0,"H":5.0,"O":1.0,"P":1.0},"names":{"en":"1,3-oxaphosphetane"},"descriptions":{"en":"An oxaphosphetane is a molecule containing a four-membered ring with one phosphorus, one oxygen and two carbon atoms. In a 1,2-oxaphosphetane phosphorus is bonded directly to oxygen, whereas a 1,3-oxaphosphetane has the phosphorus and oxygen atoms at opposite corners. 1,2-Oxaphosphetanes are rarely isolated but are important intermediates in the Wittig reaction and related reactions such as the Seyferth–Gilbert homologation and the Horner–Wadsworth–Emmons reaction."},"fame":1,"pubchemCid":20362213,"mass":76.03,"charge":0,"smiles":"C1OCP1","inchikey":"XIEBRVIWJYCCCK-UHFFFAOYSA-N","iupac":"1,3-oxaphosphetane","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"20362213","atoms":9,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":1.291,"y":0.0,"z":0.126,"el":"P"},{"x":-1.015,"y":0.0,"z":0.205,"el":"O"},{"x":-0.138,"y":-1.08,"z":-0.165,"el":"C"},{"x":-0.138,"y":1.08,"z":-0.165,"el":"C"},{"x":-0.194,"y":-1.926,"z":0.522,"el":"H"},{"x":-0.269,"y":-1.392,"z":-1.204,"el":"H"},{"x":-0.269,"y":1.392,"z":-1.204,"el":"H"},{"x":-0.194,"y":1.926,"z":0.522,"el":"H"},{"x":1.256,"y":0.0,"z":1.54,"el":"H"}],"bonds":[[0,2,1],[0,3,1],[0,8,1],[1,2,1],[1,3,1],[2,4,1],[2,5,1],[3,6,1],[3,7,1]]},"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q135006602","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/1%2C3-oxaphosphetane","license":"CC BY-SA 4.0"},{"role":"properties","name":"PubChem","url":"https://pubchem.ncbi.nlm.nih.gov/compound/20362213","license":"PubChem (NIH), public data"},{"role":"structure","name":"Pu
{"version":"2026.10.11-r25","id":"Q27895916","formula":"C₂₄H₂₆N₄O","hill":"C24H26N4O","elements":["H","C","N","O"],"composition":{"C":24.0,"H":26.0,"N":4.0,"O":1.0},"names":{"en":"Dordaviprone"},"descriptions":{"en":"Dordaviprone, sold under the brand name Modeyso, is an anti-cancer medication used for the treatment of diffuse midline glioma (a type of brain tumor). Dordaviprone is a protease activator of the mitochondrial caseinolytic protease P. It is dopamine receptor D2 antagonist and an allosteric activator of the mitochondrial caseinolytic protease P. Dordaviprone was approved for medical use in the United States in August 2025. It is the first approval of a systemic therapy for H3 K27M-mutant diffuse midline glioma by the US Food and Drug Administration (FDA)."},"fame":1,"pubchemCid":73777259,"mass":386.5,"charge":0,"smiles":"CC1=CC=CC=C1CN2C(=O)C3=C(CCN(C3)CC4=CC=CC=C4)N5C2=NCC5","inchikey":"VLULRUCCHYVXOH-UHFFFAOYSA-N","iupac":"11-benzyl-7-[(2-methylphenyl)methyl]-2,5,7,11-tetrazatricyclo[7.4.0.02,6]trideca-1(9),5-dien-8-one","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"rdkit","ref":"73777259","atoms":55,"license":"Computed with RDKit from SMILES (PubChem, Wikidata)"},"structure":{"kind":"molecule","atoms":[{"x":-3.754,"y":3.147,"z":0.517,"el":"C"},{"x":-4.61,"y":1.951,"z":0.204,"el":"C"},{"x":-5.758,"y":1.746,"z":0.994,"el":"C"},{"x":-6.599,"y":0.656,"z":0.779,"el":"C"},{"x":-6.301,"y":-0.255,"z":-0.225,"el":"C"},{"x":-5.161,"y":-0.075,"z":-1.007,"el":"C"},{"x":-4.293,"y":1.018,"z":-0.808,"el":"C"},{"x":-3.058,"y":1.122,"z":-1.694,"el":"C"},{"x":-1.886,"y":0.461,"z":-1.128,"el":"N"},{"x":-0.916,"y":1.235,"z":-0.503,"el":"C"},{"x":-0.93,"y":2.465,"z":-0.475,"el":"O"},{"x":0.228,"y":0.515,"z":0.144,"el":"C"},{"x":0.324,"y":-0.82,"z":0.003,"el":"C"},{"x":1.455,"y":-1.571,"z":0.663,"el":"C"},{"x":2.235,"y":-0.706,"z":1.669,"el":
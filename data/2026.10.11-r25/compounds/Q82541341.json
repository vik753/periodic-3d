{"version":"2026.10.11-r25","id":"Q82541341","formula":"C₂H₅OP","hill":"C2H5OP","elements":["H","C","O","P"],"composition":{"C":2.0,"H":5.0,"O":1.0,"P":1.0},"names":{"en":"1,2-oxaphosphetane"},"descriptions":{"en":"An oxaphosphetane is a molecule containing a four-membered ring with one phosphorus, one oxygen and two carbon atoms. In a 1,2-oxaphosphetane phosphorus is bonded directly to oxygen, whereas a 1,3-oxaphosphetane has the phosphorus and oxygen atoms at opposite corners. 1,2-Oxaphosphetanes are rarely isolated but are important intermediates in the Wittig reaction and related reactions such as the Seyferth–Gilbert homologation and the Horner–Wadsworth–Emmons reaction."},"fame":1,"pubchemCid":23373974,"mass":76.03,"charge":0,"smiles":"C1CPO1","inchikey":"JONKIUBSNSUGGZ-UHFFFAOYSA-N","iupac":"oxaphosphetane","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"23373974","atoms":9,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":1.07,"y":-0.577,"z":0.107,"el":"P"},{"x":0.505,"y":0.927,"z":-0.137,"el":"O"},{"x":-0.702,"y":-0.926,"z":-0.114,"el":"C"},{"x":-0.873,"y":0.575,"z":0.144,"el":"C"},{"x":-1.116,"y":-1.601,"z":0.634,"el":"H"},{"x":-0.931,"y":-1.255,"z":-1.129,"el":"H"},{"x":-1.566,"y":1.08,"z":-0.539,"el":"H"},{"x":-1.157,"y":0.843,"z":1.171,"el":"H"},{"x":1.112,"y":-0.539,"z":1.522,"el":"H"}],"bonds":[[0,1,1],[0,2,1],[0,8,1],[1,3,1],[2,3,1],[2,4,1],[2,5,1],[3,6,1],[3,7,1]]},"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q82541341","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/1%2C2-oxaphosphetane","license":"CC BY-SA 4.0"},{"role":"properties","name":"PubChem","url":"https://pubchem.ncbi.nlm.nih.gov/compound/23373974","license":"PubChem (NIH), public data"},{"role":"structure","name":"
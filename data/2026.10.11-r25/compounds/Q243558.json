{"version":"2026.10.11-r25","id":"Q243558","formula":"Al·Cu·Fe·Mg·Mn·Si","hill":"AlCuFeMgMnSi","elements":["Mg","Al","Si","Mn","Fe","Cu"],"composition":{"Al":1.0,"Cu":1.0,"Fe":1.0,"Mg":1.0,"Mn":1.0,"Si":1.0},"names":{"en":"Duralumin","ru":"Дюралюминий","uk":"Дюралюміній"},"descriptions":{"en":"Duralumin (also called duraluminum, duraluminium, duralum, dural(l)ium, or dural) is a trade name for one of the earliest types of age-hardenable aluminium–copper alloys. The term is a combination of Düren, dur (a German prefix meaning \"hard\"), and aluminium. Its use as a trade name is obsolete.","ru":"Дюралюми́н, дюралюми́ний, дюра́ль — собирательное обозначение группы высокопрочных сплавов на основе алюминия (алюминиевый сплав) с добавками меди, магния и марганца. Название сплава происходит от торговой марки Dural (фр. dur — твёрдый) — коммерческого обозначения одного из первых упрочняемых термообработкой и последующим старением алюминиевых сплавов.","uk":"Дюралюміній — торгівельна марка одного з перших зміцнюваних старінням алюмінієвих сплавів. Основними легуючими елементами є мідь (4,4 %), магній (1,5 %), манган (0,6 %). Алюміній становить 93,5 % за масою сплаву."},"fame":53,"pubchemCid":null,"mass":null,"charge":0,"smiles":null,"inchikey":null,"iupac":null,"classes":[{"qid":"Q447725","names":{"en":"aluminium alloy","ru":"алюминиевый сплав","uk":"алюмінієві сплави"}}],"structureInfo":null,"structure":null,"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q243558","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Duralumin","license":"CC BY-SA 4.0"},{"role":"description","name":"Wikipedia (ru)","url":"https://ru.wikipedia.org/wiki/%D0%94%D1%8E%D1%80%D0%B0%D0%BB%D1%8E%D0%BC%D0%B8%D0%BD%D0%B8%D0%B9","license":"CC BY-SA 4.0"},{"role":"description","name":"Wikipedia (uk)","url":"https://uk.wikipedia.org/wiki/%D0%94%D1%8E%D1%80%D0%B0%D0%BB%D1%8E%D0%BC%D1%96%D0%BD%D1%96%D0%B9","license":"CC BY-SA 4.0"},{"role":"photo","name":"Wikimedia Commons","url":"https://commons.wikimedia.org/wiki/File:DLZ129_spar.jpg","license":"CC BY 3.0"}],"similar":[{"id":"Q586697","formula":"Al·Cu·Mg·Si","names":{"en":"Avional"},"elements":["Mg","Al","Si","Cu"],"fame":2,"kind":null},{"id":"Q2607372","formula":"Al·Cr·Cu·Fe·Mg·Mn·Si·Ti·Zn","names":{"en":"7075 aluminium alloy"},"elements":["Mg","Al","Si","Ti","Cr","Mn","Fe","Cu","Zn"],"fame":10,"kind":null},{"id":"Q16968874","formula":"Al·Cu·Mg·Ni·Si","names":{"en":"Lo-Ex"},"elements":["Mg","Al","Si","Ni","Cu"],"fame":1,"kind":null},{"id":"Q447401","formula":"Al·Fe·Mn·Ni·Si","names":{"en":"Alumel","ru":"Алюмель","uk":"Алюмель"},"elements":["Al","Si","Mn","Fe","Ni"],"fame":17,"kind":null},{"id":"Q114538","formula":"Fe₂Si","names":{"en":"Hapkeite","uk":"Гапкеїт"},"elements":["Si","Fe"],"fame":13,"kind":"crystal"},{"id":"Q15628164","formula":"Fe₂Si","names":{"en":"Diiron silicide","ru":"Силицид дижелеза"},"elements":["Si","Fe"],"fame":5,"kind":"crystal"},{"id":"Q4021824","formula":"Fe₅Si₃","names":{"en":"Xifengite","uk":"Цзифенгіт"},"elements":["Si","Fe"],"fame":7,"kind":"crystal"},{"id":"Q18211769","formula":"Mn₃Si","names":{"ru":"Силицид тримарганца"},"elements":["Si","Mn"],"fame":1,"kind":"crystal"}],"photo":{"url":"https://upload.wikimedia.org/wikipedia/commons/4/48/DLZ129_spar.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","page":"https://commons.wikimedia.org/wiki/File:DLZ129_spar.jpg","license":"CC BY 3.0","author":"Image creator/original uploader Centpacrr at en.wikipedia","licenseUrl":"https://creativecommons.org/licenses/by/3.0"}}
{"version":"2026.10.11-r25","id":"Q5443572","formula":"C₂₂H₂₉N₂O⁺","hill":"C22H29N2O","elements":["H","C","N","O"],"composition":{"C":22.0,"H":29.0,"N":2.0,"O":1.0},"names":{"en":"Fenpiverinium"},"descriptions":{"en":"Fenpiverinium is an anticholinergic and antispasmodic compound; it is marketed as a combination drug with pitofenone hydrochloride and either nimesulide or metamizole in Eastern Europe and India to treat smooth muscle spasms and pain. The combination with metamizole was removed from the market in Lithuania for safety reasons in 2000 and a boxed warning against use by children and adolescents was added in Serbia in 2005. In 2016 India banned marketing of the combination with nimesulide along with 344 other combination drugs; the order was overturned in December and appealed by the Government in January 2017."},"fame":5,"pubchemCid":71490,"mass":337.5,"charge":1,"smiles":"C[N+]1(CCCCC1)CCC(C2=CC=CC=C2)(C3=CC=CC=C3)C(=O)N","inchikey":"QDIYJDPBMZUZEH-UHFFFAOYSA-O","iupac":"4-(1-methylpiperidin-1-ium-1-yl)-2,2-diphenylbutanamide","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"71490","atoms":54,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":0.62,"y":0.815,"z":2.732,"el":"O"},{"x":-2.985,"y":-0.384,"z":0.322,"el":"N"},{"x":1.343,"y":-1.342,"z":2.573,"el":"N"},{"x":-3.074,"y":-0.418,"z":-1.208,"el":"C"},{"x":-4.106,"y":0.479,"z":0.911,"el":"C"},{"x":-1.643,"y":0.252,"z":0.706,"el":"C"},{"x":-4.451,"y":-0.862,"z":-1.687,"el":"C"},{"x":-5.48,"y":0.033,"z":0.427,"el":"C"},{"x":-5.562,"y":-0.008,"z":-1.092,"el":"C"},{"x":-0.509,"y":-0.582,"z":0.097,"el":"C"},{"x":-3.004,"y":-1.795,"z":0.91,"el":"C"},{"x":0.95,"y":-0.094,"z":0.461,"el":"C"},{"x":1.272,"y":1.329,"z":-0.078,"el":"C"},{"x":2.018,"y":-1.056,"z":-0.138,"el":"C"},{"x":0.972,"y":-0.129,"z":2.025,"el":"C"},{"x":0.69,"y":1.7
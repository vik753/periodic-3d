{"version":"2026.10.11-r25","id":"Q5206163","formula":"C₁₁H₁₅BrClN","hill":"C11H15BrClN","elements":["H","C","N","Cl","Br"],"composition":{"C":11.0,"H":15.0,"N":1.0,"Br":1.0,"Cl":1.0},"names":{"en":"DSP-4"},"descriptions":{"en":"For the Super NES enhancement chip see List of Super NES enhancement chips DSP-4, or N-(2-chloroethyl)-N-ethyl-2-bromobenzylamine, is a monoaminergic neurotoxin selective for noradrenergic neurons, capable of crossing the blood–brain barrier. It exerts transient effects in peripheral sympathetic neurons, but more permanent changes within neurons of the central nervous system. It can induce long-term depletion in cortical and spinal levels of noradrenaline."},"fame":4,"pubchemCid":3172,"mass":276.6,"charge":0,"smiles":"CCN(CCCl)CC1=CC=CC=C1Br","inchikey":"SDJLVPMBBFRBLL-UHFFFAOYSA-N","iupac":"N-[(2-bromophenyl)methyl]-2-chloro-N-ethylethanamine","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"3172","atoms":29,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-0.655,"y":2.595,"z":0.988,"el":"Br"},{"x":4.814,"y":1.256,"z":-0.549,"el":"Cl"},{"x":1.262,"y":-0.495,"z":0.191,"el":"N"},{"x":0.448,"y":0.193,"z":-0.81,"el":"C"},{"x":2.683,"y":-0.371,"z":-0.133,"el":"C"},{"x":0.88,"y":-1.904,"z":0.28,"el":"C"},{"x":-1.019,"y":0.137,"z":-0.475,"el":"C"},{"x":3.09,"y":1.095,"z":-0.136,"el":"C"},{"x":1.71,"y":-2.64,"z":1.311,"el":"C"},{"x":-1.625,"y":1.118,"z":0.299,"el":"C"},{"x":-1.753,"y":-0.935,"z":-0.967,"el":"C"},{"x":-2.987,"y":1.026,"z":0.586,"el":"C"},{"x":-3.115,"y":-1.027,"z":-0.68,"el":"C"},{"x":-3.732,"y":-0.047,"z":0.096,"el":"C"},{"x":0.604,"y":-0.256,"z":-1.803,"el":"H"},{"x":0.708,"y":1.242,"z":-0.958,"el":"H"},{"x":2.911,"y":-0.835,"z":-1.102,"el":"H"},{"x":3.309,"y":-0.859,"z":0.621,"el":"H"},{"x":-0.147,"y":-2.006,"z":0.642,"el":"H"},{"x":0.959,"y":-2.418,"
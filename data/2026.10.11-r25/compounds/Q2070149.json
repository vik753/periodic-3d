{"version":"2026.10.11-r25","id":"Q2070149","formula":"CO₄²⁻","hill":"CO4","elements":["C","O"],"composition":{"C":1.0,"O":4.0},"names":{"en":"Peroxycarbonate"},"descriptions":{"en":"In chemistry, peroxycarbonate (sometimes peroxocarbonate, IUPAC name: oxocarbonate or oxidocarbonate) or percarbonate is a divalent anion with formula CO2−4. It is an oxocarbon anion that consists solely of carbon and oxygen. It is the anion of peroxycarbonic acid also called hydroperoxyformic acid, HO−O−CO−OH. The peroxycarbonate anion is formed, together with peroxydicarbonate C2O2−6, at the negative electrode during electrolysis of molten lithium carbonate."},"fame":5,"pubchemCid":15793132,"mass":76.01,"charge":-2,"smiles":"C(=O)([O-])O[O-]","inchikey":"MMCOUVMKNAHQOY-UHFFFAOYSA-L","iupac":"oxido carbonate","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"15793132","atoms":5,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":0.743,"y":0.8,"z":0.0,"el":"O"},{"x":-0.475,"y":-1.304,"z":0.0,"el":"O"},{"x":-1.67,"y":0.549,"z":0.0,"el":"O"},{"x":1.83,"y":-0.141,"z":0.0,"el":"O"},{"x":-0.428,"y":0.095,"z":0.0,"el":"C"}],"bonds":[[0,3,1],[0,4,1],[1,4,1],[2,4,2]]},"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q2070149","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Peroxycarbonate","license":"CC BY-SA 4.0"},{"role":"properties","name":"PubChem","url":"https://pubchem.ncbi.nlm.nih.gov/compound/15793132","license":"PubChem (NIH), public data"},{"role":"structure","name":"PubChem 3D","url":"https://pubchem.ncbi.nlm.nih.gov/compound/15793132#section=3D-Conformer","license":"PubChem (NIH), public data"}],"similar":[{"id":"Q1086826","formula":"CO₄","names":{"en":"Carbon tetroxide"},"elements":["C","O"],"fame":15,"kind":"molecul
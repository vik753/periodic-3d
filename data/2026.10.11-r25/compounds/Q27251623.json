{"version":"2026.10.11-r25","id":"Q27251623","formula":"C₂₁H₂₇NO₃","hill":"C21H27NO3","elements":["H","C","N","O"],"composition":{"C":21.0,"H":27.0,"N":1.0,"O":3.0},"names":{"en":"Benapryzine"},"descriptions":{"en":"Benapryzine (BANTooltip British Approved Name), or benaprizine (INNTooltip International Nonproprietary Name), also known as benapryzine hydrochloride (USANTooltip United States Adopted Name in the case of the hydrochloride salt and sold under the brand name Brizin, is an antiparkinsonian agent and anticholinergic which has been used in the treatment of parkinsonism. As an anticholinergic, it is specifically a muscarinic acetylcholine receptor antagonist. Structurally, benapryzine is a benzilate, and is closely related to other antimuscarinic benzilate derivatives like benactyzine."},"fame":1,"pubchemCid":18551,"mass":341.4,"charge":0,"smiles":"CCCN(CC)CCOC(=O)C(C1=CC=CC=C1)(C2=CC=CC=C2)O","inchikey":"PYPJRLVCFAVWFR-UHFFFAOYSA-N","iupac":"2-[ethyl(propyl)amino]ethyl 2-hydroxy-2,2-diphenylacetate","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"18551","atoms":52,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":0.814,"y":1.398,"z":-0.365,"el":"O"},{"x":-1.14,"y":0.504,"z":-1.952,"el":"O"},{"x":-0.987,"y":2.452,"z":0.602,"el":"O"},{"x":3.556,"y":0.889,"z":0.202,"el":"N"},{"x":3.085,"y":2.149,"z":-0.373,"el":"C"},{"x":4.672,"y":0.357,"z":-0.579,"el":"C"},{"x":-1.31,"y":0.308,"z":-0.533,"el":"C"},{"x":3.954,"y":1.082,"z":1.596,"el":"C"},{"x":1.664,"y":2.447,"z":0.079,"el":"C"},{"x":4.158,"y":-0.298,"z":-1.858,"el":"C"},{"x":-0.68,"y":-1.024,"z":-0.119,"el":"C"},{"x":-2.796,"y":0.346,"z":-0.168,"el":"C"},{"x":-0.515,"y":1.517,"z":-0.035,"el":"C"},{"x":4.389,"y":-0.229,"z":2.229,"el":"C"},{"x":3.191,"y":-1.431,"z":-1.551,"el":"C"},{"x":-0.67,"y":-2.098,"z":-1.01,"el":"C"},{"x":-3.1
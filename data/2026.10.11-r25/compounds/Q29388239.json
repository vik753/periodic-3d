{"version":"2026.10.11-r25","id":"Q29388239","formula":"C₆H₄F₁₁NO₃","hill":"C6H4F11NO3","elements":["H","C","N","O","F"],"composition":{"C":6.0,"F":11.0,"H":4.0,"N":1.0,"O":3.0},"names":{"en":"Ammonium 2,3,3,3-tetrafluoro-2-(heptafluoropropoxy)propanoate"},"descriptions":{"en":"GenX is a Chemours trademark name for a synthetic, short-chain organofluorine chemical compound, the ammonium salt of hexafluoropropylene oxide dimer acid (HFPO-DA). It can also be used more informally to refer to the group of related fluorochemicals that are used to produce GenX. DuPont began the commercial development of GenX in 2009 as a replacement for perfluorooctanoic acid (PFOA, also known as C8), in response to legal action due to the health effects and ecotoxicity of PFOA. Although GenX was designed to be less persistent in the environment compared to PFOA, its effects may be equally harmful or even more detrimental than those of the chemical it was meant to replace."},"fame":2,"pubchemCid":51342034,"mass":347.08,"charge":0,"smiles":"C(=O)(C(C(F)(F)F)(OC(C(C(F)(F)F)(F)F)(F)F)F)[O-].[NH4+]","inchikey":"RJWVKMAIYPNUSL-UHFFFAOYSA-N","iupac":"azanium 2,3,3,3-tetrafluoro-2-(1,1,2,2,3,3,3-heptafluoropropoxy)propanoate","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"rdkit","ref":"51342034","atoms":25,"license":"Computed with RDKit from SMILES (PubChem, Wikidata)"},"structure":{"kind":"molecule","atoms":[{"x":-0.843,"y":0.556,"z":0.571,"el":"C"},{"x":0.252,"y":0.974,"z":1.066,"el":"O"},{"x":-0.878,"y":-0.951,"z":0.278,"el":"C"},{"x":-1.797,"y":-1.437,"z":1.383,"el":"C"},{"x":-1.887,"y":-2.805,"z":1.322,"el":"F"},{"x":-3.076,"y":-1.001,"z":1.312,"el":"F"},{"x":-1.343,"y":-1.174,"z":2.634,"el":"F"},{"x":0.427,"y":-1.564,"z":0.348,"el":"O"},{"x":1.226,"y":-1.25,"z":-0.779,"el":"C"},{"x":2.718,"y":-1.333,"z":-0.514,"el":"C"},{"x":3.172,"y":-0.304,"z":0.492,"el":"C"}
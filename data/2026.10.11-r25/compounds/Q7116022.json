{"version":"2026.10.11-r25","id":"Q7116022","formula":"C₁₇H₂₁NO₄","hill":"C17H21NO4","elements":["H","C","N","O"],"composition":{"C":17.0,"H":21.0,"N":1.0,"O":4.0},"names":{"en":"Oxymorphol"},"descriptions":{"en":"Oxymorphol is oxymorphone which has been hydrogenated at the 6-position and consists of a mixture of 4,5α-epoxy-17-methylmorphinan-3,6β,14-triol and 4,5α-epoxy-17-methylmorphinan-3,6α,14-triol (hydromorphinol). It is produced by the human body as an active metabolite of oxymorphone and some bacteria as an intermediate in turning morphine into hydromorphone. It can also be manufactured and is the subject of patents by drug companies looking for new semi-synthetic analgesics and cough suppressants."},"fame":1,"pubchemCid":6712731,"mass":303.35,"charge":0,"smiles":"CN1CC[C@]23[C@@H]4C(CC[C@]2([C@H]1CC5=C3C(=C(C=C5)O)O4)O)O","inchikey":"AABLHGPVOULICI-ZOFKVTQNSA-N","iupac":"(4R,4aS,7aR,12bS)-3-methyl-1,2,4,5,6,7,7a,13-octahydro-4,12-methanobenzofuro[3,2-e]isoquinoline-4a,7,9-triol","classes":[{"qid":"Q59199015","names":{"en":"group of stereoisomers","ru":"группа стереоизомеров","uk":"група стереоізомерів"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"6712731","atoms":43,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":2.029,"y":0.611,"z":1.184,"el":"O"},{"x":-2.274,"y":1.953,"z":0.214,"el":"O"},{"x":2.058,"y":3.451,"z":0.062,"el":"O"},{"x":3.958,"y":-1.495,"z":0.558,"el":"O"},{"x":-2.947,"y":-0.684,"z":0.527,"el":"N"},{"x":-0.315,"y":0.542,"z":0.598,"el":"C"},{"x":-1.395,"y":0.992,"z":-0.397,"el":"C"},{"x":-2.249,"y":-0.28,"z":-0.723,"el":"C"},{"x":0.884,"y":1.48,"z":0.84,"el":"C"},{"x":-0.988,"y":0.065,"z":1.908,"el":"C"},{"x":0.466,"y":-0.595,"z":0.033,"el":"C"},{"x":-0.804,"y":1.69,"z":-1.633,"el":"C"},{"x":1.306,"y":2.323,"z":-0.387,"el":"C"},{"x":-1.399,"y":-1.419,"z":-1.387,"el":"C"},{"x":0.135,"y":2.828,"z":-1.225,"el":"C"},{"x":-2.059,"y":-1.012,"z":1.648,"el":"C"},{"x":-0.005,"y":-1.561,"z":-0.834,
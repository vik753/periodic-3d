{"version":"2026.10.11-r25","id":"Q519447","formula":"C₁₄H₇Cl₂NO₃","hill":"C14H7Cl2NO3","elements":["H","C","N","O","Cl"],"composition":{"C":14.0,"H":7.0,"N":1.0,"O":3.0,"Cl":2.0},"names":{"en":"Tafamidis"},"descriptions":{"en":"Tafamidis, sold under the brand names Vyndaqel and Vyndamax, is a medication used to delay disease progression in adults with certain forms of transthyretin amyloidosis. It can be used to treat both hereditary forms, familial amyloid cardiomyopathy and familial amyloid polyneuropathy, as well as wild-type transthyretin amyloidosis, which formerly was called senile systemic amyloidosis. It works by stabilizing the quaternary structure of the protein transthyretin."},"fame":15,"pubchemCid":11001318,"mass":308.1,"charge":0,"smiles":"C1=CC2=C(C=C1C(=O)O)OC(=N2)C3=CC(=CC(=C3)Cl)Cl","inchikey":"TXEIIPDJKFWEEC-UHFFFAOYSA-N","iupac":"2-(3,5-dichlorophenyl)-1,3-benzoxazole-6-carboxylic acid","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"11001318","atoms":27,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-5.525,"y":-2.154,"z":-0.001,"el":"Cl"},{"x":-4.438,"y":3.132,"z":-0.002,"el":"Cl"},{"x":0.139,"y":0.696,"z":0.002,"el":"O"},{"x":4.981,"y":2.032,"z":0.0,"el":"O"},{"x":6.144,"y":0.079,"z":-0.001,"el":"O"},{"x":-0.066,"y":-1.561,"z":0.0,"el":"N"},{"x":1.395,"y":0.159,"z":0.001,"el":"C"},{"x":1.265,"y":-1.222,"z":0.0,"el":"C"},{"x":-0.676,"y":-0.396,"z":0.002,"el":"C"},{"x":-2.083,"y":-0.107,"z":0.001,"el":"C"},{"x":2.605,"y":0.841,"z":0.001,"el":"C"},{"x":2.424,"y":-2.011,"z":-0.001,"el":"C"},{"x":3.752,"y":0.039,"z":0.0,"el":"C"},{"x":3.665,"y":-1.359,"z":-0.001,"el":"C"},{"x":-2.529,"y":1.218,"z":0.0,"el":"C"},{"x":-3.015,"y":-1.148,"z":0.0,"el":"C"},{"x":-4.382,"y":-0.868,"z":0.0,"el":"C"},{"x":-3.895,"y":1.499,"z":0.0,"el":"C"},{"x":-4.822,"y":0.456,"z":-0.001,"el
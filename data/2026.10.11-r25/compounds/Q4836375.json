{"version":"2026.10.11-r25","id":"Q4836375","formula":"C₉H₁₂N₂O₄S","hill":"C9H12N2O4S","elements":["H","C","N","O","S"],"composition":{"C":9.0,"H":12.0,"N":2.0,"O":4.0,"S":1.0},"names":{"en":"Brl-50481"},"descriptions":{"en":"BRL-50481 is a drug developed by GlaxoSmithKline which is the first compound that acts as a phosphodiesterase inhibitor selective for the PDE7 family. PDE7 activity is encoded by two genes, PDE7A and PDE7B. BRL-50481 actually shows about an 80-fold preference for the PDE7A subtype, for which it was developed, over PDE7B. BRL-50481 has been shown to increase mineralisation activity in osteoblasts, suggesting a potential role for PDE7 inhibitors in the treatment of osteoporosis."},"fame":3,"pubchemCid":2921148,"mass":244.27,"charge":0,"smiles":"CC1=C(C=C(C=C1)[N+](=O)[O-])S(=O)(=O)N(C)C","inchikey":"IFIUFCJFLGCQPH-UHFFFAOYSA-N","iupac":"N,N,2-trimethyl-5-nitrobenzenesulfonamide","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"2921148","atoms":28,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":1.918,"y":0.237,"z":0.727,"el":"S"},{"x":1.704,"y":1.358,"z":1.623,"el":"O"},{"x":2.716,"y":-0.891,"z":1.173,"el":"O"},{"x":-4.274,"y":0.433,"z":-0.272,"el":"O"},{"x":-2.97,"y":2.066,"z":0.403,"el":"O"},{"x":2.53,"y":0.814,"z":-0.779,"el":"N"},{"x":-3.143,"y":0.876,"z":0.043,"el":"N"},{"x":0.324,"y":-0.392,"z":0.281,"el":"C"},{"x":0.174,"y":-1.711,"z":-0.111,"el":"C"},{"x":-0.757,"y":0.473,"z":0.337,"el":"C"},{"x":-1.093,"y":-2.181,"z":-0.456,"el":"C"},{"x":-2.024,"y":0.004,"z":-0.009,"el":"C"},{"x":1.33,"y":-2.655,"z":-0.176,"el":"C"},{"x":1.763,"y":1.876,"z":-1.478,"el":"C"},{"x":3.996,"y":1.017,"z":-0.898,"el":"C"},{"x":-2.192,"y":-1.323,"z":-0.406,"el":"C"},{"x":-0.612,"y":1.506,"z":0.64,"el":"H"},{"x":-1.243,"y":-3.212,"z":-0.766,"el":"H"},{"x":1.64,"y":-2.975,"z":0.823,"e
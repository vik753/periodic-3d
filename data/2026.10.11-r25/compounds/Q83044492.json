{"version":"2026.10.11-r25","id":"Q83044492","formula":"C₃H₄Cl₂F₂S","hill":"C3H4Cl2F2S","elements":["H","C","F","S","Cl"],"composition":{"C":3.0,"F":2.0,"H":4.0,"S":1.0,"Cl":2.0},"names":{"en":"Thiomethoxyflurane"},"descriptions":{"en":"Thiomethoxyflurane, is a volatile, inhalational anesthetic. It is an analogue of the widely used inhalational anesthetic methoxyflurane but with the methoxy group replaced by a heavier methylthio group. Thiomethoxyflurane is approximately 7.5x more potent than methoxyflurane, making it the most potent inhalational anesthetic ever discovered, but was never developed for medical use due to its lower volatility, higher toxicity, and longer duration of action compared to methoxyflurane."},"fame":2,"pubchemCid":164920,"mass":181.03,"charge":0,"smiles":"CSC(C(Cl)Cl)(F)F","inchikey":"BJMNUMOCQIVWFA-UHFFFAOYSA-N","iupac":"2,2-dichloro-1,1-difluoro-1-methylsulfanylethane","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"164920","atoms":12,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-1.697,"y":-1.785,"z":-0.157,"el":"Cl"},{"x":-2.405,"y":1.019,"z":0.027,"el":"Cl"},{"x":1.511,"y":-0.901,"z":0.61,"el":"S"},{"x":0.209,"y":0.274,"z":-1.332,"el":"F"},{"x":0.455,"y":1.47,"z":0.472,"el":"F"},{"x":0.192,"y":0.211,"z":0.026,"el":"C"},{"x":-1.194,"y":-0.208,"z":0.509,"el":"C"},{"x":2.929,"y":-0.079,"z":-0.156,"el":"C"},{"x":-1.234,"y":-0.266,"z":1.601,"el":"H"},{"x":3.024,"y":0.944,"z":0.217,"el":"H"},{"x":2.821,"y":-0.067,"z":-1.243,"el":"H"},{"x":3.841,"y":-0.627,"z":0.096,"el":"H"}],"bonds":[[0,6,1],[1,6,1],[2,5,1],[2,7,1],[3,5,1],[4,5,1],[5,6,1],[6,8,1],[7,9,1],[7,10,1],[7,11,1]]},"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q83044492","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikiped
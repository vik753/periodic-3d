{"version":"2026.10.11-r25","id":"Q2697560","formula":"C₆H₇N","hill":"C6H7N","elements":["H","C","N"],"composition":{"C":6.0,"H":7.0,"N":1.0},"names":{"en":"Β-picoline"},"descriptions":{"en":"3-Methylpyridine or 3-picoline, is an organic compound with formula 3-CH3C5H4N. It is one of three positional isomers of methylpyridine, whose structures vary according to where the methyl group is attached around the pyridine ring. This colorless liquid is a precursor to pyridine derivatives that have applications in the pharmaceutical and agricultural industries. Like pyridine, 3-methylpyridine is a colorless liquid with a strong odor and is classified as a weak base."},"fame":18,"pubchemCid":7970,"mass":93.13,"charge":0,"smiles":"CC1=CN=CC=C1","inchikey":"ITQTTZVARXURQS-UHFFFAOYSA-N","iupac":"3-methylpyridine","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"7970","atoms":14,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":1.121,"y":-1.202,"z":0.0,"el":"N"},{"x":-0.978,"y":-0.003,"z":0.0,"el":"C"},{"x":-0.295,"y":1.208,"z":0.0,"el":"C"},{"x":-2.465,"y":-0.044,"z":0.001,"el":"C"},{"x":-0.23,"y":-1.169,"z":0.0,"el":"C"},{"x":1.096,"y":1.216,"z":0.0,"el":"C"},{"x":1.751,"y":-0.005,"z":0.0,"el":"C"},{"x":-0.835,"y":2.151,"z":0.002,"el":"H"},{"x":-2.883,"y":0.81,"z":-0.543,"el":"H"},{"x":-2.836,"y":-0.95,"z":-0.491,"el":"H"},{"x":-2.842,"y":-0.025,"z":1.028,"el":"H"},{"x":-0.706,"y":-2.145,"z":0.002,"el":"H"},{"x":1.649,"y":2.148,"z":0.001,"el":"H"},{"x":2.835,"y":-0.054,"z":0.001,"el":"H"}],"bonds":[[0,4,1],[0,6,2],[1,2,1],[1,3,1],[1,4,2],[2,5,2],[2,7,1],[3,8,1],[3,9,1],[3,10,1],[4,11,1],[5,6,1],[5,12,1],[6,13,1]]},"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q2697560","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedi
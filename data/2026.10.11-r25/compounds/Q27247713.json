{"version":"2026.10.11-r25","id":"Q27247713","formula":"C₁₂H₁₄F₅N₃O₄S","hill":"C12H14F5N3O4S","elements":["H","C","N","O","F","S"],"composition":{"C":12.0,"F":5.0,"H":14.0,"N":3.0,"O":4.0,"S":1.0},"names":{"en":"Pyroxasulfone"},"descriptions":{"en":"Pyroxasulfone is a pre-emergence herbicide that inhibits the production of very long chain fatty acids in plants. The structure of the existing herbicide thiobencarb served as the basis for development but pyroxasulfone requires a lower dose (100–25 g/ha) and is more stable resulting in longer efficacy. As of 2016 it had been registered for use in Japan, Australia, USA, Canada, Saudi Arabia and South Africa and was used on crops including maize, soybean, wheat and cotton."},"fame":4,"pubchemCid":11556910,"mass":391.32,"charge":0,"smiles":"CC1(CC(=NO1)S(=O)(=O)CC2=C(N(N=C2C(F)(F)F)C)OC(F)F)C","inchikey":"CASLETQIYIQFTQ-UHFFFAOYSA-N","iupac":"3-[[5-(difluoromethoxy)-1-methyl-3-(trifluoromethyl)pyrazol-4-yl]methylsulfonyl]-5,5-dimethyl-4H-1,2-oxazole","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"11556910","atoms":39,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":0.912,"y":-0.094,"z":-1.04,"el":"S"},{"x":-0.427,"y":-2.717,"z":0.747,"el":"F"},{"x":-2.382,"y":-3.232,"z":1.546,"el":"F"},{"x":-1.972,"y":-3.496,"z":-0.579,"el":"F"},{"x":-2.342,"y":4.219,"z":0.684,"el":"F"},{"x":-0.451,"y":3.145,"z":0.687,"el":"F"},{"x":4.723,"y":0.27,"z":-0.875,"el":"O"},{"x":0.653,"y":1.042,"z":-1.891,"el":"O"},{"x":0.862,"y":-1.458,"z":-1.508,"el":"O"},{"x":-2.257,"y":2.188,"z":-0.288,"el":"O"},{"x":3.443,"y":0.086,"z":-1.452,"el":"N"},{"x":-3.581,"y":0.244,"z":-0.283,"el":"N"},{"x":-3.52,"y":-1.085,"z":-0.088,"el":"N"},{"x":4.609,"y":0.058,"z":0.541,"el":"C"},{"x":3.164,"y":0.383,"z":0.849,"el":"C"},{"x":2.571,"y":0.128,"z":-0.494,"el":"C"},{"x":-0.034,"y":0.
{"version":"2026.10.11-r25","id":"Q3631336","formula":"Ca₂MgAl₂BSi₄O₁₅OH","hill":"Al2BCa2HMgO16Si4","elements":["H","B","O","Mg","Al","Si","Ca"],"composition":{"B":1.0,"H":1.0,"O":16.0,"Al":2.0,"Ca":2.0,"Mg":1.0,"Si":4.0},"names":{"en":"Axinite-(Mg)"},"descriptions":{"en":"Axinite-(Mg) is a borosilicate mineral of aluminum, calcium and magnesium of the axinite group, with magnesium as the dominant cation in the place of the structure that can also be occupied by iron and manganese. It was discovered in gem material from Merelani Hills, Lelatema Mts, Manyara Region, Tanzania, which is consequently its type locality. It was initially called magnesioaxinite, referring to its membership in the axinite group and the role of magnesium as the dominant cation."},"fame":6,"pubchemCid":null,"mass":null,"charge":0,"smiles":null,"inchikey":null,"iupac":null,"classes":[{"qid":"Q12089225","names":{"en":"mineral species","ru":"действительный вид минералов","uk":"мінеральний вид"}}],"structureInfo":null,"structure":null,"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q3631336","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Axinite-%28Mg%29","license":"CC BY-SA 4.0"},{"role":"photo","name":"Wikimedia Commons","url":"https://commons.wikimedia.org/wiki/File:Axinite-(Mg)-396672.jpg","license":"CC BY-SA 3.0"}],"similar":[{"id":"Q3631339","formula":"Ca₂MnAl₂BSi₄O₁₅(OH)","names":{"en":"Axinite-(Mn)","uk":"Cевергініт"},"elements":["H","B","O","Al","Si","Ca","Mn"],"fame":5,"kind":null},{"id":"Q272844","formula":"{Ca₂}{Al₂Fe}(Si₂O₇)(SiO₄)O(OH)","names":{"en":"Epidote","ru":"Эпидот","uk":"Епідот"},"elements":["H","O","Al","Si","Ca","Fe"],"fame":43,"kind":"crystal"},{"id":"Q422173","formula":"NaAlSi₂O₆","names":{"en":"Jadeite","ru":"Жадеит","uk":"Жадеїт"},"elements":["O","Na","Al","Si"],"fame":42,"kind":"crystal"},{"id":"Q213544","formula":"Ca₂Al₃(Si₂O₇)(SiO₄)O(OH)","names":{"en":"Zoisite","ru":"Цоизи
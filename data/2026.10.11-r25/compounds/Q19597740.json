{"version":"2026.10.11-r25","id":"Q19597740","formula":"C₈H₃Cl₂N₃O₄","hill":"C8H3Cl2N3O4","elements":["H","C","N","O","Cl"],"composition":{"C":8.0,"H":3.0,"N":3.0,"O":4.0,"Cl":2.0},"names":{"en":"Licostinel"},"descriptions":{"en":"Licostinel (INN; development code ACEA-1021) is a competitive, silent antagonist of the glycine site of the NMDA receptor (Kb = 5 nM). It was under investigation by Acea Pharmaceuticals as a neuroprotective agent for the treatment of cerebral ischemia associated with stroke and head injuries but was ultimately never marketed. In clinical trials, licostinel did not produce phencyclidine-like psychotomimetic effects at the doses tested, though transient sedation, dizziness, and nausea were observed."},"fame":4,"pubchemCid":5486198,"mass":276.03,"charge":0,"smiles":"C1=C2C(=C(C(=C1Cl)Cl)[N+](=O)[O-])NC(=O)C(=O)N2","inchikey":"CHFSOFHQIZKQCR-UHFFFAOYSA-N","iupac":"6,7-dichloro-5-nitro-1,4-dihydroquinoxaline-2,3-dione","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"5486198","atoms":20,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-3.792,"y":0.283,"z":-0.002,"el":"Cl"},{"x":-3.134,"y":-2.847,"z":0.0,"el":"Cl"},{"x":3.562,"y":1.467,"z":-0.001,"el":"O"},{"x":4.07,"y":-1.132,"z":0.0,"el":"O"},{"x":-0.406,"y":2.835,"z":0.001,"el":"O"},{"x":-2.561,"y":2.416,"z":0.0,"el":"O"},{"x":1.284,"y":1.086,"z":0.0,"el":"N"},{"x":1.815,"y":-1.635,"z":0.001,"el":"N"},{"x":-1.369,"y":2.037,"z":0.001,"el":"N"},{"x":0.221,"y":0.175,"z":0.001,"el":"C"},{"x":0.488,"y":-1.191,"z":0.001,"el":"C"},{"x":-1.096,"y":0.635,"z":0.0,"el":"C"},{"x":-0.561,"y":-2.112,"z":0.001,"el":"C"},{"x":-2.146,"y":-0.284,"z":0.0,"el":"C"},{"x":-1.879,"y":-1.655,"z":0.0,"el":"C"},{"x":2.607,"y":0.701,"z":-0.001,"el":"C"},{"x":2.896,"y":-0.781,"z":-0.001,"el":"C"},{"x":1.105,"y":2.082,"z":-0.001,"el":"H"},{"x
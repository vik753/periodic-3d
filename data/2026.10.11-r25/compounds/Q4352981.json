{"version":"2026.10.11-r25","id":"Q4352981","formula":"C₂₀H₂₃NO₄","hill":"C20H23NO4","elements":["H","C","N","O"],"composition":{"C":20.0,"H":23.0,"N":1.0,"O":4.0},"names":{"en":"6-Monoacetylcodeine"},"descriptions":{"en":"6-Monoacetylcodeine (6-MAC) is an acetate ester of codeine in which the hydroxyl group on the 6 position has been acetylated. It is occasionally present as an impurity in street heroin and is typically created when attempting to create heroin from a solution of morphine in which some of the codeine from the original opium solution still remains. It is formed either through the addition of acetic anhydride, which can only acetylate the 6 position on the codeine or as a result of the addition of acetic acid with a catalyst in an attempt to create 6-monoacetylmorphine, the equivalent ester of morphine which is slightly more potent than heroin itself."},"fame":6,"pubchemCid":5745725,"mass":341.4,"charge":0,"smiles":"CC(=O)O[C@@H]1C=C[C@H]2[C@H]3CC4=C5[C@]2([C@H]1OC5=C(C=C4)OC)CCN3C","inchikey":"MFXFQKMUCYHPFQ-ZLOUOWRTSA-N","iupac":"[(4R,4aR,7R,7aR,12bS)-9-methoxy-3-methyl-2,4,4a,7,7a,13-hexahydro-1H-4,12-methanobenzofuro[3,2-e]isoquinolin-7-yl] acetate","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"5745725","atoms":48,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":0.708,"y":-1.236,"z":1.423,"el":"O"},{"x":3.087,"y":0.983,"z":0.592,"el":"O"},{"x":0.069,"y":-4.002,"z":0.735,"el":"O"},{"x":4.333,"y":0.567,"z":-1.308,"el":"O"},{"x":-3.02,"y":2.214,"z":0.211,"el":"N"},{"x":-0.534,"y":0.692,"z":0.665,"el":"C"},{"x":-0.602,"y":1.818,"z":-0.37,"el":"C"},{"x":-2.076,"y":1.861,"z":-0.884,"el":"C"},{"x":0.861,"y":0.199,"z":1.097,"el":"C"},{"x":-1.447,"y":1.069,"z":1.851,"el":"C"},{"x":-1.004,"y":-0.587,"z":0.061,"el":"C"},{"x":-2.524,"y":0.518,"z":-1.562,"el":"C"},{"x":-2.891,"y
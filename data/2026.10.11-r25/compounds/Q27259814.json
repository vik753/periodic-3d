{"version":"2026.10.11-r25","id":"Q27259814","formula":"C₈H₆O₂","hill":"C8H6O2","elements":["H","C","O"],"composition":{"C":8.0,"H":6.0,"O":2.0},"names":{"en":"Isophthalide"},"descriptions":{"en":"2-Coumaranone (sometimes also called 2-Cumaranone) is a bicyclic heteroaromatic compound in which a six-membered benzene ring is annulated with a five-membered γ-butyrolactone ring. The 2(3H)-benzofuranone can also be considered as a lactone of (2-hydroxyphenyl)acetic acid. The benzofuranone basic structure is the basis of some natural products – such as rosmadial, which is isolatable from rosemary oil, and some substances with high pharmacological activity, such as griseofulvin and rifampicin."},"fame":5,"pubchemCid":68382,"mass":134.13,"charge":0,"smiles":"C1C2=CC=CC=C2OC1=O","inchikey":"ACZGCWSMSTYWDQ-UHFFFAOYSA-N","iupac":"3H-1-benzofuran-2-one","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"68382","atoms":16,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":1.215,"y":1.138,"z":0.0,"el":"O"},{"x":3.261,"y":0.07,"z":0.0,"el":"O"},{"x":-0.139,"y":-0.745,"z":0.0,"el":"C"},{"x":1.234,"y":-1.273,"z":0.0,"el":"C"},{"x":-0.075,"y":0.636,"z":0.0,"el":"C"},{"x":2.039,"y":0.014,"z":0.0,"el":"C"},{"x":-1.355,"y":-1.403,"z":0.0,"el":"C"},{"x":-1.212,"y":1.421,"z":0.0,"el":"C"},{"x":-2.519,"y":-0.631,"z":0.0,"el":"C"},{"x":-2.448,"y":0.773,"z":0.0,"el":"C"},{"x":1.447,"y":-1.842,"z":0.908,"el":"H"},{"x":1.447,"y":-1.842,"z":-0.908,"el":"H"},{"x":-1.409,"y":-2.486,"z":0.0,"el":"H"},{"x":-1.153,"y":2.503,"z":0.0,"el":"H"},{"x":-3.49,"y":-1.119,"z":0.0,"el":"H"},{"x":-3.365,"y":1.357,"z":0.0,"el":"H"}],"bonds":[[0,4,1],[0,5,1],[1,5,2],[2,3,1],[2,4,1],[2,6,2],[3,5,1],[3,10,1],[3,11,1],[4,7,2],[6,8,1],[6,12,1],[7,9,1],[7,13,1],[8,9,2],[8,14,1],[9,15,1]]},"sources":[{"role":"identity","name":"Wikidata","url"
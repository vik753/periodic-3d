{"version":"2026.10.11-r25","id":"Q27295178","formula":"C₂₅H₃₄O₆","hill":"C25H34O6","elements":["H","C","O"],"composition":{"C":25.0,"H":34.0,"O":6.0},"names":{"en":"YK-11"},"descriptions":{"en":"YK-11 is a synthetic steroidal selective androgen receptor modulator (SARM). It is a gene-selective partial agonist of the androgen receptor (AR) and does not induce the physical interaction between the NTD/AF1 and LBD/AF2 (known as the N/C interaction), which is required for full transactivation of the AR. The drug has anabolic activity in vitro in C2C12 myoblasts and shows greater potency than dihydrotestosterone (DHT) in this regard. It has been investigated as a potential treatment for sepsis-induced muscle wasting in animal studies."},"fame":1,"pubchemCid":119058028,"mass":430.5,"charge":0,"smiles":"C[C@]12CC[C@H]3[C@H]([C@@H]1CC[C@@]24/C(=C\\C(=O)OC)/OC(O4)(C)OC)CCC5=CC(=O)CC[C@H]35","inchikey":"KCQHQCDHFVGNMK-PQUNLUOYSA-N","iupac":"methyl (2E)-2-[(8R,9S,10R,13S,14S,17S)-2'-methoxy-2',13-dimethyl-3-oxospiro[1,2,6,7,8,9,10,11,12,14,15,16-dodecahydrocyclopenta[a]phenanthrene-17,5'-1,3-dioxolane]-4'-ylidene]acetate","classes":[{"qid":"Q59199015","names":{"en":"group of stereoisomers","ru":"группа стереоизомеров","uk":"група стереоізомерів"}}],"structureInfo":{"kind":"molecule","source":"rdkit","ref":"119058028","atoms":65,"license":"Computed with RDKit from SMILES (PubChem, Wikidata)"},"structure":{"kind":"molecule","atoms":[{"x":-0.21,"y":-1.916,"z":1.912,"el":"C"},{"x":-0.741,"y":-0.863,"z":0.887,"el":"C"},{"x":-0.412,"y":-1.367,"z":-0.53,"el":"C"},{"x":1.105,"y":-1.386,"z":-0.803,"el":"C"},{"x":1.778,"y":-0.026,"z":-0.514,"el":"C"},{"x":1.441,"y":0.491,"z":0.921,"el":"C"},{"x":-0.084,"y":0.523,"z":1.071,"el":"C"},{"x":-0.7,"y":1.031,"z":2.371,"el":"C"},{"x":-2.152,"y":0.508,"z":2.349,"el":"C"},{"x":-2.248,"y":-0.535,"z":1.202,"el":"C"},{"x":-3.171,"y":-0.167,"z":0.056,"el":"C"},{"x":-3.278,"y":0.905,"z":-0.743,"el":"C"},{"x":-2.495,"y":2.146,"z":-0.713,"el":"C"},{"x":
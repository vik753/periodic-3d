{"version":"2026.10.11-r25","id":"Q976343","formula":"Ag₂Se","hill":"Ag2Se","elements":["Se","Ag"],"composition":{"Ag":2.0,"Se":1.0},"names":{"en":"Silver(I) selenide"},"descriptions":{"en":"Silver selenide (Ag2Se) is the reaction product formed when selenium toning analog silver gelatine photo papers in photographic print toning. The selenium toner contains sodium selenite (Na2SeO3) as one of its active ingredients, which is the source of the selenide (Se2−) anion combining with the silver in the toning process. It is found in nature as the mineral naumannite, a comparatively rare silver mineral which has nevertheless become recognized as important silver compound in some low-sulfur silver ores from mines in Nevada and Idaho."},"fame":16,"pubchemCid":6335450,"mass":294.71,"charge":0,"smiles":"[Se].[Ag].[Ag]","inchikey":"GNWCVDGUVZRYLC-UHFFFAOYSA-N","iupac":null,"classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"crystal","source":"materialsproject","ref":"mp-568936","atoms":12,"license":"CC BY 4.0, Materials Project"},"structure":{"cell":[[4.449,0.0,0.0],[0.0,7.076,0.0],[0.0,0.0,7.663]],"kind":"crystal","atoms":[{"x":0.076,"y":1.631,"z":6.711,"el":"Ag"},{"x":3.07,"y":6.232,"z":7.234,"el":"Ag"},{"x":2.148,"y":5.446,"z":2.879,"el":"Ag"},{"x":0.845,"y":4.382,"z":0.429,"el":"Ag"},{"x":3.604,"y":0.844,"z":3.402,"el":"Ag"},{"x":4.373,"y":5.169,"z":4.784,"el":"Ag"},{"x":1.38,"y":2.694,"z":4.261,"el":"Ag"},{"x":2.301,"y":1.908,"z":0.952,"el":"Ag"},{"x":3.91,"y":3.493,"z":2.577,"el":"Se"},{"x":0.539,"y":7.031,"z":1.255,"el":"Se"},{"x":1.686,"y":0.045,"z":5.086,"el":"Se"},{"x":2.764,"y":3.583,"z":6.409,"el":"Se"}],"bonds":[[2,8,1],[4,10,1],[6,11,1],[0,10,1],[5,11,1],[7,8,1],[2,9,1],[4,8,1],[6,10,1],[1,11,1],[3,9,1],[5,8,1],[6,8,1]],"cellOrigin":[0,0,0]},"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q976343","license":"CC0 1.0"},{"r
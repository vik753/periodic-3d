{"version":"2026.10.11-r25","id":"Q2823325","formula":"C₆H₄O₈","hill":"C6H4O8","elements":["H","C","O"],"composition":{"C":6.0,"H":4.0,"O":8.0},"names":{"en":"Ethylenetetracarboxylic acid"},"descriptions":{"en":"Ethylenetetracarboxylic acid is an organic compound with formula C6H4O8, or (HO(OC)-)2C=C(-(CO)OH)2. By removal of four protons, the acid yields the anion C6O4−8, ethylenetetracarboxylate, which is one of the oxocarbon anions (consisting solely of oxygen and carbon). By loss of 1 through 3 protons, it forms the anions C6H3O−8, C6H2O2−8, and C6HO3−8, called respectively trihydrogen-, dihydrogen-, and hydrogenethylenetetracarboxylate."},"fame":9,"pubchemCid":12651152,"mass":204.09,"charge":0,"smiles":"C(=C(C(=O)O)C(=O)O)(C(=O)O)C(=O)O","inchikey":"AIJZIRPGCQPZSL-UHFFFAOYSA-N","iupac":"ethene-1,1,2,2-tetracarboxylic acid","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"12651152","atoms":18,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":2.049,"y":-1.047,"z":1.378,"el":"O"},{"x":2.145,"y":1.903,"z":-0.506,"el":"O"},{"x":-2.039,"y":1.061,"z":-1.38,"el":"O"},{"x":-2.139,"y":-1.906,"z":0.522,"el":"O"},{"x":2.36,"y":-1.21,"z":-0.876,"el":"O"},{"x":0.213,"y":2.546,"z":0.522,"el":"O"},{"x":-2.363,"y":1.208,"z":0.873,"el":"O"},{"x":-0.216,"y":-2.548,"z":-0.524,"el":"O"},{"x":0.637,"y":0.218,"z":0.034,"el":"C"},{"x":-0.64,"y":-0.22,"z":-0.037,"el":"C"},{"x":1.767,"y":-0.752,"z":0.087,"el":"C"},{"x":0.935,"y":1.678,"z":0.059,"el":"C"},{"x":-1.77,"y":0.75,"z":-0.09,"el":"C"},{"x":-0.938,"y":-1.68,"z":-0.061,"el":"C"},{"x":2.793,"y":-1.683,"z":1.455,"el":"H"},{"x":2.38,"y":2.855,"z":-0.504,"el":"H"},{"x":-2.777,"y":1.703,"z":-1.457,"el":"H"},{"x":-2.37,"y":-2.86,"z":0.529,"el":"H"}],"bonds":[[0,10,1],[0,14,1],[1,11,1],[1,15,1],[2,12,1],[2,16,1],[3,13,1],[3,17,1],[4,10,2],[5,11,2],[6,12,2],[7,
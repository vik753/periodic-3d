{"version":"2026.10.11-r25","id":"Q15633977","formula":"C₂₂H₃₁NO₃","hill":"C22H31NO3","elements":["H","C","N","O"],"composition":{"C":22.0,"H":31.0,"N":1.0,"O":3.0},"names":{"en":"Epostane"},"descriptions":{"en":"Epostane (INN, USAN, BAN) (developmental code name WIN-32729) is an inhibitor of 3β-hydroxysteroid dehydrogenase (3β-HSD) that was developed as a contraceptive, abortifacient, and oxytocic drug but was never marketed. By inhibiting 3β-HSD, epostane blocks the biosynthesis of progesterone from pregnenolone (and also the conversion of dehydroepiandrosterone to androstenedione), thereby functioning as an antiprogestogen and terminating pregnancy. The drug was trialed and in a study was found to be slightly more effective at inducing abortion relative to mifepristone."},"fame":3,"pubchemCid":6917713,"mass":357.5,"charge":0,"smiles":"C[C@]12CC[C@H]3[C@H]([C@@H]1CC[C@]2(C)O)CC[C@]45[C@@]3(CC(=C([C@]4(O5)C)O)C#N)C","inchikey":"CETKWEWBSMKADK-GSXVSZIWSA-N","iupac":"(1S,2R,6R,8S,11S,12S,15S,16S)-5,15-dihydroxy-2,6,15,16-tetramethyl-7-oxapentacyclo[9.7.0.02,8.06,8.012,16]octadec-4-ene-4-carbonitrile","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"6917713","atoms":57,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":2.113,"y":-1.405,"z":1.302,"el":"O"},{"x":-5.676,"y":1.299,"z":-0.182,"el":"O"},{"x":5.396,"y":-0.476,"z":0.017,"el":"O"},{"x":5.113,"y":3.125,"z":0.047,"el":"N"},{"x":1.681,"y":-1.18,"z":-0.051,"el":"C"},{"x":1.176,"y":0.236,"z":-0.35,"el":"C"},{"x":-0.31,"y":0.327,"z":0.154,"el":"C"},{"x":-1.194,"y":-0.832,"z":-0.418,"el":"C"},{"x":3.144,"y":-1.371,"z":0.298,"el":"C"},{"x":-2.613,"y":-0.695,"z":0.152,"el":"C"},{"x":-3.279,"y":0.654,"z":-0.199,"el":"C"},{"x":0.858,"y":-2.321,"z":-0.575,"el":"C"},{"x":-0.584,"y":-2.205,"z":-0.084,"el":"C"},{"x":-0.963,"y":1.717,"z":-0.048,"el"
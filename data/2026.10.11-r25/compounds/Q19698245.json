{"version":"2026.10.11-r25","id":"Q19698245","formula":"FeTiNb₂O₈","hill":"FeNb2O8Ti","elements":["O","Ti","Fe","Nb"],"composition":{"O":8.0,"Fe":1.0,"Nb":2.0,"Ti":1.0},"names":{"en":"Achalaite"},"descriptions":{"en":"Achalaite ((Fe2+, Mn)(Ti, Fe3+, Ta)(Nb, Ta)2O8) is a black mineral of the wodginite group, first discovered in 2013. It crystallizes in the monoclinic system and has a dark, metallic luster, a specific gravity of 6.285 and a Mohs hardness of 5.5. Achalaite occurs in the intermediate zone of topaz- and tantalite-bearing pegmatite."},"fame":5,"pubchemCid":null,"mass":null,"charge":0,"smiles":null,"inchikey":null,"iupac":null,"classes":[{"qid":"Q12089225","names":{"en":"mineral species","ru":"действительный вид минералов","uk":"мінеральний вид"}}],"structureInfo":null,"structure":null,"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q19698245","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Achalaite","license":"CC BY-SA 4.0"}],"similar":[{"id":"Q417648","formula":"YFeNb₂O₈","names":{"en":"Samarskite-(Y)","ru":"Самарскит","uk":"Самарськіт"},"elements":["O","Fe","Y","Nb"],"fame":24,"kind":null},{"id":"Q3991838","formula":"MnTiTa₂O₈","names":{"en":"Titanowodginite"},"elements":["O","Ti","Mn","Ta"],"fame":7,"kind":null},{"id":"Q4020618","formula":"MnSnTa₂O₈","names":{"en":"Wodginite","uk":"Воджиніт"},"elements":["O","Mn","Sn","Ta"],"fame":9,"kind":null},{"id":"Q3980910","formula":"MnTa₂O₆","names":{"en":"Tantalite-(Mn)","ru":"Манганотанталит"},"elements":["O","Mn","Ta"],"fame":7,"kind":"crystal"},{"id":"Q413128","formula":"K₃Al₃Cu₂₀Si₂₉H₃₂O₁₀₀","names":{"en":"Ajoite","ru":"Ахоит"},"elements":["H","O","Al","Si","K","Cu"],"fame":13,"kind":null},{"id":"Q1070784","formula":"Cu₈(Si₈O₂₂)(OH)₄·H₂O","names":{"en":"Plancheite","uk":"Планшеїт"},"elements":["H","O","Si","Cu"],"fame":11,"kind":null},{"id":"Q3808473","formula":"BaNa(Fe)₄Ti₂(Si₂O₇)₂O₂(OH)₂F","names":{"en":"Jinshaji
{"version":"2026.10.11-r25","id":"Q82248650","formula":"C₁₃H₁₆BrNO₂","hill":"C13H16BrNO2","elements":["H","C","N","O","Br"],"composition":{"C":13.0,"H":16.0,"N":1.0,"O":2.0,"Br":1.0},"names":{"en":"DOB-FLY"},"descriptions":{"en":"DOB-FLY, also known as 3C-B-FLY or as B-FLY, is a psychedelic drug and designer drug of the phenethylamine, amphetamine, DOx, and FLY families. It is the FLY derivative of DOB, the amphetamine (α-methyl) derivative of 2C-B-FLY, and the partially saturated analogue of Bromo-DragonFLY (DOB-DFLY). Unlike Bromo-DragonFLY, DOB-FLY is only slightly more potent than DOB itself, with an active dose in humans of around 1 mg orally (compared to 1–3 mg orally for DOB)."},"fame":2,"pubchemCid":10017554,"mass":298.18,"charge":0,"smiles":"CC(CC1=C2CCOC2=C(C3=C1OCC3)Br)N","inchikey":"FKRREVSELFOLDT-UHFFFAOYSA-N","iupac":"1-(4-bromo-2,3,6,7-tetrahydrofuro[2,3-f][1]benzofuran-8-yl)propan-2-amine","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"10017554","atoms":33,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-3.919,"y":-0.661,"z":0.487,"el":"Br"},{"x":0.914,"y":-2.215,"z":-0.492,"el":"O"},{"x":-2.363,"y":2.097,"z":0.166,"el":"O"},{"x":4.376,"y":0.915,"z":0.002,"el":"N"},{"x":0.651,"y":0.209,"z":-0.458,"el":"C"},{"x":-0.263,"y":1.229,"z":-0.262,"el":"C"},{"x":0.16,"y":-1.079,"z":-0.327,"el":"C"},{"x":-1.18,"y":-1.346,"z":-0.04,"el":"C"},{"x":2.073,"y":0.478,"z":-0.794,"el":"C"},{"x":-0.076,"y":2.692,"z":-0.387,"el":"C"},{"x":-1.602,"y":0.962,"z":0.029,"el":"C"},{"x":-1.395,"y":-2.811,"z":-0.049,"el":"C"},{"x":-2.099,"y":-0.326,"z":0.136,"el":"C"},{"x":3.007,"y":0.618,"z":0.434,"el":"C"},{"x":-1.383,"y":3.159,"z":0.255,"el":"C"},{"x":0.062,"y":-3.269,"z":0.013,"el":"C"},{"x":3.037,"y":-0.652,"z":1.285,"el":"C"},{"x":2.448,"y":-0.317,"z":-1.455,"el":"H"},{"x":2.137,"y":1.391,"
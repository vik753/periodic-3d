{"version":"2026.10.11-r25","id":"Q418214","formula":"C₄H₉NO₃","hill":"C4H9NO3","elements":["H","C","N","O"],"composition":{"C":4.0,"H":9.0,"N":1.0,"O":3.0},"names":{"en":"L-homoserine"},"descriptions":{"en":"Homoserine (also called isothreonine) is an α-amino acid with the chemical formula HO2CCH(NH2)CH2CH2OH. L-Homoserine is not one of the common amino acids encoded by DNA. It differs from the proteinogenic amino acid serine by insertion of an additional −CH2− unit into the sidechain. Homoserine, or its lactone, is the product of a cyanogen bromide cleavage of a peptide by degradation of methionine. Homoserine is an intermediate in the biosynthesis of three essential amino acids: methionine, threonine (an isomer of homoserine), and isoleucine."},"fame":23,"pubchemCid":12647,"mass":119.12,"charge":0,"smiles":"C(CO)[C@@H](C(=O)O)N","inchikey":"UKAUYVFTDYCKQA-VKHMYHEASA-N","iupac":"(2S)-2-amino-4-hydroxybutanoic acid","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"12647","atoms":17,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":3.305,"y":0.522,"z":-0.377,"el":"O"},{"x":-1.718,"y":1.562,"z":0.338,"el":"O"},{"x":-2.469,"y":-0.331,"z":-0.659,"el":"O"},{"x":-0.346,"y":-1.783,"z":0.15,"el":"N"},{"x":-0.311,"y":-0.36,"z":0.487,"el":"C"},{"x":0.891,"y":0.358,"z":-0.145,"el":"C"},{"x":2.255,"y":-0.221,"z":0.224,"el":"C"},{"x":-1.606,"y":0.254,"z":-0.018,"el":"C"},{"x":-0.286,"y":-0.263,"z":1.577,"el":"H"},{"x":0.88,"y":1.42,"z":0.137,"el":"H"},{"x":0.795,"y":0.363,"z":-1.24,"el":"H"},{"x":2.394,"y":-0.197,"z":1.309,"el":"H"},{"x":2.342,"y":-1.258,"z":-0.115,"el":"H"},{"x":-0.397,"y":-1.903,"z":-0.861,"el":"H"},{"x":-1.185,"y":-2.213,"z":0.539,"el":"H"},{"x":4.141,"y":0.109,"z":-0.101,"el":"H"},{"x":-2.557,"y":1.957,"z":0.016,"el":"H"}],"bonds":[[0,6,1],[0,15,1],[1,7,1],[1,16,1],[2,7,2],[3,4,1
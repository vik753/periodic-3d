{"version":"2026.10.11-r25","id":"Q98139893","formula":"C₂₀H₂₂BrN₃O","hill":"C20H22BrN3O","elements":["H","C","N","O","Br"],"composition":{"C":20.0,"H":22.0,"N":3.0,"O":1.0,"Br":1.0},"names":{"en":"Brorphine"},"descriptions":{"en":"Brorphine is a piperidine-based opioid analgesic compound. Brorphine was originally described in a 2018 paper investigating functionally biased opioid compounds, with the intention of finding safer analgesics that produce less respiratory depression than typical opioids. Brorphine was originally reported to be highly biased, with an EC50 of 4.8nM for GTPγS binding and 182nM for β-arrestin recruitment, however a more recent study found no significant bias for any of the compounds tested, including brorphine."},"fame":3,"pubchemCid":145975294,"mass":400.3,"charge":0,"smiles":"CC(C1=CC=C(C=C1)Br)N2CCC(CC2)N3C4=CC=CC=C4NC3=O","inchikey":"CNOFBGYRMCBVLO-UHFFFAOYSA-N","iupac":"3-[1-[1-(4-bromophenyl)ethyl]piperidin-4-yl]-1H-benzimidazol-2-one","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"rdkit","ref":"145975294","atoms":47,"license":"Computed with RDKit from SMILES (PubChem, Wikidata)"},"structure":{"kind":"molecule","atoms":[{"x":-3.313,"y":-2.046,"z":-0.985,"el":"C"},{"x":-2.627,"y":-0.729,"z":-0.575,"el":"C"},{"x":-3.707,"y":0.17,"z":0.036,"el":"C"},{"x":-4.172,"y":1.293,"z":-0.667,"el":"C"},{"x":-5.163,"y":2.112,"z":-0.121,"el":"C"},{"x":-5.697,"y":1.813,"z":1.131,"el":"C"},{"x":-5.252,"y":0.703,"z":1.843,"el":"C"},{"x":-4.262,"y":-0.117,"z":1.296,"el":"C"},{"x":-7.037,"y":2.925,"z":1.868,"el":"Br"},{"x":-1.471,"y":-0.906,"z":0.34,"el":"N"},{"x":-0.872,"y":0.389,"z":0.723,"el":"C"},{"x":0.627,"y":0.318,"z":1.01,"el":"C"},{"x":1.376,"y":-0.143,"z":-0.247,"el":"C"},{"x":0.633,"y":-1.283,"z":-0.967,"el":"C"},{"x":-0.465,"y":-1.886,"z":-0.093,"el":"C"},{"x":2.762,"y":-0.466,"z":0.057,"el":"N"},{"x":3.855,"y":0.40
{"version":"2026.10.11-r25","id":"Q1224566","formula":"C₂₃H₂₅F₂NO₃","hill":"C23H25F2NO3","elements":["H","C","N","O","F"],"composition":{"C":23.0,"F":2.0,"H":25.0,"N":1.0,"O":3.0},"names":{"en":"Difluoropine"},"descriptions":{"en":"Difluoropine (O-620) is a stimulant drug synthesised from tropinone, which acts as a potent and selective dopamine reuptake inhibitor. Difluoropine is unique among the tropane-derived dopamine reuptake inhibitors in that the active stereoisomer is the (S) enantiomer rather than the (R) enantiomer, the opposite way round compared to natural cocaine. It is structurally related to benztropine and has similar anticholinergic and antihistamine effects in addition to its dopamine reuptake inhibitory action."},"fame":5,"pubchemCid":190851,"mass":401.4,"charge":0,"smiles":"CN1[C@@H]2CC[C@H]1[C@@H]([C@H](C2)OC(C3=CC=C(C=C3)F)C4=CC=C(C=C4)F)C(=O)OC","inchikey":"XSYGBVSQKPLETJ-ANULTFPQSA-N","iupac":"methyl (1S,2S,3S,5R)-3-[bis(4-fluorophenyl)methoxy]-8-methyl-8-azabicyclo[3.2.1]octane-2-carboxylate","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"190851","atoms":54,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":3.644,"y":-4.918,"z":0.153,"el":"F"},{"x":4.375,"y":4.406,"z":-0.397,"el":"F"},{"x":-0.111,"y":0.01,"z":-0.679,"el":"O"},{"x":-3.576,"y":-0.201,"z":2.478,"el":"O"},{"x":-2.583,"y":1.801,"z":1.881,"el":"O"},{"x":-3.963,"y":0.234,"z":-1.008,"el":"N"},{"x":-3.253,"y":-0.827,"z":-0.269,"el":"C"},{"x":-3.009,"y":0.575,"z":-2.076,"el":"C"},{"x":-2.152,"y":-0.152,"z":0.586,"el":"C"},{"x":-2.646,"y":-1.71,"z":-1.366,"el":"C"},{"x":-2.468,"y":-0.772,"z":-2.56,"el":"C"},{"x":-1.921,"y":1.449,"z":-1.42,"el":"C"},{"x":-1.225,"y":0.779,"z":-0.22,"el":"C"},{"x":-5.259,"y":-0.202,"z":-1.523,"el":"C"},{"x":-2.788,"y":0.607,"z":1.716,"el":"C"},{"x":0.94,"y":0.008,"z":0.274,"el"
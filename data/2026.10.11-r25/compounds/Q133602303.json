{"version":"2026.10.11-r25","id":"Q133602303","formula":"C₆₁H₁₀₁N₁₉O₂₈","hill":"C61H101N19O28","elements":["H","C","N","O"],"composition":{"C":61.0,"H":101.0,"N":19.0,"O":28.0},"names":{"en":"PEPITEM"},"descriptions":{"en":"PEPITEM (Peptide Inhibitor of Trans-Endothelial Migration) is an endogenous polypeptide composed of the 14 amino acids 28–41 of the 14.3.3.ζδ protein, which in turn is a 245 amino-acid product of the YWHAZ gene. It has the sequence SVTEQGAELSNEER. PEPITEM has antiinflammatory effects by inhibiting trafficking of T cells into inflamed tissues. Levels of PEPITEM in the body decline with age, diabetes or rheumatoid arthritis, and decreased PEPITEM levels correlates with increases in chronic inflammation and numerous resulting health issues."},"fame":1,"pubchemCid":505189302,"mass":null,"charge":0,"smiles":null,"inchikey":null,"iupac":null,"classes":[{"qid":"Q172847","names":{"en":"peptide","ru":"пептид","uk":"пептид"}}],"structureInfo":null,"structure":null,"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q133602303","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/PEPITEM","license":"CC BY-SA 4.0"},{"role":"properties","name":"PubChem","url":"https://pubchem.ncbi.nlm.nih.gov/compound/505189302","license":"PubChem (NIH), public data"}],"similar":[{"id":"Q186242","formula":"C₈H₁₁NO₃","names":{"en":"Norepinephrine","ru":"Норадреналин","uk":"Норадреналін"},"elements":["H","C","N","O"],"fame":65,"kind":"molecule"},{"id":"Q423746","formula":"C₈H₁₁NO₃","names":{"en":"Pyridoxine","ru":"Пиридоксин","uk":"Піридоксин"},"elements":["H","C","N","O"],"fame":49,"kind":"molecule"},{"id":"Q412621","formula":"C₁₀H₁₃NO₄","names":{"en":"Methyldopa","ru":"Метилдопа","uk":"Метилдопа"},"elements":["H","C","N","O"],"fame":30,"kind":"molecule"},{"id":"Q421178","formula":"C₁₀H₁₄N₂O₄","names":{"en":"Porphobilinogen","ru":"Порфобилиноген"},"elements":["H","C","N","O"],"fame":22,"kind":"
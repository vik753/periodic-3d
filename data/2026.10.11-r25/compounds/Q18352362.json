{"version":"2026.10.11-r25","id":"Q18352362","formula":"C₂₁H₃₄O₂","hill":"C21H34O2","elements":["H","C","O"],"composition":{"C":21.0,"H":34.0,"O":2.0},"names":{"en":"Sepranolone"},"descriptions":{"en":"Isopregnanolone, also known as isoallopregnanolone and epiallopregnanolone, as well as sepranolone (INNTooltip International Nonproprietary Name), and as 3β-hydroxy-5α-pregnan-20-one or 3β,5α-tetrahydroprogesterone (3β,5α-THP), is an endogenous neurosteroid and a natural 3β-epimer of allopregnanolone. It has been reported to act as a subunit-selective negative allosteric modulator of the GABAA receptor, and antagonizes in animals and humans some but not all of the GABAA receptor-mediated effects of allopregnanolone, such as anesthesia, sedation, and reduced saccadic eye movements, but not learning impairment."},"fame":4,"pubchemCid":92787,"mass":318.5,"charge":0,"smiles":"CC(=O)[C@H]1CC[C@@H]2[C@@]1(CC[C@H]3[C@H]2CC[C@@H]4[C@@]3(CC[C@@H](C4)O)C)C","inchikey":"AURFZBICLPNKBZ-FZCSVUEKSA-N","iupac":"1-[(3S,5S,8R,9S,10S,13S,14S,17S)-3-hydroxy-10,13-dimethyl-2,3,4,5,6,7,8,9,11,12,14,15,16,17-tetradecahydro-1H-cyclopenta[a]phenanthren-17-yl]ethanone","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"92787","atoms":57,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-6.408,"y":-0.346,"z":0.131,"el":"O"},{"x":5.525,"y":-0.236,"z":-0.839,"el":"O"},{"x":-0.645,"y":-0.359,"z":0.279,"el":"C"},{"x":0.074,"y":0.952,"z":-0.178,"el":"C"},{"x":1.494,"y":0.955,"z":0.398,"el":"C"},{"x":2.337,"y":-0.252,"z":-0.069,"el":"C"},{"x":-2.134,"y":-0.42,"z":-0.227,"el":"C"},{"x":-2.854,"y":0.869,"z":0.288,"el":"C"},{"x":0.194,"y":-1.624,"z":-0.043,"el":"C"},{"x":1.653,"y":-1.528,"z":0.441,"el":"C"},{"x":-0.711,"y":2.198,"z":0.255,"el":"C"},{"x":3.672,"y":0.093,"z":0.627,"el":"C"},{"x":2.402,"y":2.149,"z":0.121,"el":"C
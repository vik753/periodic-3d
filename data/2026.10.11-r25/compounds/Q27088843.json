{"version":"2026.10.11-r25","id":"Q27088843","formula":"C₃₀H₃₇Cl₂N₇O₆","hill":"C30H37Cl2N7O6","elements":["H","C","N","O","Cl"],"composition":{"C":30.0,"H":37.0,"N":7.0,"O":6.0,"Cl":2.0},"names":{"en":"SP-4206"},"descriptions":{"en":"SP4206 is an experimental drug which is described as a small molecule protein-protein interaction inhibitor. It binds with high affinity to interleukin-2 at the precise residues which usually mediate binding between interleukin-2 and the IL-2 receptor, thereby preventing binding and blocking the action of interleukin-2 in the body. Interleukin-2 is a cytokine signalling molecule with an important role in the function of the immune system, and most medical interest has been in enhancing interleukin-2 activity for the treatment of cancer."},"fame":1,"pubchemCid":5288251,"mass":662.6,"charge":0,"smiles":"CC(C)C[C@H](C(=O)NCC(=O)N1CCC(CC1)C2=CC(=NN2C)C3=C(C(=C(C=C3)OCC4=CC=C(O4)C(=O)O)Cl)Cl)N=C(N)N","inchikey":"VNZHOIDQBPFEJU-OAQYLSRUSA-N","iupac":"5-[[2,3-dichloro-4-[5-[1-[2-[[(2R)-2-(diaminomethylideneamino)-4-methylpentanoyl]amino]acetyl]piperidin-4-yl]-1-methylpyrazol-3-yl]phenoxy]methyl]furan-2-carboxylic acid","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"5288251","atoms":82,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-3.815,"y":2.026,"z":-1.873,"el":"Cl"},{"x":-6.414,"y":0.202,"z":-2.12,"el":"Cl"},{"x":5.58,"y":0.412,"z":-1.217,"el":"O"},{"x":8.659,"y":0.944,"z":0.377,"el":"O"},{"x":-6.734,"y":-1.692,"z":0.13,"el":"O"},{"x":-9.738,"y":-0.883,"z":0.116,"el":"O"},{"x":-12.988,"y":-1.127,"z":-1.371,"el":"O"},{"x":-11.732,"y":0.732,"z":-1.07,"el":"O"},{"x":4.162,"y":1.737,"z":0.062,"el":"N"},{"x":-0.935,"y":3.079,"z":1.224,"el":"N"},{"x":-2.207,"y":2.649,"z":1.274,"el":"N"},{"x":6.928,"y":-0.573,"z":0.692,"el":"N"},{"x":9.651,"y":-1.963,"z":1.163,"el"
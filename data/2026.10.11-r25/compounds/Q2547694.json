{"version":"2026.10.11-r25","id":"Q2547694","formula":"MgSO₄·11H₂O","hill":"H22MgO15S","elements":["H","O","Mg","S"],"composition":{"H":22.0,"O":15.0,"S":1.0,"Mg":1.0},"names":{"en":"Meridianiite"},"descriptions":{"en":"Meridianiite is the mineral consisting of magnesium sulfate undecahydrate, MgSO4·11H2O. It is colorless transparent crystalline salt that precipitates from solutions saturated in Mg2+ and SO2−4 ions at temperatures less than 2 °C. The synthetic compound was formerly known as Fritzsche's salt. Meridianiite is a naturally occurring mineral species found on Earth in a variety of environments including sea ice, crusts and efflorescences in coal/metal mines, cave systems, oxidized zones of sulfide deposits, salt lakes/playas and Antarctic ice-cores. It is commonly associated with other evaporite minerals such as epsomite, mirabilite, halides, and other sodium-magnesium-sulfates."},"fame":6,"pubchemCid":null,"mass":null,"charge":0,"smiles":null,"inchikey":null,"iupac":null,"classes":[{"qid":"Q12089225","names":{"en":"mineral species","ru":"действительный вид минералов","uk":"мінеральний вид"}}],"structureInfo":{"kind":"crystal","source":"materialsproject","ref":"mp-1198750","atoms":88,"license":"CC BY 4.0, Materials Project"},"structure":{"cell":[[6.782,0.0,0.0],[3.152,6.114,0.0],[0.195,0.659,17.449]],"kind":"crystal","atoms":[{"x":0.0,"y":0.0,"z":0.0,"el":"Mg"},{"x":0.195,"y":0.659,"z":17.449,"el":"Mg"},{"x":3.152,"y":6.114,"z":0.0,"el":"Mg"},{"x":3.346,"y":6.773,"z":17.449,"el":"Mg"},{"x":6.782,"y":0.0,"z":0.0,"el":"Mg"},{"x":6.977,"y":0.659,"z":17.449,"el":"Mg"},{"x":9.934,"y":6.114,"z":0.0,"el":"Mg"},{"x":10.129,"y":6.773,"z":17.449,"el":"Mg"},{"x":0.097,"y":0.33,"z":8.725,"el":"Mg"},{"x":3.249,"y":6.443,"z":8.725,"el":"Mg"},{"x":6.88,"y":0.33,"z":8.725,"el":"Mg"},{"x":10.031,"y":6.443,"z":8.725,"el":"Mg"},{"x":5.617,"y":5.314,"z":16.56,"el":"H"},{"x":4.511,"y":1.458,"z":0.889,"el":"H"},{"x":5.517,"y":4.978,"z":0.663,"el":"H"},{"x":4.612,"y":1.795,"z":
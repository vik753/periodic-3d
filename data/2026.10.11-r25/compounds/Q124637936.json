{"version":"2026.10.11-r25","id":"Q124637936","formula":"C₁₄H₁₈FNO","hill":"C14H18FNO","elements":["H","C","N","O","F"],"composition":{"C":14.0,"F":1.0,"H":18.0,"N":1.0,"O":1.0},"names":{"en":"2F-NENDCK"},"descriptions":{"en":"2F-NENDCK (also known as CanKet, 2-fluoro-N-ethylnordeschloroketamine, 2'-fluoro-2-oxo-phenylcyclohexylethylamine, 2'-Fluoro-2-Oxo-PCE, and 2-FXE) is a recreational designer drug from the arylcyclohexylamine family, with dissociative effects presumably similar to those of ketamine. Its general effects, dissociative or otherwise, may deviate from other arylcyclohexylamines. It was initially identified in Canberra, Australia in mid-August 2022 by the government-funded drug-testing service CanTEST. It has since been dubbed \"CanKet\" due to it originally being found in Canberra and being a structural analogue of ketamine."},"fame":2,"pubchemCid":168323042,"mass":235.3,"charge":0,"smiles":"CCNC1(CCCCC1=O)C2=CC=CC=C2F","inchikey":"RTXKYSLDFKUESF-UHFFFAOYSA-N","iupac":"2-(ethylamino)-2-(2-fluorophenyl)cyclohexan-1-one","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"rdkit","ref":"168323042","atoms":35,"license":"Computed with RDKit from SMILES (PubChem, Wikidata)"},"structure":{"kind":"molecule","atoms":[{"x":-2.757,"y":2.625,"z":0.12,"el":"C"},{"x":-2.151,"y":1.243,"z":0.335,"el":"C"},{"x":-0.734,"y":1.283,"z":0.007,"el":"N"},{"x":0.016,"y":-0.01,"z":-0.005,"el":"C"},{"x":-0.135,"y":-0.852,"z":1.291,"el":"C"},{"x":-1.4,"y":-1.707,"z":1.427,"el":"C"},{"x":-1.917,"y":-2.308,"z":0.121,"el":"C"},{"x":-0.902,"y":-2.25,"z":-1.004,"el":"C"},{"x":-0.498,"y":-0.811,"z":-1.239,"el":"C"},{"x":-0.583,"y":-0.304,"z":-2.363,"el":"O"},{"x":1.523,"y":0.319,"z":-0.145,"el":"C"},{"x":2.063,"y":1.499,"z":0.409,"el":"C"},{"x":3.427,"y":1.794,"z":0.31,"el":"C"},{"x":4.289,"y":0.908,"z":-0.33,"el":"C"},{"x":3.786,"y":-0.276,"z":-0.859,"el":"
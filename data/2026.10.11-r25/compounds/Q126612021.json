{"version":"2026.10.11-r25","id":"Q126612021","formula":"C₉H₁₂ClN","hill":"C9H12ClN","elements":["H","C","N","Cl"],"composition":{"C":9.0,"H":12.0,"N":1.0,"Cl":1.0},"names":{"en":"1-(3-chlorophenyl)propan-2-amine"},"descriptions":{"en":"3-Chloroamphetamine (3-CA; code name PAL-304), also known as meta-chloroamphetamine (MCA), is a psychostimulant of the amphetamine family and a serotonergic neurotoxin related to para-chloroamphetamine (PCA; 4-chloroamphetamine). The drug is a potent serotonin–norepinephrine–dopamine releasing agent (SNDRA). Its EC50Tooltip half-maximal effective concentration values for induction of monoamine release are 9.4 nM for norepinephrine, 11.8 nM for dopamine, and 120 nM for serotonin."},"fame":2,"pubchemCid":20027470,"mass":169.65,"charge":0,"smiles":"CC(CC1=CC(=CC=C1)Cl)N","inchikey":"ORWQJKNRYUIFJU-UHFFFAOYSA-N","iupac":"1-(3-chlorophenyl)propan-2-amine","classes":[{"qid":"Q59199015","names":{"en":"group of stereoisomers","ru":"группа стереоизомеров","uk":"група стереоізомерів"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"20027470","atoms":23,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":3.022,"y":2.012,"z":0.154,"el":"Cl"},{"x":-3.914,"y":0.034,"z":0.18,"el":"N"},{"x":-2.536,"y":0.017,"z":-0.32,"el":"C"},{"x":-1.578,"y":-0.354,"z":0.827,"el":"C"},{"x":-0.131,"y":-0.437,"z":0.404,"el":"C"},{"x":-2.226,"y":1.388,"z":-0.922,"el":"C"},{"x":0.682,"y":0.694,"z":0.467,"el":"C"},{"x":0.393,"y":-1.648,"z":-0.05,"el":"C"},{"x":2.018,"y":0.616,"z":0.076,"el":"C"},{"x":1.729,"y":-1.727,"z":-0.44,"el":"C"},{"x":2.542,"y":-0.595,"z":-0.377,"el":"C"},{"x":-2.466,"y":-0.736,"z":-1.114,"el":"H"},{"x":-1.874,"y":-1.319,"z":1.261,"el":"H"},{"x":-1.669,"y":0.371,"z":1.648,"el":"H"},{"x":-2.202,"y":2.17,"z":-0.155,"el":"H"},{"x":-2.984,"y":1.67,"z":-1.662,"el":"H"},{"x":-1.266,"y":1.387,"z":-1.447,"el":"H"},{"x":0.274,"y":1.637,"z":0.826,"el":"H"},{"x":-0.231,"y":-2.536,"z":-0.105,"el":"H"},{"x":-4.1
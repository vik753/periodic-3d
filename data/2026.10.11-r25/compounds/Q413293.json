{"version":"2026.10.11-r25","id":"Q413293","formula":"MnO₂","hill":"MnO2","elements":["O","Mn"],"composition":{"O":2.0,"Mn":1.0},"names":{"en":"Pyrolusite","ru":"Пиролюзит","uk":"Піролюзит"},"descriptions":{"en":"Pyrolusite is a mineral consisting essentially of manganese dioxide (MnO2) and is important as an ore of manganese. It is a black, amorphous appearing mineral, often with a granular, fibrous, or columnar structure, sometimes forming reniform crusts. It has a metallic luster, a black or bluish-black streak, and readily soils the fingers.","ru":"Пиролюзи́т — минерал, диоксид марганца (MnO2). Непрозрачный, цвет чёрный или серо-стальной. Кристаллы мелкие, имеют игольчатый или столбчатый облик.","uk":"Піролюзит (англ. pyrolusite; нім. Pyrolusit m) — мінерал класу оксидів і гідроксидів, діоксид манґану ланцюжкової будови."},"fame":45,"pubchemCid":null,"mass":null,"charge":0,"smiles":null,"inchikey":null,"iupac":null,"classes":[{"qid":"Q12089225","names":{"en":"mineral species","ru":"действительный вид минералов","uk":"мінеральний вид"}}],"structureInfo":{"kind":"crystal","source":"materialsproject","ref":"mp-19326","atoms":12,"license":"CC BY 4.0, Materials Project"},"structure":{"cell":[[9.181,0.0,0.0],[0.0,2.858,0.0],[0.0,0.0,4.562]],"kind":"crystal","atoms":[{"x":5.825,"y":2.144,"z":4.398,"el":"Mn"},{"x":3.356,"y":0.715,"z":0.164,"el":"Mn"},{"x":7.946,"y":0.715,"z":2.117,"el":"Mn"},{"x":1.234,"y":2.144,"z":2.445,"el":"Mn"},{"x":7.114,"y":2.144,"z":3.011,"el":"O"},{"x":2.067,"y":0.715,"z":1.551,"el":"O"},{"x":6.657,"y":0.715,"z":0.73,"el":"O"},{"x":2.524,"y":2.144,"z":3.832,"el":"O"},{"x":8.898,"y":2.144,"z":1.298,"el":"O"},{"x":0.282,"y":0.715,"z":3.264,"el":"O"},{"x":4.308,"y":2.144,"z":0.983,"el":"O"},{"x":4.873,"y":0.715,"z":3.578,"el":"O"}],"bonds":[[3,5,1],[2,4,1],[0,4,1],[2,6,1],[3,7,1],[1,5,1],[2,8,1],[0,11,1],[1,10,1],[3,9,1]],"cellOrigin":[0,0,0]},"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q413293","license":"
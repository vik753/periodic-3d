{"version":"2026.10.11-r25","id":"Q4596802","formula":"C₅H₆N₆","hill":"C5H6N6","elements":["H","C","N"],"composition":{"C":5.0,"H":6.0,"N":6.0},"names":{"en":"2,6-diaminopurine"},"descriptions":{"en":"2,6-diaminopurine (2,6-DAP, also known as 2-aminoadenine, standard IUPAC symbol n2A) is a compound once used in the treatment of leukemia. It is found instead of adenine (A) in the genetic material of some bacteriophage viruses, In August 2011, a report, based on NASA studies with meteorites found on Earth, was published suggesting 2,6-diaminopurine and related organic molecules, including the DNA and RNA components adenine and guanine, may have been formed extraterrestrially in outer space."},"fame":14,"pubchemCid":30976,"mass":150.14,"charge":0,"smiles":"C1=NC2=NC(=NC(=C2N1)N)N","inchikey":"MSSXOMSJDRHRMC-UHFFFAOYSA-N","iupac":"7H-purine-2,6-diamine","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"30976","atoms":17,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-2.051,"y":-0.686,"z":0.0,"el":"N"},{"x":-1.738,"y":1.521,"z":0.0,"el":"N"},{"x":0.692,"y":1.462,"z":0.0,"el":"N"},{"x":1.625,"y":-0.792,"z":0.0,"el":"N"},{"x":0.235,"y":-2.745,"z":0.0,"el":"N"},{"x":3.004,"y":1.102,"z":0.0,"el":"N"},{"x":-0.698,"y":-0.503,"z":0.0,"el":"C"},{"x":-0.528,"y":0.875,"z":0.0,"el":"C"},{"x":0.394,"y":-1.35,"z":0.0,"el":"C"},{"x":-2.632,"y":0.555,"z":0.0,"el":"C"},{"x":1.697,"y":0.561,"z":0.0,"el":"C"},{"x":-2.539,"y":-1.572,"z":0.0,"el":"H"},{"x":-3.705,"y":0.683,"z":0.0,"el":"H"},{"x":1.058,"y":-3.334,"z":0.0,"el":"H"},{"x":-0.687,"y":-3.16,"z":0.0,"el":"H"},{"x":3.126,"y":2.105,"z":0.0,"el":"H"},{"x":3.799,"y":0.478,"z":0.0,"el":"H"}],"bonds":[[0,6,1],[0,9,1],[0,11,1],[1,7,1],[1,9,2],[2,7,2],[2,10,1],[3,8,1],[3,10,2],[4,8,1],[4,13,1],[4,14,1],[5,10,1],[5,15,1],[5,16,1],[6,7,1],[6,8,2],[9,12,1]]},"so
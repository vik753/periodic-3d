{"version":"2026.10.11-r25","id":"Q3620564","formula":"Cu₉Si₁₀O₂₉·11H₂O","hill":"Cu9H22O40Si10","elements":["H","O","Si","Cu"],"composition":{"H":22.0,"O":40.0,"Cu":9.0,"Si":10.0},"names":{"en":"Apachite"},"descriptions":{"en":"Apachite is a copper silicate mineral with a general formula of Cu9Si10O29·11H2O. The name is associated with the Apache tribe residents of the area near the Christmas copper mine in the Dripping Spring Mountains of Gila County, Arizona, the location where apachite was first described in 1980. Apachite has monoclinic crystal symmetry, displaying 3 axes of unequal length with two of the axes perpendicular to each other as well as one angle oriented less than 90°. The mineral has a maximum birefringence value of δ = 0.040 which describes the difference between the highest and lowest index of refraction for the mineral."},"fame":6,"pubchemCid":null,"mass":null,"charge":0,"smiles":null,"inchikey":null,"iupac":null,"classes":[{"qid":"Q12089225","names":{"en":"mineral species","ru":"действительный вид минералов","uk":"мінеральний вид"}}],"structureInfo":null,"structure":null,"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q3620564","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Apachite","license":"CC BY-SA 4.0"}],"similar":[{"id":"Q413369","formula":"CuSiO₃·H₂O","names":{"en":"Dioptase","ru":"Диоптаз","uk":"Діоптаз"},"elements":["H","O","Si","Cu"],"fame":30,"kind":"crystal"},{"id":"Q3764186","formula":"Cu₅Si₆O₁₇·7H₂O","names":{"en":"Gilalite","uk":"Гілаліт"},"elements":["H","O","Si","Cu"],"fame":8,"kind":null},{"id":"Q1067093","formula":"NaCaCu₅(PO₄)₄Cl·5H₂O","names":{"en":"Sampleite","uk":"Самплеїт"},"elements":["H","O","Na","P","Cl","Ca","Cu"],"fame":9,"kind":null},{"id":"Q3650518","formula":"CuFe₆(PO₄)₄(OH)₈·4H₂O","names":{"en":"Chalcosiderite","uk":"Халькосидерит"},"elements":["H","O","P","Fe","Cu"],"fame":7,"kind":"crystal"},{"id":"Q2251934","formula
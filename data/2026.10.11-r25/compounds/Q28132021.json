{"version":"2026.10.11-r25","id":"Q28132021","formula":"C₃₅H₅₈O₃","hill":"C35H58O3","elements":["H","C","O"],"composition":{"C":35.0,"H":58.0,"O":3.0},"names":{"en":"Testosterone palmitate"},"descriptions":{"en":"Testosterone palmitate, also known as testosterone hexadecanoate, testosterone 17β-palmitate, and androst-4-en-17β-ol-3-one 17β-palmitate, is an anabolic-androgenic steroid (AAS) and an androgen ester – specifically, the C17β palmitate (hexadecanoate) ester of testosterone – which was never marketed. It is a prodrug of testosterone and, when administered via intramuscular injection, is associated with a long-lasting depot effect and extended duration of action. Testosterone palmitate is a longer-chain ester of testosterone compared to testosterone undecanoate."},"fame":1,"pubchemCid":164765,"mass":526.8,"charge":0,"smiles":"CCCCCCCCCCCCCCCC(=O)O[C@H]1CC[C@@H]2[C@@]1(CC[C@H]3[C@H]2CCC4=CC(=O)CC[C@]34C)C","inchikey":"OKFBXYQPCPWWRP-SHDAAXGTSA-N","iupac":"[(8R,9S,10R,13S,14S,17S)-10,13-dimethyl-3-oxo-1,2,6,7,8,9,11,12,14,15,16,17-dodecahydrocyclopenta[a]phenanthren-17-yl] hexadecanoate","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"rdkit","ref":"164765","atoms":96,"license":"Computed with RDKit from SMILES (PubChem, Wikidata)"},"structure":{"kind":"molecule","atoms":[{"x":8.196,"y":4.432,"z":-0.431,"el":"C"},{"x":7.766,"y":4.233,"z":1.011,"el":"C"},{"x":8.378,"y":3.006,"z":1.692,"el":"C"},{"x":7.961,"y":1.662,"z":1.081,"el":"C"},{"x":9.003,"y":1.104,"z":0.106,"el":"C"},{"x":8.553,"y":-0.176,"z":-0.609,"el":"C"},{"x":8.992,"y":-1.482,"z":0.063,"el":"C"},{"x":8.348,"y":-1.811,"z":1.411,"el":"C"},{"x":6.817,"y":-1.887,"z":1.414,"el":"C"},{"x":6.263,"y":-2.956,"z":0.47,"el":"C"},{"x":4.753,"y":-3.177,"z":0.621,"el":"C"},{"x":3.918,"y":-1.972,"z":0.179,"el":"C"},{"x":2.408,"y":-2.189,"z":0.33,"el":"C"},{"x":1.848,"y":-3.257,"z":-0.616
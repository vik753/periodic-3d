{"version":"2026.10.11-r25","id":"Q5121290","formula":"C₁₉H₂₇NO","hill":"C19H27NO","elements":["H","C","N","O"],"composition":{"C":19.0,"H":27.0,"N":1.0,"O":1.0},"names":{"en":"Ciprefadol"},"descriptions":{"en":"Ciprefadol is an opioid analgesic that is an isoquinoline derivative most closely related to cyclazocine and picenadol, with a number of other related compounds known. Ciprefadol is a mixed agonist–antagonist at μ-opioid receptors and can partly block the effects of morphine at low doses, though at higher doses it acts more like a full agonist. It is also a potent κ-opioid agonist, unlike the corresponding N-methyl and N-phenethyl derivatives which are reasonably μ-selective agonists."},"fame":6,"pubchemCid":333483,"mass":285.4,"charge":0,"smiles":"C1CC[C@]2(CCN(C[C@@H]2C1)CC3CC3)C4=CC(=CC=C4)O","inchikey":"KFIQKMINEHFZSM-HKUYNNGSSA-N","iupac":"3-[(4aR,8aR)-2-(cyclopropylmethyl)-1,3,4,5,6,7,8,8a-octahydroisoquinolin-4a-yl]phenol","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"333483","atoms":48,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":3.348,"y":-3.292,"z":1.015,"el":"O"},{"x":-2.239,"y":0.705,"z":-0.002,"el":"N"},{"x":0.677,"y":0.845,"z":0.686,"el":"C"},{"x":-0.069,"y":1.882,"z":-0.225,"el":"C"},{"x":-0.424,"y":0.279,"z":1.633,"el":"C"},{"x":-1.291,"y":1.296,"z":-0.958,"el":"C"},{"x":1.709,"y":1.671,"z":1.518,"el":"C"},{"x":0.863,"y":2.707,"z":-1.128,"el":"C"},{"x":-4.412,"y":-0.378,"z":0.261,"el":"C"},{"x":-1.609,"y":-0.308,"z":0.852,"el":"C"},{"x":-3.395,"y":0.145,"z":-0.702,"el":"C"},{"x":2.682,"y":2.45,"z":0.627,"el":"C"},{"x":1.951,"y":3.404,"z":-0.312,"el":"C"},{"x":-5.655,"y":-1.011,"z":-0.276,"el":"C"},{"x":-4.602,"y":-1.857,"z":0.378,"el":"C"},{"x":1.416,"y":-0.35,"z":0.029,"el":"C"},{"x":2.057,"y":-1.293,"z":0.828,"el":"C"},{"x":1.434,"y":-0.476,"z":-1.359,"el
{"version":"2026.10.11-r25","id":"Q420831","formula":"XePtF₆","hill":"F6PtXe","elements":["F","Xe","Pt"],"composition":{"F":6.0,"Pt":1.0,"Xe":1.0},"names":{"en":"Xenon hexafluoroplatinate"},"descriptions":{"en":"Xenon hexafluoroplatinate is the product of the reaction of platinum hexafluoride with xenon, in an experiment that proved the chemical reactivity of the noble gases. This experiment was performed in 1962 by Neil Bartlett at the University of British Columbia, who formulated the product as \"Xe+[PtF6]−\", although subsequent work suggests that Bartlett's product was probably a salt mixture and did not in fact contain this specific salt."},"fame":22,"pubchemCid":null,"mass":null,"charge":0,"smiles":null,"inchikey":null,"iupac":null,"classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":null,"structure":null,"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q420831","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Xenon_hexafluoroplatinate","license":"CC BY-SA 4.0"}],"similar":[{"id":"Q419600","formula":"F₃I","names":{"en":"Iodine trifluoride","ru":"Трифторид иода"},"elements":["F","I"],"fame":23,"kind":"molecule"},{"id":"Q411142","formula":"F₆Xe","names":{"en":"Xenon hexafluoride","ru":"Фторид ксенона(VI)"},"elements":["F","Xe"],"fame":28,"kind":"molecule"},{"id":"Q417309","formula":"PtF₆","names":{"en":"Platinum hexafluoride","ru":"Гексафторид платины"},"elements":["F","Pt"],"fame":27,"kind":"crystal"},{"id":"Q417415","formula":"F₅I","names":{"en":"Iodine pentafluoride","ru":"Фторид иода(V)"},"elements":["F","I"],"fame":24,"kind":"molecule"},{"id":"Q425217","formula":"F₆Se","names":{"en":"Selenium hexafluoride","ru":"Гексафторид селена"},"elements":["F","Se"],"fame":22,"kind":"molecule"},{"id":"Q8043633","formula":"XeRhF₆","names":{"en":"Xenon hexafluororhodate"},"elements":["
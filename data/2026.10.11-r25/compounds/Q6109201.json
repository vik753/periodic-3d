{"version":"2026.10.11-r25","id":"Q6109201","formula":"C₂₅H₂₄","hill":"C25H24","elements":["H","C"],"composition":{"C":25.0,"H":24.0},"names":{"en":"JWH-176"},"descriptions":{"en":"JWH-176 is an analgesic drug which acts as a cannabinoid receptor agonist. Its binding affinity at the CB1 receptor is 26.0 nM, making it more potent than THC itself, however JWH-176 is particularly notable in that it is a hydrocarbon containing no heteroatoms. This demonstrates that reasonably high-affinity cannabinoid binding and agonist effects can be produced by compounds with no hydrogen bonding capacity at all, relying merely on Van der Waals and possibly hydrophobic interactions to bind to the receptor."},"fame":4,"pubchemCid":53249197,"mass":324.5,"charge":0,"smiles":"CCCCCC1=C/C(=C\\C2=CC=CC3=CC=CC=C32)/C4=CC=CC=C41","inchikey":"FPESBQVTVSBBSE-OQKWZONESA-N","iupac":"1-[(E)-(3-pentylinden-1-ylidene)methyl]naphthalene","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"53249197","atoms":49,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-2.165,"y":0.105,"z":0.001,"el":"C"},{"x":-3.131,"y":-1.004,"z":-0.177,"el":"C"},{"x":-2.506,"y":-2.399,"z":-0.045,"el":"C"},{"x":-2.523,"y":1.529,"z":-0.105,"el":"C"},{"x":-1.379,"y":2.319,"z":0.117,"el":"C"},{"x":-0.293,"y":1.371,"z":0.365,"el":"C"},{"x":-0.85,"y":0.034,"z":0.277,"el":"C"},{"x":-3.534,"y":-3.528,"z":-0.169,"el":"C"},{"x":-2.876,"y":-4.898,"z":-0.002,"el":"C"},{"x":0.983,"y":1.669,"z":0.625,"el":"C"},{"x":-3.748,"y":2.121,"z":-0.373,"el":"C"},{"x":-1.434,"y":3.702,"z":0.075,"el":"C"},{"x":2.063,"y":0.698,"z":0.872,"el":"C"},{"x":-3.813,"y":3.516,"z":-0.418,"el":"C"},{"x":2.876,"y":0.184,"z":-0.151,"el":"C"},{"x":-2.667,"y":4.299,"z":-0.196,"el":"C"},{"x":-3.898,"y":-6.021,"z":-0.082,"el":"C"},{"x":3.891,"y":-0.748,"z":0.173,"el":"C"},{"x":2.248,"y":0.298
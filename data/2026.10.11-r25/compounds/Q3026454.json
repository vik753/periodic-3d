{"version":"2026.10.11-r25","id":"Q3026454","formula":"HN₂⁺","hill":"HN2","elements":["H","N"],"composition":{"H":1.0,"N":2.0},"names":{"en":"Diazynium","ru":"Ион HN2+"},"descriptions":{"en":"Diazenylium is the chemical N2H+, an inorganic cation that was one of the first ions to be observed in interstellar clouds. Since then, it has been observed in several different types of interstellar environments, observations that have several different scientific uses. It gives astronomers information about the fractional ionization of gas clouds, the chemistry that happens within those clouds, and it is often used as a tracer for molecules that are not as easily detected (such as N2)."},"fame":3,"pubchemCid":5460527,"mass":29.022,"charge":1,"smiles":"[NH+]#N","inchikey":"IJGRMHOSHXDMSA-UHFFFAOYSA-O","iupac":"azanylidyneazanium","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"5460527","atoms":3,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":0.543,"y":0.0,"z":0.0,"el":"N"},{"x":-0.543,"y":0.0,"z":0.0,"el":"N"},{"x":1.554,"y":0.0,"z":0.0,"el":"H"}],"bonds":[[0,1,3],[0,2,1]]},"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q3026454","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Diazenylium","license":"CC BY-SA 4.0"},{"role":"properties","name":"PubChem","url":"https://pubchem.ncbi.nlm.nih.gov/compound/5460527","license":"PubChem (NIH), public data"},{"role":"structure","name":"PubChem 3D","url":"https://pubchem.ncbi.nlm.nih.gov/compound/5460527#section=3D-Conformer","license":"PubChem (NIH), public data"}],"similar":[{"id":"Q58826308","formula":"CH₂N₄","names":{"en":"1H-tetrazole","ru":"Тетразол","uk":"Тетразол"},"elements":["H","C","N"],"fame":26,"kind":"molecule"},{"id":"Q417549","formula":"C₂H₂N₄","na
{"version":"2026.10.11-r25","id":"Q1070696","formula":"CuFe₂(AsO₄)₂(OH)₂*4H₂O","hill":"As2CuFe2H10O14","elements":["H","O","Fe","Cu","As"],"composition":{"H":10.0,"O":14.0,"As":2.0,"Cu":1.0,"Fe":2.0},"names":{"en":"Arthurite"},"descriptions":{"en":"Arthurite is a mineral composed of divalent copper and iron ions in combination with trivalent arsenate, phosphate and sulfate ions with hydrogen and oxygen. Initially discovered by Sir Arthur Russell in 1954 at Hingston Down Consols mine in Calstock, Cornwall, England, arthurite is formed as a resultant mineral in the oxidation region of some copper deposits by the variation of enargite or arsenopyrite. The chemical formula of Arthurite is CuFe23+(AsO4,PO4,SO4)2(O,OH)2·4H2O. Arthurite is named after Arthur W. G. Kingsbury (1906–1968), a British mineralogist, and Sir Arthur Russell (1878–1964), a collector of minerals."},"fame":11,"pubchemCid":null,"mass":null,"charge":0,"smiles":null,"inchikey":null,"iupac":null,"classes":[{"qid":"Q12089225","names":{"en":"mineral species","ru":"действительный вид минералов","uk":"мінеральний вид"}}],"structureInfo":null,"structure":null,"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q1070696","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Arthurite","license":"CC BY-SA 4.0"},{"role":"photo","name":"Wikimedia Commons","url":"https://commons.wikimedia.org/wiki/File:Arthurite_Tomeik.jpg","license":"CC BY 4.0"}],"similar":[{"id":"Q425546","formula":"FeAsH₄O₆","names":{"en":"Scorodite","ru":"Скородит","uk":"Скородит"},"elements":["H","O","Fe","As"],"fame":21,"kind":"crystal"},{"id":"Q3635001","formula":"Ba₀.₅Fe₄(AsO₄)₃(OH)₄*5H₂O","names":{"en":"Bariopharmacosiderite","ru":"Бариофармакосидерит"},"elements":["H","O","Fe","As","Ba"],"fame":8,"kind":null},{"id":"Q3895291","formula":"FeAsO₄*2H₂O","names":{"en":"Parascorodite"},"elements":["H","O","Fe","As"],"fame":4,"kind":"crystal"},{"id":"Q1934730","f
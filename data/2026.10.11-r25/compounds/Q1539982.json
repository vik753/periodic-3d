{"version":"2026.10.11-r25","id":"Q1539982","formula":"CaMg(VO₄)OH","hill":"CaHMgO5V","elements":["H","O","Mg","Ca","V"],"composition":{"H":1.0,"O":5.0,"V":1.0,"Ca":1.0,"Mg":1.0},"names":{"en":"Gottlobite"},"descriptions":{"en":"Gottlobite, CaMg(VO4,AsO4)(OH), is a mineral in the adelite group found as isolated crystals or isometric grains of orange or orange-brown color. The size of the crystals are a half millimeter in diameter and are part of the orthorhombic crystal system. Gottlobite is the vanadate end member in a solid solution formed with adelite (CaMg(AsO4)(OH))."},"fame":9,"pubchemCid":null,"mass":null,"charge":0,"smiles":null,"inchikey":null,"iupac":null,"classes":[{"qid":"Q12089225","names":{"en":"mineral species","ru":"действительный вид минералов","uk":"мінеральний вид"}}],"structureInfo":null,"structure":null,"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q1539982","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Gottlobite","license":"CC BY-SA 4.0"},{"role":"photo","name":"Wikimedia Commons","url":"https://commons.wikimedia.org/wiki/File:Gottlobite_-_Grube_Gl%C3%BCckstern,_Gottlob,_Th%C3%BCringen.jpg","license":"CC BY-SA 3.0 de"}],"similar":[{"id":"Q2251970","formula":"Ba₂Mn(VO₄)₂(OH)","names":{"en":"Tokyoite"},"elements":["H","O","V","Mn","Ba"],"fame":11,"kind":"crystal"},{"id":"Q418442","formula":"Na₂O₄U⁶⁻","names":{"en":"Sodium diuranate","ru":"Диуранат натрия"},"elements":["O","Na","U"],"fame":16,"kind":"molecule"},{"id":"Q2661725","formula":"Na₂O₄U","names":{"en":"Sodium uranate","ru":"Уранат натрия"},"elements":["O","Na","U"],"fame":6,"kind":"crystal"},{"id":"Q3625311","formula":"NaMg₃(AlSi₃O₁₀)(OH)₂","names":{"en":"Aspidolite","ru":"Аспидолит"},"elements":["H","O","Na","Mg","Al","Si"],"fame":7,"kind":null},{"id":"Q3952221","formula":"(NaCa₂)Mg₂(VO₄)₃","names":{"en":"Schäferite"},"elements":["O","Na","Mg","Ca","V"],"fame":6,"kind":"crystal"},{"id":"Q182
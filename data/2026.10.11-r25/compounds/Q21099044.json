{"version":"2026.10.11-r25","id":"Q21099044","formula":"C₁₈H₂₆FN₃O₆","hill":"C18H26FN3O6","elements":["H","C","N","O","F"],"composition":{"C":18.0,"F":1.0,"H":26.0,"N":3.0,"O":6.0},"names":{"en":"Mericitabine"},"descriptions":{"en":"Mericitabine (RG-7128) is an antiviral drug, a deoxycytidine analog (a type of nucleoside analog). It was developed as a treatment for hepatitis C, acting as a NS5B RNA polymerase inhibitor, but while it showed a good safety profile in clinical trials, it was not sufficiently effective to be used as a stand-alone agent. However mericitabine has been shown to boost the efficacy of other antiviral drugs when used alongside them, and as most modern treatment regimens for hepatitis C use a combination therapy of several antiviral drugs, clinical trials have continued to see if it can form a part of a clinically useful drug treatment program."},"fame":4,"pubchemCid":16122663,"mass":399.4,"charge":0,"smiles":"CC(C)C(=O)OC[C@@H]1[C@H]([C@@]([C@@H](O1)N2C=CC(=NC2=O)N)(C)F)OC(=O)C(C)C","inchikey":"MLESJYFEMSJZLZ-MAAOGQSESA-N","iupac":"[(2R,3R,4R,5R)-5-(4-amino-2-oxopyrimidin-1-yl)-4-fluoro-4-methyl-3-(2-methylpropanoyloxy)oxolan-2-yl]methyl 2-methylpropanoate","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"16122663","atoms":54,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-0.536,"y":2.886,"z":1.11,"el":"F"},{"x":-0.153,"y":-0.104,"z":-0.675,"el":"O"},{"x":1.779,"y":2.244,"z":0.22,"el":"O"},{"x":1.29,"y":-2.433,"z":-0.149,"el":"O"},{"x":-3.059,"y":2.752,"z":-1.004,"el":"O"},{"x":3.734,"y":1.021,"z":0.258,"el":"O"},{"x":1.595,"y":-3.933,"z":1.577,"el":"O"},{"x":-2.325,"y":0.68,"z":-0.302,"el":"N"},{"x":-4.66,"y":1.185,"z":-0.64,"el":"N"},{"x":-6.295,"y":-0.426,"z":-0.264,"el":"N"},{"x":-0.385,"y":1.538,"z":1.025,"el":"C"},{"x":1.092,"y":1.19,"z":0.899,"el":"C"},{"x
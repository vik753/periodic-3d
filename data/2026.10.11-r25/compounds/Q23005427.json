{"version":"2026.10.11-r25","id":"Q23005427","formula":"Na(Na₂)(Mg₃FeTi)(Si₈O₂₂)O₂","hill":"FeMg3Na3O24Si8Ti","elements":["O","Na","Mg","Si","Ti","Fe"],"composition":{"O":24.0,"Fe":1.0,"Mg":3.0,"Na":3.0,"Si":8.0,"Ti":1.0},"names":{"en":"Ferri-obertiite"},"descriptions":{"en":"Ferri-obertiite is an amphibole group mineral that was formally approved by the International Mineralogical Association in 2015. It has the chemical formula Na(Na2)(Mg3Fe3+Ti)(Si8O22)O2. Ferri-obertiite is highly sodic and is especially characterized in the presence of oxygen instead of a hydroxy group or fluorine at the W site, which compensates for the relatively high positive charge due to the dominance of ferric iron and presence of titanium."},"fame":7,"pubchemCid":null,"mass":null,"charge":0,"smiles":null,"inchikey":null,"iupac":null,"classes":[{"qid":"Q12089225","names":{"en":"mineral species","ru":"действительный вид минералов","uk":"мінеральний вид"}}],"structureInfo":null,"structure":null,"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q23005427","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Ferri-obertiite","license":"CC BY-SA 4.0"},{"role":"photo","name":"Wikimedia Commons","url":"https://commons.wikimedia.org/wiki/File:Obertiite4478-4.jpg","license":"CC BY 4.0"}],"similar":[{"id":"Q380674","formula":"NaFeSi₂O₆","names":{"en":"Aegirine","ru":"Эгирин","uk":"Егірин"},"elements":["O","Na","Si","Fe"],"fame":35,"kind":"crystal"},{"id":"Q836952","formula":"Mg₂O₈Si₃","names":{"en":"Magnesium trisilicate","ru":"Трисиликат магния"},"elements":["O","Mg","Si"],"fame":15,"kind":"molecule"},{"id":"Q1071200","formula":"Na(NaCa)Mg₅Si₈O₂₂F₂","names":{"en":"Fluoro-richterite"},"elements":["O","F","Na","Mg","Si","Ca"],"fame":8,"kind":"crystal"},{"id":"Q18059147","formula":"KNa₂(Mg₄Fe)Si₈O₂₂F₂","names":{"en":"Potassic-magnesio-fluoro-arfvedsonite"},"elements":["O","F","Na","Mg","Si","K","Fe"],"fame":4,"kind"
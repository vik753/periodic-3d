{"version":"2026.10.11-r25","id":"Q6714966","formula":"C₂₆H₄₀N₄","hill":"C26H40N4","elements":["H","C","N"],"composition":{"C":26.0,"H":40.0,"N":4.0},"names":{"en":"MCOPPB"},"descriptions":{"en":"MCOPPB is a drug which acts as a potent and selective agonist for the nociceptin receptor, with a pKi of 10.07 and much weaker activity at other opioid receptors. It has only moderate affinity for the mu opioid receptor, weak affinity for the kappa opioid receptor and negligible binding at the delta opioid receptor. In animal studies, MCOPPB produces potent anxiolytic effects, with no inhibition of memory or motor function, and only slight sedative side effects which do not appear until much higher doses than the effective anxiolytic dose range."},"fame":3,"pubchemCid":24800108,"mass":408.6,"charge":0,"smiles":"CC1(CCCCCCC1)N2CCC(CC2)N3C4=CC=CC=C4N=C3[C@@H]5CCCNC5","inchikey":"CYYNMPPFEJPBJD-OAQYLSRUSA-N","iupac":"1-[1-(1-methylcyclooctyl)piperidin-4-yl]-2-[(3R)-piperidin-3-yl]benzimidazole","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"24800108","atoms":70,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":2.263,"y":0.38,"z":-0.03,"el":"N"},{"x":-1.957,"y":-0.606,"z":-0.092,"el":"N"},{"x":-4.139,"y":-1.027,"z":-0.123,"el":"N"},{"x":-4.97,"y":3.205,"z":-1.001,"el":"N"},{"x":3.549,"y":1.095,"z":-0.02,"el":"C"},{"x":-0.662,"y":0.183,"z":-0.085,"el":"C"},{"x":1.473,"y":0.726,"z":1.159,"el":"C"},{"x":1.522,"y":0.673,"z":-1.265,"el":"C"},{"x":4.274,"y":0.824,"z":1.317,"el":"C"},{"x":4.338,"y":0.696,"z":-1.29,"el":"C"},{"x":0.156,"y":-0.053,"z":1.195,"el":"C"},{"x":0.206,"y":-0.108,"z":-1.319,"el":"C"},{"x":3.209,"y":2.6,"z":-0.083,"el":"C"},{"x":4.642,"y":-0.62,"z":1.668,"el":"C"},{"x":5.806,"y":1.14,"z":-1.327,"el":"C"},{"x":5.625,"y":-1.353,"z":0.756,"el":"C"},{"x":6.811,"y":0.015,"z":-1.073,"el":
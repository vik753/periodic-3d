{"version":"2026.10.11-r25","id":"Q44793","formula":"C₁₉H₁₇ClFN₅S","hill":"C19H17ClFN5S","elements":["H","C","N","F","S","Cl"],"composition":{"C":19.0,"F":1.0,"H":17.0,"N":5.0,"S":1.0,"Cl":1.0},"names":{"en":"PRX-08066"},"descriptions":{"en":"PRX-08066 is a drug discovered and developed by Predix (later Epix) Pharmaceuticals [Dale S. Dhanoa et al. Patent US 7,030,240 B2], which acts as a potent and selective antagonist at the serotonin 5-HT2B receptor, with a 5-HT2B binding affinity (Ki) of 3.4nM, and high selectivity over the closely related 5-HT2A and 5-HT2C receptors and other receptor targets. PRX-08066 and other selective 5-HT2B antagonists are being researched for the treatment of pulmonary arterial hypertension, following the discovery that the potent 5-HT2B agonist norfenfluramine produces pulmonary arterial hypertension and subsequent heart valve damage."},"fame":3,"pubchemCid":11502243,"mass":401.9,"charge":0,"smiles":"C1CN(CCC1NC2=C3C=C(SC3=NC=N2)Cl)CC4=CC(=C(C=C4)F)C#N","inchikey":"IENZFHBNCRQMNP-UHFFFAOYSA-N","iupac":"5-[[4-[(6-chlorothieno[2,3-d]pyrimidin-4-yl)amino]piperidin-1-yl]methyl]-2-fluorobenzonitrile","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"11502243","atoms":44,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":6.194,"y":-3.436,"z":0.267,"el":"Cl"},{"x":6.278,"y":-0.916,"z":-1.3,"el":"S"},{"x":-6.463,"y":-0.978,"z":-2.123,"el":"F"},{"x":-1.457,"y":0.071,"z":1.584,"el":"N"},{"x":2.104,"y":0.671,"z":0.984,"el":"N"},{"x":3.129,"y":2.075,"z":-0.641,"el":"N"},{"x":5.147,"y":1.438,"z":-1.824,"el":"N"},{"x":-6.595,"y":2.276,"z":-0.703,"el":"N"},{"x":1.03,"y":1.606,"z":1.259,"el":"C"},{"x":-0.037,"y":1.52,"z":0.165,"el":"C"},{"x":0.413,"y":1.314,"z":2.628,"el":"C"},{"x":-0.859,"y":0.231,"z":0.252,"el":"C"},{"x":-0.424,"y":0.031,"z":2.628,"el":"C"},{"x":-2.283,"y":-1
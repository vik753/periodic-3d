{"version":"2026.10.11-r25","id":"Q47455781","formula":"C₆H₄F₁₁NO₃","hill":"C6H4F11NO3","elements":["H","C","N","O","F"],"composition":{"C":6.0,"F":11.0,"H":4.0,"N":1.0,"O":3.0},"names":{"en":"GenX"},"descriptions":{"en":"GenX is a Chemours trademark name for a synthetic, short-chain organofluorine chemical compound, the ammonium salt of hexafluoropropylene oxide dimer acid (HFPO-DA). It can also be used more informally to refer to the group of related fluorochemicals that are used to produce GenX. DuPont began the commercial development of GenX in 2009 as a replacement for perfluorooctanoic acid (PFOA, also known as C8), in response to legal action due to the health effects and ecotoxicity of PFOA. Although GenX was designed to be less persistent in the environment compared to PFOA, its effects may be equally harmful or even more detrimental than those of the chemical it was meant to replace."},"fame":5,"pubchemCid":null,"mass":null,"charge":0,"smiles":null,"inchikey":null,"iupac":null,"classes":[{"qid":"Q167270","names":{"en":"trademark","ru":"товарный знак","uk":"торговельна марка"}},{"qid":"Q2281940","names":{"en":"chemical process","ru":"химический процесс","uk":"хімічний процес"}}],"structureInfo":null,"structure":null,"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q47455781","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/GenX","license":"CC BY-SA 4.0"}],"similar":[{"id":"Q81988518","formula":"C₂HF₃O","names":{"en":"Acetaldehyde, trifluoro-"},"elements":["H","C","O","F"],"fame":3,"kind":"molecule"},{"id":"Q29388239","formula":"C₆H₄F₁₁NO₃","names":{"en":"Ammonium 2,3,3,3-tetrafluoro-2-(heptafluoropropoxy)propanoate"},"elements":["H","C","N","O","F"],"fame":2,"kind":"molecule"},{"id":"Q419394","formula":"C₄H₃F₇O","names":{"en":"Sevoflurane","ru":"Севофлуран","uk":"Севофлуран"},"elements":["H","C","O","F"],"fame":31,"kind":"molecule"},{"id":"Q27063662","formula":"C₈H₅F₁
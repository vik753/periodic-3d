{"version":"2026.10.11-r25","id":"Q7119048","formula":"C₂₅H₂₀N₄O","hill":"C25H20N4O","elements":["H","C","N","O"],"composition":{"C":25.0,"H":20.0,"N":4.0,"O":1.0},"names":{"en":"PF-2545920"},"descriptions":{"en":"Mardepodect (developmental code name PF-2545920) is a drug which was developed by Pfizer for the treatment of schizophrenia. It acts as a phosphodiesterase inhibitor selective for the PDE10A subtype. The PDE10A enzyme is expressed primarily in the brain, mostly in the striatum, nucleus accumbens and olfactory tubercle, and is thought to be particularly important in regulating the activity of dopamine-sensitive medium spiny neurons in the striatum which are known to be targets of conventional antipsychotic drugs."},"fame":3,"pubchemCid":11581936,"mass":392.5,"charge":0,"smiles":"CN1C=C(C(=N1)C2=CC=C(C=C2)OCC3=NC4=CC=CC=C4C=C3)C5=CC=NC=C5","inchikey":"AZEXWHKOMMASPA-UHFFFAOYSA-N","iupac":"2-[[4-(1-methyl-4-pyridin-4-ylpyrazol-3-yl)phenoxy]methyl]quinoline","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"11581936","atoms":50,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-1.661,"y":0.885,"z":-0.431,"el":"O"},{"x":5.822,"y":2.03,"z":0.063,"el":"N"},{"x":4.522,"y":2.357,"z":-0.031,"el":"N"},{"x":-4.345,"y":-0.5,"z":0.423,"el":"N"},{"x":4.23,"y":-4.098,"z":0.054,"el":"N"},{"x":3.906,"y":1.168,"z":-0.053,"el":"C"},{"x":4.815,"y":0.092,"z":0.027,"el":"C"},{"x":2.475,"y":1.095,"z":-0.15,"el":"C"},{"x":6.051,"y":0.686,"z":0.102,"el":"C"},{"x":4.618,"y":-1.326,"z":0.036,"el":"C"},{"x":1.698,"y":1.079,"z":1.008,"el":"C"},{"x":1.863,"y":1.04,"z":-1.402,"el":"C"},{"x":-0.295,"y":0.954,"z":-0.338,"el":"C"},{"x":0.308,"y":1.008,"z":0.913,"el":"C"},{"x":0.473,"y":0.97,"z":-1.497,"el":"C"},{"x":-2.386,"y":0.874,"z":0.792,"el":"C"},{"x":-3.845,"y":0.755,"z":0.5,"el":"C"},{"x":-6.507,"y":0.462,
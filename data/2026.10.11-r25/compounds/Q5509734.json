{"version":"2026.10.11-r25","id":"Q5509734","formula":"C₁₇H₂₆N₄O₃S₂","hill":"C17H26N4O3S2","elements":["H","C","N","O","S"],"composition":{"C":17.0,"H":26.0,"N":4.0,"O":3.0,"S":2.0},"names":{"en":"Fursultiamine"},"descriptions":{"en":"Fursultiamine (INN; chemical name thiamine tetrahydrofurfuryl disulfide or TTFD; brand names Adventan, Alinamin-F, Benlipoid, Bevitol Lipophil, Judolor, Lipothiamine) is a medication and vitamin used to treat thiamine deficiency. Chemically, it is a tetrahydrofurfuryl disulfide derivative of thiamine and is similar in structure to allithiamine. It was synthesized in Japan in the 1960s from allithiamine for the purpose of developing forms of thiamine with improved lipophilicity for treating vitamin B1 deficiency (i.e., beriberi), It was subsequently commercialized not only in Japan but also in Spain, Austria, Germany, and the United States."},"fame":8,"pubchemCid":3002119,"mass":398.5,"charge":0,"smiles":"CC1=NC=C(C(=N1)N)CN(C=O)/C(=C(\\CCO)/SSCC2CCCO2)/C","inchikey":"JTLXCMOFVBXEKD-FOWTUZBSSA-N","iupac":"N-[(4-amino-2-methylpyrimidin-5-yl)methyl]-N-[(E)-5-hydroxy-3-(oxolan-2-ylmethyldisulfanyl)pent-2-en-2-yl]formamide","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"3002119","atoms":52,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":1.413,"y":2.505,"z":-1.482,"el":"S"},{"x":-0.227,"y":3.407,"z":-0.646,"el":"S"},{"x":3.016,"y":0.087,"z":-0.468,"el":"O"},{"x":-2.39,"y":3.014,"z":2.364,"el":"O"},{"x":-4.248,"y":-0.557,"z":1.053,"el":"O"},{"x":-2.692,"y":0.255,"z":-0.502,"el":"N"},{"x":0.826,"y":-2.586,"z":-0.477,"el":"N"},{"x":-0.858,"y":-3.594,"z":0.922,"el":"N"},{"x":0.236,"y":-0.88,"z":-2.015,"el":"N"},{"x":3.623,"y":1.382,"z":-0.317,"el":"C"},{"x":4.612,"y":1.255,"z":0.828,"el":"C"},{"x":5.086,"y":-0.167,"z":0.659,"el":"C"},{"x":3.814,"y":-0.873,"z":0.24
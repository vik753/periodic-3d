{"version":"2026.10.11-r25","id":"Q7687250","formula":"C₁₅H₁₉NO₂","hill":"C15H19NO2","elements":["H","C","N","O"],"composition":{"C":15.0,"H":19.0,"N":1.0,"O":2.0},"names":{"en":"Tasimelteon"},"descriptions":{"en":"Tasimelteon, sold under the brand name Hetlioz, is a medication approved by the U.S. Food and Drug Administration (FDA) in January 2014, for the treatment of non-24-hour sleep–wake disorder (also called non-24, N24 and N24HSWD). In June 2014, the European Medicines Agency (EMA) accepted an EU filing application for tasimelteon and in July 2015, the drug was approved in the European Union for the treatment of non-24-hour sleep-wake rhythm disorder in totally blind adults, but not in the case of non-24 in sighted people. The most common side effects include headache, somnolence, nausea (feeling sick) and dizziness."},"fame":16,"pubchemCid":10220503,"mass":245.32,"charge":0,"smiles":"CCC(=O)NC[C@@H]1C[C@H]1C2=C3CCOC3=CC=C2","inchikey":"PTOIAAWZLUQTIO-GXFFZTMASA-N","iupac":"N-[[(1R,2R)-2-(2,3-dihydro-1-benzofuran-4-yl)cyclopropyl]methyl]propanamide","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"10220503","atoms":37,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-4.516,"y":-0.578,"z":-0.002,"el":"O"},{"x":3.224,"y":-0.243,"z":1.335,"el":"O"},{"x":3.303,"y":1.009,"z":-0.623,"el":"N"},{"x":-0.046,"y":1.152,"z":0.358,"el":"C"},{"x":0.95,"y":1.548,"z":-0.689,"el":"C"},{"x":-0.226,"y":2.434,"z":-0.396,"el":"C"},{"x":-0.967,"y":0.014,"z":0.089,"el":"C"},{"x":2.305,"y":1.984,"z":-0.269,"el":"C"},{"x":-2.34,"y":0.164,"z":0.165,"el":"C"},{"x":-0.459,"y":-1.241,"z":-0.256,"el":"C"},{"x":-3.144,"y":1.373,"z":0.442,"el":"C"},{"x":-3.187,"y":-0.901,"z":-0.105,"el":"C"},{"x":-4.507,"y":0.712,"z":0.655,"el":"C"},{"x":-1.323,"y":-2.313,"z":-0.531,"el":"C"},{"x":-2.708,"y":-2.146,"z":-0.461,"e
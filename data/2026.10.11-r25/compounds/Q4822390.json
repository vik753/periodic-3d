{"version":"2026.10.11-r25","id":"Q4822390","formula":"C₂₂H₁₄O₉","hill":"C22H14O9","elements":["H","C","O"],"composition":{"C":22.0,"H":14.0,"O":9.0},"names":{"en":"Aurintricarboxylic acid"},"descriptions":{"en":"Aurintricarboxylic acid (ATA) is a chemical compound (triarylmethane dye) that readily polymerizes in aqueous solution, forming a stable free radical that inhibits protein-nucleic acid interactions. It is a potent inhibitor of ribonuclease and topoisomerase II by preventing the binding of the nucleic acid to the enzyme. It stimulates tyrosine phosphorylation processes including the Jak2/STAT5 pathway in NB2 lymphoma cells, ErbB4 in neuroblastoma cells, and MAP kinases, Shc proteins, phosphatidylinositide 3-kinase and phospholipase Cγ in PC12 cells."},"fame":7,"pubchemCid":2259,"mass":422.3,"charge":0,"smiles":"C1=CC(=C(C=C1C(=C2C=CC(=O)C(=C2)C(=O)O)C3=CC(=C(C=C3)O)C(=O)O)C(=O)O)O","inchikey":"GIXWDMTZECRIJT-UHFFFAOYSA-N","iupac":"5-[(3-carboxy-4-hydroxyphenyl)-(3-carboxy-4-oxocyclohexa-2,5-dien-1-ylidene)methyl]-2-hydroxybenzoic acid","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"2259","atoms":45,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":2.782,"y":-4.472,"z":1.24,"el":"O"},{"x":-5.782,"y":0.443,"z":1.07,"el":"O"},{"x":2.415,"y":4.801,"z":-0.667,"el":"O"},{"x":1.884,"y":-3.144,"z":-2.525,"el":"O"},{"x":-4.072,"y":0.277,"z":-2.642,"el":"O"},{"x":4.59,"y":3.548,"z":0.032,"el":"O"},{"x":1.972,"y":-5.073,"z":-1.326,"el":"O"},{"x":-5.815,"y":-0.605,"z":-1.481,"el":"O"},{"x":4.622,"y":1.378,"z":-0.69,"el":"O"},{"x":-0.205,"y":0.22,"z":0.537,"el":"C"},{"x":0.587,"y":-1.025,"z":0.717,"el":"C"},{"x":-1.684,"y":0.277,"z":0.672,"el":"C"},{"x":0.45,"y":1.354,"z":0.238,"el":"C"},{"x":0.825,"y":-1.827,"z":-0.38,"el":"C"},{"x":-2.464,"y":0.059,"z":-0.445,"el":"C"},{"x":1.9,"y":1.348,"
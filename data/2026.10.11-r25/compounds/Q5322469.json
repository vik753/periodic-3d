{"version":"2026.10.11-r25","id":"Q5322469","formula":"C₁₉H₂₇NO₃","hill":"C19H27NO3","elements":["H","C","N","O"],"composition":{"C":19.0,"H":27.0,"N":1.0,"O":3.0},"names":{"en":"1-methyl-4-piperidyl cyclopentylphenyl glycolate"},"descriptions":{"en":"EA-3443 is a potent and long lasting anticholinergic deliriant drug, related to the chemical warfare agent 3-Quinuclidinyl benzilate (QNB). It was developed under contract to Edgewood Arsenal during the 1960s as part of the US military chemical weapons program, during research to improve upon the properties of earlier agents such as QNB. The main advantages of EA-3443 were not only increased potency over QNB, but also a significantly improved central to peripheral effects ratio."},"fame":4,"pubchemCid":37838,"mass":317.4,"charge":0,"smiles":"CN1CCC(CC1)OC(=O)C(C2CCCC2)(C3=CC=CC=C3)O","inchikey":"DZFJGXMHIMAYMW-UHFFFAOYSA-N","iupac":"(1-methylpiperidin-4-yl) 2-cyclopentyl-2-hydroxy-2-phenylacetate","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"37838","atoms":50,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-0.495,"y":1.084,"z":0.21,"el":"O"},{"x":2.238,"y":-0.051,"z":-1.834,"el":"O"},{"x":0.068,"y":1.485,"z":-1.989,"el":"O"},{"x":-4.591,"y":0.243,"z":0.384,"el":"N"},{"x":2.424,"y":0.838,"z":0.353,"el":"C"},{"x":3.766,"y":0.146,"z":0.572,"el":"C"},{"x":2.846,"y":2.21,"z":-0.163,"el":"C"},{"x":1.515,"y":0.091,"z":-0.607,"el":"C"},{"x":4.656,"y":1.239,"z":1.156,"el":"C"},{"x":4.057,"y":2.568,"z":0.692,"el":"C"},{"x":-1.885,"y":1.263,"z":-0.032,"el":"C"},{"x":0.296,"y":0.965,"z":-0.903,"el":"C"},{"x":1.093,"y":-1.308,"z":-0.178,"el":"C"},{"x":-2.608,"y":1.397,"z":1.304,"el":"C"},{"x":-2.435,"y":0.074,"z":-0.814,"el":"C"},{"x":-4.124,"y":1.43,"z":1.115,"el":"C"},{"x":-3.957,"y":0.148,"z":-0.938,"el":"C"},{"x":0.93,"y":-2.28,"z":-1.144,"el":
{"version":"2026.10.11-r25","id":"Q668231","formula":"C₁₀H₁₇N₅O₁₇P₄","hill":"C10H17N5O17P4","elements":["H","C","N","O","P"],"composition":{"C":10.0,"H":17.0,"N":5.0,"O":17.0,"P":4.0},"names":{"en":"Guanosine pentaphosphate"},"descriptions":{"en":"(p)ppGpp, guanosine pentaphosphate and tetraphosphate, also known as the \"magic spot\" nucleotides, are alarmones involved in the stringent response in bacteria that cause the inhibition of RNA synthesis when there is a shortage of amino acids. This inhibition by (p)ppGpp decreases translation in the cell, conserving amino acids present. Furthermore, ppGpp and pppGpp cause the up-regulation of many other genes involved in stress response such as the genes for amino acid uptake (from surrounding media) and biosynthesis."},"fame":12,"pubchemCid":766,"mass":603.16,"charge":0,"smiles":"C1=NC2=C(N1C3C(C(C(O3)COP(=O)(O)OP(=O)(O)O)OP(=O)(O)OP(=O)(O)O)O)NC(=NC2=O)N","inchikey":"BUFLLCUFNHESEH-UHFFFAOYSA-N","iupac":"[5-(2-amino-6-oxo-3H-purin-9-yl)-4-hydroxy-2-[[hydroxy(phosphonooxy)phosphoryl]oxymethyl]oxolan-3-yl] phosphono hydrogen phosphate","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"766","atoms":53,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-1.761,"y":2.8,"z":-0.222,"el":"P"},{"x":4.414,"y":0.12,"z":-0.786,"el":"P"},{"x":-0.318,"y":3.371,"z":2.277,"el":"P"},{"x":3.509,"y":-2.072,"z":0.955,"el":"P"},{"x":0.235,"y":-0.79,"z":-2.146,"el":"O"},{"x":-0.737,"y":1.636,"z":-0.676,"el":"O"},{"x":-1.524,"y":1.046,"z":-4.144,"el":"O"},{"x":3.068,"y":0.11,"z":-1.683,"el":"O"},{"x":-1.579,"y":2.903,"z":1.381,"el":"O"},{"x":-3.228,"y":2.138,"z":-0.386,"el":"O"},{"x":-1.585,"y":4.103,"z":-0.946,"el":"O"},{"x":3.978,"y":-0.564,"z":0.612,"el":"O"},{"x":4.624,"y":1.674,"z":-0.39,"el":"O"},{"x":5.606,"y":-0.519,"z":-1.438,"el":"O"},{"x":-3.986,"y":-3.239
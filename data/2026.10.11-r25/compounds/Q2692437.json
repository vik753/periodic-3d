{"version":"2026.10.11-r25","id":"Q2692437","formula":"C₁₅H₁₈","hill":"C15H18","elements":["H","C"],"composition":{"C":15.0,"H":18.0},"names":{"en":"Cadalene"},"descriptions":{"en":"Cadalene or cadalin (4-isopropyl-1,6-dimethylnaphthalene) is a polycyclic aromatic hydrocarbon with a chemical formula C15H18 and a cadinane skeleton. It is derived from generic sesquiterpenes, and ubiquitous in essential oils of many higher plants. Cadalene, together with retene, simonellite and ip-iHMN, is a biomarker of higher plants, which makes it useful for paleobotanic analysis of rock sediments."},"fame":11,"pubchemCid":10225,"mass":198.3,"charge":0,"smiles":"CC1=CC2=C(C=CC(=C2C=C1)C)C(C)C","inchikey":"VMOJIHDTVZTGDO-UHFFFAOYSA-N","iupac":"1,6-dimethyl-4-propan-2-ylnaphthalene","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"10225","atoms":33,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":2.213,"y":-1.336,"z":0.0,"el":"C"},{"x":1.327,"y":-0.129,"z":0.0,"el":"C"},{"x":-0.073,"y":-0.232,"z":0.0,"el":"C"},{"x":-0.855,"y":0.948,"z":0.0,"el":"C"},{"x":-0.212,"y":2.197,"z":0.0,"el":"C"},{"x":1.949,"y":1.12,"z":0.0,"el":"C"},{"x":-0.716,"y":-1.481,"z":0.0,"el":"C"},{"x":3.091,"y":-1.415,"z":1.26,"el":"C"},{"x":3.09,"y":-1.415,"z":-1.26,"el":"C"},{"x":1.181,"y":2.281,"z":0.0,"el":"C"},{"x":-2.255,"y":0.845,"z":0.0,"el":"C"},{"x":-2.109,"y":-1.565,"z":0.0,"el":"C"},{"x":-2.877,"y":-0.404,"z":0.0,"el":"C"},{"x":-0.977,"y":3.484,"z":0.0,"el":"C"},{"x":-2.776,"y":-2.899,"z":0.0,"el":"C"},{"x":1.659,"y":-2.273,"z":0.0,"el":"H"},{"x":3.031,"y":1.218,"z":0.0,"el":"H"},{"x":-0.191,"y":-2.428,"z":0.002,"el":"H"},{"x":3.811,"y":-0.592,"z":1.316,"el":"H"},{"x":3.66,"y":-2.351,"z":1.274,"el":"H"},{"x":2.475,"y":-1.385,"z":2.166,"el":"H"},{"x":2.474,"y":-1.386,"z":-2.166,"el":"H"},{"x":3.66,"y":-2.352,"z":-1.274,"el":"
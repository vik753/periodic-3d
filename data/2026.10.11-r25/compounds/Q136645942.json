{"version":"2026.10.11-r25","id":"Q136645942","formula":"C₁₄H₁₇N₃","hill":"C14H17N3","elements":["H","C","N"],"composition":{"C":14.0,"H":17.0,"N":3.0},"names":{"en":"(R)-70"},"descriptions":{"en":"(R)-70, or R-70, is a non-hallucinogenic selective serotonin 5-HT2 receptor moderate-efficacy partial agonist of the tetrahydropyridinylpyrrolopyridine family related to the psychedelic tryptamines. It shows preference for activation of the serotonin 5-HT2A receptor of about 6.4-fold relative to the serotonin 5-HT2B receptor and of about 30-fold relative to the serotonin 5-HT2C receptor. The drug is a biased agonist of the serotonin 5-HT2A receptor, activating Gq protein signaling more readily than β-arrestin2 signaling."},"fame":1,"pubchemCid":170328782,"mass":227.3,"charge":0,"smiles":"C[C@H]1CN(CC(=C1)C2=CNC3=C2C=CC=N3)C","inchikey":"BVUHRQDBEWGRFX-SNVBAGLBSA-N","iupac":"3-[(3R)-1,3-dimethyl-3,6-dihydro-2H-pyridin-5-yl]-1H-pyrrolo[2,3-b]pyridine","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"rdkit","ref":"170328782","atoms":34,"license":"Computed with RDKit from SMILES (PubChem, Wikidata)"},"structure":{"kind":"molecule","atoms":[{"x":-2.293,"y":2.444,"z":0.953,"el":"C"},{"x":-2.19,"y":0.925,"z":0.811,"el":"C"},{"x":-2.924,"y":0.459,"z":-0.47,"el":"C"},{"x":-2.608,"y":-0.916,"z":-0.887,"el":"N"},{"x":-1.152,"y":-1.051,"z":-1.111,"el":"C"},{"x":-0.266,"y":-0.414,"z":-0.052,"el":"C"},{"x":-0.747,"y":0.482,"z":0.83,"el":"C"},{"x":1.104,"y":-0.826,"z":-0.075,"el":"C"},{"x":1.539,"y":-2.133,"z":0.03,"el":"C"},{"x":2.91,"y":-2.124,"z":-0.016,"el":"N"},{"x":3.364,"y":-0.841,"z":-0.146,"el":"C"},{"x":2.26,"y":0.005,"z":-0.186,"el":"C"},{"x":2.514,"y":1.381,"z":-0.325,"el":"C"},{"x":3.845,"y":1.791,"z":-0.406,"el":"C"},{"x":4.85,"y":0.833,"z":-0.349,"el":"C"},{"x":4.664,"y":-0.5,"z":-0.219,"el":"N"},{"x":-3.096,"y":-1.91,"z":0.067,"el":"C"},{"x":-
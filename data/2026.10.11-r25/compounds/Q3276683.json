{"version":"2026.10.11-r25","id":"Q3276683","formula":"C₅H₁₀O₅","hill":"C5H10O5","elements":["H","C","O"],"composition":{"C":5.0,"H":10.0,"O":5.0},"names":{"en":"Apiose","ru":"Апиоза"},"descriptions":{"en":"Apiose is a branched-chain sugar found as residues in galacturonans-type pectins; that occurs in parsley and many other plants. Apiose is a component of cell wall polysaccharides. Apiose 1-reductase uses D-apiitol and NAD+ to produce apiitol-apiose, NADH, and H+.","ru":"Апио́за — является развлетвлённым моносахаридом, остатки которого участвуют в синтезе структуры галактоуроновой кислоты — образующей пектины. Этот синтез пектинов происходит, например в петрушке и во многих других растениях Входит в состав компонентов клеточной стенки растений (в составе рамногалактоуронана-II). Кристаллическое вещество, хорошо растворимое в воде."},"fame":12,"pubchemCid":null,"mass":null,"charge":0,"smiles":null,"inchikey":null,"iupac":null,"classes":[{"qid":"Q15711994","names":{"en":"group of isomeric entities","ru":"семейство химических соединений","uk":"родина хімічних сполук"}}],"structureInfo":null,"structure":null,"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q3276683","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Apiose","license":"CC BY-SA 4.0"},{"role":"description","name":"Wikipedia (ru)","url":"https://ru.wikipedia.org/wiki/%D0%90%D0%BF%D0%B8%D0%BE%D0%B7%D0%B0","license":"CC BY-SA 4.0"}],"similar":[{"id":"Q37525","formula":"C₆H₁₂O₆","names":{"en":"Glucose","ru":"Глюкоза","uk":"Глюкоза"},"elements":["H","C","O"],"fame":114,"kind":"molecule"},{"id":"Q66589593","formula":"C₆H₁₂O₆","names":{"en":"Galactose","ru":"Галактоза","uk":"Галактоза"},"elements":["H","C","O"],"fame":62,"kind":"molecule"},{"id":"Q407997","formula":"C₆H₁₂O₆","names":{"en":"Inositol","ru":"Инозитол","uk":"Інозитол"},"elements":["H","C","O"],"fame":44,"kind":"molecule"},{"id":"Q71240623","formula":"C₅H₁₀O₅",
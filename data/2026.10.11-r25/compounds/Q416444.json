{"version":"2026.10.11-r25","id":"Q416444","formula":"C₁₄H₁₅N₃O₅","hill":"C14H15N3O5","elements":["H","C","N","O"],"composition":{"C":14.0,"H":15.0,"N":3.0,"O":5.0},"names":{"en":"Entacapone"},"descriptions":{"en":"Entacapone, sold under the brand name Comtan among others, is a medication commonly used in combination with other medications for the treatment of Parkinson's disease. Entacapone together with levodopa and carbidopa allows levodopa to have a longer effect in the brain and reduces Parkinson's disease signs and symptoms for a greater length of time than levodopa and carbidopa therapy alone. Entacapone is a selective and reversible inhibitor of the enzyme catechol-O-methyltransferase (COMT)."},"fame":24,"pubchemCid":5281081,"mass":305.29,"charge":0,"smiles":"CCN(CC)C(=O)/C(=C/C1=CC(=C(C(=C1)O)O)[N+](=O)[O-])/C#N","inchikey":"JRURYQJSLYLRLN-BJMVGYQFSA-N","iupac":"(E)-2-cyano-3-(3,4-dihydroxy-5-nitrophenyl)-N,N-diethylprop-2-enamide","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"5281081","atoms":37,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":3.545,"y":-1.85,"z":0.589,"el":"O"},{"x":-3.568,"y":-2.86,"z":0.439,"el":"O"},{"x":-4.866,"y":-0.487,"z":-0.111,"el":"O"},{"x":-2.749,"y":2.986,"z":-0.251,"el":"O"},{"x":-4.674,"y":1.943,"z":-0.422,"el":"O"},{"x":3.78,"y":0.442,"z":0.23,"el":"N"},{"x":-3.437,"y":1.938,"z":-0.217,"el":"N"},{"x":1.022,"y":-1.069,"z":-2.603,"el":"N"},{"x":5.192,"y":0.445,"z":0.59,"el":"C"},{"x":3.232,"y":1.739,"z":-0.162,"el":"C"},{"x":3.069,"y":-0.759,"z":0.268,"el":"C"},{"x":6.073,"y":0.2,"z":-0.618,"el":"C"},{"x":2.667,"y":2.486,"z":1.029,"el":"C"},{"x":-0.783,"y":-0.515,"z":0.566,"el":"C"},{"x":1.63,"y":-0.707,"z":-0.117,"el":"C"},{"x":0.667,"y":-0.53,"z":0.806,"el":"C"},{"x":-1.416,"y":0.688,"z":0.291,"el":"C"},{"x":-1.494,"y":-1.705,"z":0.618,"el":"
{"version":"2026.10.11-r25","id":"Q15408403","formula":"C₁₅H₁₀BrFN₂O","hill":"C15H10BrFN2O","elements":["H","C","N","O","F","Br"],"composition":{"C":15.0,"F":1.0,"H":10.0,"N":2.0,"O":1.0,"Br":1.0},"names":{"en":"Flubromazepam"},"descriptions":{"en":"Flubromazepam is a benzodiazepine derivative which was first synthesized in 1960, but was never marketed and did not receive any further attention or study until late 2012 when it appeared on the grey market as a novel designer drug. It is a structural analog of phenazepam in which the chlorine atom has been replaced by a fluorine atom. An alternate isomer, 5-(2-bromophenyl)-7-fluoro-1,3-dihydro-2H-1,4-benzodiazepin-2-one or \"iso-flubromazepam\", may have been sold under the same name."},"fame":15,"pubchemCid":12947024,"mass":333.15,"charge":0,"smiles":"C1C(=O)NC2=C(C=C(C=C2)Br)C(=N1)C3=CC=CC=C3F","inchikey":"ZRKDDZBVSZLOFS-UHFFFAOYSA-N","iupac":"7-bromo-5-(2-fluorophenyl)-1,3-dihydro-1,4-benzodiazepin-2-one","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"12947024","atoms":30,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-1.521,"y":-4.34,"z":0.992,"el":"Br"},{"x":2.687,"y":1.573,"z":1.423,"el":"F"},{"x":-2.091,"y":3.704,"z":-0.732,"el":"O"},{"x":-2.411,"y":1.437,"z":-0.76,"el":"N"},{"x":0.243,"y":1.865,"z":0.617,"el":"N"},{"x":-0.896,"y":-0.288,"z":0.207,"el":"C"},{"x":0.289,"y":0.621,"z":0.28,"el":"C"},{"x":-2.111,"y":0.115,"z":-0.371,"el":"C"},{"x":1.628,"y":0.081,"z":-0.092,"el":"C"},{"x":-0.737,"y":-1.618,"z":0.63,"el":"C"},{"x":-1.028,"y":2.444,"z":0.994,"el":"C"},{"x":-3.105,"y":-0.847,"z":-0.612,"el":"C"},{"x":-1.861,"y":2.594,"z":-0.251,"el":"C"},{"x":-1.753,"y":-2.551,"z":0.428,"el":"C"},{"x":-2.929,"y":-2.17,"z":-0.208,"el":"C"},{"x":2.77,"y":0.595,"z":0.51,"el":"C"},{"x":1.717,"y":-0.932,"z":-1.038,"el":"C"},{"x":4.021,"y":0.
{"version":"2026.10.11-r25","id":"Q13423022","formula":"C₁₁H₁₅NO₂","hill":"C11H15NO2","elements":["H","C","N","O"],"composition":{"C":11.0,"H":15.0,"N":1.0,"O":2.0},"names":{"en":"1-methylamino-1-(3,4-methylenedioxyphenyl)propane"},"descriptions":{"en":"M-ALPHA, also known as 3,4-methylenedioxy-α-ethyl-N-methylbenzylamine or as α-ethyl-N-methylpiperonylamine, is a psychoactive drug of the substituted benzylamine group. It was reported by Alexander Shulgin in his book PIHKAL as a positional isomer of MDMA. Subsequently, the drug was encountered as a designer drug in the United Kingdom in 2010 and was reported to the EMCDDA new drug monitoring service. It was described by Shulgin as similar in action to its demethylated homologue, ALPHA, but with roughly twice the duration and twice the potency."},"fame":6,"pubchemCid":14647597,"mass":193.24,"charge":0,"smiles":"CCC(C1=CC2=C(C=C1)OCO2)NC","inchikey":"NLINVDHEDVEOMJ-UHFFFAOYSA-N","iupac":"1-(1,3-benzodioxol-5-yl)-N-methylpropan-1-amine","classes":[{"qid":"Q59199015","names":{"en":"group of stereoisomers","ru":"группа стереоизомеров","uk":"група стереоізомерів"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"14647597","atoms":29,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":2.368,"y":0.268,"z":-1.577,"el":"O"},{"x":3.301,"y":-0.053,"z":0.621,"el":"O"},{"x":-2.717,"y":-1.179,"z":-0.769,"el":"N"},{"x":-2.27,"y":-0.059,"z":0.087,"el":"C"},{"x":-0.788,"y":-0.063,"z":0.266,"el":"C"},{"x":-2.853,"y":1.255,"z":-0.5,"el":"C"},{"x":0.045,"y":0.12,"z":-0.841,"el":"C"},{"x":-0.243,"y":-0.25,"z":1.548,"el":"C"},{"x":1.407,"y":0.108,"z":-0.626,"el":"C"},{"x":1.941,"y":-0.075,"z":0.63,"el":"C"},{"x":-2.567,"y":2.466,"z":0.381,"el":"C"},{"x":1.141,"y":-0.257,"z":1.739,"el":"C"},{"x":-2.33,"y":-2.444,"z":-0.179,"el":"C"},{"x":3.565,"y":0.165,"z":-0.779,"el":"C"},{"x":-2.752,"y":-0.187,"z":1.067,"el":"H"},{"x":-2.46,"y":1.445,"z":-1.506,"el":"H"},{"x":-3.942,"y":1.158,"z":-0.6,"el":
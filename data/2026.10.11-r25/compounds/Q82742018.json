{"version":"2026.10.11-r25","id":"Q82742018","formula":"H₄CoGe","hill":"CoGeH4","elements":["H","Co","Ge"],"composition":{"H":4.0,"Co":1.0,"Ge":1.0},"names":{"en":"Cobalt monogermanide"},"descriptions":{"en":"Cobalt germanide (CoGe) is an intermetallic compound, a germanide of cobalt. Cubic CoGe crystals (space group P213, cP8, a = 0.4631 nm) can be produced by processing a mixture of Co and Ge powders at a pressure of 4 GPa and a temperature of 800–1000 °C for 1 to 3 hours. They have no inversion center, and are therefore helical, with right-hand and left-handed chiralities."},"fame":4,"pubchemCid":71354864,"mass":135.6,"charge":0,"smiles":"[Co].[GeH4]","inchikey":"NZQLLOQSPPIDOS-UHFFFAOYSA-N","iupac":"cobalt;germane","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"rdkit","ref":"71354864","atoms":6,"license":"Computed with RDKit from SMILES (PubChem, Wikidata)"},"structure":{"kind":"molecule","atoms":[{"x":-0.438,"y":-0.168,"z":-0.116,"el":"Ge"},{"x":0.769,"y":-0.553,"z":-1.009,"el":"H"},{"x":-0.906,"y":1.267,"z":-0.47,"el":"H"},{"x":-1.6,"y":-1.165,"z":-0.359,"el":"H"},{"x":-0.015,"y":-0.221,"z":1.374,"el":"H"},{"x":2.191,"y":0.84,"z":0.579,"el":"Co"}],"bonds":[[0,1,1.0],[0,2,1.0],[0,3,1.0],[0,4,1.0]]},"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q82742018","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Cobalt_germanide","license":"CC BY-SA 4.0"},{"role":"properties","name":"PubChem","url":"https://pubchem.ncbi.nlm.nih.gov/compound/71354864","license":"PubChem (NIH), public data"},{"role":"structure","name":"RDKit","url":null,"license":"Computed with RDKit from SMILES (PubChem, Wikidata)"}],"similar":[{"id":"Q21663017","formula":"H₂₁Ga₇Rb","names":{"ru":"Рубидийгептагаллий"},"elements":["H","Ga","Rb"],"fame":1,"kind":"molecule"},{"id":"Q516
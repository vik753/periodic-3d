{"version":"2026.10.11-r25","id":"Q21099645","formula":"CH₆B₂","hill":"CH6B2","elements":["H","B","C"],"composition":{"B":2.0,"C":1.0,"H":6.0},"names":{"en":"Methyldiborane"},"descriptions":{"en":"Methyldiborane, CH3B2H5, or monomethyldiborane is the simplest of alkyldiboranes, consisting of a methyl group substituted for a hydrogen in diborane. As with other boranes it exists in the form of a dimer with a twin hydrogen bridge that uses three-center two-electron bonding between the two boron atoms, and can be imagined as methyl borane (CH3BH2) bound to borane (BH3). Other combinations of methylation occur on diborane, including 1,1-dimethylborane, 1,2-dimethyldiborane, trimethyldiborane, tetramethyldiborane, and trimethylborane (which is not a dimer)."},"fame":4,"pubchemCid":18380882,"mass":36.66,"charge":0,"smiles":"[B][B]C","inchikey":"ODJSSQUKXSECTC-UHFFFAOYSA-N","iupac":null,"classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":null,"structure":null,"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q21099645","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Methyldiborane","license":"CC BY-SA 4.0"},{"role":"properties","name":"PubChem","url":"https://pubchem.ncbi.nlm.nih.gov/compound/18380882","license":"PubChem (NIH), public data"}],"similar":[{"id":"Q25323738","formula":"C₂H₁₀B₂","names":{"en":"1,2-dimethyldiborane"},"elements":["H","B","C"],"fame":4,"kind":null},{"id":"Q48997405","formula":"C₂H₁₀B₂","names":{"en":"1,1-dimethyldiborane"},"elements":["H","B","C"],"fame":3,"kind":null},{"id":"Q407684","formula":"B₂H₆","names":{"en":"Diborane(6)","ru":"Диборан","uk":"Диборан"},"elements":["H","B"],"fame":32,"kind":null},{"id":"Q15634214","formula":"BH₃","names":{"en":"Borane","ru":"Боран"},"elements":["H","B"],"fame":20,"kind":"molecule"},{"id":"Q55647673","formula":"CH₃BO","names
{"version":"2026.10.11-r25","id":"Q6120732","formula":"C₉H₁₇NO","hill":"C9H17NO","elements":["H","C","N","O"],"composition":{"C":9.0,"H":17.0,"N":1.0,"O":1.0},"names":{"en":"Triacetonamine"},"descriptions":{"en":"Triacetonamine is an organic compound with the formula OC(CH2CMe2)2NH (where Me = CH3). It is a colorless or white solid that melts near room temperature. The compound is an intermediate in the preparation of 2,2,6,6-tetramethylpiperidine, a sterically hindered base and precursor to the reagent called TEMPO. Triacetonamine is formed by the poly-aldol condensation of acetone in the presence of ammonia and calcium chloride: 3 (CH3)2CO + NH3 → OC(CH2CMe2)2NH + 2 H2O Reductive amination of triacetonamine gives 4-amino-2,2,6,6-tetramethylpiperidine."},"fame":10,"pubchemCid":13220,"mass":155.24,"charge":0,"smiles":"CC1(CC(=O)CC(N1)(C)C)C","inchikey":"JWUXJYZVKZKLTJ-UHFFFAOYSA-N","iupac":"2,2,6,6-tetramethylpiperidin-4-one","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"13220","atoms":28,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-0.001,"y":2.751,"z":0.23,"el":"O"},{"x":0.0,"y":-1.253,"z":-0.293,"el":"N"},{"x":-1.267,"y":-0.546,"z":-0.019,"el":"C"},{"x":1.268,"y":-0.545,"z":-0.019,"el":"C"},{"x":-1.275,"y":0.886,"z":-0.579,"el":"C"},{"x":1.274,"y":0.886,"z":-0.579,"el":"C"},{"x":0.0,"y":1.61,"z":-0.227,"el":"C"},{"x":-2.375,"y":-1.349,"z":-0.737,"el":"C"},{"x":-1.615,"y":-0.547,"z":1.48,"el":"C"},{"x":2.376,"y":-1.348,"z":-0.737,"el":"C"},{"x":1.616,"y":-0.546,"z":1.48,"el":"C"},{"x":0.001,"y":-2.166,"z":0.161,"el":"H"},{"x":-2.128,"y":1.455,"z":-0.191,"el":"H"},{"x":-1.348,"y":0.886,"z":-1.674,"el":"H"},{"x":1.347,"y":0.887,"z":-1.674,"el":"H"},{"x":2.127,"y":1.456,"z":-0.191,"el":"H"},{"x":-3.355,"y":-0.874,"z":-0.609,"el":"H"},{"x":-2.183,"y":-1.42,"z":-1.814,"el":"H"},{"x":
{"version":"2026.10.11-r25","id":"Q83071851","formula":"C₁₂H₁₄N₂","hill":"C12H14N2","elements":["H","C","N"],"composition":{"C":12.0,"H":14.0,"N":2.0},"names":{"en":"1H-Pyrido(4,3-b)indole, 2,3,4,5-tetrahydro-2-methyl-"},"descriptions":{"en":"2MePI, also known as 2-methyl-2,3,4,5-tetrahydro-1H-pyrido[4,3-b]indole, is a serotonin receptor modulator of the pyridoindole (γ-carboline) family. It is the pyridoindole homologue of the ibogalog (azepinoindole) ibogaminalog (DM-506). The drug acts as a weak partial agonist or functional competitive antagonist of the serotonin 5-HT2A receptor, with an affinity (Ki) of 95 nM, an EC50Tooltip half-maximal effective concentration (EmaxTooltip maximal efficacy) of 533 nM (32%), an apparent IC50Tooltip half-maximal inhibitory concentration of 3,100 to 18,000 nM, and a KB of 89 to 228 nM."},"fame":1,"pubchemCid":97424,"mass":186.25,"charge":0,"smiles":"CN1CCC2=C(C1)C3=CC=CC=C3N2","inchikey":"FYHWPFXPFFPQRT-UHFFFAOYSA-N","iupac":"2-methyl-1,3,4,5-tetrahydropyrido[4,3-b]indole","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"97424","atoms":28,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-2.84,"y":0.587,"z":-0.326,"el":"N"},{"x":0.525,"y":-1.75,"z":-0.058,"el":"N"},{"x":-0.46,"y":0.247,"z":0.048,"el":"C"},{"x":-0.678,"y":-1.112,"z":-0.003,"el":"C"},{"x":-2.012,"y":-1.758,"z":-0.028,"el":"C"},{"x":-1.583,"y":1.226,"z":0.136,"el":"C"},{"x":-3.086,"y":-0.711,"z":0.346,"el":"C"},{"x":0.948,"y":0.449,"z":0.032,"el":"C"},{"x":1.541,"y":-0.818,"z":-0.037,"el":"C"},{"x":-3.969,"y":1.494,"z":-0.116,"el":"C"},{"x":1.782,"y":1.585,"z":0.071,"el":"C"},{"x":2.929,"y":-0.999,"z":-0.071,"el":"C"},{"x":3.171,"y":1.416,"z":0.038,"el":"C"},{"x":3.733,"y":0.143,"z":-0.032,"el":"C"},{"x":-2.207,"y":-2.141,"z":-1.037,"el":"H"},{"x":-2.055,"y":-2.601,"z":0.669,"el":"H"},{"x
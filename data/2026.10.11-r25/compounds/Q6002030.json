{"version":"2026.10.11-r25","id":"Q6002030","formula":"C₉H₁₉NO₂","hill":"C9H19NO2","elements":["H","C","N","O"],"composition":{"C":9.0,"H":19.0,"N":1.0,"O":2.0},"names":{"en":"Imagabalin"},"descriptions":{"en":"Imagabalin (INNTooltip International Nonproprietary Name, USANTooltip United States Adopted Name; developmental code name PD-0332334) was an investigational drug that acts as a ligand for the α2δ subunit of the voltage-dependent calcium channel, with some selectivity for the α2δ1 subunit over α2δ2. It was under development by Pfizer as a pharmaceutical medication due to its hypothesized anxiolytic, analgesic, hypnotic, and anticonvulsant-like activity. It reached phase-III clinical trials for treatment of generalized anxiety disorder; however, the trials were terminated by the manufacturer."},"fame":4,"pubchemCid":10236037,"mass":173.25,"charge":0,"smiles":"CCC[C@@H](C)C[C@@H](CC(=O)O)N","inchikey":"JXEHXYFSIOYTAH-SFYZADRCSA-N","iupac":"(3S,5R)-3-amino-5-methyloctanoic acid","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"10236037","atoms":31,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-3.268,"y":1.91,"z":-0.201,"el":"O"},{"x":-2.706,"y":0.462,"z":1.464,"el":"O"},{"x":-0.666,"y":-1.873,"z":-1.594,"el":"N"},{"x":1.466,"y":-0.917,"z":0.285,"el":"C"},{"x":0.165,"y":-0.138,"z":-0.035,"el":"C"},{"x":-1.038,"y":-0.994,"z":-0.485,"el":"C"},{"x":2.648,"y":0.034,"z":0.568,"el":"C"},{"x":1.196,"y":-1.857,"z":1.468,"el":"C"},{"x":3.001,"y":0.949,"z":-0.608,"el":"C"},{"x":-2.258,"y":-0.131,"z":-0.844,"el":"C"},{"x":4.217,"y":1.809,"z":-0.296,"el":"C"},{"x":-2.759,"y":0.748,"z":0.277,"el":"C"},{"x":1.746,"y":-1.532,"z":-0.578,"el":"H"},{"x":-0.108,"y":0.46,"z":0.843,"el":"H"},{"x":0.361,"y":0.577,"z":-0.841,"el":"H"},{"x":-1.332,"y":-1.636,"z":0.353,"el":"H"},{"x":2.419,"y":0.647,"z":1.4
{"version":"2026.10.11-r25","id":"Q83025876","formula":"C₁₁H₁₆N₂","hill":"C11H16N2","elements":["H","C","N"],"composition":{"C":11.0,"H":16.0,"N":2.0},"names":{"en":"6-methylnicotine"},"descriptions":{"en":"6-Methylnicotine (6-MN) is a nicotine analogue in which a methyl group is added at the 6-position of the pyridine ring. It has been identified in certain electronic cigarettes and oral pouch products marketed as nicotine alternatives, sometimes under the trade names Metatine (in disposables) and Nixodine-S (sold as a benzoate salt or free base). Studies in cells, animal models, and early human biomonitoring indicate higher activity at nicotinic acetylcholine receptors and differences in toxicity and metabolism compared with nicotine."},"fame":4,"pubchemCid":25768196,"mass":176.26,"charge":0,"smiles":"CC1=NC=C(C=C1)[C@@H]2CCCN2C","inchikey":"SWNIAVIKMKSDBJ-NSHDSACASA-N","iupac":"2-methyl-5-[(2S)-1-methylpyrrolidin-2-yl]pyridine","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"25768196","atoms":29,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-2.054,"y":-0.627,"z":0.547,"el":"N"},{"x":2.473,"y":-0.692,"z":-0.864,"el":"N"},{"x":-1.274,"y":-0.153,"z":-0.614,"el":"C"},{"x":-1.905,"y":1.203,"z":-0.981,"el":"C"},{"x":-3.066,"y":1.377,"z":-0.012,"el":"C"},{"x":-3.387,"y":-0.04,"z":0.417,"el":"C"},{"x":0.207,"y":-0.049,"z":-0.318,"el":"C"},{"x":-2.102,"y":-2.08,"z":0.652,"el":"C"},{"x":0.675,"y":0.745,"z":0.724,"el":"C"},{"x":1.138,"y":-0.741,"z":-1.075,"el":"C"},{"x":2.041,"y":0.821,"z":0.972,"el":"C"},{"x":2.89,"y":0.09,"z":0.157,"el":"C"},{"x":4.363,"y":0.148,"z":0.394,"el":"C"},{"x":-1.429,"y":-0.825,"z":-1.471,"el":"H"},{"x":-2.293,"y":1.158,"z":-2.006,"el":"H"},{"x":-1.22,"y":2.056,"z":-0.929,"el":"H"},{"x":-2.745,"y":1.975,"z":0.85,"el":"H"},{"x":-3.92,"y":1.879,"z":-0.476,"el":"H"}
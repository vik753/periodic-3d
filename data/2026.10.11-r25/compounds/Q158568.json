{"version":"2026.10.11-r25","id":"Q158568","formula":"C₉H₇MnO₃","hill":"C9H7MnO3","elements":["H","C","O","Mn"],"composition":{"C":9.0,"H":7.0,"O":3.0,"Mn":1.0},"names":{"en":"Methylcyclopentadienyl manganese tricarbonyl"},"descriptions":{"en":"Methylcyclopentadienyl manganese tricarbonyl (MMT or MCMT) is an organomanganese compound with the formula (C5H4CH3)Mn(CO)3. Initially marketed as a supplement for use in leaded gasoline, MMT was later used in unleaded gasoline to increase the octane rating. Following the implementation of the Clean Air Act (United States) (CAA) in 1970, MMT continued to be used alongside tetraethyl lead (TEL) in the US as leaded gasoline was phased out (prior to TEL finally being banned from US gasoline in 1995), and was also used in unleaded gasoline until 1977."},"fame":12,"pubchemCid":25511,"mass":218.09,"charge":0,"smiles":"CC1=C[CH-]C=C1.[C-]#[O+].[C-]#[O+].[C-]#[O+].[Mn]","inchikey":"IYSGJCJSRBFZSZ-UHFFFAOYSA-N","iupac":"carbon monoxide;manganese;2-methylcyclopenta-1,3-diene","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"rdkit","ref":"25511","atoms":20,"license":"Computed with RDKit from SMILES (PubChem, Wikidata)"},"structure":{"kind":"molecule","atoms":[{"x":1.721,"y":-0.479,"z":0.06,"el":"C"},{"x":3.204,"y":-0.419,"z":0.033,"el":"C"},{"x":4.083,"y":-1.412,"z":0.247,"el":"C"},{"x":5.392,"y":-0.829,"z":0.104,"el":"C"},{"x":5.25,"y":0.57,"z":-0.207,"el":"C"},{"x":3.931,"y":0.812,"z":-0.249,"el":"C"},{"x":1.306,"y":-0.19,"z":-0.911,"el":"H"},{"x":1.322,"y":0.197,"z":0.823,"el":"H"},{"x":1.367,"y":-1.489,"z":0.289,"el":"H"},{"x":3.874,"y":-2.443,"z":0.479,"el":"H"},{"x":6.326,"y":-1.354,"z":0.213,"el":"H"},{"x":6.054,"y":1.268,"z":-0.37,"el":"H"},{"x":3.464,"y":1.763,"z":-0.457,"el":"H"},{"x":-1.142,"y":-0.019,"z":0.03,"el":"C"},{"x":-2.27,"y":-0.019,"z":0.03,"el":"O"},{"x":-5.133,"y":0.441,"z":0.0,"el":"C"
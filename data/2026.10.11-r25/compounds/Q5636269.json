{"version":"2026.10.11-r25","id":"Q5636269","formula":"C₈H₁₁NO₅","hill":"C8H11NO5","elements":["H","C","N","O"],"composition":{"C":8.0,"H":11.0,"N":1.0,"O":5.0},"names":{"en":"HYDIA"},"descriptions":{"en":"HYDIA is a drug that is used in neuroscience research, which acts as a potent and selective antagonist for the group II metabotropic glutamate receptors (mGluR2/3). It has been useful in the mapping of the group II mGluR receptor proteins and their molecular modeling. HYDIA is similar in structure to group II mGluR agonists such as eglumetad and pomaglumetad, but the addition of the 3-hydroxy group reverses the activity to a competitive antagonist."},"fame":4,"pubchemCid":9794223,"mass":201.18,"charge":0,"smiles":"C1[C@H]2[C@@H]([C@H]2[C@@]([C@@H]1O)(C(=O)O)N)C(=O)O","inchikey":"NTPXNEQCDPWJQA-AZDHXYLBSA-N","iupac":"(1S,2R,3R,5R,6S)-2-amino-3-hydroxybicyclo[3.1.0]hexane-2,6-dicarboxylic acid","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"9794223","atoms":25,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":2.059,"y":-1.567,"z":-1.026,"el":"O"},{"x":-3.817,"y":0.564,"z":0.923,"el":"O"},{"x":-3.251,"y":0.597,"z":-1.27,"el":"O"},{"x":3.28,"y":0.96,"z":0.418,"el":"O"},{"x":1.875,"y":1.833,"z":-1.13,"el":"O"},{"x":0.96,"y":0.523,"z":1.814,"el":"N"},{"x":-0.304,"y":0.246,"z":-0.275,"el":"C"},{"x":-0.866,"y":-1.142,"z":-0.416,"el":"C"},{"x":-1.618,"y":-0.117,"z":0.377,"el":"C"},{"x":1.047,"y":0.136,"z":0.406,"el":"C"},{"x":0.084,"y":-2.109,"z":0.238,"el":"C"},{"x":1.424,"y":-1.356,"z":0.237,"el":"C"},{"x":-2.94,"y":0.373,"z":-0.102,"el":"C"},{"x":2.067,"y":1.059,"z":-0.195,"el":"C"},{"x":-0.333,"y":0.876,"z":-1.154,"el":"H"},{"x":-1.213,"y":-1.451,"z":-1.392,"el":"H"},{"x":-1.603,"y":-0.259,"z":1.455,"el":"H"},{"x":-0.242,"y":-2.327,"z":1.261,"el":"H"},{"x":0.133,"y":-3.046,"z":-0.325,"el":
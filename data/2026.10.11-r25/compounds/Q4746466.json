{"version":"2026.10.11-r25","id":"Q4746466","formula":"C₂H₅NO₃","hill":"C2H5NO3","elements":["H","C","N","O"],"composition":{"C":2.0,"H":5.0,"N":1.0,"O":3.0},"names":{"en":"Aminooxyacetic acid"},"descriptions":{"en":"Aminooxyacetic acid, often abbreviated AOA or AOAA, is a compound that inhibits 4-aminobutyrate aminotransferase (GABA-T) activity in vitro and in vivo, leading to less gamma-aminobutyric acid (GABA) being broken down. Subsequently, the level of GABA is increased in tissues. At concentrations high enough to fully inhibit 4-aminobutyrate aminotransferase activity, aminooxyacetic acid is indicated as a useful tool to study regional GABA turnover in rats."},"fame":9,"pubchemCid":286,"mass":91.07,"charge":0,"smiles":"C(C(=O)O)ON","inchikey":"NQRKYASMKDDGHT-UHFFFAOYSA-N","iupac":"2-aminooxyacetic acid","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"286","atoms":11,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":1.324,"y":-0.432,"z":0.01,"el":"O"},{"x":-1.986,"y":0.919,"z":0.008,"el":"O"},{"x":-1.27,"y":-1.243,"z":-0.003,"el":"O"},{"x":2.627,"y":0.22,"z":0.0,"el":"N"},{"x":0.337,"y":0.58,"z":-0.012,"el":"C"},{"x":-1.031,"y":-0.045,"z":-0.003,"el":"C"},{"x":0.434,"y":1.211,"z":0.878,"el":"H"},{"x":0.436,"y":1.178,"z":-0.925,"el":"H"},{"x":3.054,"y":-0.232,"z":-0.807,"el":"H"},{"x":3.05,"y":-0.2,"z":0.826,"el":"H"},{"x":-2.89,"y":0.539,"z":0.014,"el":"H"}],"bonds":[[0,3,1],[0,4,1],[1,5,1],[1,10,1],[2,5,2],[3,8,1],[3,9,1],[4,5,1],[4,6,1],[4,7,1]]},"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q4746466","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Aminooxyacetic_acid","license":"CC BY-SA 4.0"},{"role":"properties","name":"PubChem","url":"https://pubchem.ncbi.nlm.nih.gov/compound/286","
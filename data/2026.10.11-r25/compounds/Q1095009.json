{"version":"2026.10.11-r25","id":"Q1095009","formula":"C₉H₁₆N₂O₂","hill":"C9H16N2O2","elements":["H","C","N","O"],"composition":{"C":9.0,"H":16.0,"N":2.0,"O":2.0},"names":{"en":"Apronal"},"descriptions":{"en":"Apronal (brand name Sedormid), or apronalide, also known as allylisopropylacetylurea or allylisopropylacetylcarbamide, is a hypnotic/sedative drug of the ureide (acylurea) group synthesized in 1926 by Hoffmann-La Roche. Though it is not a barbiturate, apronal is similar in structure to the barbiturates (being an open-chain carbamide instead of having a heterocyclic ring). In accordance, it is similar in action to the barbiturates, although considerably milder in comparison (formerly used as a daytime sedative at doses of 1 to 2 grams every 3 to 4 hours)."},"fame":10,"pubchemCid":10715,"mass":184.24,"charge":0,"smiles":"CC(C)C(CC=C)C(=O)NC(=O)N","inchikey":"KSUUMAWCGDNLFK-UHFFFAOYSA-N","iupac":"N-carbamoyl-2-propan-2-ylpent-4-enamide","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"10715","atoms":29,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-0.374,"y":-0.743,"z":-1.245,"el":"O"},{"x":-3.152,"y":-0.539,"z":-0.872,"el":"O"},{"x":-1.476,"y":0.301,"z":0.521,"el":"N"},{"x":-3.697,"y":0.601,"z":1.047,"el":"N"},{"x":0.961,"y":0.329,"z":0.485,"el":"C"},{"x":1.304,"y":1.779,"z":0.036,"el":"C"},{"x":2.095,"y":-0.686,"z":0.229,"el":"C"},{"x":1.455,"y":1.928,"z":-1.481,"el":"C"},{"x":2.562,"y":2.302,"z":0.738,"el":"C"},{"x":-0.347,"y":-0.114,"z":-0.189,"el":"C"},{"x":1.728,"y":-2.071,"z":0.69,"el":"C"},{"x":1.74,"y":-3.152,"z":-0.098,"el":"C"},{"x":-2.8,"y":0.066,"z":0.139,"el":"C"},{"x":0.784,"y":0.35,"z":1.57,"el":"H"},{"x":0.47,"y":2.426,"z":0.34,"el":"H"},{"x":2.36,"y":-0.706,"z":-0.834,"el":"H"},{"x":2.996,"y":-0.39,"z":0.778,"el":"H"},{"x":1.677,"y":2.97,"z":-1.739,"el":"H"},{"x":
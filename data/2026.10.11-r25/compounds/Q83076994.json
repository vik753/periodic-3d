{"version":"2026.10.11-r25","id":"Q83076994","formula":"C₁₅H₁₃ClN₂O₂","hill":"C15H13ClN2O2","elements":["H","C","N","O","Cl"],"composition":{"C":15.0,"H":13.0,"N":2.0,"O":2.0,"Cl":1.0},"names":{"en":"Noravizafone desglycyl"},"descriptions":{"en":"Noravizafone desglycyl is a chemical compound that can act as both a prodrug and a synthetic precursor for the benzodiazepine derivative nordiazepam, as well as forming as a breakdown product of nordiazepam during storage under certain conditions. It is inactive in vitro but has similar effects to nordiazepam in vivo due to metabolic conversion to the active benzodiazepine form. It has been detected as a designer drug, first being identified in Germany in September 2024."},"fame":1,"pubchemCid":3014364,"mass":288.73,"charge":0,"smiles":"C1=CC=C(C=C1)C(=O)C2=C(C=CC(=C2)Cl)NC(=O)CN","inchikey":"GIBRATRQHFFRHE-UHFFFAOYSA-N","iupac":"2-amino-N-(2-benzoyl-4-chlorophenyl)acetamide","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"3014364","atoms":33,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-0.894,"y":-4.45,"z":-0.157,"el":"Cl"},{"x":-0.175,"y":1.581,"z":-1.22,"el":"O"},{"x":4.247,"y":-0.01,"z":0.45,"el":"O"},{"x":2.052,"y":0.67,"z":-0.05,"el":"N"},{"x":5.201,"y":2.501,"z":0.407,"el":"N"},{"x":-0.011,"y":-0.58,"z":-0.34,"el":"C"},{"x":1.339,"y":-0.532,"z":-0.079,"el":"C"},{"x":-0.767,"y":0.681,"z":-0.606,"el":"C"},{"x":-2.143,"y":0.871,"z":-0.174,"el":"C"},{"x":-0.721,"y":-1.76,"z":-0.37,"el":"C"},{"x":2.017,"y":-1.726,"z":0.165,"el":"C"},{"x":-0.043,"y":-2.955,"z":-0.126,"el":"C"},{"x":1.326,"y":-2.938,"z":0.141,"el":"C"},{"x":-2.804,"y":-0.145,"z":0.517,"el":"C"},{"x":-2.801,"y":2.07,"z":-0.45,"el":"C"},{"x":3.421,"y":0.861,"z":0.202,"el":"C"},{"x":3.78,"y":2.336,"z":0.136,"el":"C"},{"x":-4.123,"y":0.037,"z":0.931,"el":"C"},{"x":-4.121,"y":2.
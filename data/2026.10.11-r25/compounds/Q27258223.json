{"version":"2026.10.11-r25","id":"Q27258223","formula":"C₂₈H₃₂ClO₅P","hill":"C28H32ClO5P","elements":["H","C","O","P","Cl"],"composition":{"C":28.0,"H":32.0,"O":5.0,"P":1.0,"Cl":1.0},"names":{"en":"MB-07811"},"descriptions":{"en":"VK2809 (formerly known as MB07811) is a thyromimetic prodrug whose active form is selective for the THR-β isoform. It is being developed by Viking Therapeutics in a phase II trial for the treatment of nonalcoholic steatohepatitis and is also being investigated for glycogen storage disease type Ia. In 2023, Viking Therapeutics filed a lawsuit against the developer of ASC41, Chinese company Ascletis BioScience, accusing it of stealing Viking's trade secrets to develop ASC41 which is allegedly similar to, or identical to, VK2809."},"fame":1,"pubchemCid":15942005,"mass":515.0,"charge":0,"smiles":"CC1=CC(=CC(=C1CC2=CC(=C(C=C2)O)C(C)C)C)OC[P@@]3(=O)OCC[C@H](O3)C4=CC(=CC=C4)Cl","inchikey":"LGGPZDRLTDGYSQ-JADSYQMUSA-N","iupac":"4-[[4-[[(2R,4S)-4-(3-chlorophenyl)-2-oxo-1,3,2lambda5-dioxaphosphinan-2-yl]methoxy]-2,6-dimethylphenyl]methyl]-2-propan-2-ylphenol","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"15942005","atoms":67,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-2.606,"y":4.323,"z":0.164,"el":"Cl"},{"x":-3.702,"y":-2.323,"z":0.194,"el":"P"},{"x":-3.874,"y":-0.742,"z":-0.111,"el":"O"},{"x":-4.48,"y":-2.5,"z":1.603,"el":"O"},{"x":-1.305,"y":-2.144,"z":-0.562,"el":"O"},{"x":-4.163,"y":-3.234,"z":-0.905,"el":"O"},{"x":6.529,"y":3.154,"z":-0.255,"el":"O"},{"x":-5.195,"y":-0.203,"z":-0.029,"el":"C"},{"x":-5.781,"y":-0.475,"z":1.366,"el":"C"},{"x":-5.798,"y":-1.969,"z":1.681,"el":"C"},{"x":-5.148,"y":1.274,"z":-0.341,"el":"C"},{"x":-1.988,"y":-2.481,"z":0.636,"el":"C"},{"x":2.841,"y":-2.071,"z":-0.385,"el":"C"},{"x":4.335,"y":-2.045,"z":-0.322,"el":"C"},{"x":4.92
{"version":"2026.10.11-r25","id":"Q4917168","formula":"C₁₉H₁₆O₄","hill":"C19H16O4","elements":["H","C","O"],"composition":{"C":19.0,"H":16.0,"O":4.0},"names":{"en":"Bisdemethoxycurcumin"},"descriptions":{"en":"Bisdemethoxycurcumin is a curcuminoid found (along with the curcuminoids curcumin and demethoxycurcumin) in turmeric (Curcuma longa), but absent in Javanese turmeric (Curcuma xanthorrhiza). Bisdemethoxycurcumin is used as a pigment and nutraceutical with antimutagenic properties. All three of the curcuminoids found in Curcuma longa have been shown to have antioxidant properties, but bisdemethoxycurcumin is more resistant than the others to alkaline degradation."},"fame":4,"pubchemCid":5315472,"mass":308.3,"charge":0,"smiles":"C1=CC(=CC=C1/C=C/C(=O)CC(=O)/C=C/C2=CC=C(C=C2)O)O","inchikey":"PREBVFJICNPEKM-YDWXAUTNSA-N","iupac":"(1E,6E)-1,7-bis(4-hydroxyphenyl)hepta-1,6-diene-3,5-dione","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"5315472","atoms":39,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-1.109,"y":1.774,"z":-0.969,"el":"O"},{"x":1.125,"y":1.806,"z":0.981,"el":"O"},{"x":-8.832,"y":-1.299,"z":0.397,"el":"O"},{"x":8.82,"y":-1.315,"z":-0.433,"el":"O"},{"x":-0.001,"y":-0.11,"z":0.047,"el":"C"},{"x":-5.025,"y":0.175,"z":-0.239,"el":"C"},{"x":5.027,"y":0.182,"z":0.23,"el":"C"},{"x":-1.209,"y":0.693,"z":-0.394,"el":"C"},{"x":1.214,"y":0.707,"z":0.439,"el":"C"},{"x":-3.667,"y":0.701,"z":-0.466,"el":"C"},{"x":3.674,"y":0.716,"z":0.466,"el":"C"},{"x":-2.537,"y":0.066,"z":-0.126,"el":"C"},{"x":2.538,"y":0.071,"z":0.168,"el":"C"},{"x":-5.201,"y":-1.184,"z":-0.035,"el":"C"},{"x":5.198,"y":-1.183,"z":0.066,"el":"C"},{"x":-6.099,"y":1.05,"z":-0.235,"el":"C"},{"x":6.101,"y":1.055,"z":0.176,"el":"C"},{"x":-6.486,"y":-1.682,"z":0.18,"el":"C"},{"x":6.479,"y":-1.688,"z":-0.158,"el":"C"},{"x
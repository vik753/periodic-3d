{"version":"2026.10.11-r25","id":"Q7391026","formula":"C₂₂H₂₃ClF₃N₃O₃","hill":"C22H23ClF3N3O3","elements":["H","C","N","O","F","Cl"],"composition":{"C":22.0,"F":3.0,"H":23.0,"N":3.0,"O":3.0,"Cl":1.0},"names":{"en":"SM-130,686"},"descriptions":{"en":"SM-130686 is a small-molecule drug which acts as a potent, orally-active agonist of the ghrelin/growth hormone secretagogue receptor (GHSR) and growth hormone secretagogue, with around half the potency of the endogenous agonist ghrelin as a stimulator of growth hormone release. It produces dose-dependent increases in muscle mass and decrease in body fat, and is under investigation for the treatment of growth hormone deficiency and other medical conditions. Concerns about its potential use as a performance-enhancing drug for athletes have led to the development of urine tests for SM-130686 and other GHSR agonists, even though no drugs from this class have yet progressed to clinical use."},"fame":3,"pubchemCid":9890863,"mass":469.9,"charge":0,"smiles":"CCN(CC)CCN1C2=CC(=CC(=C2C(C1=O)(C3=CC=CC=C3Cl)O)C(F)(F)F)C(=O)N","inchikey":"YSSPGXCFFITNCE-UHFFFAOYSA-N","iupac":"3-(2-chlorophenyl)-1-[2-(diethylamino)ethyl]-3-hydroxy-2-oxo-4-(trifluoromethyl)indole-6-carboxamide","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"9890863","atoms":55,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-0.832,"y":-1.234,"z":2.285,"el":"Cl"},{"x":-3.602,"y":2.725,"z":-0.984,"el":"F"},{"x":-3.038,"y":1.081,"z":-2.28,"el":"F"},{"x":-3.79,"y":0.676,"z":-0.28,"el":"F"},{"x":-1.315,"y":-1.073,"z":-2.172,"el":"O"},{"x":0.425,"y":-2.915,"z":-0.656,"el":"O"},{"x":0.099,"y":5.139,"z":0.956,"el":"O"},{"x":1.095,"y":-0.777,"z":0.085,"el":"N"},{"x":4.811,"y":-0.93,"z":-0.081,"el":"N"},{"x":2.083,"y":4.119,"z":1.485,"el":"N"},{"x":-1.105,"y":-0.992,"z":-0.776,"el":"C"},{"x":-0.79
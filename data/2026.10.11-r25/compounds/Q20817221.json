{"version":"2026.10.11-r25","id":"Q20817221","formula":"H₉AlMgO₁₅Si₄","hill":"AlH9MgO15Si4","elements":["H","O","Mg","Al","Si"],"composition":{"H":9.0,"O":15.0,"Al":1.0,"Mg":1.0,"Si":4.0},"names":{"en":"Attapulgite"},"descriptions":{"en":"Palygorskite or attapulgite is a magnesium aluminium phyllosilicate with the chemical formula (Mg,Al)2Si4O10(OH)·4(H2O) that occurs in a type of clay soil common to the Southeastern United States. It is one of the types of fuller's earth and commonly occurs as a fibrous clay mineral. Some smaller deposits of this mineral can be found in Mexico, where its use is tied to the manufacture of Maya blue in pre-Columbian times."},"fame":2,"pubchemCid":73415752,"mass":412.69,"charge":0,"smiles":"O.O.O.O.[OH-].[O-2].[O-2].[O-2].[O-2].[O-2].[O-2].[O-2].[O-2].[O-2].[O-2].[Mg+2].[Al+3].[Si+4].[Si+4].[Si+4].[Si+4]","inchikey":"IXWIAFSBWGYQOE-UHFFFAOYSA-M","iupac":"aluminum;magnesium;decakis(oxygen(2-));tetrakis(silicon(4+));hydroxide;tetrahydrate","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":null,"structure":null,"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q20817221","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Attapulgite","license":"CC BY-SA 4.0"},{"role":"properties","name":"PubChem","url":"https://pubchem.ncbi.nlm.nih.gov/compound/73415752","license":"PubChem (NIH), public data"}],"similar":[{"id":"Q410972","formula":"Ba(Si₃Al₂)O₁₀·4H₂O","names":{"en":"Edingtonite","uk":"Едінгтоніт"},"elements":["H","O","Al","Si","Ba"],"fame":13,"kind":null},{"id":"Q3758427","formula":"Ca₃(Al₆Si₁₀O₃₂)·14H₂O","names":{"en":"Garronite-Ca","uk":"Гароніт"},"elements":["H","O","Al","Si","Ca"],"fame":7,"kind":null},{"id":"Q3881055","formula":"KCaMg(Si₁₃Al₅)O₃₆·15H₂O","names":{"en":"Offretite","ru":"Оффретит"},"elements":["H","O","Mg","Al","Si","K","Ca"],"fame":7
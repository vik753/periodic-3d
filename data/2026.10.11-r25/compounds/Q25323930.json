{"version":"2026.10.11-r25","id":"Q25323930","formula":"C₁₆H₂₅NO₂","hill":"C16H25NO2","elements":["H","C","N","O"],"composition":{"C":16.0,"H":25.0,"N":1.0,"O":2.0},"names":{"en":"Emixustat"},"descriptions":{"en":"Emixustat is a small molecule notable for its establishment of a new class of compounds known as visual cycle modulators (VCMs). Formulated as the hydrochloride salt, emixustat hydrochloride, it is the first synthetic medicinal compound shown to affect retinal disease processes when taken by mouth. Emixustat was developed based on the ground-breaking research of Ryo Kubota, MD, PhD at Acucela Inc., the company he founded, working with a team of chemists including Ian L. Scott."},"fame":1,"pubchemCid":25221720,"mass":263.37,"charge":0,"smiles":"C1CCC(CC1)COC2=CC=CC(=C2)[C@@H](CCN)O","inchikey":"WJIGGYYSZBWCGC-MRXNPFEDSA-N","iupac":"(1R)-3-amino-1-[3-(cyclohexylmethoxy)phenyl]propan-1-ol","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"25221720","atoms":44,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":0.883,"y":1.387,"z":0.642,"el":"O"},{"x":-3.845,"y":-0.324,"z":2.01,"el":"O"},{"x":-2.69,"y":-3.533,"z":-1.462,"el":"N"},{"x":2.899,"y":0.106,"z":0.677,"el":"C"},{"x":3.508,"y":-1.268,"z":0.988,"el":"C"},{"x":3.203,"y":0.524,"z":-0.768,"el":"C"},{"x":5.005,"y":-1.302,"z":0.691,"el":"C"},{"x":4.701,"y":0.487,"z":-1.062,"el":"C"},{"x":5.304,"y":-0.877,"z":-0.744,"el":"C"},{"x":1.393,"y":0.099,"z":0.932,"el":"C"},{"x":-0.414,"y":1.458,"z":0.196,"el":"C"},{"x":-3.661,"y":-0.441,"z":0.591,"el":"C"},{"x":-2.664,"y":0.578,"z":0.153,"el":"C"},{"x":-1.347,"y":0.505,"z":0.606,"el":"C"},{"x":-3.27,"y":-1.902,"z":0.272,"el":"C"},{"x":-0.799,"y":2.483,"z":-0.668,"el":"C"},{"x":-3.049,"y":1.603,"z":-0.711,"el":"C"},{"x":-2.116,"y":2.556,"z":-1.121,"el":"C"},{"x":-3.042,"y":-2.138,"z":-1.222,"
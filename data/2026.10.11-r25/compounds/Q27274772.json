{"version":"2026.10.11-r25","id":"Q27274772","formula":"C₁₈H₂₅ClFN₃O₆","hill":"C18H25ClFN3O6","elements":["H","C","N","O","F","Cl"],"composition":{"C":18.0,"F":1.0,"H":25.0,"N":3.0,"O":6.0,"Cl":1.0},"names":{"en":"Lumicitabine"},"descriptions":{"en":"Lumicitabine (ALS-8176) is an antiviral drug which was developed as a treatment for respiratory syncytial virus (RSV) and human metapneumovirus (hMPV). It acts as an RNA polymerase inhibitor. While it showed promise in early clinical trials, poor results in Phase IIb trials led to it being discontinued from development for treatment of RSV. Research continues to determine whether it may be useful for the treatment of diseases caused by other RNA viruses, and it has been found to show activity against Nipah virus."},"fame":2,"pubchemCid":89658382,"mass":433.9,"charge":0,"smiles":"CC(C)C(=O)OC[C@@]1([C@H]([C@H]([C@@H](O1)N2C=CC(=NC2=O)N)F)OC(=O)C(C)C)CCl","inchikey":"MJVKYGMNSQJLIN-KYZVSKTDSA-N","iupac":"[(2R,3R,4R,5R)-5-(4-amino-2-oxopyrimidin-1-yl)-2-(chloromethyl)-4-fluoro-3-(2-methylpropanoyloxy)oxolan-2-yl]methyl 2-methylpropanoate","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"rdkit","ref":"89658382","atoms":54,"license":"Computed with RDKit from SMILES (PubChem, Wikidata)"},"structure":{"kind":"molecule","atoms":[{"x":2.013,"y":2.442,"z":3.688,"el":"C"},{"x":2.895,"y":2.576,"z":2.451,"el":"C"},{"x":3.307,"y":4.028,"z":2.23,"el":"C"},{"x":2.158,"y":2.034,"z":1.24,"el":"C"},{"x":1.617,"y":2.72,"z":0.384,"el":"O"},{"x":2.183,"y":0.672,"z":1.26,"el":"O"},{"x":1.46,"y":-0.013,"z":0.215,"el":"C"},{"x":0.168,"y":-0.646,"z":0.781,"el":"C"},{"x":-0.666,"y":-1.298,"z":-0.335,"el":"C"},{"x":-2.075,"y":-1.192,"z":0.209,"el":"C"},{"x":-2.058,"y":0.177,"z":0.891,"el":"C"},{"x":-0.681,"y":0.449,"z":1.256,"el":"O"},{"x":-2.6,"y":1.255,"z":0.066,"el":"N"},{"x":-1.823,"y":2.286,"z":-0.415,"el":"C"},{"x
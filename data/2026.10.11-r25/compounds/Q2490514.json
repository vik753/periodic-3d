{"version":"2026.10.11-r25","id":"Q2490514","formula":"C₁₅H₂₃N","hill":"C15H23N","elements":["H","C","N"],"composition":{"C":15.0,"H":23.0,"N":1.0},"names":{"en":"PCPr"},"descriptions":{"en":"PCPr is an arylcyclohexylamine dissociative anesthetic drug with hallucinogenic and stimulant effects. It is around the same potency as phencyclidine, although slightly less potent than the ethyl homologue eticyclidine, and has reportedly been sold as a designer drug in Germany and other European countries since the late 1990s. Several other related derivatives have also been encountered, with the n-propyl group of PCPr replaced by a 2-methoxyethyl, 2-ethoxyethyl or 3-methoxypropyl group to form PCMEA, PCEEA and PCMPA respectively."},"fame":5,"pubchemCid":599880,"mass":217.35,"charge":0,"smiles":"CCCNC1(CCCCC1)C2=CC=CC=C2","inchikey":"KHXNTQRMMGXPQW-UHFFFAOYSA-N","iupac":"1-phenyl-N-propylcyclohexan-1-amine","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"599880","atoms":39,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-0.962,"y":0.802,"z":-0.712,"el":"N"},{"x":-0.544,"y":-0.482,"z":-0.115,"el":"C"},{"x":-1.254,"y":-0.589,"z":1.265,"el":"C"},{"x":-1.058,"y":-1.645,"z":-1.012,"el":"C"},{"x":-2.781,"y":-0.674,"z":1.176,"el":"C"},{"x":-2.583,"y":-1.742,"z":-1.094,"el":"C"},{"x":-3.223,"y":-1.827,"z":0.285,"el":"C"},{"x":0.994,"y":-0.529,"z":-0.024,"el":"C"},{"x":-0.514,"y":1.918,"z":0.105,"el":"C"},{"x":1.609,"y":-0.657,"z":1.218,"el":"C"},{"x":1.758,"y":-0.443,"z":-1.184,"el":"C"},{"x":-0.92,"y":3.242,"z":-0.538,"el":"C"},{"x":3.001,"y":-0.7,"z":1.3,"el":"C"},{"x":3.15,"y":-0.485,"z":-1.101,"el":"C"},{"x":-0.443,"y":4.427,"z":0.287,"el":"C"},{"x":3.771,"y":-0.614,"z":0.141,"el":"C"},{"x":-0.975,"y":0.184,"z":1.987,"el":"H"},{"x":-0.936,"y":-1.53,"z":1.74,"el":"H"},{"x":-0.668,"y":-2.597,"z":-0.625
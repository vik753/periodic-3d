{"version":"2026.10.11-r25","id":"Q27257163","formula":"C₉H₁₈N₂O₂","hill":"C9H18N2O2","elements":["H","C","N","O"],"composition":{"C":9.0,"H":18.0,"N":2.0,"O":2.0},"names":{"en":"Capuride"},"descriptions":{"en":"Capuride is a synthetic sedative-hypnotic drug of the N-acylurea class, primarily developed and studied as a preanesthetic agent to promote sleep prior to surgery. It has a mechanism and duration of action considered similar to that of short-acting barbiturates, although it is chemically distinct. Clinical studies from the 1970s demonstrated capuride's efficacy in facilitating presurgical sleep, situating it among early modern hypnotic agents, but its clinical use has been superseded by safer alternatives."},"fame":1,"pubchemCid":231285,"mass":186.25,"charge":0,"smiles":"CCC(C)C(CC)C(=O)NC(=O)N","inchikey":"HLSLSXBFTXUKCY-UHFFFAOYSA-N","iupac":"N-carbamoyl-2-ethyl-3-methylpentanamide","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"231285","atoms":31,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-0.472,"y":0.806,"z":1.402,"el":"O"},{"x":-3.051,"y":-0.288,"z":1.219,"el":"O"},{"x":-1.454,"y":-0.149,"z":-0.479,"el":"N"},{"x":-3.512,"y":-1.1,"z":-0.88,"el":"N"},{"x":1.779,"y":-0.535,"z":-0.621,"el":"C"},{"x":0.827,"y":0.7,"z":-0.646,"el":"C"},{"x":2.332,"y":-0.854,"z":0.785,"el":"C"},{"x":1.556,"y":1.99,"z":-0.215,"el":"C"},{"x":1.115,"y":-1.764,"z":-1.256,"el":"C"},{"x":-0.42,"y":0.476,"z":0.219,"el":"C"},{"x":3.309,"y":-2.023,"z":0.804,"el":"C"},{"x":0.689,"y":3.232,"z":-0.392,"el":"C"},{"x":-2.698,"y":-0.491,"z":0.059,"el":"C"},{"x":2.638,"y":-0.282,"z":-1.26,"el":"H"},{"x":0.498,"y":0.849,"z":-1.684,"el":"H"},{"x":2.857,"y":0.019,"z":1.185,"el":"H"},{"x":1.512,"y":-1.079,"z":1.476,"el":"H"},{"x":1.862,"y":1.941,"z":0.836,"el":"H"},{"x":2.468,"y":2.111,"z":-0.813,"el":"H"},{"x
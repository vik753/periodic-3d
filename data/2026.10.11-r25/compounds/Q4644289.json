{"version":"2026.10.11-r25","id":"Q4644289","formula":"C₁₃H₁₂N₄O₂","hill":"C13H12N4O2","elements":["H","C","N","O"],"composition":{"C":13.0,"H":12.0,"N":4.0,"O":2.0},"names":{"en":"8-phenyltheophylline"},"descriptions":{"en":"8-Phenyltheophylline (8-phenyl-1,3-dimethylxanthine, 8-PT) is a drug derived from the xanthine family which acts as a potent and selective antagonist for the adenosine receptors A1 and A2A, but unlike other xanthine derivatives has virtually no activity as a phosphodiesterase inhibitor. It has stimulant effects in animals with similar potency to caffeine. Coincidentally 8-phenyltheophylline has also been found to be a potent and selective inhibitor of the liver enzyme CYP1A2 which makes it likely to cause interactions with other drugs which are normally metabolised by CYP1A2."},"fame":9,"pubchemCid":1922,"mass":256.26,"charge":0,"smiles":"CN1C2=C(C(=O)N(C1=O)C)NC(=N2)C3=CC=CC=C3","inchikey":"PJFMAVHETLRJHJ-UHFFFAOYSA-N","iupac":"1,3-dimethyl-8-phenyl-7H-purine-2,6-dione","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"1922","atoms":31,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":2.12,"y":-2.722,"z":0.221,"el":"O"},{"x":4.391,"y":1.374,"z":-0.109,"el":"O"},{"x":2.064,"y":1.403,"z":-0.113,"el":"N"},{"x":3.284,"y":-0.683,"z":0.057,"el":"N"},{"x":-0.38,"y":-1.098,"z":0.087,"el":"N"},{"x":-0.381,"y":1.124,"z":-0.092,"el":"N"},{"x":0.931,"y":-0.717,"z":0.057,"el":"C"},{"x":0.902,"y":0.647,"z":-0.053,"el":"C"},{"x":-1.131,"y":0.045,"z":-0.005,"el":"C"},{"x":2.123,"y":-1.498,"z":0.121,"el":"C"},{"x":3.323,"y":0.754,"z":-0.06,"el":"C"},{"x":-2.574,"y":0.012,"z":-0.003,"el":"C"},{"x":1.991,"y":2.854,"z":-0.229,"el":"C"},{"x":4.57,"y":-1.37,"z":0.114,"el":"C"},{"x":-3.294,"y":1.088,"z":0.516,"el":"C"},{"x":-3.247,"y":-1.095,"z":-0.519,"el":"C"},{"x":-4.688,"y":1.057,"z":0
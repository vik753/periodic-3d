{"version":"2026.10.11-r25","id":"Q4834697","formula":"C₂₀H₂₁F₃O₅S","hill":"C20H21F3O5S","elements":["H","C","O","F","S"],"composition":{"C":20.0,"F":3.0,"H":21.0,"O":5.0,"S":1.0},"names":{"en":"Bay-38-7271"},"descriptions":{"en":"Originally synthesized by chemist Wayne E. Kenney, BAY 38-7271 (KN 38-7271) is a drug which is a cannabinoid receptor agonist developed by Bayer AG. It has analgesic and neuroprotective effects and is used in scientific research, with proposed uses in the treatment of traumatic brain injury. It is a full agonist with around the same potency as CP 55,940 in animal studies, and has fairly high affinity for both CB1 and CB2 receptors, with Ki values of 2.91nM at CB1 and 4.24nM at CB2. It has been licensed to KeyNeurotek Pharmaceuticals for clinical development, and was in Phase II trials in 2008 but its development appears to have stopped."},"fame":4,"pubchemCid":9845561,"mass":430.4,"charge":0,"smiles":"C1[C@H](CC2=C1C=CC=C2OC3=CC(=CC=C3)OS(=O)(=O)CCCC(F)(F)F)CO","inchikey":"XJURALZPEJKKOV-CQSZACIVSA-N","iupac":"[3-[[(2R)-2-(hydroxymethyl)-2,3-dihydro-1H-inden-4-yl]oxy]phenyl] 4,4,4-trifluorobutane-1-sulfonate","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"9845561","atoms":50,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":1.645,"y":-0.752,"z":-0.188,"el":"S"},{"x":7.887,"y":0.682,"z":0.183,"el":"F"},{"x":6.297,"y":1.991,"z":-0.547,"el":"F"},{"x":6.353,"y":1.406,"z":1.553,"el":"F"},{"x":-1.858,"y":2.711,"z":-3.061,"el":"O"},{"x":-3.562,"y":-1.278,"z":-0.145,"el":"O"},{"x":1.105,"y":-2.183,"z":-0.774,"el":"O"},{"x":1.382,"y":0.298,"z":-1.152,"el":"O"},{"x":1.277,"y":-0.629,"z":1.208,"el":"O"},{"x":-3.334,"y":3.006,"z":-1.206,"el":"C"},{"x":-3.775,"y":1.524,"z":-1.224,"el":"C"},{"x":-3.457,"y":3.475,"z":0.262,"el":"C"},{"x":-3.456,"y":1.089,"z":0.172,"el":"C"},
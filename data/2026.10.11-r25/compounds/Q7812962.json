{"version":"2026.10.11-r25","id":"Q7812962","formula":"C₁₇H₂₁NO","hill":"C17H21NO","elements":["H","C","N","O"],"composition":{"C":17.0,"H":21.0,"N":1.0,"O":1.0},"names":{"en":"Tofenacin"},"descriptions":{"en":"Tofenacin is an antidepressant drug with a tricyclic-like structure which was developed and marketed in the United Kingdom and Italy in 1971 and 1981, respectively, by Brocades-Stheeman & Pharmacia (now part of Astellas Pharma). It acts as a serotonin-norepinephrine reuptake inhibitor, and based on its close relation to orphenadrine, may also possess anticholinergic and antihistamine properties. Tofenacin is also the major active metabolite of orphenadrine and likely plays a role in its beneficial effects against depressive symptoms seen in Parkinson's disease patients."},"fame":7,"pubchemCid":25315,"mass":255.35,"charge":0,"smiles":"CC1=CC=CC=C1C(C2=CC=CC=C2)OCCNC","inchikey":"PNYKGCPSFKLFKA-UHFFFAOYSA-N","iupac":"N-methyl-2-[(2-methylphenyl)-phenylmethoxy]ethanamine","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"25315","atoms":40,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":0.675,"y":1.301,"z":0.095,"el":"O"},{"x":4.337,"y":1.592,"z":0.141,"el":"N"},{"x":-0.269,"y":0.319,"z":0.556,"el":"C"},{"x":0.074,"y":-1.063,"z":0.007,"el":"C"},{"x":-1.668,"y":0.748,"z":0.267,"el":"C"},{"x":0.501,"y":-2.054,"z":0.865,"el":"C"},{"x":2.002,"y":0.892,"z":0.369,"el":"C"},{"x":-0.06,"y":-1.269,"z":-1.35,"el":"C"},{"x":-2.708,"y":0.346,"z":1.105,"el":"C"},{"x":-1.937,"y":1.551,"z":-0.841,"el":"C"},{"x":2.957,"y":1.962,"z":-0.137,"el":"C"},{"x":0.81,"y":-3.31,"z":0.342,"el":"C"},{"x":0.645,"y":-1.825,"z":2.334,"el":"C"},{"x":0.249,"y":-2.525,"z":-1.873,"el":"C"},{"x":0.684,"y":-3.545,"z":-1.027,"el":"C"},{"x":-4.017,"y":0.747,"z":0.835,"el":"C"},{"x":-3.245,"y":1.953,"z":-1.111,"el":"C"},{"x
{"version":"2026.10.11-r25","id":"Q130622603","formula":"C₁₅H₉FN₂","hill":"C15H9FN2","elements":["H","C","N","F"],"composition":{"C":15.0,"F":1.0,"H":9.0,"N":2.0},"names":{"en":"MFZ 10-7"},"descriptions":{"en":"MFZ 10-7 (3-fluoro-5-((6-methylpyridin-2-yl)ethynyl)benzonitrile) is a drug with potential applications in the treatment of addiction, which acts as a negative allosteric modulator of the metabotropic glutamate receptor subtype 5 (mGluR5). Others of the kind, namely MPEP and MTEP, are not considered to have translational potential for human use due to off-target effects and short half-lives. Drugs of this kind have been used to offset craving for drugs of abuse such as cocaine in in vivo animal administration models."},"fame":1,"pubchemCid":46208250,"mass":236.24,"charge":0,"smiles":"CC1=NC(=CC=C1)C#CC2=CC(=CC(=C2)F)C#N","inchikey":"ZGEXQIMQZVRTDZ-UHFFFAOYSA-N","iupac":"3-fluoro-5-[2-(6-methyl-2-pyridinyl)ethynyl]benzonitrile","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"46208250","atoms":27,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":3.801,"y":-2.975,"z":-0.374,"el":"F"},{"x":-3.34,"y":-0.692,"z":0.339,"el":"N"},{"x":5.256,"y":2.63,"z":0.465,"el":"N"},{"x":-4.681,"y":-0.529,"z":0.335,"el":"C"},{"x":1.409,"y":-0.251,"z":-0.07,"el":"C"},{"x":-2.607,"y":0.344,"z":-0.128,"el":"C"},{"x":-5.322,"y":0.615,"z":-0.112,"el":"C"},{"x":2.272,"y":0.829,"z":0.113,"el":"C"},{"x":1.926,"y":-1.536,"z":-0.234,"el":"C"},{"x":3.652,"y":0.625,"z":0.13,"el":"C"},{"x":-3.151,"y":1.529,"z":-0.596,"el":"C"},{"x":-4.535,"y":1.659,"z":-0.585,"el":"C"},{"x":3.305,"y":-1.741,"z":-0.216,"el":"C"},{"x":4.168,"y":-0.661,"z":-0.034,"el":"C"},{"x":-5.495,"y":-1.67,"z":0.849,"el":"C"},{"x":-0.004,"y":-0.041,"z":-0.09,"el":"C"},{"x":-1.192,"y":0.135,"z":-0.107,"el":"C"},{"x":4.537,"y":1.731,"z":0.315,"el":
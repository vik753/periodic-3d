{"version":"2026.10.11-r25","id":"Q332889","formula":"CH₂O₂²⁻","hill":"CH2O2","elements":["H","C","O"],"composition":{"C":1.0,"H":2.0,"O":2.0},"names":{"en":"Carbonite"},"descriptions":{"en":"The carbonite ion is an anion with the chemical formula CO2−2. This divalent anion forms by deprotonation of carbonous acid (C(OH)2). Alkali metal salts of carbonous acid, Li2CO2 (lithium carbonite), K2CO2 (potassium carbonite), Rb2CO2 (rubidium carbonite) and Cs2CO2 (caesium carbonite), have been observed at 15 K. The disodium salt has not been directly observed under experimental conditions, suggesting that this is less stable than other alkali carbonites."},"fame":4,"pubchemCid":null,"mass":null,"charge":-2,"smiles":"[C--](O)O","inchikey":null,"iupac":null,"classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"rdkit","ref":null,"atoms":5,"license":"Computed with RDKit from SMILES (PubChem, Wikidata)"},"structure":{"kind":"molecule","atoms":[{"x":0.0,"y":0.0,"z":-0.045,"el":"C"},{"x":-0.872,"y":0.28,"z":0.909,"el":"O"},{"x":0.872,"y":-0.28,"z":-1.0,"el":"O"},{"x":-1.778,"y":0.224,"z":0.559,"el":"H"},{"x":1.778,"y":-0.224,"z":-0.65,"el":"H"}],"bonds":[[0,1,1.0],[0,2,1.0],[1,3,1.0],[2,4,1.0]]},"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q332889","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Carbonite_%28ion%29","license":"CC BY-SA 4.0"},{"role":"structure","name":"RDKit","url":null,"license":"Computed with RDKit from SMILES (PubChem, Wikidata)"}],"similar":[{"id":"Q161233","formula":"CH₂O₂","names":{"en":"Formic acid","ru":"Муравьиная кислота","uk":"Мурашина кислота"},"elements":["H","C","O"],"fame":76,"kind":"molecule"},{"id":"Q905942","formula":"CH₂O₂","names":{"en":"Dioxirane","ru":"Диоксиран"},"elements":["H","C","O"],"fame":20,"kind":"molecule"},{"id":"Q
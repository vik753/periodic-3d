{"version":"2026.10.11-r25","id":"Q908013","formula":"C₁₅H₁₃N₃O₂S","hill":"C15H13N3O2S","elements":["H","C","N","O","S"],"composition":{"C":15.0,"H":13.0,"N":3.0,"O":2.0,"S":1.0},"names":{"en":"Fenbendazole"},"descriptions":{"en":"Fenbendazole is a broad-spectrum benzimidazole anthelmintic used against gastrointestinal parasites including: roundworms, hookworms, whipworms, the tapeworm genus Taenia (but not effective against Dipylidium caninum, a common dog tapeworm), pinworms, Aelurostrongylus spp., paragonimiasis, strongyles, and strongyloides that can be administered to sheep, cattle, horses, fish, dogs, cats, rabbits, most reptiles, freshwater shrimp tanks as planaria and hydra treatments, and seals. It has not been tested or approved for use in humans by the FDA or EMA. Related benzimidazole drugs such as mebendazole and albendazole are used in humans."},"fame":17,"pubchemCid":3334,"mass":299.3,"charge":0,"smiles":"COC(=O)NC1=NC2=C(N1)C=C(C=C2)SC3=CC=CC=C3","inchikey":"HDDSHPAODJUKPD-UHFFFAOYSA-N","iupac":"methyl N-(6-phenylsulfanyl-1H-benzimidazol-2-yl)carbamate","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"3334","atoms":34,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-3.419,"y":-1.686,"z":-0.826,"el":"S"},{"x":5.821,"y":1.535,"z":-0.282,"el":"O"},{"x":5.213,"y":-0.34,"z":0.872,"el":"O"},{"x":1.374,"y":0.526,"z":-0.93,"el":"N"},{"x":2.337,"y":-0.951,"z":0.423,"el":"N"},{"x":3.678,"y":0.85,"z":-0.452,"el":"N"},{"x":0.386,"y":-0.365,"z":-0.598,"el":"C"},{"x":1.012,"y":-1.276,"z":0.248,"el":"C"},{"x":-0.961,"y":-0.448,"z":-0.953,"el":"C"},{"x":-1.689,"y":-1.514,"z":-0.414,"el":"C"},{"x":2.52,"y":0.133,"z":-0.296,"el":"C"},{"x":0.265,"y":-2.341,"z":0.78,"el":"C"},{"x":-1.089,"y":-2.445,"z":0.437,"el":"C"},{"x":-4.076,"y":-0.145,"z":-0.208,"el":"C"},{"x":-3.955,"y":0.168,"z":1.1
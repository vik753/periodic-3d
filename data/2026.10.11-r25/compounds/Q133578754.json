{"version":"2026.10.11-r25","id":"Q133578754","formula":"C₁₂H₁₃FN₂O","hill":"C12H13FN2O","elements":["H","C","N","O","F"],"composition":{"C":12.0,"F":1.0,"H":13.0,"N":2.0,"O":1.0},"names":{"en":"BK-5F-NM-AMT"},"descriptions":{"en":"BK-5F-NM-AMT, or βk-5F-NM-αMT, also known as β-keto-5-fluoro-N-methyl-αMT or α,N-dimethyl-5-fluoro-β-ketotryptamine, is a monoamine releasing agent of the tryptamine, α-alkyltryptamine, and β-ketotryptamine families. It is known to induce the release of serotonin and dopamine, with respective EC50Tooltip half-maximal effective concentration values of 190 nM and 620 nM in rat brain synaptosomes, whereas norepinephrine release was not reported. In contrast to many other tryptamines, the drug is inactive as an agonist of serotonin receptors including the 5-HT1, 5-HT2, and 5-HT3 receptors."},"fame":2,"pubchemCid":162765676,"mass":220.24,"charge":0,"smiles":"CC(C(=O)C1=CNC2=C1C=C(C=C2)F)NC","inchikey":"NONYEOWAEONGSG-UHFFFAOYSA-N","iupac":"1-(5-fluoro-1H-indol-3-yl)-2-(methylamino)propan-1-one","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"rdkit","ref":"162765676","atoms":29,"license":"Computed with RDKit from SMILES (PubChem, Wikidata)"},"structure":{"kind":"molecule","atoms":[{"x":3.034,"y":0.434,"z":1.499,"el":"C"},{"x":2.139,"y":0.023,"z":0.326,"el":"C"},{"x":0.681,"y":-0.151,"z":0.823,"el":"C"},{"x":0.452,"y":-0.482,"z":1.989,"el":"O"},{"x":-0.423,"y":0.072,"z":-0.124,"el":"C"},{"x":-0.309,"y":0.273,"z":-1.489,"el":"C"},{"x":-1.561,"y":0.432,"z":-2.017,"el":"N"},{"x":-2.509,"y":0.344,"z":-1.026,"el":"C"},{"x":-1.829,"y":0.113,"z":0.173,"el":"C"},{"x":-2.588,"y":-0.022,"z":1.355,"el":"C"},{"x":-3.977,"y":0.08,"z":1.283,"el":"C"},{"x":-4.63,"y":0.31,"z":0.08,"el":"C"},{"x":-3.905,"y":0.447,"z":-1.105,"el":"C"},{"x":-4.701,"y":-0.047,"z":2.404,"el":"F"},{"x":2.573,"y":-1.243,"z":-0.303,"el":"N"},{"x":3.855,"y":
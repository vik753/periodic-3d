{"version":"2026.10.11-r25","id":"Q133539879","formula":"C₁₂H₁₄ClNO","hill":"C12H14ClNO","elements":["H","C","N","O","Cl"],"composition":{"C":12.0,"H":14.0,"N":1.0,"O":1.0,"Cl":1.0},"names":{"en":"3-chloro-N-cyclopropylcathinone"},"descriptions":{"en":"3-Chloro-N-cyclopropylcathinone (3Cl-CpC; code names PAL-433, RTI-6037-39) is a stimulant and hybrid monoamine releasing agent and monoamine reuptake inhibitor of the cathinone family related to bupropion (3-chloro-N-tert-butylcathinone). It acts specifically as a dual serotonin releasing agent (SRA) and serotonin–norepinephrine–dopamine reuptake inhibitor (SNDRI). Its EC50Tooltip half-maximal effective concentration for induction of serotonin release is 1,328 nM, whereas its IC50Tooltip half-maximal inhibitory concentration values for monoamine reuptake inhibition are 265 to 533 nM for dopamine, 2,150 nM for norepinephrine, and 3,180 nM for serotonin."},"fame":1,"pubchemCid":44543271,"mass":223.7,"charge":0,"smiles":"CC(C(=O)C1=CC(=CC=C1)Cl)NC2CC2","inchikey":"YKOZIWZLLJVPPD-UHFFFAOYSA-N","iupac":"1-(3-chlorophenyl)-2-(cyclopropylamino)propan-1-one","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"44543271","atoms":29,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":3.93,"y":1.608,"z":-1.05,"el":"Cl"},{"x":-0.79,"y":-0.777,"z":-1.964,"el":"O"},{"x":-2.828,"y":-0.101,"z":0.034,"el":"N"},{"x":-2.471,"y":1.105,"z":0.803,"el":"C"},{"x":-3.075,"y":2.431,"z":0.442,"el":"C"},{"x":-1.621,"y":2.171,"z":0.176,"el":"C"},{"x":-1.824,"y":-1.156,"z":0.183,"el":"C"},{"x":-2.428,"y":-2.497,"z":-0.214,"el":"C"},{"x":-0.622,"y":-0.819,"z":-0.726,"el":"C"},{"x":0.694,"y":-0.568,"z":-0.159,"el":"C"},{"x":1.577,"y":0.299,"z":-0.802,"el":"C"},{"x":1.071,"y":-1.194,"z":1.029,"el":"C"},{"x":2.839,"y":0.539,"z":-0.257,"el":"C"},{"x":2.333,"y":-0.954,"z":1.574,"el
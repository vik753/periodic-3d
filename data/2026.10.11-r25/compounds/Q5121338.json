{"version":"2026.10.11-r25","id":"Q5121338","formula":"C₁₃H₁₆N₂O","hill":"C13H16N2O","elements":["H","C","N","O"],"composition":{"C":13.0,"H":16.0,"N":2.0,"O":1.0},"names":{"en":"Cirazoline"},"descriptions":{"en":"Cirazoline is a full agonist at the α1A adrenergic receptor, a partial agonist at both the α1B and α1D adrenergic receptors, and a nonselective antagonist to the α2 adrenergic receptor. It is believed that this combination of properties could make cirazoline an effective vasoconstricting agent. Cirazoline has also been shown to decrease food intake in rats, purportedly through activation of α1 adrenoceptors in the paraventricular nucleus in the hypothalamus of the brain."},"fame":8,"pubchemCid":2765,"mass":216.28,"charge":0,"smiles":"C1CC1C2=CC=CC=C2OCC3=NCCN3","inchikey":"YAORIDZYZDUZCM-UHFFFAOYSA-N","iupac":"2-[(2-cyclopropylphenoxy)methyl]-4,5-dihydro-1H-imidazole","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"2765","atoms":32,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-0.184,"y":-0.501,"z":-0.635,"el":"O"},{"x":-2.763,"y":0.049,"z":1.119,"el":"N"},{"x":-3.28,"y":-0.765,"z":-0.942,"el":"N"},{"x":1.459,"y":1.836,"z":-0.682,"el":"C"},{"x":0.277,"y":2.397,"z":0.042,"el":"C"},{"x":1.642,"y":2.98,"z":0.263,"el":"C"},{"x":1.974,"y":0.488,"z":-0.299,"el":"C"},{"x":1.142,"y":-0.623,"z":-0.29,"el":"C"},{"x":3.316,"y":0.345,"z":0.055,"el":"C"},{"x":1.626,"y":-1.874,"z":0.066,"el":"C"},{"x":3.813,"y":-0.908,"z":0.414,"el":"C"},{"x":-1.093,"y":-1.395,"z":-0.029,"el":"C"},{"x":2.967,"y":-2.018,"z":0.42,"el":"C"},{"x":-2.414,"y":-0.702,"z":0.038,"el":"C"},{"x":-4.053,"y":0.633,"z":0.916,"el":"C"},{"x":-4.431,"y":0.057,"z":-0.457,"el":"C"},{"x":1.525,"y":2.08,"z":-1.74,"el":"H"},{"x":-0.162,"y":1.855,"z":0.87,"el":"H"},{"x":-0.434,"y":2.981,"z":-0.53,"el":"H"},{"x":1.847,"y":3.957
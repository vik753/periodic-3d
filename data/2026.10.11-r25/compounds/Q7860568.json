{"version":"2026.10.11-r25","id":"Q7860568","formula":"C₃₅H₄₆N₆O₇","hill":"C35H46N6O7","elements":["H","C","N","O"],"composition":{"C":35.0,"H":46.0,"N":6.0,"O":7.0},"names":{"en":"Tynorphin"},"descriptions":{"en":"Tynorphin is a synthetic opioid peptide which is a potent and competitive inhibitor of the enkephalinase class of enzymes which break down the endogenous enkephalin peptides. It specifically inactivates dipeptidyl aminopeptidase III (DPP3) with very high efficacy, but also inhibits neutral endopeptidase (NEP), aminopeptidase N (APN), and angiotensin-converting enzyme (ACE) to a lesser extent. It has a pentapeptide structure with the amino acid sequence Val-Val-Tyr-Pro-Trp (VVYPW)."},"fame":4,"pubchemCid":9961318,"mass":662.8,"charge":0,"smiles":"CC(C)[C@@H](C(=O)N[C@@H](C(C)C)C(=O)N[C@@H](CC1=CC=C(C=C1)O)C(=O)N2CCC[C@H]2C(=O)N[C@@H](CC3=CNC4=CC=CC=C43)C(=O)O)N","inchikey":"WLWBANYDSJWZBI-IIZANFQQSA-N","iupac":"(2S)-2-[[(2S)-1-[(2S)-2-[[(2S)-2-[[(2S)-2-amino-3-methylbutanoyl]amino]-3-methylbutanoyl]amino]-3-(4-hydroxyphenyl)propanoyl]pyrrolidine-2-carbonyl]amino]-3-(1H-indol-3-yl)propanoic acid","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"rdkit","ref":"9961318","atoms":94,"license":"Computed with RDKit from SMILES (PubChem, Wikidata)"},"structure":{"kind":"molecule","atoms":[{"x":-9.062,"y":3.121,"z":-0.477,"el":"C"},{"x":-7.763,"y":2.513,"z":-1.02,"el":"C"},{"x":-8.096,"y":1.67,"z":-2.259,"el":"C"},{"x":-7.02,"y":1.67,"z":0.044,"el":"C"},{"x":-5.682,"y":1.128,"z":-0.512,"el":"C"},{"x":-5.552,"y":-0.011,"z":-0.949,"el":"O"},{"x":-4.664,"y":2.059,"z":-0.47,"el":"N"},{"x":-3.274,"y":1.651,"z":-0.654,"el":"C"},{"x":-2.415,"y":2.843,"z":-1.136,"el":"C"},{"x":-0.945,"y":2.466,"z":-1.351,"el":"C"},{"x":-2.969,"y":3.423,"z":-2.445,"el":"C"},{"x":-2.802,"y":1.113,"z":0.72,"el":"C"},{"x":-3.283,"y":1.493,"z":1.788,"el":"O"},{"x":-1.
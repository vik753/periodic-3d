{"version":"2026.10.11-r25","id":"Q413391","formula":"Mn₇Si₈O₄","hill":"Mn7O4Si8","elements":["O","Si","Mn"],"composition":{"O":4.0,"Mn":7.0,"Si":8.0},"names":{"en":"Braunite","ru":"Браунит","uk":"Брауніт"},"descriptions":{"en":"Braunite is a silicate mineral containing both di- and tri-valent manganese with the chemical formula: Mn2+Mn3+6[O8|SiO4]. Common impurities include iron, calcium, boron, barium, titanium, aluminium, and magnesium. Braunite forms grey/black tetragonal crystals and has a Mohs hardness of 6 – 6.5.","ru":"Браунит — марганцевый минерал, класса оксидов. Образуется при метаморфизме силикатов и оксидов марганца, и как продукт выветривания. Руду с браунитом используют в металлургической, химической промышленности, для производства марганца.","uk":"Брауніт (рос. браунит; англ. braunite; нім."},"fame":34,"pubchemCid":null,"mass":null,"charge":0,"smiles":null,"inchikey":null,"iupac":null,"classes":[{"qid":"Q12089225","names":{"en":"mineral species","ru":"действительный вид минералов","uk":"мінеральний вид"}}],"structureInfo":null,"structure":null,"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q413391","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Braunite","license":"CC BY-SA 4.0"},{"role":"description","name":"Wikipedia (ru)","url":"https://ru.wikipedia.org/wiki/%D0%91%D1%80%D0%B0%D1%83%D0%BD%D0%B8%D1%82","license":"CC BY-SA 4.0"},{"role":"description","name":"Wikipedia (uk)","url":"https://uk.wikipedia.org/wiki/%D0%91%D1%80%D0%B0%D1%83%D0%BD%D1%96%D1%82","license":"CC BY-SA 4.0"},{"role":"photo","name":"Wikimedia Commons","url":"https://commons.wikimedia.org/wiki/File:Braunite-195641.jpg","license":"CC BY-SA 3.0"}],"similar":[{"id":"Q413375","formula":"MnSi","names":{"en":"Brownleeite"},"elements":["Si","Mn"],"fame":10,"kind":"crystal"},{"id":"Q4419236","formula":"MnSi","names":{"en":"Manganese monosilicide","ru":"Силицид марганца"},"elements":["Si","Mn"],
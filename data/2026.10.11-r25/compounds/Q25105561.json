{"version":"2026.10.11-r25","id":"Q25105561","formula":"C₂H₃Br₃O","hill":"C2H3Br3O","elements":["H","C","O","Br"],"composition":{"C":2.0,"H":3.0,"O":1.0,"Br":3.0},"names":{"en":"Tribromoethanol"},"descriptions":{"en":"2,2,2-Tribromoethanol, often called just tribromoethanol, is a chemical compound with formula Br3C−CH2OH. Its molecule can be described as that of ethanol, with the three hydrogen atoms in position 2 (on the methyl group) replaced by bromine. It is a white crystalline solid, soluble in water and other solvents, that absorbs strongly in the UV below 290 nm. Tribromoethanol is used in medicine and biology as an anesthetic, and has been available commercially for that purpose by the trade name Avertin."},"fame":7,"pubchemCid":6400,"mass":282.76,"charge":0,"smiles":"C(C(Br)(Br)Br)O","inchikey":"YFDSDPIBEUFTMI-UHFFFAOYSA-N","iupac":"2,2,2-tribromoethanol","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"6400","atoms":9,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":2.033,"y":0.001,"z":0.996,"el":"Br"},{"x":0.246,"y":1.616,"z":-1.138,"el":"Br"},{"x":0.246,"y":-1.618,"z":-1.136,"el":"Br"},{"x":-2.068,"y":0.0,"z":0.323,"el":"O"},{"x":-0.804,"y":0.001,"z":0.981,"el":"C"},{"x":0.346,"y":0.0,"z":-0.025,"el":"C"},{"x":-0.767,"y":-0.884,"z":1.627,"el":"H"},{"x":-0.767,"y":0.886,"z":1.626,"el":"H"},{"x":-2.75,"y":0.001,"z":1.016,"el":"H"}],"bonds":[[0,5,1],[1,5,1],[2,5,1],[3,4,1],[3,8,1],[4,5,1],[4,6,1],[4,7,1]]},"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q25105561","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Tribromoethanol","license":"CC BY-SA 4.0"},{"role":"properties","name":"PubChem","url":"https://pubchem.ncbi.nlm.nih.gov/compound/6400","license":"PubChem (NIH), public data"},{"r
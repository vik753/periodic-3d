{"version":"2026.10.11-r25","id":"Q27264157","formula":"C₂₀H₂₄O₅S","hill":"C20H24O5S","elements":["H","C","O","S"],"composition":{"C":20.0,"H":24.0,"O":5.0,"S":1.0},"names":{"en":"Ethynylestradiol 3-sulfate"},"descriptions":{"en":"Ethinylestradiol sulfate (EE sulfate), also known as 17α-ethynylestradiol 3-sulfate, is an estrogen ester – specifically, the C3 sulfuric acid (sulfate) ester of the synthetic estrogen ethinylestradiol (EE) – and is the major metabolite of EE. Circulating levels of EE sulfate range from 6 to 22 times those of EE when EE is taken orally. EE sulfate can be transformed back into EE (14–21%) via steroid sulfatase, and it has been suggested that EE sulfate may serve as a circulating reservoir for EE, similarly to the case of estrone sulfate with estradiol."},"fame":1,"pubchemCid":68575,"mass":376.5,"charge":0,"smiles":"C[C@]12CC[C@H]3[C@H]([C@@H]1CC[C@]2(C#C)O)CCC4=C3C=CC(=C4)OS(=O)(=O)O","inchikey":"WLGIWVFFGMPRLM-SLHNCBLASA-N","iupac":"[(8R,9S,13S,14S,17R)-17-ethynyl-17-hydroxy-13-methyl-7,8,9,11,12,14,15,16-octahydro-6H-cyclopenta[a]phenanthren-3-yl] hydrogen sulfate","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"68575","atoms":50,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":5.976,"y":0.153,"z":-0.667,"el":"S"},{"x":-5.601,"y":0.891,"z":-1.435,"el":"O"},{"x":5.136,"y":0.08,"z":0.745,"el":"O"},{"x":7.522,"y":-0.112,"z":-0.216,"el":"O"},{"x":5.565,"y":-0.948,"z":-1.519,"el":"O"},{"x":5.896,"y":1.517,"z":-1.157,"el":"O"},{"x":-3.292,"y":0.442,"z":-0.658,"el":"C"},{"x":-2.723,"y":-0.782,"z":0.095,"el":"C"},{"x":-1.199,"y":-0.882,"z":-0.014,"el":"C"},{"x":-4.82,"y":0.205,"z":-0.466,"el":"C"},{"x":-0.564,"y":0.393,"z":0.617,"el":"C"},{"x":-2.693,"y":1.712,"z":-0.026,"el":"C"},{"x":-3.573,"y":-1.942,"z":-0.417,"el":"C"},{"x":-1.152,"y":1.683,"z":-0.013,"el":"C"},
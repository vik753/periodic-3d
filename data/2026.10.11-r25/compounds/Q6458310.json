{"version":"2026.10.11-r25","id":"Q6458310","formula":"C₁₄H₉F₉N₂O","hill":"C14H9F9N2O","elements":["H","C","N","O","F"],"composition":{"C":14.0,"F":9.0,"H":9.0,"N":2.0,"O":1.0},"names":{"en":"LGD-2226"},"descriptions":{"en":"LGD-2226 is an investigational selective androgen receptor modulator (SARM), which is being developed for treatment of muscle wasting and osteoporosis. LGD-2226 is an orally active, potent and selective agonist for androgen receptors which was shown to have anabolic effects in both muscle and bone tissue, but with considerably less effects on prostate weight and luteinizing hormone levels than testosterone. Selective androgen receptor modulators may also be used by athletes to assist in training and increase physical stamina and fitness, potentially producing effects similar to anabolic steroids but with significantly less side effects."},"fame":4,"pubchemCid":11560224,"mass":392.22,"charge":0,"smiles":"C1=CC2=C(C=C1N(CC(F)(F)F)CC(F)(F)F)C(=CC(=O)N2)C(F)(F)F","inchikey":"ULBPQWIGZUGPHU-UHFFFAOYSA-N","iupac":"6-[bis(2,2,2-trifluoroethyl)amino]-4-(trifluoromethyl)-1H-quinolin-2-one","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"11560224","atoms":35,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-3.625,"y":2.729,"z":-1.931,"el":"F"},{"x":-2.969,"y":2.641,"z":0.146,"el":"F"},{"x":-1.528,"y":2.353,"z":-1.472,"el":"F"},{"x":-3.573,"y":-2.175,"z":2.443,"el":"F"},{"x":-4.083,"y":-2.097,"z":0.325,"el":"F"},{"x":-2.068,"y":-2.673,"z":0.947,"el":"F"},{"x":1.211,"y":1.497,"z":1.964,"el":"F"},{"x":3.064,"y":0.756,"z":2.842,"el":"F"},{"x":3.103,"y":2.479,"z":1.508,"el":"F"},{"x":5.313,"y":-1.173,"z":-1.351,"el":"O"},{"x":-2.189,"y":-0.056,"z":-0.135,"el":"N"},{"x":3.04,"y":-1.35,"z":-1.651,"el":"N"},{"x":-0.869,"y":-0.381,"z":-0.515,"el":"C"},{"x":1.53,"y":-0.161,"z":-0.163,"
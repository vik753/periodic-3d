{"version":"2026.10.11-r25","id":"Q19861287","formula":"Tl₂Cu₂As₂S₅","hill":"As2Cu2S5Tl2","elements":["S","Cu","As","Tl"],"composition":{"S":5.0,"As":2.0,"Cu":2.0,"Tl":2.0},"names":{"en":"Spaltiite"},"descriptions":{"en":"Spaltiite is a rare thallium sulfosalt mineral with the ideal chemical formula Tl2Cu2As2S5. It was discovered on a waste dump of the Lengenbach quarry in the Binn Valley (Binntal), Canton Valais, Switzerland, a locality famous for producing an unusually large number of rare thallium- and arsenic-bearing sulfosalt minerals. Spaltiite was approved as a valid mineral species by the International Mineralogical Association's Commission on New Minerals, Nomenclature and Classification (IMA-CNMNC) in 2014, but a full scientific description of the species, including its crystal structure, was not published until 2026."},"fame":5,"pubchemCid":null,"mass":null,"charge":0,"smiles":null,"inchikey":null,"iupac":null,"classes":[{"qid":"Q12089225","names":{"en":"mineral species","ru":"действительный вид минералов","uk":"мінеральний вид"}}],"structureInfo":null,"structure":null,"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q19861287","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Spaltiite","license":"CC BY-SA 4.0"},{"role":"photo","name":"Wikimedia Commons","url":"https://commons.wikimedia.org/wiki/File:Spaltiite.jpg","license":"CC BY 4.0"}],"similar":[{"id":"Q3756715","formula":"Tl₂AgCu₂As₃S₇","names":{"en":"Gabrielite"},"elements":["S","Cu","As","Ag","Tl"],"fame":5,"kind":null},{"id":"Q424114","formula":"TlAsS₂","names":{"en":"Lorándite","uk":"Лорандит"},"elements":["S","As","Tl"],"fame":14,"kind":"crystal"},{"id":"Q1059826","formula":"CuSbS₂","names":{"en":"Chalcostibite","ru":"Халькостибит","uk":"Халькостибіт"},"elements":["S","Cu","Sb"],"fame":11,"kind":"crystal"},{"id":"Q411881","formula":"Cu₃AsS₄","names":{"en":"Enargite","ru":"Энаргит","uk":"Енаргіт"},"elements
{"version":"2026.10.11-r25","id":"Q134706494","formula":"C₁₁H₁₃ClN₂O","hill":"C11H13ClN2O","elements":["H","C","N","O","Cl"],"composition":{"C":11.0,"H":13.0,"N":2.0,"O":1.0,"Cl":1.0},"names":{"en":"Ropanicant"},"descriptions":{"en":"Ropanicant (SUVN-911) is an investigational new drug under development by Suven Life Sciences Ltd for the treatment of major depressive disorder (MDD) and certain neurological conditions. It acts as an antagonist of the α4β2 nicotinic acetylcholine receptor (nAChR), a target involved in mood regulation and cognitive function. Ropanicant has been shown to increase levels of serotonin and brain-derived neurotrophic factor (BDNF) in the cortex, which may contribute to its antidepressant effects."},"fame":1,"pubchemCid":146026959,"mass":224.68,"charge":0,"smiles":"C1[C@H]2C[C@H]2N[C@@H]1COC3=CN=C(C=C3)Cl","inchikey":"PYSCVJMLJRHJGJ-OYNCUSHFSA-N","iupac":"(1R,3S,5R)-3-[(6-chloro-3-pyridinyl)oxymethyl]-2-azabicyclo[3.1.0]hexane","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"rdkit","ref":"146026959","atoms":28,"license":"Computed with RDKit from SMILES (PubChem, Wikidata)"},"structure":{"kind":"molecule","atoms":[{"x":-1.505,"y":-0.644,"z":1.392,"el":"C"},{"x":-2.864,"y":-0.047,"z":1.592,"el":"C"},{"x":-3.16,"y":1.401,"z":1.305,"el":"C"},{"x":-3.366,"y":0.357,"z":0.244,"el":"C"},{"x":-2.331,"y":0.074,"z":-0.764,"el":"N"},{"x":-1.074,"y":-0.202,"z":-0.026,"el":"C"},{"x":-0.208,"y":-1.252,"z":-0.732,"el":"C"},{"x":0.985,"y":-1.53,"z":0.008,"el":"O"},{"x":2.078,"y":-0.738,"z":-0.18,"el":"C"},{"x":3.207,"y":-1.081,"z":0.56,"el":"C"},{"x":4.388,"y":-0.419,"z":0.521,"el":"N"},{"x":4.44,"y":0.641,"z":-0.307,"el":"C"},{"x":3.382,"y":1.072,"z":-1.088,"el":"C"},{"x":2.179,"y":0.367,"z":-1.021,"el":"C"},{"x":5.947,"y":1.459,"z":-0.336,"el":"Cl"},{"x":-1.58,"y":-1.736,"z":1.464,"el":"H"},{"x":-0.801,"y":-0.291,"z":2.152,"el"
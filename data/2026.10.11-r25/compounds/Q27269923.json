{"version":"2026.10.11-r25","id":"Q27269923","formula":"C₂₅H₃₄O₅","hill":"C25H34O5","elements":["H","C","O"],"composition":{"C":25.0,"H":34.0,"O":5.0},"names":{"en":"9,11-dehydrocortexolone 17α-butyrate"},"descriptions":{"en":"9,11-Dehydrocortexolone 17α-butyrate (developmental code name CB-03-04) is a synthetic steroidal antiandrogen that was developed for use as a topical medication but was never marketed. It is the C17α butyrate (butanoate) ester of the 9,11-dehydrogenated analogue of 11-deoxycortisol (cortexolone). C17α esters of 11-deoxycortisol were unexpectedly found to possess antiandrogen activity, and 9,11-dehydrocortexolone 17α-butyrate was selected for development based on its optimum drug profile."},"fame":1,"pubchemCid":11704352,"mass":414.5,"charge":0,"smiles":"CCCC(=O)O[C@@]1(CC[C@@H]2[C@@]1(CC=C3[C@H]2CCC4=CC(=O)CC[C@@]43C)C)C(=O)CO","inchikey":"IMSKTQNPYUKZMB-AMMWCUJOSA-N","iupac":"[(8S,10S,13S,14S,17R)-17-(2-hydroxyacetyl)-10,13-dimethyl-3-oxo-2,6,7,8,12,14,15,16-octahydro-1H-cyclopenta[a]phenanthren-17-yl] butanoate","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"11704352","atoms":64,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-2.694,"y":-0.566,"z":0.222,"el":"O"},{"x":-4.096,"y":2.247,"z":-0.596,"el":"O"},{"x":-4.632,"y":2.213,"z":2.108,"el":"O"},{"x":6.942,"y":-1.923,"z":1.012,"el":"O"},{"x":-4.753,"y":-0.433,"z":-0.811,"el":"O"},{"x":-0.835,"y":1.041,"z":-0.086,"el":"C"},{"x":-0.141,"y":0.095,"z":-1.088,"el":"C"},{"x":1.376,"y":0.331,"z":-1.187,"el":"C"},{"x":-2.318,"y":0.68,"z":-0.355,"el":"C"},{"x":-0.958,"y":0.252,"z":-2.37,"el":"C"},{"x":-2.395,"y":0.527,"z":-1.889,"el":"C"},{"x":-0.269,"y":0.697,"z":1.302,"el":"C"},{"x":2.02,"y":0.473,"z":0.203,"el":"C"},{"x":3.575,"y":0.491,"z":0.249,"el":"C"},{"x":2.025,"y":-0.81,"z":-1.981,"el":"C"},{"x":-0.574,"y":2
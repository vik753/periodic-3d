{"version":"2026.10.11-r25","id":"Q903566","formula":"C₉H₁₀O₄","hill":"C9H10O4","elements":["H","C","O"],"composition":{"C":9.0,"H":10.0,"O":4.0},"names":{"en":"Homovanillic acid","ru":"Гомованилиновая кислота"},"descriptions":{"en":"Homovanillic acid (HVA) is a major catecholamine metabolite that is produced by a consecutive action of monoamine oxidase and catechol-O-methyltransferase on dopamine. Homovanillic acid is used as a reagent to detect oxidative enzymes, and is associated with dopamine levels in the brain. In psychiatry and neuroscience, brain and cerebrospinal fluid levels of HVA are measured as a marker of metabolic stress caused by 2-deoxy-D-glucose.","ru":"Гомованилиновая, или 3-метокси-4-гидроксифенилуксусная кислота, сокр. ГК, ГВК, англ. HVA (формула HOC6H3(OCH3)CH2COOH) — основной продукт обмена катехоламинов, в том числе дофамина."},"fame":18,"pubchemCid":1738,"mass":182.17,"charge":0,"smiles":"COC1=C(C=CC(=C1)CC(=O)O)O","inchikey":"QRMZSPFSDQBLIX-UHFFFAOYSA-N","iupac":"2-(4-hydroxy-3-methoxyphenyl)acetic acid","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"1738","atoms":23,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-2.437,"y":1.4,"z":-0.547,"el":"O"},{"x":-3.257,"y":-1.049,"z":0.481,"el":"O"},{"x":4.297,"y":0.46,"z":-0.091,"el":"O"},{"x":2.564,"y":0.612,"z":1.367,"el":"O"},{"x":0.724,"y":-0.435,"z":-0.525,"el":"C"},{"x":2.155,"y":-0.219,"z":-0.885,"el":"C"},{"x":-0.203,"y":0.592,"z":-0.704,"el":"C"},{"x":-1.541,"y":0.39,"z":-0.367,"el":"C"},{"x":0.313,"y":-1.664,"z":-0.009,"el":"C"},{"x":-1.952,"y":-0.839,"z":0.149,"el":"C"},{"x":-1.025,"y":-1.866,"z":0.328,"el":"C"},{"x":2.991,"y":0.323,"z":0.257,"el":"C"},{"x":-2.63,"y":2.297,"z":0.545,"el":"C"},{"x":2.227,"y":0.483,"z":-1.724,"el":"H"},{"x":2.601,"y":-1.165,"z":-1.216,"el":"H"},{"x":0.113,"y":1.552,"z":-1.1
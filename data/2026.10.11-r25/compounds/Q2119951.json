{"version":"2026.10.11-r25","id":"Q2119951","formula":"C₅H₅NOS","hill":"C5H5NOS","elements":["H","C","N","O","S"],"composition":{"C":5.0,"H":5.0,"N":1.0,"O":1.0,"S":1.0},"names":{"en":"Pyrithione"},"descriptions":{"en":"Pyrithione is the common name of an organosulfur compound with molecular formula C5H5NOS, chosen as an abbreviation of pyridinethione, and found in the Persian shallot. It exists as a pair of tautomers, the major form being the thione 1-hydroxy-2(1H)-pyridinethione and the minor form being the thiol 2-mercaptopyridine N-oxide; it crystallises in the thione form. It is usually prepared from either 2-bromopyridine, 2-chloropyridine, or 2-chloropyridine N-oxide, and is commercially available as both the neutral compound and its sodium salt."},"fame":4,"pubchemCid":1570,"mass":127.17,"charge":0,"smiles":"C1=CC(=S)N(C=C1)O","inchikey":"YBBJKCMMCRQZMA-UHFFFAOYSA-N","iupac":"1-hydroxypyridine-2-thione","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"1570","atoms":13,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-2.315,"y":1.18,"z":0.022,"el":"S"},{"x":-1.434,"y":-1.728,"z":-0.034,"el":"O"},{"x":-0.416,"y":-0.764,"z":0.003,"el":"N"},{"x":-0.74,"y":0.579,"z":0.007,"el":"C"},{"x":0.854,"y":-1.278,"z":0.026,"el":"C"},{"x":0.454,"y":1.493,"z":-0.02,"el":"C"},{"x":1.907,"y":-0.454,"z":0.013,"el":"C"},{"x":1.69,"y":0.972,"z":-0.018,"el":"C"},{"x":0.959,"y":-2.357,"z":0.04,"el":"H"},{"x":0.301,"y":2.567,"z":-0.039,"el":"H"},{"x":2.923,"y":-0.829,"z":0.023,"el":"H"},{"x":2.562,"y":1.617,"z":-0.037,"el":"H"},{"x":-1.8,"y":-1.568,"z":-0.921,"el":"H"}],"bonds":[[0,3,2],[1,2,1],[1,12,1],[2,3,1],[2,4,1],[3,5,1],[4,6,2],[4,8,1],[5,7,2],[5,9,1],[6,7,1],[6,10,1],[7,11,1]]},"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q2119951","license":"CC0 1.0"},{"ro
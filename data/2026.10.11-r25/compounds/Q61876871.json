{"version":"2026.10.11-r25","id":"Q61876871","formula":"C₁₈H₂₅O₆P","hill":"C18H25O6P","elements":["H","C","O","P"],"composition":{"C":18.0,"H":25.0,"O":6.0,"P":1.0},"names":{"en":"Estriol phosphate"},"descriptions":{"en":"Estriol phosphate (E3P), or estriol 17β-phosphate, also known as estra-1,3,5(10)-triene-3,16α,17β-triol 17β-(dihydrogen phosphate), is an estrogen which was never marketed. It is an estrogen ester, specifically an ester of estriol with phosphoric acid, and acts as a prodrug of estriol by cleavage via phosphatase enzymes in the body. Estriol phosphate is contained within the chemical structure of polyestriol phosphate (a polymer of estriol phosphate), and this medication has been marketed for medical use (brand names Gynäsan, Klimadurin, Triodurin)."},"fame":1,"pubchemCid":139033615,"mass":368.4,"charge":0,"smiles":"C[C@]12CC[C@H]3[C@H]([C@@H]1C[C@H]([C@@H]2OP(=O)(O)O)O)CCC4=C3C=CC(=C4)O","inchikey":"HNKVQSMSAFUELQ-ZXXIGWHRSA-N","iupac":"[(8R,9S,13S,14S,16R,17R)-3,16-dihydroxy-13-methyl-6,7,8,9,11,12,14,15,16,17-decahydrocyclopenta[a]phenanthren-17-yl] dihydrogen phosphate","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"rdkit","ref":"139033615","atoms":50,"license":"Computed with RDKit from SMILES (PubChem, Wikidata)"},"structure":{"kind":"molecule","atoms":[{"x":1.819,"y":-1.392,"z":-0.448,"el":"C"},{"x":1.513,"y":-0.243,"z":0.545,"el":"C"},{"x":0.854,"y":-0.822,"z":1.802,"el":"C"},{"x":-0.574,"y":-1.328,"z":1.52,"el":"C"},{"x":-1.478,"y":-0.285,"z":0.808,"el":"C"},{"x":-0.767,"y":0.325,"z":-0.439,"el":"C"},{"x":0.595,"y":0.868,"z":-0.009,"el":"C"},{"x":1.468,"y":1.608,"z":-1.028,"el":"C"},{"x":2.903,"y":1.439,"z":-0.49,"el":"C"},{"x":2.772,"y":0.602,"z":0.806,"el":"C"},{"x":3.933,"y":-0.171,"z":1.044,"el":"O"},{"x":5.161,"y":0.592,"z":1.739,"el":"P"},{"x":4.874,"y":1.342,"z":2.992,"el":"O"},{"x":6.278,"y":-0.542,"z":1
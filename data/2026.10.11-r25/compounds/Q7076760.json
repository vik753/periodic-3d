{"version":"2026.10.11-r25","id":"Q7076760","formula":"C₁₇H₃₂BrNO₂","hill":"C17H32BrNO2","elements":["H","C","N","O","Br"],"composition":{"C":17.0,"H":32.0,"N":1.0,"O":2.0,"Br":1.0},"names":{"en":"Anisotropine methylbromide"},"descriptions":{"en":"Octatropine methylbromide (INN) or anisotropine methylbromide (USAN), trade names Valpin, Endovalpin, Lytispasm and others, is a muscarinic antagonist and antispasmodic. It was introduced to the U.S. market in 1963 as an adjunct in the treatment of peptic ulcer, and promoted as being more specific to the gastrointestinal tract than other anticholinergics, although its selectivity was questioned in later studies. Octatropine has been superseded by more effective agents in the treatment of peptic ulcer disease, and is no longer used."},"fame":4,"pubchemCid":21867154,"mass":362.3,"charge":0,"smiles":"CCCC(CCC)C(=O)OC1CC2CCC(C1)[N+]2(C)C.[Br-]","inchikey":"QSFKGMJOKUZAJM-UHFFFAOYSA-M","iupac":"(8,8-dimethyl-8-azoniabicyclo[3.2.1]octan-3-yl) 2-propylpentanoate bromide","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"rdkit","ref":"21867154","atoms":53,"license":"Computed with RDKit from SMILES (PubChem, Wikidata)"},"structure":{"kind":"molecule","atoms":[{"x":-1.158,"y":0.911,"z":3.428,"el":"C"},{"x":-2.62,"y":1.027,"z":3.032,"el":"C"},{"x":-3.15,"y":-0.142,"z":2.19,"el":"C"},{"x":-2.519,"y":-0.252,"z":0.788,"el":"C"},{"x":-3.427,"y":-1.01,"z":-0.2,"el":"C"},{"x":-4.596,"y":-0.159,"z":-0.705,"el":"C"},{"x":-5.441,"y":-0.923,"z":-1.713,"el":"C"},{"x":-1.193,"y":-0.995,"z":0.834,"el":"C"},{"x":-0.907,"y":-1.904,"z":1.599,"el":"O"},{"x":-0.35,"y":-0.515,"z":-0.132,"el":"O"},{"x":0.907,"y":-1.214,"z":-0.277,"el":"C"},{"x":1.372,"y":-1.014,"z":-1.73,"el":"C"},{"x":2.23,"y":0.244,"z":-1.945,"el":"C"},{"x":1.472,"y":1.509,"z":-1.511,"el":"C"},{"x":1.788,"y":1.684,"z":-0.022,"el":"C"},{"x":2.718,"y":0.516,"z
{"version":"2026.10.11-r25","id":"Q143629","formula":"C₁₈H₂₃NO₂","hill":"C18H23NO2","elements":["H","C","N","O"],"composition":{"C":18.0,"H":23.0,"N":1.0,"O":2.0},"names":{"en":"Acrylonitrile styrene acrylate"},"descriptions":{"en":"Acrylonitrile styrene acrylate (ASA), also called acrylic styrene acrylonitrile, is an amorphous thermoplastic developed as an alternative to acrylonitrile butadiene styrene (ABS), that has improved weather resistance. It is an acrylate rubber-modified styrene acrylonitrile copolymer. It is used for general prototyping in 3D printing, where its UV resistance and mechanical properties make it an excellent material for use in fused filament fabrication printers, particularly for outdoor applications."},"fame":11,"pubchemCid":null,"mass":null,"charge":0,"smiles":null,"inchikey":null,"iupac":null,"classes":[{"qid":"Q11474","names":{"en":"plastic","ru":"пластмасса","uk":"пластмаси"}},{"qid":"Q421281","names":{"en":"copolymer","ru":"сополимеры","uk":"Кополімер"}}],"structureInfo":null,"structure":null,"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q143629","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Acrylonitrile_styrene_acrylate","license":"CC BY-SA 4.0"}],"similar":[{"id":"Q27105777","formula":"C₁₀H₁₂O","names":{"en":"Anethol","ru":"Анетол","uk":"Анетол"},"elements":["H","C","O"],"fame":32,"kind":"molecule"},{"id":"Q415563","formula":"C₂₀H₂₄O₂","names":{"en":"Ethinylestradiol","ru":"Этинилэстрадиол"},"elements":["H","C","O"],"fame":32,"kind":"molecule"},{"id":"Q415122","formula":"C₃₂H₃₉NO₄","names":{"en":"Fexofenadine","ru":"Фексофенадин","uk":"Фексофенадин"},"elements":["H","C","N","O"],"fame":31,"kind":"molecule"},{"id":"Q421344","formula":"C₁₀H₁₂O","names":{"en":"Butyrophenone","ru":"Бутирофенон"},"elements":["H","C","O"],"fame":25,"kind":"molecule"},{"id":"Q418819","formula":"C₂₀H₂₄O₂","names":{"en":"Exemestane","ru":"Exemestan","uk":"Ексеме
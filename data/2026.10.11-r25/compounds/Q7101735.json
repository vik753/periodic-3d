{"version":"2026.10.11-r25","id":"Q7101735","formula":"C₂₄H₃₅N₃O₂","hill":"C24H35N3O2","elements":["H","C","N","O"],"composition":{"C":24.0,"H":35.0,"N":3.0,"O":2.0},"names":{"en":"Org 28312"},"descriptions":{"en":"Org 28312 is a drug developed by Organon International which acts as a potent cannabinoid receptor full agonist at both the CB1 and CB2 receptors. It was developed with the aim of finding a water-soluble cannabinoid agonist suitable for intravenous use as an analgesic, but did not proceed to human trials, with the related compound Org 28611 chosen instead due to its better penetration into the brain. The structure-activity relationships of these compounds have subsequently been investigated further leading to the development of a number of more potent analogues, derived by cyclisation around the indole or piperazine rings."},"fame":3,"pubchemCid":10069407,"mass":397.6,"charge":0,"smiles":"CC1CN(CC(N1C)C)C(=O)C2=CN(C3=C2C=CC=C3OC)CC4CCCCC4","inchikey":"DMYGECJTVMCGEP-UHFFFAOYSA-N","iupac":"[1-(cyclohexylmethyl)-7-methoxyindol-3-yl]-(3,4,5-trimethylpiperazin-1-yl)methanone","classes":[{"qid":"Q59199015","names":{"en":"group of stereoisomers","ru":"группа стереоизомеров","uk":"група стереоізомерів"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"10069407","atoms":64,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":2.244,"y":1.133,"z":-2.581,"el":"O"},{"x":-3.579,"y":2.101,"z":0.784,"el":"O"},{"x":4.585,"y":-1.107,"z":1.177,"el":"N"},{"x":2.632,"y":-0.338,"z":-0.824,"el":"N"},{"x":-1.724,"y":0.446,"z":-0.951,"el":"N"},{"x":-3.357,"y":-1.226,"z":-0.152,"el":"C"},{"x":-2.292,"y":-2.329,"z":-0.218,"el":"C"},{"x":-4.756,"y":-1.804,"z":-0.406,"el":"C"},{"x":-3.044,"y":-0.113,"z":-1.15,"el":"C"},{"x":-2.611,"y":-3.48,"z":0.733,"el":"C"},{"x":-5.072,"y":-2.955,"z":0.546,"el":"C"},{"x":-4.006,"y":-4.045,"z":0.484,"el":"C"},{"x":4.976,"y":-0.355,"z":-0.038,"el":"C"},{"x":3.171,"y":-0.867,"z":1.545,"el":"C"},{"x":4.01
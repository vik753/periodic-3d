{"version":"2026.10.11-r25","id":"Q4637107","formula":"C₁₁H₁₇NO₂Br","hill":"C11H17BrNO2","elements":["H","C","N","O","Br"],"composition":{"C":11.0,"H":17.0,"N":1.0,"O":2.0,"Br":1.0},"names":{"en":"4-Br-3,5-DMA"},"descriptions":{"en":"4-Br-3,5-DMA, also known as 4-bromo-3,5-dimethoxyamphetamine, 3C-DBR, or 4-bromo-TMA, is a psychoactive drug of the phenethylamine, amphetamine, and 3C-desoxyscaline families related to mescaline. It is the analogue of TMA in which the methoxy group at the 4 position has been replaced with a bromine atom. In addition, 4-Br-3,5-DMA is a positional isomer of DOB with the methoxy group at the 2 position located instead at the 3 position."},"fame":5,"pubchemCid":208044,"mass":274.15,"charge":0,"smiles":"CC(CC1=CC(=C(C(=C1)OC)Br)OC)N","inchikey":"FAVLJTSHWBEOMA-UHFFFAOYSA-N","iupac":"1-(4-bromo-3,5-dimethoxyphenyl)propan-2-amine","classes":[{"qid":"Q59199015","names":{"en":"group of stereoisomers","ru":"группа стереоизомеров","uk":"група стереоізомерів"}}],"structureInfo":null,"structure":null,"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q4637107","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/4-Bromo-3%2C5-dimethoxyamphetamine","license":"CC BY-SA 4.0"},{"role":"properties","name":"PubChem","url":"https://pubchem.ncbi.nlm.nih.gov/compound/208044","license":"PubChem (NIH), public data"}],"similar":[{"id":"Q424294","formula":"C₂₀H₃₀BrNO₃","names":{"en":"Ipratropium bromide","ru":"Ипратропия бромид","uk":"Іпратропію бромід"},"elements":["H","C","N","O","Br"],"fame":31,"kind":"molecule"},{"id":"Q419361","formula":"C₂₁H₃₀BrNO₄","names":{"en":"Butylscopolamine bromide"},"elements":["H","C","N","O","Br"],"fame":26,"kind":"molecule"},{"id":"Q27162963","formula":"C₁₉H₂₈BrNO₃","names":{"en":"Glycopyrronium bromide"},"elements":["H","C","N","O","Br"],"fame":20,"kind":"molecule"},{"id":"Q15053666","formula":"C₂₄H₃₃Cl₂NO₅","names":{"en":"Vilanterol"},"elemen
{"version":"2026.10.11-r25","id":"Q27281594","formula":"C₂₅H₃₈N₂O₂","hill":"C25H38N2O2","elements":["H","C","N","O"],"composition":{"C":25.0,"H":38.0,"N":2.0,"O":2.0},"names":{"en":"Prostanozol"},"descriptions":{"en":"Prostanozol, also known as demethylstanozolol tetrahydropyran ether, is an androgen/anabolic steroid (AAS) and designer steroid which acts as a prodrug of the 17α-demethylated analogue of stanozolol (Winstrol). It was found in 2005 as an ingredient of products sold as \"dietary supplements\" for bodybuilding. It is one of hundreds of drugs banned from the Olympics by the IOC. Russian marathon runner Lyubov Denisova was banned for two years from competition after testing positive for prostanozol and testosterone in 2007."},"fame":3,"pubchemCid":56842253,"mass":398.6,"charge":0,"smiles":"C[C@]12CC[C@H]3[C@H]([C@@H]1CC[C@@H]2OC4CCCCO4)CC[C@@H]5[C@@]3(CC6=C(C5)NN=C6)C","inchikey":"AGJAMJZFPDQSEW-KOTDIDPQSA-N","iupac":"(1S,2S,10S,13R,14S,17S,18S)-2,18-dimethyl-17-(oxan-2-yloxy)-6,7-diazapentacyclo[11.7.0.02,10.04,8.014,18]icosa-4(8),5-diene","classes":[{"qid":"Q59199015","names":{"en":"group of stereoisomers","ru":"группа стереоизомеров","uk":"група стереоізомерів"}}],"structureInfo":{"kind":"molecule","source":"rdkit","ref":"56842253","atoms":67,"license":"Computed with RDKit from SMILES (PubChem, Wikidata)"},"structure":{"kind":"molecule","atoms":[{"x":1.386,"y":-0.014,"z":1.768,"el":"C"},{"x":1.277,"y":-0.333,"z":0.255,"el":"C"},{"x":0.824,"y":0.925,"z":-0.5,"el":"C"},{"x":-0.633,"y":1.297,"z":-0.169,"el":"C"},{"x":-1.631,"y":0.125,"z":-0.357,"el":"C"},{"x":-1.145,"y":-1.176,"z":0.354,"el":"C"},{"x":0.293,"y":-1.469,"z":-0.092,"el":"C"},{"x":0.985,"y":-2.719,"z":0.44,"el":"C"},{"x":2.479,"y":-2.444,"z":0.206,"el":"C"},{"x":2.592,"y":-0.973,"z":-0.254,"el":"C"},{"x":3.765,"y":-0.402,"z":0.31,"el":"O"},{"x":4.377,"y":0.581,"z":-0.522,"el":"C"},{"x":5.42,"y":1.328,"z":0.322,"el":"C"},{"x":6.568,"y":1.825,"z":-0.542,"el":"C"},{"x":7.219,"y":0.659,"z":-1.286,
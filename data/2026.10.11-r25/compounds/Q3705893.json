{"version":"2026.10.11-r25","id":"Q3705893","formula":"Cu₄(UO₂)(SeO₃)₂(OH)₆","hill":"Cu4H6O14Se2U","elements":["H","O","Cu","Se","U"],"composition":{"H":6.0,"O":14.0,"U":1.0,"Cu":4.0,"Se":2.0},"names":{"en":"Derriksite"},"descriptions":{"en":"Derriksite is a very rare uranium mineral with the chemical formula Cu4(UO2)(SeO3)2(OH)6•H2O. It is a secondary mineral that contains copper, uranium and the rarer selenium. It is a bright green to duller bottle green colour. Its crystal habit is acicular, it is most likely to be found along with the uranyl selenium mineral demesmaekerite, but derriksite is much rarer than demesmaekerite."},"fame":9,"pubchemCid":null,"mass":null,"charge":0,"smiles":null,"inchikey":null,"iupac":null,"classes":[{"qid":"Q12089225","names":{"en":"mineral species","ru":"действительный вид минералов","uk":"мінеральний вид"}}],"structureInfo":null,"structure":null,"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q3705893","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Derriksite","license":"CC BY-SA 4.0"},{"role":"photo","name":"Wikimedia Commons","url":"https://commons.wikimedia.org/wiki/File:Derriksite-Malachite-201074.jpg","license":"CC BY-SA 3.0"}],"similar":[{"id":"Q639258","formula":"Cu₃(TeO₄)(OH)₄","names":{"en":"Xocomecatlite","uk":"Ксокомекатліт"},"elements":["H","O","Cu","Te"],"fame":11,"kind":null},{"id":"Q780935","formula":"NaCaCu₅(AsO₄)₄Cl·5H₂O","names":{"en":"Lavendulan","ru":"Лавендулан"},"elements":["H","O","Na","Cl","Ca","Cu","As"],"fame":11,"kind":null},{"id":"Q3705271","formula":"Pb₂Cu₅(UO₂)₂(SeO₃)₆(OH)₆·2H₂O","names":{"en":"Demesmaekerite","uk":"Демесмекерит"},"elements":["H","O","Cu","Se","Pb","U"],"fame":9,"kind":null},{"id":"Q3665592","formula":"Cu₃TeO₄(OH)₄","names":{"en":"Cesbronite"},"elements":["H","O","Cu","Te"],"fame":7,"kind":null},{"id":"Q4023961","formula":"NaPbCu₅(AsO₄)₄Cl·5H₂O","names":{"en":"Zdenĕkite","uk":"Зденекіт"},"eleme
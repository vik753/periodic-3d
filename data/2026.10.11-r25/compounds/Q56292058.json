{"version":"2026.10.11-r25","id":"Q56292058","formula":"C₄H₁₂FN","hill":"C4H12FN","elements":["H","C","N","F"],"composition":{"C":4.0,"F":1.0,"H":12.0,"N":1.0},"names":{"en":"Tetramethylammonium fluoride"},"descriptions":{"en":"Tetramethyl­ammonium fluoride, commonly abbreviated TMAF, is the quaternary ammonium salt with the formula (CH3)4NF. This hygroscopic white solid is a source of “naked fluoride\": fluoride ions not complexed with a metal atom. Most other soluble salts of fluoride are in fact bifluorides, HF2–. Historically, there have been two main approaches to prepare tetramethyl­ammonium fluoride: hydrofluoric acid neutralization of tetramethyl­ammonium hydroxide, and salt metathesis between different ammonium salts and inorganic fluoride sources, such as KF or CsF."},"fame":4,"pubchemCid":67803,"mass":93.14,"charge":0,"smiles":"C[N+](C)(C)C.[F-]","inchikey":"GTDKXDWWMOMSFL-UHFFFAOYSA-M","iupac":"tetramethylazanium fluoride","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"rdkit","ref":"67803","atoms":18,"license":"Computed with RDKit from SMILES (PubChem, Wikidata)"},"structure":{"kind":"molecule","atoms":[{"x":0.44,"y":-1.209,"z":-0.749,"el":"C"},{"x":-0.132,"y":-0.031,"z":0.027,"el":"N"},{"x":-1.585,"y":-0.313,"z":0.38,"el":"C"},{"x":0.67,"y":0.172,"z":1.304,"el":"C"},{"x":-0.053,"y":1.226,"z":-0.828,"el":"C"},{"x":0.375,"y":-2.102,"z":-0.12,"el":"H"},{"x":-0.148,"y":-1.34,"z":-1.662,"el":"H"},{"x":1.483,"y":-0.989,"z":-0.994,"el":"H"},{"x":-1.979,"y":0.542,"z":0.937,"el":"H"},{"x":-2.146,"y":-0.457,"z":-0.548,"el":"H"},{"x":-1.623,"y":-1.219,"z":0.994,"el":"H"},{"x":0.602,"y":-0.739,"z":1.905,"el":"H"},{"x":0.246,"y":1.022,"z":1.848,"el":"H"},{"x":1.71,"y":0.374,"z":1.032,"el":"H"},{"x":-0.634,"y":1.062,"z":-1.74,"el":"H"},{"x":0.997,"y":1.413,"z":-1.072,"el":"H"},{"x":-0.467,"y":2.061,"z":-0.255,"el":"H"},{"x":2.252,"y":0.5
{"version":"2026.10.11-r25","id":"Q15628375","formula":"BiI₃O₉","hill":"BiI3O9","elements":["O","I","Bi"],"composition":{"I":3.0,"O":9.0,"Bi":1.0},"names":{"en":"Bismuth iodate","ru":"Иодат висмута(III)"},"descriptions":{"en":"Bismuth iodate is an inorganic compound with the chemical formula Bi(IO3)3. Its anhydrate can be obtained by reacting bismuth nitrate and iodic acid, dissolving the resulting precipitate in 7.8 mol/L nitric acid, and heating to volatilize and crystallize at 70 °C; The dihydrate can be obtained by reacting bismuth nitrate and potassium iodate or sodium iodate. It is obtained by evaporation and crystallization in 7 mol/L nitric acid at 50 °C. Its basic salt BiOIO3 is known.","ru":"Иодат висмута(III) — неорганическое соединение, соль висмута и иодноватой кислоты с формулой Bi(IO3)3, бесцветные кристаллы, не растворяется в воде, образует кристаллогидрат."},"fame":6,"pubchemCid":3014773,"mass":733.69,"charge":0,"smiles":"[O-]I(=O)=O.[O-]I(=O)=O.[O-]I(=O)=O.[Bi+3]","inchikey":"FGQDLCIITXBKAR-UHFFFAOYSA-K","iupac":"bismuth triiodate","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"crystal","source":"materialsproject","ref":"mp-31259","atoms":52,"license":"CC BY 4.0, Materials Project"},"structure":{"cell":[[8.844,0.0,0.0],[0.0,5.948,0.0],[-6.942,0.0,15.188]],"kind":"crystal","atoms":[{"x":1.546,"y":4.292,"z":9.166,"el":"Bi"},{"x":-3.116,"y":1.319,"z":13.617,"el":"Bi"},{"x":0.355,"y":1.655,"z":6.022,"el":"Bi"},{"x":5.017,"y":4.629,"z":1.572,"el":"Bi"},{"x":-4.107,"y":5.357,"z":10.646,"el":"I"},{"x":2.537,"y":2.383,"z":12.136,"el":"I"},{"x":6.008,"y":0.591,"z":4.542,"el":"I"},{"x":-0.636,"y":3.565,"z":3.052,"el":"I"},{"x":3.966,"y":2.124,"z":7.915,"el":"I"},{"x":-5.536,"y":5.098,"z":14.867,"el":"I"},{"x":-2.065,"y":3.824,"z":7.273,"el":"I"},{"x":7.437,"y":0.85,"z":0.321,"el":"I"},{"x":2.605,"y":4.846,"z":5.347,"el":"I"},{"x":2.767,"y":1.872,"z
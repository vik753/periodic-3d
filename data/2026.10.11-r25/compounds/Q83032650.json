{"version":"2026.10.11-r25","id":"Q83032650","formula":"EuI₃O₉","hill":"EuI3O9","elements":["O","I","Eu"],"composition":{"I":3.0,"O":9.0,"Eu":1.0},"names":{"en":"Europium triiodate"},"descriptions":{"en":"Europium(III) iodate is an inorganic compound with the chemical formula Eu(IO3)3. It can be produced by hydrothermal reaction of europium(III) nitrate or europium(III) oxide and iodic acid in water at 230 °C. It can be thermally decomposed as follows: 7 Eu(IO3)3 → Eu5(IO6)3 + Eu2O3 + 9 I2 + 21 O2 It reacts hydrothermally with iodine pentoxide and molybdenum trioxide at 200 °C to obtain Eu(MoO2)(IO3)4(OH)."},"fame":4,"pubchemCid":44146080,"mass":676.67,"charge":0,"smiles":"[O-]I(=O)=O.[O-]I(=O)=O.[O-]I(=O)=O.[Eu+3]","inchikey":"HQQLAVIUDCPDOA-UHFFFAOYSA-K","iupac":"europium(3+) triiodate","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"crystal","source":"materialsproject","ref":"mp-556079","atoms":52,"license":"CC BY 4.0, Materials Project"},"structure":{"cell":[[8.948,0.0,0.0],[0.0,6.071,0.0],[-7.14,0.0,15.433]],"kind":"crystal","atoms":[{"x":4.84,"y":1.637,"z":6.165,"el":"Eu"},{"x":1.27,"y":1.398,"z":13.882,"el":"Eu"},{"x":0.538,"y":4.673,"z":1.551,"el":"Eu"},{"x":-3.032,"y":4.433,"z":9.267,"el":"Eu"},{"x":-0.539,"y":2.197,"z":8.055,"el":"I"},{"x":0.224,"y":5.52,"z":10.771,"el":"I"},{"x":-1.987,"y":2.484,"z":12.378,"el":"I"},{"x":-1.895,"y":4.934,"z":5.435,"el":"I"},{"x":3.794,"y":3.586,"z":3.054,"el":"I"},{"x":7.273,"y":1.898,"z":2.281,"el":"I"},{"x":3.031,"y":0.839,"z":0.338,"el":"I"},{"x":2.346,"y":3.874,"z":7.378,"el":"I"},{"x":-5.465,"y":4.172,"z":13.151,"el":"I"},{"x":1.583,"y":0.551,"z":4.662,"el":"I"},{"x":-1.224,"y":5.232,"z":15.094,"el":"I"},{"x":3.703,"y":1.137,"z":9.997,"el":"I"},{"x":-2.322,"y":2.374,"z":7.567,"el":"O"},{"x":4.221,"y":0.609,"z":8.321,"el":"O"},{"x":-3.949,"y":2.396,"z":10.353,"el":"O"},{"x":0.556,"y":1.102,"z":11.487,"el":"O"
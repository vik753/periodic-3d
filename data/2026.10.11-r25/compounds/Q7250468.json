{"version":"2026.10.11-r25","id":"Q7250468","formula":"C₁₂H₁₉N","hill":"C12H19N","elements":["H","C","N"],"composition":{"C":12.0,"H":19.0,"N":1.0},"names":{"en":"(RS)-propylamphetamine"},"descriptions":{"en":"Propylamphetamine (code name PAL-424; also known as N-propylamphetamine or NPA) is a central nervous system psychostimulant and substituted amphetamine which was never marketed. It was first developed in the 1970s, mainly for research into the metabolism of, and as a comparison tool to, other amphetamines. Propylamphetamine is inactive as a dopamine releasing agent in vitro and instead acts as a low-potency dopamine reuptake inhibitor with an IC50Tooltip half-maximal inhibitory concentration of 1,013 nM. The drug can be N-dealkylated to form amphetamine (10–20% excreted in urine after 24 hours)."},"fame":8,"pubchemCid":103544,"mass":177.29,"charge":0,"smiles":"CCCNC(C)CC1=CC=CC=C1","inchikey":"SNPGTHLGFHVIDA-UHFFFAOYSA-N","iupac":"1-phenyl-N-propylpropan-2-amine","classes":[{"qid":"Q59199015","names":{"en":"group of stereoisomers","ru":"группа стереоизомеров","uk":"група стереоізомерів"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"103544","atoms":32,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":2.199,"y":0.235,"z":0.618,"el":"N"},{"x":0.889,"y":0.043,"z":-0.01,"el":"C"},{"x":-0.221,"y":0.329,"z":1.018,"el":"C"},{"x":3.265,"y":0.03,"z":-0.348,"el":"C"},{"x":0.824,"y":-1.382,"z":-0.56,"el":"C"},{"x":-1.615,"y":0.198,"z":0.456,"el":"C"},{"x":4.626,"y":0.235,"z":0.312,"el":"C"},{"x":-2.228,"y":1.306,"z":-0.106,"el":"C"},{"x":-2.257,"y":-1.029,"z":0.513,"el":"C"},{"x":5.759,"y":0.047,"z":-0.685,"el":"C"},{"x":-3.517,"y":1.184,"z":-0.626,"el":"C"},{"x":-3.546,"y":-1.151,"z":-0.006,"el":"C"},{"x":-4.176,"y":-0.044,"z":-0.576,"el":"C"},{"x":0.773,"y":0.747,"z":-0.845,"el":"H"},{"x":-0.098,"y":1.343,"z":1.425,"el":"H"},{"x":-0.118,"y":-0.342,"z":1.883,"el":"H"},{"x":2.259,"y":1.177,"z":1.004,"el":"H"},{"x":3.282
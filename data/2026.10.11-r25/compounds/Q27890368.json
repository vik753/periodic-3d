{"version":"2026.10.11-r25","id":"Q27890368","formula":"C₂₀H₂₀ClN₃","hill":"C20H20ClN3","elements":["H","C","N","Cl"],"composition":{"C":20.0,"H":20.0,"N":3.0,"Cl":1.0},"names":{"en":"JNJ-18038683 free base"},"descriptions":{"en":"JNJ-18038683 is a potent and selective antagonist of the 5HT7 serotonin receptor discovered by Johnson & Johnson. It has nootropic and antidepressant effects in both animal and human studies and has progressed to Phase II trials as an adjunctive treatment for improving cognition and mood in stable bipolar disorder; it has been found to reduce REM sleep (the lightest stage of sleep, elevated in depression) in humans and block circadian rhythm phase-shift advances in mice. It binds to the 5-HT6 serotonin receptor with 10x less affinity."},"fame":1,"pubchemCid":11151899,"mass":337.8,"charge":0,"smiles":"C1CNCCC2=C1C(=NN2CC3=CC=CC=C3)C4=CC=C(C=C4)Cl","inchikey":"UKJPMZGILXATGT-UHFFFAOYSA-N","iupac":"1-benzyl-3-(4-chlorophenyl)-5,6,7,8-tetrahydro-4H-pyrazolo[4,5-d]azepine","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"11151899","atoms":44,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":6.41,"y":-2.166,"z":-0.382,"el":"Cl"},{"x":-1.05,"y":0.202,"z":0.923,"el":"N"},{"x":-0.399,"y":4.299,"z":-0.678,"el":"N"},{"x":0.031,"y":-0.594,"z":0.982,"el":"N"},{"x":-0.845,"y":1.361,"z":0.231,"el":"C"},{"x":0.464,"y":1.32,"z":-0.198,"el":"C"},{"x":-1.889,"y":2.396,"z":0.03,"el":"C"},{"x":1.166,"y":2.352,"z":-1.002,"el":"C"},{"x":-1.369,"y":3.809,"z":0.31,"el":"C"},{"x":0.96,"y":3.777,"z":-0.478,"el":"C"},{"x":0.951,"y":0.09,"z":0.297,"el":"C"},{"x":-2.268,"y":-0.238,"z":1.565,"el":"C"},{"x":2.273,"y":-0.458,"z":0.133,"el":"C"},{"x":-3.124,"y":-1.043,"z":0.624,"el":"C"},{"x":3.262,"y":-0.172,"z":1.071,"el":"C"},{"x":2.556,"y":-1.268,"z":-0.963,"el":"C"},{"x":-2.959,"y":-2.42,"z
{"version":"2026.10.11-r25","id":"Q26827841","formula":"C₂₁H₂₇ClO₂","hill":"C21H27ClO2","elements":["H","C","O","Cl"],"composition":{"C":21.0,"H":27.0,"O":2.0,"Cl":1.0},"names":{"en":"Chloroethynyl norgestrel"},"descriptions":{"en":"Chloroethynylnorgestrel (developmental code name WY-4355) is a steroidal progestin of the 19-nortestosterone group related to norgestrel that was investigated as an oral contraceptive in the 1970s but was never marketed. In combination with mestranol, similarly to ethynerone and anagestone acetate (and certain other progestogens, including progesterone and several other 17α-hydroxyprogesterone derivatives), chloroethynylnorgestrel was found to produce striking mammary tumors in beagle dogs after administration at very high dosages (10- to 25-fold human clinical dosages) for prolonged periods of time."},"fame":1,"pubchemCid":22790422,"mass":346.9,"charge":0,"smiles":"CC[C@]12CC[C@H]3[C@H]([C@@H]1CC[C@]2(C#CCl)O)CCC4=CC(=O)CC[C@H]34","inchikey":"MISOWVVRHHLGIK-ZUHHCLADSA-N","iupac":"(8R,9S,10R,13S,14S,17S)-17-(2-chloroethynyl)-13-ethyl-17-hydroxy-1,2,6,7,8,9,10,11,12,14,15,16-dodecahydrocyclopenta[a]phenanthren-3-one","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"22790422","atoms":51,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":4.061,"y":-4.184,"z":0.223,"el":"Cl"},{"x":4.43,"y":0.766,"z":-0.755,"el":"O"},{"x":-6.255,"y":-1.254,"z":-0.029,"el":"O"},{"x":1.983,"y":0.605,"z":-0.399,"el":"C"},{"x":1.188,"y":0.349,"z":0.901,"el":"C"},{"x":-0.28,"y":0.772,"z":0.794,"el":"C"},{"x":-0.956,"y":-0.03,"z":-0.356,"el":"C"},{"x":3.416,"y":0.196,"z":0.061,"el":"C"},{"x":1.343,"y":-0.231,"z":-1.521,"el":"C"},{"x":2.057,"y":0.988,"z":1.983,"el":"C"},{"x":-0.159,"y":0.073,"z":-1.681,"el":"C"},{"x":-2.45,"y":0.384,"z":-0.526,"el":"C"},{"x":3.505,"y":0.793,"z":1.489,"el":
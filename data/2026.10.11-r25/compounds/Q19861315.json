{"version":"2026.10.11-r25","id":"Q19861315","formula":"FeCe(MoO₄)₃·3H₂O","hill":"CeFeH6Mo3O15","elements":["H","O","Fe","Mo","Ce"],"composition":{"H":6.0,"O":15.0,"Ce":1.0,"Fe":1.0,"Mo":3.0},"names":{"en":"Tancaite-(Ce)"},"descriptions":{"en":"Tancaite-(Ce) is a very rare molybdate mineral with the formula FeCe(MoO4)3•3H2O. It was found in Punta de Su Seinargiu locality on Sardinia, Italy. Red crystals of tancaite-(Ce) resemble modified cubes, but the mineral is trigonal (space group R-3). The type locality of tancaite-(Ce) is also a place of discovery of other molybdate minerals, including thorium molybdates ichnusaite and nuragheite."},"fame":6,"pubchemCid":null,"mass":null,"charge":0,"smiles":null,"inchikey":null,"iupac":null,"classes":[{"qid":"Q12089225","names":{"en":"mineral species","ru":"действительный вид минералов","uk":"мінеральний вид"}}],"structureInfo":null,"structure":null,"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q19861315","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Tancaite-%28Ce%29","license":"CC BY-SA 4.0"},{"role":"photo","name":"Wikimedia Commons","url":"https://commons.wikimedia.org/wiki/File:Tancaite-(Ce).jpg","license":"CC BY 4.0"}],"similar":[{"id":"Q409100","formula":"K₂(UO₂)₂(VO₄)₂·3H₂O","names":{"en":"Carnotite","ru":"Карнотит","uk":"Карнотит"},"elements":["H","O","K","V","U"],"fame":36,"kind":null},{"id":"Q3633654","formula":"FeMo₂H₅O₁₀","names":{"en":"Bamfordite","uk":"Бамфордит"},"elements":["H","O","Fe","Mo"],"fame":4,"kind":null},{"id":"Q961099","formula":"UMo₅O₁₂(OH)₁₀","names":{"en":"Mourite","uk":"Моурит"},"elements":["H","O","Mo","U"],"fame":4,"kind":null},{"id":"Q412950","formula":"H₂MoO₄","names":{"en":"Molybdic acid","ru":"Молибденовая кислота"},"elements":["H","O","Mo"],"fame":24,"kind":"crystal"},{"id":"Q1146033","formula":"K₂Ca(UO₂)₇(PO₄)₄(OH)₆·6H₂O","names":{"en":"Yingjiangite"},"elements":["H","O","P","K","Ca","U"],"fa
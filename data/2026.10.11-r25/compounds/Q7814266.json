{"version":"2026.10.11-r25","id":"Q7814266","formula":"C₁₁H₁₀N₂O₂","hill":"C11H10N2O2","elements":["H","C","N","O"],"composition":{"C":11.0,"H":10.0,"N":2.0,"O":2.0},"names":{"en":"Tolimidone"},"descriptions":{"en":"Tolimidone (CP-26154; MLR-1023) is a compound which was discovered by scientists at Pfizer, was found to stimulate secretion of gastric mucosa, and was in development by Pfizer as a drug candidate to treat gastric ulcers but was abandoned. After the patent on the compound expired, scientists at the company Melior Discovery identified it as a potential drug candidate for diabetes through a phenotypic screen. The company proceeded to show that MLR-1023 is an allosteric activator of Lyn kinase with an EC50 of 63 nM. As of 2012 Melior was repurposing it for diabetes."},"fame":5,"pubchemCid":39065,"mass":202.21,"charge":0,"smiles":"CC1=CC(=CC=C1)OC2=CNC(=O)N=C2","inchikey":"HJQILFPVRNHTIG-UHFFFAOYSA-N","iupac":"5-(3-methylphenoxy)-1H-pyrimidin-2-one","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"39065","atoms":25,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-0.14,"y":1.521,"z":0.511,"el":"O"},{"x":4.467,"y":-1.123,"z":-0.484,"el":"O"},{"x":3.206,"y":0.171,"z":0.904,"el":"N"},{"x":2.381,"y":-0.529,"z":-1.219,"el":"N"},{"x":-2.653,"y":-1.127,"z":0.277,"el":"C"},{"x":-1.294,"y":0.869,"z":0.205,"el":"C"},{"x":-1.469,"y":-0.46,"z":0.592,"el":"C"},{"x":-3.661,"y":-0.467,"z":-0.424,"el":"C"},{"x":-2.303,"y":1.53,"z":-0.496,"el":"C"},{"x":1.043,"y":0.868,"z":0.303,"el":"C"},{"x":-3.487,"y":0.862,"z":-0.811,"el":"C"},{"x":-2.84,"y":-2.548,"z":0.69,"el":"C"},{"x":2.049,"y":0.848,"z":1.179,"el":"C"},{"x":1.294,"y":0.116,"z":-0.941,"el":"C"},{"x":3.406,"y":-0.529,"z":-0.285,"el":"C"},{"x":-0.701,"y":-0.982,"z":1.157,"el":"H"},{"x":-2.172,"y":2.565,"z":-0.801,"el":"H"},{"x":-4.589,"y":-
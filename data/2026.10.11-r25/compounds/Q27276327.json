{"version":"2026.10.11-r25","id":"Q27276327","formula":"C₁₉H₁₅ClN₂O₅","hill":"C19H15ClN2O5","elements":["H","C","N","O","Cl"],"composition":{"C":19.0,"H":15.0,"N":2.0,"O":5.0,"Cl":1.0},"names":{"en":"Oxazepam hemisuccinate"},"descriptions":{"en":"Oxazepam hemisuccinate (Empracil), is a benzodiazepine derivative which is an ester substituted prodrug of oxazepam. It was developed as a water-soluble benzodiazepine suitable for administration by injection, for use as an anxiolytic and for procedural sedation. It was used medically to a limited extent during the 1970s and 1980s under the brand name Empracil, but fell into disuse following the introduction of midazolam, which is similarly water-soluble and is more potent and effective than oxazepam hemisuccinate for the same medical applications."},"fame":1,"pubchemCid":36754,"mass":386.8,"charge":0,"smiles":"C1=CC=C(C=C1)C2=NC(C(=O)NC3=C2C=C(C=C3)Cl)OC(=O)CCC(=O)O","inchikey":"UCUOKZUJHTYPJT-UHFFFAOYSA-N","iupac":"4-[(7-chloro-2-oxo-5-phenyl-1,3-dihydro-1,4-benzodiazepin-3-yl)oxy]-4-oxobutanoic acid","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"36754","atoms":42,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-5.028,"y":-1.17,"z":2.859,"el":"Cl"},{"x":2.117,"y":-0.973,"z":-0.676,"el":"O"},{"x":0.819,"y":-2.162,"z":-2.626,"el":"O"},{"x":2.307,"y":0.358,"z":1.197,"el":"O"},{"x":7.412,"y":0.891,"z":1.55,"el":"O"},{"x":7.045,"y":-0.32,"z":-0.337,"el":"O"},{"x":-1.134,"y":-2.351,"z":-1.458,"el":"N"},{"x":0.046,"y":0.284,"z":-0.594,"el":"N"},{"x":-2.053,"y":-0.74,"z":0.202,"el":"C"},{"x":-1.191,"y":0.393,"z":-0.25,"el":"C"},{"x":-2.053,"y":-1.981,"z":-0.454,"el":"C"},{"x":0.701,"y":-1.01,"z":-0.513,"el":"C"},{"x":-1.793,"y":1.754,"z":-0.351,"el":"C"},{"x":0.142,"y":-1.859,"z":-1.642,"el":"C"},{"x":-2.966,"y":-0.505,"z":1.243,"el":"C"},{"x":-3.
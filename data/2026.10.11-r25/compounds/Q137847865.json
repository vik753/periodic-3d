{"version":"2026.10.11-r25","id":"Q137847865","formula":"C₄₆H₆₃N₃O₂PS⁺","hill":"C46H63N3O2PS","elements":["H","C","N","O","P","S"],"composition":{"C":46.0,"H":63.0,"N":3.0,"O":2.0,"P":1.0,"S":1.0},"names":{"en":"YC8-02"},"descriptions":{"en":"YC8-02 is a drug which acts as a potent inhibitor of the enzymes sirtuin 2 (SIRT2) and sirtuin 3 (SIRT3). It was developed from an older SIRT2 selective inhibitor thiomyristoyl, but substituted with a triphenylphosphine group which increases affinity to SIRT3 and selectively targets uptake into mitochondria. It is still relatively selective for SIRT2 with an IC50 of 62nM at SIRT2 vs 530nM at SIRT3, but this still makes it one of the most potent SIRT3 inhibitors currently available."},"fame":1,"pubchemCid":177378251,"mass":753.1,"charge":1,"smiles":"CCCCCCCCCCCCCC(=S)NCCCC[C@@H](C(=O)NC1=CC(=CC=C1)O)NCC[P+](C2=CC=CC=C2)(C3=CC=CC=C3)C4=CC=CC=C4","inchikey":"RIVWUGLXBPHZGR-SJARJILFSA-O","iupac":"2-[[(2S)-1-(3-hydroxyanilino)-1-oxo-6-(tetradecanethioylamino)hexan-2-yl]amino]ethyl-triphenylphosphanium","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"rdkit","ref":"177378251","atoms":116,"license":"Computed with RDKit from SMILES (PubChem, Wikidata)"},"structure":{"kind":"molecule","atoms":[{"x":7.535,"y":-3.01,"z":5.465,"el":"C"},{"x":6.568,"y":-2.932,"z":4.295,"el":"C"},{"x":7.03,"y":-3.801,"z":3.126,"el":"C"},{"x":6.06,"y":-3.709,"z":1.946,"el":"C"},{"x":6.506,"y":-4.607,"z":0.79,"el":"C"},{"x":5.563,"y":-4.551,"z":-0.418,"el":"C"},{"x":6.027,"y":-3.621,"z":-1.546,"el":"C"},{"x":6.137,"y":-2.134,"z":-1.204,"el":"C"},{"x":4.789,"y":-1.491,"z":-0.87,"el":"C"},{"x":4.9,"y":-0.02,"z":-0.454,"el":"C"},{"x":5.315,"y":0.904,"z":-1.601,"el":"C"},{"x":5.471,"y":2.368,"z":-1.176,"el":"C"},{"x":4.185,"y":3.074,"z":-0.735,"el":"C"},{"x":3.171,"y":3.239,"z":-1.862,"el":"C"},{"x":3.309,"y":4.511,"z":-2.945,"el":"S"},
{"version":"2026.10.11-r25","id":"Q27077810","formula":"C₂₁H₂₂N₆O","hill":"C21H22N6O","elements":["H","C","N","O"],"composition":{"C":21.0,"H":22.0,"N":6.0,"O":1.0},"names":{"en":"Glasdegib"},"descriptions":{"en":"Glasdegib, sold under the brand name Daurismo, is a medication for the treatment of newly diagnosed acute myeloid leukemia (AML) in adults older than 75 years or those who have comorbidities that preclude use of intensive induction chemotherapy. It is taken by mouth and is used in combination with low-dose cytarabine. The recommended dose of glasdegib is 100 mg orally once daily on days 1 to 28 in combination with cytarabine 20 mg subcutaneously twice daily on days 1 to 10 of each 28-day cycle in the absence of unacceptable toxicity or loss of disease control."},"fame":5,"pubchemCid":25166913,"mass":374.4,"charge":0,"smiles":"CN1CC[C@H](C[C@@H]1C2=NC3=CC=CC=C3N2)NC(=O)NC4=CC=C(C=C4)C#N","inchikey":"SFNSLLSYNZWZQG-VQIMIIECSA-N","iupac":"1-[(2R,4R)-2-(1H-benzimidazol-2-yl)-1-methylpiperidin-4-yl]-3-(4-cyanophenyl)urea","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"25166913","atoms":50,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-2.679,"y":-1.545,"z":-1.454,"el":"O"},{"x":2.322,"y":-2.099,"z":1.019,"el":"N"},{"x":-0.853,"y":-0.729,"z":-0.293,"el":"N"},{"x":3.874,"y":1.108,"z":0.677,"el":"N"},{"x":4.574,"y":-0.582,"z":-0.586,"el":"N"},{"x":-2.925,"y":0.152,"z":0.149,"el":"N"},{"x":-9.601,"y":1.406,"z":0.036,"el":"N"},{"x":2.222,"y":-0.772,"z":0.358,"el":"C"},{"x":0.14,"y":-1.572,"z":-0.916,"el":"C"},{"x":1.497,"y":-0.873,"z":-1.006,"el":"C"},{"x":0.285,"y":-2.898,"z":-0.177,"el":"C"},{"x":0.998,"y":-2.729,"z":1.165,"el":"C"},{"x":3.577,"y":-0.107,"z":0.127,"el":"C"},{"x":2.946,"y":-2.004,"z":2.346,"el":"C"},{"x":5.149,"y":1.44,"z":0.294,"el":"C"},{"x":5.564,"y":0.37,"z":-0.
{"version":"2026.10.11-r25","id":"Q690924","formula":"MnBe(PO₄)OH","hill":"BeHMnO5P","elements":["H","Be","O","P","Mn"],"composition":{"H":1.0,"O":5.0,"P":1.0,"Be":1.0,"Mn":1.0},"names":{"en":"Väyrynenite","uk":"Вяюрюненіт"},"descriptions":{"en":"Väyrynenite is a rare phosphate mineral with formula MnBe(PO4)(OH,F). It was first described in 1954 for an occurrence in Viitaniemi, Erajarvi, Finland and named for mineralogist Heikki Allan Väyrynen of Helsinki, Finland. It occurs in pegmatites as an alteration of beryl and triphylite.","uk":"Вяюрюненіт — рідкісний фосфатний мінерал із формулою MnBe(PO4)(OH,F). Вперше його було описано в 1954 році у Віітаніємі, Ераярві, Фінляндія, і названо на честь мінералога Гейккі Вяйрюнена (1888—1956) з Гельсінкі. Зустрічається в пегматитах як зміна берилу та трифіліту."},"fame":12,"pubchemCid":null,"mass":null,"charge":0,"smiles":null,"inchikey":null,"iupac":null,"classes":[{"qid":"Q12089225","names":{"en":"mineral species","ru":"действительный вид минералов","uk":"мінеральний вид"}}],"structureInfo":null,"structure":null,"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q690924","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/V%C3%A4yrynenite","license":"CC BY-SA 4.0"},{"role":"description","name":"Wikipedia (uk)","url":"https://uk.wikipedia.org/wiki/%D0%92%D1%8F%D1%8E%D1%80%D1%8E%D0%BD%D0%B5%D0%BD%D1%96%D1%82","license":"CC BY-SA 4.0"},{"role":"photo","name":"Wikimedia Commons","url":"https://commons.wikimedia.org/wiki/File:Vayrynenite-177599.jpg","license":"CC BY-SA 3.0"}],"similar":[{"id":"Q3787835","formula":"CaBePO₄(OH)","names":{"en":"Hydroxylherderite","uk":"Гідроксилгердерит"},"elements":["H","Be","O","P","Ca"],"fame":6,"kind":null},{"id":"Q3978313","formula":"MnBO₂(OH)","names":{"en":"Sussexite"},"elements":["H","B","O","Mn"],"fame":9,"kind":null},{"id":"Q412651","formula":"MgAl₂(PO₄)₂(OH)₂","names":{"en":"Lazulite","ru":"Лазулит","uk
{"version":"2026.10.11-r25","id":"Q27895944","formula":"C₁₈H₂₆N₂O₃","hill":"C18H26N2O3","elements":["H","C","N","O"],"composition":{"C":18.0,"H":26.0,"N":2.0,"O":3.0},"names":{"en":"Vsn-16r"},"descriptions":{"en":"VSN16R (SPG601) is a drug which acts as an opener of BKCa large-conductance, calcium-activated potassium channels. It is similar in chemical structure to some cannabinoid derivatives such as methanandamide and CB-86, and was originally thought to be an atypical cannabinoid compound, but pharmacological studies showed it to be inactive at both cannabinoid receptors and related receptors such as GPR55, and eventually it was found to be a selective BKCa channel opener. It has neuroprotective effects and reduces muscle spasticity, and is being researched as a potential therapeutic agent for the treatment of Fragile X syndrome."},"fame":1,"pubchemCid":23730084,"mass":318.4,"charge":0,"smiles":"C[C@H](CO)NC(=O)C1=CC=CC(=C1)/C=C\\CCCC(=O)N(C)C","inchikey":"SVYRYFAUQHVGAI-BMWLXYDHSA-N","iupac":"3-[(Z)-6-(dimethylamino)-6-oxohex-1-enyl]-N-[(2R)-1-hydroxypropan-2-yl]benzamide","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"23730084","atoms":49,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-1.292,"y":-2.713,"z":1.327,"el":"O"},{"x":-3.852,"y":1.203,"z":-1.455,"el":"O"},{"x":2.972,"y":-2.863,"z":0.08,"el":"O"},{"x":0.868,"y":-1.971,"z":-0.31,"el":"N"},{"x":-4.608,"y":0.28,"z":0.533,"el":"N"},{"x":-1.466,"y":2.195,"z":-0.485,"el":"C"},{"x":-0.185,"y":2.661,"z":0.213,"el":"C"},{"x":-2.42,"y":1.446,"z":0.452,"el":"C"},{"x":0.185,"y":-3.23,"z":-0.504,"el":"C"},{"x":0.761,"y":3.371,"z":-0.714,"el":"C"},{"x":-3.683,"y":0.974,"z":-0.255,"el":"C"},{"x":-1.264,"y":-3.131,"z":-0.034,"el":"C"},{"x":2.678,"y":1.833,"z":-0.258,"el":"C"},{"x":2.769,"y":-0.528,"z":0.166,"el":"C"},{"x":0.261,"y":-3.6
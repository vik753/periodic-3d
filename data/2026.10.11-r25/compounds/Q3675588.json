{"version":"2026.10.11-r25","id":"Q3675588","formula":"Ag₂Pd₃Se₄","hill":"Ag2Pd3Se4","elements":["Se","Pd","Ag"],"composition":{"Ag":2.0,"Pd":3.0,"Se":4.0},"names":{"en":"Chrisstanleyite"},"descriptions":{"en":"Chrisstanleyite, Ag2Pd3Se4, is a selenide mineral that crystallizes in high saline, acidic hydrothermal solution at low temperatures as part of selenide vein inclusions in and alongside calcite veins. It tends to be found in assemblages of other selenides: jagueite, naumannite, fischesserite, oosterboschite, and tiemannite, and it is a solid solution mineral with jagueite Cu2Pd3Se4 in which it shares a unique crystal structure that has not been identified elsewhere (Paar et al. 1998; Nickel 2002; Paar et al."},"fame":6,"pubchemCid":null,"mass":null,"charge":0,"smiles":null,"inchikey":null,"iupac":null,"classes":[{"qid":"Q12089225","names":{"en":"mineral species","ru":"действительный вид минералов","uk":"мінеральний вид"}}],"structureInfo":null,"structure":null,"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q3675588","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Chrisstanleyite","license":"CC BY-SA 4.0"}],"similar":[{"id":"Q21007382","formula":"Pd₁₇Se₁₅","names":{"ru":"Пентадекаселенид гептадекапалладия"},"elements":["Se","Pd"],"fame":1,"kind":"crystal"},{"id":"Q21007404","formula":"Pd₇Se₄","names":{"ru":"Тетраселенид гептапалладия"},"elements":["Se","Pd"],"fame":1,"kind":"crystal"},{"id":"Q4009859","formula":"PdSe₂","names":{"en":"Verbeekite"},"elements":["Se","Pd"],"fame":6,"kind":"crystal"},{"id":"Q19614950","formula":"PdSe₂","names":{"ru":"Диселенид палладия"},"elements":["Se","Pd"],"fame":1,"kind":"crystal"},{"id":"Q21007390","formula":"Pd₃Se","names":{"ru":"Селенид трипалладия"},"elements":["Se","Pd"],"fame":1,"kind":null},{"id":"Q3837989","formula":"Pt₅Se₄","names":{"en":"Luberoite","ru":"Любероит","uk":"Любероїт"},"elements":["Se","Pt"],"fame":4,"kind":"crys
{"version":"2026.10.11-r25","id":"Q72445276","formula":"C₂₆H₂₆ClN₃O₄","hill":"C26H26ClN3O4","elements":["H","C","N","O","Cl"],"composition":{"C":26.0,"H":26.0,"N":3.0,"O":4.0,"Cl":1.0},"names":{"en":"N-[3-(1H-Benzimidazol-2-yl)-4-chlorophenyl]-3,4,5-triethoxybenzamide"},"descriptions":{"en":"SANT-2 is a small-molecule antagonist of the sonic hedgehog (Shh) pathway, a developmental signaling cascade implicated in tissue patterning, stem cell maintenance, and the progression of various cancers. By targeting the smoothened (SMO) receptor, SANT-2 disrupts aberrant Shh pathway activation, thereby inhibiting downstream transcriptional programs that drive uncontrolled cell proliferation and survival. Due to its potency and specificity, SANT-2 has become a tool for studying Hedgehog-dependent oncogenesis and holds potential as a lead compound for the development of targeted anticancer therapeutics."},"fame":1,"pubchemCid":1367095,"mass":480.0,"charge":0,"smiles":"CCOC1=CC(=CC(=C1OCC)OCC)C(=O)NC2=CC(=C(C=C2)Cl)C3=NC4=CC=CC=C4N3","inchikey":"VQOJFGFKIVFMDH-UHFFFAOYSA-N","iupac":"N-[3-(1H-benzimidazol-2-yl)-4-chlorophenyl]-3,4,5-triethoxybenzamide","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"1367095","atoms":60,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":5.28,"y":3.278,"z":0.32,"el":"Cl"},{"x":-6.098,"y":-1.343,"z":0.404,"el":"O"},{"x":-3.687,"y":-2.47,"z":1.167,"el":"O"},{"x":-6.197,"y":1.331,"z":-0.31,"el":"O"},{"x":-1.532,"y":2.994,"z":0.698,"el":"O"},{"x":4.787,"y":-0.744,"z":0.726,"el":"N"},{"x":5.432,"y":0.364,"z":-1.09,"el":"N"},{"x":-0.213,"y":1.087,"z":0.311,"el":"N"},{"x":4.558,"y":0.313,"z":-0.11,"el":"C"},{"x":3.47,"y":1.236,"z":0.105,"el":"C"},{"x":5.882,"y":-1.421,"z":0.254,"el":"C"},{"x":6.266,"y":-0.71,"z":-0.88,"el":"C"},{"x":1.089,"y":1.59,"z":0.311,"el":"C"},{"x":-2.645
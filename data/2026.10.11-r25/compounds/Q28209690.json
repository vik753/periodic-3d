{"version":"2026.10.11-r25","id":"Q28209690","formula":"C₂₁H₁₈","hill":"C21H18","elements":["H","C"],"composition":{"C":21.0,"H":18.0},"names":{"en":"Triphenylmethylethylene"},"descriptions":{"en":"Triphenylmethylethylene, also known as methyltriphenylethylene or as triphenylpropene, is a synthetic nonsteroidal estrogen of the triphenylethylene group that is related to triphenylchloroethylene and was never marketed. Along with diethylstilbestrol and triphenylchoroethylene, triphenylmethylethylene was studied in 1944 by Sir Alexander Haddow for the treatment of breast cancer, and this is historically notable in that it was the first time that high-dose estrogens were found to be effective in the treatment of breast cancer."},"fame":2,"pubchemCid":4207747,"mass":270.4,"charge":0,"smiles":"CC(=C(C1=CC=CC=C1)C2=CC=CC=C2)C3=CC=CC=C3","inchikey":"FLTIZNYOOOPPHQ-UHFFFAOYSA-N","iupac":"1,1-diphenylprop-1-en-2-ylbenzene","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"4207747","atoms":39,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-0.658,"y":-0.232,"z":0.0,"el":"C"},{"x":0.116,"y":-1.369,"z":0.0,"el":"C"},{"x":-2.111,"y":-0.299,"z":0.0,"el":"C"},{"x":0.049,"y":1.087,"z":0.0,"el":"C"},{"x":1.595,"y":-1.275,"z":0.0,"el":"C"},{"x":-0.366,"y":-2.8,"z":0.003,"el":"C"},{"x":-2.808,"y":-0.33,"z":-1.208,"el":"C"},{"x":0.358,"y":1.664,"z":1.208,"el":"C"},{"x":-2.808,"y":-0.332,"z":1.208,"el":"C"},{"x":0.359,"y":1.665,"z":-1.208,"el":"C"},{"x":2.264,"y":-1.232,"z":1.208,"el":"C"},{"x":2.264,"y":-1.234,"z":-1.208,"el":"C"},{"x":-4.202,"y":-0.395,"z":-1.208,"el":"C"},{"x":1.018,"y":2.894,"z":1.209,"el":"C"},{"x":-4.201,"y":-0.396,"z":1.208,"el":"C"},{"x":1.018,"y":2.894,"z":-1.207,"el":"C"},{"x":3.656,"y":-1.145,"z":1.208,"el":"C"},{"x":3.656,"y":-1.146,"z":-1.208,"el":"C"},{"x":-4.898,"y":-0.427,"z":0
{"version":"2026.10.11-r25","id":"Q4024215","formula":"C₁₈H₂₆O₅","hill":"C18H26O5","elements":["H","C","O"],"composition":{"C":18.0,"H":26.0,"O":5.0},"names":{"en":"Zeranol"},"descriptions":{"en":"Zeranol (INNTooltip International Nonproprietary Name, USANTooltip United States Adopted Name, BANTooltip British Approved Name) (brand names Frideron, Ralabol, Ralgro, Ralone, Zerano; developmental code names MK-188, P-1496), or zearanol, also known as α-zearalanol or simply zearalanol, is a synthetic nonsteroidal estrogen of the resorcylic acid lactone group related to mycoestrogens found in fungi in the Fusarium genus and is used mainly as an anabolic agent in veterinary medicine. Zeranol is approved for use as a growth promoter in livestock, including beef cattle, under the brand name Ralgro (by Merck Animal Health) in the United States."},"fame":11,"pubchemCid":2999413,"mass":322.4,"charge":0,"smiles":"C[C@H]1CCC[C@@H](CCCCCC2=C(C(=CC(=C2)O)O)C(=O)O1)O","inchikey":"DWTTZBARDOXEAM-GXTWGEPZSA-N","iupac":"(4S,8R)-8,16,18-trihydroxy-4-methyl-3-oxabicyclo[12.4.0]octadeca-1(14),15,17-trien-2-one","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"2999413","atoms":49,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-5.246,"y":-0.925,"z":0.361,"el":"O"},{"x":0.057,"y":1.716,"z":-0.114,"el":"O"},{"x":0.4,"y":1.188,"z":2.119,"el":"O"},{"x":2.904,"y":2.359,"z":-0.177,"el":"O"},{"x":5.047,"y":-1.797,"z":-1.034,"el":"O"},{"x":-4.266,"y":-0.618,"z":-0.629,"el":"C"},{"x":-3.302,"y":-1.807,"z":-0.75,"el":"C"},{"x":-3.6,"y":0.721,"z":-0.274,"el":"C"},{"x":-2.628,"y":-2.209,"z":0.571,"el":"C"},{"x":-2.595,"y":1.195,"z":-1.327,"el":"C"},{"x":-1.496,"y":-3.222,"z":0.36,"el":"C"},{"x":-2.007,"y":2.579,"z":-1.019,"el":"C"},{"x":-0.192,"y":-2.585,"z":-0.136,"el":"C"},{"x":-1.053,"y":2.59,"z":0.183,"el":"C"},{"x":0
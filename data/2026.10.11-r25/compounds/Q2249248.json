{"version":"2026.10.11-r25","id":"Q2249248","formula":"Ag₆Cu₄Fe₂Sb₄S₁₃","hill":"Ag6Cu4Fe2S13Sb4","elements":["S","Fe","Cu","Ag","Sb"],"composition":{"S":13.0,"Ag":6.0,"Cu":4.0,"Fe":2.0,"Sb":4.0},"names":{"en":"Freibergite subgroup","ru":"Фрейбергит"},"descriptions":{"en":"Freibergite is a complex sulfosalt mineral of silver, copper, iron, antimony and arsenic with formula (Ag,Cu,Fe)12(Sb,As)4S13. It has cubic crystals and is formed in hydrothermal deposits. It forms one solid solution series with tetrahedrite and another with argentotennantite.","ru":"Фрейбергит — минерал из класса сульфосолей, относится к группе тетраэдрита. Образует изоморфные ряды с тетраэдритом и аргентотеннантитом. Впервые описан в серебряных рудниках Фрайберга (Саксония, Германия) в 1853 году."},"fame":11,"pubchemCid":null,"mass":null,"charge":0,"smiles":null,"inchikey":null,"iupac":null,"classes":[{"qid":"Q3965281","names":{"en":"mineral series","ru":"подгруппа минералов","uk":"підгрупа мінералів"}}],"structureInfo":null,"structure":null,"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q2249248","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Freibergite","license":"CC BY-SA 4.0"},{"role":"description","name":"Wikipedia (ru)","url":"https://ru.wikipedia.org/wiki/%D0%A4%D1%80%D0%B5%D0%B9%D0%B1%D0%B5%D1%80%D0%B3%D0%B8%D1%82","license":"CC BY-SA 4.0"},{"role":"photo","name":"Wikimedia Commons","url":"https://commons.wikimedia.org/wiki/File:Freibergite.jpg","license":"CC BY-SA 3.0"}],"similar":[{"id":"Q1058765","formula":"AgPbAsS₃","names":{"en":"Marrite"},"elements":["S","As","Ag","Pb"],"fame":7,"kind":"crystal"},{"id":"Q3756715","formula":"Tl₂AgCu₂As₃S₇","names":{"en":"Gabrielite"},"elements":["S","Cu","As","Ag","Tl"],"fame":5,"kind":null},{"id":"Q3951855","formula":"Ag₀.₄Pb₀.₂Bi₀.₄S","names":{"en":"Schapbachite","uk":"Шапбахіт"},"elements":["S","Ag","Pb","Bi"],"fame":4,"kind":null},{"id":"Q410810","form
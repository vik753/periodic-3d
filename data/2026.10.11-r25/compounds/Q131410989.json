{"version":"2026.10.11-r25","id":"Q131410989","formula":"C₆₃H₈₈F₃N₁₁O₇","hill":"C63H88F3N11O7","elements":["H","C","N","O","F"],"composition":{"C":63.0,"F":3.0,"H":88.0,"N":11.0,"O":7.0},"names":{"en":"Zoldonrasib"},"descriptions":{"en":"Zoldonrasib, also known as RMC-9805, is an investigational drug that selectively targets the G12D mutation in KRAS dependent cancers. Zoldonrasib functions as molecular glue that forms a non-covalent ligand-mediated protein-protein interaction between cyclophilin A and GTP-bound RAS. Subsequent covalent modification of the mutant Asp12 residue affords selectivity over wild-type RAS. As of 2025, zoldonrasib is in a phase 1/1b clinical trial for the treatment of KRAS G12D-mutant solid tumors. Preliminary data indicated that KRAS G12D–mutant PDAC patients dosed at 1200 mg daily or 600 mg twice daily achieved a 30% objective response rate (n = 12) and 80% disease control rate (n = 32)."},"fame":3,"pubchemCid":168201327,"mass":1168.4,"charge":0,"smiles":"C[C@@H](C1=C(C=C(C=N1)N2CCN(CC2)C3CC3)C4=C5CC(COC(=O)[C@@H]6CCCN(N6)C(=O)[C@H](C[C@H]7CN(CCO7)C8=CC5=C(N4CC(F)(F)F)C=C8)NC(=O)[C@H](C9CCCC9)N1CC[C@@]2(C1)CCN(C2)C(=O)[C@H]1[C@H](N1C)C1CC1)(C)C)OC","inchikey":"VKNNQJWNUPSOEK-VCAAAJMFSA-N","iupac":"(2S)-2-cyclopentyl-2-[(5S)-2-[(2R,3R)-3-cyclopropyl-1-methylaziridine-2-carbonyl]-2,7-diazaspiro[4.4]nonan-7-yl]-N-[(6S,8S,14S)-21-[5-(4-cyclopropylpiperazin-1-yl)-2-[(1S)-1-methoxyethyl]-3-pyridinyl]-18,18-dimethyl-9,15-dioxo-22-(2,2,2-trifluoroethyl)-5,16-dioxa-2,10,22,28-tetrazapentacyclo[18.5.2.12,6.110,14.023,27]nonacosa-1(26),20,23(27),24-tetraen-8-yl]acetamide","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"rdkit","ref":"168201327","atoms":172,"license":"Computed with RDKit from SMILES (PubChem, Wikidata)"},"structure":{"kind":"molecule","atoms":[{"x":-7.303,"y":3.961,"z":0.242,"el":"C"},{"x":-7.429,"y":2.733
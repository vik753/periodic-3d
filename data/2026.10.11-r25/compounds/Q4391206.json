{"version":"2026.10.11-r25","id":"Q4391206","formula":"C₁₆H₈O₈","hill":"C16H8O8","elements":["H","C","O"],"composition":{"C":16.0,"H":8.0,"O":8.0},"names":{"en":"Hipposudoric acid"},"descriptions":{"en":"Hipposudoric acid is a red pigment found in the skin secretions of the hippopotamus; although the secretions are often known as \"blood sweat\" (thus the name \"hipposudoric\", referring to \"hippo sweat\"), they are neither blood nor sweat. Like its orange-colored analog norhipposudoric acid, hipposudoric acid functions both as a natural sunscreen and as an antimicrobial agent. It is derived from the oxidative dimerization of homogentisic acid."},"fame":15,"pubchemCid":null,"mass":null,"charge":0,"smiles":"C1=CC(=O)C2=C(C3=C(C2=C1O)C(=O)C(=CC3=O)C(=O)O)C(=O)O","inchikey":null,"iupac":null,"classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":null,"structure":null,"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q4391206","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Hipposudoric_acid","license":"CC BY-SA 4.0"}],"similar":[{"id":"Q411945","formula":"C₇H₅NO₄","names":{"en":"Quinolinic acid","ru":"Хинолиновая кислота"},"elements":["H","C","N","O"],"fame":18,"kind":"molecule"},{"id":"Q417164","formula":"C₇H₅NO₄","names":{"en":"Pyridine-2,6-dicarboxylic acid"},"elements":["H","C","N","O"],"fame":18,"kind":"molecule"},{"id":"Q2823227","formula":"C₇H₅NO₄","names":{"en":"4-nitrobenzoic acid"},"elements":["H","C","N","O"],"fame":16,"kind":"molecule"},{"id":"Q4634183","formula":"C₇H₅NO₄","names":{"en":"3-nitrobenzoic acid","ru":"3-нитробензойная кислота"},"elements":["H","C","N","O"],"fame":14,"kind":"molecule"},{"id":"Q15632703","formula":"C₇H₅NO₄","names":{"en":"Dinicotinic acid"},"elements":["H","C","N","O"],"fame":9,"kind":"molecule"},{"id":"Q1675143","formula":"C₉H₄O₅","names":{"en":
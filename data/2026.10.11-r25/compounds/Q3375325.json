{"version":"2026.10.11-r25","id":"Q3375325","formula":"C₄F₁₀","hill":"C4F10","elements":["C","F"],"composition":{"C":4.0,"F":10.0},"names":{"en":"Perfluorobutane","ru":"Декафторбутан"},"descriptions":{"en":"Perfluorobutane (PFB) is an inert, high-density colorless gas. It is a simple fluorocarbon with a n-butane skeleton and all the hydrogen atoms replaced with fluorine atoms.","ru":"Декафторбута́н (перфторбута́н, R31-10) — химическое соединение класса перфторуглеродов с химической формулой C4F10 (молекула бутана, где все атомы водорода заменены на атомы фтора). Представляет собой инертный бесцветный тяжёлый газ. Существует также структурный изомер с близкими свойствами: перфторизобутан (CF3)3CF, представляющий собой перфторированный изобутан."},"fame":15,"pubchemCid":9638,"mass":238.03,"charge":0,"smiles":"C(C(C(F)(F)F)(F)F)(C(F)(F)F)(F)F","inchikey":"KAVGMUDTWQVPDF-UHFFFAOYSA-N","iupac":"1,1,1,2,2,3,3,4,4,4-decafluorobutane","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"9638","atoms":14,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-0.62,"y":-0.691,"z":-1.639,"el":"F"},{"x":-1.333,"y":-1.809,"z":0.087,"el":"F"},{"x":0.616,"y":-0.681,"z":1.635,"el":"F"},{"x":1.329,"y":-1.81,"z":-0.084,"el":"F"},{"x":-1.069,"y":1.683,"z":-0.318,"el":"F"},{"x":-1.718,"y":0.582,"z":1.441,"el":"F"},{"x":-2.822,"y":0.386,"z":-0.43,"el":"F"},{"x":1.054,"y":1.678,"z":0.304,"el":"F"},{"x":2.802,"y":0.384,"z":0.462,"el":"F"},{"x":1.771,"y":0.581,"z":-1.442,"el":"F"},{"x":-0.709,"y":-0.66,"z":-0.279,"el":"C"},{"x":0.705,"y":-0.658,"z":0.275,"el":"C"},{"x":-1.586,"y":0.509,"z":0.097,"el":"C"},{"x":1.582,"y":0.507,"z":-0.109,"el":"C"}],"bonds":[[0,10,1],[1,10,1],[2,11,1],[3,11,1],[4,12,1],[5,12,1],[6,12,1],[7,13,1],[8,13,1],[9,13,1],[10,11,1],[10,12,1],[11,13,1]]},"sources":[{"role":"identity","name":"Wikidat
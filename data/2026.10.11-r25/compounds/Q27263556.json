{"version":"2026.10.11-r25","id":"Q27263556","formula":"C₁₉H₂₂N₄O","hill":"C19H22N4O","elements":["H","C","N","O"],"composition":{"C":19.0,"H":22.0,"N":4.0,"O":1.0},"names":{"en":"Cianergoline"},"descriptions":{"en":"Cianergoline (INNTooltip International Nonproprietary Name), also known as 355/1057 or as 2-cyano-3-(6-methylergolin-8β-yl)propionamide (2-CMEBP), is a dopamine receptor agonist described as an antihypertensive agent of the ergoline family which was never marketed. It has atypical properties as a dopamine receptor agonist compared to other ergolines, for instance having less central activity and showing predominant cardiovascular effects. In addition to its dopamine receptor agonism, cianergoline may interact with α-adrenergic receptors, which may or may not also be involved in its antihypertensive effects."},"fame":1,"pubchemCid":71136,"mass":322.4,"charge":0,"smiles":"CN1C[C@@H](C[C@H]2[C@H]1CC3=CNC4=CC=CC2=C34)CC(C#N)C(=O)N","inchikey":"LVMVXZOPCAMYHC-QOAXCGLXSA-N","iupac":"3-[(6aR,9S,10aR)-7-methyl-6,6a,8,9,10,10a-hexahydro-4H-indolo[4,3-fg]quinolin-9-yl]-2-cyanopropanamide","classes":[{"qid":"Q59199015","names":{"en":"group of stereoisomers","ru":"группа стереоизомеров","uk":"група стереоізомерів"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"71136","atoms":46,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-6.15,"y":-0.599,"z":0.419,"el":"O"},{"x":0.107,"y":2.681,"z":-0.078,"el":"N"},{"x":5.173,"y":-0.565,"z":0.165,"el":"N"},{"x":-4.775,"y":-1.705,"z":1.887,"el":"N"},{"x":-4.212,"y":-0.474,"z":-2.605,"el":"N"},{"x":0.617,"y":0.238,"z":-0.396,"el":"C"},{"x":1.104,"y":1.623,"z":0.217,"el":"C"},{"x":-0.773,"y":-0.12,"z":0.149,"el":"C"},{"x":-1.757,"y":1.028,"z":-0.087,"el":"C"},{"x":-1.21,"y":2.338,"z":0.489,"el":"C"},{"x":2.553,"y":2.013,"z":-0.27,"el":"C"},{"x":1.649,"y":-0.855,"z":-0.17,"el":"C"},{"x":2.985,"y":-0.448,"z":-0.066,"el":"C"},{"x":3.49,"y":0.866,"z":-0.102,"el":"C"},{"x":-3.121,"y
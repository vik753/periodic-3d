{"version":"2026.10.11-r25","id":"Q82992005","formula":"C₁₁H₁₂N₂","hill":"C11H12N2","elements":["H","C","N"],"composition":{"C":11.0,"H":12.0,"N":2.0},"names":{"en":"1,3,4,5-Tetrahydrobenzo[cd]indol-4-amine"},"descriptions":{"en":"RU-27849, also known as 4,α-methylenetryptamine (4,α-methylene-T), is a serotonin receptor modulator. It can be regarded as a conformationally restricted tricyclic derivative of tryptamine or a structurally simplified derivative of LSD. This molecule was developed during structure–activity relationship (SAR) studies of LSD. It shows affinity for serotonin receptors, including for the serotonin 5-HT1, 5-HT1A, and 5-HT2 receptors (IC50Tooltip half-maximal inhibitory concentration = 267–520 nM, 325–326 nM, and 1,964–2,900 nM, respectively). RU-27849's affinities for serotonin receptors are similar to but lower than those of tryptamine and dimethyltryptamine (DMT)."},"fame":1,"pubchemCid":132797,"mass":172.23,"charge":0,"smiles":"C1C(CC2=CNC3=CC=CC1=C23)N","inchikey":"JPTWSZJFCLJZJX-UHFFFAOYSA-N","iupac":"1,3,4,5-tetrahydrobenzo[cd]indol-4-amine","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"132797","atoms":25,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":1.655,"y":1.956,"z":-0.055,"el":"N"},{"x":-3.775,"y":-0.515,"z":-0.069,"el":"N"},{"x":-2.363,"y":-0.272,"z":-0.357,"el":"C"},{"x":-1.952,"y":1.14,"z":0.181,"el":"C"},{"x":-1.5,"y":-1.457,"z":0.198,"el":"C"},{"x":0.359,"y":0.183,"z":0.044,"el":"C"},{"x":-0.474,"y":1.32,"z":0.082,"el":"C"},{"x":-0.027,"y":-1.162,"z":0.074,"el":"C"},{"x":1.679,"y":0.578,"z":-0.039,"el":"C"},{"x":0.354,"y":2.416,"z":0.02,"el":"C"},{"x":0.995,"y":-2.114,"z":0.046,"el":"C"},{"x":2.712,"y":-0.358,"z":-0.086,"el":"C"},{"x":2.338,"y":-1.714,"z":-0.039,"el":"C"},{"x":-2.236,"y":-0.257,"z":-1.45,"el":"H"},{"x":-2.248,"y":1.242,"z":1.23
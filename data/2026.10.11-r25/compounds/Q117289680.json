{"version":"2026.10.11-r25","id":"Q117289680","formula":"Ga₂Mg₅","hill":"Ga2Mg5","elements":["Mg","Ga"],"composition":{"Ga":2.0,"Mg":5.0},"names":{"en":"Pentamagnesium digallide"},"descriptions":{"en":"Pentamagnesium digallide, also known as magnesium gallide(−V), is a chemical compound in the family of magnesium gallides (MgxGay). This compound has gallium in the rare oxidation state −5 and is produced by splat quenching of a molten mixture of magnesium and gallium metal then heating the resulting substance to 350 °C: 5Mg + 2Ga → Mg5Ga2 It is an unwanted product when magnesium-gallium alloys are exposed to high temperatures."},"fame":6,"pubchemCid":78062207,"mass":260.97,"charge":0,"smiles":"[Mg].[Mg].[Mg].[Mg].[Mg].[Ga].[Ga]","inchikey":"BHKRUXZCMMTJBB-UHFFFAOYSA-N","iupac":null,"classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"crystal","source":"materialsproject","ref":"mp-1770","atoms":46,"license":"CC BY 4.0, Materials Project"},"structure":{"cell":[[6.971,0.0,0.0],[0.0,13.509,0.0],[0.0,0.0,5.975]],"kind":"crystal","atoms":[{"x":1.073,"y":5.623,"z":0.0,"el":"Mg"},{"x":1.073,"y":5.623,"z":5.975,"el":"Mg"},{"x":2.412,"y":1.132,"z":2.987,"el":"Mg"},{"x":4.558,"y":1.132,"z":0.0,"el":"Mg"},{"x":4.558,"y":1.132,"z":5.975,"el":"Mg"},{"x":5.898,"y":5.623,"z":2.987,"el":"Mg"},{"x":0.0,"y":0.0,"z":4.481,"el":"Mg"},{"x":0.0,"y":13.509,"z":4.481,"el":"Mg"},{"x":6.971,"y":0.0,"z":4.481,"el":"Mg"},{"x":6.971,"y":13.509,"z":4.481,"el":"Mg"},{"x":3.485,"y":6.754,"z":4.481,"el":"Mg"},{"x":3.485,"y":3.619,"z":1.494,"el":"Mg"},{"x":0.0,"y":3.136,"z":4.481,"el":"Mg"},{"x":6.971,"y":3.136,"z":4.481,"el":"Mg"},{"x":0.0,"y":3.136,"z":1.494,"el":"Mg"},{"x":6.971,"y":3.136,"z":1.494,"el":"Mg"},{"x":3.485,"y":3.619,"z":4.481,"el":"Mg"},{"x":5.328,"y":5.103,"z":0.0,"el":"Ga"},{"x":5.328,"y":5.103,"z":5.975,"el":"Ga"},{"x":5.128,"y":1.652,"z":2.987,"el":"Ga"},{"x":1.843,"y":1.652,"
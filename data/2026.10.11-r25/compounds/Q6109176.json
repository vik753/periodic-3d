{"version":"2026.10.11-r25","id":"Q6109176","formula":"C₂₃H₂₁NO","hill":"C23H21NO","elements":["H","C","N","O"],"composition":{"C":23.0,"H":21.0,"N":1.0,"O":1.0},"names":{"en":"JWH-015"},"descriptions":{"en":"JWH-015 is a chemical from the naphthoylindole family that acts as a subtype-selective cannabinoid agonist. Its affinity for CB2 receptors is 13.8 nM, while its affinity for CB1 is 383 nM, meaning that it binds almost 28 times more strongly to CB2 than to CB1. However, it still displays some CB1 activity, and in some model systems can be very potent and efficacious at activating CB1 receptors, and therefore it is not as selective as newer drugs such as JWH-133."},"fame":7,"pubchemCid":4273754,"mass":327.4,"charge":0,"smiles":"CCCN1C(=C(C2=CC=CC=C21)C(=O)C3=CC=CC4=CC=CC=C43)C","inchikey":"LJSBBBWQTLXQEN-UHFFFAOYSA-N","iupac":"(2-methyl-1-propylindol-3-yl)-naphthalen-1-ylmethanone","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"4273754","atoms":46,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-0.408,"y":-2.585,"z":1.046,"el":"O"},{"x":2.939,"y":-0.205,"z":0.292,"el":"N"},{"x":2.037,"y":-1.2,"z":0.557,"el":"C"},{"x":2.289,"y":1.002,"z":0.163,"el":"C"},{"x":0.816,"y":-0.616,"z":0.595,"el":"C"},{"x":0.927,"y":0.758,"z":0.354,"el":"C"},{"x":4.37,"y":-0.392,"z":0.165,"el":"C"},{"x":4.784,"y":-0.697,"z":-1.272,"el":"C"},{"x":-0.429,"y":-1.362,"z":0.857,"el":"C"},{"x":2.459,"y":-2.606,"z":0.745,"el":"C"},{"x":2.798,"y":2.278,"z":-0.105,"el":"C"},{"x":0.027,"y":1.839,"z":0.274,"el":"C"},{"x":-1.718,"y":-0.676,"z":0.885,"el":"C"},{"x":1.886,"y":3.335,"z":-0.18,"el":"C"},{"x":-2.511,"y":-0.515,"z":-0.263,"el":"C"},{"x":0.521,"y":3.121,"z":0.006,"el":"C"},{"x":6.286,"y":-0.901,"z":-1.385,"el":"C"},{"x":-3.749,"y":0.161,"z":-0.16,"el":"C"},{"x":-2.14,"y":-0.176,"z":2.117,"el":"C"},{"x":-2.10
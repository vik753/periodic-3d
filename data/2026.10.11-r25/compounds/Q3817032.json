{"version":"2026.10.11-r25","id":"Q3817032","formula":"Bi·Pb·Sn","hill":"BiPbSn","elements":["Sn","Pb","Bi"],"composition":{"Bi":1.0,"Pb":1.0,"Sn":1.0},"names":{"en":"Newton's metal","ru":"Металл Ньютона","uk":"Сплав Ньютона"},"descriptions":{"en":"Newton's metal is a fusible alloy with a low melting point. Its composition by weight is 8 parts bismuth, 5 parts lead and 3 parts tin; its melting point is 97 °C. Newton's metal is comparable to Cerrobend, but avoids its toxic cadmium content. This has encouraged its use for medical applications for easily shaped shielding during radiotherapy.","uk":"Сплав Нью́тона (англ. Newton's metal) — легкоплавкий сплав, що має такий ваговий склад компонентів: бісмут 50 % свинець 31,2 % олово 18,8 %, або 8:5:3 частин, відповідно. Як неминучі металургійні домішки у сплаві можуть бути присутні срібло, стибій, арсен, інколи — залізо, сірка і магній."},"fame":9,"pubchemCid":null,"mass":null,"charge":0,"smiles":null,"inchikey":null,"iupac":null,"classes":[{"qid":"Q119892838","names":{"en":"type of mixture of chemical entities","ru":"тип смеси химических соединений"}}],"structureInfo":null,"structure":null,"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q3817032","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Newton%27s_metal","license":"CC BY-SA 4.0"},{"role":"description","name":"Wikipedia (uk)","url":"https://uk.wikipedia.org/wiki/%D0%A1%D0%BF%D0%BB%D0%B0%D0%B2_%D0%9D%D1%8C%D1%8E%D1%82%D0%BE%D0%BD%D0%B0","license":"CC BY-SA 4.0"}],"similar":[{"id":"Q901189","formula":"Bi·Pb·Sn","names":{"en":"Rose's metal","ru":"Сплав Розе","uk":"Сплав Розе"},"elements":["Sn","Pb","Bi"],"fame":16,"kind":null},{"id":"Q905989","formula":"Bi·Cd·Pb·Sn","names":{"en":"Wood's metal","ru":"Сплав Вуда","uk":"Сплав Вуда"},"elements":["Cd","Sn","Pb","Bi"],"fame":23,"kind":null},{"id":"Q794304","formula":"Pb·Sb·Sn","names":{"en":"Type metal"},"elements":["Sn","Sb","Pb"],
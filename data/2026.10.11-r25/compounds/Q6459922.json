{"version":"2026.10.11-r25","id":"Q6459922","formula":"C₂₁H₂₅N₃O","hill":"C21H25N3O","elements":["H","C","N","O"],"composition":{"C":21.0,"H":25.0,"N":3.0,"O":1.0},"names":{"en":"LSD-Pip"},"descriptions":{"en":"Lysergic acid piperidide (LA-Pip or LSD-Pip), also known as N-piperidinyllysergamide, is a serotonin receptor modulator of the lysergamide family related to lysergic acid diethylamide (LSD). It is the analogue of LSD in which the N,N-diethyl substitution has been replaced with an N-piperidide ring. The drug has fairly similar affinity and efficacy as a serotonin 5-HT2A receptor agonist compared to LSD, though is variably less potent in terms of EC50Tooltip half-maximal effective concentration depending on the assay."},"fame":4,"pubchemCid":308707,"mass":335.4,"charge":0,"smiles":"CN1CC(C=C2C1CC3=CNC4=CC=CC2=C34)C(=O)N5CCCCC5","inchikey":"URDULHYODQAQTM-UHFFFAOYSA-N","iupac":"(7-methyl-6,6a,8,9-tetrahydro-4H-indolo[4,3-fg]quinolin-9-yl)-piperidin-1-ylmethanone","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"308707","atoms":50,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-2.165,"y":1.712,"z":1.046,"el":"O"},{"x":-0.23,"y":-2.119,"z":0.154,"el":"N"},{"x":-3.82,"y":0.733,"z":-0.258,"el":"N"},{"x":5.519,"y":-0.43,"z":-0.152,"el":"N"},{"x":1.025,"y":-1.367,"z":0.437,"el":"C"},{"x":-1.492,"y":-0.064,"z":-0.358,"el":"C"},{"x":0.961,"y":0.121,"z":-0.02,"el":"C"},{"x":2.248,"y":-2.147,"z":-0.173,"el":"C"},{"x":-1.412,"y":-1.322,"z":0.511,"el":"C"},{"x":-0.196,"y":0.683,"z":-0.412,"el":"C"},{"x":2.226,"y":0.89,"z":-0.031,"el":"C"},{"x":3.479,"y":-1.314,"z":-0.148,"el":"C"},{"x":3.373,"y":0.091,"z":-0.087,"el":"C"},{"x":-2.514,"y":0.875,"z":0.209,"el":"C"},{"x":-4.875,"y":1.612,"z":0.25,"el":"C"},{"x":-4.257,"y":-0.222,"z":-1.285,"el":"C"},{"x":4.647,"y":0.636,"z":-0.094,"el":"C"},{"x":
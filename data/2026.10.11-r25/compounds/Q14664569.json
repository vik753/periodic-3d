{"version":"2026.10.11-r25","id":"Q14664569","formula":"C₁₄H₂₂N₂O","hill":"C14H22N2O","elements":["H","C","N","O"],"composition":{"C":14.0,"H":22.0,"N":2.0,"O":1.0},"names":{"en":"Ispronicline"},"descriptions":{"en":"Ispronicline (TC-1734, AZD-3480) is an experimental drug which acts as a partial agonist at neural nicotinic acetylcholine receptors. It progressed to phase II clinical trials for the treatment of dementia and Alzheimer's disease, but is no longer under development. It has also progressed to phase II as a potential treatment for ADHD. With dosages of 50 mg/day showing a significant improvement in ADHD symptoms Ispronicline is subtype-selective, binding primarily to the α4β2 subtype."},"fame":5,"pubchemCid":9824145,"mass":234.34,"charge":0,"smiles":"C[C@@H](C/C=C/C1=CC(=CN=C1)OC(C)C)NC","inchikey":"RPCVIAXDAUMJJP-PZBABLGHSA-N","iupac":"(E,2S)-N-methyl-5-(5-propan-2-yloxy-3-pyridinyl)pent-4-en-2-amine","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"9824145","atoms":39,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":3.493,"y":0.679,"z":-0.434,"el":"O"},{"x":-5.357,"y":0.6,"z":-0.315,"el":"N"},{"x":2.351,"y":-2.634,"z":0.568,"el":"N"},{"x":-3.945,"y":0.592,"z":0.077,"el":"C"},{"x":-3.133,"y":-0.146,"z":-1.0,"el":"C"},{"x":-3.822,"y":-0.061,"z":1.455,"el":"C"},{"x":-1.658,"y":-0.168,"z":-0.703,"el":"C"},{"x":-0.951,"y":-1.298,"z":-0.556,"el":"C"},{"x":3.215,"y":1.9,"z":0.255,"el":"C"},{"x":0.489,"y":-1.363,"z":-0.255,"el":"C"},{"x":-6.152,"y":1.342,"z":0.65,"el":"C"},{"x":2.657,"y":-0.365,"z":-0.21,"el":"C"},{"x":1.301,"y":-0.274,"z":-0.502,"el":"C"},{"x":4.392,"y":2.261,"z":1.146,"el":"C"},{"x":2.953,"y":2.997,"z":-0.767,"el":"C"},{"x":1.038,"y":-2.508,"z":0.271,"el":"C"},{"x":3.129,"y":-1.556,"z":0.319,"el":"C"},{"x":-3.573,"y":1.624,"z":0.14,"el":"H"},{"x":-3.515,"y":-1.169
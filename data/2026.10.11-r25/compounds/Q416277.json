{"version":"2026.10.11-r25","id":"Q416277","formula":"Ag₂CrO₄","hill":"Ag2CrO4","elements":["O","Cr","Ag"],"composition":{"O":4.0,"Ag":2.0,"Cr":1.0},"names":{"en":"Silver(I) chromate","ru":"Хромат серебра"},"descriptions":{"en":"Silver chromate is an inorganic compound with formula Ag2CrO4 which appears as distinctively coloured brown-red crystals. The compound is insoluble and its precipitation is indicative of the reaction between soluble chromate and silver precursor salts (commonly potassium/sodium chromate with silver nitrate). This reaction is important for two uses in the laboratory: in analytical chemistry it constitutes the basis for the Mohr method of argentometry, whereas in neuroscience it is used in the Golgi method of staining neurons for microscopy.","ru":"Хромат серебра(I) — неорганическое соединение, соль металла серебра и хромовой кислоты с формулой Ag2CrO4, красные кристаллы, не растворимые в воде."},"fame":22,"pubchemCid":62666,"mass":331.73,"charge":0,"smiles":"[O-][Cr](=O)(=O)[O-].[Ag+].[Ag+]","inchikey":"OJKANDGLELGDHV-UHFFFAOYSA-N","iupac":"disilver;dioxido(dioxo)chromium","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"crystal","source":"materialsproject","ref":"mp-542882","atoms":39,"license":"CC BY 4.0, Materials Project"},"structure":{"cell":[[10.248,0.0,0.0],[0.0,7.03,0.0],[0.0,0.0,5.694]],"kind":"crystal","atoms":[{"x":6.994,"y":5.273,"z":0.231,"el":"Cr"},{"x":8.378,"y":1.758,"z":3.078,"el":"Cr"},{"x":3.254,"y":1.758,"z":5.463,"el":"Cr"},{"x":1.87,"y":5.273,"z":2.616,"el":"Cr"},{"x":5.124,"y":3.515,"z":2.847,"el":"Ag"},{"x":0.0,"y":3.515,"z":0.0,"el":"Ag"},{"x":0.0,"y":3.515,"z":5.694,"el":"Ag"},{"x":10.248,"y":3.515,"z":0.0,"el":"Ag"},{"x":10.248,"y":3.515,"z":5.694,"el":"Ag"},{"x":5.124,"y":0.0,"z":2.847,"el":"Ag"},{"x":5.124,"y":7.03,"z":2.847,"el":"Ag"},{"x":0.0,"y":0.0,"z":0.0,"el":"Ag"},{"x":0.0,"y":0.0,"z":5.694,"el":"Ag
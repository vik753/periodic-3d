{"version":"2026.10.11-r25","id":"Q3180100","formula":"C₅H₃Cl₃O₃","hill":"C5H3Cl3O3","elements":["H","C","O","Cl"],"composition":{"C":5.0,"H":3.0,"O":3.0,"Cl":3.0},"names":{"en":"3-chloro-4-(dichloromethyl)-5-hydroxy-2(5H)-furanone"},"descriptions":{"en":"Mutagen X (MX), or 3-chloro-4-(dichloromethyl)-5-hydroxy-5H-furan-2-one, is a byproduct of the disinfection of water by chlorination. MX is produced by reaction of chlorine with natural humic acids. MX is found in chlorinated drinking water all over the world and is an environmental carcinogen that is known to cause several types of cancer in rats when present in large enough concentrations."},"fame":11,"pubchemCid":53665,"mass":217.43,"charge":0,"smiles":"C1(C(=C(C(=O)O1)Cl)C(Cl)Cl)O","inchikey":"WNTRMRXAGJOLCU-UHFFFAOYSA-N","iupac":"4-chloro-3-(dichloromethyl)-2-hydroxy-2H-furan-5-one","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"53665","atoms":14,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-0.139,"y":2.399,"z":-0.406,"el":"Cl"},{"x":-2.562,"y":0.613,"z":1.436,"el":"Cl"},{"x":-2.543,"y":0.04,"z":-1.414,"el":"Cl"},{"x":1.828,"y":-0.893,"z":0.325,"el":"O"},{"x":0.313,"y":-2.487,"z":-0.523,"el":"O"},{"x":2.721,"y":1.181,"z":-0.106,"el":"O"},{"x":-0.379,"y":-0.269,"z":0.145,"el":"C"},{"x":0.503,"y":-1.434,"z":0.411,"el":"C"},{"x":0.354,"y":0.819,"z":-0.069,"el":"C"},{"x":-1.86,"y":-0.408,"z":0.164,"el":"C"},{"x":1.764,"y":0.44,"z":0.036,"el":"C"},{"x":0.346,"y":-1.818,"z":1.425,"el":"H"},{"x":-2.162,"y":-1.439,"z":0.37,"el":"H"},{"x":0.602,"y":-3.309,"z":-0.092,"el":"H"}],"bonds":[[0,8,1],[1,9,1],[2,9,1],[3,7,1],[3,10,1],[4,7,1],[4,13,1],[5,10,2],[6,7,1],[6,8,2],[6,9,1],[7,11,1],[8,10,1],[9,12,1]]},"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q3180100","license":"CC0 1.0"},{"role":"descript
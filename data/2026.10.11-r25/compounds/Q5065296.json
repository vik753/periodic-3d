{"version":"2026.10.11-r25","id":"Q5065296","formula":"C₁₂H₁₇NO₃","hill":"C12H17NO3","elements":["H","C","N","O"],"composition":{"C":12.0,"H":17.0,"N":1.0,"O":3.0},"names":{"en":"Cerulenin"},"descriptions":{"en":"Cerulenin is an antifungal antibiotic that inhibits fatty acid and steroid biosynthesis. It was the first natural product antibiotic known to inhibit lipid synthesis. In fatty acid synthesis, it has been reported to bind in equimolar ratio to b-keto-acyl-ACP synthase, one of the seven moieties of fatty acid synthase, blocking the interaction of malonyl-CoA. It also has the related activity of stimulating fatty acid oxidation through the activation of CPT1, another enzyme normally inhibited by malonyl-CoA. Inhibition involves covalent thioacylation that permanently inactivates the enzymes."},"fame":5,"pubchemCid":5282054,"mass":223.27,"charge":0,"smiles":"C/C=C/C/C=C/CCC(=O)[C@@H]1[C@@H](O1)C(=O)N","inchikey":"GVEZIHKRYBHEFX-NQQPLRFYSA-N","iupac":"(2R,3S)-3-[(4E,7E)-nona-4,7-dienoyl]oxirane-2-carboxamide","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"5282054","atoms":33,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":2.553,"y":-1.042,"z":1.148,"el":"O"},{"x":1.309,"y":0.328,"z":-1.725,"el":"O"},{"x":-0.145,"y":-1.288,"z":1.247,"el":"O"},{"x":-0.221,"y":-2.39,"z":-0.779,"el":"N"},{"x":2.712,"y":-0.864,"z":-0.256,"el":"C"},{"x":1.878,"y":-1.97,"z":0.289,"el":"C"},{"x":2.043,"y":0.377,"z":-0.747,"el":"C"},{"x":2.37,"y":1.639,"z":0.026,"el":"C"},{"x":0.416,"y":-1.844,"z":0.31,"el":"C"},{"x":1.265,"y":2.693,"z":-0.032,"el":"C"},{"x":-0.017,"y":2.208,"z":0.585,"el":"C"},{"x":-1.192,"y":2.181,"z":-0.061,"el":"C"},{"x":-2.472,"y":1.699,"z":0.555,"el":"C"},{"x":-3.091,"y":0.595,"z":-0.252,"el":"C"},{"x":-3.393,"y":-0.613,"z":0.246,"el":"C"},{"x":-4.013,"y":-1.71,"z":-0.554,"el":"C"},{
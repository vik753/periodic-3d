{"version":"2026.10.11-r25","id":"Q137324905","formula":"C₁₂H₁₇NO₂","hill":"C12H17NO2","elements":["H","C","N","O"],"composition":{"C":12.0,"H":17.0,"N":1.0,"O":2.0},"names":{"en":"DOH-5-hemiFLY"},"descriptions":{"en":"DOH-5-hemiFLY, or DMA-hemiFly-5, also known as semi-fly (SF), is a serotonin receptor modulator and putative psychedelic drug of the phenethylamine, amphetamine, DOx, and benzofuran families related to 2,5-dimethoxyamphetamine (2,5-DMA; DOH). It is a cyclized derivative of 2,5-DMA related to the FLY psychedelics. The drug shows affinity for the serotonin 5-HT2A receptor (Ki = 146 nM) and fully substitutes for LSD in rodent drug discrimination tests, albeit with relatively low potency."},"fame":1,"pubchemCid":11745828,"mass":207.27,"charge":0,"smiles":"CC(CC1=C(C=CC2=C1CCO2)OC)N","inchikey":"XDJBFAKEKIPGDT-UHFFFAOYSA-N","iupac":"1-(5-methoxy-2,3-dihydro-1-benzofuran-4-yl)propan-2-amine","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"11745828","atoms":32,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":3.317,"y":-0.443,"z":0.14,"el":"O"},{"x":-1.596,"y":1.991,"z":0.076,"el":"O"},{"x":-2.887,"y":-2.62,"z":-0.125,"el":"N"},{"x":1.042,"y":-0.499,"z":-0.228,"el":"C"},{"x":-0.223,"y":0.058,"z":-0.275,"el":"C"},{"x":-1.395,"y":-0.748,"z":-0.722,"el":"C"},{"x":1.493,"y":-1.851,"z":-0.621,"el":"C"},{"x":2.136,"y":0.255,"z":0.168,"el":"C"},{"x":-2.12,"y":-1.496,"z":0.42,"el":"C"},{"x":2.898,"y":-1.819,"z":-0.018,"el":"C"},{"x":-0.369,"y":1.396,"z":0.099,"el":"C"},{"x":2.018,"y":1.583,"z":0.53,"el":"C"},{"x":0.745,"y":2.154,"z":0.498,"el":"C"},{"x":-3.078,"y":-0.592,"z":1.196,"el":"C"},{"x":-1.982,"y":2.631,"z":-1.138,"el":"C"},{"x":-2.111,"y":-0.138,"z":-1.285,"el":"H"},{"x":-1.04,"y":-1.479,"z":-1.462,"el":"H"},{"x":0.896,"y":-2.664,"z":-0.203,"el":"H"},{"x":1.536,"y":-1.937,"z":-
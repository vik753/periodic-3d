{"version":"2026.10.11-r25","id":"Q63392130","formula":"C₄H₁₁NO","hill":"C4H11NO","elements":["H","C","N","O"],"composition":{"C":4.0,"H":11.0,"N":1.0,"O":1.0},"names":{"en":"4-amino-1-butanol"},"descriptions":{"en":"4-Amino-1-butanol, or 4-aminobutanol, also known as 4-hydroxybutylamine, is an alkanolamine and an analogue and precursor of the neurotransmitter γ-aminobutyric acid (GABA). Its formula is H2NCH2CH2CH2CH2OH. It is a colorless liquid. The structural relation of 1,4-butanediol (1,4-BD) to γ-hydroxybutyric acid (GHB) is analogous to the relation of 4-amino-1-butanol to GABA. 1,4-BD is a known prodrug of GHB which is converted into it through the actions of alcohol dehydrogenase (ADH) and aldehyde dehydrogenase (ALDH)."},"fame":4,"pubchemCid":25868,"mass":89.14,"charge":0,"smiles":"C(CCO)CN","inchikey":"BLFRQYKZFKYQLO-UHFFFAOYSA-N","iupac":"4-aminobutan-1-ol","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"25868","atoms":17,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":3.066,"y":-0.241,"z":-0.004,"el":"O"},{"x":-3.094,"y":0.237,"z":-0.002,"el":"N"},{"x":-0.648,"y":0.399,"z":-0.011,"el":"C"},{"x":0.66,"y":-0.39,"z":-0.008,"el":"C"},{"x":-1.857,"y":-0.535,"z":0.011,"el":"C"},{"x":1.873,"y":0.531,"z":0.013,"el":"C"},{"x":-0.676,"y":1.062,"z":0.863,"el":"H"},{"x":-0.685,"y":1.038,"z":-0.903,"el":"H"},{"x":0.713,"y":-1.042,"z":-0.888,"el":"H"},{"x":0.697,"y":-1.058,"z":0.863,"el":"H"},{"x":-1.837,"y":-1.165,"z":0.907,"el":"H"},{"x":-1.841,"y":-1.2,"z":-0.859,"el":"H"},{"x":1.881,"y":1.183,"z":-0.866,"el":"H"},{"x":1.88,"y":1.161,"z":0.908,"el":"H"},{"x":-3.116,"y":0.834,"z":-0.828,"el":"H"},{"x":-3.112,"y":0.867,"z":0.799,"el":"H"},{"x":3.06,"y":-0.806,"z":0.788,"el":"H"}],"bonds":[[0,5,1],[0,16,1],[1,4,1],[1,14,1],[1,15,1],[2,3,1],[2,4,1],[2,6,1],[2,7,1],[3,5,1],[3,8,1],[3,9,1],
{"version":"2026.10.11-r25","id":"Q4639640","formula":"C₁₆H₂₅NO","hill":"C16H25NO","elements":["H","C","N","O"],"composition":{"C":16.0,"H":25.0,"N":1.0,"O":1.0},"names":{"en":"(S)-5-OH-DPAT"},"descriptions":{"en":"5-OH-DPAT is a synthetic compound that acts as a dopamine receptor agonist with selectivity for the D2 receptor and D3 receptor subtypes. Only the (S)-enantiomer is active as an agonist, with the (R)-enantiomer being a weak antagonist at D2 receptors. Radiolabelled 11C-5-OH-DPAT is used as an agonist radioligand for mapping the distribution and function of D2 and D3 receptors in the brain, and the drug is also being studied in the treatment of Parkinson's disease."},"fame":9,"pubchemCid":11299620,"mass":247.38,"charge":0,"smiles":"CCCN(CCC)[C@H]1CCC2=C(C1)C=CC=C2O","inchikey":"MDBWEQVKJDMEMK-AWEZNQCLSA-N","iupac":"(6S)-6-(dipropylamino)-5,6,7,8-tetrahydronaphthalen-1-ol","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"11299620","atoms":43,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":4.214,"y":-0.872,"z":1.438,"el":"O"},{"x":-2.184,"y":-0.136,"z":0.52,"el":"N"},{"x":-0.744,"y":0.073,"z":0.666,"el":"C"},{"x":-0.105,"y":-1.137,"z":1.35,"el":"C"},{"x":-0.095,"y":0.305,"z":-0.705,"el":"C"},{"x":1.38,"y":-0.878,"z":1.608,"el":"C"},{"x":1.414,"y":0.281,"z":-0.656,"el":"C"},{"x":2.107,"y":-0.313,"z":0.414,"el":"C"},{"x":-2.448,"y":-1.302,"z":-0.322,"el":"C"},{"x":-2.818,"y":1.056,"z":-0.044,"el":"C"},{"x":-3.952,"y":-1.537,"z":-0.444,"el":"C"},{"x":-2.622,"y":2.25,"z":0.886,"el":"C"},{"x":2.138,"y":0.813,"z":-1.735,"el":"C"},{"x":3.51,"y":-0.331,"z":0.401,"el":"C"},{"x":3.532,"y":0.779,"z":-1.74,"el":"C"},{"x":4.218,"y":0.21,"z":-0.672,"el":"C"},{"x":-4.254,"y":-2.759,"z":-1.298,"el":"C"},{"x":-3.292,"y":3.499,"z":0.333,"el":"C"},{"x":-0.524,"y":0.912,"z":1.333,"el":"H"},{"x":-0.
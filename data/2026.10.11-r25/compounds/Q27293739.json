{"version":"2026.10.11-r25","id":"Q27293739","formula":"C₁₅H₁₀ClFN₂O","hill":"C15H10ClFN2O","elements":["H","C","N","O","F","Cl"],"composition":{"C":15.0,"F":1.0,"H":10.0,"N":2.0,"O":1.0,"Cl":1.0},"names":{"en":"Norflurazepam"},"descriptions":{"en":"N-Desalkylflurazepam (also known as norflurazepam) is a benzodiazepine analog and an active metabolite of several other benzodiazepine drugs including flurazepam, flutoprazepam, fludiazepam, midazolam, flutazolam, quazepam, and ethyl loflazepate. It is long-acting, prone to accumulation, and binds unselectively to the various benzodiazepine receptor subtypes. It has been sold as a designer drug from 2016 onward."},"fame":9,"pubchemCid":4540,"mass":288.7,"charge":0,"smiles":"C1C(=O)NC2=C(C=C(C=C2)Cl)C(=N1)C3=CC=CC=C3F","inchikey":"UVCOILFBWYKHHB-UHFFFAOYSA-N","iupac":"7-chloro-5-(2-fluorophenyl)-1,3-dihydro-1,4-benzodiazepin-2-one","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"4540","atoms":30,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-1.52,"y":-4.189,"z":0.971,"el":"Cl"},{"x":2.682,"y":1.586,"z":1.415,"el":"F"},{"x":-2.108,"y":3.682,"z":-0.75,"el":"O"},{"x":-2.417,"y":1.413,"z":-0.764,"el":"N"},{"x":0.236,"y":1.862,"z":0.607,"el":"N"},{"x":-0.894,"y":-0.298,"z":0.211,"el":"C"},{"x":0.287,"y":0.616,"z":0.279,"el":"C"},{"x":-2.111,"y":0.095,"z":-0.368,"el":"C"},{"x":1.629,"y":0.08,"z":-0.091,"el":"C"},{"x":-0.728,"y":-1.625,"z":0.643,"el":"C"},{"x":-1.037,"y":2.437,"z":0.982,"el":"C"},{"x":-3.1,"y":-0.873,"z":-0.603,"el":"C"},{"x":-1.872,"y":2.576,"z":-0.263,"el":"C"},{"x":-1.74,"y":-2.564,"z":0.448,"el":"C"},{"x":-2.918,"y":-2.193,"z":-0.19,"el":"C"},{"x":2.768,"y":0.603,"z":0.507,"el":"C"},{"x":1.722,"y":-0.939,"z":-1.031,"el":"C"},{"x":4.022,"y":0.099,"z":0.16,"el":"C"},{"x":2.975,"y":-1.443,"z":-1.379,"el":"C"},{"x":4.125,"y":-0.9
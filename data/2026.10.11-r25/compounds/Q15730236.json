{"version":"2026.10.11-r25","id":"Q15730236","formula":"Ag₂HgI₄","hill":"Ag2HgI4","elements":["Ag","I","Hg"],"composition":{"I":4.0,"Ag":2.0,"Hg":1.0},"names":{"en":"Silver tetraiodomercurate(II)","ru":"Тетраиодомеркурат(II) серебра(I)"},"descriptions":{"en":"Silver tetraiodomercurate(II), the inorganic chemical having chemical formula Ag2HgI4, is a salt containing silver as cations and the tetraiodomercurate(II) polyatomic metal complex as dianion. This compound is thermochromic, reversibly changing from yellow below 50 °C to orange at higher temperature. This color change is an effect of a change from a highly ordered phase, with the silver ions rigidly held in the crystal structure, to one in which the silver ions are randomly distributed and freely moving.","ru":"Тетраиодомеркура́т(II) серебра́(I) — неорганическое соединение, комплексная соль серебра, ртути и иодистоводородной кислоты с формулой Ag2[HgI4]. Лимонно-жёлтые кристаллы."},"fame":6,"pubchemCid":9941088,"mass":923.95,"charge":0,"smiles":"[Ag+].[Ag+].[I-].[I-].[I-].[I-].[Hg+2]","inchikey":"YNTJRFXPYRRRKS-UHFFFAOYSA-J","iupac":"disilver;mercury(2+);tetraiodide","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"crystal","source":"materialsproject","ref":"mp-570256","atoms":16,"license":"CC BY 4.0, Materials Project"},"structure":{"cell":[[6.479,0.0,0.0],[0.0,6.479,0.0],[0.0,0.0,6.382]],"kind":"crystal","atoms":[{"x":0.0,"y":3.239,"z":3.191,"el":"Ag"},{"x":6.479,"y":3.239,"z":3.191,"el":"Ag"},{"x":3.239,"y":0.0,"z":3.191,"el":"Ag"},{"x":3.239,"y":6.479,"z":3.191,"el":"Ag"},{"x":0.0,"y":0.0,"z":0.0,"el":"Hg"},{"x":0.0,"y":0.0,"z":6.382,"el":"Hg"},{"x":0.0,"y":6.479,"z":0.0,"el":"Hg"},{"x":0.0,"y":6.479,"z":6.382,"el":"Hg"},{"x":6.479,"y":0.0,"z":0.0,"el":"Hg"},{"x":6.479,"y":0.0,"z":6.382,"el":"Hg"},{"x":6.479,"y":6.479,"z":0.0,"el":"Hg"},{"x":6.479,"y":6.479,"z":6.382,"el":"Hg"},{"x":4.775,"y":4.775
{"version":"2026.10.11-r25","id":"Q123499554","formula":"C₁₈H₁₈FN₅O₂","hill":"C18H18FN5O2","elements":["H","C","N","O","F"],"composition":{"C":18.0,"F":1.0,"H":18.0,"N":5.0,"O":2.0},"names":{"en":"Repotrectinib"},"descriptions":{"en":"Repotrectinib, sold under the brand name Augtyro, is an anti-cancer medication used for the treatment of non-small cell lung cancer. It is taken by mouth. Repotrectinib is an inhibitor of proto-oncogene tyrosine-protein kinase ROS1 (ROS1) and of the tropomyosin receptor tyrosine kinases (TRKs) TRKA, TRKB, and TRKC. The most common adverse reactions include dizziness, dysgeusia, peripheral neuropathy, constipation, dyspnea, ataxia, fatigue, cognitive disorders, and muscular weakness."},"fame":3,"pubchemCid":135565923,"mass":355.4,"charge":0,"smiles":"C[C@H]1CNC(=O)C2=C3N=C(C=CN3N=C2)N[C@@H](C4=C(O1)C=CC(=C4)F)C","inchikey":"FIKPXCOQUIZNHB-WDEREUQCSA-N","iupac":"(3R,11S)-6-fluoro-3,11-dimethyl-10-oxa-2,13,17,18,21-pentazatetracyclo[13.5.2.04,9.018,22]docosa-1(21),4(9),5,7,15(22),16,19-heptaen-14-one","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"rdkit","ref":"135565923","atoms":44,"license":"Computed with RDKit from SMILES (PubChem, Wikidata)"},"structure":{"kind":"molecule","atoms":[{"x":-3.102,"y":2.04,"z":-0.501,"el":"C"},{"x":-1.696,"y":1.556,"z":-0.848,"el":"C"},{"x":-0.731,"y":2.772,"z":-0.81,"el":"C"},{"x":0.638,"y":2.33,"z":-0.972,"el":"N"},{"x":1.705,"y":3.022,"z":-0.442,"el":"C"},{"x":1.719,"y":4.237,"z":-0.28,"el":"O"},{"x":2.792,"y":2.156,"z":-0.013,"el":"C"},{"x":2.778,"y":0.774,"z":0.0,"el":"C"},{"x":1.817,"y":-0.108,"z":-0.415,"el":"N"},{"x":1.985,"y":-1.379,"z":-0.167,"el":"C"},{"x":3.224,"y":-1.89,"z":0.53,"el":"C"},{"x":4.158,"y":-0.988,"z":0.867,"el":"C"},{"x":3.954,"y":0.361,"z":0.608,"el":"N"},{"x":4.76,"y":1.413,"z":0.899,"el":"N"},{"x":4.042,"y":2.485,"z":0.542,"el":"C"},{"x":1.035,"y
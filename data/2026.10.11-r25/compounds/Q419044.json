{"version":"2026.10.11-r25","id":"Q419044","formula":"Cu₂AlAsO₄(OH)₄·4H₂O","hill":"AlAsCu2H12O12","elements":["H","O","Al","Cu","As"],"composition":{"H":12.0,"O":12.0,"Al":1.0,"As":1.0,"Cu":2.0},"names":{"en":"Liroconite","uk":"Ліроконіт"},"descriptions":{"en":"Liroconite is a complex mineral: Hydrated copper aluminium arsenate hydroxide, with the formula Cu2Al[(OH)4|AsO4]·4(H2O). It is a vitreous monoclinic mineral, colored bright blue to green, often associated with malachite, azurite, olivenite, and clinoclase. It is quite soft, with a Mohs hardness of 2–2.5, and has a specific gravity of 2.9–3.0.","uk":"Ліроконі́т — рідкісний мінерал, основний водний арсенат міді й алюмінію острівної будови. Назва походить від грецьких слів «лірос» — блідий і «коніа» — порох, що вказує на блідий колір риски, яку залишає на порцеляновій поверхні цей мінерал."},"fame":13,"pubchemCid":null,"mass":null,"charge":0,"smiles":null,"inchikey":null,"iupac":null,"classes":[{"qid":"Q12089225","names":{"en":"mineral species","ru":"действительный вид минералов","uk":"мінеральний вид"}}],"structureInfo":null,"structure":null,"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q419044","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Liroconite","license":"CC BY-SA 4.0"},{"role":"description","name":"Wikipedia (uk)","url":"https://uk.wikipedia.org/wiki/%D0%9B%D1%96%D1%80%D0%BE%D0%BA%D0%BE%D0%BD%D1%96%D1%82","license":"CC BY-SA 4.0"},{"role":"photo","name":"Wikimedia Commons","url":"https://commons.wikimedia.org/wiki/File:Liroconite-226219.jpg","license":"CC BY-SA 3.0"}],"similar":[{"id":"Q421020","formula":"Cu₄Al₂SO₄(OH)₁₂·2H₂O","names":{"en":"Cyanotrichite","ru":"Цианотрихит","uk":"Ціанотрихіт"},"elements":["H","O","Al","S","Cu"],"fame":18,"kind":null},{"id":"Q3817812","formula":"Zn₃(AsO₄)₂·8H₂O","names":{"en":"Köttigite"},"elements":["H","O","Zn","As"],"fame":8,"kind":"crystal"},{"id":"Q3961322","formula":
{"version":"2026.10.11-r25","id":"Q10843651","formula":"C₁₈H₂₂O₃","hill":"C18H22O3","elements":["H","C","O"],"composition":{"C":18.0,"H":22.0,"O":3.0},"names":{"en":"Methallenestril"},"descriptions":{"en":"Methallenestril (INNTooltip International Nonproprietary Name) (brand names Cur-men, Ercostrol, Geklimon, Novestrine, Vallestril), also known as methallenoestril (BANTooltip British Approved Name) and as methallenestrol, as well as Horeau's acid, is a synthetic nonsteroidal estrogen and a derivative of allenolic acid and allenestrol (specifically, a methyl ether of it) that was formerly used to treat menstrual issues but is now no longer marketed. It is a seco-analogue of bisdehydrodoisynolic acid, and although methallenestril is potently estrogenic in rats, in humans it is only weakly so in comparison. Vallestril was a brand of methallenestril issued by G. D. Searle & Company in the 1950s."},"fame":10,"pubchemCid":10599,"mass":286.4,"charge":0,"smiles":"CCC(C1=CC2=C(C=C1)C=C(C=C2)OC)C(C)(C)C(=O)O","inchikey":"KHLJKRBMZVNZOC-UHFFFAOYSA-N","iupac":"3-(6-methoxynaphthalen-2-yl)-2,2-dimethylpentanoic acid","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"10599","atoms":43,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-4.563,"y":-1.186,"z":-1.24,"el":"O"},{"x":-5.378,"y":-0.504,"z":0.762,"el":"O"},{"x":5.622,"y":0.07,"z":0.442,"el":"O"},{"x":-2.181,"y":0.29,"z":-0.471,"el":"C"},{"x":-2.945,"y":-0.718,"z":0.471,"el":"C"},{"x":-2.903,"y":1.663,"z":-0.563,"el":"C"},{"x":-0.694,"y":0.435,"z":-0.149,"el":"C"},{"x":-2.914,"y":-0.265,"z":1.948,"el":"C"},{"x":-2.382,"y":-2.153,"z":0.415,"el":"C"},{"x":-4.422,"y":-0.774,"z":0.046,"el":"C"},{"x":0.195,"y":-0.447,"z":-0.722,"el":"C"},{"x":-2.319,"y":2.576,"z":-1.637,"el":"C"},{"x":-0.299,"y":1.44,"z":0.701,"el":"C"},{"x":1.565,"y":-0.327,"z":-0.43
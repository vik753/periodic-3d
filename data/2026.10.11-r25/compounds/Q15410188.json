{"version":"2026.10.11-r25","id":"Q15410188","formula":"C₂₈H₂₈ClN₃OS","hill":"C28H28ClN3OS","elements":["H","C","N","O","S","Cl"],"composition":{"C":28.0,"H":28.0,"N":3.0,"O":1.0,"S":1.0,"Cl":1.0},"names":{"en":"Smoothened agonist"},"descriptions":{"en":"Smoothened agonist (SAG) was one of the first small-molecule agonists developed for the protein Smoothened, a key part of the hedgehog signaling pathway, which is involved in brain development as well as having a number of other functions in the body. Smoothened agonist has been shown to aid proliferation and survival of developing neurons, and prevent drug-induced brain injury. When injected into the cerebellum of newborn mice with an induced Down syndrome-like condition, Smoothened agonist was able to stimulate normal cerebellum development, resulting in significant behavioural improvement once the mice had grown to adulthood."},"fame":3,"pubchemCid":null,"mass":null,"charge":0,"smiles":"CN[C@H]1CC[C@H](N(Cc2cccc(-c3ccncc3)c2)C(=O)c2sc3ccccc3c2Cl)CC1","inchikey":null,"iupac":null,"classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"rdkit","ref":null,"atoms":62,"license":"Computed with RDKit from SMILES (PubChem, Wikidata)"},"structure":{"kind":"molecule","atoms":[{"x":-3.7,"y":-0.738,"z":1.89,"el":"C"},{"x":-3.303,"y":-0.852,"z":0.491,"el":"N"},{"x":-2.258,"y":-1.864,"z":0.266,"el":"C"},{"x":-2.036,"y":-2.024,"z":-1.253,"el":"C"},{"x":-0.943,"y":-1.112,"z":-1.833,"el":"C"},{"x":-0.738,"y":0.175,"z":-1.019,"el":"C"},{"x":0.199,"y":1.152,"z":-1.638,"el":"N"},{"x":1.418,"y":0.673,"z":-2.305,"el":"C"},{"x":2.504,"y":0.227,"z":-1.352,"el":"C"},{"x":3.175,"y":1.158,"z":-0.55,"el":"C"},{"x":4.16,"y":0.743,"z":0.344,"el":"C"},{"x":4.489,"y":-0.609,"z":0.445,"el":"C"},{"x":3.845,"y":-1.569,"z":-0.351,"el":"C"},{"x":4.186,"y":-2.995,"z":-0.243,"el":"C"},{"x":4.579,"y":-3.733,"z":-1.365,"el":"C"},{"x"
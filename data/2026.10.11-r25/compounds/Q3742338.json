{"version":"2026.10.11-r25","id":"Q3742338","formula":"Al₄(SO₄)(OH)₁₀·4H₂O","hill":"Al4H18O18S","elements":["H","O","Al","S"],"composition":{"H":18.0,"O":18.0,"S":1.0,"Al":4.0},"names":{"en":"Felsőbányaite","uk":"Фельшебаніїт"},"descriptions":{"en":"Felsőbányaite or basaluminite is a hydrated aluminium sulfate mineral with formula: Al4(SO4)(OH)10·4H2O. It is a rare white to pale yellow mineral which typically occurs as globular masses and incrustations or as minute rhombic crystals. It crystallizes in the monoclinic crystal system. It occurs as a weathering product under acidic conditions associated with pyrite or marcasite decomposition.","uk":"Фельшебаніїт — мінерал, основний водний сульфат алюмінію. Від назви родовища Бая-Спріє в Румунії (угор. — Фельшебаня), W.K.Haidinger, 1825."},"fame":8,"pubchemCid":null,"mass":null,"charge":0,"smiles":null,"inchikey":null,"iupac":null,"classes":[{"qid":"Q12089225","names":{"en":"mineral species","ru":"действительный вид минералов","uk":"мінеральний вид"}}],"structureInfo":null,"structure":null,"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q3742338","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Fels%C5%91b%C3%A1nyaite","license":"CC BY-SA 4.0"},{"role":"description","name":"Wikipedia (uk)","url":"https://uk.wikipedia.org/wiki/%D0%A4%D0%B5%D0%BB%D1%8C%D1%88%D0%B5%D0%B1%D0%B0%D0%BD%D1%96%D1%97%D1%82","license":"CC BY-SA 4.0"},{"role":"photo","name":"Wikimedia Commons","url":"https://commons.wikimedia.org/wiki/File:Fels%C3%B6b%C3%A1nyaite16463-2.jpg","license":"CC BY 4.0"}],"similar":[{"id":"Q4023724","formula":"Al₁₂(SO₄)₅(OH)₂₆·20H₂O","names":{"en":"Zaherite"},"elements":["H","O","Al","S"],"fame":10,"kind":null},{"id":"Q3650494","formula":"CuAl₄(SO₄)(OH)₁₂*3H₂O","names":{"en":"Chalcoalumite","uk":"Халькоалюміт"},"elements":["H","O","Al","S","Cu"],"fame":6,"kind":null},{"id":"Q422895","formula":"Ba(UO₂)₂(PO₄)₂·10H₂O","names":{"en":"U
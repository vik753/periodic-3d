{"version":"2026.10.11-r25","id":"Q60173870","formula":"CH₂N₂","hill":"CH2N2","elements":["H","C","N"],"composition":{"C":1.0,"H":2.0,"N":2.0},"names":{"en":"Isodiazomethane"},"descriptions":{"en":"In organic chemistry, isodiazomethane, also known as isocyanamide, aminoisonitrile, or systematically as isocyanoamine, is the parent compound of a class of derivatives of general formula R2N–NC. It has the condensed formula H2N–N+≡C–, making it an isomer of diazomethane. It is prepared by protonating an ethereal solution of lithiodiazomethane, LiCHN2, with aqueous NaH2PO4 or NH4Cl. The parent compound is only marginally stable at room temperature and is isolated by removal of solvent at –50 °C. Derivatives are generally prepared by dehydration of the corresponding substituted formylhydrazine with COCl2 and Et3N."},"fame":3,"pubchemCid":20684874,"mass":42.04,"charge":0,"smiles":"[C-]#[N+]N","inchikey":"DOIJUTUOUQGQPQ-UHFFFAOYSA-N","iupac":"aminoazaniumylidynemethane","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"20684874","atoms":5,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":1.358,"y":0.0,"z":0.0,"el":"N"},{"x":-0.094,"y":0.0,"z":0.0,"el":"N"},{"x":-1.264,"y":0.0,"z":0.0,"el":"C"},{"x":1.713,"y":0.71,"z":-0.639,"el":"H"},{"x":1.713,"y":-0.891,"z":-0.345,"el":"H"}],"bonds":[[0,1,1],[0,3,1],[0,4,1],[1,2,3]]},"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q60173870","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Isodiazomethane","license":"CC BY-SA 4.0"},{"role":"properties","name":"PubChem","url":"https://pubchem.ncbi.nlm.nih.gov/compound/20684874","license":"PubChem (NIH), public data"},{"role":"structure","name":"PubChem 3D","url":"https://pubchem.ncbi.nlm.nih.gov/compound/20684874#section=3D
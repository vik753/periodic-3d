{"version":"2026.10.11-r25","id":"Q15426208","formula":"C₂₀H₂₄NO₄⁺","hill":"C20H24NO4","elements":["H","C","N","O"],"composition":{"C":20.0,"H":24.0,"N":1.0,"O":4.0},"names":{"en":"Magnoflorine"},"descriptions":{"en":"(S)-Magnoflorine is a quaternary benzylisoquinoline alkaloid (BIA) of the aporphine structural subgroup which has been isolated from various species of the family Menispermaceae, such as Pachygone ovata, Sinomenium acutum, and Cissampelos pareira. It was identified among the verified anti-inflammatory components in an extract of Sinomenii caulis and has been proposed to have other potential physiological effects, such as sedative and anxiolytic, reduction of erythrocyte hemolysis, antifungal activity, improvement of LPS-induced acute lung injury, and protection against muscle atrophy."},"fame":8,"pubchemCid":73337,"mass":342.4,"charge":1,"smiles":"C[N+]1(CCC2=CC(=C(C3=C2[C@@H]1CC4=C3C(=C(C=C4)OC)O)O)OC)C","inchikey":"YLRXAIKMLINXQY-ZDUSSCGKSA-O","iupac":"(6aS)-2,10-dimethoxy-6,6-dimethyl-5,6,6a,7-tetrahydro-4H-dibenzo[de,g]quinolin-6-ium-1,11-diol","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"73337","atoms":49,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-1.283,"y":-2.479,"z":-0.653,"el":"O"},{"x":0.841,"y":-4.075,"z":-0.489,"el":"O"},{"x":-2.761,"y":-1.237,"z":0.744,"el":"O"},{"x":-4.78,"y":0.491,"z":0.547,"el":"O"},{"x":2.966,"y":2.043,"z":0.071,"el":"N"},{"x":1.52,"y":1.51,"z":0.309,"el":"C"},{"x":3.94,"y":1.087,"z":0.78,"el":"C"},{"x":1.342,"y":0.013,"z":0.084,"el":"C"},{"x":0.482,"y":2.304,"z":-0.509,"el":"C"},{"x":3.86,"y":-0.318,"z":0.201,"el":"C"},{"x":2.457,"y":-0.846,"z":0.077,"el":"C"},{"x":3.14,"y":3.423,"z":0.723,"el":"C"},{"x":3.326,"y":2.175,"z":-1.41,"el":"C"},{"x":0.027,"y":-0.504,"z":-0.049,"el":"C"},{"x":-0.916,"y":1.803,"z":-0.222,"el":"C"},{"x":
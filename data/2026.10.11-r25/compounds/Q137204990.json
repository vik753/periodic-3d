{"version":"2026.10.11-r25","id":"Q137204990","formula":"C₂₃H₃₀N₃O₄","hill":"C23H30N3O4","elements":["H","C","N","O"],"composition":{"C":23.0,"H":30.0,"N":3.0,"O":4.0},"names":{"en":"TMU4142"},"descriptions":{"en":"TMU4142 is a potent and selective serotonin 5-HT1A receptor biased agonist. It is a preferential near-full agonist of the GoA pathway with weak agonism of the Gi3 pathway and little or no β-arrestin2 recruitment. Presynaptic serotonin 5-HT1A autoreceptors predominantly signal via the Gi3 pathway in the dorsal raphe nucleus (DRN) and are associated with feedback inhibition that may hamper therapeutic effects, whereas postsynaptic serotonin 5-HT1A heteroreceptors couple mainly to Go pathways in hippocampal and cortical areas and are thought to mediate antidepressant-like effects."},"fame":1,"pubchemCid":null,"mass":null,"charge":0,"smiles":"O=C1CC2(CCCC2)CC(=O)N1CCCNC[C](O)COc1cccc2[nH]ccc12","inchikey":null,"iupac":null,"classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"rdkit","ref":null,"atoms":60,"license":"Computed with RDKit from SMILES (PubChem, Wikidata)"},"structure":{"kind":"molecule","atoms":[{"x":-1.596,"y":0.491,"z":-0.061,"el":"O"},{"x":-2.719,"y":-0.015,"z":-0.096,"el":"C"},{"x":-3.839,"y":0.593,"z":0.717,"el":"C"},{"x":-5.224,"y":0.279,"z":0.146,"el":"C"},{"x":-6.334,"y":0.853,"z":1.04,"el":"C"},{"x":-6.431,"y":2.327,"z":0.656,"el":"C"},{"x":-5.913,"y":2.424,"z":-0.778,"el":"C"},{"x":-5.502,"y":1.009,"z":-1.18,"el":"C"},{"x":-5.336,"y":-1.235,"z":0.03,"el":"C"},{"x":-4.235,"y":-1.835,"z":-0.813,"el":"C"},{"x":-4.435,"y":-2.888,"z":-1.42,"el":"O"},{"x":-3.007,"y":-1.179,"z":-0.805,"el":"N"},{"x":-1.929,"y":-1.77,"z":-1.599,"el":"C"},{"x":-1.233,"y":-2.95,"z":-0.91,"el":"C"},{"x":-0.55,"y":-2.635,"z":0.424,"el":"C"},{"x":0.489,"y":-1.615,"z":0.279,"el":"N"},{"x":1.234,"y":-1.456,"z":1.53,"el":"C"},{"x":2.303,"y":-0.434
{"version":"2026.10.11-r25","id":"Q28131983","formula":"C₁₉H₂₈O₃","hill":"C19H28O3","elements":["H","C","O"],"composition":{"C":19.0,"H":28.0,"O":3.0},"names":{"en":"Methylhydroxynandrolone"},"descriptions":{"en":"Methylhydroxynandrolone (MOHN, MHN), also known as 4-hydroxy-17α-methyl-19-nortestosterone (HMNT), as well as 4,17β-dihydroxy-17α-methylestr-4-en-3-one, is a synthetic, orally active anabolic–androgenic steroid (AAS) and a 17α-alkylated derivative of nandrolone (19-nortestosterone) which was never marketed. It was first described in 1964 and was studied in the treatment of breast cancer, but was not introduced for clinical use. The drug re-emerged in 2004 when it started being sold on the Internet as a \"dietary supplement\"."},"fame":2,"pubchemCid":351707,"mass":304.4,"charge":0,"smiles":"CC12CCC3C(C1CCC2(C)O)CCC4=C(C(=O)CCC34)O","inchikey":"CLNUZOCYKSHICX-UHFFFAOYSA-N","iupac":"4,17-dihydroxy-13,17-dimethyl-1,2,6,7,8,9,10,11,12,14,15,16-dodecahydrocyclopenta[a]phenanthren-3-one","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"rdkit","ref":"351707","atoms":50,"license":"Computed with RDKit from SMILES (PubChem, Wikidata)"},"structure":{"kind":"molecule","atoms":[{"x":2.992,"y":0.18,"z":-2.082,"el":"C"},{"x":2.1,"y":0.321,"z":-0.817,"el":"C"},{"x":1.247,"y":1.589,"z":-1.018,"el":"C"},{"x":-0.025,"y":1.689,"z":-0.187,"el":"C"},{"x":-0.892,"y":0.434,"z":-0.323,"el":"C"},{"x":-0.081,"y":-0.814,"z":0.125,"el":"C"},{"x":1.246,"y":-0.971,"z":-0.663,"el":"C"},{"x":2.2,"y":-1.97,"z":0.032,"el":"C"},{"x":3.352,"y":-1.164,"z":0.644,"el":"C"},{"x":2.967,"y":0.312,"z":0.48,"el":"C"},{"x":4.194,"y":1.223,"z":0.467,"el":"C"},{"x":2.18,"y":0.686,"z":1.613,"el":"O"},{"x":-0.944,"y":-2.094,"z":0.0,"el":"C"},{"x":-2.284,"y":-1.975,"z":0.73,"el":"C"},{"x":-3.013,"y":-0.75,"z":0.234,"el":"C"},{"x":-4.184,"y":-0.765,"z":-0.438,"el":"C"},{"x":-4.705
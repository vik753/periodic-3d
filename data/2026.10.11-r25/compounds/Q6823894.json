{"version":"2026.10.11-r25","id":"Q6823894","formula":"C₂₁H₃₆FO₂P","hill":"C21H36FO2P","elements":["H","C","O","F","P"],"composition":{"C":21.0,"F":1.0,"H":36.0,"O":2.0,"P":1.0},"names":{"en":"Methoxy arachidonyl fluorophosphonate"},"descriptions":{"en":"Methoxy arachidonyl fluorophosphonate, commonly referred as MAFP, is an irreversible active site-directed enzyme inhibitor that inhibits nearly all serine hydrolases and serine proteases. It inhibits phospholipase A2 and fatty acid amide hydrolase with special potency, displaying IC50 values in the low-nanomolar range. In addition, it binds to the CB1 receptor in rat brain membrane preparations (IC50 = 20 nM), but does not appear to agonize or antagonize the receptor, though some related derivatives do show cannabinoid-like properties."},"fame":7,"pubchemCid":10429254,"mass":370.5,"charge":0,"smiles":"CCCCC/C=C\\C/C=C\\C/C=C\\C/C=C\\CCCCP(=O)(OC)F","inchikey":"KWKZCGMJGHHOKJ-ZKWNWVNESA-N","iupac":"(5Z,8Z,11Z,14Z)-1-[fluoro(methoxy)phosphoryl]icosa-5,8,11,14-tetraene","classes":[{"qid":"Q59199015","names":{"en":"group of stereoisomers","ru":"группа стереоизомеров","uk":"група стереоізомерів"}}],"structureInfo":{"kind":"molecule","source":"rdkit","ref":"10429254","atoms":61,"license":"Computed with RDKit from SMILES (PubChem, Wikidata)"},"structure":{"kind":"molecule","atoms":[{"x":-1.641,"y":3.59,"z":-0.958,"el":"C"},{"x":-1.552,"y":2.445,"z":0.038,"el":"C"},{"x":-2.744,"y":1.488,"z":-0.02,"el":"C"},{"x":-2.959,"y":0.778,"z":-1.361,"el":"C"},{"x":-1.761,"y":-0.065,"z":-1.806,"el":"C"},{"x":-2.081,"y":-0.823,"z":-3.064,"el":"C"},{"x":-2.08,"y":-2.156,"z":-3.23,"el":"C"},{"x":-1.718,"y":-3.205,"z":-2.215,"el":"C"},{"x":-2.935,"y":-3.721,"z":-1.501,"el":"C"},{"x":-3.045,"y":-4.024,"z":-0.196,"el":"C"},{"x":-1.972,"y":-3.978,"z":0.854,"el":"C"},{"x":-2.277,"y":-2.953,"z":1.908,"el":"C"},{"x":-1.526,"y":-1.901,"z":2.276,"el":"C"},{"x":-0.216,"y":-1.455,"z":1.697,"el":"C"},{"x":0.918,"y":-1.746,"z":2.637,"el":"C"},{"x":1.6
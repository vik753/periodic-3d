{"version":"2026.10.11-r25","id":"Q3651150","formula":"C₁₉H₁₈ClN₃O₃","hill":"C19H18ClN3O3","elements":["H","C","N","O","Cl"],"composition":{"C":19.0,"H":18.0,"N":3.0,"O":3.0,"Cl":1.0},"names":{"en":"Camazepam"},"descriptions":{"en":"Camazepam is a benzodiazepine psychoactive drug, marketed under the brand names Albego, Limpidon and Paxor. It is the dimethyl carbamate ester of temazepam, a metabolite of diazepam. While it possesses anxiolytic, anticonvulsant, skeletal muscle relaxant and hypnotic properties it differs from other benzodiazepines in that its anxiolytic properties are particularly prominent but has comparatively limited anticonvulsant, hypnotic and skeletal muscle relaxant properties."},"fame":15,"pubchemCid":37367,"mass":371.8,"charge":0,"smiles":"CN1C2=C(C=C(C=C2)Cl)C(=NC(C1=O)OC(=O)N(C)C)C3=CC=CC=C3","inchikey":"PXBVEXGRHZFEOF-UHFFFAOYSA-N","iupac":"(7-chloro-1-methyl-2-oxo-5-phenyl-3H-1,4-benzodiazepin-3-yl) N,N-dimethylcarbamate","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"37367","atoms":44,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-4.223,"y":1.499,"z":-2.887,"el":"Cl"},{"x":2.898,"y":0.388,"z":0.155,"el":"O"},{"x":2.005,"y":1.598,"z":2.289,"el":"O"},{"x":2.659,"y":-0.88,"z":-1.731,"el":"O"},{"x":-0.043,"y":2.166,"z":1.346,"el":"N"},{"x":0.694,"y":-0.601,"z":0.358,"el":"N"},{"x":4.772,"y":-0.549,"z":-0.819,"el":"N"},{"x":-1.058,"y":1.958,"z":0.35,"el":"C"},{"x":-1.287,"y":0.712,"z":-0.266,"el":"C"},{"x":-0.578,"y":-0.53,"z":0.158,"el":"C"},{"x":1.488,"y":0.602,"z":0.174,"el":"C"},{"x":1.178,"y":1.478,"z":1.38,"el":"C"},{"x":-1.372,"y":-1.772,"z":0.386,"el":"C"},{"x":-1.884,"y":3.034,"z":-0.031,"el":"C"},{"x":-2.255,"y":0.581,"z":-1.278,"el":"C"},{"x":-0.273,"y":3.205,"z":2.351,"el":"C"},{"x":-2.857,"y":2.893,"z":-1.024,"el":"C"},{"x":-3.035,"y":1.67,"z":-1.6
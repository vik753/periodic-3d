{"version":"2026.10.11-r25","id":"Q6026626","formula":"C₁₃H₁₆N₂O₃","hill":"C13H16N2O3","elements":["H","C","N","O"],"composition":{"C":13.0,"H":16.0,"N":2.0,"O":3.0},"names":{"en":"Indorenate"},"descriptions":{"en":"Indorenate (developmental code name TR-3369), also known as β-methoxycarbonyl-5-methoxytryptamine, is a tryptamine derivative which acts as an agonist at the 5-HT1A, 5-HT1B and 5-HT2C serotonin receptors. It has anxiolytic, antihypertensive and anorectic effects, predominantly through action at 5-HT1A, but with some contribution from the 5-HT1B and 5-HT2C subtypes, and possibly some other non-serotonergic targets also. In addition to the preceding serotonin receptors, indorenate may also act as an agonist of the serotonin 5-HT2A receptor."},"fame":7,"pubchemCid":71987,"mass":248.28,"charge":0,"smiles":"COC1=CC2=C(C=C1)NC=C2C(CN)C(=O)OC","inchikey":"YFEDJMLMWJSRJJ-UHFFFAOYSA-N","iupac":"methyl 3-amino-2-(5-methoxy-1H-indol-3-yl)propanoate","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"71987","atoms":34,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":3.679,"y":-1.199,"z":0.357,"el":"O"},{"x":-3.677,"y":-1.915,"z":0.162,"el":"O"},{"x":2.626,"y":0.362,"z":1.68,"el":"O"},{"x":-0.554,"y":2.591,"z":0.188,"el":"N"},{"x":1.519,"y":-0.107,"z":-2.956,"el":"N"},{"x":1.64,"y":-0.251,"z":-0.475,"el":"C"},{"x":0.548,"y":0.702,"z":-0.196,"el":"C"},{"x":-0.828,"y":0.386,"z":-0.019,"el":"C"},{"x":-1.497,"y":1.589,"z":0.221,"el":"C"},{"x":2.413,"y":-0.004,"z":-1.805,"el":"C"},{"x":0.685,"y":2.065,"z":-0.063,"el":"C"},{"x":-1.571,"y":-0.811,"z":-0.039,"el":"C"},{"x":2.681,"y":-0.314,"z":0.661,"el":"C"},{"x":-2.877,"y":1.654,"z":0.442,"el":"C"},{"x":-2.952,"y":-0.761,"z":0.18,"el":"C"},{"x":-3.593,"y":0.454,"z":0.417,"el":"C"},{"x":4.721,"y":-1.316,"z":1.331,"el":"C"},{"x":-2.963,"y":-3.124,"
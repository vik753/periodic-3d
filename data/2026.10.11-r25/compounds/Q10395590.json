{"version":"2026.10.11-r25","id":"Q10395590","formula":"C₁₀H₈O₃S","hill":"C10H8O3S","elements":["H","C","O","S"],"composition":{"C":10.0,"H":8.0,"O":3.0,"S":1.0},"names":{"en":"2-naphthalenesulfonic acid"},"descriptions":{"en":"Naphthalene-2-sulfonic acid is an organic compound with the formula C10H7SO3H. A colorless, water-soluble solid, it is often available as the mono- and trihydrates C10H7SO3H.2H2O. It is one of two monosulfonic acids of naphthalene, the other being naphthalene-1-sulfonic acid. The compound is mainly used in the production of dyes via nitration en route to aminonaphthalenesulfonic acids. The compound is prepared by sulfonation of naphthalene with sulfuric acid, however under equilibrating conditions that allow the 1-sulfonic acid isomer to convert to the more stable 2-sulfonic acid."},"fame":7,"pubchemCid":8420,"mass":208.24,"charge":0,"smiles":"C1=CC=C2C=C(C=CC2=C1)S(=O)(=O)O","inchikey":"KVBGVZZKJNLNJU-UHFFFAOYSA-N","iupac":"naphthalene-2-sulfonic acid","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"8420","atoms":22,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-2.929,"y":-0.245,"z":0.085,"el":"S"},{"x":-3.377,"y":-0.364,"z":-1.483,"el":"O"},{"x":-3.064,"y":-1.573,"z":0.666,"el":"O"},{"x":-3.622,"y":0.893,"z":0.667,"el":"O"},{"x":1.097,"y":-0.549,"z":0.019,"el":"C"},{"x":1.502,"y":0.807,"z":-0.005,"el":"C"},{"x":-1.231,"y":0.158,"z":0.047,"el":"C"},{"x":-0.273,"y":-0.857,"z":0.045,"el":"C"},{"x":0.524,"y":1.815,"z":-0.003,"el":"C"},{"x":-0.833,"y":1.492,"z":0.023,"el":"C"},{"x":2.075,"y":-1.558,"z":0.016,"el":"C"},{"x":2.872,"y":1.114,"z":-0.032,"el":"C"},{"x":3.431,"y":-1.234,"z":-0.01,"el":"C"},{"x":3.829,"y":0.1,"z":-0.034,"el":"C"},{"x":-0.584,"y":-1.9,"z":0.056,"el":"H"},{"x":0.812,"y":2.864,"z":-0.023,"el":"H"},{"x":-1.56,"y":2.298,"z":0.017,"el":"H"},{
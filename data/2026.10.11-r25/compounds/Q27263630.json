{"version":"2026.10.11-r25","id":"Q27263630","formula":"H₂O","hill":"H2O","elements":["H","O"],"composition":{"H":2.0,"O":1.0},"names":{"en":"Water O-15"},"descriptions":{"en":"Oxygen-15 labelled water (also known as 15O-water, [O-15]-H2O, or H215O) is a radioactive variation of regular water, in which the oxygen atom has been replaced by oxygen-15 (15O), a positron-emitting isotope. 15O-water is used as a radioactive tracer for measuring and quantifying blood flow using positron emission tomography (PET) in the heart, brain and tumors."},"fame":2,"pubchemCid":10129877,"mass":17.019,"charge":0,"smiles":"[15OH2]","inchikey":"XLYOFNOQVPJJNP-BJUDXGSMSA-N","iupac":"oxidane","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"10129877","atoms":3,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":0.0,"y":0.0,"z":0.0,"el":"O"},{"x":0.277,"y":0.893,"z":0.254,"el":"H"},{"x":0.607,"y":-0.238,"z":-0.717,"el":"H"}],"bonds":[[0,1,1],[0,2,1]]},"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q27263630","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Oxygen-15_labelled_water","license":"CC BY-SA 4.0"},{"role":"properties","name":"PubChem","url":"https://pubchem.ncbi.nlm.nih.gov/compound/10129877","license":"PubChem (NIH), public data"},{"role":"structure","name":"PubChem 3D","url":"https://pubchem.ncbi.nlm.nih.gov/compound/10129877#section=3D-Conformer","license":"PubChem (NIH), public data"}],"similar":[{"id":"Q283","formula":"H₂O","names":{"en":"Water","ru":"Вода","uk":"Вода"},"elements":["H","O"],"fame":330,"kind":"molecule"},{"id":"Q23392","formula":"H₂O","names":{"en":"Ice","ru":"Лёд","uk":"Лід"},"elements":["H","O"],"fame":178,"kind":"crystal"},{"id":"Q155890","formula":"D₂O","names":{"en":"Heavy water","ru":"Т
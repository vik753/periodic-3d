{"version":"2026.10.11-r25","id":"Q7071997","formula":"C₁₄H₁₆Cl₂O₂","hill":"C14H16Cl2O2","elements":["H","C","O","Cl"],"composition":{"C":14.0,"H":16.0,"O":2.0,"Cl":2.0},"names":{"en":"O-2172"},"descriptions":{"en":"O-2172 is a drug developed by Organix Inc, which acts as a stimulant and potent dopamine reuptake inhibitor. It is an analogue of methylphenidate where the phenyl ring has had a 3,4-dichloro substitution added, and the piperidine ring has been replaced by cyclopentane. It is around 1/3 the potency of methylphenidate, demonstrating that even with the important binding group of the nitrogen lone pair removed entirely, selective DAT binding and reuptake inhibition is still possible."},"fame":4,"pubchemCid":11778793,"mass":287.2,"charge":0,"smiles":"COC(=O)C(C1CCCC1)C2=CC(=C(C=C2)Cl)Cl","inchikey":"NEHPFNBRZYFWFN-UHFFFAOYSA-N","iupac":"methyl 2-cyclopentyl-2-(3,4-dichlorophenyl)acetate","classes":[{"qid":"Q59199015","names":{"en":"group of stereoisomers","ru":"группа стереоизомеров","uk":"група стереоізомерів"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"11778793","atoms":34,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-3.194,"y":-0.588,"z":-2.437,"el":"Cl"},{"x":-4.887,"y":-0.978,"z":0.292,"el":"Cl"},{"x":0.465,"y":2.682,"z":0.545,"el":"O"},{"x":2.023,"y":1.999,"z":-1.007,"el":"O"},{"x":1.839,"y":-0.683,"z":-0.165,"el":"C"},{"x":3.33,"y":-0.377,"z":-0.062,"el":"C"},{"x":1.739,"y":-2.048,"z":0.508,"el":"C"},{"x":4.003,"y":-1.717,"z":-0.341,"el":"C"},{"x":2.975,"y":-2.792,"z":0.015,"el":"C"},{"x":0.965,"y":0.373,"z":0.488,"el":"C"},{"x":-0.52,"y":0.031,"z":0.422,"el":"C"},{"x":1.241,"y":1.757,"z":-0.097,"el":"C"},{"x":-1.115,"y":-0.107,"z":-0.814,"el":"C"},{"x":-1.217,"y":-0.13,"z":1.6,"el":"C"},{"x":-2.473,"y":-0.42,"z":-0.875,"el":"C"},{"x":-2.575,"y":-0.444,"z":1.539,"el":"C"},{"x":-3.203,"y":-0.589,"z":0.302,"el":"C"},{"x":0.605,"y":4.031,"z":0.088,"el":"C"},{"x":1.591,"y":-0.793,"z":-1.23,"el":"H
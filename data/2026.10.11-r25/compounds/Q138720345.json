{"version":"2026.10.11-r25","id":"Q138720345","formula":"CCl₃I","hill":"CCl3I","elements":["C","Cl","I"],"composition":{"C":1.0,"I":1.0,"Cl":3.0},"names":{"en":"Trichloroiodomethane"},"descriptions":{"en":"Trichloroiodomethane is a tetrahalomethane with the chemical formula CCl3I. It contains one chlorine and three iodine atoms attached to a central carbon atom. Despite its relative simplicity, trichloroiodomethane was not commercially available as of 2015. Like other iodinated tetrahalomethanes, trichloroiodomethane decomposes easily, releasing iodine, The iodine atom is susceptible to halogen bonds; CCl3I forms 1:1 adducts with pnictogen bases."},"fame":4,"pubchemCid":576109,"mass":245.27,"charge":0,"smiles":"C(Cl)(Cl)(Cl)I","inchikey":"SFLKZLQXODICBP-UHFFFAOYSA-N","iupac":"trichloro(iodo)methane","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"576109","atoms":5,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":2.015,"y":0.0,"z":0.0,"el":"I"},{"x":-0.646,"y":-1.377,"z":-0.964,"el":"Cl"},{"x":-0.646,"y":-0.146,"z":1.674,"el":"Cl"},{"x":-0.646,"y":1.523,"z":-0.711,"el":"Cl"},{"x":-0.077,"y":0.0,"z":0.0,"el":"C"}],"bonds":[[0,4,1],[1,4,1],[2,4,1],[3,4,1]]},"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q138720345","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Trichloroiodomethane","license":"CC BY-SA 4.0"},{"role":"properties","name":"PubChem","url":"https://pubchem.ncbi.nlm.nih.gov/compound/576109","license":"PubChem (NIH), public data"},{"role":"structure","name":"PubChem 3D","url":"https://pubchem.ncbi.nlm.nih.gov/compound/576109#section=3D-Conformer","license":"PubChem (NIH), public data"}],"similar":[{"id":"Q23780617","formula":"CBrCl₃","names":{"en":"Bromotrichloromethane"},"elements":["C
{"version":"2026.10.11-r25","id":"Q5470067","formula":"C₂₁H₂₈O₄","hill":"C21H28O4","elements":["H","C","O"],"composition":{"C":21.0,"H":28.0,"O":4.0},"names":{"en":"Formebolone"},"descriptions":{"en":"Formebolone (INN, BAN) (brand names Esiclene, Hubernol, Metanor), also known as formyldienolone, as well as 2-formyl-11α-hydroxy-17α-methyl-δ1-testosterone, is an orally active anabolic-androgenic steroid (AAS) described as an anticatabolic and anabolic drug that is or has been marketed in Spain and Italy. As an AAS, it shows some anabolic activity, though it is inferior to testosterone in terms of potency, but is said to have virtually no androgenic activity. Formebolone counteracts the catabolic effects (control of nitrogen balance) of potent glucocorticoids like dexamethasone phosphate."},"fame":9,"pubchemCid":17150,"mass":344.4,"charge":0,"smiles":"C[C@@]1(CC[C@@H]2[C@@]1(C[C@H]([C@H]3[C@H]2CCC4=CC(=O)C(=C[C@]34C)C=O)O)C)O","inchikey":"AMVODTGMYSRMNP-GNIMZFFESA-N","iupac":"(8S,9S,10R,11R,13S,14S,17S)-11,17-dihydroxy-10,13,17-trimethyl-3-oxo-7,8,9,11,12,14,15,16-octahydro-6H-cyclopenta[a]phenanthrene-2-carbaldehyde","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"17150","atoms":53,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-5.305,"y":1.241,"z":-0.145,"el":"O"},{"x":0.193,"y":2.559,"z":-0.115,"el":"O"},{"x":5.078,"y":-0.76,"z":1.229,"el":"O"},{"x":5.596,"y":1.871,"z":0.734,"el":"O"},{"x":-2.955,"y":0.507,"z":-0.209,"el":"C"},{"x":-2.285,"y":-0.744,"z":0.393,"el":"C"},{"x":-0.953,"y":-1.091,"z":-0.284,"el":"C"},{"x":0.051,"y":0.11,"z":-0.133,"el":"C"},{"x":-4.308,"y":0.513,"z":0.569,"el":"C"},{"x":-2.011,"y":1.688,"z":0.036,"el":"C"},{"x":-3.399,"y":-1.787,"z":0.375,"el":"C"},{"x":-0.606,"y":1.462,"z":-0.562,"el":"C"},{"x":1.447,"y":-0.228,"z":-0.814,"el":"C"},{"x":-4.69,"y":-0.988,
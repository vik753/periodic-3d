{"version":"2026.10.11-r25","id":"Q27282436","formula":"C₂₀H₂₅N₃O₃","hill":"C20H25N3O3","elements":["H","C","N","O"],"composition":{"C":20.0,"H":25.0,"N":3.0,"O":3.0},"names":{"en":"2-oxo-3-hydroxy-lysergide"},"descriptions":{"en":"2-Oxo-3-hydroxy-LSD, or 2-oxy-3-hydroxy-LSD, also known as O-H-LSD or OH-LSD, as well as more fully as 2-oxo-3-hydroxy-2,3-dihydro-LSD, is a lysergamide and the major metabolite of the psychedelic drug lysergic acid diethylamide (LSD). LSD is eliminated 13% as O-H-LSD in urine within 24 hours and urinary concentrations of O-H-LSD are 4 to 40 times those of LSD in humans. The specific enzymes responsible for the formation of O-H-LSD from LSD are unclear."},"fame":1,"pubchemCid":10155149,"mass":355.4,"charge":0,"smiles":"CCN(CC)C(=O)[C@H]1CN([C@@H]2CC3(C4=C(C2=C1)C=CC=C4NC3=O)O)C","inchikey":"YSZSHHCNLVHCNV-VRORWYBRSA-N","iupac":"(6aR,9R)-N,N-diethyl-5a-hydroxy-7-methyl-5-oxo-6,6a,8,9-tetrahydro-4H-indolo[4,3-fg]quinoline-9-carboxamide","classes":[{"qid":"Q59199015","names":{"en":"group of stereoisomers","ru":"группа стереоизомеров","uk":"група стереоізомерів"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"10155149","atoms":51,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":2.808,"y":1.109,"z":1.911,"el":"O"},{"x":5.011,"y":2.17,"z":0.152,"el":"O"},{"x":-2.875,"y":-1.006,"z":1.552,"el":"O"},{"x":-0.625,"y":2.119,"z":-0.433,"el":"N"},{"x":4.91,"y":-0.18,"z":-0.051,"el":"N"},{"x":-4.569,"y":-0.3,"z":0.125,"el":"N"},{"x":0.446,"y":1.272,"z":0.148,"el":"C"},{"x":2.909,"y":0.941,"z":0.503,"el":"C"},{"x":1.875,"y":1.781,"z":-0.229,"el":"C"},{"x":0.243,"y":-0.245,"z":-0.063,"el":"C"},{"x":2.673,"y":-0.493,"z":0.157,"el":"C"},{"x":1.451,"y":-1.109,"z":-0.054,"el":"C"},{"x":-2.204,"y":0.164,"z":-0.384,"el":"C"},{"x":-1.936,"y":1.622,"z":0.015,"el":"C"},{"x":-0.993,"y":-0.724,"z":-0.306,"el":"C"},{"x":3.888,"y":-1.128,"z":-0.071,"el":"C"},{"x":4.397,"y":1.114,"z":0.168,"el":"C"},{"x":-0.566,"y":2.
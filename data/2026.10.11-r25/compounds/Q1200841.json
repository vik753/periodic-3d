{"version":"2026.10.11-r25","id":"Q1200841","formula":"C₁₈H₂₈N₄O₇","hill":"C18H28N4O7","elements":["H","C","N","O"],"composition":{"C":18.0,"H":28.0,"N":4.0,"O":7.0},"names":{"en":"Deoxypyridinoline"},"descriptions":{"en":"Deoxypyridinoline, also called D-Pyrilinks, Pyrilinks-D, or deoxyPYD, is one of two pyridinium cross-links that provide structural stiffness to type I collagen found in bones. It is excreted unmetabolized in urine and is a specific marker of bone resorption and osteoclastic activity. It is measured in urine tests and is used along with other bone markers such as alkaline phosphatase, osteocalcin, and N-terminal telopeptide to diagnose bone diseases such as postmenopausal osteoporosis, bone metastasis, and Paget's disease, furthermore, it has been useful in monitoring treatments that contain bone-active agents such as estrogens and bisphosphonates."},"fame":5,"pubchemCid":105071,"mass":412.4,"charge":0,"smiles":"C1=C(C(=C(C=[N+]1CCCC[C@H](C(=O)[O-])N)O)C[C@@H](C(=O)O)N)CC[C@@H](C(=O)O)N","inchikey":"ZAHDXEIQWWLQQL-RDBSUJKOSA-N","iupac":"(2R)-2-amino-6-[4-[(2S)-2-amino-2-carboxyethyl]-3-[(3S)-3-amino-3-carboxypropyl]-5-hydroxypyridin-1-ium-1-yl]hexanoate","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"105071","atoms":57,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-1.063,"y":3.019,"z":-1.3,"el":"O"},{"x":-2.952,"y":3.766,"z":0.988,"el":"O"},{"x":-5.048,"y":-2.785,"z":1.451,"el":"O"},{"x":-4.503,"y":4.004,"z":-0.649,"el":"O"},{"x":-5.48,"y":-2.991,"z":-0.764,"el":"O"},{"x":7.582,"y":1.071,"z":-0.729,"el":"O"},{"x":8.111,"y":0.242,"z":1.332,"el":"O"},{"x":0.904,"y":0.672,"z":0.589,"el":"N"},{"x":-5.395,"y":1.464,"z":-0.118,"el":"N"},{"x":-3.244,"y":-4.593,"z":-0.994,"el":"N"},{"x":7.692,"y":-1.694,"z":-1.257,"el":"N"},{"x":-1.283,"y":-0.207,"z":0.418,"el":"C"},{"x":-
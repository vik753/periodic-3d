{"version":"2026.10.11-r25","id":"Q105334909","formula":"C₂₈H₂₂Cl₃N₃O₅","hill":"C28H22Cl3N3O5","elements":["H","C","N","O","Cl"],"composition":{"C":28.0,"H":22.0,"N":3.0,"O":5.0,"Cl":3.0},"names":{"en":"Cilofexor"},"descriptions":{"en":"Cilofexor (also known as GS-9674) is a nonsteroidal farnesoid X receptor (FXR) agonist in clinical trials for the treatment of non-alcoholic fatty liver disease (NAFLD), non-alcoholic steatohepatitis (NASH), and primary sclerosing cholangitis (PSC). It is being investigated for use alone or in combination with firsocostat, selonsertib, or semaglutide. In rat models and human clinical trials of NASH it has been shown to reduce fibrosis and steatosis, and in human clinical trials of PSC it improved cholestasis and reduced markers of liver injury."},"fame":1,"pubchemCid":71228883,"mass":586.8,"charge":0,"smiles":"C1CC1C2=C(C(=NO2)C3=C(C=CC=C3Cl)Cl)COC4=CC(=C(C=C4)C5(CN(C5)C6=NC=CC(=C6)C(=O)O)O)Cl","inchikey":"KZSKGLFYQAYZCO-UHFFFAOYSA-N","iupac":"2-[3-[2-chloro-4-[[5-cyclopropyl-3-(2,6-dichlorophenyl)-1,2-oxazol-4-yl]methoxy]phenyl]-3-hydroxyazetidin-1-yl]pyridine-4-carboxylic acid","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"rdkit","ref":"71228883","atoms":61,"license":"Computed with RDKit from SMILES (PubChem, Wikidata)"},"structure":{"kind":"molecule","atoms":[{"x":-4.755,"y":0.287,"z":-4.5,"el":"C"},{"x":-5.211,"y":1.709,"z":-4.64,"el":"C"},{"x":-4.139,"y":1.36,"z":-3.641,"el":"C"},{"x":-4.486,"y":1.414,"z":-2.131,"el":"C"},{"x":-4.149,"y":0.474,"z":-1.179,"el":"C"},{"x":-4.705,"y":1.007,"z":0.026,"el":"C"},{"x":-5.322,"y":2.176,"z":-0.204,"el":"N"},{"x":-5.173,"y":2.428,"z":-1.55,"el":"O"},{"x":-4.674,"y":0.443,"z":1.369,"el":"C"},{"x":-3.815,"y":0.968,"z":2.351,"el":"C"},{"x":-3.786,"y":0.42,"z":3.639,"el":"C"},{"x":-4.608,"y":-0.656,"z":3.965,"el":"C"},{"x":-5.463,"y":-1.187,"z":3.002,"el":"C"},{"
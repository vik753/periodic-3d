{"version":"2026.10.11-r25","id":"Q2281857","formula":"C₇H₇N","hill":"C7H7N","elements":["H","C","N"],"composition":{"C":7.0,"H":7.0,"N":1.0},"names":{"en":"Azocine"},"descriptions":{"en":"Azocine is a heterocyclic organic compound with the molecular formula C7H7N. It consists of an unsaturated eight-membered ring having seven carbon atoms, one nitrogen atom and four double bonds. The parent compound is thermally unstable and polymerizes at −50 °C. It can be prepared temporarily through diazabasketene pyrolysis: a retro-Diels–Alder decomposition and subsequent hydrocyanic acid elimination. Nevertheless, azocine-type rings are found in many natural products."},"fame":9,"pubchemCid":6451481,"mass":105.14,"charge":0,"smiles":"C\\1=C\\C=C/N=C\\C=C1","inchikey":"XXRGLCKZBCIEKO-BCLLOLPUSA-N","iupac":"(3Z,5Z,7Z)-azocine","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"6451481","atoms":15,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":1.652,"y":-0.278,"z":-0.426,"el":"N"},{"x":-1.642,"y":0.33,"z":-0.405,"el":"C"},{"x":-1.437,"y":-0.883,"z":0.354,"el":"C"},{"x":-0.865,"y":1.422,"z":-0.371,"el":"C"},{"x":-0.324,"y":-1.626,"z":0.405,"el":"C"},{"x":0.325,"y":1.576,"z":0.43,"el":"C"},{"x":0.887,"y":-1.32,"z":-0.393,"el":"C"},{"x":1.403,"y":0.779,"z":0.405,"el":"C"},{"x":-2.558,"y":0.361,"z":-0.991,"el":"H"},{"x":-2.312,"y":-1.234,"z":0.897,"el":"H"},{"x":-1.174,"y":2.303,"z":-0.927,"el":"H"},{"x":-0.308,"y":-2.556,"z":0.964,"el":"H"},{"x":0.332,"y":2.441,"z":1.089,"el":"H"},{"x":1.188,"y":-2.156,"z":-1.048,"el":"H"},{"x":2.239,"y":1.037,"z":1.051,"el":"H"}],"bonds":[[0,6,2],[0,7,1],[1,2,1],[1,3,2],[1,8,1],[2,4,2],[2,9,1],[3,5,1],[3,10,1],[4,6,1],[4,11,1],[5,7,2],[5,12,1],[6,13,1],[7,14,1]]},"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q2281857","license":"CC
{"version":"2026.10.11-r25","id":"Q4918369","formula":"C₄₁H₅₀N₆O₂","hill":"C41H50N6O2","elements":["H","C","N","O"],"composition":{"C":41.0,"H":50.0,"N":6.0,"O":2.0},"names":{"en":"Bisoctrizole"},"descriptions":{"en":"Bisoctrizole (INN/USAN, INCI methylene bis-benzotriazolyl tetramethylbutylphenol, marketed as Tinosorb M, Parsol Max, Eversorb M, and Milestab 360, among others) is a phenolic benzotriazole that is added to sunscreens to absorb UV rays. It is a broad-spectrum ultraviolet radiation absorber, absorbing UVB as well as UVA rays. It also reflects and scatters UV. Bisoctrizole is what is termed a hybrid UV absorber, which has been described as an organic UV filter produced in microfine organic particles (< 200 nm), like microfine zinc oxide and titanium dioxide."},"fame":9,"pubchemCid":3571576,"mass":658.9,"charge":0,"smiles":"CC(C)(C)CC(C)(C)C1=CC(=C(C(=C1)N2N=C3C=CC=CC3=N2)O)CC4=C(C(=CC(=C4)C(C)(C)CC(C)(C)C)N5N=C6C=CC=CC6=N5)O","inchikey":"FQUNFJULCYSSOP-UHFFFAOYSA-N","iupac":"2-(benzotriazol-2-yl)-6-[[3-(benzotriazol-2-yl)-2-hydroxy-5-(2,4,4-trimethylpentan-2-yl)phenyl]methyl]-4-(2,4,4-trimethylpentan-2-yl)phenol","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"3571576","atoms":99,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-2.51,"y":1.037,"z":-1.877,"el":"O"},{"x":2.506,"y":-1.044,"z":-1.866,"el":"O"},{"x":-4.311,"y":-0.456,"z":-0.348,"el":"N"},{"x":4.31,"y":0.454,"z":-0.348,"el":"N"},{"x":-5.161,"y":-1.183,"z":0.382,"el":"N"},{"x":-4.644,"y":0.792,"z":-0.69,"el":"N"},{"x":5.161,"y":1.185,"z":0.377,"el":"N"},{"x":4.642,"y":-0.794,"z":-0.686,"el":"N"},{"x":-1.197,"y":-4.292,"z":-0.347,"el":"C"},{"x":1.207,"y":4.244,"z":-0.37,"el":"C"},{"x":0.15,"y":-4.384,"z":0.458,"el":"C"},{"x":-0.149,"y":4.386,"z":0.452,"el":"C"},{"x":0.397,"y":-3.58,"z":1.777,"el":"C"},{"x":-0.406,"y
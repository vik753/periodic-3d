{"version":"2026.10.11-r25","id":"Q5197458","formula":"C₂₀H₂₀N₂S","hill":"C20H20N2S","elements":["H","C","N","S"],"composition":{"C":20.0,"H":20.0,"N":2.0,"S":1.0},"names":{"en":"Cyanodothiepin"},"descriptions":{"en":"Cyanodothiepin (developmental code name BTS-56424) is a tricyclic antidepressant (TCA) acting as a potent and highly selective (over norepinephrine and dopamine uptake) inhibitor of the reuptake of serotonin that was never marketed. It also has moderate affinity for the muscarinic acetylcholine receptors and weak/negligible affinity for the α1-adrenergic, 5-HT2A, D1, and D2 receptors; the H1 receptor has not been assayed, but cyanodothiepin is less sedating than the related drug cianopramine, suggesting that its antihistamine activity is not as pronounced as other TCAs."},"fame":4,"pubchemCid":13276753,"mass":320.5,"charge":0,"smiles":"CN(C)CC/C=C/1\\C2=CC=CC=C2CSC3=C1C=C(C=C3)C#N","inchikey":"FSIRGTNPQFDCCD-QGMBQPNBSA-N","iupac":"(11E)-11-[3-(dimethylamino)propylidene]-6H-benzo[c][1]benzothiepine-2-carbonitrile","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"13276753","atoms":43,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-1.792,"y":-2.743,"z":1.196,"el":"S"},{"x":4.177,"y":2.217,"z":0.198,"el":"N"},{"x":-4.667,"y":3.463,"z":-1.061,"el":"N"},{"x":-0.034,"y":-0.03,"z":0.191,"el":"C"},{"x":0.772,"y":-1.139,"z":-0.356,"el":"C"},{"x":-1.52,"y":-0.02,"z":0.228,"el":"C"},{"x":0.79,"y":-2.373,"z":0.314,"el":"C"},{"x":2.144,"y":1.025,"z":0.848,"el":"C"},{"x":0.651,"y":0.983,"z":0.756,"el":"C"},{"x":2.735,"y":2.234,"z":0.125,"el":"C"},{"x":-0.023,"y":-2.564,"z":1.564,"el":"C"},{"x":-2.319,"y":-1.115,"z":0.628,"el":"C"},{"x":1.515,"y":-0.971,"z":-1.533,"el":"C"},{"x":-2.164,"y":1.156,"z":-0.223,"el":"C"},{"x":1.552,"y":-3.427,"z":-0.211,"el":"C"},{"x":-3.725,"y":-0.98,"z":0.5
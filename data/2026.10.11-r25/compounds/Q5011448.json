{"version":"2026.10.11-r25","id":"Q5011448","formula":"C₁₈H₂₀N₂O₆","hill":"C18H20N2O6","elements":["H","C","N","O"],"composition":{"C":18.0,"H":20.0,"N":2.0,"O":6.0},"names":{"en":"CI-1017"},"descriptions":{"en":"CI-1017 is a muscarinic acetylcholine receptor agonist which is selective for and is approximately equipotent at the M1 and M4 receptors, with 20-30-fold lower affinity for the M2, M3, and M5 subtypes It is the (R)-enantiomer of the racemic compound PD-142,505. In animals CI-1017 improves learning and memory and increases the electrical activity of the hippocampus through activation of the M1 receptor, while minimally producing parasympathetic side effects and only at very high doses. It also inhibits production of amyloidogenic A beta peptide and increases secretion of soluble amyloid precursor protein via stimulation of the M1 receptor as well."},"fame":3,"pubchemCid":6505360,"mass":360.4,"charge":0,"smiles":"COC1=CC=CC(=C1)C#CCO/N=C\\2/CN3CCC2C3.C(=O)(C(=O)O)O","inchikey":"FSSMLDVGDZVSES-XYJRJTJESA-N","iupac":"(E)-N-[3-(3-methoxyphenyl)prop-2-ynoxy]-1-azabicyclo[2.2.1]heptan-3-imine;oxalic acid","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"rdkit","ref":"6505360","atoms":46,"license":"Computed with RDKit from SMILES (PubChem, Wikidata)"},"structure":{"kind":"molecule","atoms":[{"x":-6.029,"y":1.195,"z":-0.488,"el":"C"},{"x":-5.817,"y":-0.208,"z":-0.579,"el":"O"},{"x":-4.518,"y":-0.637,"z":-0.615,"el":"C"},{"x":-4.366,"y":-2.023,"z":-0.706,"el":"C"},{"x":-3.095,"y":-2.599,"z":-0.751,"el":"C"},{"x":-1.964,"y":-1.786,"z":-0.705,"el":"C"},{"x":-2.108,"y":-0.4,"z":-0.614,"el":"C"},{"x":-3.383,"y":0.175,"z":-0.569,"el":"C"},{"x":-0.946,"y":0.434,"z":-0.566,"el":"C"},{"x":0.032,"y":1.13,"z":-0.526,"el":"C"},{"x":1.227,"y":1.977,"z":-0.477,"el":"C"},{"x":2.393,"y":1.156,"z":-0.59,"el":"O"},{"x":3.534,"y":1.973,"z":-0.536,"el":"N"},
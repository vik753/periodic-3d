{"version":"2026.10.11-r25","id":"Q421294","formula":"C₅H₄O₂","hill":"C5H4O2","elements":["H","C","O"],"composition":{"C":5.0,"H":4.0,"O":2.0},"names":{"en":"Protoanemonin"},"descriptions":{"en":"Protoanemonin (sometimes called anemonol or ranunculol) is a toxin whose glycosidic precursor ranunculin is found in many plants of the buttercup family (Ranunculaceae). When the plant is wounded or macerated, ranunculin is enzymatically broken down into glucose and protoanemonin. This toxin's ability to inhibit both gram positive and gram negative bacteria is linked to the presence of a 5-membered lactone ring with a highly reactive double bond system."},"fame":21,"pubchemCid":66948,"mass":96.08,"charge":0,"smiles":"C=C1C=CC(=O)O1","inchikey":"RNYZJZKPGHQTJR-UHFFFAOYSA-N","iupac":"5-methylidenefuran-2-one","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"66948","atoms":11,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":0.005,"y":1.004,"z":0.0,"el":"O"},{"x":-2.256,"y":0.579,"z":0.0,"el":"O"},{"x":1.081,"y":0.128,"z":0.0,"el":"C"},{"x":0.621,"y":-1.216,"z":0.0,"el":"C"},{"x":-0.704,"y":-1.222,"z":0.0,"el":"C"},{"x":-1.099,"y":0.19,"z":0.0,"el":"C"},{"x":2.352,"y":0.538,"z":0.0,"el":"C"},{"x":1.252,"y":-2.091,"z":0.0,"el":"H"},{"x":-1.372,"y":-2.065,"z":0.0,"el":"H"},{"x":2.594,"y":1.595,"z":0.0,"el":"H"},{"x":3.176,"y":-0.168,"z":0.0,"el":"H"}],"bonds":[[0,2,1],[0,5,1],[1,5,2],[2,3,1],[2,6,2],[3,4,2],[3,7,1],[4,5,1],[4,8,1],[6,9,1],[6,10,1]]},"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q421294","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Protoanemonin","license":"CC BY-SA 4.0"},{"role":"properties","name":"PubChem","url":"https://pubchem.ncbi.nlm.nih.gov/compound/66948","license":"PubChem (NIH),
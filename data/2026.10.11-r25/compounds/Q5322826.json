{"version":"2026.10.11-r25","id":"Q5322826","formula":"C₁₂H₁₄N₂O₃S","hill":"C12H14N2O3S","elements":["H","C","N","O","S"],"composition":{"C":12.0,"H":14.0,"N":2.0,"O":3.0,"S":1.0},"names":{"en":"EDANS"},"descriptions":{"en":"EDANS (5-((2-Aminoethyl)amino)naphthalene-1-sulfonic acid) is a donor for FRET-based nucleic acid probes and protease substrates. EDANS is often paired with DABCYL or DABSYL. The combination can be used in enzyme assays. When the two compounds are in close proximity, most of the energy emitted from EDANS will be quenched by DABCYL. However, if the compounds are separated (for example, by substrate cleavage) EDANS will fluoresce, giving an indication of enzyme presence."},"fame":7,"pubchemCid":92329,"mass":266.32,"charge":0,"smiles":"C1=CC2=C(C=CC=C2S(=O)(=O)O)C(=C1)NCCN","inchikey":"SJQRQOKXQKVJGJ-UHFFFAOYSA-N","iupac":"5-(2-aminoethylamino)naphthalene-1-sulfonic acid","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"92329","atoms":32,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-3.67,"y":-0.278,"z":-0.052,"el":"S"},{"x":-3.818,"y":-0.954,"z":1.426,"el":"O"},{"x":-4.67,"y":0.771,"z":-0.148,"el":"O"},{"x":-3.601,"y":-1.341,"z":-1.037,"el":"O"},{"x":2.802,"y":0.391,"z":-0.01,"el":"N"},{"x":6.45,"y":-0.091,"z":0.079,"el":"N"},{"x":0.341,"y":0.467,"z":-0.025,"el":"C"},{"x":-0.889,"y":-0.232,"z":-0.035,"el":"C"},{"x":1.543,"y":-0.259,"z":-0.022,"el":"C"},{"x":-2.092,"y":0.494,"z":-0.038,"el":"C"},{"x":0.333,"y":1.872,"z":-0.018,"el":"C"},{"x":-0.881,"y":-1.636,"z":-0.042,"el":"C"},{"x":1.532,"y":-1.654,"z":-0.029,"el":"C"},{"x":4.038,"y":-0.323,"z":-0.006,"el":"C"},{"x":-2.081,"y":1.889,"z":-0.031,"el":"C"},{"x":0.322,"y":-2.341,"z":-0.039,"el":"C"},{"x":-0.871,"y":2.577,"z":-0.021,"el":"C"},{"x":5.211,"y":0.647,"z":0.048,"el":"C"},{"x":1.24,"y":2.467,"z":-0.009,"el":
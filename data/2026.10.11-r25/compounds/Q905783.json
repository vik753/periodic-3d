{"version":"2026.10.11-r25","id":"Q905783","formula":"C₂₀H₂₄N₄O₄","hill":"C20H24N4O4","elements":["H","C","N","O"],"composition":{"C":20.0,"H":24.0,"N":4.0,"O":4.0},"names":{"en":"Istradefylline"},"descriptions":{"en":"Istradefylline, sold under the brand name Nourianz, is a medication used as an add-on treatment to levodopa/carbidopa in adults with Parkinson's disease (PD) experiencing \"off\" episodes. Istradefylline reduces \"off\" periods resulting from long-term treatment with the antiparkinson drug levodopa. An \"off\" episode is a time when a patient's medications are not working well, causing an increase in PD symptoms, such as tremor and difficulty walking."},"fame":11,"pubchemCid":5311037,"mass":384.4,"charge":0,"smiles":"CCN1C2=C(C(=O)N(C1=O)CC)N(C(=N2)/C=C/C3=CC(=C(C=C3)OC)OC)C","inchikey":"IQVRBWUUXZMOPW-PKNBQFBNSA-N","iupac":"8-[(E)-2-(3,4-dimethoxyphenyl)ethenyl]-1,3-diethyl-7-methylpurine-2,6-dione","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"5311037","atoms":52,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":3.782,"y":-2.698,"z":-0.551,"el":"O"},{"x":6.028,"y":1.275,"z":0.536,"el":"O"},{"x":-5.847,"y":-1.392,"z":1.138,"el":"O"},{"x":-7.328,"y":0.438,"z":-0.337,"el":"O"},{"x":3.701,"y":1.289,"z":0.562,"el":"N"},{"x":1.266,"y":-1.142,"z":-0.096,"el":"N"},{"x":4.928,"y":-0.72,"z":-0.009,"el":"N"},{"x":1.257,"y":1.005,"z":0.503,"el":"N"},{"x":2.576,"y":-0.766,"z":-0.002,"el":"C"},{"x":2.542,"y":0.552,"z":0.365,"el":"C"},{"x":3.771,"y":-1.515,"z":-0.221,"el":"C"},{"x":4.963,"y":0.668,"z":0.378,"el":"C"},{"x":0.511,"y":-0.042,"z":0.218,"el":"C"},{"x":3.613,"y":2.691,"z":0.95,"el":"C"},{"x":6.217,"y":-1.377,"z":-0.202,"el":"C"},{"x":0.783,"y":-2.457,"z":-0.457,"el":"C"},{"x":3.571,"y":3.6,"z":-0.261,"el":"C"},{"x":-0.893,"y":-0.158,"z":0.2,"el":"C"},{"x":6.696,"y":-1.249,
{"version":"2026.10.11-r25","id":"Q20707039","formula":"C₁₅H₁₄O₃S","hill":"C15H14O3S","elements":["H","C","O","S"],"composition":{"C":15.0,"H":14.0,"O":3.0,"S":1.0},"names":{"en":"Modafinil acid"},"descriptions":{"en":"Modafinil acid (code name CRL-40467), also known as modafinilic acid or modafinil carboxylate, is one of the two major metabolites of modafinil – the other being modafinil sulfone. Modafinil acid is also a metabolite of the modafinil prodrug, adrafinil, and the (R)-(–)-enantiomer is a metabolite of armodafinil, the (R)-(–)-enantiomer of modafinil. Between 30 - 60% of modafinil is converted to modafinil acid and its half life is roughly half that of modafinil (about 7 hours)."},"fame":2,"pubchemCid":3085267,"mass":274.3,"charge":0,"smiles":"C1=CC=C(C=C1)C(C2=CC=CC=C2)S(=O)CC(=O)O","inchikey":"QARQPIWTMBRJFX-UHFFFAOYSA-N","iupac":"2-benzhydrylsulfinylacetic acid","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"3085267","atoms":33,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-0.895,"y":-1.389,"z":-0.406,"el":"S"},{"x":-0.556,"y":-2.737,"z":0.124,"el":"O"},{"x":-4.722,"y":-1.174,"z":0.616,"el":"O"},{"x":-3.561,"y":-2.437,"z":-0.875,"el":"O"},{"x":0.238,"y":-0.203,"z":0.452,"el":"C"},{"x":-0.112,"y":1.227,"z":0.21,"el":"C"},{"x":1.705,"y":-0.542,"z":0.192,"el":"C"},{"x":-2.378,"y":-0.803,"z":0.441,"el":"C"},{"x":0.0,"y":2.157,"z":1.244,"el":"C"},{"x":2.457,"y":-1.056,"z":1.224,"el":"C"},{"x":-0.549,"y":1.635,"z":-1.05,"el":"C"},{"x":2.221,"y":-0.323,"z":-1.066,"el":"C"},{"x":-0.327,"y":3.494,"z":1.018,"el":"C"},{"x":3.796,"y":-1.366,"z":0.987,"el":"C"},{"x":-0.876,"y":2.972,"z":-1.276,"el":"C"},{"x":3.56,"y":-0.634,"z":-1.303,"el":"C"},{"x":-0.764,"y":3.901,"z":-0.242,"el":"C"},{"x":4.348,"y":-1.155,"z":-0.277,"el":"C"},{"x":-3.586,"y":-1.567,"z":-0.013,"el":"C"},{"x":0.04
{"version":"2026.10.11-r25","id":"Q6460430","formula":"C₇H₉NO₅","hill":"C7H9NO5","elements":["H","C","N","O"],"composition":{"C":7.0,"H":9.0,"N":1.0,"O":5.0},"names":{"en":"LY379268"},"descriptions":{"en":"LY-379,268 is a drug that is used in neuroscience research, which acts as a potent and selective agonist for the group II metabotropic glutamate receptors (mGluR2/3). It is derived from the older mGluR group II agonist eglumegad, and led on to the development of the more potent compound LY-404,039, but is still widely used in research itself. LY-379,268 has sedative, neuroprotective, anti-addictive and anticonvulsant effects in animals, and blocks the effects of PCP and DOI, which has led to research into LY-379,268 and similar compounds as antipsychotic drugs for the treatment of schizophrenia in animals."},"fame":3,"pubchemCid":10197984,"mass":187.15,"charge":0,"smiles":"C1[C@]([C@@H]2[C@H]([C@@H]2O1)C(=O)O)(C(=O)O)N","inchikey":"YASVRZWVUGJELU-MDASVERJSA-N","iupac":"(1R,4R,5S,6R)-4-amino-2-oxabicyclo[3.1.0]hexane-4,6-dicarboxylic acid","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"10197984","atoms":22,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":0.281,"y":-1.617,"z":-1.192,"el":"O"},{"x":-3.663,"y":-0.239,"z":0.939,"el":"O"},{"x":-2.986,"y":1.301,"z":-0.6,"el":"O"},{"x":3.46,"y":0.132,"z":0.248,"el":"O"},{"x":2.149,"y":1.682,"z":-0.788,"el":"O"},{"x":1.261,"y":-0.069,"z":1.911,"el":"N"},{"x":-0.197,"y":0.396,"z":0.01,"el":"C"},{"x":-0.651,"y":-0.508,"z":-1.09,"el":"C"},{"x":-1.475,"y":-0.392,"z":0.161,"el":"C"},{"x":1.131,"y":-0.122,"z":0.464,"el":"C"},{"x":1.182,"y":-1.568,"z":-0.064,"el":"C"},{"x":-2.759,"y":0.327,"z":0.102,"el":"C"},{"x":2.27,"y":0.678,"z":-0.102,"el":"C"},{"x":-0.27,"y":1.469,"z":-0.1,"el":"H"},{"x":-1.009,"y":-0.062,"z":-2.008,"el":"H"},{"x":-1.454,"y":-
{"version":"2026.10.11-r25","id":"Q5984069","formula":"C₂₃H₂₀Cl₂N₄O₂S","hill":"C23H20Cl2N4O2S","elements":["H","C","N","O","S","Cl"],"composition":{"C":23.0,"H":20.0,"N":4.0,"O":2.0,"S":1.0,"Cl":2.0},"names":{"en":"Ibipinabant"},"descriptions":{"en":"Ibipinabant (SLV319, BMS-646,256) was designed by Jos Lange at Solvay Pharmaceuticals in 2000. Nowadays, it is an in vivo active pharmacological tool used in scientific research which acts as a potent and highly selective CB1 antagonist. It has potent anorectic effects in animals, and was researched for the treatment of obesity, although CB1 antagonists as a class have now fallen out of favour as potential anorectics following the problems seen with rimonabant, and so ibipinabant is now only used for laboratory research, especially structure-activity relationship studies into novel CB1 antagonists."},"fame":7,"pubchemCid":9826744,"mass":487.4,"charge":0,"smiles":"CN=C(NS(=O)(=O)C1=CC=C(C=C1)Cl)N2C[C@@H](C(=N2)C3=CC=C(C=C3)Cl)C4=CC=CC=C4","inchikey":"AXJQVVLKUYCICH-OAQYLSRUSA-N","iupac":"(4S)-5-(4-chlorophenyl)-N-(4-chlorophenyl)sulfonyl-N'-methyl-4-phenyl-3,4-dihydropyrazole-2-carboximidamide","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"9826744","atoms":52,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-8.007,"y":-1.201,"z":0.633,"el":"Cl"},{"x":6.586,"y":2.981,"z":1.286,"el":"Cl"},{"x":3.706,"y":-2.14,"z":-0.866,"el":"S"},{"x":3.802,"y":-3.173,"z":0.147,"el":"O"},{"x":4.216,"y":-2.372,"z":-2.203,"el":"O"},{"x":-0.056,"y":-0.988,"z":-0.301,"el":"N"},{"x":-1.249,"y":-1.396,"z":0.178,"el":"N"},{"x":2.087,"y":-1.593,"z":-0.967,"el":"N"},{"x":1.466,"y":-1.99,"z":1.265,"el":"N"},{"x":-1.611,"y":0.441,"z":-1.276,"el":"C"},{"x":-0.147,"y":0.003,"z":-1.342,"el":"C"},{"x":-2.153,"y":-0.637,"z":-0.363,"el":"C"},{"x":-1.766,"y":1.792,"z":-0.667,
{"version":"2026.10.11-r25","id":"Q4596864","formula":"C₁₁H₁₇NO₂Br","hill":"C11H17BrNO2","elements":["H","C","N","O","Br"],"composition":{"C":11.0,"H":17.0,"N":1.0,"O":2.0,"Br":1.0},"names":{"en":"2-Br-4,5-MDA"},"descriptions":{"en":"6-Bromo-MDA, also known as 6-bromo-3,4-methylenedioxyamphetamine or as 2-bromo-4,5-methylenedioxyamphetamine (2-bromo-4,5-MDA), is a psychoactive drug of the phenethylamine, amphetamine, and MDxx families related to 3,4-methylenedioxyamphetamine (MDA). It is the 6-bromo derivative of MDA. In his book PiHKAL (Phenethylamines I Have Known and Loved), Alexander Shulgin lists 6-bromo-MDA's dose as 350 mg orally and its duration as unknown. 6-Bromo-MDA has been reported to produce amphetamine-like effects with no other details provided."},"fame":5,"pubchemCid":44719492,"mass":258.11,"charge":0,"smiles":"CC(CC1=CC2=C(C=C1Br)OCO2)N","inchikey":"PHCFFGXVMHXBGD-UHFFFAOYSA-N","iupac":"1-(6-bromo-1,3-benzodioxol-5-yl)propan-2-amine","classes":[{"qid":"Q59199015","names":{"en":"group of stereoisomers","ru":"группа стереоизомеров","uk":"група стереоізомерів"}}],"structureInfo":null,"structure":null,"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q4596864","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/2-Bromo-4%2C5-methylenedioxyamphetamine","license":"CC BY-SA 4.0"},{"role":"properties","name":"PubChem","url":"https://pubchem.ncbi.nlm.nih.gov/compound/44719492","license":"PubChem (NIH), public data"}],"similar":[{"id":"Q424294","formula":"C₂₀H₃₀BrNO₃","names":{"en":"Ipratropium bromide","ru":"Ипратропия бромид","uk":"Іпратропію бромід"},"elements":["H","C","N","O","Br"],"fame":31,"kind":"molecule"},{"id":"Q419361","formula":"C₂₁H₃₀BrNO₄","names":{"en":"Butylscopolamine bromide"},"elements":["H","C","N","O","Br"],"fame":26,"kind":"molecule"},{"id":"Q27162963","formula":"C₁₉H₂₈BrNO₃","names":{"en":"Glycopyrronium bromide"},"elements":["H","C","N","O","Br"],"
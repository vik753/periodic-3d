{"version":"2026.10.11-r25","id":"Q5383831","formula":"C₂₀H₃₂O₃","hill":"C20H32O3","elements":["H","C","O"],"composition":{"C":20.0,"H":32.0,"O":3.0},"names":{"en":"Epoxyeicosatrienoic acid"},"descriptions":{"en":"Epoxyeicosatrienoic acids or EETs are signaling molecules formed within various types of cells by the metabolism of arachidonic acid by a specific subset of cytochrome P450 enzymes, termed cytochrome P450 epoxygenases. They are nonclassic eicosanoids. EETs are generally short-lived, being rapidly converted from epoxides to less active or inactive dihydroxy-eicosatrienoic acids (diHETrEs) by a widely distributed cellular enzyme, soluble epoxide hydrolase (sEH), also termed epoxide hydrolase 2."},"fame":3,"pubchemCid":null,"mass":null,"charge":0,"smiles":null,"inchikey":null,"iupac":null,"classes":[{"qid":"Q17339814","names":{"en":"group or class of chemical substances","ru":"группа или класс химических веществ","uk":"група хімічних сполук"}}],"structureInfo":null,"structure":null,"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q5383831","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Epoxyeicosatrienoic_acid","license":"CC BY-SA 4.0"}],"similar":[{"id":"Q420859","formula":"C₁₉H₃₀O₃","names":{"en":"Oxandrolone","ru":"Oxandrolone"},"elements":["H","C","O"],"fame":28,"kind":"molecule"},{"id":"Q418492","formula":"C₂₄H₃₈O₄","names":{"en":"Diethylhexyl phthalate"},"elements":["H","C","O"],"fame":19,"kind":"molecule"},{"id":"Q410393","formula":"C₂₆H₄₂O₄","names":{"en":"Diisononylphthalate"},"elements":["H","C","O"],"fame":14,"kind":"molecule"},{"id":"Q418686","formula":"C₁₅H₂₄O₂","names":{"en":"Hernandulcin"},"elements":["H","C","O"],"fame":12,"kind":"molecule"},{"id":"Q5279087","formula":"C₂₄H₃₈O₄","names":{"en":"Diethylhexyl terephthalate"},"elements":["H","C","O"],"fame":11,"kind":"molecule"},{"id":"Q1907191","formula":"C₃₀H₄₈O₄","names":{"en":"Maslinic acid"},"elements
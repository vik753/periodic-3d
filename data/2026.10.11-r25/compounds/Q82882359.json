{"version":"2026.10.11-r25","id":"Q82882359","formula":"C₁₂H₁₄N₂","hill":"C12H14N2","elements":["H","C","N"],"composition":{"C":12.0,"H":14.0,"N":2.0},"names":{"en":"3-AMTBI"},"descriptions":{"en":"3-AMTBI, also known as 3-aminomethyl-THBI, 3-aminomethyl-1,3,4,5-tetrahydrobenz(cd)indole, or 4,β-dimethylenetryptamine, is a serotonin receptor modulator of the tryptamine family. It is a cyclized tryptamine and is the derivative of tryptamine in which the 4 and β positions have been connected with an ethyl group, resulting in a non-partial-ergoline tricyclic compound. The drug shows affinity for the serotonin 5-HT1, 5-HT1A, and 5-HT2A receptors (Ki = 392 nM, 369 nM, and 465–555 nM, respectively)."},"fame":1,"pubchemCid":194894,"mass":186.25,"charge":0,"smiles":"C1CC2=C3C(=CC=C2)NC=C3C1CN","inchikey":"PKWJZQKTYSEOEQ-UHFFFAOYSA-N","iupac":"1,3,4,5-tetrahydrobenzo[cd]indol-3-ylmethanamine","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"194894","atoms":28,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":0.621,"y":-2.288,"z":0.289,"el":"N"},{"x":-3.366,"y":-0.907,"z":-1.036,"el":"N"},{"x":-1.972,"y":0.36,"z":0.54,"el":"C"},{"x":-1.426,"y":1.788,"z":0.896,"el":"C"},{"x":-0.823,"y":-0.596,"z":0.413,"el":"C"},{"x":0.468,"y":-0.1,"z":0.127,"el":"C"},{"x":-0.221,"y":2.284,"z":0.037,"el":"C"},{"x":0.854,"y":1.233,"z":-0.053,"el":"C"},{"x":-2.803,"y":0.401,"z":-0.744,"el":"C"},{"x":1.36,"y":-1.151,"z":0.046,"el":"C"},{"x":-0.703,"y":-1.962,"z":0.514,"el":"C"},{"x":2.197,"y":1.469,"z":-0.354,"el":"C"},{"x":2.709,"y":-0.933,"z":-0.236,"el":"C"},{"x":3.105,"y":0.401,"z":-0.438,"el":"C"},{"x":-2.612,"y":0.036,"z":1.372,"el":"H"},{"x":-1.096,"y":1.765,"z":1.945,"el":"H"},{"x":-2.237,"y":2.525,"z":0.845,"el":"H"},{"x":0.184,"y":3.196,"z":0.489,"el":"H"},{"x":-0.563,"y":2.53,"z":-0.975,"el":"H"},{"x":-2.192,
{"version":"2026.10.11-r25","id":"Q5462967","formula":"C₁₆H₁₂ClFN₂O₂","hill":"C16H12ClFN2O2","elements":["H","C","N","O","F","Cl"],"composition":{"C":16.0,"F":1.0,"H":12.0,"N":2.0,"O":2.0,"Cl":1.0},"names":{"en":"Flutemazepam"},"descriptions":{"en":"Flutemazepam was initially first synthesized in 1965, but was not further described until a team at Stabilimenti Chimici Farmaceutici Riuniti SpA in the mid-1970s. It is a short-acting (9–25 hr elimination half-life) fluorinated analogue of temazepam that has powerful hypnotic, sedative, amnesiac, anxiolytic, anticonvulsant and skeletal muscle relaxant properties. Flutemazepam has been shown to have similar pharmacological properties to temazepam, but with more powerful sedative-hypnotic and anxiolytic properties."},"fame":8,"pubchemCid":40344,"mass":318.73,"charge":0,"smiles":"CN1C2=C(C=C(C=C2)Cl)C(=NC(C1=O)O)C3=CC=CC=C3F","inchikey":"RMFYWNFETXNTIQ-UHFFFAOYSA-N","iupac":"7-chloro-5-(2-fluorophenyl)-3-hydroxy-1-methyl-3H-1,4-benzodiazepin-2-one","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"40344","atoms":34,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-0.415,"y":-4.528,"z":-1.329,"el":"Cl"},{"x":2.595,"y":1.899,"z":-1.303,"el":"F"},{"x":-1.459,"y":3.219,"z":-1.629,"el":"O"},{"x":-2.443,"y":3.024,"z":0.781,"el":"O"},{"x":-2.379,"y":0.7,"z":0.828,"el":"N"},{"x":0.102,"y":1.665,"z":-0.618,"el":"N"},{"x":-0.578,"y":-0.667,"z":-0.244,"el":"C"},{"x":-1.86,"y":-0.544,"z":0.329,"el":"C"},{"x":0.399,"y":0.46,"z":-0.264,"el":"C"},{"x":-1.268,"y":1.95,"z":-1.007,"el":"C"},{"x":-2.064,"y":1.956,"z":0.291,"el":"C"},{"x":1.805,"y":0.204,"z":0.162,"el":"C"},{"x":-0.145,"y":-1.897,"z":-0.77,"el":"C"},{"x":-2.646,"y":-1.709,"z":0.422,"el":"C"},{"x":-3.346,"y":0.647,"z":1.925,"el":"C"},{"x":-0.957,"y":-3.025,"z":-0.692,"el":"C"},{"x":-2.202,"y":-2.933
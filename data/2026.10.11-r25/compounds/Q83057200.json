{"version":"2026.10.11-r25","id":"Q83057200","formula":"C₄H₄O","hill":"C4H4O","elements":["H","C","O"],"composition":{"C":4.0,"H":4.0,"O":1.0},"names":{"en":"2-cyclobutene-1-one"},"descriptions":{"en":"Cyclobutenone is a chemical compound with the formula C4H4O. It is a highly strained cyclic enone which exhibits significant chemical reactivity. Notable reactions of cyclobutenone include acting as a Michael acceptor, a dienophile for Diels-Alder reactions, and a regioselective substrate for activation of C−C bonds. Electrocyclic ring opening of cyclobutenones yields vinylketenes, which serve as reactive intermediates in cycloaddition reactions."},"fame":3,"pubchemCid":141691,"mass":68.07,"charge":0,"smiles":"C1C=CC1=O","inchikey":"DFLRGCFWSRELEL-UHFFFAOYSA-N","iupac":"cyclobut-2-en-1-one","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"141691","atoms":9,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":1.803,"y":0.03,"z":0.0,"el":"O"},{"x":-0.485,"y":-1.102,"z":0.0,"el":"C"},{"x":0.592,"y":-0.014,"z":-0.001,"el":"C"},{"x":-1.444,"y":0.076,"z":0.0,"el":"C"},{"x":-0.465,"y":1.011,"z":0.0,"el":"C"},{"x":-0.479,"y":-1.731,"z":0.895,"el":"H"},{"x":-0.48,"y":-1.731,"z":-0.895,"el":"H"},{"x":-2.528,"y":0.136,"z":0.001,"el":"H"},{"x":-0.494,"y":2.097,"z":0.0,"el":"H"}],"bonds":[[0,2,2],[1,2,1],[1,3,1],[1,5,1],[1,6,1],[2,4,1],[3,4,2],[3,7,1],[4,8,1]]},"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q83057200","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Cyclobutenone","license":"CC BY-SA 4.0"},{"role":"properties","name":"PubChem","url":"https://pubchem.ncbi.nlm.nih.gov/compound/141691","license":"PubChem (NIH), public data"},{"role":"structure","name":"PubChem 3D","url":"https://pubchem.ncbi.nlm.nih.g
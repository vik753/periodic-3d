{"version":"2026.10.11-r25","id":"Q5514865","formula":"C₂₃H₂₄Cl₂N₂O₃","hill":"C23H24Cl2N2O3","elements":["H","C","N","O","Cl"],"composition":{"C":23.0,"H":24.0,"N":2.0,"O":3.0,"Cl":2.0},"names":{"en":"L-768242"},"descriptions":{"en":"GW-405,833 (L-768,242) is a drug that acts as a potent and selective partial agonist for the cannabinoid receptor subtype CB2, with an EC50 of 0.65 nM and selectivity of around 1200x for CB2 over CB1 receptors. Animal studies have shown it to possess antiinflammatory and anti-hyperalgesic effects at low doses, followed by ataxia and analgesic effects when the dose is increased. Selective CB2 agonist drugs such as GW-405,833 are hoped to be particularly useful in the treatment of allodynia and neuropathic pain for which current treatment options are often inadequate."},"fame":4,"pubchemCid":9911463,"mass":447.4,"charge":0,"smiles":"CC1=C(C2=C(N1C(=O)C3=C(C(=CC=C3)Cl)Cl)C=CC(=C2)OC)CCN4CCOCC4","inchikey":"FSFZRNZSZYDVLI-UHFFFAOYSA-N","iupac":"(2,3-dichlorophenyl)-[5-methoxy-2-methyl-3-(2-morpholin-4-ylethyl)indol-1-yl]methanone","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"9911463","atoms":54,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-2.188,"y":1.396,"z":-1.969,"el":"Cl"},{"x":-5.072,"y":0.876,"z":-3.283,"el":"Cl"},{"x":7.225,"y":1.631,"z":-0.728,"el":"O"},{"x":-0.053,"y":-4.732,"z":-0.118,"el":"O"},{"x":-2.099,"y":2.402,"z":1.809,"el":"O"},{"x":4.698,"y":0.369,"z":-0.376,"el":"N"},{"x":-1.038,"y":0.61,"z":0.923,"el":"N"},{"x":2.6,"y":0.048,"z":0.918,"el":"C"},{"x":3.238,"y":0.349,"z":-0.45,"el":"C"},{"x":1.123,"y":-0.007,"z":0.865,"el":"C"},{"x":0.339,"y":-1.156,"z":0.612,"el":"C"},{"x":5.16,"y":1.431,"z":0.53,"el":"C"},{"x":5.285,"y":0.556,"z":-1.71,"el":"C"},{"x":0.266,"y":1.047,"z":1.057,"el":"C"},{"x":-1.006,"y":-0.763,"z":0.654,"el":"C"},{"x":
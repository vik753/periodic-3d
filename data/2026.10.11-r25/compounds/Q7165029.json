{"version":"2026.10.11-r25","id":"Q7165029","formula":"C₂₂H₂₈N₂O₃","hill":"C22H28N2O3","elements":["H","C","N","O"],"composition":{"C":22.0,"H":28.0,"N":2.0,"O":3.0},"names":{"en":"Pentamorphone"},"descriptions":{"en":"Pentamorphone (14β-pentylaminomorphinone, RX-77989) is a semi-synthetic opiate derivative related to compounds such as Morphinone and oxymorphone. Developed in 1984, it is a potent opioid analgesic several times stronger than fentanyl, and with a similarly fast onset of effects and short duration of action. It was found to produce relatively little respiratory depression compared to other potent opioid agonists, but its analgesic effects were somewhat disappointing in human trials, and while pentamorphone had some slight advantages over fentanyl these were not sufficient to warrant its introduction into clinical use."},"fame":3,"pubchemCid":5464186,"mass":368.5,"charge":0,"smiles":"CCCCCN[C@@]12C=CC(=O)[C@H]3[C@@]14CCN([C@@H]2CC5=C4C(=C(C=C5)O)O3)C","inchikey":"NRPCWSUJMWEFOK-KDXIVRHGSA-N","iupac":"(4R,4aS,7aR,12bR)-9-hydroxy-3-methyl-4a-(pentylamino)-2,4,7a,13-tetrahydro-1H-4,12-methanobenzofuro[3,2-e]isoquinolin-7-one","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"5464186","atoms":55,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":2.637,"y":1.49,"z":1.232,"el":"O"},{"x":1.38,"y":3.7,"z":0.006,"el":"O"},{"x":5.334,"y":0.946,"z":0.247,"el":"O"},{"x":-0.808,"y":-2.352,"z":0.632,"el":"N"},{"x":-1.795,"y":0.321,"z":0.578,"el":"N"},{"x":0.696,"y":0.124,"z":0.765,"el":"C"},{"x":-0.545,"y":-0.013,"z":-0.145,"el":"C"},{"x":-0.569,"y":-1.527,"z":-0.582,"el":"C"},{"x":0.563,"y":-0.771,"z":2.021,"el":"C"},{"x":1.181,"y":1.546,"z":1.075,"el":"C"},{"x":1.922,"y":-0.314,"z":0.029,"el":"C"},{"x":0.708,"y":-1.937,"z":-1.404,"el":"C"},{"x":0.231,"y":-2.232,"z":1.662,"el":"C"},{"x":1.9
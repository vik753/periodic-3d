{"version":"2026.10.11-r25","id":"Q61155701","formula":"C₆H₁₆FNO₂P⁺","hill":"C6H16FNO2P","elements":["H","C","N","O","F","P"],"composition":{"C":6.0,"F":1.0,"H":16.0,"N":1.0,"O":2.0,"P":1.0},"names":{"en":"Methylfluorophosphonylcholine"},"descriptions":{"en":"Methylfluorophosphonylcholine (MFPCh) is an extremely toxic chemical compound related to the G-series nerve agents. It is an extremely potent acetylcholinesterase inhibitor which is around 100 times more potent than sarin at inhibiting acetylcholinesterase in vitro, and around 10 times more potent in vivo, depending on route of administration and animal species tested. MFPCh is resistant to oxime reactivators, meaning the acetylcholinesterase inhibited by MFPCh can't be reactivated by cholinesterase reactivators."},"fame":3,"pubchemCid":39430,"mass":184.17,"charge":1,"smiles":"C[N+](C)(C)CCOP(=O)(C)F","inchikey":"OKNSDXKIPFDADW-UHFFFAOYSA-N","iupac":"2-[fluoro(methyl)phosphoryl]oxyethyl-trimethylazanium","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"39430","atoms":27,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":2.587,"y":0.035,"z":-0.022,"el":"P"},{"x":2.531,"y":0.859,"z":1.316,"el":"F"},{"x":1.14,"y":0.311,"z":-0.689,"el":"O"},{"x":3.726,"y":0.523,"z":-0.873,"el":"O"},{"x":-2.515,"y":0.003,"z":-0.005,"el":"N"},{"x":-1.257,"y":0.328,"z":-0.798,"el":"C"},{"x":-2.51,"y":0.789,"z":1.298,"el":"C"},{"x":-3.742,"y":0.383,"z":-0.823,"el":"C"},{"x":-2.551,"y":-1.487,"z":0.301,"el":"C"},{"x":-0.038,"y":-0.023,"z":0.031,"el":"C"},{"x":2.63,"y":-1.722,"z":0.265,"el":"C"},{"x":-1.281,"y":-0.239,"z":-1.737,"el":"H"},{"x":-1.273,"y":1.395,"z":-1.049,"el":"H"},{"x":-2.289,"y":1.837,"z":1.077,"el":"H"},{"x":-3.507,"y":0.706,"z":1.744,"el":"H"},{"x":-1.785,"y":0.364,"z":1.995,"el":"H"},{"x":-3.725,"y":-0.188,"z":-1.756,"el":"H"},{"x":-4.638,"
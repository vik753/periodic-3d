{"version":"2026.10.11-r25","id":"Q83051764","formula":"C₁₂H₁₂N₂O₂","hill":"C12H12N2O2","elements":["H","C","N","O"],"composition":{"C":12.0,"H":12.0,"N":2.0,"O":2.0},"names":{"en":"Harmalacidine"},"descriptions":{"en":"Harmalacidine, also known as 7-methoxy-2,3,4,9-tetrahydro-1H-β-carbolin-1-one or as 1-keto-7-methoxytryptoline, is a harmala alkaloid and β-carboline found in Peganum harmala (Syrian rue) and Banisteriopsis caapi. It is a reversible inhibitor of monoamine oxidase A (RIMA), with similar potency as harmine (IC50Tooltip half-maximal inhibitory concentration = 457 nM and 506 nM, respectively). The alkaloid was isolated from Banisteriopsis caapi in 1976 and from Peganum harmala in 1988."},"fame":1,"pubchemCid":179484,"mass":216.24,"charge":0,"smiles":"COC1=CC2=C(C=C1)C3=C(N2)C(=O)NCC3","inchikey":"MWEGNYFSTKOOSD-UHFFFAOYSA-N","iupac":"7-methoxy-2,3,4,9-tetrahydropyrido[3,4-b]indol-1-one","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"179484","atoms":28,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":3.226,"y":2.247,"z":0.155,"el":"O"},{"x":-4.322,"y":0.082,"z":-0.049,"el":"O"},{"x":0.402,"y":1.349,"z":-0.013,"el":"N"},{"x":3.849,"y":0.041,"z":-0.073,"el":"N"},{"x":1.169,"y":-0.733,"z":0.094,"el":"C"},{"x":2.188,"y":-1.813,"z":0.192,"el":"C"},{"x":-0.251,"y":-0.791,"z":0.068,"el":"C"},{"x":1.543,"y":0.595,"z":0.034,"el":"C"},{"x":-0.707,"y":0.529,"z":-0.002,"el":"C"},{"x":3.504,"y":-1.336,"z":-0.436,"el":"C"},{"x":2.909,"y":1.066,"z":0.042,"el":"C"},{"x":-1.199,"y":-1.833,"z":0.103,"el":"C"},{"x":-2.067,"y":0.856,"z":-0.043,"el":"C"},{"x":-2.987,"y":-0.195,"z":-0.01,"el":"C"},{"x":-2.562,"y":-1.52,"z":0.062,"el":"C"},{"x":-4.695,"y":1.456,"z":-0.123,"el":"C"},{"x":2.35,"y":-2.043,"z":1.252,"el":"H"},{"x":1.849,"y":-2.731,"z":-0.3,"el":"H"},{"x":4.335,"y":-1.984,"z":-0.141,"e
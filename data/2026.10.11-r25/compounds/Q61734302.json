{"version":"2026.10.11-r25","id":"Q61734302","formula":"C₁₁H₁₂O₂","hill":"C11H12O2","elements":["H","C","O"],"composition":{"C":11.0,"H":12.0,"O":2.0},"names":{"en":"Cinnamyl acetate"},"descriptions":{"en":"Cinnamyl acetate (3-phenylprop-2-enyl acetate) is a chemical compound of the cinnamyl ester family, in which the variable R group is substituted by a methyl group. As a result of the non-aromatic carbon-carbon double bond, cinnamyl acetate can exist in a Z and an E configuration: Cinnamyl acetate naturally occurs in fresh bark of cinnamon (Cinnamomum zeylanicum Blume and other Cinnamomum species), with concentrations of 2,800–51,000 ppm. Cinnamyl acetate is used as a flavor ester in for example bread and animal feed and has a sweet floral-fruity fragrance."},"fame":8,"pubchemCid":7660,"mass":176.21,"charge":0,"smiles":"CC(=O)OCC=CC1=CC=CC=C1","inchikey":"WJSDHUCWMSHDCR-UHFFFAOYSA-N","iupac":"3-phenylprop-2-enyl acetate","classes":[{"qid":"Q59199015","names":{"en":"group of stereoisomers","ru":"группа стереоизомеров","uk":"група стереоізомерів"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"7660","atoms":25,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":2.845,"y":-0.4,"z":0.022,"el":"O"},{"x":4.702,"y":0.954,"z":-0.219,"el":"O"},{"x":-1.81,"y":0.303,"z":0.073,"el":"C"},{"x":-0.421,"y":0.737,"z":0.086,"el":"C"},{"x":-2.126,"y":-1.013,"z":-0.264,"el":"C"},{"x":-2.825,"y":1.203,"z":0.397,"el":"C"},{"x":0.605,"y":0.127,"z":-0.549,"el":"C"},{"x":2.017,"y":0.621,"z":-0.518,"el":"C"},{"x":-3.457,"y":-1.43,"z":-0.277,"el":"C"},{"x":-4.156,"y":0.786,"z":0.384,"el":"C"},{"x":-4.472,"y":-0.53,"z":0.048,"el":"C"},{"x":4.176,"y":-0.099,"z":0.116,"el":"C"},{"x":4.922,"y":-1.26,"z":0.7,"el":"C"},{"x":-0.213,"y":1.642,"z":0.654,"el":"H"},{"x":2.335,"y":0.848,"z":-1.542,"el":"H"},{"x":2.107,"y":1.528,"z":0.09,"el":"H"},{"x":0.443,"y":-0.761,"z":-1.153,"el":"H"},{"x":-1.368,"y":-1.754,"z":-0.503,"el":"H"},{"x":-2.598,"y":2.233,
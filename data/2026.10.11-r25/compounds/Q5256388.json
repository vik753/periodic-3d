{"version":"2026.10.11-r25","id":"Q5256388","formula":"C₄₃H₆₅N₁₁O₁₂S₂","hill":"C43H65N11O12S2","elements":["H","C","N","O","S"],"composition":{"C":43.0,"H":65.0,"N":11.0,"O":12.0,"S":2.0},"names":{"en":"Demoxytocin"},"descriptions":{"en":"Demoxytocin (INN; brand names Sandopart, Odeax, Sandopral; also known as desaminooxytocin, deaminooxytocin, 1-(3-mercaptopropanoic acid)oxytocin, and [Mpa1]OT) is an oxytocic peptide drug that is used to induce labor, promote lactation, and to prevent and treat puerperal (postpartum) mastitis (breast inflammation). Demoxytocin is a synthetic analogue of oxytocin and has similar activities, but is more potent and has a longer half-life in comparison. Unlike oxytocin, which is given via intravenous injection, demoxytocin is administered as a buccal tablet formulation."},"fame":4,"pubchemCid":449224,"mass":992.2,"charge":0,"smiles":"CC[C@H](C)[C@H]1C(=O)N[C@H](C(=O)N[C@H](C(=O)N[C@@H](CSSCCC(=O)N[C@H](C(=O)N1)CC2=CC=C(C=C2)O)C(=O)N3CCC[C@H]3C(=O)N[C@@H](CC(C)C)C(=O)NCC(=O)N)CC(=O)N)CCC(=O)N","inchikey":"GTYWGUNQAMYZPF-QPLNMOKZSA-N","iupac":"(2S)-N-[(2S)-1-[(2-amino-2-oxoethyl)amino]-4-methyl-1-oxopentan-2-yl]-1-[(4R,7S,10S,13S,16S)-7-(2-amino-2-oxoethyl)-10-(3-amino-3-oxopropyl)-13-[(2S)-butan-2-yl]-16-[(4-hydroxyphenyl)methyl]-6,9,12,15,18-pentaoxo-1,2-dithia-5,8,11,14,17-pentazacycloicosane-4-carbonyl]pyrrolidine-2-carboxamide","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"rdkit","ref":"449224","atoms":133,"license":"Computed with RDKit from SMILES (PubChem, Wikidata)"},"structure":{"kind":"molecule","atoms":[{"x":-10.053,"y":-0.398,"z":-0.885,"el":"C"},{"x":-9.273,"y":-0.161,"z":-2.173,"el":"C"},{"x":-8.19,"y":-1.214,"z":-2.488,"el":"C"},{"x":-8.834,"y":-2.577,"z":-2.789,"el":"C"},{"x":-7.121,"y":-1.351,"z":-1.38,"el":"C"},{"x":-5.884,"y":-2.149,"z":-1.864,"el":"C"},{"x":-5.495,"y":-2.113,"z":-3.026,"
{"version":"2026.10.11-r25","id":"Q27093765","formula":"C₆H₁₀N₂O₅","hill":"C6H10N2O5","elements":["H","C","N","O"],"composition":{"C":6.0,"H":10.0,"N":2.0,"O":5.0},"names":{"en":"N-(2-acetamido)iminodiacetic acid"},"descriptions":{"en":"ADA is a zwitterionic organic chemical buffering agent; one of Good's buffers. It has a useful pH range of 6.0-7.2 in the physiological range, making it useful for cell culture work. It has a pKa of 6.6 with ΔpKa/°C of -0.011 and is most often prepared in 1 M NaOH where it has a solubility of 160 mg/mL. ADA has been used in protein-free media for chicken embryo fibroblasts, as a chelating agent for H+, Ca2+, and Mg2+, and for isoelectric focusing in immobilized pH gradients."},"fame":4,"pubchemCid":117765,"mass":190.15,"charge":0,"smiles":"C(C(=O)N)N(CC(=O)O)CC(=O)O","inchikey":"QZTKDVCDBIDYMD-UHFFFAOYSA-N","iupac":"2-[(2-amino-2-oxoethyl)-(carboxymethyl)amino]acetic acid","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"117765","atoms":23,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":2.954,"y":1.353,"z":-1.004,"el":"O"},{"x":-0.299,"y":-3.274,"z":-0.824,"el":"O"},{"x":-1.833,"y":1.684,"z":1.155,"el":"O"},{"x":2.365,"y":1.27,"z":1.189,"el":"O"},{"x":-0.019,"y":-2.605,"z":1.329,"el":"O"},{"x":-0.002,"y":0.01,"z":0.005,"el":"N"},{"x":-3.173,"y":1.54,"z":-0.706,"el":"N"},{"x":-1.391,"y":-0.066,"z":-0.448,"el":"C"},{"x":0.628,"y":1.236,"z":-0.482,"el":"C"},{"x":0.747,"y":-1.163,"z":-0.444,"el":"C"},{"x":-2.129,"y":1.135,"z":0.096,"el":"C"},{"x":2.05,"y":1.273,"z":0.005,"el":"C"},{"x":0.102,"y":-2.394,"z":0.129,"el":"C"},{"x":-1.458,"y":-0.095,"z":-1.542,"el":"H"},{"x":-1.917,"y":-0.94,"z":-0.048,"el":"H"},{"x":0.168,"y":2.161,"z":-0.121,"el":"H"},{"x":0.619,"y":1.28,"z":-1.579,"el":"H"},{"x":1.784,"y":-1.184,"z":-0.089,"el":"H"},{"x":0.773,"y":-1.233,"z":-
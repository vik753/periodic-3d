{"version":"2026.10.11-r25","id":"Q7187582","formula":"C₅H₁₄NO₄P","hill":"C5H14NO4P","elements":["H","C","N","O","P"],"composition":{"C":5.0,"H":14.0,"N":1.0,"O":4.0,"P":1.0},"names":{"en":"Phosphorylcholine"},"descriptions":{"en":"Phosphorylcholine (abbreviated ChoP) is the hydrophilic polar head group of some phospholipids, which is composed of a negatively charged phosphate bonded to a small, positively charged choline group. Phosphorylcholine is part of the platelet-activating factor; the phospholipid phosphatidylcholine and sphingomyelin, the only phospholipid of the membrane that is not built with a glycerol backbone. Treatment of cell membranes, like those of RBCs, by certain enzymes, like some phospholipase A2, renders the phosphorylcholine moiety exposed to the external aqueous phase, and thus accessible for recognition by the immune system."},"fame":3,"pubchemCid":135437,"mass":183.14,"charge":0,"smiles":"C[N+](C)(C)CCOP(=O)(O)[O-]","inchikey":"YHHSONZFOIEMCP-UHFFFAOYSA-N","iupac":"2-(trimethylazaniumyl)ethyl hydrogen phosphate","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"135437","atoms":25,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":2.6,"y":0.047,"z":0.069,"el":"P"},{"x":1.146,"y":-0.588,"z":0.454,"el":"O"},{"x":2.574,"y":-0.171,"z":-1.55,"el":"O"},{"x":3.676,"y":-0.847,"z":0.646,"el":"O"},{"x":2.605,"y":1.533,"z":0.355,"el":"O"},{"x":-2.513,"y":-0.009,"z":0.001,"el":"N"},{"x":-1.252,"y":-0.701,"z":0.498,"el":"C"},{"x":-2.486,"y":0.065,"z":-1.519,"el":"C"},{"x":-3.734,"y":-0.799,"z":0.449,"el":"C"},{"x":-2.58,"y":1.398,"z":0.576,"el":"C"},{"x":-0.037,"y":0.073,"z":0.023,"el":"C"},{"x":-1.291,"y":-0.753,"z":1.592,"el":"H"},{"x":-1.245,"y":-1.727,"z":0.112,"el":"H"},{"x":-2.24,"y":-0.925,"z":-1.917,"el":"H"},{"x":-3.483,"y":0.363,"z":-1.86,"el":"H"},{"x":-1.769,"y":0.8
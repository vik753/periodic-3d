{"version":"2026.10.11-r25","id":"Q772913","formula":"Al·Cu·Zn","hill":"AlCuZn","elements":["Al","Cu","Zn"],"composition":{"Al":1.0,"Cu":1.0,"Zn":1.0},"names":{"en":"Devarda's alloy","ru":"Сплав Деварда"},"descriptions":{"en":"Devarda's alloy (CAS # 8049-11-4) is an alloy of aluminium (44% – 46%), copper (49% – 51%) and zinc (4% – 6%). Devarda's alloy is used as reducing agent in analytical chemistry for the determination of nitrates after their reduction to ammonia under alkaline conditions. It is named for Italian chemist Arturo Devarda (1859–1944), who synthesised it at the end of the 19th century to develop a new method to analyze nitrate in Chile saltpeter.","ru":"Сплав Деварда — сплав меди, алюминия и цинка (50 %, 45 % и 5 % соответственно). Хорошо растирается в порошок. Применяют в аналитической химии как восстановитель нитратов и нитритов в аммиак и др."},"fame":18,"pubchemCid":91936835,"mass":943.7,"charge":0,"smiles":"[Al].[Al].[Al].[Al].[Al].[Al].[Al].[Al].[Al].[Cu].[Cu].[Cu].[Cu].[Cu].[Cu].[Cu].[Cu].[Cu].[Cu].[Zn]","inchikey":"MPKKOQSNGWAMJD-UHFFFAOYSA-N","iupac":null,"classes":[{"qid":"Q37756","names":{"en":"alloy","ru":"сплав","uk":"сплави"}}],"structureInfo":null,"structure":null,"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q772913","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Devarda%27s_alloy","license":"CC BY-SA 4.0"},{"role":"description","name":"Wikipedia (ru)","url":"https://ru.wikipedia.org/wiki/%D0%A1%D0%BF%D0%BB%D0%B0%D0%B2_%D0%94%D0%B5%D0%B2%D0%B0%D1%80%D0%B4%D0%B0","license":"CC BY-SA 4.0"},{"role":"properties","name":"PubChem","url":"https://pubchem.ncbi.nlm.nih.gov/compound/91936835","license":"PubChem (NIH), public data"}],"similar":[{"id":"Q145352","formula":"Al·Cu·Mg·Zn","names":{"en":"Zamak","ru":"Замак","uk":"Zamak"},"elements":["Mg","Al","Cu","Zn"],"fame":22,"kind":null},{"id":"Q3645332","formula":"Al·Cu·Ni","names":{"en":"Bronzital","
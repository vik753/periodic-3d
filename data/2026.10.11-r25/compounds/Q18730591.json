{"version":"2026.10.11-r25","id":"Q18730591","formula":"C₆H₄N₂","hill":"C6H4N2","elements":["H","C","N"],"composition":{"C":6.0,"H":4.0,"N":2.0},"names":{"en":"3-cyanopyridine"},"descriptions":{"en":"Nicotinonitrile or 3-cyanopyridine is an organic compound with the formula NCC5H4N. The molecule consists of a pyridine ring with a nitrile group attached to the 3-position. A colorless solid, it is produced by ammoxidation of 3-methylpyridine: H3CC5H4N + NH3 + 1.5 O2 → NCC5H4N + 3 H2O Nicotinonitrile is a precursor to the vitamin niacin. Nitrilase-catalyzed hydrolysis of 3-cyanopyridine by means of immobilized Rhodococcus rhodochrous J1 strains leads in quantitative yield to nicotinamide (vitamin B3)."},"fame":8,"pubchemCid":79,"mass":104.11,"charge":0,"smiles":"C1=CC(=CN=C1)C#N","inchikey":"GZPHSAQLYPIAIN-UHFFFAOYSA-N","iupac":"pyridine-3-carbonitrile","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"79","atoms":12,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":1.544,"y":-1.213,"z":0.0,"el":"N"},{"x":-3.13,"y":-0.026,"z":0.0,"el":"N"},{"x":-0.539,"y":0.014,"z":0.001,"el":"C"},{"x":0.16,"y":1.216,"z":0.0,"el":"C"},{"x":1.55,"y":1.205,"z":0.0,"el":"C"},{"x":0.193,"y":-1.163,"z":0.0,"el":"C"},{"x":2.189,"y":-0.025,"z":0.0,"el":"C"},{"x":-1.966,"y":-0.008,"z":0.0,"el":"C"},{"x":-0.365,"y":2.168,"z":0.0,"el":"H"},{"x":2.116,"y":2.129,"z":-0.001,"el":"H"},{"x":-0.293,"y":-2.134,"z":0.0,"el":"H"},{"x":3.272,"y":-0.088,"z":-0.001,"el":"H"}],"bonds":[[0,5,1],[0,6,2],[1,7,3],[2,3,1],[2,5,2],[2,7,1],[3,4,2],[3,8,1],[4,6,1],[4,9,1],[5,10,1],[6,11,1]]},"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q18730591","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Nicotinonitrile","license":"CC BY-SA 4.0"},{"role":"
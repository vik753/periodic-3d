{"version":"2026.10.11-r25","id":"Q1934730","formula":"Ca₂Cu₉(AsO₄)₄(CO₃)(OH)₈·11H₂O","hill":"CH30As4Ca2Cu9O38","elements":["H","C","O","Ca","Cu","As"],"composition":{"C":1.0,"H":30.0,"O":38.0,"As":4.0,"Ca":2.0,"Cu":9.0},"names":{"en":"Tyrolite","uk":"Тироліт"},"descriptions":{"en":"Tyrolite is a hydrous calcium copper arsenate carbonate mineral with the formula CaCu5(AsO4)2CO3(OH)4⋅6H2O. Tyrolite forms glassy, blue to green orthorhombic radial crystals and botryoidal masses. It has a Mohs hardness of 1.5–2.0 and a specific gravity of 3.1–3.2. It is translucent with refractive indices of nα = 1.694, nβ = 1.726, and nγ = 1.730.","uk":"Тироліт, Тіроліт (рос. тиролит; англ. tyrolite; нім."},"fame":16,"pubchemCid":null,"mass":null,"charge":0,"smiles":null,"inchikey":null,"iupac":null,"classes":[{"qid":"Q12089225","names":{"en":"mineral species","ru":"действительный вид минералов","uk":"мінеральний вид"}}],"structureInfo":null,"structure":null,"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q1934730","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Tyrolite","license":"CC BY-SA 4.0"},{"role":"description","name":"Wikipedia (uk)","url":"https://uk.wikipedia.org/wiki/%D0%A2%D0%B8%D1%80%D0%BE%D0%BB%D1%96%D1%82","license":"CC BY-SA 4.0"},{"role":"photo","name":"Wikimedia Commons","url":"https://commons.wikimedia.org/wiki/File:Mineraly.sk_-_tirolit.jpg","license":"CC BY 2.0"}],"similar":[{"id":"Q2238642","formula":"CaCu₄(SO₄)₂(OH)₆·3H₂O","names":{"en":"Devilline","uk":"Девілін"},"elements":["H","O","S","Ca","Cu"],"fame":17,"kind":null},{"id":"Q2632186","formula":"Cu₂AsO₄(OH)·3H₂O","names":{"en":"Euchroite","ru":"Эвхроит","uk":"Евхроїт"},"elements":["H","O","Cu","As"],"fame":17,"kind":null},{"id":"Q4023315","formula":"Cu(AsO₃OH)·2H₂O","names":{"en":"Yvonite","uk":"Івоніт"},"elements":["H","O","Cu","As"],"fame":8,"kind":null},{"id":"Q3896314","formula":"Cu₉(AsO₄)₂(SO₄)(OH)₁₀*7H₂O","names
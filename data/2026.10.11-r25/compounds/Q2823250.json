{"version":"2026.10.11-r25","id":"Q2823250","formula":"C₃H₇NO₅S","hill":"C3H7NO5S","elements":["H","C","N","O","S"],"composition":{"C":3.0,"H":7.0,"N":1.0,"O":5.0,"S":1.0},"names":{"en":"Cysteic acid"},"descriptions":{"en":"Cysteic acid also known as 3-sulfo-l-alanine is the organic compound with the formula HO3SCH2CH(NH2)CO2H. It is often referred to as cysteate, which near neutral pH takes the form −O3SCH2CH(NH3+)CO2−. It is an amino acid generated by oxidation of cysteine, whereby a thiol group is fully oxidized to a sulfonic acid/sulfonate group. It is further metabolized via 3-sulfolactate, which converts to pyruvate and sulfite/bisulfite."},"fame":9,"pubchemCid":25701,"mass":169.16,"charge":0,"smiles":"C(C(C(=O)O)N)S(=O)(=O)O","inchikey":"XVOYSCVBGLVSOL-UHFFFAOYSA-N","iupac":"2-amino-3-sulfopropanoic acid","classes":[{"qid":"Q15711994","names":{"en":"group of isomeric entities","ru":"семейство химических соединений","uk":"родина хімічних сполук"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"25701","atoms":17,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-1.591,"y":-0.156,"z":0.052,"el":"S"},{"x":-2.863,"y":0.577,"z":-0.66,"el":"O"},{"x":-1.822,"y":-0.204,"z":1.484,"el":"O"},{"x":-1.256,"y":-1.348,"z":-0.704,"el":"O"},{"x":1.767,"y":-1.346,"z":0.979,"el":"O"},{"x":1.768,"y":-0.802,"z":-1.222,"el":"O"},{"x":1.903,"y":1.864,"z":0.022,"el":"N"},{"x":-0.388,"y":1.091,"z":-0.291,"el":"C"},{"x":0.945,"y":0.823,"z":0.397,"el":"C"},{"x":1.537,"y":-0.499,"z":-0.058,"el":"C"},{"x":-0.281,"y":1.133,"z":-1.382,"el":"H"},{"x":-0.803,"y":2.045,"z":0.054,"el":"H"},{"x":0.82,"y":0.817,"z":1.485,"el":"H"},{"x":2.045,"y":1.866,"z":-0.987,"el":"H"},{"x":2.81,"y":1.67,"z":0.446,"el":"H"},{"x":-3.22,"y":1.364,"z":-0.186,"el":"H"},{"x":2.137,"y":-2.202,"z":0.677,"el":"H"}],"bonds":[[0,1,1],[0,2,2],[0,3,2],[0,7,1],[1,15,1],[4,9,1],[4,16,1],[5,9,2],[6,8,1],[6,13,1],[6,14,1],[7,8,1],[7,10,1],[7,11,1],[8,9,1],[8,12,1]]},"sources":
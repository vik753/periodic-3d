{"version":"2026.10.11-r25","id":"Q238477","formula":"C₄H₃BrN₂O₂","hill":"C4H3BrN2O2","elements":["H","C","N","O","Br"],"composition":{"C":4.0,"H":3.0,"N":2.0,"O":2.0,"Br":1.0},"names":{"en":"Bromouracil"},"descriptions":{"en":"5-Bromouracil (5-BrU, 5BrUra, or br5Ura) is a brominated derivative of uracil that acts as an antimetabolite or base analog, substituting for thymine in DNA, and can induce DNA mutation in the same way as 2-aminopurine. It is used mainly as an experimental mutagen, but its deoxyriboside derivative (5-bromo-2-deoxy-uridine) is used to treat neoplasms. 5-BrU exists in three tautomeric forms that have different base pairing properties."},"fame":11,"pubchemCid":5802,"mass":190.98,"charge":0,"smiles":"C1=C(C(=O)NC(=O)N1)Br","inchikey":"LQLQRFGHAALLLE-UHFFFAOYSA-N","iupac":"5-bromo-1H-pyrimidine-2,4-dione","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"5802","atoms":12,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-2.974,"y":0.796,"z":0.0,"el":"Br"},{"x":-1.409,"y":-1.876,"z":0.0,"el":"O"},{"x":2.886,"y":-0.196,"z":0.0,"el":"O"},{"x":0.741,"y":-1.046,"z":0.0,"el":"N"},{"x":1.108,"y":1.264,"z":0.0,"el":"N"},{"x":-0.644,"y":-0.916,"z":0.0,"el":"C"},{"x":1.67,"y":-0.003,"z":0.0,"el":"C"},{"x":-1.137,"y":0.492,"z":0.0,"el":"C"},{"x":-0.242,"y":1.485,"z":0.0,"el":"C"},{"x":1.113,"y":-1.991,"z":0.0,"el":"H"},{"x":1.721,"y":2.074,"z":0.0,"el":"H"},{"x":-0.529,"y":2.53,"z":0.0,"el":"H"}],"bonds":[[0,7,1],[1,5,2],[2,6,2],[3,5,1],[3,6,1],[3,9,1],[4,6,1],[4,8,1],[4,10,1],[5,7,1],[7,8,2],[8,11,1]]},"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q238477","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/5-Bromouracil","license":"CC BY-SA 4.0"},{"role":"properties","name":"PubChem","url":
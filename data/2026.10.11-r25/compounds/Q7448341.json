{"version":"2026.10.11-r25","id":"Q7448341","formula":"C₇H₁₄NO₅P","hill":"C7H14NO5P","elements":["H","C","N","O","P"],"composition":{"C":7.0,"H":14.0,"N":1.0,"O":5.0,"P":1.0},"names":{"en":"Selfotel"},"descriptions":{"en":"Selfotel (CGS-19755) is a drug which acts as a competitive NMDA antagonist, directly competing with glutamate for binding to the receptor. Initial studies showed it to have anticonvulsant, anxiolytic, analgesic and neuroprotective effects, and it was originally researched for the treatment of stroke, but subsequent animal and human studies showed phencyclidine-like effects, as well as limited efficacy and evidence for possible neurotoxicity under some conditions, and so clinical development was ultimately discontinued."},"fame":5,"pubchemCid":68736,"mass":223.16,"charge":0,"smiles":"C1CN[C@@H](C[C@@H]1CP(=O)(O)O)C(=O)O","inchikey":"LPMRCCNDNGONCD-RITPCOANSA-N","iupac":"(2S,4R)-4-(phosphonomethyl)piperidine-2-carboxylic acid","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"68736","atoms":28,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-3.217,"y":-0.188,"z":-0.068,"el":"P"},{"x":-3.336,"y":-0.51,"z":1.506,"el":"O"},{"x":-4.247,"y":-1.221,"z":-0.752,"el":"O"},{"x":-3.371,"y":1.243,"z":-0.456,"el":"O"},{"x":3.485,"y":-1.836,"z":0.345,"el":"O"},{"x":4.178,"y":0.073,"z":-0.688,"el":"O"},{"x":2.011,"y":1.411,"z":0.009,"el":"N"},{"x":-0.465,"y":-0.149,"z":0.185,"el":"C"},{"x":0.885,"y":-0.789,"z":-0.159,"el":"C"},{"x":-0.452,"y":1.332,"z":-0.212,"el":"C"},{"x":2.043,"y":0.013,"z":0.438,"el":"C"},{"x":-1.614,"y":-0.89,"z":-0.494,"el":"C"},{"x":0.753,"y":2.055,"z":0.386,"el":"C"},{"x":3.347,"y":-0.544,"z":-0.039,"el":"C"},{"x":-0.608,"y":-0.208,"z":1.272,"el":"H"},{"x":0.999,"y":-0.861,"z":-1.25,"el":"H"},{"x":0.903,"y":-1.82,"z":0.218,"el":"H"},{"x":-1.323,"y":1.855,"z":0.
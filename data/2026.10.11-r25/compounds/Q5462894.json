urane","ru":"Тетрафторэтан"},"elements":["H","C","F"],"fame":32,"kind":"molecule"},{"id":"Q2474643","formula":"C₂H₃F₃O","names":{"en":"2,2,2-trifluoroethanol","ru":"Трифторэтанол"},"elements":["H","C","O","F"],"fame":21,"kind":"molecule"}],"photo":null}
{"version":"2026.10.11-r25","id":"Q15409358","formula":"C₁₇H₂₂O₂","hill":"C17H22O2","elements":["H","C","O"],"composition":{"C":17.0,"H":22.0,"O":2.0},"names":{"en":"O-1602"},"descriptions":{"en":"O-1602 is a synthetic compound most closely related to abnormal cannabidiol, and more distantly related in structure to cannabinoid drugs such as THC. O-1602 does not bind to the classical cannabinoid receptors CB1 or CB2 with any significant affinity, but instead is an agonist at several other receptors which appear to be related to the cannabinoid receptors, particularly GPR18 and GPR55. These previously orphan receptors have been found to be targets for a number of endogenous and synthetic cannabinoid compounds, and are thought to be responsible for most of the non-CB1, non-CB2 mediated effects that have become evident in the course of cannabinoid research."},"fame":4,"pubchemCid":45073499,"mass":258.35,"charge":0,"smiles":"CC1=C[C@H]([C@@H](CC1)C(=C)C)C2=C(C=C(C=C2C)O)O","inchikey":"KDZOUSULXZNDJH-LSDHHAIUSA-N","iupac":"5-methyl-4-[(1R,6R)-3-methyl-6-prop-1-en-2-ylcyclohex-2-en-1-yl]benzene-1,3-diol","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"45073499","atoms":41,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-0.168,"y":-1.348,"z":1.716,"el":"O"},{"x":-4.743,"y":-0.781,"z":0.512,"el":"O"},{"x":1.448,"y":0.878,"z":0.494,"el":"C"},{"x":0.763,"y":0.022,"z":-0.608,"el":"C"},{"x":2.974,"y":0.806,"z":0.358,"el":"C"},{"x":3.474,"y":-0.635,"z":0.47,"el":"C"},{"x":1.466,"y":-1.298,"z":-0.852,"el":"C"},{"x":2.675,"y":-1.61,"z":-0.353,"el":"C"},{"x":-0.718,"y":-0.19,"z":-0.31,"el":"C"},{"x":1.003,"y":2.311,"z":0.446,"el":"C"},{"x":-1.687,"y":0.292,"z":-1.19,"el":"C"},{"x":3.307,"y":-2.95,"z":-0.589,"el":"C"},{"x":-1.101,"y":-0.87,"z":0.846,"el":"C"},{"x":0.333,"y":2.837,"z":1.68,"el":"C"},{"x"
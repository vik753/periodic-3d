{"version":"2026.10.11-r25","id":"Q4836835","formula":"C₁₆H₁₈N₂OS","hill":"C16H18N2OS","elements":["H","C","N","O","S"],"composition":{"C":16.0,"H":18.0,"N":2.0,"O":1.0,"S":1.0},"names":{"en":"BW723C86"},"descriptions":{"en":"BW-723C86 is a tryptamine derivative drug which acts as a 5-HT2B receptor agonist. It has anxiolytic effects in animal studies, and is also used for investigating the function of the 5-HT2B receptor in a range of other tissues. BW-723C86 is actually a mixed 5-HT2B/5-HT2C agonist, and while it has good selectivity over 5-HT2A and other serotonin receptor subtypes, it is around only 3 times as selective for 2B compared to 2C and so is much less selective than most research ligands, but no superior 5-HT2B agonist was available until the potent and selective 5-HT2B activity of 6-APB was discovered in 2012."},"fame":5,"pubchemCid":4284720,"mass":286.4,"charge":0,"smiles":"CC(CC1=CNC2=C1C=C(C=C2)OCC3=CC=CS3)N","inchikey":"ALFGDCNSEBJYSP-UHFFFAOYSA-N","iupac":"1-[5-(thiophen-2-ylmethoxy)-1H-indol-3-yl]propan-2-amine","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"4284720","atoms":38,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":4.618,"y":-1.052,"z":-1.363,"el":"S"},{"x":1.893,"y":0.995,"z":0.123,"el":"O"},{"x":-3.486,"y":2.029,"z":-0.111,"el":"N"},{"x":-3.201,"y":-3.821,"z":0.035,"el":"N"},{"x":-2.93,"y":-0.081,"z":-0.518,"el":"C"},{"x":-3.027,"y":-1.52,"z":-0.837,"el":"C"},{"x":-1.738,"y":0.651,"z":-0.26,"el":"C"},{"x":-3.186,"y":-2.426,"z":0.412,"el":"C"},{"x":-2.115,"y":1.972,"z":-0.007,"el":"C"},{"x":-3.988,"y":0.793,"z":-0.42,"el":"C"},{"x":-0.37,"y":0.316,"z":-0.216,"el":"C"},{"x":-4.449,"y":-2.093,"z":1.2,"el":"C"},{"x":-1.188,"y":2.978,"z":0.288,"el":"C"},{"x":0.568,"y":1.312,"z":0.078,"el":"C"},{"x":0.163,"y":2.622,"z":0.326,"el":"C"},{"x":2.243,"y":-0.362,"z
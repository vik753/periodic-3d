{"version":"2026.10.11-r25","id":"Q15634092","formula":"C₁₆H₁₀MgO₁₀","hill":"C16H10MgO10","elements":["H","C","O","Mg"],"composition":{"C":16.0,"H":10.0,"O":10.0,"Mg":1.0},"names":{"en":"Magnesium monoperoxyphthalate"},"descriptions":{"en":"Magnesium monoperoxyphthalate (MMPP) is a water-soluble peroxy acid used as an oxidant in organic synthesis. Its main areas of use are the conversion of ketones to esters (Baeyer-Villiger oxidation), epoxidation of alkenes (Prilezhaev reaction), oxidation of sulfides to sulfoxides and sulfones, oxidation of amines to produce amine oxides, and in the oxidative cleavage of hydrazones. Due to its insolubility in non-polar solvents MMPP has seen less use than the more widely used meta-chloroperoxybenzoic acid (mCPBA)."},"fame":3,"pubchemCid":3081588,"mass":386.55,"charge":0,"smiles":"[H+].[H+].C1=CC=C(C(=C1)C(=O)[O-])C(=O)O[O-].C1=CC=C(C(=C1)C(=O)[O-])C(=O)O[O-].[Mg+2]","inchikey":"PIOZZBNFRIZETM-UHFFFAOYSA-L","iupac":"magnesium;hydron;bis(2-oxidooxycarbonylbenzoate)","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"rdkit","ref":"3081588","atoms":37,"license":"Computed with RDKit from SMILES (PubChem, Wikidata)"},"structure":{"kind":"molecule","atoms":[{"x":-1.438,"y":-2.478,"z":-0.459,"el":"C"},{"x":-0.718,"y":-3.542,"z":0.078,"el":"C"},{"x":0.672,"y":-3.467,"z":0.177,"el":"C"},{"x":1.364,"y":-2.323,"z":-0.263,"el":"C"},{"x":0.633,"y":-1.255,"z":-0.851,"el":"C"},{"x":-0.771,"y":-1.343,"z":-0.921,"el":"C"},{"x":1.291,"y":-0.079,"z":-1.465,"el":"C"},{"x":0.72,"y":1.044,"z":-1.456,"el":"O"},{"x":2.514,"y":-0.209,"z":-2.114,"el":"O"},{"x":2.824,"y":-2.252,"z":-0.022,"el":"C"},{"x":3.522,"y":-3.302,"z":-0.072,"el":"O"},{"x":3.424,"y":-1.041,"z":0.318,"el":"O"},{"x":4.739,"y":-0.969,"z":0.559,"el":"O"},{"x":-2.517,"y":-2.537,"z":-0.53,"el":"H"},{"x":-1.238,"y":-4.423,"z":0.43,"el":"H"},{"x":1.206,"y":-4.294,"z"
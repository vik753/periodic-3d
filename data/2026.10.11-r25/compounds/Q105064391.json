{"version":"2026.10.11-r25","id":"Q105064391","formula":"C₁₈H₁₉ClN₂","hill":"C18H19ClN2","elements":["H","C","N","Cl"],"composition":{"C":18.0,"H":19.0,"N":2.0,"Cl":1.0},"names":{"en":"Huprine X"},"descriptions":{"en":"Huprine X is a synthetic cholinergic compound developed as a hybrid between the natural product Huperzine A and the synthetic drug tacrine. It is one of the most potent reversible inhibitors of acetylcholinesterase known, with a binding affinity of 0.026nM, as well as showing direct agonist activity at both nicotinic and muscarinic acetylcholine receptors. In animal studies it has nootropic and neuroprotective effects, and is used in research into Alzheimer's disease, and although huprine X itself has not been researched for medical use in humans, a large family of related derivatives have been developed."},"fame":1,"pubchemCid":5288588,"mass":298.8,"charge":0,"smiles":"CCC1=C[C@H]2C[C@@H](C1)C3=C(C4=C(C=C(C=C4)Cl)N=C3C2)N","inchikey":"QTPHSDHUHXUYFE-NWDGAFQWSA-N","iupac":"(1S,13S)-7-chloro-15-ethyl-10-azatetracyclo[11.3.1.02,11.04,9]heptadeca-2,4(9),5,7,10,14-hexaen-3-amine","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"5288588","atoms":40,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":5.779,"y":0.366,"z":-1.355,"el":"Cl"},{"x":0.904,"y":1.49,"z":-0.516,"el":"N"},{"x":0.339,"y":-1.84,"z":1.979,"el":"N"},{"x":-1.904,"y":-0.123,"z":1.494,"el":"C"},{"x":-2.796,"y":1.776,"z":0.172,"el":"C"},{"x":-2.715,"y":1.175,"z":1.581,"el":"C"},{"x":-2.686,"y":-1.15,"z":0.642,"el":"C"},{"x":-1.392,"y":2.245,"z":-0.248,"el":"C"},{"x":-0.538,"y":0.15,"z":0.893,"el":"C"},{"x":-3.304,"y":-0.56,"z":-0.609,"el":"C"},{"x":-0.304,"y":1.239,"z":0.051,"el":"C"},{"x":-3.335,"y":0.769,"z":-0.82,"el":"C"},{"x":0.531,"y":-0.713,"z":1.136,"el":"C"},{"x":-3.871,"y":-1.537,"z":-1.594,"el":"C"},{"x":1
{"version":"2026.10.11-r25","id":"Q1139791","formula":"C₄H₃₄N₁₂Ru₂","hill":"C4H34N12Ru2","elements":["H","C","N","Ru"],"composition":{"C":4.0,"H":34.0,"N":12.0,"Ru":2.0},"names":{"en":"Creutz-Taube complex"},"descriptions":{"en":"The Creutz–Taube ion is the metal complex with the formula {[Ru(NH3)5]2(C4H4N2)}5+. This cationic species has been heavily studied in an effort to understand the intimate details of inner sphere electron transfer, that is, how electrons move from one metal complex to another. The ion is named after Carol Creutz, who first prepared the complex, and her thesis advisor Henry Taube, who received a Nobel Prize in Chemistry for this and related discoveries on electron transfer."},"fame":7,"pubchemCid":null,"mass":null,"charge":0,"smiles":null,"inchikey":null,"iupac":null,"classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":null,"structure":null,"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q1139791","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Creutz%E2%80%93Taube_complex","license":"CC BY-SA 4.0"}],"similar":[{"id":"Q161296","formula":"C₂H₈N₂","names":{"en":"1,1-dimethylhydrazine","ru":"1,1-диметилгидразин","uk":"Несиметричний диметилгідразин"},"elements":["H","C","N"],"fame":35,"kind":"molecule"},{"id":"Q411362","formula":"C₂H₈N₂","names":{"en":"Ethylenediamine","ru":"Этилендиамин"},"elements":["H","C","N"],"fame":31,"kind":"molecule"},{"id":"Q417347","formula":"CH₆N₂","names":{"en":"Monomethylhydrazine","ru":"Метилгидразин"},"elements":["H","C","N"],"fame":28,"kind":"molecule"},{"id":"Q16831","formula":"C₂H₁₂N₄","names":{"en":"Aerozine-50","ru":"Аэрозин","uk":"Аерозин 50"},"elements":["H","C","N"],"fame":19,"kind":"molecule"},{"id":"Q161484","formula":"C₂H₈N₂","names":{"en":"1,2-dimethylhydrazine","ru":"1,2-диметилгидразин"},"elements":["H","C","N"],"f
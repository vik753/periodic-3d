{"version":"2026.10.11-r25","id":"Q83118112","formula":"C₁₇H₁₂BrClN₄","hill":"C17H12BrClN4","elements":["H","C","N","Cl","Br"],"composition":{"C":17.0,"H":12.0,"N":4.0,"Br":1.0,"Cl":1.0},"names":{"en":"Phenazolam"},"descriptions":{"en":"Clobromazolam (also known as phenazolam, DM-II-90, and BRN 4550445) is a synthetic benzodiazepine derivative. It is structurally related to other triazolobenzodiazepines and is believed to act as a potent sedative and hypnotic through positive allosteric modulation of the GABAA receptor. The compound was first described in the early 1980s during research into novel anxiolytic and hypnotic agents, but it was never developed or approved for medical use."},"fame":5,"pubchemCid":1032830,"mass":387.7,"charge":0,"smiles":"CC1=NN=C2N1C3=C(C=C(C=C3)Br)C(=NC2)C4=CC=CC=C4Cl","inchikey":"BUTCFAZTKZDYCN-UHFFFAOYSA-N","iupac":"8-bromo-6-(2-chlorophenyl)-1-methyl-4H-[1,2,4]triazolo[4,3-a][1,4]benzodiazepine","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"1032830","atoms":35,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-1.171,"y":4.729,"z":0.203,"el":"Br"},{"x":-0.997,"y":-1.81,"z":-2.029,"el":"Cl"},{"x":2.221,"y":-0.34,"z":0.051,"el":"N"},{"x":-0.221,"y":-1.537,"z":1.438,"el":"N"},{"x":3.083,"y":-2.279,"z":0.646,"el":"N"},{"x":3.864,"y":-1.751,"z":-0.353,"el":"N"},{"x":1.38,"y":0.794,"z":0.023,"el":"C"},{"x":0.046,"y":0.741,"z":0.472,"el":"C"},{"x":2.12,"y":-1.418,"z":0.901,"el":"C"},{"x":-0.685,"y":-0.537,"z":0.768,"el":"C"},{"x":1.12,"y":-1.487,"z":1.989,"el":"C"},{"x":3.355,"y":-0.585,"z":-0.679,"el":"C"},{"x":1.912,"y":2.011,"z":-0.434,"el":"C"},{"x":-2.066,"y":-0.7,"z":0.223,"el":"C"},{"x":-0.699,"y":1.932,"z":0.537,"el":"C"},{"x":1.149,"y":3.177,"z":-0.385,"el":"C"},{"x":-0.148,"y":3.141,"z":0.115,"el":"C"},{"x":3.865,"y":0.224,"z":-1.806,"el":"C"},{"x":-2.
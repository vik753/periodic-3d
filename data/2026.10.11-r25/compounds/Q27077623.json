{"version":"2026.10.11-r25","id":"Q27077623","formula":"B₄O₇²⁻","hill":"B4O7","elements":["B","O"],"composition":{"B":4.0,"O":7.0},"names":{"en":"Tetraborate(2-)"},"descriptions":{"en":"In chemistry, tetraborate or pyroborate is an anion (negative ion) with formula B4O2−7; or a salt containing that anion, such as sodium tetraborate, Na2B4O7. It is one of the boron oxoacids, that is, a borate. The name is also applied to the hydrated ion [B4O5(OH)4]2− as present in borax The ion occurs in boric acid solutions at neutral pH, being formed by condensation of orthoborate and tetrahydroxyborate anions: 2 B(OH)3 + 2 [B(OH)4]− ⇌ [B4O5(OH)4]−2 + 5 H2O The tetraborate anion (tetramer) includes two tetrahedral and two trigonal boron atoms symmetrically assembled in a fused bicyclic structure."},"fame":1,"pubchemCid":9855541,"mass":155.2,"charge":-2,"smiles":"B1(OB2OB(OB(O1)O2)[O-])[O-]","inchikey":"GDTSJMKGXGJFGQ-UHFFFAOYSA-N","iupac":"3,7-dioxido-2,4,6,8,9-pentaoxa-1,3,5,7-tetraborabicyclo[3.3.1]nonane","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"rdkit","ref":"9855541","atoms":11,"license":"Computed with RDKit from SMILES (PubChem, Wikidata)"},"structure":{"kind":"molecule","atoms":[{"x":-1.914,"y":0.538,"z":-0.468,"el":"B"},{"x":-1.313,"y":1.032,"z":0.798,"el":"O"},{"x":-0.166,"y":0.146,"z":1.124,"el":"B"},{"x":1.157,"y":0.818,"z":1.192,"el":"O"},{"x":2.026,"y":0.195,"z":0.16,"el":"B"},{"x":1.44,"y":-0.206,"z":-1.145,"el":"O"},{"x":0.076,"y":-0.731,"z":-0.878,"el":"B"},{"x":-1.03,"y":0.008,"z":-1.538,"el":"O"},{"x":-0.185,"y":-1.201,"z":0.504,"el":"O"},{"x":3.169,"y":-0.579,"z":0.638,"el":"O"},{"x":-3.261,"y":-0.02,"z":-0.387,"el":"O"}],"bonds":[[0,1,1.0],[1,2,1.0],[2,3,1.0],[3,4,1.0],[4,5,1.0],[5,6,1.0],[6,7,1.0],[6,8,1.0],[4,9,1.0],[0,10,1.0],[7,0,1.0],[8,2,1.0]]},"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.o
{"version":"2026.10.11-r25","id":"Q7277302","formula":"C₂₄H₂₀F₃N₃O","hill":"C24H20F3N3O","elements":["H","C","N","O","F"],"composition":{"C":24.0,"F":3.0,"H":20.0,"N":3.0,"O":1.0},"names":{"en":"Ro4491533"},"descriptions":{"en":"RO-4491533 is a drug developed by Hoffmann-La Roche which acts as a potent and selective negative allosteric modulator for group II of the metabotropic glutamate receptors (mGluR2/3), being equipotent at mGluR2 and mGluR3 but without activity at other mGluR subtypes. In animal studies, RO-4491533 produced antidepressant effects and reversed the effects of the mGluR2/3 agonist LY-379,268 with similar efficacy but slightly lower potency than the mGluR2/3 antagonist LY-341,495. A number of related compounds are known, with similar effects in vitro and a fairly well characterized structure-activity relationship."},"fame":4,"pubchemCid":11158623,"mass":423.4,"charge":0,"smiles":"CC1=CC2=C(C=C1C(F)(F)F)NC(=O)CC(=N2)C3=CC=CC(=C3)C4=CC(=NC(=C4)C)C","inchikey":"LYTVXCQQTLUEQR-UHFFFAOYSA-N","iupac":"4-[3-(2,6-dimethyl-4-pyridinyl)phenyl]-7-methyl-8-(trifluoromethyl)-1,3-dihydro-1,5-benzodiazepin-2-one","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"11158623","atoms":51,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":6.866,"y":-1.958,"z":0.608,"el":"F"},{"x":7.473,"y":-0.43,"z":-0.806,"el":"F"},{"x":7.38,"y":0.033,"z":1.317,"el":"F"},{"x":-0.03,"y":-2.841,"z":0.116,"el":"O"},{"x":2.009,"y":-1.83,"z":0.347,"el":"N"},{"x":1.308,"y":1.124,"z":-0.015,"el":"N"},{"x":-6.998,"y":-1.242,"z":0.251,"el":"N"},{"x":0.258,"y":0.52,"z":-0.47,"el":"C"},{"x":2.937,"y":-0.775,"z":0.195,"el":"C"},{"x":2.6,"y":0.568,"z":-0.062,"el":"C"},{"x":0.323,"y":-0.834,"z":-1.121,"el":"C"},{"x":-1.062,"y":1.195,"z":-0.35,"el":"C"},{"x":5.306,"y":-0.197,"z":0.178,"el":"C"},{"x":4.983,"y":1.12,"z":-0.1
{"version":"2026.10.11-r25","id":"Q124721221","formula":"C₄₅H₄₈ClN₇O₈S","hill":"C45H48ClN7O8S","elements":["H","C","N","O","S","Cl"],"composition":{"C":45.0,"H":48.0,"N":7.0,"O":8.0,"S":1.0,"Cl":1.0},"names":{"en":"Lisaftoclax"},"descriptions":{"en":"Lisaftoclax is an investigational new drug being developed by Ascentage Pharma for the treatment of hematological malignancies, particularly chronic lymphocytic leukemia (CLL) and small lymphocytic lymphoma (SLL). It is a selective inhibitor of the B-cell lymphoma 2 (BCL-2) protein, designed to restore the normal process of programmed cell death (apoptosis) in cancer cells. As of 2024, lisaftoclax is undergoing multiple Phase 3 clinical trials, including studies in combination with BTK inhibitors for relapsed/refractory CLL/SLL. In July 2025, lisaftoclax was approved in China for the treatment of CLL or SLL in adult patients who had received at least one prior systemic therapy."},"fame":1,"pubchemCid":137355972,"mass":882.4,"charge":0,"smiles":"C1CC2(C1)CCC(=C(C2)C3=CC=C(C=C3)Cl)CN4CCN(CC4)C5=CC(=C(C=C5)C(=O)NS(=O)(=O)C6=CC(=C(C=C6)NC[C@H]7COCCO7)[N+](=O)[O-])OC8=CN=C9C(=C8)C=CN9","inchikey":"FNBXDBIYRAPDPI-BHVANESWSA-N","iupac":"4-[4-[[8-(4-chlorophenyl)spiro[3.5]non-7-en-7-yl]methyl]piperazin-1-yl]-N-[4-[[(2S)-1,4-dioxan-2-yl]methylamino]-3-nitrophenyl]sulfonyl-2-(1H-pyrrolo[2,3-b]pyridin-5-yloxy)benzamide","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"rdkit","ref":"137355972","atoms":110,"license":"Computed with RDKit from SMILES (PubChem, Wikidata)"},"structure":{"kind":"molecule","atoms":[{"x":-6.868,"y":4.136,"z":1.827,"el":"C"},{"x":-7.82,"y":4.452,"z":0.658,"el":"C"},{"x":-7.483,"y":3.05,"z":0.063,"el":"C"},{"x":-6.17,"y":3.113,"z":0.911,"el":"C"},{"x":-7.283,"y":3.053,"z":-1.449,"el":"C"},{"x":-6.655,"y":1.726,"z":-1.872,"el":"C"},{"x":-7.314,"y":0.504,"z":-1.263,"el":"C"},{"x":-8
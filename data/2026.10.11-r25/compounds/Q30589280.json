{"version":"2026.10.11-r25","id":"Q30589280","formula":"MgAr","hill":"ArMg","elements":["Mg","Ar"],"composition":{"Ar":1.0,"Mg":1.0},"names":{"en":"Magnesium argide"},"descriptions":{"en":"The magnesium argide ion, MgAr+ is an ion composed of one ionised magnesium atom, Mg+ and an argon atom. It is important in inductively coupled plasma mass spectrometry and in the study of the field around the magnesium ion. The ionization potential of magnesium is lower than the first excitation state of argon, so the positive charge in MgAr+ will reside on the magnesium atom."},"fame":2,"pubchemCid":null,"mass":null,"charge":0,"smiles":null,"inchikey":null,"iupac":null,"classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":null,"structure":null,"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q30589280","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Magnesium_argide","license":"CC BY-SA 4.0"}],"similar":[{"id":"Q129261","formula":"Al·Mg","names":{"en":"Elektron","ru":"Электрон (сплав)","uk":"Електрон"},"elements":["Mg","Al"],"fame":17,"kind":"crystal"},{"id":"Q12528782","formula":"Al·Mg","names":{"en":"Aluminium-magnesium alloy"},"elements":["Mg","Al"],"fame":3,"kind":"crystal"},{"id":"Q425036","formula":"Mg₃N₂","names":{"en":"Magnesium nitride","ru":"Нитрид магния","uk":"Нітрид магнію"},"elements":["N","Mg"],"fame":23,"kind":"crystal"},{"id":"Q421028","formula":"Mg₂Si","names":{"en":"Magnesium silicide","ru":"Силицид магния"},"elements":["Mg","Si"],"fame":20,"kind":"crystal"},{"id":"Q28719795","formula":"Na₂He","names":{"en":"Disodium helide"},"elements":["He","Na"],"fame":9,"kind":null},{"id":"Q4321622","formula":"Mn₄N","names":{"ru":"Нитрид тетрамарганца"},"elements":["N","Mn"],"fame":1,"kind":"crystal"},{"id":"Q945146","formula":"Mn₅N₂","names":{"en":"Pentamanganese dinitride","ru":"Динитри
{"version":"2026.10.11-r25","id":"Q24884525","formula":"C₂₆H₃₈O₅","hill":"C26H38O5","elements":["H","C","O"],"composition":{"C":26.0,"H":38.0,"O":5.0},"names":{"en":"Edogestrone"},"descriptions":{"en":"Edogestrone (INNTooltip International Nonproprietary Name, BANTooltip British Approved Name; development code PH-218; also known as edogesterone or 17α-acetoxy-3,3-ethylenedioxy-6-methylpregn-5-en-20-one) is a steroidal progestin and antiandrogen of the 17α-hydroxyprogesterone group which was synthesized in 1964 but was never marketed. Similarly to the structurally related steroid cyproterone acetate, edogestrone binds directly to the androgen receptor and antagonizes it, displacing androgens like testosterone from the receptor, though not as potently as cyproterone acetate."},"fame":1,"pubchemCid":20055315,"mass":430.6,"charge":0,"smiles":"CC1=C2CC3(CC[C@@]2([C@H]4CC[C@]5([C@H]([C@@H]4C1)CC[C@@]5(C(=O)C)OC(=O)C)C)C)OCCO3","inchikey":"UOYMGHSCINLOBK-ZKKYLISVSA-N","iupac":"[(8'R,9'S,10'R,13'S,14'S,17'R)-17'-acetyl-6',10',13'-trimethylspiro[1,3-dioxolane-2,3'-2,4,7,8,9,11,12,14,15,16-decahydro-1H-cyclopenta[a]phenanthrene]-17'-yl] acetate","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"20055315","atoms":69,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":3.898,"y":-0.366,"z":-1.264,"el":"O"},{"x":-4.883,"y":-0.589,"z":-1.424,"el":"O"},{"x":-6.368,"y":0.565,"z":-0.02,"el":"O"},{"x":5.838,"y":0.691,"z":1.119,"el":"O"},{"x":5.971,"y":-1.285,"z":-0.824,"el":"O"},{"x":2.388,"y":0.646,"z":0.419,"el":"C"},{"x":1.557,"y":-0.653,"z":0.499,"el":"C"},{"x":0.097,"y":-0.424,"z":0.913,"el":"C"},{"x":-0.585,"y":0.558,"z":-0.072,"el":"C"},{"x":-2.075,"y":0.855,"z":0.364,"el":"C"},{"x":3.781,"y":0.045,"z":0.095,"el":"C"},{"x":1.741,"y":1.524,"z":-0.665,"el":"C"},{"x":0.268,"y":1.828,"z":-0.342,"el":"C"},{"
{"version":"2026.10.11-r25","id":"Q6951380","formula":"C₉H₁₃N","hill":"C9H13N","elements":["H","C","N"],"composition":{"C":9.0,"H":13.0,"N":1.0},"names":{"en":"N-methylphenethylamine"},"descriptions":{"en":"N-Methylphenethylamine (NMPEA) is a naturally occurring trace amine neuromodulator in humans that is derived from the trace amine, phenethylamine (PEA). It has been detected in human urine (<1 μg over 24 hours) and is produced by phenylethanolamine N-methyltransferase with phenethylamine as a substrate, which significantly increases PEA's effects. PEA breaks down into phenylacetaldehyde which is further broken down into phenylacetic acid by monoamine oxidase."},"fame":11,"pubchemCid":11503,"mass":135.21,"charge":0,"smiles":"CNCCC1=CC=CC=C1","inchikey":"SASNBVQSOZSTPD-UHFFFAOYSA-N","iupac":"N-methyl-2-phenylethanamine","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"11503","atoms":23,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":3.348,"y":-0.013,"z":-0.282,"el":"N"},{"x":0.96,"y":-0.03,"z":-0.922,"el":"C"},{"x":1.98,"y":-0.021,"z":0.223,"el":"C"},{"x":-0.449,"y":-0.013,"z":-0.431,"el":"C"},{"x":-1.116,"y":-1.212,"z":-0.184,"el":"C"},{"x":-1.098,"y":1.204,"z":-0.219,"el":"C"},{"x":-2.433,"y":-1.196,"z":0.275,"el":"C"},{"x":-2.415,"y":1.22,"z":0.24,"el":"C"},{"x":4.306,"y":0.041,"z":0.813,"el":"C"},{"x":-3.083,"y":0.02,"z":0.487,"el":"C"},{"x":1.118,"y":-0.913,"z":-1.556,"el":"H"},{"x":1.127,"y":0.834,"z":-1.579,"el":"H"},{"x":1.823,"y":-0.906,"z":0.853,"el":"H"},{"x":1.808,"y":0.862,"z":0.853,"el":"H"},{"x":3.483,"y":0.795,"z":-0.889,"el":"H"},{"x":-0.621,"y":-2.166,"z":-0.344,"el":"H"},{"x":-0.588,"y":2.145,"z":-0.405,"el":"H"},{"x":-2.953,"y":-2.13,"z":0.467,"el":"H"},{"x":-2.921,"y":2.167,"z":0.406,"el":"H"},{"x":4.187,"y":0.953,"z":1.407,"el":"H"},{"x":5.323,"y":0.034,"z":0.408,
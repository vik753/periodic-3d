{"version":"2026.10.11-r25","id":"Q3631555","formula":"Mg₂(Ti₀.₅Mg₀.₅)O₂(BO₃)","hill":"BMg2.5O5Ti0.5","elements":["B","O","Mg","Ti"],"composition":{"B":1.0,"O":5.0,"Mg":2.5,"Ti":0.5},"names":{"en":"Azoproite","uk":"Азопроїт"},"descriptions":{"en":"Azoproite is a rare manganese iron borate mineral with the chemical formula (Mg,Fe2+)2(Fe3+,Ti,Mg)(BO3)O2. It was first identified near Lake Baikal, Russia. It was named after the Association pour l'Etude Géologique des Zones Profondes de l'Ecorce Terrestre, whose acronym is AZOPRO in French.","uk":"Азопроїт — рідкісний марганцево-залізоборатний мінерал із хімічною формулою (Mg, Fe2+)2(Fe3+,Ti, Mg)(BO3)O2. Вперше його виявили біля озера Байкал. Названий на честь Асоціації з досліджень глибинних зон земної кори, спонсорованих Міжнародною геологічною асоціацією у 1969 році (абревіатура фр."},"fame":8,"pubchemCid":null,"mass":null,"charge":0,"smiles":null,"inchikey":null,"iupac":null,"classes":[{"qid":"Q12089225","names":{"en":"mineral species","ru":"действительный вид минералов","uk":"мінеральний вид"}}],"structureInfo":null,"structure":null,"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q3631555","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Azoproite","license":"CC BY-SA 4.0"},{"role":"description","name":"Wikipedia (uk)","url":"https://uk.wikipedia.org/wiki/%D0%90%D0%B7%D0%BE%D0%BF%D1%80%D0%BE%D1%97%D1%82","license":"CC BY-SA 4.0"},{"role":"photo","name":"Wikimedia Commons","url":"https://commons.wikimedia.org/wiki/File:Azoproite.jpg","license":"CC BY-SA 4.0"}],"similar":[{"id":"Q3816643","formula":"Mg₃(BO₃)₂","names":{"en":"Kotoite","uk":"Котоїт"},"elements":["B","O","Mg"],"fame":7,"kind":"crystal"},{"id":"Q17373925","formula":"B₂Mg₃O₆","names":{"en":"Magnesium borate","ru":"Ортоборат магния"},"elements":["B","O","Mg"],"fame":1,"kind":"crystal"},{"id":"Q2424234","formula":"Mg₂FeO₂(BO₃)","names":{"en":"Ludwigite","uk":"Людвігіт
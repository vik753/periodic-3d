{"version":"2026.10.11-r25","id":"Q133578763","formula":"C₁₂H₁₃BrN₂O","hill":"C12H13BrN2O","elements":["H","C","N","O","Br"],"composition":{"C":12.0,"H":13.0,"N":2.0,"O":1.0,"Br":1.0},"names":{"en":"BK-5Br-NM-AMT"},"descriptions":{"en":"BK-5Br-NM-AMT, or βk-5Br-NM-αMT, also known as β-keto-5-bromo-N-methyl-αMT or α,N-dimethyl-5-bromo-β-ketotryptamine, is a monoamine releasing agent of the tryptamine, α-alkyltryptamine, and β-ketotryptamine families. It is known to induce the release of serotonin and dopamine, with respective EC50Tooltip half-maximal effective concentration values of 295 nM and 2,100 nM in rat brain synaptosomes, whereas norepinephrine release was not reported. In contrast to many other tryptamines, the drug is inactive as an agonist of serotonin receptors including the 5-HT1, 5-HT2, and 5-HT3 receptors."},"fame":2,"pubchemCid":162765532,"mass":281.15,"charge":0,"smiles":"CC(C(=O)C1=CNC2=C1C=C(C=C2)Br)NC","inchikey":"WOUHPASMWLAZGG-UHFFFAOYSA-N","iupac":"1-(5-bromo-1H-indol-3-yl)-2-(methylamino)propan-1-one","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"rdkit","ref":"162765532","atoms":29,"license":"Computed with RDKit from SMILES (PubChem, Wikidata)"},"structure":{"kind":"molecule","atoms":[{"x":1.788,"y":-1.459,"z":1.51,"el":"C"},{"x":1.847,"y":-0.249,"z":0.581,"el":"C"},{"x":1.268,"y":-0.643,"z":-0.79,"el":"C"},{"x":2.021,"y":-1.091,"z":-1.663,"el":"O"},{"x":-0.171,"y":-0.491,"z":-1.065,"el":"C"},{"x":-0.69,"y":-0.707,"z":-2.333,"el":"C"},{"x":-2.035,"y":-0.488,"z":-2.31,"el":"N"},{"x":-2.431,"y":-0.137,"z":-1.043,"el":"C"},{"x":-1.29,"y":-0.133,"z":-0.229,"el":"C"},{"x":-1.475,"y":0.188,"z":1.136,"el":"C"},{"x":-2.755,"y":0.496,"z":1.616,"el":"C"},{"x":-3.86,"y":0.49,"z":0.776,"el":"C"},{"x":-3.716,"y":0.17,"z":-0.574,"el":"C"},{"x":-2.979,"y":0.925,"z":3.446,"el":"Br"},{"x":3.273,"y":0.157,"z":0.46,"el":"N"},{"x":3
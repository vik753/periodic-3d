{"version":"2026.10.11-r25","id":"Q6460405","formula":"C₁₄H₁₇ClN₂O₂","hill":"C14H17ClN2O2","elements":["H","C","N","O","Cl"],"composition":{"C":14.0,"H":17.0,"N":2.0,"O":2.0,"Cl":1.0},"names":{"en":"LY-156735"},"descriptions":{"en":"TIK-301, also known as LY-156735 or PD-6735 or as β-methyl-6-chloromelatonin, is an agonist for the melatonin receptors MT1 and MT2 that is under development for the treatment of insomnia and other sleep disorders. Its agonist action on MT1 and MT2 receptors in the suprachiasmatic nucleus in the brain enables its action as a chronobiotic. It is in the same class of melatonin receptor agonists as ramelteon and tasimelteon."},"fame":2,"pubchemCid":219018,"mass":280.75,"charge":0,"smiles":"C[C@@H](CNC(=O)C)C1=CNC2=CC(=C(C=C21)OC)Cl","inchikey":"RKHCTAKUYDTFHE-QMMMGPOBSA-N","iupac":"N-[(2R)-2-(6-chloro-5-methoxy-1H-indol-3-yl)propyl]acetamide","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"219018","atoms":36,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-4.643,"y":-0.576,"z":0.383,"el":"Cl"},{"x":-2.349,"y":-2.193,"z":-0.658,"el":"O"},{"x":3.21,"y":-2.284,"z":-0.428,"el":"O"},{"x":-0.788,"y":2.918,"z":0.567,"el":"N"},{"x":2.353,"y":-0.669,"z":1.014,"el":"N"},{"x":2.144,"y":1.131,"z":-0.674,"el":"C"},{"x":0.823,"y":1.609,"z":-0.217,"el":"C"},{"x":-0.381,"y":0.852,"z":-0.17,"el":"C"},{"x":3.006,"y":0.478,"z":0.441,"el":"C"},{"x":-1.377,"y":1.697,"z":0.325,"el":"C"},{"x":0.541,"y":2.874,"z":0.243,"el":"C"},{"x":2.98,"y":2.234,"z":-1.366,"el":"C"},{"x":-0.721,"y":-0.474,"z":-0.503,"el":"C"},{"x":-2.701,"y":1.28,"z":0.505,"el":"C"},{"x":-2.042,"y":-0.905,"z":-0.328,"el":"C"},{"x":-3.014,"y":-0.039,"z":0.168,"el":"C"},{"x":2.511,"y":-1.959,"z":0.528,"el":"C"},{"x":1.736,"y":-2.973,"z":1.327,"el":"C"},{"x":-1.288,"y":-3.003,"z":-1.157,"el":"C"},{"x":1.973,"y":0.365
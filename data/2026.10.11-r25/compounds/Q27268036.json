{"version":"2026.10.11-r25","id":"Q27268036","formula":"C₁₈H₂₀O₂","hill":"C18H20O2","elements":["H","C","O"],"composition":{"C":18.0,"H":20.0,"O":2.0},"names":{"en":"8,9-Dehydroestrone"},"descriptions":{"en":"8,9-Dehydroestrone, or Δ8-estrone, also known as estra-1,3,5(10),8-tetraen-3-ol-17-one, is a naturally occurring estrogen found in horses which is closely related to equilin, equilenin, and estrone, and, as the 3-sulfate ester sodium salt, is a minor constituent (3.5%) of conjugated estrogens (Premarin). It produces 8,9-dehydro-17β-estradiol as an important active metabolite, analogously to conversion of estrone or estrone sulfate into estradiol. The compound was first described in 1997."},"fame":2,"pubchemCid":6451472,"mass":268.3,"charge":0,"smiles":"C[C@]12CCC3=C([C@@H]1CCC2=O)CCC4=C3C=CC(=C4)O","inchikey":"OUGSRCWSHMWPQE-WMZOPIPTSA-N","iupac":"(13S,14S)-3-hydroxy-13-methyl-7,11,12,14,15,16-hexahydro-6H-cyclopenta[a]phenanthren-17-one","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"6451472","atoms":40,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-4.956,"y":-1.107,"z":-0.26,"el":"O"},{"x":5.836,"y":-0.162,"z":0.299,"el":"O"},{"x":-2.612,"y":-0.62,"z":0.163,"el":"C"},{"x":-2.005,"y":0.724,"z":-0.304,"el":"C"},{"x":-2.007,"y":-1.704,"z":-0.719,"el":"C"},{"x":-2.912,"y":1.768,"z":0.349,"el":"C"},{"x":-0.507,"y":0.752,"z":-0.155,"el":"C"},{"x":-4.075,"y":-0.285,"z":-0.046,"el":"C"},{"x":-4.32,"y":1.21,"z":0.081,"el":"C"},{"x":-0.473,"y":-1.741,"z":-0.546,"el":"C"},{"x":0.201,"y":-0.396,"z":-0.288,"el":"C"},{"x":-2.441,"y":-0.945,"z":1.66,"el":"C"},{"x":0.146,"y":2.086,"z":0.086,"el":"C"},{"x":1.68,"y":-0.357,"z":-0.127,"el":"C"},{"x":1.584,"y":2.151,"z":-0.425,"el":"C"},{"x":2.35,"y":0.884,"z":-0.157,"el":"C"},{"x":2.447,"y":-1.52,"z":0.051,"el":"C"},{"x":3.746,"y":0.941,"z":-0.
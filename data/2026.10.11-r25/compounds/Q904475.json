{"version":"2026.10.11-r25","id":"Q904475","formula":"C₂₉H₄₀N₂O₉","hill":"C29H40N2O9","elements":["H","C","N","O"],"composition":{"C":29.0,"H":40.0,"N":2.0,"O":9.0},"names":{"en":"Geldanamycin"},"descriptions":{"en":"Geldanamycin is a 1,4-benzoquinone ansamycin antitumor antibiotic that inhibits the function of Hsp90 (Heat Shock Protein 90) by binding to the unusual ADP/ATP-binding pocket of the protein. HSP90 client proteins play important roles in the regulation of the cell cycle, cell growth, cell survival, apoptosis, angiogenesis and oncogenesis. Geldanamycin induces the degradation of proteins that are mutated or overexpressed in tumor cells such as v-Src, Bcr-Abl, p53, and ERBB2."},"fame":11,"pubchemCid":5288382,"mass":560.6,"charge":0,"smiles":"C[C@H]1C[C@@H]([C@@H]([C@H](/C=C(/[C@@H]([C@H](/C=C\\C=C(\\C(=O)NC2=CC(=O)C(=C(C1)C2=O)OC)/C)OC)OC(=O)N)\\C)C)O)OC","inchikey":"QTQAWLPCGQOSGP-KSRBKZBZSA-N","iupac":"[(4E,6Z,8S,9S,10E,12S,13R,14S,16R)-13-hydroxy-8,14,19-trimethoxy-4,10,12,16-tetramethyl-3,20,22-trioxo-2-azabicyclo[16.3.1]docosa-1(21),4,6,10,18-pentaen-9-yl] carbamate","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"5288382","atoms":80,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-1.2,"y":3.269,"z":-2.065,"el":"O"},{"x":1.514,"y":4.016,"z":-2.018,"el":"O"},{"x":3.725,"y":0.474,"z":1.796,"el":"O"},{"x":-5.623,"y":0.598,"z":1.102,"el":"O"},{"x":4.842,"y":-1.843,"z":1.009,"el":"O"},{"x":-1.028,"y":-0.42,"z":1.56,"el":"O"},{"x":-5.848,"y":-2.042,"z":0.298,"el":"O"},{"x":2.346,"y":2.316,"z":1.728,"el":"O"},{"x":-1.797,"y":-4.512,"z":-1.139,"el":"O"},{"x":-1.126,"y":-2.456,"z":-0.242,"el":"N"},{"x":4.354,"y":2.36,"z":2.848,"el":"N"},{"x":-0.472,"y":3.318,"z":-0.842,"el":"C"},{"x":-1.078,"y":2.356,"z":0.19,"el":"C"},{"x":-2.516,"y":2.672,"z":0.672,"el":"C"},{"x":1.035,"y":3.05
{"version":"2026.10.11-r25","id":"Q27264667","formula":"C₄H₈OS","hill":"C4H8OS","elements":["H","C","O","S"],"composition":{"C":4.0,"H":8.0,"O":1.0,"S":1.0},"names":{"en":"S-ethyl thiolacetate"},"descriptions":{"en":"S-Ethyl thioacetate is the organosulfur compound with the formula CH3C(O)SC2H5. It is an ethyl ester of thioacetic acid. The compound is traditionally prepared by alkylation of potassium thioacetate and thiolation of acetyl chloride: CH3COSK + C2H5Br → CH3C(O)SC2H5 + KBr CH3COCl + C2H5SH → CH3C(O)SC2H5 + HCl The compound has been well studied in part as a model for biologically relevant thioesters, such as Coenzyme A. H-D exchange of the methyl group has been examined in aqueous solution."},"fame":7,"pubchemCid":61171,"mass":104.17,"charge":0,"smiles":"CCSC(=O)C","inchikey":"APTGPWJUOYMUCE-UHFFFAOYSA-N","iupac":"S-ethyl ethanethioate","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"61171","atoms":14,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-0.297,"y":0.887,"z":-0.008,"el":"S"},{"x":1.173,"y":-1.307,"z":0.003,"el":"O"},{"x":-1.548,"y":-0.416,"z":-0.012,"el":"C"},{"x":-2.941,"y":0.183,"z":0.012,"el":"C"},{"x":1.176,"y":-0.082,"z":0.0,"el":"C"},{"x":2.437,"y":0.735,"z":0.005,"el":"C"},{"x":-1.428,"y":-1.033,"z":-0.908,"el":"H"},{"x":-1.411,"y":-1.056,"z":0.866,"el":"H"},{"x":-3.105,"y":0.787,"z":0.911,"el":"H"},{"x":-3.125,"y":0.811,"z":-0.867,"el":"H"},{"x":-3.69,"y":-0.616,"z":0.01,"el":"H"},{"x":2.481,"y":1.357,"z":0.902,"el":"H"},{"x":2.488,"y":1.358,"z":-0.892,"el":"H"},{"x":3.301,"y":0.064,"z":0.007,"el":"H"}],"bonds":[[0,2,1],[0,4,1],[1,4,2],[2,3,1],[2,6,1],[2,7,1],[3,8,1],[3,9,1],[3,10,1],[4,5,1],[5,11,1],[5,12,1],[5,13,1]]},"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q27264667","license":"CC0 1.0"},{"role":"description"
{"version":"2026.10.11-r25","id":"Q27113993","formula":"C₆H₆N₂O₂","hill":"C6H6N2O2","elements":["H","C","N","O"],"composition":{"C":6.0,"H":6.0,"N":2.0,"O":2.0},"names":{"en":"Cis-urocanic acid"},"descriptions":{"en":"cis-Urocanic acid (cis-UCA), also known as (Z)-imidazole-4-acrylic acid, is a chemical compound produced by ultraviolet (UV) irradiation of trans-urocanic acid, a metabolite naturally formed in the body from the amino acid histidine. cis-Urocanic acid is suspected of involvement in the development of skin cancer. It acts as an immunosuppressant through action as an agonist of the serotonin 5-HT2A receptor, which it binds to with relatively high affinity (Kd = 4.6 nM), and blocking this receptor has been shown to reduce cis-UCA mediated photocarcinogenesis."},"fame":2,"pubchemCid":1549103,"mass":138.12,"charge":0,"smiles":"C1=C(NC=N1)/C=C\\C(=O)O","inchikey":"LOIYMIARKYCTBW-UPHRSURJSA-N","iupac":"(Z)-3-(1H-imidazol-5-yl)prop-2-enoic acid","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"1549103","atoms":16,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":3.307,"y":-0.587,"z":-0.086,"el":"O"},{"x":1.149,"y":-1.32,"z":0.003,"el":"O"},{"x":-1.349,"y":0.324,"z":-1.055,"el":"N"},{"x":-2.516,"y":-0.691,"z":0.539,"el":"N"},{"x":-0.738,"y":0.651,"z":0.122,"el":"C"},{"x":0.393,"y":1.476,"z":0.107,"el":"C"},{"x":-1.476,"y":0.014,"z":1.091,"el":"C"},{"x":-2.412,"y":-0.483,"z":-0.755,"el":"C"},{"x":1.677,"y":1.032,"z":0.045,"el":"C"},{"x":1.966,"y":-0.416,"z":-0.012,"el":"C"},{"x":-1.073,"y":0.619,"z":-1.982,"el":"H"},{"x":0.229,"y":2.551,"z":0.144,"el":"H"},{"x":-1.314,"y":0.023,"z":2.16,"el":"H"},{"x":-3.063,"y":-0.883,"z":-1.518,"el":"H"},{"x":2.501,"y":1.736,"z":0.035,"el":"H"},{"x":3.554,"y":-1.536,"z":-0.126,"el":"H"}],"bonds":[[0,9,1],[0,15,1],[1,9,2],[2,4,1],[2,7,1],[2,10,1],[3,
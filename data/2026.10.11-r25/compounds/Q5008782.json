{"version":"2026.10.11-r25","id":"Q5008782","formula":"C₂₁H₂₉NO₃","hill":"C21H29NO3","elements":["H","C","N","O"],"composition":{"C":21.0,"H":29.0,"N":1.0,"O":3.0},"names":{"en":"CAR-301,060"},"descriptions":{"en":"CAR-301,060 (also known as cis-2-Methyl-3-quinuclidinylphenylcyclopentylglycolate or just by its code number 301060) is a potent and long lasting anticholinergic deliriant drug, related to the chemical warfare agent 3-Quinuclidinyl benzilate (QNB). It was developed under contract to Edgewood Arsenal, Fort Detrick,Maryland during the 1960s as part of the US military chemical weapons program, during research to improve upon the properties of earlier agents such as QNB. CAR-301,060 was found to be slightly less potent than QNB, and with around the same duration of action, but with a very high central to peripheral effects ratio."},"fame":3,"pubchemCid":44149220,"mass":343.5,"charge":0,"smiles":"C[C@@H]1[C@@H](C2CCN1CC2)OC(=O)C(C3CCCC3)(C4=CC=CC=C4)O","inchikey":"ICYFZPARHUFDKQ-GAKLZJQJSA-N","iupac":"[(2R,3R)-2-methyl-1-azabicyclo[2.2.2]octan-3-yl] 2-cyclopentyl-2-hydroxy-2-phenylacetate","classes":[{"qid":"Q59199015","names":{"en":"group of stereoisomers","ru":"группа стереоизомеров","uk":"група стереоізомерів"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"44149220","atoms":54,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-0.693,"y":0.201,"z":0.331,"el":"O"},{"x":2.428,"y":-0.883,"z":1.751,"el":"O"},{"x":-0.13,"y":-0.58,"z":2.425,"el":"O"},{"x":-3.905,"y":1.018,"z":-0.79,"el":"N"},{"x":-2.817,"y":-0.928,"z":0.544,"el":"C"},{"x":-2.037,"y":0.385,"z":0.758,"el":"C"},{"x":-2.761,"y":1.538,"z":0.012,"el":"C"},{"x":-4.266,"y":-0.694,"z":0.996,"el":"C"},{"x":-2.843,"y":-1.238,"z":-0.962,"el":"C"},{"x":-4.893,"y":0.42,"z":0.141,"el":"C"},{"x":-3.45,"y":-0.045,"z":-1.715,"el":"C"},{"x":1.552,"y":-1.563,"z":-0.342,"el":"C"},{"x":1.575,"y":-0.447,"z":0.688,"el":"C"},{"x":-1.851,"y":2.438,"z":-0.828,"el":"C"},{"x
{"version":"2026.10.11-r25","id":"Q4634055","formula":"C₉H₁₁Cl₂N","hill":"C9H11Cl2N","elements":["H","C","N","Cl"],"composition":{"C":9.0,"H":11.0,"N":1.0,"Cl":2.0},"names":{"en":"3,4-dichloroamphetamine"},"descriptions":{"en":"3,4-Dichloroamphetamine (3,4-DCA), is an amphetamine derived drug invented by Eli Lilly in the 1960s, which has a number of pharmacological actions. It acts as a highly potent and selective serotonin releasing agent (SSRA) and binds to the serotonin transporter with high affinity, but also acts as a selective serotonergic neurotoxin in a similar manner to the related para-chloroamphetamine (PCA), though with slightly lower potency. It is also a monoamine oxidase inhibitor (MAOI), as well as a very potent inhibitor of the enzyme phenylethanolamine N-methyl transferase which normally functions to transform noradrenaline into adrenaline in the body."},"fame":4,"pubchemCid":17535,"mass":204.09,"charge":0,"smiles":"CC(CC1=CC(=C(C=C1)Cl)Cl)N","inchikey":"PUFDZMUCDFIRQY-UHFFFAOYSA-N","iupac":"1-(3,4-dichlorophenyl)propan-2-amine","classes":[{"qid":"Q59199015","names":{"en":"group of stereoisomers","ru":"группа стереоизомеров","uk":"група стереоізомерів"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"17535","atoms":23,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-2.491,"y":-2.264,"z":-0.274,"el":"Cl"},{"x":-3.905,"y":0.516,"z":0.584,"el":"Cl"},{"x":4.256,"y":0.131,"z":-0.041,"el":"N"},{"x":2.855,"y":0.094,"z":0.391,"el":"C"},{"x":1.936,"y":0.36,"z":-0.816,"el":"C"},{"x":0.474,"y":0.383,"z":-0.469,"el":"C"},{"x":2.591,"y":-1.262,"z":1.045,"el":"C"},{"x":-0.262,"y":-0.794,"z":-0.52,"el":"C"},{"x":-0.125,"y":1.581,"z":-0.1,"el":"C"},{"x":-1.619,"y":-0.773,"z":-0.197,"el":"C"},{"x":-1.482,"y":1.602,"z":0.223,"el":"C"},{"x":-2.229,"y":0.425,"z":0.174,"el":"C"},{"x":2.711,"y":0.877,"z":1.145,"el":"H"},{"x":2.108,"y":-0.394,"z":-1.597,"el":"H"},{"x":2.204,"y":1.319,"z":-1.281,"el":"H"},{"x":3.333,"y":
{"version":"2026.10.11-r25","id":"Q15425266","formula":"C₁₆H₁₁F₃O","hill":"C16H11F3O","elements":["H","C","O","F"],"composition":{"C":16.0,"F":3.0,"H":11.0,"O":1.0},"names":{"en":"Pirkle's alcohol"},"descriptions":{"en":"Pirkle's alcohol is an off-white, crystalline solid that is stable at room temperature when protected from light and oxygen. This chiral molecule is typically used, in nonracemic form, as a chiral shift reagent in nuclear magnetic resonance spectroscopy, in order to simultaneously determine absolute configuration and enantiomeric purity of other chiral molecules. The molecule is named after William H. Pirkle, Professor of Chemistry at the University of Illinois whose group reported its synthesis and its application as a chiral shift reagent."},"fame":6,"pubchemCid":103802,"mass":276.25,"charge":0,"smiles":"C1=CC=C2C(=C1)C=C3C=CC=CC3=C2C(C(F)(F)F)O","inchikey":"ICZHJFWIOPYQCA-UHFFFAOYSA-N","iupac":"1-anthracen-9-yl-2,2,2-trifluoroethanol","classes":[{"qid":"Q59199015","names":{"en":"group of stereoisomers","ru":"группа стереоизомеров","uk":"група стереоізомерів"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"103802","atoms":31,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-0.692,"y":2.629,"z":1.207,"el":"F"},{"x":0.689,"y":3.875,"z":0.076,"el":"F"},{"x":1.449,"y":2.197,"z":1.244,"el":"F"},{"x":1.427,"y":1.786,"z":-1.574,"el":"O"},{"x":-0.009,"y":0.272,"z":-0.389,"el":"C"},{"x":-1.335,"y":-0.168,"z":-0.246,"el":"C"},{"x":1.076,"y":-0.6,"z":-0.194,"el":"C"},{"x":0.257,"y":1.706,"z":-0.76,"el":"C"},{"x":-1.584,"y":-1.514,"z":0.102,"el":"C"},{"x":0.827,"y":-1.946,"z":0.153,"el":"C"},{"x":-0.5,"y":-2.385,"z":0.296,"el":"C"},{"x":-2.42,"y":0.703,"z":-0.441,"el":"C"},{"x":2.403,"y":-0.162,"z":-0.337,"el":"C"},{"x":0.43,"y":2.602,"z":0.456,"el":"C"},{"x":-2.911,"y":-1.952,"z":0.245,"el":"C"},{"x":1.912,"y":-2.817,"z":0.348,"el":"C"},{"x":-3.732,"y":0.252,"z":-0.295,"el":"C"},{"x":3.469,"y":-1.04,"z":-0.
{"version":"2026.10.11-r25","id":"Q82900522","formula":"C₁₉H₂₀N₂O₄","hill":"C19H20N2O4","elements":["H","C","N","O"],"composition":{"C":19.0,"H":20.0,"N":2.0,"O":4.0},"names":{"en":"5-(2,3-Dihydro-1-benzofuran-7-yl)-3-methyl-8-nitro-2,3,4,5-tetrahydro-1H-3-benzazepin-7-ol"},"descriptions":{"en":"NNC 01-0687 (also known as ADX-10061, CEE-03-310, or NNC-687) is a selective dopamine D1-like receptor antagonist of the benzazepine group which was under development as an experimental antipsychotic for the treatment of schizophrenia but was never marketed. Its development for schizophrenia was discontinued due to lack of effectiveness in clinical trials. Subsequently, NNC 01-0687 was developed under the code name ADX-10061 for treatment of substance dependence and was studied for smoking cessation, alcohol dependence, and cocaine dependence."},"fame":1,"pubchemCid":164252,"mass":340.4,"charge":0,"smiles":"CN1CCC2=CC(=C(C=C2[C@H](C1)C3=CC=CC4=C3OCC4)O)[N+](=O)[O-]","inchikey":"XZPSYCOYKJRHKE-MRXNPFEDSA-N","iupac":"(5S)-5-(2,3-dihydro-1-benzofuran-7-yl)-3-methyl-8-nitro-1,2,4,5-tetrahydro-3-benzazepin-7-ol","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"164252","atoms":45,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-2.283,"y":-0.776,"z":-1.84,"el":"O"},{"x":2.171,"y":-2.705,"z":1.218,"el":"O"},{"x":5.354,"y":-0.89,"z":-0.568,"el":"O"},{"x":4.546,"y":-2.6,"z":0.546,"el":"O"},{"x":-0.242,"y":3.544,"z":-0.043,"el":"N"},{"x":4.402,"y":-1.485,"z":-0.009,"el":"N"},{"x":-0.788,"y":1.06,"z":-0.048,"el":"C"},{"x":-0.768,"y":2.404,"z":0.732,"el":"C"},{"x":0.579,"y":0.371,"z":-0.02,"el":"C"},{"x":-1.962,"y":0.176,"z":0.381,"el":"C"},{"x":1.69,"y":0.995,"z":-0.629,"el":"C"},{"x":1.2,"y":3.457,"z":-0.313,"el":"C"},{"x":1.569,"y":2.343,"z":-1.296,"el":"C"},{"x":-2.614,"y":-0.649,"z":-0.514,"el":"C"},{"x
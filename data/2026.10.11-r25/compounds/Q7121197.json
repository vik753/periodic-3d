{"version":"2026.10.11-r25","id":"Q7121197","formula":"C₁₄H₁₄ClN₃O₂","hill":"C14H14ClN3O2","elements":["H","C","N","O","Cl"],"composition":{"C":14.0,"H":14.0,"N":3.0,"O":2.0,"Cl":1.0},"names":{"en":"PWZ-029"},"descriptions":{"en":"PWZ-029 is a benzodiazepine derivative drug with nootropic effects developed by WiSys, It acts as a subtype-selective, mixed agonist-inverse agonist at the benzodiazepine binding site on the GABAA receptor, acting as a partial inverse agonist at the α5 subtype and a weak partial agonist at the α3 subtype. This gives it a mixed pharmacological profile, producing at low doses memory-enhancing effects but with no convulsant or anxiogenic effects or muscle weakness, although at higher doses it produces some sedative effects."},"fame":5,"pubchemCid":9971547,"mass":291.73,"charge":0,"smiles":"CN1CC2=C(N=CN2C3=C(C1=O)C=C(C=C3)Cl)COC","inchikey":"FXIDXTIMKAEBGY-UHFFFAOYSA-N","iupac":"8-chloro-3-(methoxymethyl)-5-methyl-4H-imidazo[1,5-a][1,4]benzodiazepin-6-one","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"9971547","atoms":34,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-5.525,"y":-0.544,"z":0.814,"el":"Cl"},{"x":4.454,"y":-0.595,"z":0.949,"el":"O"},{"x":-1.801,"y":2.615,"z":-0.926,"el":"O"},{"x":0.284,"y":-0.921,"z":-0.38,"el":"N"},{"x":0.218,"y":2.058,"z":0.06,"el":"N"},{"x":2.232,"y":-1.802,"z":-1.048,"el":"N"},{"x":1.278,"y":-0.061,"z":0.038,"el":"C"},{"x":1.005,"y":1.135,"z":0.859,"el":"C"},{"x":-1.105,"y":-0.776,"z":-0.144,"el":"C"},{"x":2.456,"y":-0.615,"z":-0.409,"el":"C"},{"x":-1.723,"y":0.483,"z":0.005,"el":"C"},{"x":-1.101,"y":1.804,"z":-0.317,"el":"C"},{"x":0.93,"y":-1.973,"z":-0.994,"el":"C"},{"x":3.829,"y":-0.11,"z":-0.245,"el":"C"},{"x":-1.879,"y":-1.945,"z":-0.034,"el":"C"},{"x":0.86,"y":3.311,"z":-0.315,"el":"C"},{"x":-3.097,"y":0.533,"z":0.305,
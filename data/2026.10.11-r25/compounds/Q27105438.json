{"version":"2026.10.11-r25","id":"Q27105438","formula":"C₂₇H₄₆O₃","hill":"C27H46O3","elements":["H","C","O"],"composition":{"C":27.0,"H":46.0,"O":3.0},"names":{"en":"(20R,22R)-20,22-dihydroxycholesterol"},"descriptions":{"en":"20α,22R-Dihydroxycholesterol, or (3β)-cholest-5-ene-3,20,22-triol is an endogenous, metabolic intermediate in the biosynthesis of the steroid hormones from cholesterol. Cholesterol ((3β)-cholest-5-en-3-ol) is hydroxylated by cholesterol side-chain cleavage enzyme (P450scc) to form 22R-hydroxycholesterol, which is subsequently hydroxylated again by P450scc to form 20α,22R-dihydroxycholesterol, and finally the bond between carbons 20 and 22 is cleaved by P450scc to form pregnenolone ((3β)-3-hydroxypregn-5-en-20-one), the precursor to the steroid hormones."},"fame":7,"pubchemCid":6453841,"mass":418.7,"charge":0,"smiles":"CC(C)CC[C@H]([C@@](C)([C@H]1CC[C@@H]2[C@@]1(CC[C@H]3[C@H]2CC=C4[C@@]3(CC[C@@H](C4)O)C)C)O)O","inchikey":"ISBSSBGEYIBVTO-TYKWNDPBSA-N","iupac":"(2R,3R)-2-[(3S,8S,9S,10R,13S,14S,17S)-3-hydroxy-10,13-dimethyl-2,3,4,7,8,9,11,12,14,15,16,17-dodecahydro-1H-cyclopenta[a]phenanthren-17-yl]-6-methylheptane-2,3-diol","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"6453841","atoms":76,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-2.851,"y":-2.638,"z":0.469,"el":"O"},{"x":-5.466,"y":-1.887,"z":-0.119,"el":"O"},{"x":7.923,"y":1.187,"z":-0.731,"el":"O"},{"x":-0.533,"y":-0.873,"z":0.092,"el":"C"},{"x":0.19,"y":0.148,"z":0.993,"el":"C"},{"x":1.706,"y":-0.06,"z":1.048,"el":"C"},{"x":2.295,"y":0.025,"z":-0.391,"el":"C"},{"x":-1.994,"y":-0.414,"z":0.32,"el":"C"},{"x":-0.013,"y":-0.674,"z":-1.339,"el":"C"},{"x":-0.605,"y":0.11,"z":2.295,"el":"C"},{"x":3.857,"y":-0.223,"z":-0.392,"el":"C"},{"x":1.514,"y":-0.847,"z":-1.412,"el":"C"},{"x":-2.056,"y":-0.134,"z":1.841,"e
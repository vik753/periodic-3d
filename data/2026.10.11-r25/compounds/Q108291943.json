{"version":"2026.10.11-r25","id":"Q108291943","formula":"C₁₈H₁₄ClN₃O₂S","hill":"C18H14ClN3O2S","elements":["H","C","N","O","S","Cl"],"composition":{"C":18.0,"H":14.0,"N":3.0,"O":2.0,"S":1.0,"Cl":1.0},"names":{"en":"S416"},"descriptions":{"en":"S416 (GTPL-11164) is a drug which acts as a selective inhibitor of the enzyme dihydroorotate dehydrogenase (DHODH). This enzyme is involved in the synthesis of pyrimidine nucleosides in the body, which are required for the synthesis of DNA and RNA. This is an important rate-limiting step in the replication of viruses, and so DHODH inhibitors may have applications as broad-spectrum antiviral drugs. In tests in vitro, S416 was found to have antiviral activity against a range of pathogenic RNA viruses including influenza, Zika virus, Ebola virus and SARS-CoV-2."},"fame":1,"pubchemCid":148568163,"mass":371.8,"charge":0,"smiles":"CN(C1=NC(=CS1)C2=CC=CC=C2Cl)/N=C\\C3=CC=CC=C3C(=O)O","inchikey":"MWIQPUXVXAVFRM-JMIUGGIZSA-N","iupac":"2-[(Z)-[[4-(2-chlorophenyl)-1,3-thiazol-2-yl]-methylhydrazinylidene]methyl]benzoic acid","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"rdkit","ref":"148568163","atoms":39,"license":"Computed with RDKit from SMILES (PubChem, Wikidata)"},"structure":{"kind":"molecule","atoms":[{"x":-0.816,"y":-1.194,"z":1.328,"el":"C"},{"x":-0.658,"y":0.25,"z":1.109,"el":"N"},{"x":0.645,"y":0.646,"z":0.896,"el":"C"},{"x":1.616,"y":-0.161,"z":0.509,"el":"N"},{"x":2.811,"y":0.519,"z":0.39,"el":"C"},{"x":2.75,"y":1.871,"z":0.646,"el":"C"},{"x":1.149,"y":2.303,"z":1.062,"el":"S"},{"x":4.032,"y":-0.161,"z":-0.001,"el":"C"},{"x":4.622,"y":0.162,"z":-1.234,"el":"C"},{"x":5.792,"y":-0.476,"z":-1.652,"el":"C"},{"x":6.384,"y":-1.444,"z":-0.844,"el":"C"},{"x":5.806,"y":-1.775,"z":0.383,"el":"C"},{"x":4.633,"y":-1.139,"z":0.806,"el":"C"},{"x":4.002,"y":-1.585,"z":2.355,"el":"Cl"},{"x":-1.532,"y":1.037,"z"
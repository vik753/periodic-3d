{"version":"2026.10.11-r25","id":"Q15411025","formula":"C₁₃H₁₂N₂O₃","hill":"C13H12N2O3","elements":["H","C","N","O"],"composition":{"C":13.0,"H":12.0,"N":2.0,"O":3.0},"names":{"en":"Indolyl-3-acryloylglycine"},"descriptions":{"en":"Indolyl-3-acryloylglycine, also known as trans-indolyl-3-acryloylglycine, or IAG for short, is a compound consisting of an indole group attached to an acrylic acid moiety, which is in turn attached to a glycine molecule. This compound has been shown to isomerize when exposed to light. It is likely a metabolic intermediate in the biosynthesis of tryptophan, and is synthesized from tryptophan via indolepropionic acid and indoleacrylicacid (IAcrA)."},"fame":5,"pubchemCid":5370648,"mass":244.25,"charge":0,"smiles":"C1=CC=C2C(=C1)C(=CN2)/C=C/C(=O)NCC(=O)O","inchikey":"DUIFVCFSAWHIOD-AATRIKPKSA-N","iupac":"2-[[(E)-3-(1H-indol-3-yl)prop-2-enoyl]amino]acetic acid","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"5370648","atoms":30,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-2.352,"y":1.436,"z":0.623,"el":"O"},{"x":-4.696,"y":-0.183,"z":-1.56,"el":"O"},{"x":-6.597,"y":0.542,"z":-0.556,"el":"O"},{"x":3.044,"y":-1.986,"z":-0.11,"el":"N"},{"x":-3.405,"y":-0.633,"z":0.665,"el":"N"},{"x":2.686,"y":0.213,"z":0.002,"el":"C"},{"x":3.675,"y":-0.763,"z":-0.143,"el":"C"},{"x":1.442,"y":-0.467,"z":0.124,"el":"C"},{"x":1.695,"y":-1.817,"z":0.051,"el":"C"},{"x":3.068,"y":1.57,"z":0.003,"el":"C"},{"x":5.03,"y":-0.449,"z":-0.29,"el":"C"},{"x":0.158,"y":0.097,"z":0.29,"el":"C"},{"x":4.42,"y":1.899,"z":-0.143,"el":"C"},{"x":5.385,"y":0.903,"z":-0.286,"el":"C"},{"x":-1.038,"y":-0.547,"z":0.402,"el":"C"},{"x":-2.311,"y":0.211,"z":0.574,"el":"C"},{"x":-4.752,"y":-0.138,"z":0.833,"el":"C"},{"x":-5.452,"y":0.113,"z":-0.478,"el":"C"},{"x":3.51,"y":-2.879,"z":-0.193,"el":"H"},{"x":1.048
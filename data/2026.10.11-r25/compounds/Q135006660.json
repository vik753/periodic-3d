{"version":"2026.10.11-r25","id":"Q135006660","formula":"C₂H₅OP","hill":"C2H5OP","elements":["H","C","O","P"],"composition":{"C":2.0,"H":5.0,"O":1.0,"P":1.0},"names":{"en":"Oxaphosphetane"},"descriptions":{"en":"An oxaphosphetane is a molecule containing a four-membered ring with one phosphorus, one oxygen and two carbon atoms. In a 1,2-oxaphosphetane phosphorus is bonded directly to oxygen, whereas a 1,3-oxaphosphetane has the phosphorus and oxygen atoms at opposite corners. 1,2-Oxaphosphetanes are rarely isolated but are important intermediates in the Wittig reaction and related reactions such as the Seyferth–Gilbert homologation and the Horner–Wadsworth–Emmons reaction."},"fame":3,"pubchemCid":null,"mass":null,"charge":0,"smiles":null,"inchikey":null,"iupac":null,"classes":[{"qid":"Q15711994","names":{"en":"group of isomeric entities","ru":"семейство химических соединений","uk":"родина хімічних сполук"}}],"structureInfo":null,"structure":null,"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q135006660","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Oxaphosphetane","license":"CC BY-SA 4.0"}],"similar":[{"id":"Q27280508","formula":"C₉H₂₁O₆P₃","names":{"en":"Propylphosphonic anhydride"},"elements":["H","C","O","P"],"fame":3,"kind":"molecule"},{"id":"Q135006602","formula":"C₂H₅OP","names":{"en":"1,3-oxaphosphetane"},"elements":["H","C","O","P"],"fame":1,"kind":"molecule"},{"id":"Q82541341","formula":"C₂H₅OP","names":{"en":"1,2-oxaphosphetane"},"elements":["H","C","O","P"],"fame":1,"kind":"molecule"},{"id":"Q166825","formula":"C₉H₂₃NO₇P₂","names":{"en":"Ibandronic acid","ru":"Ибандроновая кислота"},"elements":["H","C","N","O","P"],"fame":21,"kind":"molecule"},{"id":"Q418125","formula":"C₁₀H₂₀O₇P₂","names":{"en":"Geranyl diphosphate"},"elements":["H","C","O","P"],"fame":21,"kind":"molecule"},{"id":"Q933664","formula":"C₈H₂₀O₇P₂","names":{"en":"Tetraethyl pyrophosphate","ru":"Те
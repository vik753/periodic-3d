{"version":"2026.10.11-r25","id":"Q4550131","formula":"C₁₈H₃₀O₄","hill":"C18H30O4","elements":["H","C","O"],"composition":{"C":18.0,"H":30.0,"O":4.0},"names":{"en":"15,16-Dihydroxy-alpha-eleostearic acid"},"descriptions":{"en":"15,16-Dihydroxy-α-eleostearic acid, or 15,16-Dihydroxy-(9Z,11E,13E)-9,11,13-octadecatrienoic acid, is an organic compound with formula C18H30O4, or H3C-CH2-(-CH(OH)-)2(-CH=CH-)3-(-CH2-)7-(C=O)OH. It can be seen as derived from α-eleostearic acid by the replacement of two hydrogen atoms by two hydroxyl (OH) groups. The compound is found in the pulp and seeds of bitter melons (the fruits of Momordica charantia). It has been found to induce apoptosis in HL60 leukemia cells in vitro at a concentration of 160 μM, although it is less potent in this regard than the unsubstituted α-eleostearic acid (also found in the seed oil)."},"fame":4,"pubchemCid":25156647,"mass":310.4,"charge":0,"smiles":"CCC(C(/C=C/C=C/C=C\\CCCCCCCC(=O)O)O)O","inchikey":"OBMDTPZEEDLBKM-ZMLXCLEUSA-N","iupac":"(9Z,11E,13E)-15,16-dihydroxyoctadeca-9,11,13-trienoic acid","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"25156647","atoms":52,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-7.404,"y":0.554,"z":-0.377,"el":"O"},{"x":-5.274,"y":2.023,"z":-1.575,"el":"O"},{"x":8.764,"y":2.885,"z":0.441,"el":"O"},{"x":7.9,"y":2.091,"z":-1.511,"el":"O"},{"x":3.905,"y":-0.94,"z":-0.128,"el":"C"},{"x":2.922,"y":-1.692,"z":0.773,"el":"C"},{"x":4.908,"y":-0.132,"z":0.7,"el":"C"},{"x":1.874,"y":-2.494,"z":-0.004,"el":"C"},{"x":5.871,"y":0.646,"z":-0.201,"el":"C"},{"x":0.877,"y":-3.226,"z":0.899,"el":"C"},{"x":6.903,"y":1.439,"z":0.596,"el":"C"},{"x":-6.5,"y":1.329,"z":0.414,"el":"C"},{"x":-5.152,"y":1.335,"z":-0.33,"el":"C"},{"x":-7.097,"y":2.727,"z":0.644,"el":"C"},{"x":-0.082,"y":-4.051,"z":0.088,"el":"C"},{"x":7
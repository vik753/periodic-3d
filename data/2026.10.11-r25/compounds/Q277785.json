{"version":"2026.10.11-r25","id":"Q277785","formula":"C₁₉H₃₂N₂O₅","hill":"C19H32N2O5","elements":["H","C","N","O"],"composition":{"C":19.0,"H":32.0,"N":2.0,"O":5.0},"names":{"en":"Perindopril","ru":"Периндоприл","uk":"Периндоприл"},"descriptions":{"en":"Perindopril is a medication used to treat high blood pressure, heart failure, or stable coronary artery disease. As a long-acting ACE inhibitor, perindopril works by inhibiting production of the vasoconstriction hormone, angiotensin, thereby relaxing blood vessels, increasing urine output, and decreasing blood volume, leading to a reduction of blood pressure. It also increases blood renin activity and decreases aldosterone secretion, causing increased urine production and excretion of sodium.","ru":"Периндоприл — лекарственное средство, ингибитор ангиотензинпревращающего фермента (АПФ)."},"fame":28,"pubchemCid":107807,"mass":368.5,"charge":0,"smiles":"CCC[C@@H](C(=O)OCC)N[C@@H](C)C(=O)N1[C@H]2CCCC[C@H]2C[C@H]1C(=O)O","inchikey":"IPVQLZZIHOAWMC-QXKUPLGCSA-N","iupac":"(2S,3aS,7aS)-1-[(2S)-2-[[(2S)-1-ethoxy-1-oxopentan-2-yl]amino]propanoyl]-2,3,3a,4,5,6,7,7a-octahydroindole-2-carboxylic acid","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"107807","atoms":58,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-0.569,"y":2.37,"z":0.936,"el":"O"},{"x":-0.339,"y":-2.989,"z":0.53,"el":"O"},{"x":-0.294,"y":-1.371,"z":-1.076,"el":"O"},{"x":2.939,"y":-1.167,"z":-0.671,"el":"O"},{"x":3.692,"y":-0.75,"z":1.466,"el":"O"},{"x":-1.618,"y":0.325,"z":0.666,"el":"N"},{"x":1.724,"y":1.232,"z":1.609,"el":"N"},{"x":-3.908,"y":-0.163,"z":0.49,"el":"C"},{"x":-2.852,"y":0.878,"z":0.102,"el":"C"},{"x":-3.142,"y":-1.484,"z":0.371,"el":"C"},{"x":-1.731,"y":-1.126,"z":0.85,"el":"C"},{"x":-5.2,"y":-0.095,"z":-0.318,"el":"C"},{"x":-2.71,"y":1.096,"z":-1.409,"el":"C"},{"
{"version":"2026.10.11-r25","id":"Q7667802","formula":"C₄H₆O₃","hill":"C4H6O3","elements":["H","C","O"],"composition":{"C":4.0,"H":6.0,"O":3.0},"names":{"en":"T-HCA"},"descriptions":{"en":"trans-4-Hydroxycrotonic acid (T-HCA), also known as γ-hydroxycrotonic acid (GHC), is an agent used in scientific research to study the GHB receptor. It is an analogue of γ-hydroxybutyric acid (GHB), as well as an active metabolite of GHB. Similarly to GHB, T-HCA has been found to be endogenous to the rat central nervous system, and as a metabolite of GHB, is almost certain to be endogenous to humans as well. T-HCA binds to the high-affinity GHB receptor with 4-fold greater affinity than GHB itself, where it acts as an agonist, but does not bind to the low-affinity GHB binding site, the GABAB receptor."},"fame":4,"pubchemCid":6155526,"mass":102.09,"charge":0,"smiles":"C(/C=C/C(=O)O)O","inchikey":"RMQJECWPWQIIPW-OWOJBTEDSA-N","iupac":"(E)-4-hydroxybut-2-enoic acid","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"6155526","atoms":13,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-3.062,"y":0.206,"z":-0.579,"el":"O"},{"x":2.491,"y":-0.894,"z":-0.235,"el":"O"},{"x":1.82,"y":1.27,"z":0.032,"el":"O"},{"x":-2.222,"y":-0.333,"z":0.434,"el":"C"},{"x":-0.839,"y":0.219,"z":0.293,"el":"C"},{"x":0.241,"y":-0.547,"z":0.089,"el":"C"},{"x":1.571,"y":0.078,"z":-0.034,"el":"C"},{"x":-2.631,"y":-0.053,"z":1.41,"el":"H"},{"x":-2.238,"y":-1.425,"z":0.35,"el":"H"},{"x":-0.742,"y":1.299,"z":0.371,"el":"H"},{"x":0.164,"y":-1.626,"z":0.011,"el":"H"},{"x":-3.951,"y":-0.161,"z":-0.437,"el":"H"},{"x":3.397,"y":-0.53,"z":-0.325,"el":"H"}],"bonds":[[0,3,1],[0,11,1],[1,6,1],[1,12,1],[2,6,2],[3,4,1],[3,7,1],[3,8,1],[4,5,2],[4,9,1],[5,6,1],[5,10,1]]},"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wik
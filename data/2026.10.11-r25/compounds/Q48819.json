{"version":"2026.10.11-r25","id":"Q48819","formula":"C₂H₄N₂","hill":"C2H4N2","elements":["H","C","N"],"composition":{"C":2.0,"H":4.0,"N":2.0},"names":{"en":"Aminoacetonitrile"},"descriptions":{"en":"Aminoacetonitrile is the organic compound with the formula H2N−CH2−C≡N. The compound is a colorless liquid. It is unstable at room temperature, owing to the incompatibility of the amine nucleophile and the nitrile electrophile. For this reason it is usually encountered as the chloride and bisulfate salts of the ammonium derivative, i.e., [NCCH2NH3]+Cl− and [NCCH2NH3]+HSO4−."},"fame":15,"pubchemCid":10901,"mass":56.07,"charge":0,"smiles":"C(C#N)N","inchikey":"DFNYGALUNNFWKJ-UHFFFAOYSA-N","iupac":"2-aminoacetonitrile","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"10901","atoms":8,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":1.684,"y":0.483,"z":0.0,"el":"N"},{"x":-1.752,"y":0.257,"z":0.0,"el":"N"},{"x":0.726,"y":-0.615,"z":0.0,"el":"C"},{"x":-0.657,"y":-0.126,"z":0.0,"el":"C"},{"x":0.895,"y":-1.233,"z":0.887,"el":"H"},{"x":0.899,"y":-1.248,"z":-0.876,"el":"H"},{"x":1.601,"y":1.011,"z":-0.869,"el":"H"},{"x":2.63,"y":0.104,"z":0.009,"el":"H"}],"bonds":[[0,2,1],[0,6,1],[0,7,1],[1,3,3],[2,3,1],[2,4,1],[2,5,1]]},"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q48819","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Aminoacetonitrile","license":"CC BY-SA 4.0"},{"role":"properties","name":"PubChem","url":"https://pubchem.ncbi.nlm.nih.gov/compound/10901","license":"PubChem (NIH), public data"},{"role":"structure","name":"PubChem 3D","url":"https://pubchem.ncbi.nlm.nih.gov/compound/10901#section=3D-Conformer","license":"PubChem (NIH), public data"}],"similar":[{"id":"Q408047","formula":"C₂H₃N","names":{"en"
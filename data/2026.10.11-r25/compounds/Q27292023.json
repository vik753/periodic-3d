{"version":"2026.10.11-r25","id":"Q27292023","formula":"C₂₄H₃₂N₂O","hill":"C24H32N2O","elements":["H","C","N","O"],"composition":{"C":24.0,"H":32.0,"N":2.0,"O":1.0},"names":{"en":"Valerylfentanyl"},"descriptions":{"en":"Valerylfentanyl is an opioid analgesic that is an analog of fentanyl and has been sold online as a designer drug. It has been seldom reported on illicit markets and there is little information about it, though it is believed to be less potent than butyrfentanyl but more potent than benzylfentanyl. In one study, it fully substituted for oxycodone and produced antinociception and oxycodone-like discriminative stimulus effects comparable in potency to morphine in mice, but failed to stimulate locomotor activity in mice at doses up to 100 mg/kg."},"fame":4,"pubchemCid":21595398,"mass":364.5,"charge":0,"smiles":"CCCCC(=O)N(C1CCN(CC1)CCC2=CC=CC=C2)C3=CC=CC=C3","inchikey":"VCCPXHWAJYWQMR-UHFFFAOYSA-N","iupac":"N-phenyl-N-[1-(2-phenylethyl)piperidin-4-yl]pentanamide","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"21595398","atoms":59,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-2.142,"y":1.76,"z":-1.555,"el":"O"},{"x":1.733,"y":-0.264,"z":-0.478,"el":"N"},{"x":-2.5,"y":-0.266,"z":-0.386,"el":"N"},{"x":-1.144,"y":-0.73,"z":-0.226,"el":"C"},{"x":-0.424,"y":-0.782,"z":-1.573,"el":"C"},{"x":-0.372,"y":0.156,"z":0.751,"el":"C"},{"x":1.044,"y":-1.175,"z":-1.403,"el":"C"},{"x":1.095,"y":-0.269,"z":0.845,"el":"C"},{"x":3.147,"y":-0.623,"z":-0.366,"el":"C"},{"x":3.988,"y":0.588,"z":0.041,"el":"C"},{"x":-2.828,"y":1.056,"z":-0.81,"el":"C"},{"x":-3.574,"y":-1.179,"z":0.005,"el":"C"},{"x":-4.175,"y":1.579,"z":-0.314,"el":"C"},{"x":5.452,"y":0.237,"z":0.139,"el":"C"},{"x":-4.22,"y":3.098,"z":-0.123,"el":"C"},{"x":-4.569,"y":-1.518,"z":-0.912,"el":"C"},{"x":-3.604,"y":-1.709,"z":1.294,"
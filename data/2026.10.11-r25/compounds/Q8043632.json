{"version":"2026.10.11-r25","id":"Q8043632","formula":"XeCl₂","hill":"Cl2Xe","elements":["Cl","Xe"],"composition":{"Cl":2.0,"Xe":1.0},"names":{"en":"Xenon dichloride"},"descriptions":{"en":"Xenon dichloride (XeCl2) is a xenon compound and the only known stable chloride of xenon. The compound can be prepared by using microwave discharges towards the mixture of xenon and chlorine, and it can be isolated from a condensate trap. One experiment tried to use xenon, chlorine and boron trichloride to produce XeCl2·BCl3, but only generated xenon dichloride."},"fame":14,"pubchemCid":null,"mass":null,"charge":0,"smiles":null,"inchikey":null,"iupac":null,"classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":null,"structure":null,"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q8043632","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Xenon_dichloride","license":"CC BY-SA 4.0"}],"similar":[{"id":"Q10925136","formula":"XeCl₄","names":{"en":"Xenon tetrachloride"},"elements":["Cl","Xe"],"fame":8,"kind":"molecule"},{"id":"Q732517","formula":"XeCl","names":{"en":"Xenon monochloride"},"elements":["Cl","Xe"],"fame":7,"kind":"molecule"},{"id":"Q416188","formula":"Cl₄Tc","names":{"en":"Technetium(IV) chloride","ru":"Хлорид технеция(IV)"},"elements":["Cl","Tc"],"fame":18,"kind":"crystal"},{"id":"Q56319205","formula":"TcCl₃","names":{"en":"Technetium(III) chloride"},"elements":["Cl","Tc"],"fame":9,"kind":"crystal"},{"id":"Q10880271","formula":"XeBr₂","names":{"en":"Xenon dibromide"},"elements":["Br","Xe"],"fame":6,"kind":"molecule"},{"id":"Q408349","formula":"Cl₃Er","names":{"en":"Erbium(III) chloride","ru":"Хлорид эрбия(III)"},"elements":["Cl","Er"],"fame":20,"kind":"crystal"},{"id":"Q680191","formula":"CCl₄S","names":{"en":"Perchloromethylmercaptan","ru":"Трихлорметансульфенилхлорид"},"elements":["C","S
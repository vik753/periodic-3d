{"version":"2026.10.11-r25","id":"Q7334297","formula":"C₂₁H₂₀Cl₂N₆O₃","hill":"C21H20Cl2N6O3","elements":["H","C","N","O","Cl"],"composition":{"C":21.0,"H":20.0,"N":6.0,"O":3.0,"Cl":2.0},"names":{"en":"Rilmazafone"},"descriptions":{"en":"Rilmazafone (リスミー, brand name Rhythmy; developmental code 450191-S) is a water-soluble prodrug developed by Shionogi and approved in Japan for the treatment of insomnia and as a pre-anesthetic agent. It is not a benzodiazepine in the pharmacological or structural sense — the parent compound contains no diazepine ring and has no affinity for benzodiazepine receptors — but is converted inside the body into several active benzodiazepine metabolites, principally rilmazolam, which produce sedative and hypnotic effects. Outside Japan, rilmazafone has appeared as a new psychoactive substance (NPS) and has been implicated in fatal overdoses in Europe and North America."},"fame":11,"pubchemCid":5069,"mass":475.3,"charge":0,"smiles":"CN(C)C(=O)C1=NN(C(=N1)CNC(=O)CN)C2=C(C=C(C=C2)Cl)C(=O)C3=CC=CC=C3Cl","inchikey":"KYHFRCPLIGODFH-UHFFFAOYSA-N","iupac":"5-[[(2-aminoacetyl)amino]methyl]-1-[4-chloro-2-(2-chlorobenzoyl)phenyl]-N,N-dimethyl-1,2,4-triazole-3-carboxamide","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"5069","atoms":52,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":3.523,"y":2.822,"z":-2.807,"el":"Cl"},{"x":3.255,"y":-3.559,"z":-1.085,"el":"Cl"},{"x":0.716,"y":-2.039,"z":-0.144,"el":"O"},{"x":-3.414,"y":-3.22,"z":-1.398,"el":"O"},{"x":0.196,"y":3.573,"z":1.146,"el":"O"},{"x":-1.063,"y":-0.045,"z":-0.458,"el":"N"},{"x":-1.745,"y":-0.959,"z":-1.165,"el":"N"},{"x":-2.62,"y":-0.692,"z":0.932,"el":"N"},{"x":-1.697,"y":2.328,"z":1.655,"el":"N"},{"x":-4.938,"y":-2.207,"z":0.032,"el":"N"},{"x":-1.396,"y":5.665,"z":0.355,"el":"N"},{"x":0.032,"y":0.617,"z":-1.005,
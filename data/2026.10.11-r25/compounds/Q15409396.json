{"version":"2026.10.11-r25","id":"Q15409396","formula":"C₁₂H₁₅F₂NO₂","hill":"C12H15F2NO2","elements":["H","C","N","O","F"],"composition":{"C":12.0,"F":2.0,"H":15.0,"N":1.0,"O":2.0},"names":{"en":"Manifaxine"},"descriptions":{"en":"Manifaxine (developmental code name GW-320,659) is a norepinephrine–dopamine reuptake inhibitor developed by GlaxoSmithKline through structural modification of radafaxine, an isomer of hydroxybupropion and one of the active metabolites of bupropion. Manifaxine was researched for treatment of attention deficit hyperactivity disorder (ADHD) and obesity and was found to be safe, reasonably effective, and well-tolerated for both applications. However, no results were reported following these initial trials and development was discontinued."},"fame":6,"pubchemCid":60829,"mass":243.25,"charge":0,"smiles":"C[C@@H]1CO[C@]([C@@H](N1)C)(C2=CC(=CC(=C2)F)F)O","inchikey":"OZGPVYJHWWPEFT-RGNHYFCHSA-N","iupac":"(2S,3S,5R)-2-(3,5-difluorophenyl)-3,5-dimethylmorpholin-2-ol","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"60829","atoms":32,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-3.019,"y":2.643,"z":-0.676,"el":"F"},{"x":-3.844,"y":-1.909,"z":0.337,"el":"F"},{"x":1.29,"y":1.002,"z":0.871,"el":"O"},{"x":0.957,"y":-1.261,"z":1.428,"el":"O"},{"x":2.917,"y":-0.683,"z":-0.741,"el":"N"},{"x":1.455,"y":-0.684,"z":-0.91,"el":"C"},{"x":0.766,"y":-0.263,"z":0.42,"el":"C"},{"x":3.386,"y":0.634,"z":-0.301,"el":"C"},{"x":2.709,"y":0.997,"z":1.018,"el":"C"},{"x":-0.732,"y":-0.039,"z":0.208,"el":"C"},{"x":1.038,"y":-2.075,"z":-1.399,"el":"C"},{"x":4.903,"y":0.608,"z":-0.146,"el":"C"},{"x":-1.619,"y":-1.098,"z":0.371,"el":"C"},{"x":-1.198,"y":1.224,"z":-0.146,"el":"C"},{"x":-2.565,"y":1.429,"z":-0.338,"el":"C"},{"x":-2.986,"y":-0.894,"z":0.179,"el":"C"},{"x":-3.458,"y":0.37,"z":-0.175
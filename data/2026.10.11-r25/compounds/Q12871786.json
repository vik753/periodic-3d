{"version":"2026.10.11-r25","id":"Q12871786","formula":"C₅H₁₀","hill":"C5H10","elements":["H","C"],"composition":{"C":5.0,"H":10.0},"names":{"en":"2-pentene","ru":"Транс-пентен-2"},"descriptions":{"ru":"транс-Пенте́н-2 (транс-β-амиле́н) — органическое соединение, линейный ненасыщенный углеводород (алкен) с формулой C5H10, один из изомеров пентена. Имеет при втором атоме углерода одну двойную связь (С=С), которая определяет наличие цис-транс-изомерии и различие свойств с цис-изомером (цис-пентеном-2). Чистый транс-пентен-2 в нормальных условиях окружающей среды, то есть при температуре 25 °C и давлении 1 атм, является чрезвычайно легковоспламеняющейся жидкостью."},"fame":2,"pubchemCid":12585,"mass":70.13,"charge":0,"smiles":"CCC=CC","inchikey":"QMMOXUPEWRXHJS-UHFFFAOYSA-N","iupac":"pent-2-ene","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"12585","atoms":15,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":1.354,"y":0.582,"z":-0.165,"el":"C"},{"x":-0.044,"y":0.407,"z":0.352,"el":"C"},{"x":2.192,"y":-0.665,"z":0.068,"el":"C"},{"x":-1.055,"y":-0.078,"z":-0.383,"el":"C"},{"x":-2.447,"y":-0.247,"z":0.128,"el":"C"},{"x":1.815,"y":1.443,"z":0.333,"el":"H"},{"x":1.337,"y":0.814,"z":-1.237,"el":"H"},{"x":-0.219,"y":0.684,"z":1.388,"el":"H"},{"x":3.211,"y":-0.508,"z":-0.3,"el":"H"},{"x":1.773,"y":-1.53,"z":-0.457,"el":"H"},{"x":2.251,"y":-0.908,"z":1.134,"el":"H"},{"x":-0.876,"y":-0.364,"z":-1.416,"el":"H"},{"x":-3.14,"y":0.346,"z":-0.475,"el":"H"},{"x":-2.547,"y":0.068,"z":1.172,"el":"H"},{"x":-2.744,"y":-1.298,"z":0.059,"el":"H"}],"bonds":[[0,1,1],[0,2,1],[0,5,1],[0,6,1],[1,3,2],[1,7,1],[2,8,1],[2,9,1],[2,10,1],[3,4,1],[3,11,1],[4,12,1],[4,13,1],[4,14,1]]},"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q12871786","license":"CC0 1.0"},{"role":"description","
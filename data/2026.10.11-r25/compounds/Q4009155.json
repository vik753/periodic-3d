{"version":"2026.10.11-r25","id":"Q4009155","formula":"Sr₂B₁₁O₁₆(OH)₅*H₂O","hill":"B11H7O22Sr2","elements":["H","B","O","Sr"],"composition":{"B":11.0,"H":7.0,"O":22.0,"Sr":2.0},"names":{"en":"Veatchite"},"descriptions":{"en":"Veatchite is an unusual strontium borate, with the chemical formula Sr2B11O16(OH)5·H2O. There are two known polytypes, veatchite-A and veatchite-p. Veatchite was discovered in 1938, at the Sterling Borax mine in Tick Canyon, Los Angeles County, California. Veatchite is named to honor John Veatch, the first person to detect boron in the mineral waters of California."},"fame":7,"pubchemCid":null,"mass":null,"charge":0,"smiles":null,"inchikey":null,"iupac":null,"classes":[{"qid":"Q12089225","names":{"en":"mineral species","ru":"действительный вид минералов","uk":"мінеральний вид"}}],"structureInfo":null,"structure":null,"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q4009155","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Veatchite","license":"CC BY-SA 4.0"},{"role":"photo","name":"Wikimedia Commons","url":"https://commons.wikimedia.org/wiki/File:Veatchite.jpg","license":"Public domain"}],"similar":[{"id":"Q3910811","formula":"Mg₃B₁₁O₁₅(OH)₉","names":{"en":"Preobrazhenskite","uk":"Преображенськіт"},"elements":["H","B","O","Mg"],"fame":5,"kind":"crystal"},{"id":"Q3976253","formula":"NaCa₂[B₉O₁₄(OH)₄]*2H₂O","names":{"en":"Studenitsite"},"elements":["H","B","O","Na","Ca"],"fame":5,"kind":"crystal"},{"id":"Q3234481","formula":"BHO₂","names":{"en":"Oxoborinic acid","ru":"Метаборная кислота"},"elements":["H","B","O"],"fame":16,"kind":"molecule"},{"id":"Q421527","formula":"Ca₂B₅SiO₉(OH)₅","names":{"en":"Howlite","ru":"Говлит","uk":"Гауліт"},"elements":["H","B","O","Si","Ca"],"fame":14,"kind":"crystal"},{"id":"Q5282504","formula":"H₈B₈Na₂O₁₇","names":{"en":"Disodium octaborate tetrahydrate"},"elements":["H","B","O","Na"],"fame":9,"kind":"molecule"},{"id":"Q27270
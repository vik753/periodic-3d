{"version":"2026.10.11-r25","id":"Q20706936","formula":"C₂₂H₃₁N₃O₃","hill":"C22H31N3O3","elements":["H","C","N","O"],"composition":{"C":22.0,"H":31.0,"N":3.0,"O":3.0},"names":{"en":"MDMB-CHMINACA"},"descriptions":{"en":"MDMB-CHMINACA (also known as MDMB(N)-CHM) is an indazole-based synthetic cannabinoid that acts as a potent agonist of the CB1 receptor, and has been sold online as a designer drug. It was invented by Pfizer in 2008, and is one of the most potent cannabinoid agonists known, with a binding affinity of 0.0944 nM at CB1, and an EC50 of 0.330 nM. It is closely related to MDMB-FUBINACA, which caused at least 1000 hospitalizations and 40 deaths in Russia as consequence of intoxication."},"fame":2,"pubchemCid":121491808,"mass":385.5,"charge":0,"smiles":"CC(C)(C)[C@@H](C(=O)OC)NC(=O)C1=NN(C2=CC=CC=C21)CC3CCCCC3","inchikey":"DGQMLBSSRFFINY-LJQANCHMSA-N","iupac":"methyl (2S)-2-[[1-(cyclohexylmethyl)indazole-3-carbonyl]amino]-3,3-dimethylbutanoate","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"rdkit","ref":"121491808","atoms":59,"license":"Computed with RDKit from SMILES (PubChem, Wikidata)"},"structure":{"kind":"molecule","atoms":[{"x":-5.955,"y":1.413,"z":0.176,"el":"C"},{"x":-4.651,"y":0.937,"z":-0.496,"el":"C"},{"x":-4.976,"y":-0.287,"z":-1.374,"el":"C"},{"x":-4.154,"y":2.077,"z":-1.412,"el":"C"},{"x":-3.566,"y":0.632,"z":0.581,"el":"C"},{"x":-3.966,"y":-0.502,"z":1.54,"el":"C"},{"x":-3.733,"y":-1.69,"z":1.34,"el":"O"},{"x":-4.628,"y":-0.008,"z":2.624,"el":"O"},{"x":-5.014,"y":-1.002,"z":3.574,"el":"C"},{"x":-2.285,"y":0.242,"z":-0.017,"el":"N"},{"x":-1.082,"y":0.601,"z":0.564,"el":"C"},{"x":-1.017,"y":1.425,"z":1.473,"el":"O"},{"x":0.097,"y":-0.067,"z":-0.008,"el":"C"},{"x":1.212,"y":0.628,"z":-0.296,"el":"N"},{"x":2.059,"y":-0.286,"z":-0.8,"el":"N"},{"x":1.536,"y":-1.551,"z":-0.88,"el":"C"},{"x":2.065,"y":-2.762,"z":-1.351,"e
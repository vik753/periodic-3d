{"version":"2026.10.11-r25","id":"Q132353758","formula":"C₁₀H₁₃NO₂","hill":"C10H13NO2","elements":["H","C","N","O"],"composition":{"C":10.0,"H":13.0,"N":1.0,"O":2.0},"names":{"en":"MDM1EA"},"descriptions":{"en":"N-Methyl-1-(3,4-methylenedioxyphenyl)-1-ethanamine (MDM1EA), also known as α,N-dimethyl-3,4-methylenedioxybenzylamine (α,N-DMMDBA) or as α,N-dimethylpiperonylamine, is an entactogen-like drug of the benzylamine family related to MDMA. It is the analogue of MDMA in which the side chain has been shortened by one carbon atom. The drug has been found to be a weak serotonin reuptake inhibitor and partially substituted for MDMA in rodent drug discrimination tests at the highest assessed doses. The effects of α,N-DMMDBA in humans are unknown."},"fame":1,"pubchemCid":6424509,"mass":179.22,"charge":0,"smiles":"CC(C1=CC2=C(C=C1)OCO2)NC","inchikey":"USAUUVXZKYYZIL-UHFFFAOYSA-N","iupac":"1-(1,3-benzodioxol-5-yl)-N-methylethanamine","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"6424509","atoms":26,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-2.187,"y":-1.567,"z":-0.293,"el":"O"},{"x":-3.106,"y":0.649,"z":-0.065,"el":"O"},{"x":3.034,"y":-0.47,"z":-0.771,"el":"N"},{"x":2.43,"y":0.013,"z":0.46,"el":"C"},{"x":0.958,"y":0.219,"z":0.326,"el":"C"},{"x":0.125,"y":-0.873,"z":0.07,"el":"C"},{"x":-1.228,"y":-0.633,"z":-0.045,"el":"C"},{"x":0.422,"y":1.512,"z":0.458,"el":"C"},{"x":-1.753,"y":0.632,"z":0.085,"el":"C"},{"x":2.811,"y":-0.935,"z":1.606,"el":"C"},{"x":-0.953,"y":1.728,"z":0.337,"el":"C"},{"x":-3.374,"y":-0.748,"z":-0.303,"el":"C"},{"x":2.82,"y":0.471,"z":-1.864,"el":"C"},{"x":2.901,"y":0.974,"z":0.713,"el":"H"},{"x":0.516,"y":-1.879,"z":-0.04,"el":"H"},{"x":1.07,"y":2.362,"z":0.656,"el":"H"},{"x":2.46,"y":-1.958,"z":1.431,"el":"H"},{"x":3.899,"y":-0.975,"z":1.736,"el":"H"},{"x":2.376,
{"version":"2026.10.11-r25","id":"Q82880587","formula":"C₁₂H₁₇NO₂","hill":"C12H17NO2","elements":["H","C","N","O"],"composition":{"C":12.0,"H":17.0,"N":1.0,"O":2.0},"names":{"en":"N-methyl-N-(2-methylpropyl)-2H-1,3-benzodioxol-5-amine"},"descriptions":{"en":"Homo-MDMA (HMDMA), also known as α,N-dimethyl-3-(3,4-methylenedioxyphenyl)propylamine, is an entactogen-like drug of the phenylpropylamine group related to MDMA. It is an analogue of MDMA in which the side chain has been lengthened by one carbon atom. It showed very weak induction of serotonin release (much less than that of MDMA or methamphetamine) and no significant release of dopamine in rat brain synaptosomes. As such, its monoamine-releasing activity was said to have been essentially abolished relative to MDMA. The drug partially substituted for MDMA in rodent drug discrimination tests but produced seizures at high doses."},"fame":1,"pubchemCid":130058,"mass":207.27,"charge":0,"smiles":"CC(C)CN(C)C1=CC2=C(C=C1)OCO2","inchikey":"PUKMCMUXXJZVNY-UHFFFAOYSA-N","iupac":"N-methyl-N-(2-methylpropyl)-1,3-benzodioxol-5-amine","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"130058","atoms":32,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":2.385,"y":-1.711,"z":-0.565,"el":"O"},{"x":3.65,"y":0.028,"z":0.523,"el":"O"},{"x":-1.671,"y":0.976,"z":-0.581,"el":"N"},{"x":-2.687,"y":-1.063,"z":0.372,"el":"C"},{"x":-2.564,"y":-0.129,"z":-0.839,"el":"C"},{"x":-0.316,"y":0.768,"z":-0.287,"el":"C"},{"x":-3.198,"y":-0.332,"z":1.614,"el":"C"},{"x":-3.557,"y":-2.284,"z":0.07,"el":"C"},{"x":-2.205,"y":2.338,"z":-0.644,"el":"C"},{"x":0.298,"y":-0.446,"z":-0.624,"el":"C"},{"x":1.633,"y":-0.605,"z":-0.314,"el":"C"},{"x":0.431,"y":1.781,"z":0.35,"el":"C"},{"x":2.356,"y":0.388,"z":0.307,"el":"C"},{"x":1.782,"y":1.595,"z":0.653,"el":"C"},{"x":3.662,"y":-1.302
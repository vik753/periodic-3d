{"version":"2026.10.11-r25","id":"Q83057481","formula":"C₄H₁₀N₂O","hill":"C4H10N2O","elements":["H","C","N","O"],"composition":{"C":4.0,"H":10.0,"N":2.0,"O":1.0},"names":{"en":"Butanamide, 4-amino- (9CI)"},"descriptions":{"en":"Gabamide, or GABAmide, also known as γ-aminobutyramide (GABAD), is a GABA receptor agonist and GABA analogue, or more specifically the amide of the inhibitory neurotransmitter γ-aminobutyric acid (GABA). Along with GABA and progabide acid (SL-75.102), gabamide is an active metabolite of the anticonvulsant drug progabide (Gabrene; SL-76.002). Unlike progabide, but similarly to GABA, gabamide is unable to cross the blood–brain barrier and hence is peripherally selective."},"fame":2,"pubchemCid":18615,"mass":102.14,"charge":0,"smiles":"C(CC(=O)N)CN","inchikey":"WCVPFJVXEXJFLB-UHFFFAOYSA-N","iupac":"4-aminobutanamide","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"18615","atoms":17,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":1.712,"y":-1.313,"z":0.003,"el":"O"},{"x":-3.336,"y":-0.34,"z":0.014,"el":"N"},{"x":2.734,"y":0.746,"z":0.012,"el":"N"},{"x":-0.888,"y":-0.242,"z":-0.024,"el":"C"},{"x":0.33,"y":0.68,"z":-0.012,"el":"C"},{"x":-2.188,"y":0.558,"z":0.005,"el":"C"},{"x":1.637,"y":-0.088,"z":0.002,"el":"C"},{"x":-0.859,"y":-0.879,"z":-0.917,"el":"H"},{"x":-0.845,"y":-0.915,"z":0.843,"el":"H"},{"x":0.319,"y":1.326,"z":-0.898,"el":"H"},{"x":0.304,"y":1.324,"z":0.875,"el":"H"},{"x":-2.249,"y":1.209,"z":-0.874,"el":"H"},{"x":-2.221,"y":1.196,"z":0.895,"el":"H"},{"x":-4.193,"y":0.207,"z":0.085,"el":"H"},{"x":-3.304,"y":-0.93,"z":0.845,"el":"H"},{"x":2.647,"y":1.757,"z":0.01,"el":"H"},{"x":3.676,"y":0.369,"z":0.022,"el":"H"}],"bonds":[[0,6,2],[1,5,1],[1,13,1],[1,14,1],[2,6,1],[2,15,1],[2,16,1],[3,4,1],[3,5,1],[3,7,1],[3,8,1],[4,6,1],[4,9,1],[4,10,1],[5,11,1],[5,12,1]
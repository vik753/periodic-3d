{"version":"2026.10.11-r25","id":"Q132235833","formula":"C₁₅H₂₅NO₂","hill":"C15H25NO2","elements":["H","C","N","O"],"composition":{"C":15.0,"H":25.0,"N":1.0,"O":2.0},"names":{"en":"Methylenedioxyphenylpropylaminopentane"},"descriptions":{"en":"1-(3,4-Methylenedioxyphenyl)-2-propylaminopentane (MPAP), also known as 3,4-methylenedioxy-α,N-dipropylphenethylamine, N-propyl-1,3-benzodioxolylpentanamine (PDBP), or propyl-K, is a monoaminergic activity enhancer (MAE) of the phenethylamine, amphetamine, and α-propylphenethylamine families that is closely related to phenylpropylaminopentane (PPAP). It is an analogue of PPAP and benzofuranylpropylaminopentane (BPAP) with a benzodioxole ring instead of a phenyl or benzofuran ring, respectively. MAEs are agents that enhance the action potential-mediated release of monoamine neurotransmitters."},"fame":1,"pubchemCid":null,"mass":null,"charge":0,"smiles":"CCCNC(CCC)CC1=CC2OCOC2C=C1","inchikey":null,"iupac":null,"classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"rdkit","ref":null,"atoms":43,"license":"Computed with RDKit from SMILES (PubChem, Wikidata)"},"structure":{"kind":"molecule","atoms":[{"x":-1.422,"y":3.22,"z":-1.956,"el":"C"},{"x":-0.77,"y":2.114,"z":-1.138,"el":"C"},{"x":-1.583,"y":1.802,"z":0.121,"el":"C"},{"x":-0.931,"y":0.798,"z":0.96,"el":"N"},{"x":-1.086,"y":-0.589,"z":0.476,"el":"C"},{"x":-2.424,"y":-1.17,"z":0.992,"el":"C"},{"x":-2.759,"y":-2.545,"z":0.405,"el":"C"},{"x":-4.147,"y":-3.005,"z":0.828,"el":"C"},{"x":0.123,"y":-1.434,"z":0.967,"el":"C"},{"x":1.472,"y":-0.974,"z":0.45,"el":"C"},{"x":2.398,"y":-0.421,"z":1.255,"el":"C"},{"x":3.748,"y":0.029,"z":0.771,"el":"C"},{"x":3.916,"y":1.407,"z":1.109,"el":"O"},{"x":3.709,"y":2.109,"z":-0.111,"el":"C"},{"x":4.078,"y":1.293,"z":-1.216,"el":"O"},{"x":3.977,"y":-0.054,"z":-0.746,"el":"C"},{"x":2.892,"y":-0.737,"z":-1.526,"el":"C"},{"x":1.756
{"version":"2026.10.11-r25","id":"Q28209300","formula":"C₁₈H₂₃IO₂","hill":"C18H23IO2","elements":["H","C","O","I"],"composition":{"C":18.0,"H":23.0,"I":1.0,"O":2.0},"names":{"en":"16α-Iodo-E2"},"descriptions":{"en":"16α-Iodo-E2, or 16α-iodoestradiol, is a synthetic, steroidal, potent estrogen with slight preference for the ERα over the ERβ that is used in scientific research. The KD of 16α-iodo-E2 for the ERα is 0.6 nM and for the ERβ is 0.24 nM, a 4-fold difference in affinity, whereas estradiol is considered to have similar affinity for the two receptor subtypes. Unlike the case of the much weaker estriol (16α-hydroxyestradiol), 16α-iodo-E2 is considered to be equipotent with estradiol in terms of estrogenic activity."},"fame":1,"pubchemCid":67087,"mass":398.3,"charge":0,"smiles":"C[C@]12CC[C@H]3[C@H]([C@@H]1C[C@H]([C@@H]2O)I)CCC4=C3C=CC(=C4)O","inchikey":"SSYGGPAGDDGXAF-ZXXIGWHRSA-N","iupac":"(8R,9S,13S,14S,16R,17R)-16-iodo-13-methyl-6,7,8,9,11,12,14,15,16,17-decahydrocyclopenta[a]phenanthrene-3,17-diol","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"67087","atoms":44,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-5.395,"y":1.794,"z":-1.18,"el":"I"},{"x":-4.696,"y":-1.576,"z":0.383,"el":"O"},{"x":6.14,"y":0.077,"z":0.278,"el":"O"},{"x":-2.349,"y":-0.847,"z":0.235,"el":"C"},{"x":-1.766,"y":0.519,"z":-0.177,"el":"C"},{"x":-0.288,"y":0.65,"z":0.193,"el":"C"},{"x":0.517,"y":-0.448,"z":-0.567,"el":"C"},{"x":-3.812,"y":-0.638,"z":-0.207,"el":"C"},{"x":-1.596,"y":-1.94,"z":-0.535,"el":"C"},{"x":-2.768,"y":1.523,"z":0.39,"el":"C"},{"x":-0.075,"y":-1.859,"z":-0.306,"el":"C"},{"x":-4.134,"y":0.808,"z":0.25,"el":"C"},{"x":0.288,"y":2.023,"z":-0.162,"el":"C"},{"x":-2.279,"y":-1.154,"z":1.753,"el":"C"},{"x":2.015,"y":-0.317,"z":-0.305,"el":"C"},{"x":1.716,"y":2.136,"z":0.362,"el":"C"},{"x":2.
{"version":"2026.10.11-r25","id":"Q7243701","formula":"C₂₁H₁₄N₃NaO₃S₃","hill":"C21H14N3NaO3S3","elements":["H","C","N","O","Na","S"],"composition":{"C":21.0,"H":14.0,"N":3.0,"O":3.0,"S":3.0,"Na":1.0},"names":{"en":"Primuline"},"descriptions":{"en":"Primuline is a dye containing the benzothiazole ring system. Primuline itself is also known as Direct yellow 59 or C.I. 49000. The primulines are considered derivatives of dehydrothiotoluidine (aminobenzenyltoluylmercaptan), which is obtained when para-toluidine is heated with sulfur for eighteen hours at 180–190 °C and then for a further six hours at 200–220 °C Dehydrothiotoluidine is not itself a dye-stuff, but if the heating is carried out at a higher temperature in the presence of more sulfur, then a base is formed, which gives primuline yellow upon sulfonation."},"fame":11,"pubchemCid":3769888,"mass":475.5,"charge":0,"smiles":"CC1=C(C2=C(C=C1)N=C(S2)C3=CC4=C(C=C3)N=C(S4)C5=CC=C(C=C5)N)S(=O)(=O)[O-].[Na+]","inchikey":"RSRNHSYYBLEMOI-UHFFFAOYSA-M","iupac":"sodium 2-[2-(4-aminophenyl)-1,3-benzothiazol-6-yl]-6-methyl-1,3-benzothiazole-7-sulfonate","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"rdkit","ref":"3769888","atoms":45,"license":"Computed with RDKit from SMILES (PubChem, Wikidata)"},"structure":{"kind":"molecule","atoms":[{"x":-8.212,"y":-0.074,"z":0.375,"el":"C"},{"x":-6.784,"y":0.303,"z":0.088,"el":"C"},{"x":-5.665,"y":-0.45,"z":0.535,"el":"C"},{"x":-4.366,"y":0.018,"z":0.199,"el":"C"},{"x":-4.172,"y":1.179,"z":-0.551,"el":"C"},{"x":-5.291,"y":1.909,"z":-0.987,"el":"C"},{"x":-6.575,"y":1.468,"z":-0.666,"el":"C"},{"x":-2.856,"y":1.529,"z":-0.813,"el":"N"},{"x":-2.032,"y":0.652,"z":-0.277,"el":"C"},{"x":-2.803,"y":-0.622,"z":0.569,"el":"S"},{"x":-0.557,"y":0.75,"z":-0.379,"el":"C"},{"x":0.315,"y":-0.237,"z":0.118,"el":"C"},{"x":1.706,"y":-0.061,"z":-0.023,"el":"C"},{"x":2.253,"y":1.0
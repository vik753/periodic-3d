{"version":"2026.10.11-r25","id":"Q18353336","formula":"C₁₀H₁₁FN₂O","hill":"C10H11FN2O","elements":["H","C","N","O","F"],"composition":{"C":10.0,"F":1.0,"H":11.0,"N":2.0,"O":1.0},"names":{"en":"Nifene F-18"},"descriptions":{"en":"Nifene is a high affinity, selective nicotinic α4β2* receptor partial agonist used in medical research for nicotinic acetylcholine receptors, usually in the form of nifene (18F) as a positron emission tomography (PET) radiotracer. Nifene has been used to assess the efficacy of acetylcholinesterase inhibitors in animal models, because the neurotransmitter acetylcholine competes with the binding of nifene at the nicotinic receptor site. Learning and behavior studies in animal models using nifene have suggested a potential role of the nicotinic receptors located in distinct white matter tracts."},"fame":1,"pubchemCid":6917075,"mass":193.21,"charge":0,"smiles":"C1C=C[C@H](N1)COC2=C(N=CC=C2)[18F]","inchikey":"GHHQHFNDKOQCRS-IZFLLFDKSA-N","iupac":"3-[[(2S)-2,5-dihydro-1H-pyrrol-2-yl]methoxy]-2-(18F)fluoropyridine","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"6917075","atoms":25,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":1.708,"y":-2.173,"z":0.477,"el":"F"},{"x":0.043,"y":-0.059,"z":0.966,"el":"O"},{"x":-3.433,"y":1.04,"z":0.306,"el":"N"},{"x":3.334,"y":-0.811,"z":-0.411,"el":"N"},{"x":-2.322,"y":0.14,"z":0.688,"el":"C"},{"x":-0.979,"y":0.858,"z":0.617,"el":"C"},{"x":-4.235,"y":0.316,"z":-0.699,"el":"C"},{"x":-2.394,"y":-1.017,"z":-0.252,"el":"C"},{"x":-3.472,"y":-0.917,"z":-1.029,"el":"C"},{"x":1.275,"y":0.134,"z":0.393,"el":"C"},{"x":1.695,"y":1.406,"z":0.053,"el":"C"},{"x":2.109,"y":-0.934,"z":0.149,"el":"C"},{"x":2.948,"y":1.573,"z":-0.525,"el":"C"},{"x":3.722,"y":0.443,"z":-0.734,"el":"C"},{"x":-2.488,"y":-0.232,"z":1.707,"el":"H"},{"x":-3.065,"y":1.893,
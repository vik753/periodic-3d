{"version":"2026.10.11-r25","id":"Q135496542","formula":"C₁₂H₁₇NO₂","hill":"C12H17NO2","elements":["H","C","N","O"],"composition":{"C":12.0,"H":17.0,"N":1.0,"O":2.0},"names":{"en":"F"},"descriptions":{"en":"F, or F-1, also known as 5-methoxy-6-(2-aminopropyl)-2,3-dihydrobenzofuran (5-methoxy-6-APDB), is a putative psychedelic drug of the phenethylamine, DOx, and benzofuran families. It is the derivative of 2,5-dimethoxyamphetamine (2,5-DMA or DOH) in which the 5-methoxy group on the benzene ring has been cyclized into a tetrahydrofuran ring tethered at the 4 position. It is also an analogue of DOH-5-hemiFLY, but in contrast to DOH-5-hemiFLY, F has the 5-methoxy group tethered at the 4 position rather than at the 6 position."},"fame":1,"pubchemCid":13553507,"mass":207.27,"charge":0,"smiles":"CC(CC1=C(C=C2CCOC2=C1)OC)N","inchikey":"IUKWXRPAJLVHHN-UHFFFAOYSA-N","iupac":"1-(5-methoxy-2,3-dihydro-1-benzofuran-6-yl)propan-2-amine","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"13553507","atoms":32,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":2.595,"y":-1.72,"z":-0.502,"el":"O"},{"x":-1.077,"y":2.252,"z":0.395,"el":"O"},{"x":-4.143,"y":-1.496,"z":-0.323,"el":"N"},{"x":2.038,"y":0.4,"z":0.215,"el":"C"},{"x":-0.638,"y":0.019,"z":-0.373,"el":"C"},{"x":-2.083,"y":-0.186,"z":-0.69,"el":"C"},{"x":3.508,"y":0.352,"z":0.369,"el":"C"},{"x":1.592,"y":-0.804,"z":-0.31,"el":"C"},{"x":-2.741,"y":-1.353,"z":0.082,"el":"C"},{"x":0.263,"y":-1.019,"z":-0.62,"el":"C"},{"x":3.717,"y":-1.155,"z":0.215,"el":"C"},{"x":-0.193,"y":1.24,"z":0.161,"el":"C"},{"x":1.159,"y":1.439,"z":0.454,"el":"C"},{"x":-2.697,"y":-1.145,"z":1.596,"el":"C"},{"x":-1.298,"y":3.175,"z":-0.669,"el":"C"},{"x":-2.671,"y":0.721,"z":-0.509,"el":"H"},{"x":-2.167,"y":-0.372,"z":-1.77,"el":"H"},{"x":3.993,"y":0.903,"z":-0.444,"el":"H"},{"x":3
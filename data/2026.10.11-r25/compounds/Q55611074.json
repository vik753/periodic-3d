{"version":"2026.10.11-r25","id":"Q55611074","formula":"C₃₃H₄₀O₃","hill":"C33H40O3","elements":["H","C","O"],"composition":{"C":33.0,"H":40.0,"O":3.0},"names":{"en":"Estradiol benzoate cyclooctenyl ether"},"descriptions":{"en":"Estradiol benzoate cyclooctenyl ether (EBCO), or estradiol 3-benzoate 17β-cyclooctenyl ether, is a synthetic estrogen as well as estrogen ester and ether – specifically, the C3 benzoate ester and C17β cyclooctenyl ether of estradiol – which was described in the early 1970s and was never marketed. It has been found to have a dramatically prolonged duration of action with oral administration in animals, similarly to the related compound quinestrol (the 3-cyclopentyl ether of ethinylestradiol). A single oral dose of EBCO sustained high uterus weights for 3 weeks in rats."},"fame":1,"pubchemCid":6436089,"mass":484.7,"charge":0,"smiles":"C[C@]12CC[C@H]3[C@H]([C@@H]1CC[C@@H]2O/C/4=C/CCCCCC4)CCC5=C3C=CC(=C5)OC(=O)C6=CC=CC=C6","inchikey":"DOFNLZKUGHVIMH-UQWKGHMASA-N","iupac":"[(8R,9S,13S,14S,17S)-17-[(1E)-cycloocten-1-yl]oxy-13-methyl-6,7,8,9,11,12,14,15,16,17-decahydrocyclopenta[a]phenanthren-3-yl] benzoate","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"6436089","atoms":76,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":5.136,"y":0.652,"z":0.261,"el":"O"},{"x":-5.756,"y":-0.181,"z":-0.705,"el":"O"},{"x":-5.611,"y":1.188,"z":1.176,"el":"O"},{"x":2.743,"y":0.089,"z":0.064,"el":"C"},{"x":2.057,"y":-1.291,"z":0.072,"el":"C"},{"x":0.544,"y":-1.183,"z":0.266,"el":"C"},{"x":-0.054,"y":-0.373,"z":-0.925,"el":"C"},{"x":4.209,"y":-0.363,"z":-0.074,"el":"C"},{"x":2.198,"y":0.886,"z":-1.128,"el":"C"},{"x":2.883,"y":-2.093,"z":1.075,"el":"C"},{"x":0.662,"y":0.994,"z":-1.09,"el":"C"},{"x":4.318,"y":-1.572,"z":0.875,"el":"C"},{"x":-0.14,"y":-2.549,"z":0.332,"el":"C"},{"x":2.555,"y"
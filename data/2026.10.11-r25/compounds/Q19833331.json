{"version":"2026.10.11-r25","id":"Q19833331","formula":"K₆Cu₆TlCl₁₇(OH)₄·H₂O","hill":"Cl17Cu6H6K6O5Tl","elements":["H","O","Cl","K","Cu","Tl"],"composition":{"H":6.0,"K":6.0,"O":5.0,"Cl":17.0,"Cu":6.0,"Tl":1.0},"names":{"en":"Chrysothallite"},"descriptions":{"en":"Chrysothallite is a rare thallium-bearing chloride mineral with the formula K6Cu6Tl3+Cl17(OH)4•H2O. Chrysothallite is unique in being only the second mineral with essential trivalent thallium, a feature shared with natural thallium(III) oxide, avicennite. Another examples of natural thallium chlorides are steropesite, Tl3BiCl6, and lafossaite, TlCl. Chrysothallite is one of numerous fumarolic minerals discovered among fumarolic sites of the Tolbachik volcano, Kamchatka, Russia The mineral is named in allusion to its colour and thallium content."},"fame":3,"pubchemCid":null,"mass":null,"charge":0,"smiles":null,"inchikey":null,"iupac":null,"classes":[{"qid":"Q12089225","names":{"en":"mineral species","ru":"действительный вид минералов","uk":"мінеральний вид"}}],"structureInfo":null,"structure":null,"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q19833331","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Chrysothallite","license":"CC BY-SA 4.0"}],"similar":[{"id":"Q117719","formula":"KAg₉Pb₂₆Cu₂₄Cl₆₂(OH)₄₈","names":{"en":"Boleite","ru":"Болеит","uk":"Болеїт"},"elements":["H","O","Cl","K","Cu","Ag","Pb"],"fame":17,"kind":"crystal"},{"id":"Q3924866","formula":"Pb₃₁Cu₂₄Cl₆₂(OH)₄₈","names":{"en":"Pseudoboleite","uk":"Псевдоболеїт"},"elements":["H","O","Cl","Cu","Pb"],"fame":7,"kind":null},{"id":"Q19861254","formula":"KCuCl₃","names":{"en":"Sanguite"},"elements":["Cl","K","Cu"],"fame":2,"kind":"crystal"},{"id":"Q82905464","formula":"Cl₃CuK","names":{"en":"Copper(2+) potassium chloride (1/1/3)"},"elements":["Cl","K","Cu"],"fame":2,"kind":"crystal"},{"id":"Q4134943","formula":"Cl₆IrNa₃","names":{"en":"Trisodium hexachloroiri
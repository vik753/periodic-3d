{"version":"2026.10.11-r25","id":"Q3143745","formula":"C₂HO₄⁻","hill":"C2HO4","elements":["H","C","O"],"composition":{"C":2.0,"H":1.0,"O":4.0},"names":{"en":"Hydrogenoxalate"},"descriptions":{"en":"Hydrogenoxalate or hydrogen oxalate (IUPAC name: 2-Hydroxy-2-oxoacetate) is an anion with chemical formula HC2O−4 or HO−C(=O)−CO−2, derived from oxalic acid by the loss of a single proton; or, alternatively, from the oxalate anion C2O2−4 by addition of a proton. The name is also used for any salt containing this anion. Especially in older literature, hydrogenoxalates may also be referred to as bioxalates, acid oxalates, or monobasic oxalates."},"fame":7,"pubchemCid":3716971,"mass":89.03,"charge":-1,"smiles":"C(=O)(C(=O)[O-])O","inchikey":"MUBZPKHOEPUJKR-UHFFFAOYSA-M","iupac":"2-hydroxy-2-oxoacetate","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"3716971","atoms":7,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":1.288,"y":1.157,"z":0.0,"el":"O"},{"x":1.287,"y":-1.165,"z":0.0,"el":"O"},{"x":-1.366,"y":-1.097,"z":0.0,"el":"O"},{"x":-1.217,"y":1.176,"z":0.0,"el":"O"},{"x":0.748,"y":-0.074,"z":0.0,"el":"C"},{"x":-0.74,"y":0.003,"z":0.0,"el":"C"},{"x":2.269,"y":1.131,"z":0.001,"el":"H"}],"bonds":[[0,4,1],[0,6,1],[1,4,2],[2,5,1],[3,5,2],[4,5,1]]},"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q3143745","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Hydrogenoxalate","license":"CC BY-SA 4.0"},{"role":"properties","name":"PubChem","url":"https://pubchem.ncbi.nlm.nih.gov/compound/3716971","license":"PubChem (NIH), public data"},{"role":"structure","name":"PubChem 3D","url":"https://pubchem.ncbi.nlm.nih.gov/compound/3716971#section=3D-Conformer","license":"PubChem (NIH), public data"}],"similar":[{"id":"Q2823
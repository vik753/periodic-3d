{"version":"2026.10.11-r25","id":"Q27258116","formula":"C₁₁H₁₆ClNO","hill":"C11H16ClNO","elements":["H","C","N","O","Cl"],"composition":{"C":11.0,"H":16.0,"N":1.0,"O":1.0,"Cl":1.0},"names":{"en":"Clorprenaline"},"descriptions":{"en":"Clorprenaline (INNTooltip International Nonproprietary Name, USANTooltip United States Adopted Name, BANTooltip British Approved Name), also known as isoprophenamine and known as clorprenaline hydrochloride (USANTooltip United States Adopted Name, JANTooltip Japanese Accepted Name) in the case of the hydrochloride salt, is a sympathomimetic and bronchodilator medication which is marketed in Japan. It acts as a β-adrenergic receptor agonist or as a β-sympathomimetic. Brand names of clorprenaline in Japan are numerous and include Asnormal, Bazarl, Bronchon, Clopinerin, Conselt, Cosmoline, Fusca, Kalutein, Pentadoll, Restanolon, and Troberin."},"fame":2,"pubchemCid":2810,"mass":213.7,"charge":0,"smiles":"CC(C)NCC(C1=CC=CC=C1Cl)O","inchikey":"SSMSBSWKLKKXGG-UHFFFAOYSA-N","iupac":"1-(2-chlorophenyl)-2-(propan-2-ylamino)ethanol","classes":[{"qid":"Q59199015","names":{"en":"group of stereoisomers","ru":"группа стереоизомеров","uk":"група стереоізомерів"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"2810","atoms":30,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":2.004,"y":-2.58,"z":-0.49,"el":"Cl"},{"x":-0.354,"y":-0.455,"z":1.964,"el":"O"},{"x":-2.564,"y":-0.524,"z":0.12,"el":"N"},{"x":-1.269,"y":0.036,"z":-0.234,"el":"C"},{"x":-0.147,"y":-0.64,"z":0.564,"el":"C"},{"x":-3.632,"y":0.123,"z":-0.64,"el":"C"},{"x":1.208,"y":-0.068,"z":0.208,"el":"C"},{"x":-3.651,"y":1.622,"z":-0.355,"el":"C"},{"x":-4.969,"y":-0.519,"z":-0.285,"el":"C"},{"x":2.222,"y":-0.882,"z":-0.272,"el":"C"},{"x":1.398,"y":1.294,"z":0.378,"el":"C"},{"x":3.458,"y":-0.318,"z":-0.591,"el":"C"},{"x":2.634,"y":1.858,"z":0.059,"el":"C"},{"x":3.663,"y":1.051,"z":-0.425,"el":"C"},{"x":-1.077,"y":-0.077,"z":-1.308,"el":"H"},{"x":-1
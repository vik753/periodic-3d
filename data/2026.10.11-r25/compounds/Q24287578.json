{"version":"2026.10.11-r25","id":"Q24287578","formula":"BN₉","hill":"BN9","elements":["B","N"],"composition":{"B":1.0,"N":9.0},"names":{"en":"Boron triazide"},"descriptions":{"en":"Boron triazide, also known as triazidoborane, is a thermally unstable compound of boron and nitrogen with a nitrogen content of 92.1% (by the standard atomic weight). Formally, it is the triazido derivative of borane and is a covalent inorganic azide. The high-energy compound, which has the propensity to undergo spontaneous explosive decomposition, was first described in 1954 by Egon Wiberg and Horst Michaud of LMU Munich."},"fame":6,"pubchemCid":101089385,"mass":136.88,"charge":0,"smiles":"B(N=[N+]=[N-])(N=[N+]=[N-])N=[N+]=[N-]","inchikey":"UQZCOUGMLLHWNZ-UHFFFAOYSA-N","iupac":"triazidoborane","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"rdkit","ref":"101089385","atoms":10,"license":"Computed with RDKit from SMILES (PubChem, Wikidata)"},"structure":{"kind":"molecule","atoms":[{"x":-0.407,"y":-0.452,"z":0.083,"el":"B"},{"x":-1.838,"y":-0.901,"z":-0.178,"el":"N"},{"x":-2.749,"y":-0.079,"z":-0.277,"el":"N"},{"x":-3.66,"y":0.741,"z":-0.376,"el":"N"},{"x":-0.108,"y":1.044,"z":0.223,"el":"N"},{"x":1.023,"y":1.482,"z":0.435,"el":"N"},{"x":2.148,"y":1.931,"z":0.646,"el":"N"},{"x":0.681,"y":-1.521,"z":0.196,"el":"N"},{"x":1.863,"y":-1.252,"z":0.405,"el":"N"},{"x":3.048,"y":-0.994,"z":0.615,"el":"N"}],"bonds":[[0,1,1.0],[1,2,2.0],[2,3,2.0],[0,4,1.0],[4,5,2.0],[5,6,2.0],[0,7,1.0],[7,8,2.0],[8,9,2.0]]},"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q24287578","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Boron_triazide","license":"CC BY-SA 4.0"},{"role":"properties","name":"PubChem","url":"https://pubchem.ncbi.nlm.nih.gov/compound/101089385","license":"PubChem (NIH), public
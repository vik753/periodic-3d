{"version":"2026.10.11-r25","id":"Q4596816","formula":"C₁₃H₁₈N₂","hill":"C13H18N2","elements":["H","C","N"],"composition":{"C":13.0,"H":18.0,"N":2.0},"names":{"en":"2,N,N-trimethyltryptamine"},"descriptions":{"en":"2-Methyl-DMT, or 2-Me-DMT, also known as 2-methyl-N,N-dimethyltryptamine or as 2,N,N-trimethyltryptamine (2,N,N-TMT or 2-TMT), is a psychoactive drug of the tryptamine family related to the psychedelic drug dimethyltryptamine (DMT). It is not a conventional psychedelic, but instead produces tactile enhancement and auditory distortion. The drug was described by Alexander Shulgin and reported in his book TiHKAL (Tryptamines I Have Known and Loved)."},"fame":4,"pubchemCid":11820174,"mass":202.3,"charge":0,"smiles":"CC1=C(C2=CC=CC=C2N1)CCN(C)C","inchikey":"NDGCOWDSLVNLGE-UHFFFAOYSA-N","iupac":"N,N-dimethyl-2-(2-methyl-1H-indol-3-yl)ethanamine","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"11820174","atoms":33,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":1.771,"y":-1.786,"z":-0.211,"el":"N"},{"x":-3.684,"y":0.339,"z":-0.052,"el":"N"},{"x":-0.038,"y":-0.64,"z":0.373,"el":"C"},{"x":-1.423,"y":-0.302,"z":0.763,"el":"C"},{"x":1.034,"y":0.28,"z":0.197,"el":"C"},{"x":0.446,"y":-1.901,"z":0.115,"el":"C"},{"x":-2.328,"y":-0.021,"z":-0.451,"el":"C"},{"x":2.157,"y":-0.465,"z":-0.169,"el":"C"},{"x":1.156,"y":1.679,"z":0.315,"el":"C"},{"x":-0.217,"y":-3.219,"z":0.146,"el":"C"},{"x":3.401,"y":0.121,"z":-0.424,"el":"C"},{"x":2.395,"y":2.279,"z":0.063,"el":"C"},{"x":3.499,"y":1.51,"z":-0.301,"el":"C"},{"x":-4.503,"y":0.644,"z":-1.226,"el":"C"},{"x":-3.665,"y":1.481,"z":0.864,"el":"C"},{"x":-1.855,"y":-1.117,"z":1.36,"el":"H"},{"x":-1.365,"y":0.564,"z":1.431,"el":"H"},{"x":-2.361,"y":-0.92,"z":-1.08,"el":"H"},{"x":-1.878,"y":0.773,"z":-1.063,"el":"H"},{"x":2.381,"y":-2.555,"z":-0.449,"el":"
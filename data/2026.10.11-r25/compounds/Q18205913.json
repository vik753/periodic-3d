{"version":"2026.10.11-r25","id":"Q18205913","formula":"C₁₉H₂₃FN₄O₂","hill":"C19H23FN4O2","elements":["H","C","N","O","F"],"composition":{"C":19.0,"F":1.0,"H":23.0,"N":4.0,"O":2.0},"names":{"en":"CERC-301"},"descriptions":{"en":"Rislenemdaz (developmental code names CERC-301, MK-0657) is an orally active, selective NMDA receptor subunit 2B (NR2B) antagonist which is under development by Cerecor in the United States as an adjunctive therapy for treatment-resistant depression (TRD). In November 2013, phase II clinical trials were initiated, and in the same month, rislenemdaz received Fast Track Designation from the Food and Drug Administration for TRD. A pilot study was published in 2012, and a phase II trial was completed in 2014, but was deemed insufficient. A second attempt at a phase II trial in 2016 also found that the drug failed to demonstrate efficacy against depression."},"fame":2,"pubchemCid":11394238,"mass":358.4,"charge":0,"smiles":"CC1=CC=C(C=C1)COC(=O)N2CC[C@@H]([C@@H](C2)F)CNC3=NC=CC=N3","inchikey":"RECBFDWSXWAXHY-IAGOWNOFSA-N","iupac":"(4-methylphenyl)methyl (3S,4R)-3-fluoro-4-[(pyrimidin-2-ylamino)methyl]piperidine-1-carboxylate","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"11394238","atoms":49,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":1.578,"y":2.538,"z":1.354,"el":"F"},{"x":-2.643,"y":1.129,"z":-0.011,"el":"O"},{"x":-2.243,"y":3.271,"z":0.679,"el":"O"},{"x":-0.606,"y":2.099,"z":-0.483,"el":"N"},{"x":4.059,"y":-0.055,"z":-0.805,"el":"N"},{"x":5.386,"y":-1.967,"z":-1.107,"el":"N"},{"x":5.468,"y":-0.716,"z":0.951,"el":"N"},{"x":2.229,"y":1.534,"z":-0.682,"el":"C"},{"x":1.706,"y":2.793,"z":0.02,"el":"C"},{"x":1.184,"y":0.41,"z":-0.61,"el":"C"},{"x":0.34,"y":3.216,"z":-0.509,"el":"C"},{"x":-0.161,"y":0.877,"z":-1.16,"el":"C"},{"x":3.554,"y":1.077,"z":-0.075,"el":"C
{"version":"2026.10.11-r25","id":"Q424072","formula":"Na₁₂Mg₇(SO₄)₁₃·15H₂O","hill":"H30Mg7Na12O67S13","elements":["H","O","Na","Mg","S"],"composition":{"H":30.0,"O":67.0,"S":13.0,"Mg":7.0,"Na":12.0},"names":{"en":"Löweite","uk":"Левеїт"},"descriptions":{"en":"Löweite is a rare evaporite sulfate mineral, with the chemical formula Na12Mg7(SO4)13·15H2O. It crystallizes in the hexagonal–trigonal system (space group R3), and is found in marine salt deposits, saline playa crusts, and occasionally as a volcanic sublimation product. It is colorless, but may appear reddish-yellow due to impurities. Löweite has a vitreous luster and a Mohs hardness of 2.5–3.","uk":"Левеїт (рос. левеит; англ. loeweite; нім."},"fame":7,"pubchemCid":null,"mass":null,"charge":0,"smiles":null,"inchikey":null,"iupac":null,"classes":[{"qid":"Q12089225","names":{"en":"mineral species","ru":"действительный вид минералов","uk":"мінеральний вид"}}],"structureInfo":null,"structure":null,"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q424072","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/L%C3%B6weite","license":"CC BY-SA 4.0"},{"role":"description","name":"Wikipedia (uk)","url":"https://uk.wikipedia.org/wiki/%D0%9B%D0%B5%D0%B2%D0%B5%D1%97%D1%82","license":"CC BY-SA 4.0"},{"role":"photo","name":"Wikimedia Commons","url":"https://commons.wikimedia.org/wiki/File:Loweite-95022.jpg","license":"CC BY-SA 3.0"}],"similar":[{"id":"Q19862347","formula":"Na₄(UO₂)(SO₄)₃·3H₂O","names":{"en":"Fermiite"},"elements":["H","O","Na","S","U"],"fame":5,"kind":null},{"id":"Q388053","formula":"Mg(SO₄)(H₂O)","names":{"en":"Kieserite","ru":"Кизерит","uk":"Кізерит"},"elements":["H","O","Mg","S"],"fame":22,"kind":"crystal"},{"id":"Q2251684","formula":"Na₂Cu(SO₄)₂·2H₂O","names":{"en":"Kröhnkite"},"elements":["H","O","Na","S","Cu"],"fame":10,"kind":"crystal"},{"id":"Q3855561","formula":"Na₆K₂FeFe₆(SO₄)₁₂O₂·18H₂O","names":{"en":"Metavoltine
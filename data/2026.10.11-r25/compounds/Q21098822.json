{"version":"2026.10.11-r25","id":"Q21098822","formula":"C₁₀H₁₃NO","hill":"C10H13NO","elements":["H","C","N","O"],"composition":{"C":10.0,"H":13.0,"N":1.0,"O":1.0},"names":{"en":"MEAI"},"descriptions":{"en":"MEAI, also known as 5-methoxy-2-aminoindane (5-MeO-AI) and by its developmental code name CMND-100, is an entactogen-like psychoactive drug of the 2-aminoindane family. It is a cyclized phenethylamine and is the 2-aminoindane analogue of 3-methoxyamphetamine. The drug acts as a serotonin–norepinephrine releasing agent (SNRA) or as a modestly selective serotonin releasing agent (SSRA), with about 6-fold preference for the induction of serotonin over norepinephrine release."},"fame":5,"pubchemCid":12147687,"mass":163.22,"charge":0,"smiles":"COC1=CC2=C(CC(C2)N)C=C1","inchikey":"HLXHCNWEVQNNKA-UHFFFAOYSA-N","iupac":"5-methoxy-2,3-dihydro-1H-inden-2-amine","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"12147687","atoms":25,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-3.262,"y":0.131,"z":0.013,"el":"O"},{"x":3.971,"y":0.779,"z":-0.147,"el":"N"},{"x":2.665,"y":0.406,"z":0.372,"el":"C"},{"x":1.553,"y":1.368,"z":-0.091,"el":"C"},{"x":2.235,"y":-1.004,"z":-0.08,"el":"C"},{"x":0.357,"y":0.469,"z":-0.028,"el":"C"},{"x":0.744,"y":-0.877,"z":-0.022,"el":"C"},{"x":-0.981,"y":0.828,"z":-0.022,"el":"C"},{"x":-0.199,"y":-1.891,"z":-0.011,"el":"C"},{"x":-1.938,"y":-0.189,"z":0.002,"el":"C"},{"x":-1.55,"y":-1.538,"z":0.008,"el":"C"},{"x":-3.594,"y":1.518,"z":0.007,"el":"C"},{"x":2.708,"y":0.425,"z":1.47,"el":"H"},{"x":1.699,"y":1.711,"z":-1.122,"el":"H"},{"x":1.466,"y":2.229,"z":0.578,"el":"H"},{"x":2.616,"y":-1.774,"z":0.596,"el":"H"},{"x":2.544,"y":-1.226,"z":-1.108,"el":"H"},{"x":-1.212,"y":1.886,"z":-0.04,"el":"H"},{"x":0.098,"y":-2.934,"z":-0.018,"el":"H"},{"x":3.951,"y":0.781,"z":-1.167,"el"
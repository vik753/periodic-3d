{"version":"2026.10.11-r25","id":"Q472476","formula":"C₂₀H₂₃NO","hill":"C20H23NO","elements":["H","C","N","O"],"composition":{"C":20.0,"H":23.0,"N":1.0,"O":1.0},"names":{"en":"Amitriptylinoxide"},"descriptions":{"en":"Amitriptylinoxide (brand names Amioxid, Ambivalon, Equilibrin), or amitriptyline N-oxide, is a tricyclic antidepressant (TCA) which was introduced in Europe in the 1970s for the treatment of depression. Amitriptylinoxide is both an analogue and metabolite of amitriptyline, and has similar effects as well as equivalent efficacy as an antidepressant. However, it has a faster onset of action and fewer adverse effects, including reduced drowsiness, sedation, anticholinergic symptoms like dry mouth, sweating, and dizziness, orthostatic hypotension, and cardiotoxicity."},"fame":7,"pubchemCid":20313,"mass":293.4,"charge":0,"smiles":"C[N+](C)(CCC=C1C2=CC=CC=C2CCC3=CC=CC=C31)[O-]","inchikey":"ZPMKQFOGINQDAM-UHFFFAOYSA-N","iupac":"N,N-dimethyl-3-(2-tricyclo[9.4.0.03,8]pentadeca-1(15),3,5,7,11,13-hexaenylidene)propan-1-amine oxide","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"20313","atoms":45,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-4.659,"y":1.254,"z":-1.02,"el":"O"},{"x":-4.298,"y":1.153,"z":0.305,"el":"N"},{"x":0.546,"y":0.361,"z":-0.314,"el":"C"},{"x":2.79,"y":-0.879,"z":1.464,"el":"C"},{"x":1.392,"y":-1.38,"z":1.829,"el":"C"},{"x":-2.889,"y":1.583,"z":0.481,"el":"C"},{"x":1.915,"y":0.931,"z":-0.205,"el":"C"},{"x":0.262,"y":-1.086,"z":-0.408,"el":"C"},{"x":2.926,"y":0.364,"z":0.602,"el":"C"},{"x":0.667,"y":-1.939,"z":0.632,"el":"C"},{"x":-1.938,"y":0.709,"z":-0.323,"el":"C"},{"x":-0.521,"y":1.179,"z":-0.227,"el":"C"},{"x":2.23,"y":2.063,"z":-0.99,"el":"C"},{"x":-0.4,"y":-1.618,"z":-1.525,"el":"C"},{"x":-5.218,"y":2.027,"z":1.121,"el":"C"},{"x":-4.468,"y":-0.28,"z":0.
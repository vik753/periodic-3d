{"version":"2026.10.11-r25","id":"Q121095754","formula":"C₂₆H₂₂N₂O₄","hill":"C26H22N2O4","elements":["H","C","N","O"],"composition":{"C":26.0,"H":22.0,"N":2.0,"O":4.0},"names":{"en":"AOH1996"},"descriptions":{"en":"AOH1996 is an experimental anticancer medication which acts as a small molecule inhibitor of proliferating cell nuclear antigen (PCNA) and is in Phase I clinical trials at City of Hope as of August 2023 for the treatment of solid tumors. AOH1996 was created to target a post-translationally modified isoform of PCNA, termed caPCNA, which is preferentially found in cancer cells. PCNA is crucial in the body for DNA repair, but targeting it is difficult because of its role in healthy cells."},"fame":6,"pubchemCid":126718388,"mass":426.5,"charge":0,"smiles":"COC1=CC(=CC=C1)OC2=CC=CC=C2NC(=O)CNC(=O)C3=CC=CC4=CC=CC=C43","inchikey":"HDMONPHKMIZXDH-UHFFFAOYSA-N","iupac":"N-[2-[2-(3-methoxyphenoxy)anilino]-2-oxoethyl]naphthalene-1-carboxamide","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"rdkit","ref":"126718388","atoms":54,"license":"Computed with RDKit from SMILES (PubChem, Wikidata)"},"structure":{"kind":"molecule","atoms":[{"x":4.468,"y":4.365,"z":1.582,"el":"C"},{"x":3.416,"y":3.673,"z":0.924,"el":"O"},{"x":3.568,"y":2.323,"z":0.765,"el":"C"},{"x":2.481,"y":1.679,"z":0.168,"el":"C"},{"x":2.514,"y":0.304,"z":-0.067,"el":"C"},{"x":3.622,"y":-0.447,"z":0.329,"el":"C"},{"x":4.71,"y":0.191,"z":0.924,"el":"C"},{"x":4.686,"y":1.573,"z":1.138,"el":"C"},{"x":1.389,"y":-0.25,"z":-0.634,"el":"O"},{"x":1.573,"y":-1.247,"z":-1.571,"el":"C"},{"x":2.353,"y":-1.019,"z":-2.71,"el":"C"},{"x":2.493,"y":-2.025,"z":-3.663,"el":"C"},{"x":1.842,"y":-3.244,"z":-3.482,"el":"C"},{"x":1.043,"y":-3.462,"z":-2.354,"el":"C"},{"x":0.891,"y":-2.463,"z":-1.39,"el":"C"},{"x":0.094,"y":-2.605,"z":-0.233,"el":"N"},{"x":-0.695,"y":-3.679,"z":0.136,"el":"C"},{"x":-0.8
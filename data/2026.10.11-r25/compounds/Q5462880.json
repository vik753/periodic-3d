{"version":"2026.10.11-r25","id":"Q5462880","formula":"C₂₁H₂₄F₃N","hill":"C21H24F3N","elements":["H","C","N","F"],"composition":{"C":21.0,"F":3.0,"H":24.0,"N":1.0},"names":{"en":"Fluotracen"},"descriptions":{"en":"Fluotracen (SKF-28,175) is a tricyclic drug which has both antidepressant and antipsychotic activity. This profile of effects is similar to that of related agents like amoxapine, loxapine, and trimipramine which may also be used in the treatment of both depression and psychosis. It was believed that such duality would be advantageous in the treatment of schizophrenia, as depression is often comorbid with the disorder and usual antipsychotics often worsen such symptoms."},"fame":6,"pubchemCid":42291,"mass":347.4,"charge":0,"smiles":"CC1C2=C(C=C(C=C2)C(F)(F)F)C(C3=CC=CC=C13)CCCN(C)C","inchikey":"JTAJFHGSVCEPKC-UHFFFAOYSA-N","iupac":"N,N-dimethyl-3-[10-methyl-2-(trifluoromethyl)-9,10-dihydroanthracen-9-yl]propan-1-amine","classes":[{"qid":"Q59199015","names":{"en":"group of stereoisomers","ru":"группа стереоизомеров","uk":"група стереоізомерів"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"42291","atoms":49,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-5.312,"y":0.196,"z":0.469,"el":"F"},{"x":-4.763,"y":0.664,"z":-1.576,"el":"F"},{"x":-4.368,"y":-1.318,"z":-0.773,"el":"F"},{"x":1.725,"y":-3.926,"z":0.778,"el":"N"},{"x":0.597,"y":0.432,"z":-1.332,"el":"C"},{"x":0.893,"y":1.878,"z":1.308,"el":"C"},{"x":-0.585,"y":0.702,"z":-0.417,"el":"C"},{"x":1.925,"y":1.0,"z":-0.862,"el":"C"},{"x":0.741,"y":-1.091,"z":-1.538,"el":"C"},{"x":-0.433,"y":1.306,"z":0.84,"el":"C"},{"x":2.076,"y":1.604,"z":0.395,"el":"C"},{"x":1.176,"y":-1.769,"z":-0.249,"el":"C"},{"x":-1.873,"y":0.307,"z":-0.833,"el":"C"},{"x":0.747,"y":3.402,"z":1.504,"el":"C"},{"x":3.049,"y":0.892,"z":-1.706,"el":"C"},{"x":-1.557,"y":1.412,"z":1.685,"el":"C"},{"x":3.364,"y":1.997,"z":0.812,"el":"C"},{"x":1.288,"y":-3.279,"z":-0.454,"el":"C"},{"x":-2.979,"
{"version":"2026.10.11-r25","id":"Q7136602","formula":"C₁₂H₁₆ClN₃O₂","hill":"C12H16ClN3O2","elements":["H","C","N","O","Cl"],"composition":{"C":12.0,"H":16.0,"N":3.0,"O":2.0,"Cl":1.0},"names":{"en":"Pardoprunox hydrochloride"},"descriptions":{"en":"Pardoprunox (INN; code name SLV-308) is an antiparkinsonian drug developed by Solvay for the treatment of Parkinson's disease that reached phase III clinical trials before being discontinued.[1] It was also being investigated for the treatment of depression and anxiety but these indications appear to have been abandoned as well. Pardoprunox acts as a D2 (pKi = 8.1) and D3 receptor (pKi = 8.6) partial agonist (IA = 50% and 67%, respectively) and 5-HT1A receptor (pKi = 8.5) full agonist (IA = 100%). It also binds to D4 (pKi = 7.8), α1-adrenergic (pKi = 7.8), α2-adrenergic (pKi = 7.4), and 5-HT7 receptors (pKi = 7.2) with lower affinity."},"fame":4,"pubchemCid":6918524,"mass":269.73,"charge":0,"smiles":"CN1CCN(CC1)C2=CC=CC3=C2OC(=O)N3.Cl","inchikey":"NQRIKTDKFHAOKC-UHFFFAOYSA-N","iupac":"7-(4-methylpiperazin-1-yl)-3H-1,3-benzoxazol-2-one;hydrochloride","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"rdkit","ref":"6918524","atoms":34,"license":"Computed with RDKit from SMILES (PubChem, Wikidata)"},"structure":{"kind":"molecule","atoms":[{"x":-4.015,"y":-0.418,"z":0.306,"el":"C"},{"x":-2.842,"y":0.073,"z":-0.41,"el":"N"},{"x":-2.019,"y":-1.03,"z":-0.946,"el":"C"},{"x":-0.797,"y":-1.437,"z":-0.088,"el":"C"},{"x":0.081,"y":-0.286,"z":0.185,"el":"N"},{"x":-0.543,"y":1.045,"z":0.08,"el":"C"},{"x":-2.042,"y":0.97,"z":0.455,"el":"C"},{"x":1.447,"y":-0.445,"z":0.335,"el":"C"},{"x":1.999,"y":-1.666,"z":0.783,"el":"C"},{"x":3.388,"y":-1.867,"z":0.959,"el":"C"},{"x":4.294,"y":-0.846,"z":0.692,"el":"C"},{"x":3.755,"y":0.339,"z":0.259,"el":"C"},{"x":2.394,"y":0.546,"z":0.088,"el":"C"},{"x":2.144,"y":1.837,"z":
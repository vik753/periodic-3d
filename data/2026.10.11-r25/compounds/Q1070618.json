{"version":"2026.10.11-r25","id":"Q1070618","formula":"Mn₇(AsO₄)₂(OH)₈","hill":"As2H8Mn7O16","elements":["H","O","Mn","As"],"composition":{"H":8.0,"O":16.0,"As":2.0,"Mn":7.0},"names":{"en":"Allactite","uk":"Алактит"},"descriptions":{"en":"Allactite is a rare arsenate mineral of metamorphosed manganese zinc ore deposits. It is found in Sweden and New Jersey, US. Its name originated from the Greek αλλάκτειν (allaktein) meaning \"to change\", referring to the strong pleochroism of the mineral.","uk":"Алактит — рідкісний арсенатний мінерал метаморфізованих родовищ марганцево-цинкових руд. Зустрічається в Швеції та Нью-Джерсі, США. Його назва походить від грецького αλλάκτειν (аллактеїн), що означає «змінюватися», через сильний плеохроїзм."},"fame":14,"pubchemCid":null,"mass":null,"charge":0,"smiles":null,"inchikey":null,"iupac":null,"classes":[{"qid":"Q12089225","names":{"en":"mineral species","ru":"действительный вид минералов","uk":"мінеральний вид"}}],"structureInfo":null,"structure":null,"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q1070618","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Allactite","license":"CC BY-SA 4.0"},{"role":"description","name":"Wikipedia (uk)","url":"https://uk.wikipedia.org/wiki/%D0%90%D0%BB%D0%B0%D0%BA%D1%82%D0%B8%D1%82","license":"CC BY-SA 4.0"},{"role":"photo","name":"Wikimedia Commons","url":"https://commons.wikimedia.org/wiki/File:Allactite-116056.jpg","license":"CC BY-SA 3.0"}],"similar":[{"id":"Q401047","formula":"MnO(OH)","names":{"en":"Manganite","ru":"Манганит","uk":"Манґаніт"},"elements":["H","O","Mn"],"fame":35,"kind":"crystal"},{"id":"Q304018","formula":"MnO(OH)","names":{"en":"Groutite","uk":"Граутит"},"elements":["H","O","Mn"],"fame":11,"kind":"crystal"},{"id":"Q19862051","formula":"Mn₇(PO₄)₂(OH)₈","names":{"en":"Waterhouseite"},"elements":["H","O","P","Mn"],"fame":4,"kind":null},{"id":"Q4291509","formula":"HMnO₂","names":{"en":"M
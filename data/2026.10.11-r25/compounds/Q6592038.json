{"version":"2026.10.11-r25","id":"Q6592038","formula":"C₂₀H₁₉N₇O₂","hill":"C20H19N7O2","elements":["H","C","N","O"],"composition":{"C":20.0,"H":19.0,"N":7.0,"O":2.0},"names":{"en":"Sch-442416"},"descriptions":{"en":"SCH-442,416 is a highly selective adenosine A2a subtype receptor antagonist. It is widely used in its 11C radiolabelled form to map the distribution of A2a receptors in the brain, where they are mainly found in the striatum, nucleus accumbens, and olfactory tubercle. Given its distribution in the brain, A2a receptors have been investigated for the treatment of various neurological disorders, and SCH-442,416 has shown promise in treatment of depression, Parkinson's disease, and catalepsy."},"fame":6,"pubchemCid":10668061,"mass":389.4,"charge":0,"smiles":"COC1=CC=C(C=C1)CCCN2C3=C(C=N2)C4=NC(=NN4C(=N3)N)C5=CC=CO5","inchikey":"AEULVFLPCJOBCE-UHFFFAOYSA-N","iupac":"4-(furan-2-yl)-10-[3-(4-methoxyphenyl)propyl]-3,5,6,8,10,11-hexazatricyclo[7.3.0.02,6]dodeca-1(9),2,4,7,11-pentaen-7-amine","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"10668061","atoms":48,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-6.578,"y":1.447,"z":0.796,"el":"O"},{"x":7.715,"y":2.423,"z":0.473,"el":"O"},{"x":0.468,"y":-2.039,"z":-0.543,"el":"N"},{"x":-2.822,"y":-0.483,"z":0.947,"el":"N"},{"x":0.388,"y":-1.881,"z":-1.885,"el":"N"},{"x":-0.796,"y":-1.569,"z":1.478,"el":"N"},{"x":-3.605,"y":0.09,"z":-1.033,"el":"N"},{"x":-4.0,"y":0.093,"z":1.24,"el":"N"},{"x":-2.295,"y":-0.952,"z":3.211,"el":"N"},{"x":1.626,"y":-2.684,"z":0.03,"el":"C"},{"x":2.781,"y":-1.744,"z":0.398,"el":"C"},{"x":-0.612,"y":-1.544,"z":0.126,"el":"C"},{"x":-1.431,"y":-1.038,"z":-0.857,"el":"C"},{"x":3.375,"y":-0.957,"z":-0.78,"el":"C"},{"x":-2.604,"y":-0.476,"z":-0.41,"el":"C"},{"x":-0.788,"y":-1.263,"z":-2.068,"el":"C"},{"x":4.536,"y":-0
{"version":"2026.10.11-r25","id":"Q7339206","formula":"C₁₅H₁₈N₂O","hill":"C15H18N2O","elements":["H","C","N","O"],"composition":{"C":15.0,"H":18.0,"N":2.0,"O":1.0},"names":{"en":"(2S)-1-(7-methoxy-4H-indeno[1,2-b]pyrrol-1-yl)propan-2-amine"},"descriptions":{"en":"Ro60-0213 (Org 35032) is a drug developed by Hoffmann–La Roche, which acts as a potent and selective agonist for the 5-HT2C serotonin receptor, with more than 100x selectivity over other closely related serotonin receptor subtypes, and little or no affinity at other receptors. It was developed as a potential antidepressant, but was discontinued from clinical development at an early stage due to toxicity concerns. However the high selectivity of Ro60-0213 for 5-HT2C makes it of continued interest for research into serotonin receptors."},"fame":4,"pubchemCid":3045239,"mass":242.32,"charge":0,"smiles":"C[C@@H](CN1C=CC2=C1C3=C(C2)C=CC(=C3)OC)N","inchikey":"OTCPUISFVUWAGR-JTQLQIEISA-N","iupac":"(2S)-1-(7-methoxy-4H-indeno[1,2-b]pyrrol-1-yl)propan-2-amine","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"3045239","atoms":36,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-3.35,"y":2.059,"z":0.075,"el":"O"},{"x":1.818,"y":-0.353,"z":0.517,"el":"N"},{"x":2.827,"y":3.206,"z":-0.057,"el":"N"},{"x":0.607,"y":-0.879,"z":0.236,"el":"C"},{"x":0.71,"y":-2.232,"z":0.034,"el":"C"},{"x":-0.597,"y":-2.886,"z":-0.282,"el":"C"},{"x":-0.74,"y":-0.445,"z":0.09,"el":"C"},{"x":-1.472,"y":-1.623,"z":-0.218,"el":"C"},{"x":2.133,"y":1.028,"z":0.791,"el":"C"},{"x":2.061,"y":-2.574,"z":0.196,"el":"C"},{"x":2.729,"y":-1.393,"z":0.495,"el":"C"},{"x":2.488,"y":1.84,"z":-0.464,"el":"C"},{"x":-1.332,"y":0.795,"z":0.195,"el":"C"},{"x":-2.839,"y":-1.551,"z":-0.425,"el":"C"},{"x":-2.711,"y":0.859,"z":-0.016,"el":"C"},{"x":3.671,"y":1.25,"z":-1.23,"el":"C"},{"x":-3.
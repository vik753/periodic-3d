{"version":"2026.10.11-r25","id":"Q6758994","formula":"C₂₂H₃₂O₄","hill":"C22H32O4","elements":["H","C","O"],"composition":{"C":22.0,"H":32.0,"O":4.0},"names":{"en":"Maresin"},"descriptions":{"en":"Maresin 1 (MaR1 or 7R,14S-dihydroxy-4Z,8E,10E,12Z,16Z,19Z-docosahexaenoic acid) is a macrophage-derived mediator of inflammation resolution coined from macrophage mediator in resolving inflammation. Maresin 1, and more recently defined maresins, are 12-lipoxygenase-derived metabolites of the omega-3 fatty acid, docosahexaenoic acid (DHA), that possess potent anti-inflammatory, pro-resolving, protective, and pro-healing properties similar to a variety of other members of the specialized proresolving mediators (SPM) class of polyunsaturated fatty acid (PUFA) metabolites."},"fame":2,"pubchemCid":null,"mass":null,"charge":0,"smiles":null,"inchikey":null,"iupac":null,"classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":null,"structure":null,"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q6758994","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Maresin","license":"CC BY-SA 4.0"}],"similar":[{"id":"Q422543","formula":"C₂₁H₃₀O₄","names":{"en":"Corticosterone","ru":"Кортикостерон"},"elements":["H","C","O"],"fame":31,"kind":"molecule"},{"id":"Q20817139","formula":"C₂₂H₃₂O₄","names":{"en":"Iloprost","uk":"Ілопрост"},"elements":["H","C","O"],"fame":17,"kind":"molecule"},{"id":"Q739648","formula":"C₁₈H₂₆O₃","names":{"en":"Octinoxate"},"elements":["H","C","O"],"fame":16,"kind":"molecule"},{"id":"Q3881822","formula":"C₁₁H₁₆O₂","names":{"en":"Olivetol","ru":"Оливетол"},"elements":["H","C","O"],"fame":14,"kind":"molecule"},{"id":"Q2064915","formula":"C₂₁H₃₀O₄","names":{"en":"11-deoxycortisol","ru":"11-деоксикортизол"},"elements":["H","C","O"],"fame":11,"kind":"molecule"},{"id":"Q665725","formula":"C₂₀H
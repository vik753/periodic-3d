{"version":"2026.10.11-r25","id":"Q7339200","formula":"C₂₂H₂₇NO₂","hill":"C22H27NO2","elements":["H","C","N","O"],"composition":{"C":22.0,"H":27.0,"N":1.0,"O":2.0},"names":{"en":"Ro4-1539"},"descriptions":{"en":"Ro4-1539 (furethylnorlevorphanol) is an opioid analgesic drug from the morphinan series that was discovered by the pharmaceutical company Hoffmann–La Roche in the 1950s. It acts as a potent μ-opioid agonist, and was found to be around 30-60 times more potent than the related drug levorphanol in animal experiments. Although it has high potency, long duration, and good therapeutic index (1100 in animal studies), Ro4-1539 had no particular clinical advantages over other available opioid drugs, and was never commercially marketed."},"fame":6,"pubchemCid":20834001,"mass":337.5,"charge":0,"smiles":"C1CC[C@@]23CCN([C@@H]([C@@H]2C1)CC4=C3C=C(C=C4)O)CCC5=CC=CO5","inchikey":"ANCZOEKEGCHEKY-KSEOMHKRSA-N","iupac":"(1R,9R,10R)-17-[2-(furan-2-yl)ethyl]-17-azatetracyclo[7.5.3.01,10.02,7]heptadeca-2(7),3,5-trien-4-ol","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"20834001","atoms":52,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":5.689,"y":1.327,"z":-1.335,"el":"O"},{"x":-5.213,"y":-0.088,"z":0.81,"el":"O"},{"x":-1.008,"y":0.824,"z":0.392,"el":"N"},{"x":1.249,"y":-0.787,"z":-0.689,"el":"C"},{"x":0.394,"y":-1.261,"z":0.517,"el":"C"},{"x":-0.145,"y":-0.021,"z":1.254,"el":"C"},{"x":0.315,"y":0.037,"z":-1.618,"el":"C"},{"x":1.735,"y":-2.053,"z":-1.448,"el":"C"},{"x":1.151,"y":-2.241,"z":1.436,"el":"C"},{"x":2.386,"y":0.142,"z":-0.223,"el":"C"},{"x":1.017,"y":0.809,"z":1.838,"el":"C"},{"x":-0.386,"y":1.193,"z":-0.887,"el":"C"},{"x":2.496,"y":-3.031,"z":-0.551,"el":"C"},{"x":1.662,"y":-3.449,"z":0.655,"el":"C"},{"x":2.249,"y":0.896,"z":0.965,"el":"C"},{"x":-2.331,"y":0.232,"z":0.188,"el":"C"},{"x
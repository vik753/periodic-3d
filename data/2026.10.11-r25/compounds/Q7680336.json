{"version":"2026.10.11-r25","id":"Q7680336","formula":"C₁₇H₃₁N₇O₉","hill":"C17H31N7O9","elements":["H","C","N","O"],"composition":{"C":17.0,"H":31.0,"N":7.0,"O":9.0},"names":{"en":"Taltirelin"},"descriptions":{"en":"Taltirelin (marketed under the tradename Ceredist) is a thyrotropin-releasing hormone (TRH) analog, which mimics the physiological actions of TRH, but with a much longer half-life and duration of effects, and little development of tolerance following prolonged dosing. It has nootropic, neuroprotective and analgesic effects. Taltirelin is primarily being researched for the treatment of spinocerebellar ataxia; limited research has also been carried out with regard to other neurodegenerative disorders, e.g., spinal muscular atrophy."},"fame":4,"pubchemCid":114750,"mass":405.4,"charge":0,"smiles":"CN1C(=O)C[C@H](NC1=O)C(=O)N[C@@H](CC2=CN=CN2)C(=O)N3CCC[C@H]3C(=O)N","inchikey":"LQZAIAZUDWIVPM-SRVKXCTJSA-N","iupac":"(4S)-N-[(2S)-1-[(2S)-2-carbamoylpyrrolidin-1-yl]-3-(1H-imidazol-5-yl)-1-oxopropan-2-yl]-1-methyl-2,6-dioxo-1,3-diazinane-4-carboxamide","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":null,"structure":null,"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q7680336","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Taltirelin","license":"CC BY-SA 4.0"},{"role":"properties","name":"PubChem","url":"https://pubchem.ncbi.nlm.nih.gov/compound/114750","license":"PubChem (NIH), public data"}],"similar":[{"id":"Q186242","formula":"C₈H₁₁NO₃","names":{"en":"Norepinephrine","ru":"Норадреналин","uk":"Норадреналін"},"elements":["H","C","N","O"],"fame":65,"kind":"molecule"},{"id":"Q423746","formula":"C₈H₁₁NO₃","names":{"en":"Pyridoxine","ru":"Пиридоксин","uk":"Піридоксин"},"elements":["H","C","N","O"],"fame":49,"kind":"molecule"},{"id":"Q412621","formula":"C₁₀H₁₃NO₄","names":
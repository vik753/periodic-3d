{"version":"2026.10.11-r25","id":"Q3645332","formula":"Al·Cu·Ni","hill":"AlCuNi","elements":["Al","Ni","Cu"],"composition":{"Al":1.0,"Cu":1.0,"Ni":1.0},"names":{"en":"Bronzital","ru":"Бронзитал","uk":"Бронзітал"},"descriptions":{"ru":"Бронзитал (итал. bronzital — дословно «итальянская бронза») — сплав, вариант алюминиевой бронзы, состоящий из меди и алюминия, первоначально использовавшийся для производства монет Римского монетного двора. С 1968 года в сплав добавляют никель, чтобы сделать его более ярким и менее склонным к окислению.","uk":"Бронзіта́л (італ. bronzital акронім від італ. bronzo italiano, дослівно — «італійська бронза») — сплав міді (82 %) з алюмінієм (16 %), різновид алюмінієвої бронзи, що на початках використовувався для виготовлення монет Римським монетним двором."},"fame":4,"pubchemCid":null,"mass":null,"charge":0,"smiles":null,"inchikey":null,"iupac":null,"classes":[{"qid":"Q37756","names":{"en":"alloy","ru":"сплав","uk":"сплави"}}],"structureInfo":null,"structure":null,"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q3645332","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (ru)","url":"https://ru.wikipedia.org/wiki/%D0%91%D1%80%D0%BE%D0%BD%D0%B7%D0%B8%D1%82%D0%B0%D0%BB","license":"CC BY-SA 4.0"},{"role":"description","name":"Wikipedia (uk)","url":"https://uk.wikipedia.org/wiki/%D0%91%D1%80%D0%BE%D0%BD%D0%B7%D1%96%D1%82%D0%B0%D0%BB","license":"CC BY-SA 4.0"}],"similar":[{"id":"Q658684","formula":"Al·Co·Cu·Fe·Ni","names":{"en":"Alnico","ru":"Альнико","uk":"Алніко"},"elements":["Al","Fe","Co","Ni","Cu"],"fame":29,"kind":null},{"id":"Q772913","formula":"Al·Cu·Zn","names":{"en":"Devarda's alloy","ru":"Сплав Деварда"},"elements":["Al","Cu","Zn"],"fame":18,"kind":null},{"id":"Q18212243","formula":"Ni₂Cr","names":{"en":"Dinickel chromium","ru":"Хромдиникель"},"elements":["Cr","Ni"],"fame":1,"kind":"crystal"},{"id":"Q112260","formula":"Al·Cu·Sn·Zn","names":{"en":"Nordic gold","ru":"Северное золото","uk":"П
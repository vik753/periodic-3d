{"version":"2026.10.11-r25","id":"Q5322471","formula":"C₁₈H₂₅NO₃","hill":"C18H25NO3","elements":["H","C","N","O"],"composition":{"C":18.0,"H":25.0,"N":1.0,"O":3.0},"names":{"en":"EA-3580"},"descriptions":{"en":"EA-3580 is a potent anticholinergic deliriant drug with a fairly long duration of action, related to the chemical warfare agent 3-Quinuclidinyl benzilate (QNB). It was developed under contract to Edgewood Arsenal during the 1960s as part of the US military chemical weapons program, during research to improve upon the properties of earlier agents such as QNB. EA-3580 is closely related to the similar compound EA-3443, and has similar potency and high central to peripheral effects ratio, but with a duration of action around half as long, although effects of EA-3580 can still persist for 24 hours or more following high doses."},"fame":3,"pubchemCid":171342,"mass":303.4,"charge":0,"smiles":"CN1CCC(CC1)OC(=O)C(C2CCC2)(C3=CC=CC=C3)O","inchikey":"LOBGXFLATZQVKC-UHFFFAOYSA-N","iupac":"(1-methylpiperidin-4-yl) 2-cyclobutyl-2-hydroxy-2-phenylacetate","classes":[{"qid":"Q59199015","names":{"en":"group of stereoisomers","ru":"группа стереоизомеров","uk":"група стереоізомерів"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"171342","atoms":47,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":2.182,"y":1.009,"z":-1.731,"el":"O"},{"x":-0.783,"y":0.687,"z":0.093,"el":"O"},{"x":-0.332,"y":0.204,"z":-2.114,"el":"O"},{"x":-4.745,"y":-0.619,"z":0.441,"el":"N"},{"x":1.749,"y":1.553,"z":0.545,"el":"C"},{"x":1.483,"y":3.021,"z":0.152,"el":"C"},{"x":3.226,"y":1.953,"z":0.741,"el":"C"},{"x":2.724,"y":3.39,"z":0.992,"el":"C"},{"x":1.507,"y":0.545,"z":-0.559,"el":"C"},{"x":2.06,"y":-0.802,"z":-0.106,"el":"C"},{"x":0.043,"y":0.45,"z":-0.975,"el":"C"},{"x":-2.178,"y":0.635,"z":-0.176,"el":"C"},{"x":-2.944,"y":0.938,"z":1.107,"el":"C"},{"x":-2.557,"y":-0.747,"z":-0.703,"el":"C"},{"x":-4.447,"y":0.739,"z":0.918,"el":"C"},{"x":-4.072,"y":-0
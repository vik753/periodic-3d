{"version":"2026.10.11-r25","id":"Q76856074","formula":"C₂₅H₂₃ClN₄O₄","hill":"C25H23ClN4O4","elements":["H","C","N","O","Cl"],"composition":{"C":25.0,"H":23.0,"N":4.0,"O":4.0,"Cl":1.0},"names":{"en":"Nemtabrutinib"},"descriptions":{"en":"Nemtabrutinib (MK-1026, formerly ARQ 531) is a small molecule drug is a Bruton's tyrosine kinase (BTK) inhibitor; unlike first generation BTK inhibitors it does not bind covalently, and inhibits the ATP binding site of BTK, and was designed to inhibit Src family kinases and kinases related to ERK signalling, along with BTK. Merck paid $2.7 billion to acquire the company ArQule and the drug, which at the time had just completed a Phase I clinical trial as a treatment for B-cell cancers. As of December 2024 Merck had started Phase III trials in chronic lymphocytic leukaemia and other blood cancers, and had finished a Phase I trial for kidney disease."},"fame":1,"pubchemCid":129045720,"mass":478.9,"charge":0,"smiles":"C1C[C@H](OC[C@@H]1NC2=NC=NC3=C2C(=CN3)C(=O)C4=C(C=C(C=C4)OC5=CC=CC=C5)Cl)CO","inchikey":"JSFCZQSJQXFJDS-QAPCUYQASA-N","iupac":"(2-chloro-4-phenoxyphenyl)-[4-[[(3R,6S)-6-(hydroxymethyl)oxan-3-yl]amino]-7H-pyrrolo[2,3-d]pyrimidin-5-yl]methanone","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"rdkit","ref":"129045720","atoms":57,"license":"Computed with RDKit from SMILES (PubChem, Wikidata)"},"structure":{"kind":"molecule","atoms":[{"x":5.108,"y":-0.186,"z":0.718,"el":"C"},{"x":5.291,"y":1.328,"z":0.665,"el":"C"},{"x":5.841,"y":1.782,"z":-0.7,"el":"C"},{"x":5.576,"y":0.827,"z":-1.742,"el":"O"},{"x":4.27,"y":0.261,"z":-1.631,"el":"C"},{"x":4.166,"y":-0.669,"z":-0.4,"el":"C"},{"x":2.781,"y":-0.701,"z":0.077,"el":"N"},{"x":2.333,"y":-1.878,"z":0.673,"el":"C"},{"x":3.215,"y":-2.704,"z":1.291,"el":"N"},{"x":2.761,"y":-3.811,"z":1.905,"el":"C"},{"x":1.495,"y":-4.246,"z":1.993,"el":"N"},{"x":0.653,"y":-
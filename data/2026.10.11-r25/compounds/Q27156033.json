{"version":"2026.10.11-r25","id":"Q27156033","formula":"C₄₂H₅₀Cl₄N₂O₄","hill":"C42H50Cl4N2O4","elements":["H","C","N","O","Cl"],"composition":{"C":42.0,"H":50.0,"N":2.0,"O":4.0,"Cl":4.0},"names":{"en":"Estradiol mustard"},"descriptions":{"en":"Estradiol mustard, also known as estradiol 3,17β-bis(4-(bis(2-chloroethyl)amino)phenyl)acetate, is a semisynthetic, steroidal estrogen and cytostatic antineoplastic agent and a phenylacetic acid nitrogen mustard-coupled estrogen ester that was never marketed. It is selectively distributed into estrogen receptor (ER)-positive tissues such as ER-expressing tumors like those seen in breast and prostate cancers. For this reason, estradiol mustard and other cytostatic-linked estrogens like estramustine phosphate have reduced toxicity relative to non-linked nitrogen mustard cytostatic antineoplastic agents."},"fame":1,"pubchemCid":31586,"mass":788.7,"charge":0,"smiles":"C[C@]12CC[C@H]3[C@H]([C@@H]1CC[C@@H]2OC(=O)CC4=CC=C(C=C4)N(CCCl)CCCl)CCC5=C3C=CC(=C5)OC(=O)CC6=CC=C(C=C6)N(CCCl)CCCl","inchikey":"LRSFXIJGHRPOQQ-VZRQQIPSSA-N","iupac":"[(8R,9S,13S,14S,17S)-3-[2-[4-[bis(2-chloroethyl)amino]phenyl]acetyl]oxy-13-methyl-6,7,8,9,11,12,14,15,16,17-decahydrocyclopenta[a]phenanthren-17-yl] 2-[4-[bis(2-chloroethyl)amino]phenyl]acetate","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"rdkit","ref":"31586","atoms":102,"license":"Computed with RDKit from SMILES (PubChem, Wikidata)"},"structure":{"kind":"molecule","atoms":[{"x":2.967,"y":-0.452,"z":-2.276,"el":"C"},{"x":2.877,"y":-0.747,"z":-0.756,"el":"C"},{"x":2.272,"y":-2.142,"z":-0.548,"el":"C"},{"x":0.779,"y":-2.189,"z":-0.925,"el":"C"},{"x":-0.069,"y":-1.083,"z":-0.243,"el":"C"},{"x":0.581,"y":0.32,"z":-0.438,"el":"C"},{"x":2.029,"y":0.261,"z":0.048,"el":"C"},{"x":2.87,"y":1.533,"z":0.026,"el":"C"},{"x":4.319,"y":1.022,"z":0.08,"el":"C"},{"x":4.249,"y":-0.514,"z"
{"version":"2026.10.11-r25","id":"Q131198491","formula":"C₄₅H₅₄FN₇O₆","hill":"C45H54FN7O6","elements":["H","C","N","O","F"],"composition":{"C":45.0,"F":1.0,"H":54.0,"N":7.0,"O":6.0},"names":{"en":"Luxdegalutamide"},"descriptions":{"en":"Luxdegalutamide, also known as ARV-766 and JSB462, is an investigational oral androgen receptor (AR) degrader being developed by Arvinas for the treatment of metastatic castration-resistant prostate cancer (mCRPC). It belongs to a class of drugs called proteolysis targeting chimeras (PROTACs), which are designed to selectively degrade specific proteins by hijacking the ubiquitin-proteasome system. Luxdegalutamide is a second-generation PROTAC AR degrader that has demonstrated a broader efficacy profile and better tolerability compared to its predecessor, ARV-110, in clinical settings."},"fame":1,"pubchemCid":null,"mass":null,"charge":0,"smiles":"COC1=CC(O[C@H]2C(C)(C)[C@H](NC(=O)C3=CC=C(C=C3)N4CCC(CN5CCN(CC5)C6=CC=C(C(=O)N[C@H]7CCC(=O)NC7=O)C(F)=C6)CC4)C2(C)C)=CC=C1C#N","inchikey":null,"iupac":null,"classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"rdkit","ref":null,"atoms":113,"license":"Computed with RDKit from SMILES (PubChem, Wikidata)"},"structure":{"kind":"molecule","atoms":[{"x":-12.786,"y":2.314,"z":2.404,"el":"C"},{"x":-13.87,"y":1.423,"z":2.173,"el":"O"},{"x":-13.6,"y":0.229,"z":1.553,"el":"C"},{"x":-12.32,"y":-0.191,"z":1.164,"el":"C"},{"x":-12.143,"y":-1.426,"z":0.537,"el":"C"},{"x":-10.941,"y":-1.93,"z":0.105,"el":"O"},{"x":-9.698,"y":-1.347,"z":0.569,"el":"C"},{"x":-8.434,"y":-2.26,"z":0.382,"el":"C"},{"x":-8.74,"y":-3.683,"z":-0.1,"el":"C"},{"x":-7.555,"y":-2.317,"z":1.638,"el":"C"},{"x":-7.971,"y":-1.33,"z":-0.78,"el":"C"},{"x":-6.559,"y":-0.888,"z":-0.733,"el":"N"},{"x":-5.528,"y":-1.715,"z":-1.141,"el":"C"},{"x":-5.699,"y":-2.858,"z":-1.549,"el":"O"},{"x":-4.16,"y":-1.134,"z":-1.092,"el":"C
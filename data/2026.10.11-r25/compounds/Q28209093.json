{"version":"2026.10.11-r25","id":"Q28209093","formula":"C₁₄H₁₂N₂O₃","hill":"C14H12N2O3","elements":["H","C","N","O"],"composition":{"C":14.0,"H":12.0,"N":2.0,"O":3.0},"names":{"en":"N-(3,5-dimethyl-4-isoxazolylmethyl)phthalimide"},"descriptions":{"en":"DIMP (developmental code name Ro 7-8117), or N-(3,5-dimethyl-4-isoxazolylmethyl)phthalimide, is a nonsteroidal antiandrogen (NSAA) structurally related to thalidomide (which also binds to and antagonizes the androgen receptor (AR)) that was first described in 1973 and was never marketed. Along with flutamide, it was one of the earliest NSAAs to be discovered, and for this reason, has been described as a \"classical\" NSAA. The drug is a selective, competitive, silent antagonist of the AR, although it is described as an \"only relatively weak competitor\". Its relative binding affinity for the androgen receptor is about 2.6% of that of metribolone."},"fame":1,"pubchemCid":135035,"mass":256.26,"charge":0,"smiles":"CC1=C(C(=NO1)C)CN2C(=O)C3=CC=CC=C3C2=O","inchikey":"SHPRUADECKZSMQ-UHFFFAOYSA-N","iupac":"2-[(3,5-dimethyl-1,2-oxazol-4-yl)methyl]isoindole-1,3-dione","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"135035","atoms":31,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-3.679,"y":0.671,"z":-1.182,"el":"O"},{"x":0.494,"y":2.319,"z":0.727,"el":"O"},{"x":0.489,"y":-2.314,"z":0.715,"el":"O"},{"x":0.099,"y":0.003,"z":0.894,"el":"N"},{"x":-3.698,"y":-0.719,"z":-1.204,"el":"N"},{"x":-1.234,"y":0.004,"z":1.462,"el":"C"},{"x":-2.245,"y":0.008,"z":0.367,"el":"C"},{"x":2.088,"y":0.695,"z":0.06,"el":"C"},{"x":2.085,"y":-0.692,"z":0.057,"el":"C"},{"x":0.805,"y":1.149,"z":0.597,"el":"C"},{"x":0.801,"y":-1.145,"z":0.592,"el":"C"},{"x":-2.803,"y":1.092,"z":-0.234,"el":"C"},{"x":-2.826,"y":-1.091,"z":-0.263,"el":"C"},{"x":3.169,"y":1.424,"z":-0.39,"e
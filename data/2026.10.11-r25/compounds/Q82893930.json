{"version":"2026.10.11-r25","id":"Q82893930","formula":"C₁₅H₂₅NO₄","hill":"C15H25NO4","elements":["H","C","N","O"],"composition":{"C":15.0,"H":25.0,"N":1.0,"O":4.0},"names":{"en":"Aerocyanidin","ru":"Аэроцианидин"},"descriptions":{"ru":"Аэроцианидин — природный антибиотик, производное длинноцепочечных жирных кислот, в структуре которого присутствует редкая изоцианидная (изонитрильная) и эпоксидная группы. Впервые вещество было выделено в 1988 году американскими исследователями из культуральной жидкости грамотрицательной бактерии Chromobacterium violaceum (штамм ATCC 53434). Аэроцианидин демонстрирует высокую антибактериальную активность преимущественно против грамположительных бактерий, включая резистентные штаммы золотистого стафилококка (Staphylococcus aureus)."},"fame":3,"pubchemCid":85107779,"mass":283.36,"charge":0,"smiles":"CC1(C(O1)C(CCCCCCCCCC(=O)O)O)[N+]#[C-]","inchikey":"XDJFAHIIXLFHDP-UHFFFAOYSA-N","iupac":"11-hydroxy-11-(3-isocyano-3-methyloxiran-2-yl)undecanoic acid","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"rdkit","ref":"85107779","atoms":45,"license":"Computed with RDKit from SMILES (PubChem, Wikidata)"},"structure":{"kind":"molecule","atoms":[{"x":6.533,"y":0.47,"z":1.744,"el":"C"},{"x":5.575,"y":-0.609,"z":1.364,"el":"C"},{"x":4.259,"y":-0.249,"z":0.708,"el":"C"},{"x":4.342,"y":-0.571,"z":2.103,"el":"O"},{"x":3.489,"y":-1.233,"z":-0.115,"el":"C"},{"x":2.006,"y":-0.86,"z":-0.257,"el":"C"},{"x":1.738,"y":0.41,"z":-1.076,"el":"C"},{"x":0.247,"y":0.653,"z":-1.342,"el":"C"},{"x":-0.557,"y":0.929,"z":-0.069,"el":"C"},{"x":-1.989,"y":1.402,"z":-0.345,"el":"C"},{"x":-2.865,"y":0.333,"z":-1.003,"el":"C"},{"x":-4.296,"y":0.803,"z":-1.281,"el":"C"},{"x":-5.114,"y":1.241,"z":-0.06,"el":"C"},{"x":-5.245,"y":0.192,"z":1.044,"el":"C"},{"x":-6.026,"y":-1.02,"z":0.612,"el":"C"},{"x":-6.827,"y":-1.098,"z":-0.302,"el":"O"},{"x":-5.78
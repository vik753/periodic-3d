{"version":"2026.10.11-r25","id":"Q2252069","formula":"CuPb₂(CrO₄)(PO₄)(OH)","hill":"CrCuHO9PPb2","elements":["H","O","P","Cr","Cu","Pb"],"composition":{"H":1.0,"O":9.0,"P":1.0,"Cr":1.0,"Cu":1.0,"Pb":2.0},"names":{"en":"Vauquelinite","uk":"Вокеленіт"},"descriptions":{"en":"Vauquelinite is a complex mineral with the formula CuPb2(CrO4)(PO4)(OH) making it a combined chromate and phosphate of copper and lead. It forms a series with the arsenate mineral fornacite. It was first described in 1818 in the Beryozovskoye deposit, Urals, Russia, and named for Louis Vauquelin (1763–1829), a French chemist.","uk":"Вокеленіт (вокелініт) є складним мінералом з формулою CuPb2(CrO4)(PO4)(OH), що робить його комбінованим хроматом і фосфатом міді та свинцю. Утворює ряд з хромат-арсенатом міді — мінералом форнацитом. Вперше описаний у 1818 році на Березівському родовищі золота на Уралі і названий на честь Луї Ніколя Воклена (1763—1829), французького хіміка."},"fame":13,"pubchemCid":null,"mass":null,"charge":0,"smiles":null,"inchikey":null,"iupac":null,"classes":[{"qid":"Q12089225","names":{"en":"mineral species","ru":"действительный вид минералов","uk":"мінеральний вид"}}],"structureInfo":null,"structure":null,"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q2252069","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Vauquelinite","license":"CC BY-SA 4.0"},{"role":"description","name":"Wikipedia (uk)","url":"https://uk.wikipedia.org/wiki/%D0%92%D0%BE%D0%BA%D0%B5%D0%BB%D0%B5%D0%BD%D1%96%D1%82","license":"CC BY-SA 4.0"},{"role":"photo","name":"Wikimedia Commons","url":"https://commons.wikimedia.org/wiki/File:Vauquelinite-544001.jpg","license":"CC BY-SA 3.0"}],"similar":[{"id":"Q3784779","formula":"ZnPb₁₀(CrO₄)₆(SiO₄)₂(OH)₂","names":{"en":"Hemihedrite","uk":"Геміедрит"},"elements":["H","O","Si","Cr","Zn","Pb"],"fame":8,"kind":null},{"id":"Q3660390","formula":"PbFe₂(AsO₄)₂(OH)₂","names":{"en":"Carminite","ru":"Карминит","uk":"Кармініт"},"elements":["H","O","Fe","As","Pb"],"fame":13,"kind":"crystal"},{"id":"Q1065167","formula":"CuPb₂(CrO₄)(AsO₄)(OH)","names":{"en":"Fornacite","uk":"Форнацит"},"elements":["H","O","Cr","Cu","As","Pb"],"fame":11,"kind":null},{"id":"Q3814879","formula":"Cu₃Zn₄Cd₂(AsO₄)₆*2H₂O","names":{"en":"Keyite","uk":"Кеїт"},"elements":["H","O","Cu","Zn","As","Cd"],"fame":9,"kind":null},{"id":"Q410207","formula":"Pb₂Cu(PO₄)(SO₄)(OH)","names":{"en":"Tsumebite","uk":"Тсумебіт"},"elements":["H","O","P","S","Cu","Pb"],"fame":10,"kind":null},{"id":"Q421037","formula":"CaCuAsO₄(OH)","names":{"en":"Conichalcite","ru":"Конихальцит","uk":"Коніхальцит"},"elements":["H","O","Ca","Cu","As"],"fame":16,"kind":"crystal"},{"id":"Q422903","formula":"PbCrO₄","names":{"en":"Crocoite","ru":"Крокоит","uk":"Крокоїт"},"elements":["O","Cr","Pb"],"fame":33,"kind":"crystal"},{"id":"Q367871","formula":"CrO₄Pb","names":{"en":"Lead(II) chromate","ru":"Хромат свинца(II)"},"elements":["O","Cr","Pb"],"fame":27,"kind":"crystal"}],"photo":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/21/Vauquelinite-544001.jpg/960px-Vauquelinite-544001.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Vauquelinite-544001.jpg","license":"CC BY-SA 3.0","author":"Christian Rewitzer","licenseUrl":"https://creativecommons.org/licenses/by-sa/3.0"}}
{"version":"2026.10.11-r25","id":"Q408570","formula":"C₁₂H₈O₄","hill":"C12H8O4","elements":["H","C","O"],"composition":{"C":12.0,"H":8.0,"O":4.0},"names":{"en":"Methoxsalen"},"descriptions":{"en":"Methoxsalen (or Xanthotoxin, 8-methoxypsoralen) sold under the brand name Oxsoralen and Melanocyl among others, is a medication used to treat psoriasis, eczema, vitiligo, and some cutaneous lymphomas in conjunction with exposing the skin to ultraviolet (UVA) light from lamps or sunlight. Methoxsalen modifies the way skin cells receive the UVA radiation, allegedly clearing up the disease. Levels of individual patient PUVA exposure were originally determined using the Fitzpatrick scale."},"fame":11,"pubchemCid":4114,"mass":216.19,"charge":0,"smiles":"COC1=C2C(=CC3=C1OC=C3)C=CC(=O)O2","inchikey":"QXKHYNVANLEOEG-UHFFFAOYSA-N","iupac":"9-methoxyfuro[3,2-g]chromen-7-one","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"4114","atoms":24,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":2.926,"y":-0.684,"z":0.185,"el":"O"},{"x":-1.907,"y":-0.902,"z":0.137,"el":"O"},{"x":0.486,"y":-2.272,"z":0.318,"el":"O"},{"x":-4.197,"y":-0.899,"z":0.104,"el":"O"},{"x":1.71,"y":1.208,"z":-0.034,"el":"C"},{"x":1.664,"y":-0.176,"z":0.112,"el":"C"},{"x":-0.711,"y":1.21,"z":-0.07,"el":"C"},{"x":-0.694,"y":-0.177,"z":0.078,"el":"C"},{"x":0.487,"y":-0.918,"z":0.174,"el":"C"},{"x":0.498,"y":1.92,"z":-0.128,"el":"C"},{"x":3.089,"y":1.547,"z":-0.05,"el":"C"},{"x":-1.994,"y":1.888,"z":-0.161,"el":"C"},{"x":3.781,"y":0.367,"z":0.086,"el":"C"},{"x":-3.133,"y":1.193,"z":-0.103,"el":"C"},{"x":-3.144,"y":-0.273,"z":0.052,"el":"C"},{"x":1.137,"y":-3.033,"z":-0.699,"el":"C"},{"x":0.509,"y":3.001,"z":-0.243,"el":"H"},{"x":3.524,"y":2.532,"z":-0.148,"el":"H"},{"x":-2.011,"y":2.967,"z":-0.276,"el":"H"},{"x":4.832,"y":0.118,"z":0.128,"el":
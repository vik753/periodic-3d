{"version":"2026.10.11-r25","id":"Q15634018","formula":"C₁₈H₂₉NO₄","hill":"C18H29NO4","elements":["H","C","N","O"],"composition":{"C":18.0,"H":29.0,"N":1.0,"O":4.0},"names":{"en":"Cicloprolol"},"descriptions":{"en":"Cicloprolol (INNTooltip International Nonproprietary Name; developmental code name SL-75177), or cycloprolol (BANTooltip British Approved Name), is a β-adrenergic receptor antagonist (beta blocker) described as an antihypertensive agent which was never marketed. It has weak partial agonist or intrinsic sympathomimetic activity (30%) at the β-adrenergic receptors. This is higher than that of many other beta blockers but is lower than that of xamoterol (45%)."},"fame":4,"pubchemCid":146294,"mass":323.4,"charge":0,"smiles":"CC(C)NCC(COC1=CC=C(C=C1)OCCOCC2CC2)O","inchikey":"JNDJPKHYZWRRIS-UHFFFAOYSA-N","iupac":"1-[4-[2-(cyclopropylmethoxy)ethoxy]phenoxy]-3-(propan-2-ylamino)propan-2-ol","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"146294","atoms":52,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-4.314,"y":-0.12,"z":-0.64,"el":"O"},{"x":-2.383,"y":-1.975,"z":0.124,"el":"O"},{"x":3.077,"y":-1.368,"z":0.661,"el":"O"},{"x":5.828,"y":-0.977,"z":0.763,"el":"O"},{"x":3.859,"y":1.761,"z":-0.766,"el":"N"},{"x":-5.553,"y":1.819,"z":-0.045,"el":"C"},{"x":-6.736,"y":2.362,"z":0.703,"el":"C"},{"x":-5.481,"y":1.999,"z":1.443,"el":"C"},{"x":-5.618,"y":0.442,"z":-0.609,"el":"C"},{"x":-4.327,"y":-1.439,"z":-1.173,"el":"C"},{"x":-2.909,"y":-1.975,"z":-1.202,"el":"C"},{"x":4.69,"y":1.06,"z":0.203,"el":"C"},{"x":5.048,"y":-0.354,"z":-0.262,"el":"C"},{"x":3.487,"y":3.08,"z":-0.275,"el":"C"},{"x":3.827,"y":-1.227,"z":-0.541,"el":"C"},{"x":2.33,"y":2.969,"z":0.715,"el":"C"},{"x":3.115,"y":3.974,"z":-1.453,"el":"C"},{"x":-1.037,"y":-1.825,"z":0.257,"el":"C"},{"x":1.723,"y":-1.518,"z":0.528,"el":"
{"version":"2026.10.11-r25","id":"Q27149876","formula":"C₃₀H₅₀O","hill":"C30H50O","elements":["H","C","O"],"composition":{"C":30.0,"H":50.0,"O":1.0},"names":{"en":"Isoarborinol"},"descriptions":{"en":"Isoarborinol is a triterpenoid ubiquitously produced by angiosperms and is thus considered a biomarker for higher plants. Though no isoarborinol-producing microbe has been identified, isoarborinol is also considered a possible biomarker for marine bacteria, as its diagenetic end product, arborane, has been found in ancient marine sediments that predate the rise of plants. Importantly, isoarborinol may represent the phylogenetic link between hopanols and sterols."},"fame":3,"pubchemCid":12305182,"mass":426.7,"charge":0,"smiles":"CC(C)[C@@H]1CC[C@H]2[C@]1(CC[C@@]3([C@@]2(CC=C4[C@H]3CC[C@@H]5[C@@]4(CC[C@@H](C5(C)C)O)C)C)C)C","inchikey":"VWYANPOOORUCFJ-MBVQSDBHSA-N","iupac":"(3S,3aS,5aS,5bS,7aR,9S,11aS,13aR,13bS)-3a,5a,8,8,11a,13a-hexamethyl-3-propan-2-yl-1,2,3,4,5,5b,6,7,7a,9,10,11,13,13b-tetradecahydrocyclopenta[a]chrysen-9-ol","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"12305182","atoms":81,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":7.249,"y":-0.418,"z":-0.582,"el":"O"},{"x":-1.451,"y":-0.866,"z":0.137,"el":"C"},{"x":-0.843,"y":0.561,"z":-0.237,"el":"C"},{"x":-2.949,"y":-0.885,"z":-0.271,"el":"C"},{"x":-3.843,"y":0.236,"z":0.325,"el":"C"},{"x":0.649,"y":0.616,"z":0.302,"el":"C"},{"x":-1.731,"y":1.693,"z":0.377,"el":"C"},{"x":-5.154,"y":-0.1,"z":-0.443,"el":"C"},{"x":-3.226,"y":1.603,"z":-0.014,"el":"C"},{"x":-3.799,"y":-2.148,"z":-0.127,"el":"C"},{"x":-0.652,"y":-1.929,"z":-0.663,"el":"C"},{"x":1.461,"y":-0.653,"z":-0.047,"el":"C"},{"x":2.98,"y":-0.623,"z":0.307,"el":"C"},{"x":-5.239,"y":-1.645,"z":-0.361,"el":"C"},{"x":3.605,"y":0.714,"z":-0.236,"el":"C"},{"x":1.386,"y":1.898,"z"
{"version":"2026.10.11-r25","id":"Q2896152","formula":"Ca₆Cr₂(SO₄)₃(OH)₁₂·26H₂O","hill":"Ca6Cr2H64O50S3","elements":["H","O","S","Ca","Cr"],"composition":{"H":64.0,"O":50.0,"S":3.0,"Ca":6.0,"Cr":2.0},"names":{"en":"Bentorite","uk":"Бенторит"},"descriptions":{"en":"Bentorite is a mineral with the chemical formula Ca6(Cr,Al)2(SO4)3(OH)12·26H2O. It is colored violet to light violet. Its crystals are hexagonal to dihexagonal dipyramidal. It is transparent and has vitreous luster.","uk":"Бенторит — мінерал з хімічною формулою Ca6(Cr,Al)2(SO4)3(OH)12·26H2O. Забарвлений від фіолетового до світло-фіолетового кольору. Кристали бенториту мають форму гексагональної або дигексагональної дипіраміди. Він прозорий та має склоподібний блиск."},"fame":14,"pubchemCid":null,"mass":null,"charge":0,"smiles":null,"inchikey":null,"iupac":null,"classes":[{"qid":"Q12089225","names":{"en":"mineral species","ru":"действительный вид минералов","uk":"мінеральний вид"}}],"structureInfo":null,"structure":null,"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q2896152","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Bentorite","license":"CC BY-SA 4.0"},{"role":"description","name":"Wikipedia (uk)","url":"https://uk.wikipedia.org/wiki/%D0%91%D0%B5%D0%BD%D1%82%D0%BE%D1%80%D0%B8%D1%82","license":"CC BY-SA 4.0"},{"role":"photo","name":"Wikimedia Commons","url":"https://commons.wikimedia.org/wiki/File:Bentorite.jpg","license":"CC BY-SA 4.0"}],"similar":[{"id":"Q420287","formula":"Ca₆Al₂(SO₄)₃(OH)₁₂·26H₂O","names":{"en":"Ettringite","ru":"Эттрингит","uk":"Етрингіт"},"elements":["H","O","Al","S","Ca"],"fame":21,"kind":null},{"id":"Q654795","formula":"Ca₆Fe₂(SO₄)₂.₅[B(OH)₄](OH)₁₂·25H₂O","names":{"en":"Sturmanite","uk":"Штурманіт"},"elements":["H","B","O","S","Ca","Fe"],"fame":10,"kind":null},{"id":"Q26840944","formula":"AlH₂₄KO₂₀S₂","names":{"en":"Potassium aluminium sulfate dodecahydrate","ru":"Сульфат алюминия-кал
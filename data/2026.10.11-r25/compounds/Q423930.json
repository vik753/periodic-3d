{"version":"2026.10.11-r25","id":"Q423930","formula":"C₇H₈ClN₃O₄S₂","hill":"C7H8ClN3O4S2","elements":["H","C","N","O","S","Cl"],"composition":{"C":7.0,"H":8.0,"N":3.0,"O":4.0,"S":2.0,"Cl":1.0},"names":{"en":"Hydrochlorothiazide","ru":"Гидрохлоротиазид","uk":"Гідрохлоротіазид"},"descriptions":{"en":"Hydrochlorothiazide, sold under the brand name Hydrodiuril among others, is a diuretic medication used to treat hypertension and swelling due to fluid build-up. Other uses include treating diabetes insipidus and renal tubular acidosis and to decrease the risk of kidney stones in hypercalciuria. Hydrochlorothiazide is taken by mouth and may be combined with other blood pressure medications as a single pill to increase effectiveness.","ru":"Гидрохлоротиазид — лекарственное средство, тиазидный диуретик средней силы.","uk":"Гідрохлоротіазид (лат. Hydrochlorothiazidum, англ. Hydrochlorothiazide) — синтетичний препарат, що належить до групи тіазидних діуретиків, та є похідним бензотіазидину, що містить у своєму складі сульфонамідну групу."},"fame":45,"pubchemCid":3639,"mass":297.7,"charge":0,"smiles":"C1NC2=CC(=C(C=C2S(=O)(=O)N1)S(=O)(=O)N)Cl","inchikey":"JZUFKLXOESDKRF-UHFFFAOYSA-N","iupac":"6-chloro-1,1-dioxo-3,4-dihydro-2H-1lambda6,2,4-benzothiadiazine-7-sulfonamide","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"3639","atoms":25,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":2.701,"y":-2.415,"z":-0.004,"el":"Cl"},{"x":-2.384,"y":1.239,"z":0.026,"el":"S"},{"x":2.988,"y":0.802,"z":0.107,"el":"S"},{"x":-2.666,"y":1.56,"z":1.411,"el":"O"},{"x":-2.159,"y":2.272,"z":-0.965,"el":"O"},{"x":2.806,"y":2.11,"z":0.718,"el":"O"},{"x":3.963,"y":-0.127,"z":0.655,"el":"O"},{"x":-3.578,"y":0.171,"z":-0.569,"el":"N"},{"x":-2.35,"y":-1.859,"z":-0.057,"el":"N"},{"x":3.296,"y":1.006,"z":-1.56,"el":"N"},{"x":-0.9
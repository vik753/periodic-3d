{"version":"2026.10.11-r25","id":"Q307088","formula":"C₂₂H₂₇ClN₄O₃S","hill":"C22H27ClN4O3S","elements":["H","C","N","O","S","Cl"],"composition":{"C":22.0,"H":27.0,"N":4.0,"O":3.0,"S":1.0,"Cl":1.0},"names":{"en":"Abciximab"},"descriptions":{"en":"Abciximab, a glycoprotein IIb/IIIa receptor antagonist antibody manufactured by Janssen Biologics BV and distributed by Eli Lilly under the trade name ReoPro, is a platelet aggregation inhibitor mainly used during and after coronary artery procedures like angioplasty to prevent platelets from sticking together and causing thrombus (blood clot) formation within the coronary artery. It is a glycoprotein IIb/IIIa inhibitor. While abciximab has a short plasma half-life, due to its strong affinity for its receptor on the platelets, it may occupy some receptors for weeks."},"fame":21,"pubchemCid":3815015,"mass":463.0,"charge":0,"smiles":"CC1=CC(=C(C=C1Cl)C)S(=O)(=O)N2CCC(CC2)C3=NC=CN3CC4=C(ON=C4C)C","inchikey":"WXEDUKRNQGUVRZ-UHFFFAOYSA-N","iupac":"4-[[2-[1-(4-chloro-2,5-dimethylphenyl)sulfonylpiperidin-4-yl]imidazol-1-yl]methyl]-3,5-dimethyl-1,2-oxazole","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"3815015","atoms":58,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-7.385,"y":-2.494,"z":-0.799,"el":"Cl"},{"x":-3.116,"y":1.888,"z":0.557,"el":"S"},{"x":-3.138,"y":2.88,"z":-0.495,"el":"O"},{"x":-3.288,"y":2.266,"z":1.943,"el":"O"},{"x":7.414,"y":0.515,"z":-0.342,"el":"O"},{"x":-1.69,"y":0.949,"z":0.41,"el":"N"},{"x":3.349,"y":-0.982,"z":0.346,"el":"N"},{"x":1.817,"y":-2.41,"z":-0.391,"el":"N"},{"x":6.782,"y":1.222,"z":-1.358,"el":"N"},{"x":1.018,"y":-0.061,"z":0.057,"el":"C"},{"x":-0.055,"y":-0.2,"z":-1.037,"el":"C"},{"x":0.358,"y":0.039,"z":1.442,"el":"C"},{"x":-1.077,"y":0.93,"z":-0.951,"el":"C"},{"x":-0.672,"y":1.165,"z":1.481,"el":"C"},{"x":2.04
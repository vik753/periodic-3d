{"version":"2026.10.11-r25","id":"Q20077596","formula":"C₁₉H₂₈N₂O₄","hill":"C19H28N2O4","elements":["H","C","N","O"],"composition":{"C":19.0,"H":28.0,"N":2.0,"O":4.0},"names":{"en":"Roxatidine acetate"},"descriptions":{"en":"Roxatidine acetate is a specific and competitive histamine H2 receptor antagonist drug that is used to treat gastric ulcers, Zollinger–Ellison syndrome, erosive esophagitis, gastro-oesophageal reflux disease, and gastritis. Pharmacodynamic studies showed that 150 mg of roxatidine acetate were optimal in suppressing gastric acid secretion, and that a single bedtime dose of 150 mg was more effective than a dose of 75 mg twice daily in terms of inhibiting nocturnal acid secretion. It was patented in 1979 and approved for medical use in 1986."},"fame":6,"pubchemCid":5105,"mass":348.4,"charge":0,"smiles":"CC(=O)OCC(=O)NCCCOC1=CC=CC(=C1)CN2CCCCC2","inchikey":"SMTZFNFIKUPEJC-UHFFFAOYSA-N","iupac":"[2-oxo-2-[3-[3-(piperidin-1-ylmethyl)phenoxy]propylamino]ethyl] acetate","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"5105","atoms":53,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":2.031,"y":-1.846,"z":1.271,"el":"O"},{"x":0.765,"y":2.703,"z":-1.245,"el":"O"},{"x":0.563,"y":1.429,"z":1.191,"el":"O"},{"x":2.053,"y":1.192,"z":-2.426,"el":"O"},{"x":-2.874,"y":-0.654,"z":0.407,"el":"N"},{"x":2.879,"y":1.536,"z":1.392,"el":"N"},{"x":-2.832,"y":0.536,"z":-0.454,"el":"C"},{"x":-4.174,"y":-0.776,"z":1.081,"el":"C"},{"x":-3.084,"y":1.811,"z":0.353,"el":"C"},{"x":-4.47,"y":0.455,"z":1.938,"el":"C"},{"x":-4.404,"y":1.735,"z":1.112,"el":"C"},{"x":-2.585,"y":-1.859,"z":-0.37,"el":"C"},{"x":-1.107,"y":-2.038,"z":-0.598,"el":"C"},{"x":-0.211,"y":-1.856,"z":0.455,"el":"C"},{"x":-0.634,"y":-2.386,"z":-1.864,"el":"C"},{"x":1.157,"y":-2.022,"z":0.243,"el":"C"},{"x":0.734,"y":-2.552,"z":-2.075
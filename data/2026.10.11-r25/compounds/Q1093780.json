{"version":"2026.10.11-r25","id":"Q1093780","formula":"C₃O₆","hill":"C3O6","elements":["C","O"],"composition":{"C":3.0,"O":6.0},"names":{"en":"1,3,5-trioxanetrione"},"descriptions":{"en":"The chemical compound 1,3,5-trioxanetrione, or 1,3,5-trioxacyclohexane-2,4,6-trione is an unstable oxide of carbon with formula C3O6. It can be considered a cyclic trimer of carbon dioxide (CO2) or as a triple ketone of 1,3,5-trioxane (1,3,5-trioxacyclohexane). Trioxanetrione has been synthesized but is exceedingly unstable, with a half-life of approximately 40 min at −40 °C. It decomposes to give carbon dioxide."},"fame":12,"pubchemCid":14794697,"mass":132.03,"charge":0,"smiles":"C1(=O)OC(=O)OC(=O)O1","inchikey":"FFPDLONZSMFWAT-UHFFFAOYSA-N","iupac":"1,3,5-trioxane-2,4,6-trione","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"14794697","atoms":9,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":0.042,"y":-1.331,"z":0.0,"el":"O"},{"x":1.132,"y":0.702,"z":0.0,"el":"O"},{"x":-1.174,"y":0.629,"z":0.0,"el":"O"},{"x":2.288,"y":-1.227,"z":0.0,"el":"O"},{"x":-2.207,"y":-1.369,"z":0.0,"el":"O"},{"x":-0.082,"y":2.595,"z":0.0,"el":"O"},{"x":1.207,"y":-0.647,"z":0.0,"el":"C"},{"x":-1.164,"y":-0.722,"z":0.0,"el":"C"},{"x":-0.043,"y":1.369,"z":0.0,"el":"C"}],"bonds":[[0,6,1],[0,7,1],[1,6,1],[1,8,1],[2,7,1],[2,8,1],[3,6,2],[4,7,2],[5,8,2]]},"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q1093780","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/1%2C3%2C5-Trioxanetrione","license":"CC BY-SA 4.0"},{"role":"properties","name":"PubChem","url":"https://pubchem.ncbi.nlm.nih.gov/compound/14794697","license":"PubChem (NIH), public data"},{"role":"structure","name":"PubChem 3D","url":"https://pubchem.ncbi.nlm.nih.gov/compound/14794697
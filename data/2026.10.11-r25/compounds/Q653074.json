{"version":"2026.10.11-r25","id":"Q653074","formula":"C₁₉H₁₇ClF₃NO₄","hill":"C19H17ClF3NO4","elements":["H","C","N","O","F","Cl"],"composition":{"C":19.0,"F":3.0,"H":17.0,"N":1.0,"O":4.0,"Cl":1.0},"names":{"en":"Arhalofenate","ru":"Аргалофенат"},"descriptions":{"en":"Arhalofenate is a dual-acting small molecule being developed by CymaBay Therapeutics for the treatment of gout, offering both urate-lowering and anti-inflammatory effects. As a uricosuric agent, arhalofenate lowers serum urate by inhibiting its reabsorption in the proximal tubules of the kidney through blockade of transporters such as URAT1, OAT4, and OAT10. Arhalofenate also suppresses gout flares by inhibiting the urate crystal–stimulated release of interleukin-1β (IL-1β), the key cytokine responsible for triggering gout attacks."},"fame":2,"pubchemCid":12082259,"mass":415.8,"charge":0,"smiles":"CC(=O)NCCOC(=O)[C@@H](C1=CC=C(C=C1)Cl)OC2=CC=CC(=C2)C(F)(F)F","inchikey":"BJBCSGQLZQGGIQ-QGZVFWFLSA-N","iupac":"2-acetamidoethyl (2R)-2-(4-chlorophenyl)-2-[3-(trifluoromethyl)phenoxy]acetate","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"12082259","atoms":45,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-4.848,"y":-3.813,"z":0.49,"el":"Cl"},{"x":6.117,"y":0.789,"z":1.187,"el":"F"},{"x":5.205,"y":1.867,"z":-0.459,"el":"F"},{"x":4.267,"y":1.888,"z":1.503,"el":"F"},{"x":0.88,"y":-0.992,"z":-1.237,"el":"O"},{"x":-1.301,"y":1.76,"z":-0.516,"el":"O"},{"x":-0.022,"y":1.274,"z":-2.373,"el":"O"},{"x":-3.071,"y":1.798,"z":1.951,"el":"O"},{"x":-3.848,"y":2.946,"z":0.08,"el":"N"},{"x":-0.101,"y":-0.274,"z":-0.491,"el":"C"},{"x":-1.28,"y":-1.154,"z":-0.248,"el":"C"},{"x":-0.445,"y":0.997,"z":-1.257,"el":"C"},{"x":2.112,"y":-1.128,"z":-0.657,"el":"C"},{"x":-2.34,"y":-1.167,"z":-1.155,"el":"C"},{"x":-1.324,"y":-1.963,"z":0.887,"el":"C"},{"x
{"version":"2026.10.11-r25","id":"Q7392759","formula":"C₂₉H₃₄ClN₃O","hill":"C29H34ClN3O","elements":["H","C","N","O","Cl"],"composition":{"C":29.0,"H":34.0,"N":3.0,"O":1.0,"Cl":1.0},"names":{"en":"SR144528"},"descriptions":{"en":"SR144528 is a drug that acts as a potent and highly selective CB2 receptor inverse agonist, with a Ki of 0.6 nM at CB2 and 400 nM at the related CB1 receptor. It is used in scientific research for investigating the function of the CB2 receptor, as well as for studying the effects of CB1 receptors in isolation, as few CB1 agonists that do not also show significant activity as CB2 agonists are available. It has also been found to be an inhibitor of sterol O-acyltransferase, an effect that appears to be independent from its action on CB2 receptors."},"fame":3,"pubchemCid":3081355,"mass":476.1,"charge":0,"smiles":"CC1=CC=C(C=C1)CN2C(=CC(=N2)C(=O)N[C@H]3[C@]4(CC[C@H](C4)C3(C)C)C)C5=CC(=C(C=C5)Cl)C","inchikey":"SUGVYNSRNKFXQM-XRHWURSXSA-N","iupac":"5-(4-chloro-3-methylphenyl)-1-[(4-methylphenyl)methyl]-N-[(1S,2S,4R)-1,3,3-trimethyl-2-bicyclo[2.2.1]heptanyl]pyrazole-3-carboxamide","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"3081355","atoms":68,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":8.074,"y":-1.379,"z":0.127,"el":"Cl"},{"x":-1.47,"y":-3.077,"z":-0.632,"el":"O"},{"x":-2.429,"y":-1.142,"z":0.214,"el":"N"},{"x":0.083,"y":-0.203,"z":0.629,"el":"N"},{"x":1.416,"y":-0.043,"z":0.697,"el":"N"},{"x":-4.778,"y":-0.963,"z":1.122,"el":"C"},{"x":-5.804,"y":-0.495,"z":-0.807,"el":"C"},{"x":-4.476,"y":-1.164,"z":-1.297,"el":"C"},{"x":-3.798,"y":-1.548,"z":0.062,"el":"C"},{"x":-6.131,"y":-1.279,"z":0.472,"el":"C"},{"x":-4.774,"y":0.584,"z":1.08,"el":"C"},{"x":-5.548,"y":0.899,"z":-0.207,"el":"C"},{"x":-4.591,"y":-1.532,"z":2.515,"el":"C"},{"x":-3.61,"y":-0.133,"z":-2.05
{"version":"2026.10.11-r25","id":"Q104438858","formula":"C₂₂H₂₇N₃O₄S","hill":"C22H27N3O4S","elements":["H","C","N","O","S"],"composition":{"C":22.0,"H":27.0,"N":3.0,"O":4.0,"S":1.0},"names":{"en":"BC-LI-0186"},"descriptions":{"en":"BC-LI-0186 is a compound that acts as an inhibitor of the GTPase enzyme leucyl-tRNA synthetase (LRS). This enzyme acts as part of the mTOR complex and acts as a leucine sensor which stimulates mTORC1 in the presence of leucine. BC-LI-0186 blocks the docking site for mTORC1 and thereby prevents the mTOR activation and increased protein synthesis which is usually triggered by branched-chain amino acids such as leucine, yet without inhibiting the separate catalytic activity of LRS. This may have potential applications in the treatment of cancer, and BC-LI-0186 has also been shown to promote muscle regeneration after injury."},"fame":1,"pubchemCid":4917788,"mass":429.5,"charge":0,"smiles":"CC1=C(C(=O)N(N1C)C2=CC=C(C=C2)S(=O)(=O)NCCOC3=CC=CC=C3)C(C)C","inchikey":"SQYWMHPZMHDCHP-UHFFFAOYSA-N","iupac":"4-(2,3-dimethyl-5-oxo-4-propan-2-ylpyrazol-1-yl)-N-(2-phenoxyethyl)benzenesulfonamide","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"4917788","atoms":57,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":1.855,"y":1.832,"z":-0.77,"el":"S"},{"x":-4.73,"y":1.332,"z":1.353,"el":"O"},{"x":2.189,"y":1.731,"z":-2.185,"el":"O"},{"x":1.924,"y":3.131,"z":-0.113,"el":"O"},{"x":5.197,"y":-0.664,"z":-0.638,"el":"O"},{"x":-3.634,"y":-0.336,"z":0.063,"el":"N"},{"x":-4.135,"y":-1.454,"z":-0.619,"el":"N"},{"x":2.824,"y":0.727,"z":0.101,"el":"N"},{"x":-5.95,"y":-0.387,"z":0.236,"el":"C"},{"x":-7.3,"y":0.06,"z":0.649,"el":"C"},{"x":-5.525,"y":-1.407,"z":-0.528,"el":"C"},{"x":-4.708,"y":0.322,"z":0.668,"el":"C"},{"x":-2.329,"y":0.179,"z":-0.135,"el":"C"},{"x":-7.452,"y":0.005,"z":2.172,
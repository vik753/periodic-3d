{"version":"2026.10.11-r25","id":"Q425392","formula":"Rh₁₂As₇","hill":"As7Rh12","elements":["As","Rh"],"composition":{"As":7.0,"Rh":12.0},"names":{"en":"Polkanovite","ru":"Полкановит","uk":"Полкановіт"},"descriptions":{"ru":"Полканови́т — очень редко встречающийся минерал родия из класса арсенидов. Относится к типу «сернистые соединения и их аналоги». Кристаллизуется в гексагональной сингонии.","uk":"Полкановіт — дуже рідкісний мінерал з мінерального класу «сульфіди та сульфосолі», арсенід родію. Він кристалізується в гексагональній кристалічній системі з хімічним складом Rh12As7. Полкановіт непрозорий у будь-якій формі, і до цього часу він був знайдений лише у вигляді масивних агрегатів від коричнево-сірого до сірого, металевого кольору з глянцем."},"fame":7,"pubchemCid":null,"mass":null,"charge":0,"smiles":null,"inchikey":null,"iupac":null,"classes":[{"qid":"Q12089225","names":{"en":"mineral species","ru":"действительный вид минералов","uk":"мінеральний вид"}}],"structureInfo":{"kind":"crystal","source":"materialsproject","ref":"mp-1228882","atoms":22,"license":"CC BY 4.0, Materials Project"},"structure":{"cell":[[9.407,0.0,0.0],[-4.703,8.147,0.0],[0.0,0.0,3.727]],"kind":"crystal","atoms":[{"x":0.0,"y":0.0,"z":2.19,"el":"As"},{"x":-4.703,"y":8.147,"z":2.19,"el":"As"},{"x":9.407,"y":0.0,"z":2.19,"el":"As"},{"x":4.703,"y":8.147,"z":2.19,"el":"As"},{"x":-1.263,"y":6.856,"z":2.795,"el":"As"},{"x":-0.603,"y":3.625,"z":2.795,"el":"As"},{"x":1.866,"y":5.813,"z":2.795,"el":"As"},{"x":5.969,"y":1.314,"z":0.944,"el":"As"},{"x":5.284,"y":4.512,"z":0.944,"el":"As"},{"x":2.857,"y":2.32,"z":0.944,"el":"As"},{"x":5.794,"y":6.098,"z":2.816,"el":"Rh"},{"x":1.229,"y":1.969,"z":2.816,"el":"Rh"},{"x":7.088,"y":0.08,"z":2.816,"el":"Rh"},{"x":-1.037,"y":1.919,"z":0.949,"el":"Rh"},{"x":3.56,"y":6.289,"z":0.949,"el":"Rh"},{"x":-2.523,"y":8.085,"z":0.949,"el":"Rh"},{"x":4.219,"y":1.092,"z":2.811,"el":"Rh"},{"x":6.352,"y":3.108,"z":2.811,"el":"Rh"},{"x":3.54,"y":3.947,"z":2.811,"el":"Rh"},
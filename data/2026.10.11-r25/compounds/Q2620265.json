{"version":"2026.10.11-r25","id":"Q2620265","formula":"C₃₅H₃₀MgN₄O₅","hill":"C35H30MgN4O5","elements":["H","C","N","O","Mg"],"composition":{"C":35.0,"H":30.0,"N":4.0,"O":5.0,"Mg":1.0},"names":{"en":"Chlorophyll c1","ru":"Хлорофилл c1"},"descriptions":{"en":"Chlorophyll c refers to forms of chlorophyll found in certain marine algae, including the photosynthetic Chromista (e.g. diatoms and brown algae) and dinoflagellates. These pigments are characterized by their unusual chemical structure, with a porphyrin as opposed to the chlorin (which has a reduced ring D) as the core; they also do not have an isoprenoid tail.","ru":"Хлорофилл c1 — форма хлорофилла. Является вспомогательным пигментом, придаёт золотистый или коричневатый цвет. Помогает собирать энергию и передаёт её на светособирающую антенну в реакционный центр."},"fame":7,"pubchemCid":null,"mass":null,"charge":0,"smiles":null,"inchikey":null,"iupac":null,"classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":null,"structure":null,"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q2620265","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Chlorophyll_c1","license":"CC BY-SA 4.0"},{"role":"description","name":"Wikipedia (ru)","url":"https://ru.wikipedia.org/wiki/%D0%A5%D0%BB%D0%BE%D1%80%D0%BE%D1%84%D0%B8%D0%BB%D0%BB_c1","license":"CC BY-SA 4.0"}],"similar":[{"id":"Q424156","formula":"C₂₂H₁₉N₃O₄","names":{"en":"Tadalafil","ru":"Тадалафил","uk":"Тадалафіл"},"elements":["H","C","N","O"],"fame":35,"kind":"molecule"},{"id":"Q414462","formula":"C₂₅H₂₅N₅O₄","names":{"en":"Apixaban","ru":"Апиксабан","uk":"Апіксабан"},"elements":["H","C","N","O"],"fame":30,"kind":"molecule"},{"id":"Q412276","formula":"C₁₅H₁₅N₃O₂","names":{"en":"Methyl red","ru":"Метиловый красный","uk":"Метиловий червоний"},"elements":["H","C","N","O"],"fame":22,"kind":"mole
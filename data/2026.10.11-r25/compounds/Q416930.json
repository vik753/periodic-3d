{"version":"2026.10.11-r25","id":"Q416930","formula":"C₈H₁₄O₇","hill":"C8H14O7","elements":["H","C","O"],"composition":{"C":8.0,"H":14.0,"O":7.0},"names":{"en":"Ethyl D-glucuronide"},"descriptions":{"en":"Ethyl glucuronide (EtG) is a metabolite of ethanol which is formed in the body by glucuronidation following exposure to ethanol, usually from drinking alcoholic beverages. It is used as a biomarker to test for ethanol use and to monitor alcohol abstinence in situations where drinking is prohibited, such as by the military, in alcohol treatment programs, in professional monitoring programs (health professionals, attorneys, airline pilots in recovery from addictions), in schools, liver transplant clinics, or in recovering alcoholic patients."},"fame":9,"pubchemCid":152226,"mass":222.19,"charge":0,"smiles":"CCOC1[C@@H]([C@H]([C@@H]([C@H](O1)C(=O)O)O)O)O","inchikey":"IWJBVMJWSPZNJH-XWBUKDKVSA-N","iupac":"(2S,3S,4S,5R)-6-ethoxy-3,4,5-trihydroxyoxane-2-carboxylic acid","classes":[{"qid":"Q59199015","names":{"en":"group of stereoisomers","ru":"группа стереоизомеров","uk":"група стереоізомерів"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"152226","atoms":29,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-0.326,"y":-0.812,"z":0.052,"el":"O"},{"x":-2.489,"y":0.057,"z":0.135,"el":"O"},{"x":1.333,"y":2.893,"z":0.678,"el":"O"},{"x":2.948,"y":0.746,"z":-0.431,"el":"O"},{"x":-1.443,"y":2.65,"z":-0.275,"el":"O"},{"x":2.974,"y":-1.988,"z":-0.335,"el":"O"},{"x":1.112,"y":-2.741,"z":0.757,"el":"O"},{"x":0.816,"y":1.819,"z":-0.11,"el":"C"},{"x":1.664,"y":0.578,"z":0.169,"el":"C"},{"x":-0.651,"y":1.583,"z":0.248,"el":"C"},{"x":1.01,"y":-0.667,"z":-0.418,"el":"C"},{"x":-1.163,"y":0.271,"z":-0.346,"el":"C"},{"x":1.684,"y":-1.907,"z":0.071,"el":"C"},{"x":-3.035,"y":-1.149,"z":-0.375,"el":"C"},{"x":-4.432,"y":-1.331,"z":0.178,"el":"C"},{"x":0.905,"y":2.133,"z":-1.157,"el":"H"},{"x":1.823,"y":0.469,"z":1.249,"el":"H"},{"x":-0.785,"y":
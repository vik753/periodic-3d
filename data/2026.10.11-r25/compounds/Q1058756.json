{"version":"2026.10.11-r25","id":"Q1058756","formula":"PbSnS₂","hill":"PbS2Sn","elements":["S","Sn","Pb"],"composition":{"S":2.0,"Pb":1.0,"Sn":1.0},"names":{"en":"Teallite","ru":"Тиллит","uk":"Тиліт"},"descriptions":{"en":"Teallite is a sulfide mineral of tin and lead with chemical formula: PbSnS2. It occurs in hydrothermal veins and is sometimes mined as an ore of tin. Teallite forms soft silvery grey mica-like plates and crystallizes in the orthorhombic system.","ru":"Тиллит — минерал, сульфид олова и свинца, изоструктурен с герценбергитом, с которым образует непрерывный ряд твёрдых раство­ров. Кристаллическая решётка аналогична решётке герценбергита. Впервые найден в руде из шахты серебряных рудников Санта-Роза, Боливия, и описан в 1904 году.","uk":"Тілліт (рос. тиллит; англ. tillite; нім."},"fame":13,"pubchemCid":null,"mass":null,"charge":0,"smiles":null,"inchikey":null,"iupac":null,"classes":[{"qid":"Q12089225","names":{"en":"mineral species","ru":"действительный вид минералов","uk":"мінеральний вид"}}],"structureInfo":{"kind":"crystal","source":"materialsproject","ref":"mp-1218951","atoms":12,"license":"CC BY 4.0, Materials Project"},"structure":{"cell":[[4.1,0.0,0.0],[0.0,4.425,0.0],[0.0,0.0,11.702]],"kind":"crystal","atoms":[{"x":2.05,"y":1.638,"z":4.364,"el":"Sn"},{"x":2.05,"y":2.787,"z":10.215,"el":"Sn"},{"x":0.0,"y":0.619,"z":7.226,"el":"Pb"},{"x":4.1,"y":0.619,"z":7.226,"el":"Pb"},{"x":0.0,"y":3.806,"z":1.375,"el":"Pb"},{"x":4.1,"y":3.806,"z":1.375,"el":"Pb"},{"x":0.0,"y":1.071,"z":10.01,"el":"S"},{"x":4.1,"y":1.071,"z":10.01,"el":"S"},{"x":0.0,"y":3.354,"z":4.159,"el":"S"},{"x":4.1,"y":3.354,"z":4.159,"el":"S"},{"x":2.05,"y":1.267,"z":1.803,"el":"S"},{"x":2.05,"y":3.158,"z":7.654,"el":"S"}],"bonds":[[0,10,1],[1,11,1],[0,8,1],[0,9,1],[1,6,1],[1,7,1],[2,6,1],[3,7,1],[4,8,1],[5,9,1]],"cellOrigin":[0,0,0]},"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q1058756","license":"CC0 1.0"},{"role":"description","name":"Wikiped
{"version":"2026.10.11-r25","id":"Q7101741","formula":"C₁₄H₁₉NO₂","hill":"C14H19NO2","elements":["H","C","N","O"],"composition":{"C":14.0,"H":19.0,"N":1.0,"O":2.0},"names":{"en":"ORG-37684"},"descriptions":{"en":"ORG-37684 is a drug developed by Organon, which acts as a potent and selective agonist for the 5-HT2 receptor family, including of the serotonin 5-HT2C, 5-HT2B, and 5-HT2A receptors, in that order of potency. It has anorectic effects in animal studies and has been researched as a potential weight loss drug for use in humans. ORG-37684 produces the head-twitch response, a behavioral proxy of psychedelic effects, and hence may be hallucinogenic in humans."},"fame":3,"pubchemCid":9794656,"mass":233.31,"charge":0,"smiles":"COC1=C(C2=C(CCC2)C=C1)O[C@H]3CCNC3","inchikey":"QDJAYXYEXHVXJV-NSHDSACASA-N","iupac":"(3S)-3-[(5-methoxy-2,3-dihydro-1H-inden-4-yl)oxy]pyrrolidine","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"9794656","atoms":36,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-0.955,"y":-0.011,"z":-0.582,"el":"O"},{"x":-0.268,"y":-2.615,"z":0.117,"el":"O"},{"x":-4.148,"y":0.251,"z":-0.144,"el":"N"},{"x":-1.86,"y":0.379,"z":0.441,"el":"C"},{"x":-2.405,"y":1.769,"z":0.134,"el":"C"},{"x":1.294,"y":0.662,"z":-0.158,"el":"C"},{"x":-3.078,"y":-0.539,"z":0.469,"el":"C"},{"x":1.153,"y":2.122,"z":-0.452,"el":"C"},{"x":2.623,"y":2.534,"z":-0.622,"el":"C"},{"x":3.452,"y":1.587,"z":0.259,"el":"C"},{"x":2.599,"y":0.358,"z":0.246,"el":"C"},{"x":-3.907,"y":1.626,"z":0.282,"el":"C"},{"x":0.314,"y":-0.315,"z":-0.204,"el":"C"},{"x":2.951,"y":-0.93,"z":0.612,"el":"C"},{"x":0.664,"y":-1.62,"z":0.152,"el":"C"},{"x":1.973,"y":-1.925,"z":0.557,"el":"C"},{"x":-0.402,"y":-3.333,"z":-1.107,"el":"C"},{"x":-1.375,"y":0.375,"z":1.427,"el":"H"},{"x":-2.144,"y":2.082,"z":-0.885,"el":"H"},{"x":-2.008,"y":2
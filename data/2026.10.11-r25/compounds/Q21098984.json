{"version":"2026.10.11-r25","id":"Q21098984","formula":"C₁₄H₁₈FNO₂","hill":"C14H18FNO2","elements":["H","C","N","O","F"],"composition":{"C":14.0,"F":1.0,"H":18.0,"N":1.0,"O":2.0},"names":{"en":"4-fluoromethylphenidate"},"descriptions":{"en":"4-Fluoromethylphenidate (also known as 4-FMPH and 4F-MPH) is a stimulant drug that acts as a higher potency dopamine reuptake inhibitor than the closely related methylphenidate. 4-Fluoromethylphenidate was studied further along with other analogues of (±)-threo-methylphenidate (TMP) to assess their potential as anti-cocaine medications. 4F-MPH was reported as having an ED50 mg/kg of 0.26 (0.18–0.36), regarding its efficacy as a substitute for cocaine, and a relative potency of 3.33 compared to methylphenidate for the same purpose."},"fame":2,"pubchemCid":52944002,"mass":251.3,"charge":0,"smiles":"COC(=O)[C@@H]([C@H]1CCCCN1)C2=CC=C(C=C2)F","inchikey":"XISBAJBPDVRSPG-CHWSQXEVSA-N","iupac":"methyl (2R)-2-(4-fluorophenyl)-2-[(2R)-piperidin-2-yl]acetate","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"52944002","atoms":36,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-4.848,"y":-1.212,"z":0.465,"el":"F"},{"x":0.41,"y":2.183,"z":0.942,"el":"O"},{"x":0.898,"y":2.814,"z":-1.219,"el":"O"},{"x":2.806,"y":0.16,"z":-0.287,"el":"N"},{"x":1.472,"y":-0.361,"z":0.036,"el":"C"},{"x":1.353,"y":-1.839,"z":-0.362,"el":"C"},{"x":0.419,"y":0.475,"z":-0.69,"el":"C"},{"x":2.448,"y":-2.677,"z":0.292,"el":"C"},{"x":3.821,"y":-2.073,"z":0.018,"el":"C"},{"x":3.859,"y":-0.594,"z":0.394,"el":"C"},{"x":-0.999,"y":0.021,"z":-0.379,"el":"C"},{"x":0.618,"y":1.957,"z":-0.39,"el":"C"},{"x":-1.314,"y":-0.461,"z":0.891,"el":"C"},{"x":-1.984,"y":0.086,"z":-1.365,"el":"C"},{"x":-2.614,"y":-0.877,"z":1.177,"el":"C"},{"x":-3.284,"y":-0.331,"z":-1.079,"el":"C"},{"x":-3.599,"y":-0.813,"z":
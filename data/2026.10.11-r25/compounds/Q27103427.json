{"version":"2026.10.11-r25","id":"Q27103427","formula":"C₁₉H₂₆O₃","hill":"C19H26O3","elements":["H","C","O"],"composition":{"C":19.0,"H":26.0,"O":3.0},"names":{"en":"11β-hydroxyandrostenedione"},"descriptions":{"en":"11β-Hydroxyandrostenedione (11β-OHA4), also known as 11β-hydroxyandrost-4-ene-3,17-dione, is an endogenous, naturally occurring steroid and androgen prohormone that is produced primarily, if not exclusively, in the adrenal glands. It is closely related to adrenosterone (11-ketoandrostenedione; 11-KA4), 11-ketotestosterone (11-KT), and 11-ketodihydrotestosterone (11-KDHT), which are also produced in the adrenal glands. It can be used as a biomarker for guiding primary aldosteronism subtyping in adrenal vein sampling where blood samples are taken from both adrenal glands to compare the amount of hormone made by each gland."},"fame":4,"pubchemCid":94141,"mass":302.4,"charge":0,"smiles":"C[C@]12CCC(=O)C=C1CC[C@@H]3[C@@H]2[C@H](C[C@]4([C@H]3CCC4=O)C)O","inchikey":"WSCUHXPGYUMQEX-KCZNZURUSA-N","iupac":"(8S,9S,10R,11S,13S,14S)-11-hydroxy-10,13-dimethyl-2,6,7,8,9,11,12,14,15,16-decahydro-1H-cyclopenta[a]phenanthrene-3,17-dione","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"94141","atoms":48,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-0.584,"y":-2.309,"z":1.067,"el":"O"},{"x":-4.889,"y":-0.759,"z":-1.18,"el":"O"},{"x":5.538,"y":0.37,"z":-1.168,"el":"O"},{"x":-0.603,"y":0.807,"z":0.467,"el":"C"},{"x":0.225,"y":-0.351,"z":-0.187,"el":"C"},{"x":-1.977,"y":0.856,"z":-0.211,"el":"C"},{"x":-2.771,"y":-0.45,"z":-0.02,"el":"C"},{"x":1.708,"y":-0.431,"z":0.359,"el":"C"},{"x":-0.559,"y":-1.703,"z":-0.22,"el":"C"},{"x":-2.009,"y":-1.566,"z":-0.736,"el":"C"},{"x":0.13,"y":2.147,"z":0.302,"el":"C"},{"x":-2.973,"y":1.954,"z":0.151,"el":"C"},{"x":2.345,"y":0.964,"z":0.294,"el":"C"},{"x":-4
{"version":"2026.10.11-r25","id":"Q131152152","formula":"C₂₆H₂₆FN₅O₄","hill":"C26H26FN5O4","elements":["H","C","N","O","F"],"composition":{"C":26.0,"F":1.0,"H":26.0,"N":5.0,"O":4.0},"names":{"en":"Sebetralstat"},"descriptions":{"en":"Sebetralstat, sold under the brand name Ekterly, is a medication used for the treatment of hereditary angioedema. Sebetralstat is a plasma kallikrein inhibitor that suppresses the activation of the positive feedback mechanism of the kallikrein-kinin system, thereby reducing factor XIIa and additional plasma kallikrein production. By inhibiting plasma kallikrein, sebetralstat reduces the production of bradykinin, thereby halting the progression of hereditary angioedema attacks."},"fame":3,"pubchemCid":121365142,"mass":491.5,"charge":0,"smiles":"COCC1=NN(C=C1C(=O)NCC2=NC=CC(=C2F)OC)CC3=CC=C(C=C3)CN4C=CC=CC4=O","inchikey":"KGMPDQIYDKKXRD-UHFFFAOYSA-N","iupac":"N-[(3-fluoro-4-methoxy-2-pyridinyl)methyl]-3-(methoxymethyl)-1-[[4-[(2-oxo-1-pyridinyl)methyl]phenyl]methyl]pyrazole-4-carboxamide","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"rdkit","ref":"121365142","atoms":62,"license":"Computed with RDKit from SMILES (PubChem, Wikidata)"},"structure":{"kind":"molecule","atoms":[{"x":-2.312,"y":-2.49,"z":3.067,"el":"C"},{"x":-1.139,"y":-1.799,"z":3.463,"el":"O"},{"x":-0.825,"y":-0.678,"z":2.623,"el":"C"},{"x":-0.28,"y":-1.045,"z":1.27,"el":"C"},{"x":0.846,"y":-1.774,"z":1.187,"el":"N"},{"x":1.119,"y":-1.826,"z":-0.129,"el":"N"},{"x":0.192,"y":-1.182,"z":-0.892,"el":"C"},{"x":-0.755,"y":-0.67,"z":-0.026,"el":"C"},{"x":-1.912,"y":0.103,"z":-0.446,"el":"C"},{"x":-1.908,"y":0.794,"z":-1.459,"el":"O"},{"x":-3.026,"y":-0.061,"z":0.342,"el":"N"},{"x":-4.294,"y":0.511,"z":-0.068,"el":"C"},{"x":-5.326,"y":0.477,"z":1.032,"el":"C"},{"x":-5.797,"y":1.662,"z":1.501,"el":"N"},{"x":-6.715,"y":1.615,"z":2.491,"el":"C"},{"x":-7.19
{"version":"2026.10.11-r25","id":"Q4024611","formula":"CaZn₁₁(UO₂)(CO₃)₃(OH)₂₀·4H₂O","hill":"C3H28CaO35UZn11","elements":["H","C","O","Ca","Zn","U"],"composition":{"C":3.0,"H":28.0,"O":35.0,"U":1.0,"Ca":1.0,"Zn":11.0},"names":{"en":"Znucalite"},"descriptions":{"en":"Znucalite or CaZn11(UO2)(CO3)3(OH)20·4(H2O) is a rare, radioactive, white to pale cream colored uranium-containing carbonate mineral, hydrated calcium zinc uranyl carbonate hydroxide. Znucalite crystallizes in the orthorhombic system, often forming aggregates or crusts, and is found as a rare secondary species in carbonate-hosted (meaning it is mined from carbonate containing formations such as limestone) polymetallic veins, and nearby oxidizing uranium veins; on dump material and coating mine walls, apparently of post-mine origin. It fluoresces yellow-green under UV light."},"fame":6,"pubchemCid":null,"mass":null,"charge":0,"smiles":null,"inchikey":null,"iupac":null,"classes":[{"qid":"Q12089225","names":{"en":"mineral species","ru":"действительный вид минералов","uk":"мінеральний вид"}}],"structureInfo":null,"structure":null,"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q4024611","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Znucalite","license":"CC BY-SA 4.0"},{"role":"photo","name":"Wikimedia Commons","url":"https://commons.wikimedia.org/wiki/File:Znucalite_-_St_Christoph,_B%C3%A4renhecke,_Erzgebirge,_Saxony.JPG","license":"CC BY-SA 3.0 de"}],"similar":[{"id":"Q4023583","formula":"Zn₄Al₂(OH)₁₂[CO₃]*3H₂O","names":{"en":"Zaccagnaite","uk":"Закканьяїт"},"elements":["H","C","O","Al","Zn"],"fame":7,"kind":null},{"id":"Q17028639","formula":"Zn₂O[AsO₃(OH)](H₂O)₃.₅₃","names":{"en":"Ianbruceite"},"elements":["H","O","Zn","As"],"fame":6,"kind":null},{"id":"Q19860928","formula":"Zn₄(SO₄)(OH)₆·3H₂O","names":{"en":"Lahnsteinite"},"elements":["H","O","S","Zn"],"fame":4,"kind":null},{"id":"Q105626266","formula":"H₄O₄Zn²⁻
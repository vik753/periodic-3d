{"version":"2026.10.11-r25","id":"Q82994959","formula":"C₂₀H₁₉N₃O₂","hill":"C20H19N3O2","elements":["H","C","N","O"],"composition":{"C":20.0,"H":19.0,"N":3.0,"O":2.0},"names":{"en":"Tilivalline"},"descriptions":{"en":"Tilivalline is a nonribosomal enterotoxin and was the first naturally occurring pyrrolobenzodiazepine (PBD) to be associated with disease in the human intestine. Previous work has shown that PBD tilivalline produced by Klebsiella oxytoca was linked to the pathogenesis of colitis in animal model of antibiotic-associated hemorrhagic colitis (AAHC). Since the enteric bacterium K. oxytoca is part of the intestinal microbiota and tilivalline causes the pathogenesis of colitis, it is important to understand the biosynthesis and regulation of tilivalline activity."},"fame":4,"pubchemCid":128363,"mass":333.4,"charge":0,"smiles":"C1C[C@H]2[C@@H](NC3=C(C=CC=C3O)C(=O)N2C1)C4=CNC5=CC=CC=C54","inchikey":"AJZNARCWDDMOPL-WMZOPIPTSA-N","iupac":"(6S,6aS)-4-hydroxy-6-(1H-indol-3-yl)-5,6,6a,7,8,9-hexahydropyrrolo[2,1-c][1,4]benzodiazepin-11-one","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"128363","atoms":44,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-3.775,"y":-1.942,"z":-0.389,"el":"O"},{"x":-1.185,"y":3.392,"z":-0.546,"el":"O"},{"x":-1.553,"y":-1.969,"z":0.177,"el":"N"},{"x":-0.536,"y":0.783,"z":-0.775,"el":"N"},{"x":3.718,"y":-0.395,"z":-1.764,"el":"N"},{"x":-0.231,"y":-1.369,"z":0.384,"el":"C"},{"x":0.158,"y":-0.498,"z":-0.829,"el":"C"},{"x":0.682,"y":-2.594,"z":0.598,"el":"C"},{"x":-0.253,"y":-3.648,"z":1.167,"el":"C"},{"x":-1.513,"y":-3.414,"z":0.359,"el":"C"},{"x":1.664,"y":-0.323,"z":-0.96,"el":"C"},{"x":-2.743,"y":-1.328,"z":-0.108,"el":"C"},{"x":-1.82,"y":1.07,"z":-0.361,"el":"C"},{"x":-2.827,"y":0.155,"z":-0.017,"el":"C"},{"x":2.519,"y":0.283,"z":-0.009,"el":"C"},{"x":2.
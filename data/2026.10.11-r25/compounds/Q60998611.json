{"version":"2026.10.11-r25","id":"Q60998611","formula":"C₂₁H₃₀O₃","hill":"C21H30O3","elements":["H","C","O"],"composition":{"C":21.0,"H":30.0,"O":3.0},"names":{"en":"7-hydroxycannabidiol"},"descriptions":{"en":"7-Hydroxycannabidiol (7-OH-CBD) is an active metabolite of cannabidiol, generated in the body from cannabidiol by the action of the enzyme CYP2C19. While methods have been developed for its synthetic production, and measurement of levels in the body following consumption of cannabidiol, its pharmacology has been relatively little studied, though it has been found to possess similar anticonvulsant effects to cannabidiol itself, as well as lowering blood triglyceride levels. Like its precursor CBD, it is not known to exhibit any psychoactive effects on the body and is known to counter the psychoactive effects of THC if it is present at the same time."},"fame":1,"pubchemCid":11301963,"mass":330.5,"charge":0,"smiles":"CCCCCC1=CC(=C(C(=C1)O)[C@@H]2C=C(CC[C@H]2C(=C)C)CO)O","inchikey":"ZELUXPWDPVXUEI-ZWKOTPCHSA-N","iupac":"2-[(1R,6R)-3-(hydroxymethyl)-6-prop-1-en-2-ylcyclohex-2-en-1-yl]-5-pentylbenzene-1,3-diol","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"11301963","atoms":54,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-0.028,"y":-0.716,"z":1.609,"el":"O"},{"x":0.344,"y":1.898,"z":-2.394,"el":"O"},{"x":4.12,"y":-3.838,"z":-0.883,"el":"O"},{"x":2.468,"y":0.716,"z":0.722,"el":"C"},{"x":1.658,"y":0.207,"z":-0.504,"el":"C"},{"x":3.853,"y":0.059,"z":0.761,"el":"C"},{"x":3.742,"y":-1.465,"z":0.84,"el":"C"},{"x":1.827,"y":-1.278,"z":-0.746,"el":"C"},{"x":2.745,"y":-2.042,"z":-0.13,"el":"C"},{"x":0.184,"y":0.584,"z":-0.394,"el":"C"},{"x":2.618,"y":2.21,"z":0.712,"el":"C"},{"x":-0.577,"y":0.097,"z":0.664,"el":"C"},{"x":-0.391,"y":1.414,"z":-1.353,"el":"C"},{"x":2.839,"y":-3.519,"z":-0.3
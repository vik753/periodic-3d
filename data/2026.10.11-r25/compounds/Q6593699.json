{"version":"2026.10.11-r25","id":"Q6593699","formula":"C₁₅H₂₃NO₂S","hill":"C15H23NO2S","elements":["H","C","N","O","S"],"composition":{"C":15.0,"H":23.0,"N":1.0,"O":2.0,"S":1.0},"names":{"en":"OSU-6162"},"descriptions":{"en":"OSU-6162, also known as PNU-96391, is a compound which acts as a partial agonist at both dopamine D2 receptors and 5-HT2A receptors. It acts as a dopamine stabilizer in a similar manner to the closely related drug pridopidine, and has antipsychotic, anti-addictive and anti-Parkinsonian effects in animal studies. Both enantiomers show similar activity but with different ratios of effects, with the (S) enantiomer (–)-OSU-6162 that is more commonly used in research, having higher binding affinity to D2 but is a weaker partial agonist at 5-HT2A, while the (R) enantiomer (+)-OSU-6162 has higher efficacy at 5-HT2A but lower D2 affinity."},"fame":7,"pubchemCid":9795741,"mass":281.4,"charge":0,"smiles":"CCCN1CCC[C@H](C1)C2=CC(=CC=C2)S(=O)(=O)C","inchikey":"GZVBVBMMNFIXGE-CQSZACIVSA-N","iupac":"(3S)-3-(3-methylsulfonylphenyl)-1-propylpiperidine","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"9795741","atoms":42,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":3.623,"y":-0.946,"z":0.895,"el":"S"},{"x":5.001,"y":-0.588,"z":0.592,"el":"O"},{"x":3.123,"y":-0.808,"z":2.256,"el":"O"},{"x":-3.218,"y":0.234,"z":0.231,"el":"N"},{"x":-1.0,"y":1.221,"z":-0.292,"el":"C"},{"x":-1.82,"y":-0.073,"z":-0.113,"el":"C"},{"x":-1.082,"y":2.095,"z":0.969,"el":"C"},{"x":-2.539,"y":2.327,"z":1.359,"el":"C"},{"x":-3.301,"y":1.007,"z":1.477,"el":"C"},{"x":0.438,"y":0.933,"z":-0.685,"el":"C"},{"x":-4.0,"y":-0.998,"z":0.34,"el":"C"},{"x":-3.94,"y":-1.782,"z":-0.969,"el":"C"},{"x":1.264,"y":0.218,"z":0.179,"el":"C"},{"x":0.925,"y":1.385,"z":-1.91,"el":"C"},{"x":2.585,"y":-0.047,"z":-0.184,"el":"C"},{"
{"version":"2026.10.11-r25","id":"Q4060119","formula":"C₂₇H₂₂ClN₇O₁₀S₃","hill":"C27H22ClN7O10S3","elements":["H","C","N","O","S","Cl"],"composition":{"C":27.0,"H":22.0,"N":7.0,"O":10.0,"S":3.0,"Cl":1.0},"names":{"en":"5-({4-chloro-6-[methyl(phenyl)amino]-1,3,5-triazin-2-yl}amino)-4-hydroxy-3-[(E)-(4-methyl-2-sulfophenyl)diazenyl]naphthalene-2,7-disulfonic acid","ru":"Активный ярко-красный 6С"},"descriptions":{"ru":"Активный ярко-красный 6С — это монохлортриазиновый активный азокраситель, придающий целлюлозе красный цвет с сильным синим оттенком. Как и другие триазиновые активные красители, закрепляется в процессе взаимодействия с красителем функциональных групп волокна (или иного окрашиваемого материала) с образованием ковалентной связи. При 70—90 °C в присутствии щелочного агента, в гидрокси- или аминогруппе окрашиваемого вещества атом водорода замещается на остаток красителя, то есть вместо связи триазинового фрагмента красителя с хлором образуется связь с азотом или кислородом соответствующих групп окрашиваемого субстрата."},"fame":1,"pubchemCid":null,"mass":null,"charge":0,"smiles":"Cc1ccc(c(c1)S(=O)(=O)O)/N=N/c2c(cc3cc(cc(c3c2O)Nc4nc(nc(n4)Cl)N(C)c5ccccc5)S(=O)(=O)O)S(=O)(=O)O","inchikey":null,"iupac":null,"classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"rdkit","ref":null,"atoms":70,"license":"Computed with RDKit from SMILES (PubChem, Wikidata)"},"structure":{"kind":"molecule","atoms":[{"x":7.517,"y":-3.291,"z":2.55,"el":"C"},{"x":6.424,"y":-2.432,"z":1.987,"el":"C"},{"x":5.511,"y":-2.938,"z":1.061,"el":"C"},{"x":4.502,"y":-2.119,"z":0.544,"el":"C"},{"x":4.381,"y":-0.77,"z":0.925,"el":"C"},{"x":5.289,"y":-0.279,"z":1.866,"el":"C"},{"x":6.308,"y":-1.097,"z":2.388,"el":"C"},{"x":5.224,"y":1.388,"z":2.462,"el":"S"},{"x":6.586,"y":1.881,"z":2.466,"el":"O"},{"x":4.423,"y":1.362,"z":3.666,"el":"O"},{"x":4.446,"y":2.277,"z":1.367,"el":"O"},
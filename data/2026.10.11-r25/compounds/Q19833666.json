{"version":"2026.10.11-r25","id":"Q19833666","formula":"K₃Na₃Ca₅Si₁₂O₃₀F₄·H₂O","hill":"Ca5F4H2K3Na3O31Si12","elements":["H","O","F","Na","Si","K","Ca"],"composition":{"F":4.0,"H":2.0,"K":3.0,"O":31.0,"Ca":5.0,"Na":3.0,"Si":12.0},"names":{"en":"Fluorcanasite"},"descriptions":{"en":"Fluorcanasite is a rare calcium, potassium and sodium fluoride silicate mineral. It was discovered in 2003, in the Kirovsk mine's dumps in Russia, and was approved by the IMA in 2007. The name fluorcanasite is a portmanteau, and was made by blending fluorine, a chemical element that can be found in the mineral, and canasite, as the mineral is close to canasite in several ways: it is an analogue of said mineral and a member of the canasite group."},"fame":3,"pubchemCid":null,"mass":null,"charge":0,"smiles":null,"inchikey":null,"iupac":null,"classes":[{"qid":"Q12089225","names":{"en":"mineral species","ru":"действительный вид минералов","uk":"мінеральний вид"}}],"structureInfo":null,"structure":null,"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q19833666","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Fluorcanasite","license":"CC BY-SA 4.0"}],"similar":[{"id":"Q3655118","formula":"K₃Na₃Ca₅Si₁₂O₃₀(OH)₄","names":{"en":"Canasite"},"elements":["H","O","Na","Si","K","Ca"],"fame":8,"kind":null},{"id":"Q3816089","formula":"Ca₂MnZrNa₃Ti(Si₂O₇)₂(OF)F₂","names":{"en":"Kochite","ru":"Кохит"},"elements":["O","F","Na","Si","Ca","Ti","Mn","Zr"],"fame":5,"kind":null},{"id":"Q415135","formula":"Na₄BeAlSi₄O₁₂Cl","names":{"en":"Tugtupite","ru":"Тугтупит","uk":"Тугтупіт"},"elements":["Be","O","Na","Al","Si","Cl"],"fame":21,"kind":"crystal"},{"id":"Q396466","formula":"NaCa₂Si₄O₁₀F","names":{"en":"Agrellite","ru":"Агреллит","uk":"Агреліт"},"elements":["O","F","Na","Si","Ca"],"fame":17,"kind":"crystal"},{"id":"Q4006642","formula":"Na₂AlSi₃O₈(OH)","names":{"en":"Ussingite"},"elements":["H","O","Na","Al","Si"],"fame":11,
{"version":"2026.10.11-r25","id":"Q15409350","formula":"C₁₀H₁₅N","hill":"C10H15N","elements":["H","C","N"],"composition":{"C":10.0,"H":15.0,"N":1.0},"names":{"en":"Phenylisobutylamine"},"descriptions":{"en":"Phenylisobutylamine, also known as α-ethylphenethylamine (AEPEA) or as butanphenamine (B), is a stimulant drug of the phenethylamine and amphetamine families. It is a higher homologue of amphetamine, differing from amphetamine's molecular structure only by the substitution of the methyl group at the alpha position of the side chain with an ethyl group. Phenylisobutylamine acts as a norepinephrine–dopamine releasing agent (NDRA) and has been found to produce stimulant-like and reinforcing effects in animals."},"fame":3,"pubchemCid":103771,"mass":149.23,"charge":0,"smiles":"CCC(CC1=CC=CC=C1)N","inchikey":"IOLQWLOHKZENDW-UHFFFAOYSA-N","iupac":"1-phenylbutan-2-amine","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"103771","atoms":26,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-3.143,"y":-1.179,"z":-0.256,"el":"N"},{"x":-1.9,"y":-0.514,"z":0.151,"el":"C"},{"x":-0.74,"y":-1.057,"z":-0.71,"el":"C"},{"x":-2.058,"y":1.013,"z":0.021,"el":"C"},{"x":0.605,"y":-0.492,"z":-0.344,"el":"C"},{"x":-3.219,"y":1.57,"z":0.838,"el":"C"},{"x":1.054,"y":0.665,"z":-0.966,"el":"C"},{"x":1.382,"y":-1.135,"z":0.612,"el":"C"},{"x":2.302,"y":1.189,"z":-0.627,"el":"C"},{"x":2.629,"y":-0.611,"z":0.951,"el":"C"},{"x":3.089,"y":0.551,"z":0.331,"el":"C"},{"x":-1.709,"y":-0.761,"z":1.203,"el":"H"},{"x":-0.935,"y":-0.86,"z":-1.773,"el":"H"},{"x":-0.696,"y":-2.152,"z":-0.625,"el":"H"},{"x":-1.153,"y":1.512,"z":0.38,"el":"H"},{"x":-2.192,"y":1.298,"z":-1.03,"el":"H"},{"x":-3.199,"y":2.665,"z":0.814,"el":"H"},{"x":-4.187,"y":1.254,"z":0.438,"el":"H"},{"x":-3.152,"y":1.255,"z":1.884,"el":"H"},{"x":-3.889,"y":-0.953,"z
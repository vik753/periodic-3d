{"version":"2026.10.11-r25","id":"Q2567690","formula":"C₃₄H₂₈Cl₂FeP₂Pd","hill":"C34H28Cl2FeP2Pd","elements":["H","C","P","Cl","Fe","Pd"],"composition":{"C":34.0,"H":28.0,"P":2.0,"Cl":2.0,"Fe":1.0,"Pd":1.0},"names":{"en":"[1,1'-bis(diphenylphosphino)ferrocene]palladium(II) dichloride"},"descriptions":{"en":"[1,1'‑Bis(diphenylphosphino)ferrocene]palladium(II) dichloride is a palladium complex containing the bidentate ligand 1,1'-bis(diphenylphosphino)ferrocene (dppf), abbreviated as [(dppf)PdCl2]. This commercially available material can be prepared by reacting dppf with a suitable nitrile complex of palladium dichloride: dppf + PdCl2(RCN)2 → (dppf)PdCl2 + 2 RCN (RCN = CH3CN or C6H5CN) A mechanochemical approach for the synthesis of this compound has also recently been reported. The method involves the direct use of PdCl2 with the exact amount of dppf, obtaining the final complex in 60 minutes."},"fame":11,"pubchemCid":null,"mass":null,"charge":0,"smiles":null,"inchikey":null,"iupac":null,"classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":null,"structure":null,"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q2567690","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/%281%2C1%27-Bis%28diphenylphosphino%29ferrocene%29palladium%28II%29_dichloride","license":"CC BY-SA 4.0"}],"similar":[{"id":"Q414182","formula":"C₅₄H₄₅ClP₃Rh","names":{"en":"Wilkinson's catalyst","ru":"Катализатор Уилкинсона","uk":"Каталізатор Вілкінсона"},"elements":["H","C","P","Cl","Rh"],"fame":22,"kind":"molecule"},{"id":"Q421154","formula":"C₁₈H₁₅OP","names":{"en":"Triphenylphosphine oxide","uk":"Трифенілфосфаноксид"},"elements":["H","C","O","P"],"fame":18,"kind":"molecule"},{"id":"Q413810","formula":"C₁₂H₁₁P","names":{"en":"Diphenylphosphine","ru":"Дифенилфосфин"},"elements":["H","C","P"],"fame":17,"kind":"molecul
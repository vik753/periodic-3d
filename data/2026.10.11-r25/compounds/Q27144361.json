{"version":"2026.10.11-r25","id":"Q27144361","formula":"C₁₂H₁₄N₂O₃","hill":"C12H14N2O3","elements":["H","C","N","O"],"composition":{"C":12.0,"H":14.0,"N":2.0,"O":3.0},"names":{"en":"5-methoxytryptophan"},"descriptions":{"en":"5-Methoxytryptophan (5-MTP), or 5-methoxy-L-tryptophan, also known as 5-methoxy-α-carboxytryptamine or as cytoguardin, is an endogenous metabolite of tryptophan with anti-inflammatory and anti-fibrotic effects. It is biosynthesized in two steps by tryptophan hydroxylase (TPH) and then by hydroxyindole O-methyltransferase (HIOMT), with 5-hydroxytryptophan (5-HTP) as a metabolic intermediate. 5-MTP is also a metabolic precursor of 5-methoxytryptamine."},"fame":2,"pubchemCid":151018,"mass":234.25,"charge":0,"smiles":"COC1=CC2=C(C=C1)NC=C2C[C@@H](C(=O)O)N","inchikey":"KVNPSKDDJARYKK-JTQLQIEISA-N","iupac":"(2S)-2-amino-3-(5-methoxy-1H-indol-3-yl)propanoic acid","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"151018","atoms":31,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-2.827,"y":-2.16,"z":-0.219,"el":"O"},{"x":1.627,"y":-0.521,"z":1.896,"el":"O"},{"x":2.182,"y":-2.23,"z":0.512,"el":"O"},{"x":-0.608,"y":2.835,"z":0.207,"el":"N"},{"x":4.064,"y":-0.615,"z":-0.663,"el":"N"},{"x":0.759,"y":1.28,"z":-0.593,"el":"C"},{"x":1.96,"y":0.614,"z":-1.136,"el":"C"},{"x":-0.499,"y":0.671,"z":-0.325,"el":"C"},{"x":-1.338,"y":1.669,"z":0.177,"el":"C"},{"x":2.901,"y":0.027,"z":-0.053,"el":"C"},{"x":0.661,"y":2.61,"z":-0.256,"el":"C"},{"x":-1.006,"y":-0.636,"z":-0.461,"el":"C"},{"x":-2.664,"y":1.423,"z":0.55,"el":"C"},{"x":-2.33,"y":-0.897,"z":-0.091,"el":"C"},{"x":-3.145,"y":0.118,"z":0.407,"el":"C"},{"x":2.205,"y":-1.035,"z":0.78,"el":"C"},{"x":-1.944,"y":-3.154,"z":-0.734,"el":"C"},{"x":1.651,"y":-0.185,"z":-1.824,"el":"H"},{"x":2.524,"y":1.331,"z":-1.748,"el":"H"},{"x":3.257,"y"
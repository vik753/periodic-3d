{"version":"2026.10.11-r25","id":"Q2739171","formula":"CoNi₂S₄","hill":"CoNi2S4","elements":["S","Co","Ni"],"composition":{"S":4.0,"Co":1.0,"Ni":2.0},"names":{"en":"Siegenite"},"descriptions":{"en":"Siegenite (also called grimmite, or nickel cobalt sulfide) is a ternary transition metal dichalcogenide compound with the chemical formula (Ni,Co)3S4. It has been actively studied as a promising material system for electrodes in electrochemical energy applications due to its better conductivity, greater mechanical and thermal stability, and higher performance compared to metal oxides currently in use. Potential applications of this material system include supercapacitors, batteries, electrocatalysis, dye-sensitized solar cells, photocatalysis, glucose sensors, and microwave absorption."},"fame":11,"pubchemCid":null,"mass":null,"charge":0,"smiles":null,"inchikey":null,"iupac":null,"classes":[{"qid":"Q12089225","names":{"en":"mineral species","ru":"действительный вид минералов","uk":"мінеральний вид"}}],"structureInfo":{"kind":"crystal","source":"materialsproject","ref":"mp-674355","atoms":45,"license":"CC BY 4.0, Materials Project"},"structure":{"cell":[[6.578,0.0,0.0],[0.0,6.631,0.0],[0.0,0.0,9.338]],"kind":"crystal","atoms":[{"x":1.645,"y":4.974,"z":7.004,"el":"Co"},{"x":4.934,"y":4.974,"z":7.004,"el":"Co"},{"x":0.0,"y":4.974,"z":3.496,"el":"Ni"},{"x":6.578,"y":4.974,"z":3.496,"el":"Ni"},{"x":3.289,"y":3.316,"z":4.669,"el":"Ni"},{"x":0.0,"y":3.316,"z":0.0,"el":"Ni"},{"x":0.0,"y":3.316,"z":9.338,"el":"Ni"},{"x":6.578,"y":3.316,"z":0.0,"el":"Ni"},{"x":6.578,"y":3.316,"z":9.338,"el":"Ni"},{"x":3.289,"y":4.974,"z":1.173,"el":"Ni"},{"x":1.744,"y":4.974,"z":4.764,"el":"S"},{"x":4.835,"y":4.974,"z":4.764,"el":"S"},{"x":3.289,"y":3.449,"z":6.937,"el":"S"},{"x":3.289,"y":6.498,"z":6.937,"el":"S"},{"x":0.0,"y":3.449,"z":7.071,"el":"S"},{"x":6.578,"y":3.449,"z":7.071,"el":"S"},{"x":0.0,"y":6.498,"z":7.071,"el":"S"},{"x":6.578,"y":6.498,"z":7.071,"el":"S"},{"x":5.033,"y":4.974,"z":
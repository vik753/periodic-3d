{"version":"2026.10.11-r25","id":"Q6109184","formula":"C₂₆H₂₇NO₂","hill":"C26H27NO2","elements":["H","C","N","O"],"composition":{"C":26.0,"H":27.0,"N":1.0,"O":2.0},"names":{"en":"JWH-098"},"descriptions":{"en":"JWH-098 is a synthetic cannabinoid receptor agonist from the naphthoylindole family. It is the indole 2-methyl derivative of a closely related compound JWH-081, but has markedly different affinity for the CB1 and CB2 receptors. While JWH-081 is around tenfold selective for CB1 over CB2, in JWH-098 this is reversed, and it is around four times weaker than JWH-081 at CB1 while being six times more potent at CB2, giving it a slight selectivity for CB2 overall."},"fame":5,"pubchemCid":45272116,"mass":385.5,"charge":0,"smiles":"CCCCCN1C(=C(C2=CC=CC=C21)C(=O)C3=CC=C(C4=CC=CC=C43)OC)C","inchikey":"CNTCHEBQQFICNR-UHFFFAOYSA-N","iupac":"(4-methoxynaphthalen-1-yl)-(2-methyl-1-pentylindol-3-yl)methanone","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"45272116","atoms":56,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":0.652,"y":2.724,"z":0.168,"el":"O"},{"x":4.954,"y":-1.549,"z":2.042,"el":"O"},{"x":-2.81,"y":0.479,"z":-0.617,"el":"N"},{"x":-4.244,"y":0.683,"z":-0.654,"el":"C"},{"x":-1.904,"y":1.37,"z":-0.107,"el":"C"},{"x":-2.162,"y":-0.639,"z":-1.091,"el":"C"},{"x":-0.648,"y":0.825,"z":-0.251,"el":"C"},{"x":-0.796,"y":-0.446,"z":-0.873,"el":"C"},{"x":-5.005,"y":-0.067,"z":0.445,"el":"C"},{"x":-6.506,"y":0.236,"z":0.449,"el":"C"},{"x":0.616,"y":1.487,"z":0.182,"el":"C"},{"x":-2.322,"y":2.665,"z":0.473,"el":"C"},{"x":-2.675,"y":-1.794,"z":-1.692,"el":"C"},{"x":0.104,"y":-1.454,"z":-1.271,"el":"C"},{"x":-7.209,"y":-0.463,"z":1.613,"el":"C"},{"x":1.785,"y":0.726,"z":0.613,"el":"C"},{"x":-1.763,"y":-2.781,"z":-2.079,"el":"C"},{"x":-0.395,"y":-2.615,"z":-1.873,"el":"C"},{"x":3.026,"y":0.818,"
{"version":"2026.10.11-r25","id":"Q428379","formula":"Al₂(PO₄)F₂(OH)(H₂O)₃·4H₂O","hill":"Al2F2H15O12P","elements":["H","O","F","Al","P"],"composition":{"F":2.0,"H":15.0,"O":12.0,"P":1.0,"Al":2.0},"names":{"en":"Fluellite","uk":"Флюеліт"},"descriptions":{"en":"Fluellite is a mineral with the chemical formula Al2(PO4)F2(OH)•7H2O. The name is from its chemical composition, being a fluate of alumine (French). It was first described in 1824 for an occurrence in the Stenna Gwyn Mine, St Stephen-in-Brannel, St Austell District, Cornwall, England. It is a rare secondary mineral found in complex granite pegmatites where it forms by weathering of earlier phosphate minerals.","uk":"Флюеліт (рос. флюеллит; англ. fluellite; нім."},"fame":9,"pubchemCid":null,"mass":null,"charge":0,"smiles":null,"inchikey":null,"iupac":null,"classes":[{"qid":"Q12089225","names":{"en":"mineral species","ru":"действительный вид минералов","uk":"мінеральний вид"}}],"structureInfo":null,"structure":null,"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q428379","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Fluellite","license":"CC BY-SA 4.0"},{"role":"description","name":"Wikipedia (uk)","url":"https://uk.wikipedia.org/wiki/%D0%A4%D0%BB%D1%8E%D0%B5%D0%BB%D1%96%D1%82","license":"CC BY-SA 4.0"},{"role":"photo","name":"Wikimedia Commons","url":"https://commons.wikimedia.org/wiki/File:Fluellite-111339.jpg","license":"CC BY-SA 3.0"}],"similar":[{"id":"Q415880","formula":"Al₃PO₄(OH)₆·6H₂O","names":{"en":"Evansite","ru":"Эвансит"},"elements":["H","O","Al","P"],"fame":11,"kind":null},{"id":"Q19862339","formula":"Al₆(AsO₄)₃(OH)₉·16H₂O","names":{"en":"Bettertonite"},"elements":["H","O","Al","As"],"fame":4,"kind":null},{"id":"Q5319","formula":"Na₂B₄O₇·10H₂O","names":{"en":"Borax","ru":"Тетраборат натрия","uk":"Бура"},"elements":["H","B","O","Na"],"fame":69,"kind":"crystal"},{"id":"Q409918","formula":"Cu(UO₂)₂(PO₄)₂·12H₂O
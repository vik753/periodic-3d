{"version":"2026.10.11-r25","id":"Q2462786","formula":"H₄₂Co₄N₁₂O₁₈S₃","hill":"Co4H42N12O18S3","elements":["H","N","O","S","Co"],"composition":{"H":42.0,"N":12.0,"O":18.0,"S":3.0,"Co":4.0},"names":{"en":"Hexol"},"descriptions":{"en":"In chemistry, hexol is a cation with formula {[Co(NH3)4(OH)2]3Co}6+ — a coordination complex consisting of four cobalt cations in oxidation state +3, twelve ammonia molecules NH3, and six hydroxy anions HO−, with a net charge of +6. The hydroxy groups act as bridges between the central cobalt atom and the other three, which carry the ammonia ligands. Salts of hexol, such as the sulfate {[Co(NH3)4(OH)2]3Co}(SO4)3(H2O)x, are of historical significance as the first synthetic non-carbon-containing chiral compounds."},"fame":8,"pubchemCid":null,"mass":null,"charge":0,"smiles":null,"inchikey":null,"iupac":null,"classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":null,"structure":null,"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q2462786","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Hexol","license":"CC BY-SA 4.0"}],"similar":[{"id":"Q413075","formula":"CuH₁₄N₄O₅S","names":{"en":"Tetraamminecopper sulfate monohydrate","ru":"Сульфат тетраамминмеди(II)"},"elements":["H","N","O","S","Cu"],"fame":17,"kind":"molecule"},{"id":"Q2336041","formula":"H₈N₂O₃S","names":{"en":"Ammonium sulfite","ru":"Сульфит аммония"},"elements":["H","N","O","S"],"fame":17,"kind":"molecule"},{"id":"Q1623343","formula":"Cu(CH₃COO)₂·H₂O","names":{"en":"Hoganite","uk":"Гоґаніт"},"elements":["H","C","O","Cu"],"fame":6,"kind":"crystal"},{"id":"Q191831","formula":"H₈N₂O₄S","names":{"en":"Ammonium sulfate","ru":"Сульфат аммония","uk":"Сульфат амонію"},"elements":["H","N","O","S"],"fame":58,"kind":"crystal"},{"id":"Q421123","formula":"CH₅NO₃","names":{"en":"Ammonium hydrogen carbonate","
{"version":"2026.10.11-r25","id":"Q3623985","formula":"Al(UO₂)₂(AsO₄)₂F·20H₂O","hill":"AlAs2FH40O32U2","elements":["H","O","F","Al","As","U"],"composition":{"F":1.0,"H":40.0,"O":32.0,"U":2.0,"Al":1.0,"As":2.0},"names":{"en":"Arsenuranospathite"},"descriptions":{"en":"Arsenuranospathite (IMA symbol: Aush) is a rare mineral with the chemical formula Al(UO2)2(AsO4)2F·20H2O. The name \"arsenuranospathite\" as arsenate analog of uranospathite was first used by Walenta (1963) with reference to a uranyl-arsenate mineral from Black Forest (Schwarzwald) massif, Germany. Later it was undoubtedly demonstrated that the name arsenuranospathite was applied, at least, to two different species – proper arsenuranospathite, ideally Al(UO2)2(AsO4)2F·20H2O, orthorhombic, and its partially dehydrated analogue, Al(UO2)2(AsO4)2F·nH2O (n = 8–10), tetragonal or pseudo-tetragonal."},"fame":8,"pubchemCid":null,"mass":null,"charge":0,"smiles":null,"inchikey":null,"iupac":null,"classes":[{"qid":"Q12089225","names":{"en":"mineral species","ru":"действительный вид минералов","uk":"мінеральний вид"}}],"structureInfo":null,"structure":null,"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q3623985","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Arsenuranospathite","license":"CC BY-SA 4.0"},{"role":"photo","name":"Wikimedia Commons","url":"https://commons.wikimedia.org/wiki/File:Arsenuranospathite,_Menzenschwand.jpg","license":"CC BY-SA 4.0"}],"similar":[{"id":"Q413750","formula":"Al₂SO₄(OH)₄·7H₂O","names":{"en":"Aluminite","ru":"Алюминит","uk":"Алюмініт"},"elements":["H","O","Al","S"],"fame":22,"kind":"crystal"},{"id":"Q171877","formula":"H₂O₂","names":{"en":"Hydrogen peroxide","ru":"Пероксид водорода","uk":"Перекис водню"},"elements":["H","O"],"fame":75,"kind":"molecule"},{"id":"Q26840944","formula":"AlH₂₄KO₂₀S₂","names":{"en":"Potassium aluminium sulfate dodecahydrate","ru":"Сульфат алюминия-калия"},"eleme
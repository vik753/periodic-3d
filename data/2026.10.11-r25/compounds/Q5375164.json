{"version":"2026.10.11-r25","id":"Q5375164","formula":"C₂₄H₃₂N₂O₃","hill":"C24H32N2O3","elements":["H","C","N","O"],"composition":{"C":24.0,"H":32.0,"N":2.0,"O":3.0},"names":{"en":"Enadoline"},"descriptions":{"en":"Enadoline (developmental code name CI-977) is a drug which acts as a highly selective κ-opioid agonist. In human studies, it produced visual distortions and feelings of dissociation, reminiscent of the effects of salvinorin A. It was studied as a potential analgesic, but abandoned because of the dose-limiting effects of dysphoria, which could be expected from a κ-opioid agonist. There was mention of its potential in treating comatose head injury or stroke victims, where that type of side effect would be immaterial."},"fame":4,"pubchemCid":60768,"mass":396.5,"charge":0,"smiles":"CN([C@H]1CC[C@@]2(CCCO2)C[C@@H]1N3CCCC3)C(=O)CC4=C5C=COC5=CC=C4","inchikey":"JMBYBVLCYODBJQ-HFMPRLQTSA-N","iupac":"2-(1-benzofuran-4-yl)-N-methyl-N-[(5R,7S,8S)-7-pyrrolidin-1-yl-1-oxaspiro[4.5]decan-8-yl]acetamide","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"60768","atoms":61,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":5.506,"y":-0.552,"z":1.298,"el":"O"},{"x":-1.276,"y":-0.658,"z":1.083,"el":"O"},{"x":-6.078,"y":1.345,"z":0.3,"el":"O"},{"x":1.493,"y":1.615,"z":-0.295,"el":"N"},{"x":0.228,"y":-1.012,"z":-0.66,"el":"N"},{"x":4.402,"y":-0.769,"z":0.391,"el":"C"},{"x":2.249,"y":0.377,"z":-0.409,"el":"C"},{"x":3.571,"y":0.529,"z":0.356,"el":"C"},{"x":1.424,"y":-0.808,"z":0.127,"el":"C"},{"x":3.546,"y":-1.916,"z":0.941,"el":"C"},{"x":2.251,"y":-2.099,"z":0.158,"el":"C"},{"x":5.041,"y":-1.108,"z":-0.96,"el":"C"},{"x":6.355,"y":-0.369,"z":-0.903,"el":"C"},{"x":2.23,"y":2.768,"z":-0.814,"el":"C"},{"x":1.184,"y":1.956,"z":1.093,"el":"C"},{"x":6.73,"y":-0.519,"z":0.553,"el":"C"},{"x":1.451,"y":3.949,"z"
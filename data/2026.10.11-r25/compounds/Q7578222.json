{"version":"2026.10.11-r25","id":"Q7578222","formula":"C₂₂H₂₅N₃O₄","hill":"C22H25N3O4","elements":["H","C","N","O"],"composition":{"C":22.0,"H":25.0,"N":3.0,"O":4.0},"names":{"en":"Spirotryprostatin A"},"descriptions":{"en":"Spirotryprostatin A is an indolic alkaloid from the 2,5-Diketopiperazine class of natural products found in the Aspergillus fumigatus fungus. Spirotryprostatin A and several other indolic alkaloids (including Spirotryprostatin B, as well as other tryprostatins and cyclotryprostatins) have been found to have anti-mitotic properties, and as such they have become of great interest as anti-cancer drugs. Because of this, the total syntheses of these compounds is a major pursuit of organic chemists, and a number of different syntheses have been published in the chemical literature."},"fame":2,"pubchemCid":10408374,"mass":395.5,"charge":0,"smiles":"CC(=C[C@H]1[C@]2(C[C@@H]3N1C(=O)[C@@H]4CCCN4C3=O)C5=C(C=C(C=C5)OC)NC2=O)C","inchikey":"MQJKGSIAJNXSCM-ORGXJRBJSA-N","iupac":"(3S,5S,6S,9S)-6'-methoxy-6-(2-methylprop-1-enyl)spiro[1,7-diazatricyclo[7.3.0.03,7]dodecane-5,3'-1H-indole]-2,2',8-trione","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"10408374","atoms":54,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":2.663,"y":1.841,"z":2.303,"el":"O"},{"x":2.823,"y":-1.531,"z":-1.799,"el":"O"},{"x":-0.102,"y":1.952,"z":-2.349,"el":"O"},{"x":-6.053,"y":0.011,"z":0.986,"el":"O"},{"x":1.657,"y":-0.008,"z":-0.48,"el":"N"},{"x":3.893,"y":0.617,"z":0.757,"el":"N"},{"x":-2.309,"y":1.523,"z":-1.708,"el":"N"},{"x":-0.604,"y":0.666,"z":-0.279,"el":"C"},{"x":0.299,"y":-0.538,"z":-0.643,"el":"C"},{"x":1.676,"y":1.308,"z":0.158,"el":"C"},{"x":0.257,"y":1.505,"z":0.681,"el":"C"},{"x":4.05,"y":0.195,"z":-0.633,"el":"C"},{"x":-1.992,"y":0.381,"z":0.24,"el":"C"},{"x":2.759,"y":1.269,"z":1.221,"el":
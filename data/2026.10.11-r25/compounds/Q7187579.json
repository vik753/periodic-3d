{"version":"2026.10.11-r25","id":"Q7187579","formula":"NOP","hill":"NOP","elements":["N","O","P"],"composition":{"N":1.0,"O":1.0,"P":1.0},"names":{"en":"Phosphoryl nitride"},"descriptions":{"en":"Phosphoryl nitride is an inorganic chemical with the structure O=P≡N. It is a linear molecule consisting of oxygen, phosphorus, and nitrogen. It has a formal double bond between P and O (a phosphoryl substructure) and a triple bond between P and N (a nitride). It can be obtained in argon matrix isolation at 16 K by laser photolysis of phosphoryl triazide, OP(N3)3."},"fame":4,"pubchemCid":15919777,"mass":60.98,"charge":0,"smiles":"N#P=O","inchikey":"CMMOOVZPVLKJPM-UHFFFAOYSA-N","iupac":"azanylidyne(oxo)-lambda5-phosphane","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"15919777","atoms":3,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":0.044,"y":0.621,"z":0.0,"el":"P"},{"x":-1.097,"y":-0.291,"z":0.0,"el":"O"},{"x":1.053,"y":-0.329,"z":0.0,"el":"N"}],"bonds":[[0,1,2],[0,2,3]]},"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q7187579","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Phosphoryl_nitride","license":"CC BY-SA 4.0"},{"role":"properties","name":"PubChem","url":"https://pubchem.ncbi.nlm.nih.gov/compound/15919777","license":"PubChem (NIH), public data"},{"role":"structure","name":"PubChem 3D","url":"https://pubchem.ncbi.nlm.nih.gov/compound/15919777#section=3D-Conformer","license":"PubChem (NIH), public data"}],"similar":[{"id":"Q59314163","formula":"COP⁻","names":{"en":"Phosphaethynolate"},"elements":["C","O","P"],"fame":2,"kind":"molecule"},{"id":"Q19596252","formula":"CP","names":{"en":"Carbon monophosphide","uk":"Монофосфід вуглецю"},"elements":["C","P"],"fame":9,"kind":"molecule"},{"id":"Q562
{"version":"2026.10.11-r25","id":"Q25972347","formula":"Ag₅₁Tm₁₄","hill":"Ag51Tm14","elements":["Ag","Tm"],"composition":{"Ag":51.0,"Tm":14.0},"names":{"ru":"Генпентаконтасеребротетрадекатулий"},"descriptions":{"ru":"Генпентаконтасеребротетрадекатулий — интерметаллид тулия и серебра состава Ag51Tm14. Кристаллизуется в гексагональной сингонии, пространственная группа P 6/m, параметры ячейки a = 1,25924(6) нм, c = 0,91939(5) нм, Z = 1, структура типа тетрадекагадолинийгенпентаконтасеребра Gd14Ag51 . Соединение было описано в 1969 году как TmAg3 с помощью рентген-дифракционного анализа структуры кристаллов, однако в более поздней работе эти данные были интерпретированы как проявление близкого по стехиометрии Tm14Ag51, находящегося в ряду других аналогичных по структуре интерметаллидов редкоземельных металлов и серебра R14Ag51."},"fame":1,"pubchemCid":null,"mass":null,"charge":0,"smiles":null,"inchikey":null,"iupac":null,"classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":null,"structure":null,"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q25972347","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (ru)","url":"https://ru.wikipedia.org/wiki/%D0%93%D0%B5%D0%BD%D0%BF%D0%B5%D0%BD%D1%82%D0%B0%D0%BA%D0%BE%D0%BD%D1%82%D0%B0%D1%81%D0%B5%D1%80%D0%B5%D0%B1%D1%80%D0%BE%D1%82%D0%B5%D1%82%D1%80%D0%B0%D0%B4%D0%B5%D0%BA%D0%B0%D1%82%D1%83%D0%BB%D0%B8%D0%B9","license":"CC BY-SA 4.0"}],"similar":[{"id":"Q26207758","formula":"Ag₃Tm","names":{"ru":"Трисеребротулий"},"elements":["Ag","Tm"],"fame":1,"kind":"crystal"},{"id":"Q26207748","formula":"Ag₅₁Tb₁₄","names":{"ru":"Генпентаконтасеребротетрадекатербий"},"elements":["Ag","Tb"],"fame":1,"kind":"crystal"},{"id":"Q26207766","formula":"Yb₂Ag₇","names":{"ru":"Гептасеребродииттербий"},"elements":["Ag","Yb"],"fame":1,"kind":"crystal"},{"id":"Q25390290","formula":"Ag₅Eu","names":{"ru":"Пентасереброев
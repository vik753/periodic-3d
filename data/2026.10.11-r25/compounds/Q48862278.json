{"version":"2026.10.11-r25","id":"Q48862278","formula":"C₂₀H₂₈O₂","hill":"C20H28O2","elements":["H","C","O"],"composition":{"C":20.0,"H":28.0,"O":2.0},"names":{"en":"Ethylestradiol"},"descriptions":{"en":"Ethylestradiol, or 17α-ethylestradiol, also known as 17α-ethylestra-1,3,5(10)-triene-3,17β-diol, is a synthetic estrogen which was never marketed. It occurs as an active metabolite of the anabolic steroids norethandrolone and ethylestrenol formed via aromatase and is believed to be responsible for the estrogenic effects of norethandrolone and ethylestrenol. The 3-methyl ether of ethylestradiol has been used as an intermediate in the synthesis of certain 19-nortestosterone anabolic steroids, Norethandrolone in particular."},"fame":1,"pubchemCid":66428,"mass":300.4,"charge":0,"smiles":"CC[C@@]1(CC[C@@H]2[C@@]1(CC[C@H]3[C@H]2CCC4=C3C=CC(=C4)O)C)O","inchikey":"GQHYKMYMSVJXJM-SLHNCBLASA-N","iupac":"(8R,9S,13S,14S,17S)-17-ethyl-13-methyl-7,8,9,11,12,14,15,16-octahydro-6H-cyclopenta[a]phenanthrene-3,17-diol","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"66428","atoms":50,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":4.577,"y":-0.933,"z":-0.995,"el":"O"},{"x":-6.352,"y":-0.208,"z":-0.142,"el":"O"},{"x":2.186,"y":-0.487,"z":-0.501,"el":"C"},{"x":1.518,"y":0.752,"z":0.135,"el":"C"},{"x":0.017,"y":0.826,"z":-0.157,"el":"C"},{"x":3.682,"y":-0.221,"z":-0.144,"el":"C"},{"x":2.407,"y":1.906,"z":-0.314,"el":"C"},{"x":1.532,"y":-1.738,"z":0.108,"el":"C"},{"x":-0.676,"y":-0.438,"z":0.436,"el":"C"},{"x":3.827,"y":1.31,"z":-0.351,"el":"C"},{"x":0.001,"y":-1.739,"z":-0.07,"el":"C"},{"x":-0.636,"y":2.074,"z":0.442,"el":"C"},{"x":2.02,"y":-0.553,"z":-2.048,"el":"C"},{"x":4.09,"y":-0.606,"z":1.283,"el":"C"},{"x":-2.19,"y":-0.38,"z":0.245,"el":"C"},{"x":-2.091,"y":2.165,"z":-0.007,"el":"C"},{"x":-2.844,"y
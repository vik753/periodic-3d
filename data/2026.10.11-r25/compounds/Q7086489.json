{"version":"2026.10.11-r25","id":"Q7086489","formula":"C₁₈H₃₆O","hill":"C18H36O","elements":["H","C","O"],"composition":{"C":18.0,"H":36.0,"O":1.0},"names":{"en":"Oleyl alcohol"},"descriptions":{"en":"Oleyl alcohol , or cis-9-octadecen-1-ol, is an unsaturated fatty alcohol with the molecular formula C18H36O or the condensed structural formula CH3(CH2)7−CH=CH−(CH2)8OH. It is a colorless oil, mainly used in cosmetics. It can be produced by the hydrogenation of oleic acid esters by Bouveault–Blanc reduction, which avoids reduction of the C=C group (as would occur with usual catalytic hydrogenation). The required oleate esters are obtained from beef fat, fish oil, and, in particular, olive oil (from which it gains its name)."},"fame":14,"pubchemCid":5284499,"mass":268.5,"charge":0,"smiles":"CCCCCCCC/C=C\\CCCCCCCCO","inchikey":"ALSTYHKOOCGGFT-KTKRTIGZSA-N","iupac":"(Z)-octadec-9-en-1-ol","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"5284499","atoms":55,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":6.377,"y":-0.528,"z":-0.617,"el":"O"},{"x":0.431,"y":-2.44,"z":0.386,"el":"C"},{"x":-0.971,"y":-1.826,"z":0.348,"el":"C"},{"x":-1.57,"y":3.093,"z":-0.407,"el":"C"},{"x":-2.783,"y":2.221,"z":-0.736,"el":"C"},{"x":1.536,"y":-1.449,"z":0.001,"el":"C"},{"x":-2.078,"y":-2.844,"z":0.651,"el":"C"},{"x":-0.322,"y":2.28,"z":-0.041,"el":"C"},{"x":-3.253,"y":1.355,"z":0.439,"el":"C"},{"x":2.957,"y":-2.019,"z":-0.032,"el":"C"},{"x":0.913,"y":3.147,"z":0.217,"el":"C"},{"x":-3.502,"y":-2.281,"z":0.637,"el":"C"},{"x":-4.513,"y":0.521,"z":0.187,"el":"C"},{"x":4.022,"y":-0.962,"z":-0.334,"el":"C"},{"x":2.174,"y":2.331,"z":0.515,"el":"C"},{"x":-3.904,"y":-1.74,"z":-0.705,"el":"C"},{"x":-4.355,"y":-0.494,"z":-0.91,"el":"C"},{"x":5.428,"y":-1.55,"z":-0.345,"el":"C"},{"x":3.412,"y":3.185,"z":0.744,"el":"C"},{"x":0
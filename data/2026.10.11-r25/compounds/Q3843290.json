{"version":"2026.10.11-r25","id":"Q3843290","formula":"NaCa₂(Mg₄Fe)(Si₆Al₂)O₂₂(OH)₂","hill":"Al2Ca2FeH2Mg4NaO24Si6","elements":["H","O","Na","Mg","Al","Si","Ca","Fe"],"composition":{"H":2.0,"O":24.0,"Al":2.0,"Ca":2.0,"Fe":1.0,"Mg":4.0,"Na":1.0,"Si":6.0},"names":{"en":"Magnesio-hastingsite"},"descriptions":{"en":"Magnesiohastingsite is a calcium-containing amphibole and a member of the hornblende group. It is an inosilicate (chain silicate) with the formula NaCa2(Mg4Fe3+)(Si6Al2)O22(OH)2 and molar mass 864.69 g. In synthetic magnesiohastingsite it appears that iron occurs both as ferrous iron Fe2+ and as ferric iron Fe3+, but the ideal formula features only ferric iron."},"fame":6,"pubchemCid":null,"mass":null,"charge":0,"smiles":null,"inchikey":null,"iupac":null,"classes":[{"qid":"Q12089225","names":{"en":"mineral species","ru":"действительный вид минералов","uk":"мінеральний вид"}}],"structureInfo":null,"structure":null,"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q3843290","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Magnesiohastingsite","license":"CC BY-SA 4.0"},{"role":"photo","name":"Wikimedia Commons","url":"https://commons.wikimedia.org/wiki/File:Magnesiohastingsite.jpg","license":"CC0"}],"similar":[{"id":"Q2056968","formula":"NaCa₂(Mg₄Al)(Si₆Al₂)O₂₂(OH)₂","names":{"en":"Pargasite","uk":"Паргасит"},"elements":["H","O","Na","Mg","Al","Si","Ca"],"fame":16,"kind":null},{"id":"Q1070871","formula":"NaCa₂Mg₅(Si₇Al)O₂₂(OH)₂","names":{"en":"Edenite","uk":"Еденіт"},"elements":["H","O","Na","Mg","Al","Si","Ca"],"fame":13,"kind":null},{"id":"Q3843282","formula":"Na(NaCa)(Mg₄Al)(Si₇Al)O₂₂(OH)₂","names":{"en":"Katophorite","uk":"Катофорит"},"elements":["H","O","Na","Mg","Al","Si","Ca"],"fame":5,"kind":null},{"id":"Q418652","formula":"Na(NaCa)Mg₅Si₈O₂₂(OH)₂","names":{"en":"Richterite","ru":"Рихтерит","uk":"Рихтерит"},"elements":["H","O","Na","Mg","Si","Ca"],"fame":15,"kind":n
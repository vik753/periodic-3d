{"version":"2026.10.11-r25","id":"Q410728","formula":"C₈H₂₀N⁺","hill":"C8H20N","elements":["H","C","N"],"composition":{"C":8.0,"H":20.0,"N":1.0},"names":{"en":"Tetraethylammonium"},"descriptions":{"en":"Tetraethylammonium (TEA) is a quaternary ammonium cation with the chemical formula [(CH3CH2)4N]+, consisting of four ethyl groups (−CH2CH3 or −C2H5, often abbreviated as −Et) attached to a central nitrogen atom. It is a counterion used in the research laboratory to prepare lipophilic salts of inorganic anions. It is used similarly to tetrabutylammonium, the difference being that its salts are less lipophilic, more easily crystallized and more toxic."},"fame":12,"pubchemCid":5413,"mass":130.25,"charge":1,"smiles":"CC[N+](CC)(CC)CC","inchikey":"CBXCPBUEXACCNR-UHFFFAOYSA-N","iupac":"tetraethylazanium","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"5413","atoms":29,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":0.0,"y":0.0,"z":0.0,"el":"N"},{"x":-0.879,"y":-0.196,"z":1.227,"el":"C"},{"x":-0.878,"y":0.196,"z":-1.227,"el":"C"},{"x":0.878,"y":-1.227,"z":-0.196,"el":"C"},{"x":0.879,"y":1.227,"z":0.196,"el":"C"},{"x":-1.75,"y":-1.417,"z":1.026,"el":"C"},{"x":-1.749,"y":1.417,"z":-1.027,"el":"C"},{"x":1.75,"y":-1.027,"z":-1.417,"el":"C"},{"x":1.75,"y":1.027,"z":1.417,"el":"C"},{"x":-0.238,"y":-0.41,"z":2.087,"el":"H"},{"x":-1.444,"y":0.713,"z":1.448,"el":"H"},{"x":-0.238,"y":0.41,"z":-2.087,"el":"H"},{"x":-1.444,"y":-0.713,"z":-1.449,"el":"H"},{"x":1.443,"y":-1.449,"z":0.713,"el":"H"},{"x":0.238,"y":-2.087,"z":-0.41,"el":"H"},{"x":1.444,"y":1.448,"z":-0.713,"el":"H"},{"x":0.238,"y":2.087,"z":0.41,"el":"H"},{"x":-2.376,"y":-1.529,"z":1.921,"el":"H"},{"x":-2.455,"y":-1.336,"z":0.197,"el":"H"},{"x":-1.2,"y":-2.357,"z":0.953,"el":"H"},{"x":-2.376,"y":1.529,"z":-1.921,"el":"H"},{"x":-2.455,"y":1.337
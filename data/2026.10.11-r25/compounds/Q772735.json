{"version":"2026.10.11-r25","id":"Q772735","formula":"C₈H₁₇NO₅","hill":"C8H17NO5","elements":["H","C","N","O"],"composition":{"C":8.0,"H":17.0,"N":1.0,"O":5.0},"names":{"en":"Miglitol"},"descriptions":{"en":"Miglitol is an oral alpha-glucosidase inhibitor used in the treatment of type 2 diabetes. It works by reversibly inhibiting alpha-glucosidase enzymes in the small intestine, which delays the digestion of complex carbohydrates and subsequently reduces postprandial glucose levels. Approved for clinical use since 1998, miglitol has demonstrated efficacy in improving glycemic control, reducing HbA1c levels, and decreasing both fasting and postprandial plasma glucose concentrations in long-term clinical trials."},"fame":20,"pubchemCid":441314,"mass":207.22,"charge":0,"smiles":"C1[C@@H]([C@H]([C@@H]([C@H](N1CCO)CO)O)O)O","inchikey":"IBAQFPQHRJAVAV-ULAWRXDQSA-N","iupac":"(2R,3R,4R,5S)-1-(2-hydroxyethyl)-2-(hydroxymethyl)piperidine-3,4,5-triol","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"441314","atoms":31,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":2.702,"y":-0.714,"z":0.492,"el":"O"},{"x":1.987,"y":1.981,"z":1.219,"el":"O"},{"x":0.164,"y":3.148,"z":-0.702,"el":"O"},{"x":1.796,"y":-3.01,"z":-0.244,"el":"O"},{"x":-4.003,"y":-0.413,"z":1.114,"el":"O"},{"x":-0.828,"y":-0.45,"z":-0.757,"el":"N"},{"x":0.521,"y":-1.018,"z":-0.552,"el":"C"},{"x":1.358,"y":-0.227,"z":0.477,"el":"C"},{"x":1.423,"y":1.262,"z":0.121,"el":"C"},{"x":0.034,"y":1.833,"z":-0.161,"el":"C"},{"x":-0.738,"y":0.961,"z":-1.153,"el":"C"},{"x":0.473,"y":-2.518,"z":-0.223,"el":"C"},{"x":-1.74,"y":-0.633,"z":0.371,"el":"C"},{"x":-3.15,"y":-0.202,"z":-0.003,"el":"C"},{"x":1.054,"y":-0.947,"z":-1.513,"el":"H"},{"x":0.963,"y":-0.351,"z":1.493,"el":"H"},{"x":2.093,"y":1.425,"z":-0.732,"el":"H"},{"x":-0.521,"y":1.942,"z":0.778,
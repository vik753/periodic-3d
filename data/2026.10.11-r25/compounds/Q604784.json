{"version":"2026.10.11-r25","id":"Q604784","formula":"(Co₀.₅Fe₀.₅)AsS","hill":"AsCo0.5Fe0.5S","elements":["S","Fe","Co","As"],"composition":{"S":1.0,"As":1.0,"Co":0.5,"Fe":0.5},"names":{"en":"Glaucodot","ru":"Глаукодот","uk":"Глаукодот"},"descriptions":{"en":"Glaucodot is a cobalt iron arsenic sulfide mineral with formula (Co,Fe)AsS. The cobalt:iron(II) ratio is typically 3:1 with minor nickel substituting. It forms a series with arsenopyrite (FeAsS). It is an opaque grey to tin-white typically found as massive forms without external crystal form.","ru":"Глаукодо́т — минерал класса сульфидов. Рассматривался ранее как кобальтовая разновидность арсенопирита, с которым он образует непрерывный изоморфный ряд. Диморфен с аллоклазитом.","uk":"Глаукодот (рос. глаукодот; англ. glaucodot; нім."},"fame":13,"pubchemCid":null,"mass":null,"charge":0,"smiles":null,"inchikey":null,"iupac":null,"classes":[{"qid":"Q12089225","names":{"en":"mineral species","ru":"действительный вид минералов","uk":"мінеральний вид"}}],"structureInfo":null,"structure":null,"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q604784","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Glaucodot","license":"CC BY-SA 4.0"},{"role":"description","name":"Wikipedia (ru)","url":"https://ru.wikipedia.org/wiki/%D0%93%D0%BB%D0%B0%D1%83%D0%BA%D0%BE%D0%B4%D0%BE%D1%82","license":"CC BY-SA 4.0"},{"role":"description","name":"Wikipedia (uk)","url":"https://uk.wikipedia.org/wiki/%D0%93%D0%BB%D0%B0%D1%83%D0%BA%D0%BE%D0%B4%D0%BE%D1%82","license":"CC BY-SA 4.0"},{"role":"photo","name":"Wikimedia Commons","url":"https://commons.wikimedia.org/wiki/File:Glaucodot-169959.jpg","license":"CC BY-SA 3.0"}],"similar":[{"id":"Q191939","formula":"FeAsS","names":{"en":"Arsenopyrite","ru":"Арсенопирит","uk":"Арсенопірит"},"elements":["S","Fe","As"],"fame":43,"kind":"crystal"},{"id":"Q410396","formula":"CoAsS","names":{"en":"Cobaltite","ru":"Кобальти
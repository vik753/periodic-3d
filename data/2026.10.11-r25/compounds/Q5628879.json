{"version":"2026.10.11-r25","id":"Q5628879","formula":"C₄H₈N₂O₂","hill":"C4H8N2O2","elements":["H","C","N","O"],"composition":{"C":4.0,"H":8.0,"N":2.0,"O":2.0},"names":{"en":"HA-966"},"descriptions":{"en":"HA-966 or (±)-3-amino-1-hydroxy-pyrrolidin-2-one is a molecule used in scientific research as a glycine receptor and NMDA receptor antagonist / low efficacy partial agonist. It has neuroprotective and anticonvulsant, anxiolytic, antinociceptive and sedative / hypnotic effects in animal models. Pilot human clinical trials in the early 1960s showed that HA-966 appeared to benefit patients with tremors of extrapyramidal origin."},"fame":4,"pubchemCid":1232,"mass":116.12,"charge":0,"smiles":"C1CN(C(=O)C1N)O","inchikey":"HCKUBNLZMKAEIN-UHFFFAOYSA-N","iupac":"3-amino-1-hydroxypyrrolidin-2-one","classes":[{"qid":"Q59199015","names":{"en":"group of stereoisomers","ru":"группа стереоизомеров","uk":"група стереоізомерів"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"1232","atoms":16,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":2.365,"y":-0.347,"z":0.223,"el":"O"},{"x":-0.038,"y":-1.953,"z":-0.048,"el":"O"},{"x":1.079,"y":0.093,"z":-0.035,"el":"N"},{"x":-2.35,"y":-0.294,"z":0.328,"el":"N"},{"x":-1.181,"y":0.185,"z":-0.385,"el":"C"},{"x":-0.686,"y":1.544,"z":0.14,"el":"C"},{"x":0.816,"y":1.506,"z":-0.1,"el":"C"},{"x":-0.005,"y":-0.735,"z":-0.123,"el":"C"},{"x":-1.361,"y":0.226,"z":-1.465,"el":"H"},{"x":-0.875,"y":1.633,"z":1.218,"el":"H"},{"x":-1.173,"y":2.393,"z":-0.351,"el":"H"},{"x":1.089,"y":1.864,"z":-1.097,"el":"H"},{"x":1.381,"y":2.045,"z":0.665,"el":"H"},{"x":-2.656,"y":-1.181,"z":-0.07,"el":"H"},{"x":-3.122,"y":0.359,"z":0.197,"el":"H"},{"x":2.742,"y":-0.34,"z":-0.673,"el":"H"}],"bonds":[[0,2,1],[0,15,1],[1,7,2],[2,6,1],[2,7,1],[3,4,1],[3,13,1],[3,14,1],[4,5,1],[4,7,1],[4,8,1],[5,6,1],[5,9,1],[5,10,1],[6,11,1],[6,12,1]]},"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q5628
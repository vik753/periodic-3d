{"version":"2026.10.11-r25","id":"Q108189151","formula":"C₂₇H₂₄F₃NO","hill":"C27H24F3NO","elements":["H","C","N","O","F"],"composition":{"C":27.0,"F":3.0,"H":24.0,"N":1.0,"O":1.0},"names":{"en":"JWH-372"},"descriptions":{"en":"JWH-372 (naphthalen-1-yl-[1-pentyl-5-[2-(trifluoromethyl)phenyl]pyrrol-3-yl]methanone) is a synthetic cannabinoid from the naphthoylpyrrole family which acts as a potent and selective agonist of the CB2 receptor. JWH-372 binds approximately 9 times stronger to the CB2 receptor (Ki = 8.2 ± 0.2nM) than the CB1 receptor (Ki = 77 ± 2nM). The selectivity of JWH-372 for the CB2 receptor is likely due to the electron-withdrawing character of the trifluoromethyl group rather than steric effects, as the o-methyl compound JWH-370 was only mildly selective for the CB2 receptor (CB1 Ki = 5.6 ± 0.4nM, CB2 Ki = 4.0 ± 0.5nM)."},"fame":1,"pubchemCid":44418325,"mass":435.5,"charge":0,"smiles":"CCCCCN1C=C(C=C1C2=CC=CC=C2C(F)(F)F)C(=O)C3=CC=CC4=CC=CC=C43","inchikey":"CYPUIQJYGVOHMM-UHFFFAOYSA-N","iupac":"naphthalen-1-yl-[1-pentyl-5-[2-(trifluoromethyl)phenyl]pyrrol-3-yl]methanone","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"44418325","atoms":56,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":1.645,"y":-3.875,"z":-1.573,"el":"F"},{"x":0.021,"y":-2.548,"z":-1.001,"el":"F"},{"x":1.722,"y":-1.766,"z":-2.094,"el":"F"},{"x":-2.006,"y":2.969,"z":-1.053,"el":"O"},{"x":1.576,"y":0.882,"z":-0.545,"el":"N"},{"x":2.933,"y":1.003,"z":-1.036,"el":"C"},{"x":3.757,"y":2.079,"z":-0.322,"el":"C"},{"x":1.109,"y":-0.078,"z":0.313,"el":"C"},{"x":5.215,"y":2.126,"z":-0.789,"el":"C"},{"x":0.556,"y":1.733,"z":-0.882,"el":"C"},{"x":-0.58,"y":1.309,"z":-0.229,"el":"C"},{"x":-0.23,"y":0.163,"z":0.527,"el":"C"},{"x":1.943,"y":-1.128,"z":0.856,"el":"C"},{"x":6.02,"y":3.152,"z":0.01,"el":"C"},{"x":-1.913,"y
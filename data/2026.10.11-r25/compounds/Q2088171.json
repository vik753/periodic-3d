{"version":"2026.10.11-r25","id":"Q2088171","formula":"C₄H₅N","hill":"C4H5N","elements":["H","C","N"],"composition":{"C":4.0,"H":5.0,"N":1.0},"names":{"en":"Methacrylonitrile"},"descriptions":{"en":"Methacrylonitrile (or 2-Methylprop-2-enenitrile), MeAN in short, is a chemical compound that is an unsaturated aliphatic nitrile, widely used in the preparation of homopolymers, copolymers, elastomers, and plastics and as a chemical intermediate in the preparation of acids, amides, amines, esters, and other nitriles. MeAN is also used as a replacement for acrylonitrile in the manufacture of an acrylonitrile/butadiene/styrene-like polymer. It is a clear and colorless (to slightly yellow) liquid, that has a bitter almond smell."},"fame":10,"pubchemCid":31368,"mass":67.09,"charge":0,"smiles":"CC(=C)C#N","inchikey":"GYCMBHHDWRMZGG-UHFFFAOYSA-N","iupac":"2-methylprop-2-enenitrile","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"31368","atoms":10,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":2.06,"y":-0.074,"z":0.0,"el":"N"},{"x":-1.312,"y":-1.222,"z":0.0,"el":"C"},{"x":-0.525,"y":0.055,"z":0.0,"el":"C"},{"x":-1.123,"y":1.255,"z":0.0,"el":"C"},{"x":0.901,"y":-0.014,"z":0.0,"el":"C"},{"x":-1.075,"y":-1.817,"z":-0.888,"el":"H"},{"x":-2.393,"y":-1.04,"z":0.0,"el":"H"},{"x":-1.075,"y":-1.817,"z":0.888,"el":"H"},{"x":-2.205,"y":1.345,"z":0.0,"el":"H"},{"x":-0.552,"y":2.179,"z":0.0,"el":"H"}],"bonds":[[0,4,3],[1,2,1],[1,5,1],[1,6,1],[1,7,1],[2,3,2],[2,4,1],[3,8,1],[3,9,1]]},"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q2088171","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Methacrylonitrile","license":"CC BY-SA 4.0"},{"role":"properties","name":"PubChem","url":"https://pubchem.ncbi.nlm.nih.gov/compound/3
{"version":"2026.10.11-r25","id":"Q18212136","formula":"NdTaO₄","hill":"NdO4Ta","elements":["O","Nd","Ta"],"composition":{"O":4.0,"Nd":1.0,"Ta":1.0},"names":{"en":"Neodymium tantalate","ru":"Танталат неодима"},"descriptions":{"en":"Neodymium tantalate is an inorganic compound with the chemical formula NdTaO4. It is prepared by reacting neodymium oxide and tantalum pentoxide at 1200 °C. It reacts with a mixture of tantalum pentoxide and chlorine gas at high temperature to obtain Nd2Ta2O7Cl2. It is ammonolyzed at high temperature to obtain oxynitrides of Nd-Ta.","ru":"Танталат неодима — неорганическое соединение, соль неодима и танталовой кислоты с формулой NdTaO4, фиолетовые кристаллы, не растворяется в воде."},"fame":4,"pubchemCid":null,"mass":null,"charge":0,"smiles":null,"inchikey":null,"iupac":null,"classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"crystal","source":"materialsproject","ref":"mp-3203","atoms":14,"license":"CC BY 4.0, Materials Project"},"structure":{"cell":[[5.248,0.0,0.0],[0.0,5.605,0.0],[-0.632,0.0,5.403]],"kind":"crystal","atoms":[{"x":-0.474,"y":1.321,"z":4.052,"el":"Nd"},{"x":4.773,"y":1.321,"z":4.052,"el":"Nd"},{"x":-0.158,"y":4.284,"z":1.351,"el":"Nd"},{"x":5.09,"y":4.284,"z":1.351,"el":"Nd"},{"x":2.466,"y":1.749,"z":1.351,"el":"Ta"},{"x":2.15,"y":3.857,"z":4.052,"el":"Ta"},{"x":3.8,"y":2.459,"z":0.054,"el":"O"},{"x":1.131,"y":2.459,"z":2.647,"el":"O"},{"x":0.815,"y":3.146,"z":5.349,"el":"O"},{"x":3.484,"y":3.146,"z":2.756,"el":"O"},{"x":0.963,"y":5.088,"z":3.293,"el":"O"},{"x":3.336,"y":5.088,"z":4.811,"el":"O"},{"x":3.652,"y":0.517,"z":2.11,"el":"O"},{"x":1.279,"y":0.517,"z":0.592,"el":"O"}],"bonds":[[4,13,1],[5,10,1],[4,12,1],[5,11,1],[4,6,1],[5,9,1],[4,7,1],[5,8,1],[4,9,1],[5,7,1],[1,12,1],[2,10,1],[0,7,1],[3,9,1],[3,6,1],[2,7,1],[0,8,1],[1,9,1]],"cellOrigin":[0,0,0]},"sources":[{"role":"identity","name":"Wikidata","url":"https://
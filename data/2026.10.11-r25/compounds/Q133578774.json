{"version":"2026.10.11-r25","id":"Q133578774","formula":"C₁₂H₁₃ClN₂O","hill":"C12H13ClN2O","elements":["H","C","N","O","Cl"],"composition":{"C":12.0,"H":13.0,"N":2.0,"O":1.0,"Cl":1.0},"names":{"en":"BK-5Cl-NM-AMT"},"descriptions":{"en":"BK-5Cl-NM-AMT, or βk-5Cl-NM-αMT, also known as β-keto-5-chloro-N-methyl-αMT or α,N-dimethyl-5-chloro-β-ketotryptamine, is a monoamine releasing agent of the tryptamine, α-alkyltryptamine, and β-ketotryptamine families. It is known to induce the release of serotonin and dopamine, with respective EC50Tooltip half-maximal effective concentration values of 200 nM and 865 nM in rat brain synaptosomes, whereas norepinephrine release was not reported. In contrast to many other tryptamines, the drug is inactive as an agonist of serotonin receptors including the 5-HT1, 5-HT2, and 5-HT3 receptors."},"fame":2,"pubchemCid":162765502,"mass":236.7,"charge":0,"smiles":"CC(C(=O)C1=CNC2=C1C=C(C=C2)Cl)NC","inchikey":"JNYZOLQTXCZJRL-UHFFFAOYSA-N","iupac":"1-(5-chloro-1H-indol-3-yl)-2-(methylamino)propan-1-one","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"rdkit","ref":"162765502","atoms":29,"license":"Computed with RDKit from SMILES (PubChem, Wikidata)"},"structure":{"kind":"molecule","atoms":[{"x":1.868,"y":-1.365,"z":1.5,"el":"C"},{"x":1.858,"y":-0.152,"z":0.574,"el":"C"},{"x":1.29,"y":-0.573,"z":-0.795,"el":"C"},{"x":2.059,"y":-0.98,"z":-1.674,"el":"O"},{"x":-0.156,"y":-0.497,"z":-1.059,"el":"C"},{"x":-0.673,"y":-0.739,"z":-2.323,"el":"C"},{"x":-2.027,"y":-0.591,"z":-2.29,"el":"N"},{"x":-2.433,"y":-0.262,"z":-1.02,"el":"C"},{"x":-1.287,"y":-0.199,"z":-0.215,"el":"C"},{"x":-1.479,"y":0.113,"z":1.152,"el":"C"},{"x":-2.769,"y":0.353,"z":1.641,"el":"C"},{"x":-3.879,"y":0.289,"z":0.809,"el":"C"},{"x":-3.728,"y":-0.023,"z":-0.543,"el":"C"},{"x":-2.981,"y":0.732,"z":3.308,"el":"Cl"},{"x":3.26,"y":0.328,"z":0.443,"el":"N"},{"x
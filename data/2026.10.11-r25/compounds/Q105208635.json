{"version":"2026.10.11-r25","id":"Q105208635","formula":"C₁₉H₁₆O₈","hill":"C19H16O8","elements":["H","C","O"],"composition":{"C":19.0,"H":16.0,"O":8.0},"names":{"en":"Hypostictic acid"},"descriptions":{"en":"Hypostictic acid is a lichen secondary metabolite belonging to the depsidone class of aromatic compounds. It was first prepared in 1933 by catalytic hydrogenation of stictic acid isolated from the foliose lichen Lobaria pulmonaria, and as a natural product was later reported from an undescribed species of the crustose lichen genus Thelotrema collected in Venezuelan cloud forest. As a lichen metabolite it has been detected as a minor or trace component in several foliose and crustose lichen genera, including Pseudoparmelia, Xanthoparmelia, Nephroma, Aspicilia, Clandestinotrema, Porpidia and Rinodina."},"fame":2,"pubchemCid":101351294,"mass":372.3,"charge":0,"smiles":"CC1=CC(=C(C2=C1C(=O)OC3=C(O2)C4=C(C(=C3C)O)C(=O)OC4O)C)OC","inchikey":"PGRWVCGZKIXMQW-UHFFFAOYSA-N","iupac":"13,17-dihydroxy-5-methoxy-4,7,12-trimethyl-2,10,16-trioxatetracyclo[9.7.0.03,8.014,18]octadeca-1(11),3(8),4,6,12,14(18)-hexaene-9,15-dione","classes":[{"qid":"Q59199015","names":{"en":"group of stereoisomers","ru":"группа стереоизомеров","uk":"група стереоізомерів"}}],"structureInfo":{"kind":"molecule","source":"rdkit","ref":"101351294","atoms":43,"license":"Computed with RDKit from SMILES (PubChem, Wikidata)"},"structure":{"kind":"molecule","atoms":[{"x":2.914,"y":-0.192,"z":2.955,"el":"C"},{"x":2.472,"y":0.06,"z":1.538,"el":"C"},{"x":3.32,"y":-0.328,"z":0.486,"el":"C"},{"x":2.981,"y":-0.078,"z":-0.848,"el":"C"},{"x":1.769,"y":0.569,"z":-1.153,"el":"C"},{"x":0.892,"y":0.909,"z":-0.105,"el":"C"},{"x":1.255,"y":0.699,"z":1.231,"el":"C"},{"x":0.412,"y":1.242,"z":2.319,"el":"C"},{"x":0.895,"y":1.889,"z":3.239,"el":"O"},{"x":-0.935,"y":0.899,"z":2.299,"el":"O"},{"x":-1.693,"y":0.366,"z":1.225,"el":"C"},{"x":-1.396,"y":0.713,"z":-0.099,"el":"C"},{"x":-0.316,"y":1.486,"z":-0.43,"el":"O"},{"x":-2.268
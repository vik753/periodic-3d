{"version":"2026.10.11-r25","id":"Q572404","formula":"C₄₀H₅₆O₃","hill":"C40H56O3","elements":["H","C","O"],"composition":{"C":40.0,"H":56.0,"O":3.0},"names":{"en":"Antheraxanthin"},"descriptions":{"en":"Antheraxanthin (from ánthos, Greek for \"flower\" and xanthos, Greek for \"yellow\") is a bright yellow accessory pigment found in many organisms that perform photosynthesis. It is a xanthophyll cycle pigment, an oil-soluble alcohol within the xanthophyll subgroup of carotenoids. Antheraxanthin is both a component in and product of the cellular photoprotection mechanisms in photosynthetic green algae, red algae, euglenoids, and plants."},"fame":12,"pubchemCid":5281223,"mass":584.9,"charge":0,"smiles":"CC1=C(C(C[C@@H](C1)O)(C)C)/C=C/C(=C/C=C/C(=C/C=C/C=C(\\C)/C=C/C=C(\\C)/C=C/[C@]23[C@](O2)(C[C@H](CC3(C)C)O)C)/C)/C","inchikey":"OFNSUWBAQRCHAV-OYQUVCAXSA-N","iupac":"(1R,3S,6S)-6-[(1E,3E,5E,7E,9E,11E,13E,15E,17E)-18-[(4R)-4-hydroxy-2,6,6-trimethylcyclohexen-1-yl]-3,7,12,16-tetramethyloctadeca-1,3,5,7,9,11,13,15,17-nonaenyl]-1,5,5-trimethyl-7-oxabicyclo[4.1.0]heptan-3-ol","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"5281223","atoms":99,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":12.081,"y":0.854,"z":0.575,"el":"O"},{"x":11.935,"y":-3.278,"z":0.638,"el":"O"},{"x":-15.07,"y":2.129,"z":0.598,"el":"O"},{"x":11.032,"y":-0.011,"z":0.129,"el":"C"},{"x":11.752,"y":-0.256,"z":1.431,"el":"C"},{"x":11.34,"y":-0.836,"z":-1.099,"el":"C"},{"x":12.867,"y":-1.244,"z":1.559,"el":"C"},{"x":12.682,"y":-1.603,"z":-0.952,"el":"C"},{"x":12.902,"y":-2.259,"z":0.416,"el":"C"},{"x":11.161,"y":0.207,"z":2.722,"el":"C"},{"x":9.647,"y":0.484,"z":0.233,"el":"C"},{"x":10.17,"y":-1.811,"z":-1.346,"el":"C"},{"x":11.438,"y":0.093,"z":-2.326,"el":"C"},{"x":9.196,"y":1.653,"z":-0.25,"el":"C"},{"x":7.83,"y":2.135,"z":-
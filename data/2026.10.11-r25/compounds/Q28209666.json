{"version":"2026.10.11-r25","id":"Q28209666","formula":"C₁₈H₂₅NO","hill":"C18H25NO","elements":["H","C","N","O"],"composition":{"C":18.0,"H":25.0,"N":1.0,"O":1.0},"names":{"en":"Aminoestradiol"},"descriptions":{"en":"Aminoestradiol (AE2), also known as 17β-aminoestradiol (17βAE2) or as 17β-aminoestra-1,3,5(10)-trien-3-ol, is a synthetic, steroidal estrogen and a 17β-aminoestrogen with anticoagulant effects that was never marketed. It is an analogue of estradiol in which the C17β hydroxyl group has been replaced with an amine group. AE2 has profoundly reduced estrogenic potency compared to estradiol; its EC50 for activation of the ERα was found to be 1.82 μM, whereas that of estradiol was 2.14 nM (relative potency 0.12 for AE2 versus 100 for estradiol, or roughly a 1,000-fold difference)."},"fame":2,"pubchemCid":11231075,"mass":271.4,"charge":0,"smiles":"C[C@]12CC[C@H]3[C@H]([C@@H]1CC[C@@H]2N)CCC4=C3C=CC(=C4)O","inchikey":"VPONVJPFULJPAN-ZBRFXRBCSA-N","iupac":"(8R,9S,13S,14S,17S)-17-amino-13-methyl-6,7,8,9,11,12,14,15,16,17-decahydrocyclopenta[a]phenanthren-3-ol","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"11231075","atoms":45,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":5.864,"y":-0.152,"z":0.426,"el":"O"},{"x":-5.148,"y":-1.187,"z":0.144,"el":"N"},{"x":-2.664,"y":-0.581,"z":0.168,"el":"C"},{"x":-1.98,"y":0.697,"z":-0.368,"el":"C"},{"x":-0.508,"y":0.783,"z":0.038,"el":"C"},{"x":-4.096,"y":-0.318,"z":-0.358,"el":"C"},{"x":0.248,"y":-0.44,"z":-0.565,"el":"C"},{"x":-1.955,"y":-1.795,"z":-0.446,"el":"C"},{"x":-2.935,"y":1.818,"z":0.038,"el":"C"},{"x":-0.439,"y":-1.776,"z":-0.172,"el":"C"},{"x":-4.334,"y":1.173,"z":-0.033,"el":"C"},{"x":0.161,"y":2.07,"z":-0.448,"el":"C"},{"x":-2.65,"y":-0.704,"z":1.714,"el":"C"},{"x":1.743,"y":-0.368,"z":-0.264,"el":"C"},{"x":1.578,"y":2.159,"z":0.1
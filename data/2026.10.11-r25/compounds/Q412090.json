{"version":"2026.10.11-r25","id":"Q412090","formula":"C₆H₁₀O","hill":"C6H10O","elements":["H","C","O"],"composition":{"C":6.0,"H":10.0,"O":1.0},"names":{"en":"Meparfynol","ru":"Метилпентинол"},"descriptions":{"en":"Methylpentynol (also known as methylparafynol, trade names Dormison, Atemorin, Oblivon) is a tertiary pentynol with hypnotic/sedative and anticonvulsant effects and an exceptionally low therapeutic index. It was discovered by Bayer in 1913 and was used shortly thereafter for the treatment of insomnia, but its use was quickly phased out in response to newer drugs with far more favorable safety profiles. The drug was marketed again in the United States, Europe and elsewhere from 1956 well into the 1960s as a rapid-acting sedative."},"fame":13,"pubchemCid":6494,"mass":98.14,"charge":0,"smiles":"CCC(C)(C#C)O","inchikey":"QXLPXWSKPNOQLE-UHFFFAOYSA-N","iupac":"3-methylpent-1-yn-3-ol","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"6494","atoms":17,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-0.344,"y":-0.796,"z":-1.358,"el":"O"},{"x":-0.016,"y":-0.5,"z":0.005,"el":"C"},{"x":-1.281,"y":0.078,"z":0.67,"el":"C"},{"x":0.426,"y":-1.818,"z":0.641,"el":"C"},{"x":-1.878,"y":1.302,"z":-0.014,"el":"C"},{"x":1.094,"y":0.472,"z":0.023,"el":"C"},{"x":1.998,"y":1.262,"z":0.034,"el":"C"},{"x":-1.068,"y":0.33,"z":1.716,"el":"H"},{"x":-2.061,"y":-0.695,"z":0.684,"el":"H"},{"x":1.285,"y":-2.245,"z":0.11,"el":"H"},{"x":0.708,"y":-1.684,"z":1.691,"el":"H"},{"x":-0.373,"y":-2.566,"z":0.592,"el":"H"},{"x":-1.178,"y":2.143,"z":-0.014,"el":"H"},{"x":-2.157,"y":1.085,"z":-1.05,"el":"H"},{"x":-2.782,"y":1.622,"z":0.515,"el":"H"},{"x":-1.08,"y":-1.431,"z":-1.361,"el":"H"},{"x":2.8,"y":1.963,"z":0.043,"el":"H"}],"bonds":[[0,1,1],[0,15,1],[1,2,1],[1,3,1],[1,5,1],[2,4,1],[2,7,1],[2,8,1],[3,9,1],[3,10,1],[3
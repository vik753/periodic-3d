{"version":"2026.10.11-r25","id":"Q923092","formula":"PbAl₃(PO₄)(PO₃OH)(OH)₆","hill":"Al3H7O14P2Pb","elements":["H","O","Al","P","Pb"],"composition":{"H":7.0,"O":14.0,"P":2.0,"Al":3.0,"Pb":1.0},"names":{"en":"Plumbogummite","uk":"Плюмбогуміт"},"descriptions":{"en":"Plumbogummite is a rare secondary lead phosphate mineral, belonging to the alunite supergroup of minerals, crandallite subgroup. Some other members of this subgroup are: Crandallite, CaAl3(PO4)2(OH)5·H2O, where calcium replaces lead Goyazite, SrAl3(PO4)2(OH)5·H2O, where strontium replaces lead Philipsbornite, PbAl3(AsO4)2(OH)5·H2O, where the arsenate group AsO4 replaces the phosphate group PO4 Plumbogummite was discovered in 1819 and named in 1832 from the Latin \"plumbum\" for lead, and \"gummi\" for gum, in allusion to its lead content and appearance, which at times resembles coatings of gum.","uk":"Плюмбогуміт, плюмбоґуміт (рос. плюмбогуммит; англ. plumbogummite; нім."},"fame":9,"pubchemCid":null,"mass":null,"charge":0,"smiles":null,"inchikey":null,"iupac":null,"classes":[{"qid":"Q12089225","names":{"en":"mineral species","ru":"действительный вид минералов","uk":"мінеральний вид"}}],"structureInfo":null,"structure":null,"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q923092","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Plumbogummite","license":"CC BY-SA 4.0"},{"role":"description","name":"Wikipedia (uk)","url":"https://uk.wikipedia.org/wiki/%D0%9F%D0%BB%D1%8E%D0%BC%D0%B1%D0%BE%D0%B3%D1%83%D0%BC%D1%96%D1%82","license":"CC BY-SA 4.0"},{"role":"photo","name":"Wikimedia Commons","url":"https://commons.wikimedia.org/wiki/File:Plumbogummite-pg4a.jpg","license":"CC BY-SA 3.0"}],"similar":[{"id":"Q165254","formula":"CuAl₆(PO₄)₄(OH)₈·4H₂O","names":{"en":"Turquoise","ru":"Бирюза","uk":"Бірюза"},"elements":["H","O","Al","P","Cu"],"fame":87,"kind":"crystal"},{"id":"Q1070576","formula":"FeAl₆(PO₄)₄(OH)₈·4H₂O","names":{"
{"version":"2026.10.11-r25","id":"Q25394354","formula":"SmO","hill":"OSm","elements":["O","Sm"],"composition":{"O":1.0,"Sm":1.0},"names":{"en":"Samarium monoxide","ru":"Оксид самария(II)"},"descriptions":{"en":"Samarium monoxide is a binary inorganic compound of samarium and oxygen with the formula SmO. It is a metastable rare-earth monoxide with the cubic rock salt structure. Bulk SmO is a golden-yellow metallic solid that can be prepared from samarium metal and samarium(III) oxide under high pressure and temperature. Unlike the essentially trivalent metallic monoxides of several lighter lanthanides and the divalent semiconducting monoxides EuO and YbO, SmO is a metallic intermediate-valence compound in which the mean samarium valence lies close to +3.","ru":"Оксид самария(II) — бинарное неорганическое соединение металла самария и кислорода с формулой SmO, кристаллы."},"fame":3,"pubchemCid":null,"mass":null,"charge":0,"smiles":null,"inchikey":null,"iupac":null,"classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"crystal","source":"materialsproject","ref":"mp-1611","atoms":27,"license":"CC BY 4.0, Materials Project"},"structure":{"cell":[[4.966,0.0,0.0],[0.0,4.966,0.0],[0.0,0.0,4.966]],"kind":"crystal","atoms":[{"x":0.0,"y":0.0,"z":0.0,"el":"Sm"},{"x":0.0,"y":0.0,"z":4.966,"el":"Sm"},{"x":0.0,"y":4.966,"z":0.0,"el":"Sm"},{"x":0.0,"y":4.966,"z":4.966,"el":"Sm"},{"x":4.966,"y":0.0,"z":0.0,"el":"Sm"},{"x":4.966,"y":0.0,"z":4.966,"el":"Sm"},{"x":4.966,"y":4.966,"z":0.0,"el":"Sm"},{"x":4.966,"y":4.966,"z":4.966,"el":"Sm"},{"x":0.0,"y":0.0,"z":2.483,"el":"O"},{"x":0.0,"y":4.966,"z":2.483,"el":"O"},{"x":4.966,"y":0.0,"z":2.483,"el":"O"},{"x":4.966,"y":4.966,"z":2.483,"el":"O"},{"x":0.0,"y":2.483,"z":2.483,"el":"Sm"},{"x":4.966,"y":2.483,"z":2.483,"el":"Sm"},{"x":0.0,"y":2.483,"z":0.0,"el":"O"},{"x":0.0,"y":2.483,"z":4.966,"el":"O"},{"x":4.966,"y":2.483,"z":0.0,"el":"O"
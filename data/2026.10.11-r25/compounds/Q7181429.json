{"version":"2026.10.11-r25","id":"Q7181429","formula":"C₈H₁₁NO","hill":"C8H11NO","elements":["H","C","N","O"],"composition":{"C":8.0,"H":11.0,"N":1.0,"O":1.0},"names":{"en":"Phenylethanolamine"},"descriptions":{"en":"Phenylethanolamine (sometimes abbreviated PEOH), or β-hydroxyphenethylamine, is a trace amine with a structure similar to those of other trace phenethylamines as well as the catecholamine neurotransmitters dopamine, norepinephrine, and epinephrine. As an organic compound, phenylethanolamine is a β-hydroxylated phenethylamine that is also structurally related to a number of synthetic drugs in the substituted phenethylamine class. In common with these compounds, phenylethanolamine has strong cardiovascular activity and, under the name Apophedrin, has been used as a drug to produce topical vasoconstriction."},"fame":11,"pubchemCid":1000,"mass":137.18,"charge":0,"smiles":"C1=CC=C(C=C1)C(CN)O","inchikey":"ULSIYEODSMZIPX-UHFFFAOYSA-N","iupac":"2-amino-1-phenylethanol","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"1000","atoms":21,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":1.767,"y":1.271,"z":0.874,"el":"O"},{"x":3.606,"y":-0.492,"z":-0.472,"el":"N"},{"x":1.358,"y":-0.047,"z":0.485,"el":"C"},{"x":-0.11,"y":-0.044,"z":0.222,"el":"C"},{"x":2.171,"y":-0.491,"z":-0.747,"el":"C"},{"x":-0.728,"y":1.107,"z":-0.269,"el":"C"},{"x":-0.866,"y":-1.19,"z":0.467,"el":"C"},{"x":-2.101,"y":1.11,"z":-0.514,"el":"C"},{"x":-2.239,"y":-1.187,"z":0.222,"el":"C"},{"x":-2.857,"y":-0.037,"z":-0.269,"el":"C"},{"x":1.574,"y":-0.704,"z":1.338,"el":"H"},{"x":1.985,"y":0.188,"z":-1.588,"el":"H"},{"x":1.865,"y":-1.496,"z":-1.059,"el":"H"},{"x":-0.163,"y":2.01,"z":-0.482,"el":"H"},{"x":-0.396,"y":-2.093,"z":0.848,"el":"H"},{"x":-2.582,"y":2.005,"z":-0.899,"el":"H"},{"x":-2.827,"y":-2.08,"z":0.412,"el":"
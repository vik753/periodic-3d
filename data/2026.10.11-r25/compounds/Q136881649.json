{"version":"2026.10.11-r25","id":"Q136881649","formula":"C₁₅H₁₂Cl₂N₂O₂","hill":"C15H12Cl2N2O2","elements":["H","C","N","O","Cl"],"composition":{"C":15.0,"H":12.0,"N":2.0,"O":2.0,"Cl":2.0},"names":{"en":"Diclazafone desglycyl"},"descriptions":{"en":"Diclazafone desglycyl is a chemical compound that can act as both a prodrug and a synthetic precursor for the benzodiazepine derivative delorazepam, the N-desmethyl derivative of the designer benzodiazepine diclazepam. It is inactive in vitro but has similar effects to delorazepam in vivo due to metabolic conversion to the active benzodiazepine form. It has been detected as a designer drug, first being identified in Denmark in September 2024."},"fame":1,"pubchemCid":20442930,"mass":323.2,"charge":0,"smiles":"C1=CC=C(C(=C1)C(=O)C2=C(C=CC(=C2)Cl)NC(=O)CN)Cl","inchikey":"YGKSPOBIXHTPMV-UHFFFAOYSA-N","iupac":"2-amino-N-[4-chloro-2-(2-chlorobenzoyl)phenyl]acetamide","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"20442930","atoms":33,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-0.566,"y":-4.545,"z":0.12,"el":"Cl"},{"x":-2.943,"y":1.131,"z":2.475,"el":"Cl"},{"x":-0.178,"y":1.567,"z":1.055,"el":"O"},{"x":4.415,"y":0.092,"z":-0.327,"el":"O"},{"x":2.169,"y":0.691,"z":0.028,"el":"N"},{"x":5.261,"y":2.641,"z":-0.306,"el":"N"},{"x":0.126,"y":-0.607,"z":0.248,"el":"C"},{"x":1.506,"y":-0.538,"z":0.052,"el":"C"},{"x":-0.694,"y":0.626,"z":0.438,"el":"C"},{"x":-2.054,"y":0.743,"z":-0.075,"el":"C"},{"x":-0.515,"y":-1.846,"z":0.269,"el":"C"},{"x":2.244,"y":-1.709,"z":-0.122,"el":"C"},{"x":0.224,"y":-3.016,"z":0.094,"el":"C"},{"x":1.603,"y":-2.947,"z":-0.102,"el":"C"},{"x":-3.142,"y":0.973,"z":0.767,"el":"C"},{"x":-2.249,"y":0.62,"z":-1.45,"el":"C"},{"x":3.54,"y":0.934,"z":-0.156,"el":"C"},{"x":-4.426,"y":1.081,"z":0.233,"el":"C"},{"x":-3.534,"y":0.727,"z":
{"version":"2026.10.11-r25","id":"Q4671562","formula":"C₉H₁₄N₄O₅","hill":"C9H14N4O5","elements":["H","C","N","O"],"composition":{"C":9.0,"H":14.0,"N":4.0,"O":5.0},"names":{"en":"Acadesine"},"descriptions":{"en":"Acadesine (INN), also known as 5-aminoimidazole-4-carboxamide-1-β-D-ribofuranoside, AICA-riboside, and AICAR, is an AMP-activated protein kinase activator which is used for the treatment of acute lymphoblastic leukemia and may have applications in treating other disorders such as diabetes. Acadesine has been used clinically to treat and protect against cardiac ischemic injury. The drug was first used in the 1980s as a method to preserve blood flow to the heart during surgery."},"fame":5,"pubchemCid":17513,"mass":258.23,"charge":0,"smiles":"C1=NC(=C(N1[C@H]2[C@@H]([C@@H]([C@H](O2)CO)O)O)N)C(=O)N","inchikey":"RTRQQBHATOEIAF-UUOKFMHZSA-N","iupac":"5-amino-1-[(2R,3R,4S,5R)-3,4-dihydroxy-5-(hydroxymethyl)oxolan-2-yl]imidazole-4-carboxamide","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"17513","atoms":32,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":1.802,"y":-0.575,"z":-0.94,"el":"O"},{"x":1.249,"y":2.349,"z":1.077,"el":"O"},{"x":3.451,"y":1.945,"z":-0.463,"el":"O"},{"x":3.361,"y":-2.804,"z":-0.258,"el":"O"},{"x":-4.505,"y":0.942,"z":-0.271,"el":"O"},{"x":-0.391,"y":-0.066,"z":-0.19,"el":"N"},{"x":-1.965,"y":-1.539,"z":0.358,"el":"N"},{"x":-1.65,"y":1.88,"z":-0.71,"el":"N"},{"x":-4.761,"y":-1.212,"z":0.427,"el":"N"},{"x":1.633,"y":1.016,"z":0.806,"el":"C"},{"x":0.947,"y":0.469,"z":-0.435,"el":"C"},{"x":3.095,"y":0.886,"z":0.425,"el":"C"},{"x":3.114,"y":-0.43,"z":-0.346,"el":"C"},{"x":3.373,"y":-1.637,"z":0.545,"el":"C"},{"x":-1.584,"y":0.591,"z":-0.318,"el":"C"},{"x":-0.673,"y":-1.342,"z":0.219,"el":"C"},{"x":-2.539,"y":-0.338,"z":0.025,"el":"C"},{"x":-3.957,"y":-0.135,"z":0.048
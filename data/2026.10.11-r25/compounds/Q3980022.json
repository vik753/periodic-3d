{"version":"2026.10.11-r25","id":"Q3980022","formula":"Ca₁₂Al₂Si₁₈O₃₃(OH)₃₆","hill":"Al2Ca12H36O69Si18","elements":["H","O","Al","Si","Ca"],"composition":{"H":36.0,"O":69.0,"Al":2.0,"Ca":12.0,"Si":18.0},"names":{"en":"Tacharanite"},"descriptions":{"en":"Tacharanite is a calcium aluminium silicate hydrate (C-A-S-H) mineral of general chemical formula Ca12Al2Si18O33(OH)36 with some resemblance to the calcium silicate hydrate (C-S-H) mineral tobermorite. It is often found in mineral assemblage with zeolites and other hydrated calcium silicates. C-S-H and C-A-S-H mineral phases are important hydration products of cements but can also be found, although much less frequently, in natural conditions in particular geological environments."},"fame":7,"pubchemCid":null,"mass":null,"charge":0,"smiles":null,"inchikey":null,"iupac":null,"classes":[{"qid":"Q12089225","names":{"en":"mineral species","ru":"действительный вид минералов","uk":"мінеральний вид"}}],"structureInfo":null,"structure":null,"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q3980022","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Tacharanite","license":"CC BY-SA 4.0"},{"role":"photo","name":"Wikimedia Commons","url":"https://commons.wikimedia.org/wiki/File:Natrolitereunion.jpg","license":"CC BY-SA 3.0"}],"similar":[{"id":"Q422063","formula":"Ca₁₀Si₁₈O₄₆·18H₂O","names":{"en":"Okenite","ru":"Окенит","uk":"Океніт"},"elements":["H","O","Si","Ca"],"fame":18,"kind":null},{"id":"Q3866479","formula":"KNa₂Ca₂[Si₈O₁₉(OH)]·6H₂O","names":{"en":"Mountainite","uk":"Маунтиніт"},"elements":["H","O","Na","Si","K","Ca"],"fame":5,"kind":null},{"id":"Q3780191","formula":"NaCa₁₆(Si₂₃Al)O₆₀(OH)₈·14H₂O","names":{"en":"Gyrolite","uk":"Гіроліт"},"elements":["H","O","Na","Al","Si","Ca"],"fame":14,"kind":null},{"id":"Q411794","formula":"BaCa₄Si₁₆O₃₆(OH)₂·10H₂O","names":{"en":"Macdonaldite","uk":"Макдональдит"},"elements":["H","O","Si","Ca","Ba"]
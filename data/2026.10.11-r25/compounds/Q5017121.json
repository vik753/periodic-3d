{"version":"2026.10.11-r25","id":"Q5017121","formula":"C₁₈H₂₃N₅O₃","hill":"C18H23N5O3","elements":["H","C","N","O"],"composition":{"C":18.0,"H":23.0,"N":5.0,"O":3.0},"names":{"en":"Cafedrine"},"descriptions":{"en":"Cafedrine (INNTooltip International Nonproprietary Name, BANTooltip British Approved Name), sold under the brand name Akrinor among others, is a chemical linkage of norephedrine and theophylline and is a cardiac stimulant and antihypotensive agent used to increase blood pressure in people with hypotension. It has been marketed in Europe, South Africa, and Indonesia. There has been concern about cafedrine as a potential performance-enhancing drug and doping agent in sports."},"fame":7,"pubchemCid":5489638,"mass":357.4,"charge":0,"smiles":"C[C@@H]([C@@H](C1=CC=CC=C1)O)NCCN2C=NC3=C2C(=O)N(C(=O)N3C)C","inchikey":"UJSKUDDDPKGBJY-WFASDCNBSA-N","iupac":"7-[2-[[(1R,2S)-1-hydroxy-1-phenylpropan-2-yl]amino]ethyl]-1,3-dimethylpurine-2,6-dione","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"5489638","atoms":49,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":4.563,"y":2.396,"z":-0.116,"el":"O"},{"x":-1.21,"y":-1.597,"z":-0.383,"el":"O"},{"x":-5.789,"y":-1.951,"z":0.577,"el":"O"},{"x":-1.721,"y":1.335,"z":-0.675,"el":"N"},{"x":1.947,"y":1.295,"z":0.007,"el":"N"},{"x":-4.923,"y":0.16,"z":0.121,"el":"N"},{"x":-3.5,"y":-1.8,"z":0.101,"el":"N"},{"x":-3.734,"y":2.252,"z":-0.397,"el":"N"},{"x":2.759,"y":1.429,"z":1.209,"el":"C"},{"x":-0.305,"y":1.254,"z":-0.947,"el":"C"},{"x":0.528,"y":1.409,"z":0.322,"el":"C"},{"x":4.256,"y":1.37,"z":0.832,"el":"C"},{"x":-2.568,"y":0.31,"z":-0.367,"el":"C"},{"x":-3.793,"y":0.898,"z":-0.203,"el":"C"},{"x":2.352,"y":0.319,"z":2.179,"el":"C"},{"x":4.673,"y":0.057,"z":0.204,"el":"C"},{"x":-2.469,"y":2.484,"z":-0.681,"el":"C"},{"x":-2.316,"y":-1.088,"z":-0.23,"el"
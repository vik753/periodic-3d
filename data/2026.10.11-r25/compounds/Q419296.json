{"version":"2026.10.11-r25","id":"Q419296","formula":"Na₂SO₄·10H₂O","hill":"H20Na2O14S","elements":["H","O","Na","S"],"composition":{"H":20.0,"O":14.0,"S":1.0,"Na":2.0},"names":{"en":"Mirabilite","ru":"Мирабилит","uk":"Мірабіліт"},"descriptions":{"en":"Mirabilite, also known as Glauber's salt, is a hydrous sodium sulfate mineral with the chemical formula Na2SO4·10H2O. It is a vitreous, colorless to white monoclinic mineral that forms as an evaporite from sodium sulfate-bearing brines. It is found around saline springs and along saline playa lakes. Associated minerals include gypsum, halite, thenardite, trona, glauberite, and epsomite.","uk":"Мірабіліт (глауберова сіль) (рос. мирабилит; англ. mirabilis, mirabilite; англ."},"fame":23,"pubchemCid":null,"mass":null,"charge":0,"smiles":null,"inchikey":null,"iupac":null,"classes":[{"qid":"Q12089225","names":{"en":"mineral species","ru":"действительный вид минералов","uk":"мінеральний вид"}}],"structureInfo":null,"structure":null,"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q419296","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Mirabilite","license":"CC BY-SA 4.0"},{"role":"description","name":"Wikipedia (uk)","url":"https://uk.wikipedia.org/wiki/%D0%9C%D1%96%D1%80%D0%B0%D0%B1%D1%96%D0%BB%D1%96%D1%82","license":"CC BY-SA 4.0"},{"role":"photo","name":"Wikimedia Commons","url":"https://commons.wikimedia.org/wiki/File:Thenardite-Mirabilite-210778.jpg","license":"CC BY-SA 3.0"}],"similar":[{"id":"Q2547694","formula":"MgSO₄·11H₂O","names":{"en":"Meridianiite"},"elements":["H","O","Mg","S"],"fame":6,"kind":"crystal"},{"id":"Q3964293","formula":"H₂₀Na₂O₁₄S","names":{"en":"Sodium sulfate decahydrate","ru":"Глауберова соль","uk":"Глауберова сіль"},"elements":["H","O","Na","S"],"fame":6,"kind":"molecule"},{"id":"Q427329","formula":"Na₂CO₃·10H₂O","names":{"en":"Natron","ru":"Натрон","uk":"Кристалічна сода"},"elements":["H","C","O","Na"],
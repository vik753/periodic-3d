{"version":"2026.10.11-r25","id":"Q27261858","formula":"C₁₇H₂₂O₂","hill":"C17H22O2","elements":["H","C","O"],"composition":{"C":17.0,"H":22.0,"O":2.0},"names":{"en":"Δ1-tetrahydrocannabiorcol"},"descriptions":{"en":"Δ9-Tetrahydrocannabiorcol (Δ9-THCC, (C1)-Δ9-THC) is a phytocannabinoid found in Cannabis pollen. It is a homologue of THC with the pentyl side chain replaced by a smaller methyl group. Unlike THC, THCC has negligible affinity for the CB1 and CB2 cannabinoid receptors because of the smaller methyl group and does not have psychoactive effects as a result, but conversely it is significantly more potent than THC or THCV as an activator of the TRPA1 calcium channel which plays an important role in pain perception, and it has been shown to produce analgesic effects via activation of spinal TRPA1 channels."},"fame":1,"pubchemCid":22805649,"mass":258.35,"charge":0,"smiles":"CC1=C[C@@H]2[C@@H](CC1)C(OC3=CC(=CC(=C23)O)C)(C)C","inchikey":"WIDIPARNVYRVNW-CHWSQXEVSA-N","iupac":"(6aR,10aR)-3,6,6,9-tetramethyl-6a,7,8,10a-tetrahydrobenzo[c]chromen-1-ol","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"22805649","atoms":41,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":0.747,"y":-2.021,"z":0.37,"el":"O"},{"x":0.958,"y":2.674,"z":-0.929,"el":"O"},{"x":-1.425,"y":-0.893,"z":0.225,"el":"C"},{"x":-0.803,"y":0.339,"z":-0.476,"el":"C"},{"x":-0.611,"y":-2.169,"z":-0.097,"el":"C"},{"x":-2.922,"y":-0.955,"z":-0.108,"el":"C"},{"x":0.685,"y":0.37,"z":-0.181,"el":"C"},{"x":-3.644,"y":0.281,"z":0.441,"el":"C"},{"x":-1.587,"y":1.586,"z":-0.125,"el":"C"},{"x":-2.867,"y":1.565,"z":0.292,"el":"C"},{"x":-1.191,"y":-3.467,"z":0.486,"el":"C"},{"x":-0.479,"y":-2.366,"z":-1.618,"el":"C"},{"x":1.35,"y":-0.802,"z":0.211,"el":"C"},{"x":1.456,"y":1.529,"z":-0.379,"el":"C"},{"x":2.725,"y":-0.79,"z":0.476,"el":"C"},{"
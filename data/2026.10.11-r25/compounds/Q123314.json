rope","ru":"Гелиотроп","uk":"Геліотроп"},"elements":["O","Si"],"fame":34,"kind":"crystal"},{"id":"Q429911","formula":"SiO₂","names":{"en":"Rose quartz","ru":"Розовый кварц"},"elements":["O","Si"],"fame":31,"kind":"crystal"},{"id":"Q2050687","formula":"SiO₂","names":{"en":"Rock crystal","ru":"Горный хрусталь","uk":"Гірський кришталь"},"elements":["O","Si"],"fame":30,"kind":"crystal"}],"photo":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c9/Achat_Mineral_aus_Brasilien.jpg/960px-Achat_Mineral_aus_Brasilien.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Achat_Mineral_aus_Brasilien.jpg","license":"CC BY-SA 4.0","author":"Burkhard Mücke","licenseUrl":"https://creativecommons.org/licenses/by-sa/4.0"}}
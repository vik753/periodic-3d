{"version":"2026.10.11-r25","id":"Q7053207","formula":"C₂₁H₂₇NO₂","hill":"C21H27NO2","elements":["H","C","N","O"],"composition":{"C":21.0,"H":27.0,"N":1.0,"O":2.0},"names":{"en":"Norpropoxyphene"},"descriptions":{"en":"Norpropoxyphene is a major metabolite of the opioid analgesic drug dextropropoxyphene, and is responsible for many of the side effects associated with use of this drug, especially the unusual toxicity seen during dextropropoxyphene overdose. It has weaker analgesic effects than dextropropoxyphene itself, but is a relatively potent pro-convulsant and blocker of sodium and potassium channels, particularly in heart tissue, which produces prolonged intracardiac conduction time and can lead to heart failure following even relatively minor overdoses."},"fame":7,"pubchemCid":3084563,"mass":325.4,"charge":0,"smiles":"CCC(=O)O[C@](CC1=CC=CC=C1)(C2=CC=CC=C2)[C@H](C)CNC","inchikey":"IKACRWYHQXOSGM-UTKZUKDTSA-N","iupac":"[(2S,3R)-3-methyl-4-(methylamino)-1,2-diphenylbutan-2-yl] propanoate","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"3084563","atoms":51,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-0.018,"y":0.566,"z":-1.04,"el":"O"},{"x":0.341,"y":2.575,"z":0.036,"el":"O"},{"x":0.853,"y":-3.491,"z":-1.72,"el":"N"},{"x":0.267,"y":-0.137,"z":0.179,"el":"C"},{"x":0.123,"y":-1.682,"z":-0.136,"el":"C"},{"x":-0.768,"y":0.335,"z":1.251,"el":"C"},{"x":1.082,"y":-2.117,"z":-1.278,"el":"C"},{"x":1.695,"y":0.189,"z":0.647,"el":"C"},{"x":0.352,"y":-2.567,"z":1.106,"el":"C"},{"x":-2.224,"y":0.074,"z":0.915,"el":"C"},{"x":1.95,"y":0.205,"z":1.995,"el":"C"},{"x":2.649,"y":0.449,"z":-0.305,"el":"C"},{"x":0.058,"y":1.926,"z":-0.961,"el":"C"},{"x":-2.938,"y":1.036,"z":0.226,"el":"C"},{"x":-2.8,"y":-1.12,"z":1.308,"el":"C"},{"x":3.246,"y":0.5,"z":2.42,"el":"C"},{"x":3.944,"y":0.744,"z":0.12,"el
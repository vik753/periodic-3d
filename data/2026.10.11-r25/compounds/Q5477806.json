{"version":"2026.10.11-r25","id":"Q5477806","formula":"C₃₀H₃₄FN₅O₅","hill":"C30H34FN5O5","elements":["H","C","N","O","F"],"composition":{"C":30.0,"F":1.0,"H":34.0,"N":5.0,"O":5.0},"names":{"en":"Frakefamide"},"descriptions":{"en":"Frakefamide (INN) is a synthetic, fluorinated linear tetrapeptide with the amino acid sequence Tyr-D-Ala-(p-F)Phe-Phe-NH2 which acts as a peripherally-specific, selective μ-opioid receptor agonist. Despite its inability to penetrate the blood-brain-barrier and enter the central nervous system, frakefamide has potent analgesic effects and, unlike centrally-acting opioids like morphine, does not produce respiratory depression, indicating that its antinociceptive effects are mediated by peripheral μ-opioid receptors. It was under development for the treatment of pain by AstraZeneca and Shire but was shelved after phase II clinical trials."},"fame":4,"pubchemCid":9829352,"mass":563.6,"charge":0,"smiles":"C[C@H](C(=O)N[C@@H](CC1=CC=C(C=C1)F)C(=O)N[C@@H](CC2=CC=CC=C2)C(=O)N)NC(=O)[C@H](CC3=CC=C(C=C3)O)N","inchikey":"GTPHQORJKFJIRB-JTQLPTLWSA-N","iupac":"(2S)-2-amino-N-[(2R)-1-[[(2S)-1-[[(2S)-1-amino-1-oxo-3-phenylpropan-2-yl]amino]-3-(4-fluorophenyl)-1-oxopropan-2-yl]amino]-1-oxopropan-2-yl]-3-(4-hydroxyphenyl)propanamide","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"rdkit","ref":"9829352","atoms":75,"license":"Computed with RDKit from SMILES (PubChem, Wikidata)"},"structure":{"kind":"molecule","atoms":[{"x":2.178,"y":-3.1,"z":1.791,"el":"C"},{"x":1.795,"y":-1.833,"z":1.041,"el":"C"},{"x":1.063,"y":-2.171,"z":-0.275,"el":"C"},{"x":1.533,"y":-1.921,"z":-1.384,"el":"O"},{"x":-0.178,"y":-2.754,"z":-0.112,"el":"N"},{"x":-1.117,"y":-2.817,"z":-1.244,"el":"C"},{"x":-1.975,"y":-4.085,"z":-1.158,"el":"C"},{"x":-2.67,"y":-4.408,"z":-2.462,"el":"C"},{"x":-1.989,"y":-5.104,"z":-3.474,"el":"C"},{"x":-2.624,"y":-5.388,"z":-4.6
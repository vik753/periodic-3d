{"version":"2026.10.11-r25","id":"Q4806990","formula":"C₂₇H₃₀N₂O₂","hill":"C27H30N2O2","elements":["H","C","N","O"],"composition":{"C":27.0,"H":30.0,"N":2.0,"O":2.0},"names":{"en":"Asimadoline"},"descriptions":{"en":"Asimadoline (EMD-61753) is an experimental drug which acts as a peripherally selective κ-opioid receptor (KOR) agonist. Because of its low penetration across the blood–brain barrier, asimadoline lacks the psychotomimetic effects of centrally acting KOR agonists, and consequently was thought to have potential for medical use. It has been studied as a possible treatment for irritable bowel syndrome, with reasonable efficacy seen in clinical trials, but it has never been approved or marketed."},"fame":4,"pubchemCid":179340,"mass":414.5,"charge":0,"smiles":"CN([C@H](CN1CC[C@@H](C1)O)C2=CC=CC=C2)C(=O)C(C3=CC=CC=C3)C4=CC=CC=C4","inchikey":"JHLHNYVMZCADTC-LOSJGSFVSA-N","iupac":"N-[(1S)-2-[(3S)-3-hydroxypyrrolidin-1-yl]-1-phenylethyl]-N-methyl-2,2-diphenylacetamide","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"179340","atoms":61,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-0.363,"y":5.037,"z":-0.156,"el":"O"},{"x":0.345,"y":-0.696,"z":-1.581,"el":"O"},{"x":-1.787,"y":2.252,"z":-0.426,"el":"N"},{"x":-0.925,"y":-0.392,"z":0.343,"el":"N"},{"x":-2.301,"y":3.604,"z":-0.185,"el":"C"},{"x":-1.431,"y":2.223,"z":-1.844,"el":"C"},{"x":-1.363,"y":4.485,"z":-1.003,"el":"C"},{"x":-0.726,"y":3.558,"z":-2.036,"el":"C"},{"x":-2.749,"y":1.219,"z":-0.073,"el":"C"},{"x":-2.181,"y":-0.183,"z":-0.344,"el":"C"},{"x":-3.175,"y":-1.267,"z":0.024,"el":"C"},{"x":0.277,"y":-0.639,"z":-0.348,"el":"C"},{"x":1.545,"y":-0.833,"z":0.502,"el":"C"},{"x":-0.986,"y":-0.328,"z":1.805,"el":"C"},{"x":-4.078,"y":-1.035,"z":1.045,"el":"C"},{"x":-3.155,"y":-2.462,"z":-0.671,"el":"C"},{"x":2.176,"y":0.511,"z":0.869,
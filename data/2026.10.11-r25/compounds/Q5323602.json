{"version":"2026.10.11-r25","id":"Q5323602","formula":"C₁₃H₂₁NO₃","hill":"C13H21NO3","elements":["H","C","N","O"],"composition":{"C":13.0,"H":21.0,"N":1.0,"O":3.0},"names":{"en":"EMM"},"descriptions":{"en":"EMM, also known as 2-ethoxy-4,5-dimethoxyamphetamine or as TMA2-2-EtO, is a chemical compound of the phenethylamine, amphetamine, and DOx families related to the psychedelic drug TMA-2. It is the analogue of TMA-2 in which the methoxy group at the 2 position has been replaced with an ethoxy group. In his book PiHKAL (Phenethylamines I Have Known and Loved) and other publications, Alexander Shulgin lists EMM's dose as greater than 50 mg orally and its duration as unknown."},"fame":5,"pubchemCid":44719565,"mass":239.31,"charge":0,"smiles":"CCOC1=CC(=C(C=C1CC(C)N)OC)OC","inchikey":"SKRNTJDDBVAEGB-UHFFFAOYSA-N","iupac":"1-(2-ethoxy-4,5-dimethoxyphenyl)propan-2-amine","classes":[{"qid":"Q59199015","names":{"en":"group of stereoisomers","ru":"группа стереоизомеров","uk":"група стереоізомерів"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"44719565","atoms":38,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-1.219,"y":-1.861,"z":0.715,"el":"O"},{"x":2.768,"y":1.842,"z":-0.179,"el":"O"},{"x":3.325,"y":-0.878,"z":-0.302,"el":"O"},{"x":-3.86,"y":2.237,"z":0.163,"el":"N"},{"x":-1.916,"y":0.915,"z":0.868,"el":"C"},{"x":-2.529,"y":1.782,"z":-0.247,"el":"C"},{"x":-0.521,"y":0.427,"z":0.558,"el":"C"},{"x":-0.241,"y":-0.939,"z":0.495,"el":"C"},{"x":0.492,"y":1.358,"z":0.331,"el":"C"},{"x":-2.665,"y":1.025,"z":-1.568,"el":"C"},{"x":1.786,"y":0.924,"z":0.041,"el":"C"},{"x":1.053,"y":-1.372,"z":0.206,"el":"C"},{"x":2.066,"y":-0.441,"z":-0.021,"el":"C"},{"x":-1.505,"y":-2.768,"z":-0.348,"el":"C"},{"x":-2.96,"y":-3.178,"z":-0.269,"el":"C"},{"x":2.398,"y":3.218,"z":-0.097,"el":"C"},{"x":3.526,"y":-2.29,"z":-0.347,"el":"C"},{"x":-1.863,"y":1.494,"z":1.801,"el":"H"},{"x":-2.588,"y":0.075,"z":1.085,"el":"H"},{"x":-1.912,"y":2.671,"z":
{"version":"2026.10.11-r25","id":"Q123914020","formula":"C₁₂H₁₆N₆O₈","hill":"C12H16N6O8","elements":["H","C","N","O"],"composition":{"C":12.0,"H":16.0,"N":6.0,"O":8.0},"names":{"en":"Relmapirazin"},"descriptions":{"en":"Relmapirazin (MB-102) is an investigational fluorescent tracer that is exclusively excreted renally and is used to measure glomerular filtration rate of the kidneys. Using plasma sampling, relmapirazin has been shown to have the same properties and accuracy as iohexol for determining glomerular filtration rate in human subjects of varying kidney function. Furthermore, transdermal optical detection of the change in concentration of intravenously injected relmapirazin has been used to estimate glomerular filtration rate with excellent accuracy in human subjects of varying kidney function and skin color."},"fame":2,"pubchemCid":53389120,"mass":372.29,"charge":0,"smiles":"C([C@H](C(=O)O)NC(=O)C1=C(N=C(C(=N1)N)C(=O)N[C@H](CO)C(=O)O)N)O","inchikey":"XHNJXRDGTITISI-QWWZWVQMSA-N","iupac":"(2R)-2-[[3,6-diamino-5-[[(1R)-1-carboxy-2-hydroxyethyl]carbamoyl]pyrazine-2-carbonyl]amino]-3-hydroxypropanoic acid","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"53389120","atoms":42,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":5.237,"y":-2.276,"z":1.135,"el":"O"},{"x":-5.241,"y":2.276,"z":1.132,"el":"O"},{"x":3.167,"y":1.618,"z":-1.316,"el":"O"},{"x":-3.168,"y":-1.62,"z":-1.314,"el":"O"},{"x":6.305,"y":1.454,"z":1.011,"el":"O"},{"x":-6.306,"y":-1.456,"z":1.013,"el":"O"},{"x":4.639,"y":0.509,"z":2.228,"el":"O"},{"x":-4.64,"y":-0.507,"z":2.229,"el":"O"},{"x":3.561,"y":-0.361,"z":-0.173,"el":"N"},{"x":-3.561,"y":0.36,"z":-0.174,"el":"N"},{"x":0.972,"y":-1.009,"z":-0.798,"el":"N"},{"x":-0.974,"y":1.01,"z":-0.798,"el":"N"},{"x":0.752,"y":2.643,"z":-0.794,"el":"N"},{"x":-0.754,"y":-2.642,"z":
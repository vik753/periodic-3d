{"version":"2026.10.11-r25","id":"Q419059","formula":"C₇H₁₇N₂O₂","hill":"C7H17N2O2","elements":["H","C","N","O"],"composition":{"C":7.0,"H":17.0,"N":2.0,"O":2.0},"names":{"en":"Bethanechol"},"descriptions":{"en":"Bethanechol is a parasympathomimetic choline carbamate that selectively stimulates muscarinic receptors without any effect on nicotinic receptors. Unlike acetylcholine, bethanechol is not hydrolyzed by cholinesterase and will therefore have a long duration of action. Bethanechol is sold under the brand names Duvoid (Roberts), Myotonachol (Glenwood), Urecholine (Merck Frosst), and Urocarb (Hamilton)."},"fame":20,"pubchemCid":2370,"mass":161.22,"charge":0,"smiles":"CC(C[N+](C)(C)C)OC(=O)N","inchikey":"NZUPCNDJBJXXRF-UHFFFAOYSA-O","iupac":"2-carbamoyloxypropyl(trimethyl)azanium","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"2370","atoms":28,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-0.868,"y":0.266,"z":-0.332,"el":"O"},{"x":-2.593,"y":0.005,"z":1.169,"el":"O"},{"x":1.962,"y":0.223,"z":0.039,"el":"N"},{"x":-2.854,"y":1.243,"z":-0.75,"el":"N"},{"x":1.182,"y":-0.977,"z":-0.477,"el":"C"},{"x":-0.252,"y":-0.964,"z":0.042,"el":"C"},{"x":1.946,"y":0.223,"z":1.561,"el":"C"},{"x":3.4,"y":0.144,"z":-0.453,"el":"C"},{"x":1.32,"y":1.504,"z":-0.474,"el":"C"},{"x":-1.102,"y":-2.129,"z":-0.449,"el":"C"},{"x":-2.141,"y":0.461,"z":0.124,"el":"C"},{"x":1.206,"y":-0.928,"z":-1.572,"el":"H"},{"x":1.709,"y":-1.883,"z":-0.154,"el":"H"},{"x":-0.242,"y":-1.038,"z":1.135,"el":"H"},{"x":2.264,"y":-0.762,"z":1.915,"el":"H"},{"x":2.651,"y":0.987,"z":1.905,"el":"H"},{"x":0.951,"y":0.477,"z":1.933,"el":"H"},{"x":3.39,"y":0.161,"z":-1.547,"el":"H"},{"x":3.955,"y":1.002,"z":-0.062,"el":"H"},{"x":3.839,"y":-0.789,"z":-0.087,"el":"H"},{"x":0.982,"y":1.365,"z":-1.506,"el":"H"},{"x":0.542,"y":1.855,"z":0.20
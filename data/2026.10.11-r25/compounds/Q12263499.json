{"version":"2026.10.11-r25","id":"Q12263499","formula":"C₂H₅N₅O₃","hill":"C2H5N5O3","elements":["H","C","N","O"],"composition":{"C":2.0,"H":5.0,"N":5.0,"O":3.0},"names":{"en":"N-methyl-N'-nitro-N-nitrosoguanidine"},"descriptions":{"en":"Methylnitronitrosoguanidine (MNNG or MNG, NTG when referred to colloquially as nitrosoguanidine) is a biochemical tool used experimentally as a carcinogen and mutagen. It acts by adding alkyl groups to the O6 of guanine and O4 of thymine, which can lead to transition mutations between GC and AT. These changes do not cause a heavy distortion in the double helix of DNA and thus are hard to detect by the DNA mismatch repair system. In organic chemistry, MNNG is used as a source of diazomethane when reacted with aqueous potassium hydroxide."},"fame":9,"pubchemCid":6261,"mass":147.09,"charge":0,"smiles":"CN(C(=N[N+](=O)[O-])N)N=O","inchikey":"VZUNGTLZRAYYDE-UHFFFAOYSA-N","iupac":"1-methyl-2-nitro-1-nitrosoguanidine","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"6261","atoms":15,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-3.523,"y":0.203,"z":0.013,"el":"O"},{"x":2.765,"y":0.065,"z":1.104,"el":"O"},{"x":2.8,"y":-0.017,"z":-1.073,"el":"O"},{"x":-1.374,"y":-0.223,"z":-0.025,"el":"N"},{"x":0.163,"y":1.591,"z":-0.053,"el":"N"},{"x":0.965,"y":-0.665,"z":0.012,"el":"N"},{"x":-2.389,"y":0.691,"z":0.022,"el":"N"},{"x":2.224,"y":-0.177,"z":0.014,"el":"N"},{"x":-0.019,"y":0.214,"z":-0.021,"el":"C"},{"x":-1.611,"y":-1.681,"z":0.009,"el":"C"},{"x":-2.648,"y":-1.95,"z":-0.214,"el":"H"},{"x":-1.364,"y":-2.074,"z":1.001,"el":"H"},{"x":-0.992,"y":-2.19,"z":-0.738,"el":"H"},{"x":-0.608,"y":2.247,"z":-0.099,"el":"H"},{"x":1.089,"y":2.002,"z":-0.049,"el":"H"}],"bonds":[[0,6,2],[1,7,1],[2,7,2],[3,6,1],[3,8,1],[3,9,1],[4,8,1],[4,13,1],[4,14,1],[5,7,1],[5,8,2],[9,10,1],[9,11
{"version":"2026.10.11-r25","id":"Q3270569","formula":"C₁₅H₂₀ClN₃O","hill":"C15H20ClN3O","elements":["H","C","N","O","Cl"],"composition":{"C":15.0,"H":20.0,"N":3.0,"O":1.0,"Cl":1.0},"names":{"en":"Paclobutrazol"},"descriptions":{"en":"Paclobutrazol (PBZ) is the ISO common name for an organic compound that is used as a plant growth retardant and triazole fungicide. It is a known antagonist of the plant hormone gibberellin, acting by inhibiting gibberellin biosynthesis, reducing internodal growth to give stouter stems, increasing root growth, causing early fruitset and increasing seedset in plants such as tomato and pepper. PBZ has also been shown to reduce frost sensitivity in plants."},"fame":18,"pubchemCid":73671,"mass":293.79,"charge":0,"smiles":"CC(C)(C)[C@@H]([C@H](CC1=CC=C(C=C1)Cl)N2C=NC=N2)O","inchikey":"RMOGWMIKYWRTKW-UONOGXRCSA-N","iupac":"(2S,3S)-1-(4-chlorophenyl)-4,4-dimethyl-2-(1,2,4-triazol-1-yl)pentan-3-ol","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"73671","atoms":40,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":5.659,"y":0.875,"z":0.501,"el":"Cl"},{"x":-3.164,"y":-1.103,"z":0.679,"el":"O"},{"x":-0.461,"y":-1.44,"z":0.127,"el":"N"},{"x":-0.471,"y":-2.122,"z":-1.003,"el":"N"},{"x":0.466,"y":-3.275,"z":0.736,"el":"N"},{"x":-3.33,"y":1.245,"z":-0.004,"el":"C"},{"x":-2.558,"y":-0.11,"z":-0.154,"el":"C"},{"x":-1.027,"y":-0.069,"z":0.152,"el":"C"},{"x":-0.209,"y":0.883,"z":-0.76,"el":"C"},{"x":-4.831,"y":1.048,"z":-0.298,"el":"C"},{"x":-2.787,"y":2.27,"z":-1.027,"el":"C"},{"x":-3.172,"y":1.857,"z":1.398,"el":"C"},{"x":1.269,"y":0.882,"z":-0.443,"el":"C"},{"x":0.081,"y":-2.093,"z":1.157,"el":"C"},{"x":1.762,"y":1.781,"z":0.487,"el":"C"},{"x":2.099,"y":-0.019,"z":-1.089,"el":"C"},{"x":0.11,"y":-3.247,"z":-0.582,"el":"C"},{"x":3.126,"y":1.779,"z":0.78,"el":"C"},{"x":3.463,"
{"version":"2026.10.11-r25","id":"Q5197469","formula":"C₂₃H₃₃NO₂","hill":"C23H33NO2","elements":["H","C","N","O"],"composition":{"C":23.0,"H":33.0,"N":1.0,"O":2.0},"names":{"en":"Cyanoketone"},"descriptions":{"en":"Cyanoketone, also known as 2α-cyano-4,4',17α-trimethylandrost-5-en-17β-ol-3-one (CTM), is a synthetic androstane steroid and a steroidogenesis inhibitor which is used in scientific research. On account of its structural similarity to pregnenolone, cyanoketone binds to and acts as a potent, selective, and irreversible inhibitor of 3β-hydroxysteroid dehydrogenase (3β-HSD), an enzyme that is responsible for the conversion of pregnenolone into progesterone, 17α-hydroxypregnenolone into 17α-hydroxyprogesterone, DHEATooltip dehydroepiandrosterone into androstenedione, and androstenediol into testosterone."},"fame":5,"pubchemCid":20243,"mass":355.5,"charge":0,"smiles":"C[C@]12CC[C@H]3[C@H]([C@@H]1CC[C@]2(C)O)CC=C4[C@@]3(C[C@H](C(=O)C4(C)C)C#N)C","inchikey":"GTBRTGPZZALPNS-MXHVRSFHSA-N","iupac":"(2S,8R,9S,10R,13S,14S,17S)-17-hydroxy-4,4,10,13,17-pentamethyl-3-oxo-1,2,7,8,9,11,12,14,15,16-decahydrocyclopenta[a]phenanthrene-2-carbonitrile","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"20243","atoms":59,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-5.748,"y":-1.026,"z":0.558,"el":"O"},{"x":5.054,"y":0.209,"z":1.109,"el":"O"},{"x":5.0,"y":-2.681,"z":-1.335,"el":"N"},{"x":-3.349,"y":-0.525,"z":0.315,"el":"C"},{"x":-2.647,"y":0.65,"z":-0.393,"el":"C"},{"x":-1.209,"y":0.88,"z":0.091,"el":"C"},{"x":-0.367,"y":-0.411,"z":-0.122,"el":"C"},{"x":1.115,"y":-0.221,"z":0.404,"el":"C"},{"x":-4.782,"y":-0.412,"z":-0.293,"el":"C"},{"x":-2.552,"y":-1.799,"z":-0.009,"el":"C"},{"x":-1.081,"y":-1.678,"z":0.428,"el":"C"},{"x":-3.643,"y":1.797,"z":-0.262,"el":"C"},{"x":-5.024,"y":1.121,"z":-0.348,"el"
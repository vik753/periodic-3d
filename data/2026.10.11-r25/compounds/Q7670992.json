{"version":"2026.10.11-r25","id":"Q7670992","formula":"C₁₂H₁₉NO₂S","hill":"C12H19NO2S","elements":["H","C","N","O","S"],"composition":{"C":12.0,"H":19.0,"N":1.0,"O":2.0,"S":1.0},"names":{"en":"TOMSO"},"descriptions":{"en":"TOMSO, or 5-TOMSO, also known as 2-methoxy-4-methyl-5-methylsulfinylamphetamine, is a psychedelic drug of the phenethylamine and amphetamine families related to the DOx series. It is the analogue of DOM in which the methoxy group at the 5 position has been replaced with a sulfur-containing methylsulfinyl group. In his book PiHKAL (Phenethylamines I Have Known and Loved), Alexander Shulgin lists TOMSO's dose as >150 mg orally alone or 100 to 150 mg orally in combination with alcohol and its duration as 10 to 16 hours."},"fame":3,"pubchemCid":15915372,"mass":241.35,"charge":0,"smiles":"CC1=CC(=C(C=C1S(=O)C)CC(C)N)OC","inchikey":"LMQLBXOYCGXTOM-UHFFFAOYSA-N","iupac":"1-(2-methoxy-4-methyl-5-methylsulfinylphenyl)propan-2-amine","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"15915372","atoms":35,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":3.125,"y":-1.019,"z":0.429,"el":"S"},{"x":-1.87,"y":2.142,"z":-0.258,"el":"O"},{"x":2.773,"y":-2.138,"z":1.366,"el":"O"},{"x":-3.66,"y":-2.383,"z":0.236,"el":"N"},{"x":-2.088,"y":-0.549,"z":0.67,"el":"C"},{"x":-2.38,"y":-1.801,"z":-0.177,"el":"C"},{"x":-0.766,"y":0.104,"z":0.348,"el":"C"},{"x":-0.729,"y":1.416,"z":-0.099,"el":"C"},{"x":0.398,"y":-0.633,"z":0.508,"el":"C"},{"x":1.628,"y":-0.044,"z":0.214,"el":"C"},{"x":1.679,"y":1.275,"z":-0.236,"el":"C"},{"x":0.501,"y":2.005,"z":-0.392,"el":"C"},{"x":-2.452,"y":-1.493,"z":-1.673,"el":"C"},{"x":2.975,"y":1.945,"z":-0.562,"el":"C"},{"x":3.187,"y":-1.719,"z":-1.241,"el":"C"},{"x":-2.322,"y":2.894,"z":0.867,"el":"C"},{"x":-2.074,"y":-0.817,"z":1.736,"el":"H"},{"x":-2.923,"y":0.152,"z":0
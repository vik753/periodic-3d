{"version":"2026.10.11-r25","id":"Q3028845","formula":"C₅O₂","hill":"C5O2","elements":["C","O"],"composition":{"C":5.0,"O":2.0},"names":{"en":"Pentacarbon dioxide"},"descriptions":{"en":"Pentacarbon dioxide, officially penta-1,2,3,4-tetraene-1,5-dione, is an oxide of carbon (an oxocarbon) with formula C5O2 or O=C=C=C=C=C=O. The compound was described in 1988 by Günter Maier and others, who obtained it by pyrolysis of 2,4,6-tris(diazo)cyclohexane-1,3,5-trione (C6N6O3). Diazo transfer can produce the latter compound from phloroglucinol. It is stable at room temperature in solution."},"fame":15,"pubchemCid":521350,"mass":92.05,"charge":0,"smiles":"C(=C=C=O)=C=C=O","inchikey":"BKMBQDLZBSCFGV-UHFFFAOYSA-N","iupac":"penta-1,2,3,4-tetraene-1,5-dione","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"521350","atoms":7,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":3.577,"y":0.0,"z":0.0,"el":"O"},{"x":-3.577,"y":0.0,"z":0.0,"el":"O"},{"x":0.0,"y":0.0,"z":0.0,"el":"C"},{"x":1.201,"y":0.0,"z":0.0,"el":"C"},{"x":-1.201,"y":0.0,"z":0.0,"el":"C"},{"x":2.401,"y":0.0,"z":0.0,"el":"C"},{"x":-2.401,"y":0.0,"z":0.0,"el":"C"}],"bonds":[[0,5,2],[1,6,2],[2,3,2],[2,4,2],[3,5,2],[4,6,2]]},"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q3028845","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Pentacarbon_dioxide","license":"CC BY-SA 4.0"},{"role":"properties","name":"PubChem","url":"https://pubchem.ncbi.nlm.nih.gov/compound/521350","license":"PubChem (NIH), public data"},{"role":"structure","name":"PubChem 3D","url":"https://pubchem.ncbi.nlm.nih.gov/compound/521350#section=3D-Conformer","license":"PubChem (NIH), public data"}],"similar":[{"id":"Q3321280","formula":"C₃O","names":{"en":"Tricarbon monoxide"},"elements":["
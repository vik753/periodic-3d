{"version":"2026.10.11-r25","id":"Q27286818","formula":"C₂₁H₃₀O₂","hill":"C21H30O2","elements":["H","C","O"],"composition":{"C":21.0,"H":30.0,"O":2.0},"names":{"en":"(S)-δ3-tetrahydrocannabinol"},"descriptions":{"en":"Δ3-Tetrahydrocannabinol (often abbreviated as delta-3-THC or Δ3-THC) is a synthetic isomer of tetrahydrocannabinol (THC) developed during the original research in the 1940s to develop synthetic routes to the natural products Δ8-THC and Δ9-THC found in the cannabis. While the normal trans configuration of THC is in this case flattened by the double bond, it still has two enantiomers as the 9-methyl group can exist in an (R) or (S) conformation. The (S) enantiomer has similar effects to Δ9-THC though with several times lower potency, while the (R) enantiomer is many times less active or inactive, depending on the assay used."},"fame":1,"pubchemCid":71587360,"mass":314.5,"charge":0,"smiles":"CCCCCC1=CC(=C2C3=C(CC[C@@H](C3)C)C(OC2=C1)(C)C)O","inchikey":"NEBZNJDFIPBXCS-AWEZNQCLSA-N","iupac":"(9S)-6,6,9-trimethyl-3-pentyl-7,8,9,10-tetrahydrobenzo[c]chromen-1-ol","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"rdkit","ref":"71587360","atoms":53,"license":"Computed with RDKit from SMILES (PubChem, Wikidata)"},"structure":{"kind":"molecule","atoms":[{"x":5.264,"y":1.556,"z":-2.741,"el":"C"},{"x":5.247,"y":0.589,"z":-1.567,"el":"C"},{"x":4.298,"y":-0.582,"z":-1.824,"el":"C"},{"x":4.315,"y":-1.637,"z":-0.711,"el":"C"},{"x":3.835,"y":-1.151,"z":0.662,"el":"C"},{"x":2.391,"y":-0.715,"z":0.684,"el":"C"},{"x":2.049,"y":0.633,"z":0.806,"el":"C"},{"x":0.703,"y":1.03,"z":0.826,"el":"C"},{"x":-0.345,"y":0.095,"z":0.727,"el":"C"},{"x":-1.793,"y":0.412,"z":0.792,"el":"C"},{"x":-2.665,"y":-0.542,"z":0.398,"el":"C"},{"x":-4.158,"y":-0.284,"z":0.355,"el":"C"},{"x":-4.553,"y":1.184,"z":0.505,"el":"C"},{"x":-3.746,"y":1.838,"z":1.623,"el":"C"},{"x":
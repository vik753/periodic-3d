{"version":"2026.10.11-r25","id":"Q520633","formula":"C₅₆H₆₈Cl₄CuN₁₆S₄","hill":"C56H68Cl4CuN16S4","elements":["H","C","N","S","Cl","Cu"],"composition":{"C":56.0,"H":68.0,"N":16.0,"S":4.0,"Cl":4.0,"Cu":1.0},"names":{"en":"Alcian blue"},"descriptions":{"en":"Alcian blue () is any member of a family of polyvalent basic dyes, of which the Alcian blue 8G (also called Ingrain blue 1, and C.I. 74240, formerly called Alcian blue 8GX from the name of a batch of an ICI product) has been historically the most common and the most reliable member. It is used to stain acidic polysaccharides such as glycosaminoglycans in cartilages and other body structures, some types of mucopolysaccharides, sialylated glycocalyx of cells etc. For many of these targets it is one of the most widely used cationic dyes for both light and electron microscopy."},"fame":10,"pubchemCid":3084579,"mass":1298.9,"charge":0,"smiles":"CN(C)C(=[N+](C)C)SCC1=CC2=C(C=C1)C3=NC4=NC(=NC5=C6C=C(C=CC6=C([N-]5)N=C7C8=C(C=CC(=C8)CSC(=[N+](C)C)N(C)C)C(=N7)N=C2[N-]3)CSC(=[N+](C)C)N(C)C)C9=C4C=CC(=C9)CSC(=[N+](C)C)N(C)C.[Cl-].[Cl-].[Cl-].[Cl-].[Cu+2]","inchikey":"KDXHLJMVLXJXCW-UHFFFAOYSA-J","iupac":"copper;[dimethylamino-[[15,24,34-tris[[dimethylamino(dimethylazaniumylidene)methyl]sulfanylmethyl]-2,11,20,29,37,39-hexaza-38,40-diazanidanonacyclo[28.6.1.13,10.112,19.121,28.04,9.013,18.022,27.031,36]tetraconta-1,3,5,7,9,11,13(18),14,16,19(39),20,22(27),23,25,28,30(37),31(36),32,34-nonadecaen-6-yl]methylsulfanyl]methylidene]-dimethylazanium;tetrachloride","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"rdkit","ref":"3084579","atoms":149,"license":"Computed with RDKit from SMILES (PubChem, Wikidata)"},"structure":{"kind":"molecule","atoms":[{"x":2.358,"y":2.233,"z":-2.904,"el":"C"},{"x":3.615,"y":1.453,"z":-2.939,"el":"N"},{"x":4.657,"y":2.03,"z":-2.088,"el":"C"},{"x":3.626,"y":0.133,"z":-3.219,"e
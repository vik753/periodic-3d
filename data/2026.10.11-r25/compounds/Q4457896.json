{"version":"2026.10.11-r25","id":"Q4457896","formula":"Ag₂S₂O₃","hill":"Ag2O3S2","elements":["O","S","Ag"],"composition":{"O":3.0,"S":2.0,"Ag":2.0},"names":{"en":"Silver thiosulfate","ru":"Тиосульфат серебра"},"descriptions":{"en":"Silver thiosulfate (STS, chemical formula Ag2S2O3) is an inorganic chemical that can promote early flower growth and promote flower duration in a variety of plants. An aqueous solution of silver thiosulfate can be prepared by mixing solutions of sodium thiosulfate and silver nitrate. When used for plant assays, it is prepared using excess thiosulfate, giving the [Ag(S2O3)2]3– complex ion.","ru":"Тиосульфат серебра — неорганическое соединение, соль металла серебра и тиосерной кислоты с формулой Ag2S2O3, белый порошок, слабо растворяется в воде."},"fame":9,"pubchemCid":272112,"mass":247.29,"charge":0,"smiles":"CC1=C2C=CN=CC2=C(C3=C1C4=CC=CC=C4O3)C","inchikey":"SEKXDDMDWFIHJO-UHFFFAOYSA-N","iupac":"5,11-dimethyl-[1]benzofuro[3,2-g]isoquinoline","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":null,"structure":null,"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q4457896","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Silver_thiosulfate","license":"CC BY-SA 4.0"},{"role":"description","name":"Wikipedia (ru)","url":"https://ru.wikipedia.org/wiki/%D0%A2%D0%B8%D0%BE%D1%81%D1%83%D0%BB%D1%8C%D1%84%D0%B0%D1%82_%D1%81%D0%B5%D1%80%D0%B5%D0%B1%D1%80%D0%B0","license":"CC BY-SA 4.0"},{"role":"properties","name":"PubChem","url":"https://pubchem.ncbi.nlm.nih.gov/compound/272112","license":"PubChem (NIH), public data"}],"similar":[{"id":"Q18358784","formula":"Ag₂O₃S","names":{"en":"Silver sulfite","ru":"Сульфит серебра"},"elements":["O","S","Ag"],"fame":8,"kind":"crystal"},{"id":"Q411864","formula":"Ag₂O₄S","names":{"en":"Silver sulfate","ru":"Сульфат серебра"},"el
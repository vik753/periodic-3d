{"version":"2026.10.11-r25","id":"Q4637146","formula":"C₆H₁₂O₃","hill":"C6H12O3","elements":["H","C","O"],"composition":{"C":6.0,"H":12.0,"O":3.0},"names":{"en":"4-Hydroxy-4-methylpentanoic acid"},"descriptions":{"en":"4-Hydroxy-4-methylpentanoic acid (UMB68) is a tertiary alcohol, similar in structure to the drug GHB. The molecule has been synthesized and tested on animals in order to further research the effects of GHB. UMB68 has been shown to bind selectively to the GHB receptor ligand in binding assays, yet does not bind to GABA receptors. As such, it can provide a useful tool in studying the pharmacology of the GHB receptor in absence of GABAergic effects."},"fame":4,"pubchemCid":23422947,"mass":132.16,"charge":0,"smiles":"CC(C)(CCC(=O)O)O","inchikey":"PQJUMPXLDAZULJ-UHFFFAOYSA-N","iupac":"4-hydroxy-4-methylpentanoic acid","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"23422947","atoms":21,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-1.966,"y":0.727,"z":-1.209,"el":"O"},{"x":3.189,"y":0.876,"z":-0.058,"el":"O"},{"x":2.453,"y":-1.268,"z":0.102,"el":"O"},{"x":-1.731,"y":0.002,"z":-0.001,"el":"C"},{"x":-0.282,"y":-0.534,"z":-0.014,"el":"C"},{"x":0.831,"y":0.516,"z":-0.04,"el":"C"},{"x":-2.005,"y":0.93,"z":1.184,"el":"C"},{"x":-2.709,"y":-1.179,"z":0.025,"el":"C"},{"x":2.22,"y":-0.07,"z":0.011,"el":"C"},{"x":-0.152,"y":-1.176,"z":-0.897,"el":"H"},{"x":-0.134,"y":-1.182,"z":0.861,"el":"H"},{"x":0.738,"y":1.181,"z":0.825,"el":"H"},{"x":0.75,"y":1.113,"z":-0.955,"el":"H"},{"x":-1.43,"y":1.859,"z":1.105,"el":"H"},{"x":-1.767,"y":0.447,"z":2.137,"el":"H"},{"x":-3.059,"y":1.232,"z":1.206,"el":"H"},{"x":-2.566,"y":-1.823,"z":-0.851,"el":"H"},{"x":-3.747,"y":-0.83,"z":-0.017,"el":"H"},{"x":-2.585,"y":-1.785,"z":0.927,"el":"H"},{"x":-2.882,"y":1.055,"z":-1.191,"el":"H"},{"x":4.088,"y":0.4
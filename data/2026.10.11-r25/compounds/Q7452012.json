{"version":"2026.10.11-r25","id":"Q7452012","formula":"C₁₆H₁₆F₃NO","hill":"C16H16F3NO","elements":["H","C","N","O","F"],"composition":{"C":16.0,"F":3.0,"H":16.0,"N":1.0,"O":1.0},"names":{"en":"Seproxetine"},"descriptions":{"en":"Seproxetine, also known as (S)-norfluoxetine, is a selective serotonin reuptake inhibitor (SSRI). It is the (S) enantiomer of norfluoxetine, the active metabolite of the widely used antidepressant fluoxetine; it is nearly 4 times more selective for stimulating neurosteroid synthesis relative to serotonin reuptake inhibition than fluoxetine. It is formed through the demethylation, or removal of a methyl group, of fluoxetine."},"fame":6,"pubchemCid":4541,"mass":295.3,"charge":0,"smiles":"C1=CC=C(C=C1)C(CCN)OC2=CC=C(C=C2)C(F)(F)F","inchikey":"WIQRCHMSJFFONW-UHFFFAOYSA-N","iupac":"3-phenyl-3-[4-(trifluoromethyl)phenoxy]propan-1-amine","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"4541","atoms":37,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-5.588,"y":0.619,"z":0.209,"el":"F"},{"x":-4.963,"y":-0.171,"z":-1.712,"el":"F"},{"x":-5.221,"y":-1.512,"z":-0.019,"el":"F"},{"x":0.662,"y":0.434,"z":1.091,"el":"O"},{"x":3.73,"y":3.813,"z":-0.591,"el":"N"},{"x":1.58,"y":0.703,"z":0.029,"el":"C"},{"x":2.202,"y":2.091,"z":0.248,"el":"C"},{"x":2.587,"y":-0.422,"z":-0.011,"el":"C"},{"x":3.166,"y":2.496,"z":-0.867,"el":"C"},{"x":-0.647,"y":0.26,"z":0.738,"el":"C"},{"x":3.148,"y":-0.787,"z":-1.224,"el":"C"},{"x":2.931,"y":-1.067,"z":1.166,"el":"C"},{"x":-1.621,"y":1.11,"z":1.253,"el":"C"},{"x":-0.997,"y":-0.766,"z":-0.136,"el":"C"},{"x":4.079,"y":-1.825,"z":-1.262,"el":"C"},{"x":3.862,"y":-2.106,"z":1.128,"el":"C"},{"x":-3.313,"y":-0.093,"z":0.017,"el":"C"},{"x":-2.957,"y":0.933,"z":0.892,"el":"C"},{"x":-2.333,"y":-0.943,"z":-0.497,"el":"C"},{"x":4.436,"y":-2.485,"z":-0.085,"el"
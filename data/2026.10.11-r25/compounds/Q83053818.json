{"version":"2026.10.11-r25","id":"Q83053818","formula":"C₂H₄O₃","hill":"C2H4O3","elements":["H","C","O"],"composition":{"C":2.0,"H":4.0,"O":3.0},"names":{"en":"1,2,4-trioxolane"},"descriptions":{"en":"In organic chemistry, a 1,2,4-trioxolane is a hetrocyclic structure consisting of a five-membered ring that has two nonadjacent carbon atoms and three oxygen atoms. These structures are formed by cycloaddition a carbonyl oxide (the Criegee intermediate) and a carbonyl, such as during ozonolysis of alkenes or the Griesbaum coozonolysis of O-methyl oximes. They are sometimes called ozonides or secondary ozonides in the context of alkene-ozonolysis."},"fame":1,"pubchemCid":78967,"mass":76.05,"charge":0,"smiles":"C1OCOO1","inchikey":"RZYIPLSVRHWROD-UHFFFAOYSA-N","iupac":"1,2,4-trioxolane","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"78967","atoms":9,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":1.229,"y":0.001,"z":0.0,"el":"O"},{"x":-0.972,"y":0.705,"z":0.18,"el":"O"},{"x":-0.97,"y":-0.707,"z":-0.181,"el":"O"},{"x":0.355,"y":1.116,"z":-0.114,"el":"C"},{"x":0.357,"y":-1.115,"z":0.115,"el":"C"},{"x":0.665,"y":1.896,"z":0.587,"el":"H"},{"x":0.398,"y":1.506,"z":-1.135,"el":"H"},{"x":0.668,"y":-1.895,"z":-0.585,"el":"H"},{"x":0.4,"y":-1.504,"z":1.137,"el":"H"}],"bonds":[[0,3,1],[0,4,1],[1,2,1],[1,3,1],[2,4,1],[3,5,1],[3,6,1],[4,7,1],[4,8,1]]},"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q83053818","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/1%2C2%2C4-Trioxolane","license":"CC BY-SA 4.0"},{"role":"properties","name":"PubChem","url":"https://pubchem.ncbi.nlm.nih.gov/compound/78967","license":"PubChem (NIH), public data"},{"role":"structure","name":"PubChem 3D","url":"https://pubchem.ncbi.nlm.nih.
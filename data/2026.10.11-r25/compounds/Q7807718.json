{"version":"2026.10.11-r25","id":"Q7807718","formula":"Ag·Cu·Sn","hill":"AgCuSn","elements":["Cu","Ag","Sn"],"composition":{"Ag":1.0,"Cu":1.0,"Sn":1.0},"names":{"en":"Tin-silver-copper"},"descriptions":{"en":"Tin-silver-copper (Sn-Ag-Cu, also known as SAC), is a lead-free (Pb-free) alloy commonly used for electronic solder. It is the main choice for lead-free surface-mount technology (SMT) assembly in the industry, as it is near eutectic, with adequate thermal fatigue properties, strength, and wettability. Lead-free solder has gained attention as the environmental effects of lead in industrial products have been recognized, and as a result of Europe's RoHS legislation to remove lead and other hazardous materials from electronics."},"fame":1,"pubchemCid":null,"mass":null,"charge":0,"smiles":null,"inchikey":null,"iupac":null,"classes":[{"qid":"Q119892838","names":{"en":"type of mixture of chemical entities","ru":"тип смеси химических соединений"}}],"structureInfo":null,"structure":null,"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q7807718","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Tin-silver-copper","license":"CC BY-SA 4.0"}],"similar":[{"id":"Q3962443","formula":"PdCu","names":{"en":"Skaergaardite"},"elements":["Cu","Pd"],"fame":5,"kind":"crystal"},{"id":"Q20993634","formula":"PtCu","names":{"ru":"Платинамедь"},"elements":["Cu","Pt"],"fame":1,"kind":"crystal"},{"id":"Q413539","formula":"Pd₂CuSn","names":{"en":"Cabriite"},"elements":["Cu","Pd","Sn"],"fame":8,"kind":"crystal"},{"id":"Q15627972","formula":"CdAs₂","names":{"ru":"Диарсенид кадмия"},"elements":["As","Cd"],"fame":1,"kind":"crystal"},{"id":"Q1427612","formula":"Cu·Pb·Sn","names":{"en":"Potin","ru":"Потин","uk":"Потін (сплав)"},"elements":["Cu","Sn","Pb"],"fame":8,"kind":null},{"id":"Q18649573","formula":"PdPb₂","names":{"en":"Diplumbic palladium","ru":"Палладийдисвинец"},"elements":["Pd","Pb"],"fame":1,"kind
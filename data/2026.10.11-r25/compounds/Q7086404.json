{"version":"2026.10.11-r25","id":"Q7086404","formula":"C₂₀H₃₉NO₂","hill":"C20H39NO2","elements":["H","C","N","O"],"composition":{"C":20.0,"H":39.0,"N":1.0,"O":2.0},"names":{"en":"Oleic monoethanolamide"},"descriptions":{"en":"Oleoylethanolamide (OEA) is an endogenous peroxisome proliferator-activated receptor alpha (PPAR-α) agonist. It is a naturally occurring ethanolamide lipid that regulates feeding and body weight in vertebrates ranging from mice to pythons. OEA is a shorter, monounsaturated analogue of the endocannabinoid anandamide, but unlike anandamide it acts independently of the cannabinoid pathway, regulating PPAR-α activity to stimulate lipolysis."},"fame":7,"pubchemCid":5283454,"mass":325.5,"charge":0,"smiles":"CCCCCCCC/C=C\\CCCCCCCC(=O)NCCO","inchikey":"BOWVQLFMWHZBEF-KTKRTIGZSA-N","iupac":"(Z)-N-(2-hydroxyethyl)octadec-9-enamide","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"rdkit","ref":"5283454","atoms":62,"license":"Computed with RDKit from SMILES (PubChem, Wikidata)"},"structure":{"kind":"molecule","atoms":[{"x":-9.716,"y":1.086,"z":0.298,"el":"C"},{"x":-8.334,"y":0.669,"z":0.779,"el":"C"},{"x":-7.856,"y":-0.597,"z":0.067,"el":"C"},{"x":-6.521,"y":-1.128,"z":0.599,"el":"C"},{"x":-5.33,"y":-0.168,"z":0.509,"el":"C"},{"x":-4.998,"y":0.258,"z":-0.923,"el":"C"},{"x":-3.805,"y":1.218,"z":-1.012,"el":"C"},{"x":-2.463,"y":0.667,"z":-0.52,"el":"C"},{"x":-2.012,"y":-0.559,"z":-1.265,"el":"C"},{"x":-1.076,"y":-0.622,"z":-2.226,"el":"C"},{"x":-0.311,"y":0.528,"z":-2.819,"el":"C"},{"x":1.119,"y":0.645,"z":-2.281,"el":"C"},{"x":2.006,"y":-0.546,"z":-2.659,"el":"C"},{"x":3.478,"y":-0.347,"z":-2.284,"el":"C"},{"x":3.716,"y":-0.282,"z":-0.774,"el":"C"},{"x":5.209,"y":-0.197,"z":-0.451,"el":"C"},{"x":5.449,"y":-0.13,"z":1.056,"el":"C"},{"x":6.924,"y":-0.043,"z":1.399,"el":"C"},{"x":7.824,"y":-0.034,"z":0.566,"el":"O"},{"x":7.16,"y":0.
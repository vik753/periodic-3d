{"version":"2026.10.11-r25","id":"Q4750293","formula":"C₁₂H₁₄N₄O₅S","hill":"C12H14N4O5S","elements":["H","C","N","O","S"],"composition":{"C":12.0,"H":14.0,"N":4.0,"O":5.0,"S":1.0},"names":{"en":"RG7795"},"descriptions":{"en":"RG7795 (previously ANA773) is an antiviral drug candidate that as of 2015 had been in Phase II trials in hepatitis B. It is an orally-available prodrug of isatoribine, that was under development by Anadys Pharmaceuticals when it was acquired by Roche in 2011. Its active metabolite is an agonist of TLR7; activation of TLR7 causes secretion of endogenous type 1 interferons, which have antiviral activity. As of 2021, development of RG7795 appears to be discontinued."},"fame":1,"pubchemCid":11587892,"mass":326.33,"charge":0,"smiles":"CC(=O)O[C@@H]1C[C@H](O[C@H]1N2C3=NC(=NC=C3SC2=O)N)CO","inchikey":"HOOMGTNENMZAFP-NYNCVSEMSA-N","iupac":"[(2R,3R,5S)-2-(5-amino-2-oxo-[1,3]thiazolo[4,5-d]pyrimidin-3-yl)-5-(hydroxymethyl)oxolan-3-yl] acetate","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"11587892","atoms":36,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":1.47,"y":2.746,"z":1.312,"el":"S"},{"x":-1.756,"y":1.042,"z":-1.311,"el":"O"},{"x":-0.738,"y":-2.103,"z":0.026,"el":"O"},{"x":-3.856,"y":2.664,"z":-0.389,"el":"O"},{"x":-1.118,"y":2.646,"z":0.774,"el":"O"},{"x":-2.353,"y":-3.043,"z":1.383,"el":"O"},{"x":0.25,"y":0.945,"z":-0.116,"el":"N"},{"x":2.102,"y":-0.514,"z":-0.757,"el":"N"},{"x":4.299,"y":0.102,"z":0.054,"el":"N"},{"x":3.99,"y":-1.806,"z":-1.281,"el":"N"},{"x":-1.41,"y":-0.859,"z":0.071,"el":"C"},{"x":-0.731,"y":0.167,"z":-0.819,"el":"C"},{"x":-2.79,"y":-0.94,"z":-0.54,"el":"C"},{"x":-3.042,"y":0.491,"z":-0.979,"el":"C"},{"x":-3.67,"y":1.35,"z":0.111,"el":"C"},{"x":1.618,"y":0.567,"z":-0.12,"el":"C"},{"x":-0.035,"y":2.104,"z":0.609,"el":"C"},{"x":2.406,"y":1.438,
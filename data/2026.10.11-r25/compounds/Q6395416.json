{"version":"2026.10.11-r25","id":"Q6395416","formula":"C₁₉H₂₂N₂O","hill":"C19H22N2O","elements":["H","C","N","O"],"composition":{"C":19.0,"H":22.0,"N":2.0,"O":1.0},"names":{"en":"Ketipramine"},"descriptions":{"en":"Ketipramine (G-35,259), also known as ketimipramine or ketoimipramine, is a tricyclic antidepressant (TCA) that was tested in clinical trials for the treatment of depression in the 1960s but was never marketed. It differs from imipramine in terms of chemical structure only by a single ketone group, and is approximately equivalent in effectiveness as an antidepressant in comparison. It was one of the drugs tested by Roland Kuhn in a series of unethical experiments testing drugs on children without informed consent that were done in a psychiatric hospital located in Münsterlingen, Switzerland."},"fame":5,"pubchemCid":28424,"mass":294.4,"charge":0,"smiles":"CN(C)CCCN1C2=CC=CC=C2CC(=O)C3=CC=CC=C31","inchikey":"PXHIRIWYXDUSMR-UHFFFAOYSA-N","iupac":"11-[3-(dimethylamino)propyl]-6H-benzo[b][1]benzazepin-5-one","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"28424","atoms":44,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":2.286,"y":2.378,"z":-1.522,"el":"O"},{"x":0.062,"y":-0.342,"z":0.797,"el":"N"},{"x":-2.716,"y":-1.853,"z":-0.8,"el":"N"},{"x":-0.657,"y":-1.486,"z":1.38,"el":"C"},{"x":-0.7,"y":-2.655,"z":0.396,"el":"C"},{"x":-0.712,"y":0.849,"z":0.737,"el":"C"},{"x":1.44,"y":-0.52,"z":0.485,"el":"C"},{"x":-0.698,"y":1.68,"z":-0.397,"el":"C"},{"x":-1.347,"y":-2.33,"z":-0.954,"el":"C"},{"x":0.152,"y":1.318,"z":-1.573,"el":"C"},{"x":2.185,"y":0.314,"z":-0.382,"el":"C"},{"x":1.599,"y":1.417,"z":-1.187,"el":"C"},{"x":-1.531,"y":1.233,"z":1.82,"el":"C"},{"x":2.172,"y":-1.558,"z":1.118,"el":"C"},{"x":-1.478,"y":2.848,"z":-0.435,"el":"C"},{"x":3.567,"y":0.112,"z":-0.582,"el":"C"},{"x":-2
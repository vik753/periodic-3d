{"version":"2026.10.11-r25","id":"Q15405282","formula":"C₁₁H₁₃BrN₂O","hill":"C11H13BrN2O","elements":["H","C","N","O","Br"],"composition":{"C":11.0,"H":13.0,"N":2.0,"O":1.0,"Br":1.0},"names":{"en":"3-Bromocytisine"},"descriptions":{"en":"3-Bromocytisine is a derivative of the toxic alkaloid cytisine that acts as a highly potent agonist at neural nicotinic acetylcholine receptors, binding primarily to the α4β2 and α7 subtypes. 3-Bromocytisine is a full agonist at the α7 subtype while it is only a partial agonist at α4β2, but has an extremely strong binding affinity at α4β2 with 200-fold selectivity for α4β2 over α7. In animal studies 3-bromocytisine stimulates the release of dopamine and noradrenaline and increases locomotor activity."},"fame":3,"pubchemCid":15519735,"mass":269.14,"charge":0,"smiles":"C1[C@H]2CNC[C@@H]1C3=CC=C(C(=O)N3C2)Br","inchikey":"DWDCLEHDNICBMI-JGVFFNPUSA-N","iupac":"(1R,9S)-5-bromo-7,11-diazatricyclo[7.3.1.02,7]trideca-2,4-dien-6-one","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"15519735","atoms":28,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":4.419,"y":0.169,"z":0.444,"el":"Br"},{"x":2.011,"y":2.029,"z":0.108,"el":"O"},{"x":0.299,"y":0.482,"z":-0.229,"el":"N"},{"x":-2.278,"y":-0.134,"z":1.57,"el":"N"},{"x":-2.146,"y":1.177,"z":-0.564,"el":"C"},{"x":-1.546,"y":-1.197,"z":-0.57,"el":"C"},{"x":-2.243,"y":-0.106,"z":-1.378,"el":"C"},{"x":-0.668,"y":1.571,"z":-0.435,"el":"C"},{"x":-2.828,"y":0.985,"z":0.805,"el":"C"},{"x":-2.263,"y":-1.371,"z":0.786,"el":"C"},{"x":-0.083,"y":-0.856,"z":-0.357,"el":"C"},{"x":0.838,"y":-1.831,"z":-0.274,"el":"C"},{"x":1.637,"y":0.86,"z":0.006,"el":"C"},{"x":2.218,"y":-1.521,"z":-0.031,"el":"C"},{"x":2.633,"y":-0.258,"z":0.117,"el":"C"},{"x":-2.674,"y":1.985,"z":-1.086,"el":"H"},{"x":-1.628,"y":-2.14,"z":-1.127,"el":"H"},{"x":-1.7
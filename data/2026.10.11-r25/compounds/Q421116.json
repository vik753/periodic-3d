{"version":"2026.10.11-r25","id":"Q421116","formula":"C₇H₄O₇","hill":"C7H4O7","elements":["H","C","O"],"composition":{"C":7.0,"H":4.0,"O":7.0},"names":{"en":"Meconic acid"},"descriptions":{"en":"Meconic acid, also known as acidum meconicum and poppy acid, is a chemical substance found in certain plants of the poppy family, Papaveraceae, such as Papaver somniferum (opium poppy) and Papaver bracteatum. Meconic acid constitutes about 5% of opium and can be used as an analytical marker for the presence of opium. Meconic acid has erroneously been described as a mild narcotic, but it has little or no physiological activity, and is not used medicinally."},"fame":13,"pubchemCid":10347,"mass":200.1,"charge":0,"smiles":"C1=C(OC(=C(C1=O)O)C(=O)O)C(=O)O","inchikey":"ZEGRKMXCOCRTCS-UHFFFAOYSA-N","iupac":"3-hydroxy-4-oxopyran-2,6-dicarboxylic acid","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"10347","atoms":18,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":0.32,"y":0.886,"z":0.0,"el":"O"},{"x":-2.551,"y":-1.412,"z":-0.001,"el":"O"},{"x":-0.332,"y":-3.107,"z":0.001,"el":"O"},{"x":-1.518,"y":2.619,"z":0.001,"el":"O"},{"x":2.667,"y":1.892,"z":0.0,"el":"O"},{"x":-3.233,"y":1.107,"z":0.0,"el":"O"},{"x":3.743,"y":-0.126,"z":0.0,"el":"O"},{"x":-0.968,"y":0.386,"z":0.0,"el":"C"},{"x":-1.264,"y":-0.924,"z":-0.001,"el":"C"},{"x":1.369,"y":-0.008,"z":-0.001,"el":"C"},{"x":-0.141,"y":-1.897,"z":0.0,"el":"C"},{"x":1.229,"y":-1.338,"z":0.0,"el":"C"},{"x":-2.047,"y":1.378,"z":0.0,"el":"C"},{"x":2.724,"y":0.543,"z":0.0,"el":"C"},{"x":2.058,"y":-2.036,"z":0.0,"el":"H"},{"x":-3.189,"y":-0.682,"z":-0.001,"el":"H"},{"x":-2.21,"y":3.315,"z":0.001,"el":"H"},{"x":3.56,"y":2.298,"z":0.0,"el":"H"}],"bonds":[[0,7,1],[0,9,1],[1,8,1],[1,15,1],[2,10,2],[3,12,1],[3,16,1],[4,13,1],[4,17,1],[5,12,2],[6,13,2],[7,8,2],[7,12,1],[
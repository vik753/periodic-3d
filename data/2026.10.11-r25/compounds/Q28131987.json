{"version":"2026.10.11-r25","id":"Q28131987","formula":"C₂₃H₃₆O₃","hill":"C23H36O3","elements":["H","C","O"],"composition":{"C":23.0,"H":36.0,"O":3.0},"names":{"en":"Methandriol propionate"},"descriptions":{"en":"Methandriol propionate (brand name Metilbisexovis), or methylandrostenediol propionate, also known as 17α-methylandrost-5-ene-3β,17β-diol 3β-propionate, is a synthetic, injected anabolic-androgenic steroid (AAS) and a 17α-alkylated derivative of 5-androstenediol that is or was marketed by Vister in Italy. It is an androgen ester – specifically, the C3,17β propionate ester of methandriol (17α-methyl-5-androstenediol) – and acts as a prodrug of methandriol in the body. Methandriol propionate is administered by intramuscular injection and, relative to methandriol, has an extended duration via this route due to a depot effect afforded by its ester."},"fame":1,"pubchemCid":3085209,"mass":360.5,"charge":0,"smiles":"CCC(=O)O[C@H]1CC[C@@]2([C@H]3CC[C@]4([C@H]([C@@H]3CC=C2C1)CC[C@]4(C)O)C)C","inchikey":"YAZVIHSCBXWIRW-ZGIWMXSJSA-N","iupac":"[(3S,8R,9S,10R,13S,14S,17S)-17-hydroxy-10,13,17-trimethyl-1,2,3,4,7,8,9,11,12,14,15,16-dodecahydrocyclopenta[a]phenanthren-3-yl] propanoate","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"3085209","atoms":62,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-6.145,"y":-1.275,"z":0.284,"el":"O"},{"x":4.872,"y":0.715,"z":0.087,"el":"O"},{"x":5.657,"y":-0.665,"z":-1.587,"el":"O"},{"x":-3.771,"y":-0.629,"z":0.201,"el":"C"},{"x":-3.107,"y":0.649,"z":-0.348,"el":"C"},{"x":-1.704,"y":0.901,"z":0.219,"el":"C"},{"x":-0.789,"y":-0.322,"z":-0.079,"el":"C"},{"x":-5.183,"y":-0.525,"z":-0.454,"el":"C"},{"x":0.659,"y":-0.122,"z":0.525,"el":"C"},{"x":-2.894,"y":-1.82,"z":-0.219,"el":"C"},{"x":-1.452,"y":-1.675,"z":0.298,"el":"C"},{"x":-4.17,"y":1.724,"z":-0.144,"el"
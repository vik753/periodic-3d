{"version":"2026.10.11-r25","id":"Q3502773","formula":"C₄H₄N₂","hill":"C4H4N2","elements":["H","C","N"],"composition":{"C":4.0,"H":4.0,"N":2.0},"names":{"en":"Succinonitrile"},"descriptions":{"en":"Succinonitrile, also butanedinitrile, is a nitrile, with the formula of C2H4(CN)2. It is an odorless, colorless to light brown crystal or colourless waxy solid which melts at 58 °C. Succinonitrile is produced by the addition of hydrogen cyanide to acrylonitrile (hydrocyanation): CH2=CHCN + HCN → NCCH2CH2CN Hydrogenation of succinonitrile yields putrescine (1,4-diaminobutane)."},"fame":12,"pubchemCid":8062,"mass":80.09,"charge":0,"smiles":"C(CC#N)C#N","inchikey":"IAHFWCOBPZCAEA-UHFFFAOYSA-N","iupac":"butanedinitrile","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"8062","atoms":10,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-2.158,"y":-1.0,"z":-0.173,"el":"N"},{"x":2.158,"y":-1.0,"z":0.173,"el":"N"},{"x":-0.653,"y":1.082,"z":0.396,"el":"C"},{"x":0.653,"y":1.082,"z":-0.396,"el":"C"},{"x":-1.494,"y":-0.082,"z":0.077,"el":"C"},{"x":1.494,"y":-0.082,"z":-0.077,"el":"C"},{"x":-0.44,"y":1.093,"z":1.472,"el":"H"},{"x":-1.208,"y":2.001,"z":0.171,"el":"H"},{"x":0.44,"y":1.093,"z":-1.472,"el":"H"},{"x":1.208,"y":2.001,"z":-0.171,"el":"H"}],"bonds":[[0,4,3],[1,5,3],[2,3,1],[2,4,1],[2,6,1],[2,7,1],[3,5,1],[3,8,1],[3,9,1]]},"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q3502773","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Succinonitrile","license":"CC BY-SA 4.0"},{"role":"properties","name":"PubChem","url":"https://pubchem.ncbi.nlm.nih.gov/compound/8062","license":"PubChem (NIH), public data"},{"role":"structure","name":"PubChem 3D","url":"https://pubchem.ncbi.nlm.nih.gov/compound/8062#section=3D-Conform
{"version":"2026.10.11-r25","id":"Q27155186","formula":"C₂₄H₄₀O₅","hill":"C24H40O5","elements":["H","C","O"],"composition":{"C":24.0,"H":40.0,"O":5.0},"names":{"en":"Hyocholic acid"},"descriptions":{"en":"Hyocholic acid or 3α,6α,7α-trihydroxy-5β-cholan-24-oic acid is a bile acid found as one of the main forms in pig, and at low concentrations in other species including humans. Hyocholic acid differs from the primary bile acids found in humans by having a third hydroxyl group in the α-conformation at the 6-position, unlike cholic acid, which has a 12-hydroxyl, and chenodeoxycholic acid which has neither a 6- or 12-hydroxyl. It also differs from the muricholic acids found in rodents, as they are 6β-hydroxylated, and can have the 7-hydroxyl in either the α- or β- positions, forming α- or β-muricholic acids."},"fame":4,"pubchemCid":92805,"mass":408.6,"charge":0,"smiles":"C[C@H](CCC(=O)O)[C@H]1CC[C@@H]2[C@@]1(CC[C@H]3[C@H]2[C@@H]([C@@H]([C@H]4[C@@]3(CC[C@H](C4)O)C)O)O)C","inchikey":"DKPMWHFRUGMUKF-KWXDGCAGSA-N","iupac":"(4R)-4-[(3R,5R,6R,7S,8S,9S,10R,13R,14S,17R)-3,6,7-trihydroxy-10,13-dimethyl-2,3,4,5,6,7,8,9,11,12,14,15,16,17-tetradecahydro-1H-cyclopenta[a]phenanthren-17-yl]pentanoic acid","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"92805","atoms":69,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-1.665,"y":-2.374,"z":0.015,"el":"O"},{"x":-4.066,"y":-2.614,"z":1.407,"el":"O"},{"x":-4.903,"y":-0.752,"z":-3.301,"el":"O"},{"x":6.486,"y":-1.417,"z":-2.553,"el":"O"},{"x":7.311,"y":-1.09,"z":-0.462,"el":"O"},{"x":-1.119,"y":-0.264,"z":1.091,"el":"C"},{"x":0.362,"y":-0.476,"z":0.747,"el":"C"},{"x":1.177,"y":0.835,"z":0.746,"el":"C"},{"x":-1.745,"y":0.703,"z":0.025,"el":"C"},{"x":-3.276,"y":0.974,"z":0.3,"el":"C"},{"x":2.58,"y":0.254,"z":0.441,"el":"C"},{"x":-4.039,"y":-0.394,"z":0.367,"el":
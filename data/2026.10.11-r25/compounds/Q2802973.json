{"version":"2026.10.11-r25","id":"Q2802973","formula":"C₃H₂O₃","hill":"C3H2O3","elements":["H","C","O"],"composition":{"C":3.0,"H":2.0,"O":3.0},"names":{"en":"Vinylene carbonate"},"descriptions":{"en":"Vinylene carbonate (VC) or 1,3-dioxol-2-one, is the simplest unsaturated cyclic carbonic acid ester. Vinylene carbonate can also be thought of as the cyclic carbonate of the hypothetical (Z)-ethene-1,2-diol. The activated double bond in this five-membered oxygen-containing heterocycle makes the molecule a reactive monomer for homopolymerization and copolymerization and a dienophile in Diels-Alder reactions."},"fame":7,"pubchemCid":13385,"mass":86.05,"charge":0,"smiles":"C1=COC(=O)O1","inchikey":"VAYTZRYEBVHVLE-UHFFFAOYSA-N","iupac":"1,3-dioxol-2-one","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"13385","atoms":8,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":0.034,"y":-1.171,"z":0.0,"el":"O"},{"x":0.034,"y":1.171,"z":0.0,"el":"O"},{"x":-1.942,"y":0.0,"z":0.0,"el":"O"},{"x":1.295,"y":-0.654,"z":0.0,"el":"C"},{"x":1.295,"y":0.654,"z":0.0,"el":"C"},{"x":-0.716,"y":0.0,"z":0.0,"el":"C"},{"x":2.111,"y":-1.35,"z":0.0,"el":"H"},{"x":2.112,"y":1.349,"z":0.0,"el":"H"}],"bonds":[[0,3,1],[0,5,1],[1,4,1],[1,5,1],[2,5,2],[3,4,2],[3,6,1],[4,7,1]]},"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q2802973","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Vinylene_carbonate","license":"CC BY-SA 4.0"},{"role":"properties","name":"PubChem","url":"https://pubchem.ncbi.nlm.nih.gov/compound/13385","license":"PubChem (NIH), public data"},{"role":"structure","name":"PubChem 3D","url":"https://pubchem.ncbi.nlm.nih.gov/compound/13385#section=3D-Conformer","license":"PubChem (NIH), public data"}],"similar":[{"id":"Q28232
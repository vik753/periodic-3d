{"version":"2026.10.11-r25","id":"Q24886653","formula":"C₆H₅ClO₃","hill":"C6H5ClO3","elements":["H","C","O","Cl"],"composition":{"C":6.0,"H":5.0,"O":3.0,"Cl":1.0},"names":{"en":"Perchlorylbenzene"},"descriptions":{"en":"Perchlorylbenzene (C6H5ClO3, PhClO3), is an aromatic compound prepared by direct electrophilic perchlorylation of benzene using perchloryl fluoride and aluminum trichloride: The compound is described as a somewhat shock-sensitive oily liquid. It exhibits low chemical reactivity and is inert towards acidic (HCl (aq.)) or reducing (LiAlH4, H2/Pd) conditions. However, it undergoes hydrolysis upon reflux in aqueous KOH to afford phenol, and undergoes aromatic nitration to afford the meta-nitration product, as expected for a strongly –I, –M substituent."},"fame":4,"pubchemCid":21559072,"mass":160.55,"charge":0,"smiles":"C1=CC=C(C=C1)Cl(=O)(=O)=O","inchikey":"XUEMDHFELUYLBX-UHFFFAOYSA-N","iupac":"perchlorylbenzene","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":null,"structure":null,"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q24886653","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Perchlorylbenzene","license":"CC BY-SA 4.0"},{"role":"properties","name":"PubChem","url":"https://pubchem.ncbi.nlm.nih.gov/compound/21559072","license":"PubChem (NIH), public data"}],"similar":[{"id":"Q1675010","formula":"C₁₄H₁₃BrClNO₇","names":{"en":"X-Gluc","uk":"X-Gluc"},"elements":["H","C","N","O","Cl","Br"],"fame":6,"kind":"molecule"},{"id":"Q21098848","formula":"C₂₅H₂₂Cl₂O₁₂","names":{"en":"Sch 202596"},"elements":["H","C","O","Cl"],"fame":1,"kind":"molecule"},{"id":"Q274515","formula":"C₁₁H₁₂Cl₂N₂O₅","names":{"en":"Chloramphenicol","ru":"Хлорамфеникол","uk":"Хлорамфенікол"},"elements":["H","C","N","O","Cl"],"fame":54,"kind":"molecule"},{"id":"Q209222","formula":"C₈H₆Cl₂O₃",
{"version":"2026.10.11-r25","id":"Q1067912","formula":"Fe₂(SO₄)₃·11H₂O","hill":"Fe2H22O23S3","elements":["H","O","S","Fe"],"composition":{"H":22.0,"O":23.0,"S":3.0,"Fe":2.0},"names":{"en":"Quenstedtite"},"descriptions":{"en":"Quenstedtite is an uncommon iron sulfate mineral with chemical formula Fe2(SO4)3·11H2O. It forms violet or white triclinic crystals. Found in oxidized zones of pyrite-rich orebodies, especially in arid climates. It was first reported in 1888 for an occurrence in Tierra Amarilla, Copiapó Province, Atacama Region, Chile and named by G. Linck in 1889 for the German mineralogist F. A. von Quenstedt (1809–1889)."},"fame":11,"pubchemCid":null,"mass":null,"charge":0,"smiles":null,"inchikey":null,"iupac":null,"classes":[{"qid":"Q12089225","names":{"en":"mineral species","ru":"действительный вид минералов","uk":"мінеральний вид"}}],"structureInfo":null,"structure":null,"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q1067912","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Quenstedtite","license":"CC BY-SA 4.0"},{"role":"photo","name":"Wikimedia Commons","url":"https://commons.wikimedia.org/wiki/File:Quenstedtite.jpg","license":"CC BY-SA 4.0"}],"similar":[{"id":"Q651700","formula":"Fe₅H₄₂S₆O₄₆","names":{"en":"Copiapite","uk":"Копіапіт"},"elements":["H","O","S","Fe"],"fame":18,"kind":null},{"id":"Q417192","formula":"MgFe(SO₄)₂(OH)·7H₂O","names":{"en":"Botryogen","uk":"Ботріоген"},"elements":["H","O","Mg","S","Fe"],"fame":13,"kind":null},{"id":"Q3942089","formula":"FeSO₄*4H₂O","names":{"en":"Rozenite","uk":"Розеніт"},"elements":["H","O","S","Fe"],"fame":11,"kind":"crystal"},{"id":"Q3162933","formula":"Fe₂H₁₆S₂O₁₇","names":{"en":"Hohmannite","uk":"Гогманіт"},"elements":["H","O","S","Fe"],"fame":7,"kind":null},{"id":"Q4024462","formula":"ZnFe₄(SO₄)₆(OH)₂*18H₂O","names":{"en":"Zincocopiapite","uk":"Цинкокопіапіт"},"elements":["H","O","S","Fe","Zn"],"fame":5,"kind":nu
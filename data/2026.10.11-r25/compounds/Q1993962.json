{"version":"2026.10.11-r25","id":"Q1993962","formula":"C₂₁H₁₆N₄O₈S₂","hill":"C21H16N4O8S2","elements":["H","C","N","O","S"],"composition":{"C":21.0,"H":16.0,"N":4.0,"O":8.0,"S":2.0},"names":{"en":"Nitrocefin"},"descriptions":{"en":"Nitrocefin is a chromogenic cephalosporin substrate routinely used to detect the presence of beta-lactamase enzymes produced by various microbes. Beta-lactamase mediated resistance to beta-lactam antibiotics such as penicillin is a widespread mechanism of resistance for a number of bacteria including members of the family Enterobacteriaceae, a major group of enteric Gram-negative bacteria. Other methods for beta-lactamase detection exist including PCR; however, nitrocefin allows for rapid beta-lactamase detection using few materials and inexpensive equipment."},"fame":5,"pubchemCid":6436140,"mass":516.5,"charge":0,"smiles":"C1C(=C(N2[C@H](S1)[C@@H](C2=O)NC(=O)CC3=CC=CS3)C(=O)O)/C=C/C4=C(C=C(C=C4)[N+](=O)[O-])[N+](=O)[O-]","inchikey":"LHNIIDJCEODSHA-OQRUQETBSA-N","iupac":"(6R,7R)-3-[(E)-2-(2,4-dinitrophenyl)ethenyl]-8-oxo-7-[(2-thiophen-2-ylacetyl)amino]-5-thia-1-azabicyclo[4.2.0]oct-2-ene-2-carboxylic acid","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"6436140","atoms":51,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-2.61,"y":-0.688,"z":0.998,"el":"S"},{"x":-6.232,"y":-2.562,"z":-1.42,"el":"S"},{"x":-2.581,"y":3.148,"z":-1.63,"el":"O"},{"x":0.506,"y":3.086,"z":-0.974,"el":"O"},{"x":-6.355,"y":1.338,"z":1.275,"el":"O"},{"x":0.759,"y":1.325,"z":-2.41,"el":"O"},{"x":4.645,"y":2.152,"z":1.939,"el":"O"},{"x":4.153,"y":0.323,"z":3.049,"el":"O"},{"x":8.043,"y":-2.254,"z":-1.647,"el":"O"},{"x":8.644,"y":-1.28,"z":0.226,"el":"O"},{"x":-1.71,"y":1.531,"z":-0.149,"el":"N"},{"x":-4.734,"y":1.057,"z":-0.362,"el":"N"},{"x":4.524,"y":0.907,"z":2.004,"el":"N"},{"x":7.7
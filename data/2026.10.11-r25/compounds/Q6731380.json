{"version":"2026.10.11-r25","id":"Q6731380","formula":"C₂H₂MgO₆","hill":"C2H2MgO6","elements":["H","C","O","Mg"],"composition":{"C":2.0,"H":2.0,"O":6.0,"Mg":1.0},"names":{"en":"Magnesium bicarbonate","ru":"Гидрокарбонат магния"},"descriptions":{"en":"Magnesium bicarbonate or magnesium hydrogencarbonate, Mg(HCO3)2, is the bicarbonate salt of magnesium. It can be formed through the reaction of dilute solutions of carbonic acid (such as seltzer water) and magnesium hydroxide (milk of magnesia). It can be prepared through the synthesis of magnesium acetate and sodium bicarbonate: Mg(CH3COO)2 + 2 NaHCO3 → Mg(HCO3)2 + 2 CH3COONa Magnesium bicarbonate exists only in aqueous solution.","ru":"Гидрокарбона́т ма́гния — неорганическое соединение, кислая соль магния и угольной кислоты с формулой Mg(HCO3)2, существует только в водных растворах."},"fame":15,"pubchemCid":102204,"mass":146.34,"charge":0,"smiles":"C(=O)(O)[O-].C(=O)(O)[O-].[Mg+2]","inchikey":"QWDJLDTYWNBUKE-UHFFFAOYSA-L","iupac":"magnesium hydrogen carbonate","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"rdkit","ref":"102204","atoms":11,"license":"Computed with RDKit from SMILES (PubChem, Wikidata)"},"structure":{"kind":"molecule","atoms":[{"x":-0.393,"y":-1.716,"z":-0.159,"el":"C"},{"x":-0.2,"y":-0.476,"z":-0.14,"el":"O"},{"x":0.76,"y":-2.366,"z":-0.222,"el":"O"},{"x":-1.445,"y":-2.393,"z":-0.13,"el":"O"},{"x":1.259,"y":-1.524,"z":-0.224,"el":"H"},{"x":0.178,"y":2.557,"z":0.326,"el":"C"},{"x":0.371,"y":3.797,"z":0.345,"el":"O"},{"x":1.331,"y":1.907,"z":0.263,"el":"O"},{"x":-0.874,"y":1.88,"z":0.355,"el":"O"},{"x":1.83,"y":2.749,"z":0.261,"el":"H"},{"x":-2.817,"y":-4.411,"z":-0.677,"el":"Mg"}],"bonds":[[0,1,2.0],[0,2,1.0],[0,3,1.0],[2,4,1.0],[5,6,2.0],[5,7,1.0],[5,8,1.0],[7,9,1.0]]},"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q6731380","license":
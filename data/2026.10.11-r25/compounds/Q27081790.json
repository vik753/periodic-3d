{"version":"2026.10.11-r25","id":"Q27081790","formula":"C₂₀H₂₅N₃O","hill":"C20H25N3O","elements":["H","C","N","O"],"composition":{"C":20.0,"H":25.0,"N":3.0,"O":1.0},"names":{"en":"Isolysergic acid diethylamide"},"descriptions":{"en":"Iso-LSD, also known as d-iso-LSD, (+)-iso-LSD, or (5R-8S)-LSD, as well as N,N-diethylisolysergamide, is a serotonin receptor modulator of the lysergamide family related to lysergic acid diethylamide (LSD). It is the 8-position epimer of LSD, with iso-LSD being 8α (8S) and LSD being 8β (8R). Iso-LSD is also the N,N-diethyl derivative of isoergine (isolysergic acid amide; iso-LSA), a constituent found in morning glory seeds."},"fame":3,"pubchemCid":638252,"mass":323.4,"charge":0,"smiles":"CCN(CC)C(=O)[C@@H]1CN([C@@H]2CC3=CNC4=CC=CC(=C34)C2=C1)C","inchikey":"VAYOSLLFUXYJDT-KBXCAEBGSA-N","iupac":"(6aR,9S)-N,N-diethyl-7-methyl-6,6a,8,9-tetrahydro-4H-indolo[4,3-fg]quinoline-9-carboxamide","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"638252","atoms":49,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":1.994,"y":0.129,"z":-1.556,"el":"O"},{"x":0.766,"y":-1.844,"z":0.759,"el":"N"},{"x":-4.909,"y":-0.66,"z":-0.776,"el":"N"},{"x":4.002,"y":0.469,"z":-0.437,"el":"N"},{"x":-0.596,"y":-1.246,"z":0.798,"el":"C"},{"x":-0.604,"y":0.286,"z":0.514,"el":"C"},{"x":-1.544,"y":-2.055,"z":-0.164,"el":"C"},{"x":1.866,"y":0.385,"z":0.789,"el":"C"},{"x":1.752,"y":-0.994,"z":1.446,"el":"C"},{"x":-2.837,"y":-1.347,"z":-0.359,"el":"C"},{"x":-1.913,"y":0.932,"z":0.27,"el":"C"},{"x":-2.914,"y":0.044,"z":-0.14,"el":"C"},{"x":0.536,"y":0.997,"z":0.483,"el":"C"},{"x":-4.206,"y":0.466,"z":-0.406,"el":"C"},{"x":0.801,"y":-3.191,"z":1.339,"el":"C"},{"x":2.618,"y":0.315,"z":-0.507,"el":"C"},{"x":-4.086,"y":-1.765,"z":-0.753,"el":"C"},{"x":-2.269,"y":2.28,"z":0.403,"el":"C"},{"x":-4.577,"y":1.8
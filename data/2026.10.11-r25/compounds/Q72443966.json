{"version":"2026.10.11-r25","id":"Q72443966","formula":"C₄H₆NO₄·K","hill":"C4H6KNO4","elements":["H","C","N","O","K"],"composition":{"C":4.0,"H":6.0,"K":1.0,"N":1.0,"O":4.0},"names":{"en":"L-aspartic acid potassium salt"},"descriptions":{"en":"Potassium aspartate is a potassium salt of L-aspartic acid, an amino acid, with the chemical formula KO2CCH(NH2)CH2CO2H·H2O. The compound is used as a dietary supplement to treat low potassium levels (hypokalemia) and high blood ammonia (hyperammonemia), and is under investigation as an adjunctive treatment for hypertension. Potassium aspartate is also employed in cosmetics as a buffering agent. Potassium aspartate is also used in research settings for electrophysiological studies, as a chloride substitute in patch-clamp pipette solutions."},"fame":3,"pubchemCid":6454950,"mass":209.28,"charge":0,"smiles":"C([C@@H](C(=O)[O-])N)C(=O)[O-].[K+].[K+]","inchikey":"IKALZAKZWHFNIC-JIZZDEOASA-L","iupac":"dipotassium;(2S)-2-aminobutanedioate","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":null,"structure":null,"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q72443966","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Potassium_aspartate","license":"CC BY-SA 4.0"},{"role":"properties","name":"PubChem","url":"https://pubchem.ncbi.nlm.nih.gov/compound/6454950","license":"PubChem (NIH), public data"}],"similar":[{"id":"Q4210039","formula":"C₁₂H₁₇K₂MgN₃O₁₂","names":{"en":"Magnesium potassium aspartate","ru":"Калия и магния аспарагинат"},"elements":["H","C","N","O","Mg","K"],"fame":1,"kind":"molecule"},{"id":"Q3029787","formula":"C₅H₈KNO₄","names":{"en":"Monopotassium L-glutamate","ru":"Глутамат калия"},"elements":["H","C","N","O","K"],"fame":17,"kind":"molecule"},{"id":"Q931445","formula":"C₆H₈K₂O₄","names":{"en":"Potassium adipate"},"elements":["H","
{"version":"2026.10.11-r25","id":"Q410435","formula":"C₁₇H₁₂Br₂O₃","hill":"C17H12Br2O3","elements":["H","C","O","Br"],"composition":{"C":17.0,"H":12.0,"O":3.0,"Br":2.0},"names":{"en":"Benzbromarone"},"descriptions":{"en":"Benzbromarone is a uricosuric agent and weak non-competitive inhibitor of xanthine oxidase used in the treatment of gout. It is a brominated analogue of the withdrawn uricosurics benziodarone and benzarone, and is structurally related to the antiarrhythmic amiodarone. Benzbromarone was withdrawn from most European countries in 2003 due to the risk of idiosyncratic hepatotoxicity, but remains heavily used in Asia and South America."},"fame":14,"pubchemCid":2333,"mass":424.1,"charge":0,"smiles":"CCC1=C(C2=CC=CC=C2O1)C(=O)C3=CC(=C(C(=C3)Br)O)Br","inchikey":"WHQCHUCQKNIQEC-UHFFFAOYSA-N","iupac":"(3,5-dibromo-4-hydroxyphenyl)-(2-ethyl-1-benzofuran-3-yl)methanone","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"2333","atoms":34,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":3.951,"y":-0.488,"z":2.759,"el":"Br"},{"x":3.744,"y":0.149,"z":-2.945,"el":"Br"},{"x":-3.585,"y":-0.025,"z":0.191,"el":"O"},{"x":-0.355,"y":2.71,"z":0.369,"el":"O"},{"x":4.916,"y":-0.595,"z":-0.179,"el":"O"},{"x":-1.428,"y":0.615,"z":0.185,"el":"C"},{"x":-1.468,"y":-0.796,"z":0.029,"el":"C"},{"x":-2.736,"y":1.031,"z":0.279,"el":"C"},{"x":-2.816,"y":-1.14,"z":0.039,"el":"C"},{"x":-3.366,"y":2.349,"z":0.451,"el":"C"},{"x":-0.281,"y":1.474,"z":0.24,"el":"C"},{"x":-0.515,"y":-1.819,"z":-0.12,"el":"C"},{"x":1.104,"y":0.922,"z":0.128,"el":"C"},{"x":-3.29,"y":-2.444,"z":-0.09,"el":"C"},{"x":-3.673,"y":3.044,"z":-0.883,"el":"C"},{"x":-0.962,"y":-3.141,"z":-0.251,"el":"C"},{"x":-2.326,"y":-3.445,"z":-0.236,"el":"C"},{"x":1.669,"y":0.814,"z":-1.12,"el":"C"},{"x":1.756,"y":0.546,"z":1.279,"el":"C"},{"x":3.048,"y":
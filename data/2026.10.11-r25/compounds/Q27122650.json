{"version":"2026.10.11-r25","id":"Q27122650","formula":"C₇H₅NO","hill":"C7H5NO","elements":["H","C","N","O"],"composition":{"C":7.0,"H":5.0,"N":1.0,"O":1.0},"names":{"en":"2,1-benzisoxazole"},"descriptions":{"en":"Anthranil (2,1-benzisoxazole) is an organic compound with a molecular formula C7H5NO, which features a fused benzene-isoxazole bicyclic ring structure. It is an isomer of the more common compounds benzoxazole and benzisoxazole, which have their oxygen atoms located in the 1-position. The locations of the heteroatoms in anthranil results in disrupted aromaticity, making it by far the least stable of the 3 structural isomers."},"fame":9,"pubchemCid":67498,"mass":119.12,"charge":0,"smiles":"C1=CC2=CON=C2C=C1","inchikey":"FZKCAHQKNJXICB-UHFFFAOYSA-N","iupac":"2,1-benzoxazole","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"67498","atoms":14,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-2.333,"y":0.041,"z":0.0,"el":"O"},{"x":-1.575,"y":-1.122,"z":0.0,"el":"N"},{"x":-0.229,"y":0.699,"z":0.0,"el":"C"},{"x":-0.285,"y":-0.74,"z":0.0,"el":"C"},{"x":0.904,"y":1.5,"z":0.0,"el":"C"},{"x":0.896,"y":-1.503,"z":0.0,"el":"C"},{"x":-1.52,"y":1.131,"z":0.0,"el":"C"},{"x":2.072,"y":0.713,"z":0.0,"el":"C"},{"x":2.071,"y":-0.719,"z":0.0,"el":"C"},{"x":0.917,"y":2.581,"z":0.0,"el":"H"},{"x":0.917,"y":-2.585,"z":0.0,"el":"H"},{"x":-2.014,"y":2.091,"z":0.0,"el":"H"},{"x":3.036,"y":1.22,"z":0.0,"el":"H"},{"x":3.033,"y":-1.23,"z":0.0,"el":"H"}],"bonds":[[0,1,1],[0,6,1],[1,3,2],[2,3,1],[2,4,1],[2,6,2],[3,5,1],[4,7,2],[4,9,1],[5,8,2],[5,10,1],[6,11,1],[7,8,1],[7,12,1],[8,13,1]]},"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q27122650","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Anthranil","license":"CC B
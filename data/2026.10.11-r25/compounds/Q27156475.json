{"version":"2026.10.11-r25","id":"Q27156475","formula":"C₁₉H₂₀N₂O₄S","hill":"C19H20N2O4S","elements":["H","C","N","O","S"],"composition":{"C":19.0,"H":20.0,"N":2.0,"O":4.0,"S":1.0},"names":{"en":"Hydroxypioglitazone"},"descriptions":{"en":"Leriglitazone is a PPAR-gamma agonist and metabolite of the glitazone pioglitazone. It is an active metabolite of pioglitazone, and a selective peroxisome proliferator-activated receptor gamma (PPARγ) agonist that crosses the blood-brain barrier (BBB). Lerigltazone has been reported to have an antioxidant and neuroprotective activity in the central nervous system by modulating critical pathways involved in cerebral adrenoleukodystrophy progression and consequently decreasing neuroinflammation, enhancing BBB integrity, promoting myelination and improving mitochondrial function."},"fame":1,"pubchemCid":4147757,"mass":372.4,"charge":0,"smiles":"CC(C1=CN=C(C=C1)CCOC2=CC=C(C=C2)CC3C(=O)NC(=O)S3)O","inchikey":"OXVFDZYQLGRLCD-UHFFFAOYSA-N","iupac":"5-[[4-[2-[5-(1-hydroxyethyl)-2-pyridinyl]ethoxy]phenyl]methyl]-1,3-thiazolidine-2,4-dione","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"4147757","atoms":46,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-3.672,"y":-1.708,"z":-0.461,"el":"S"},{"x":1.567,"y":2.577,"z":-0.623,"el":"O"},{"x":-6.146,"y":0.568,"z":1.434,"el":"O"},{"x":5.946,"y":-3.313,"z":0.214,"el":"O"},{"x":-5.56,"y":-3.533,"z":-0.608,"el":"O"},{"x":-6.043,"y":-1.533,"z":0.474,"el":"N"},{"x":4.03,"y":0.729,"z":-0.912,"el":"N"},{"x":-4.076,"y":-0.177,"z":0.432,"el":"C"},{"x":-3.859,"y":1.039,"z":-0.451,"el":"C"},{"x":-2.409,"y":1.45,"z":-0.497,"el":"C"},{"x":-5.525,"y":-0.309,"z":0.843,"el":"C"},{"x":-1.579,"y":0.913,"z":-1.469,"el":"C"},{"x":-1.929,"y":2.359,"z":0.434,"el":"C"},{"x":3.67,"y":2.614,"z":0.564,"el":"C"},{"x":0.258,"y":2.206,"z":-0.5
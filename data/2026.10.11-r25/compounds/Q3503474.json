{"version":"2026.10.11-r25","id":"Q3503474","formula":"C₆H₁₂O₈S","hill":"C6H12O8S","elements":["H","C","O","S"],"composition":{"C":6.0,"H":12.0,"O":8.0,"S":1.0},"names":{"en":"6-sulfoquinovose"},"descriptions":{"en":"Sulfoquinovose, also known as 6-sulfoquinovose and 6-deoxy-6-sulfo-D-glucopyranose, is a monosaccharide sugar that is found as a building block in the sulfolipid sulfoquinovosyl diacylglycerol (SQDG). Sulfoquinovose is a sulfonic acid derivative of glucose, the sulfonic acid group is introduced into the sugar by the enzyme UDP-sulfoquinovose synthase (SQD1). Sulfoquinovose is degraded through a metabolic process termed sulfoglycolysis."},"fame":9,"pubchemCid":10880539,"mass":244.22,"charge":0,"smiles":"C([C@@H]1[C@H]([C@@H]([C@H](C(O1)O)O)O)O)S(=O)(=O)O","inchikey":"QFBWOLBPVQLZEH-GASJEMHNSA-N","iupac":"[(2S,3S,4S,5R)-3,4,5,6-tetrahydroxyoxan-2-yl]methanesulfonic acid","classes":[{"qid":"Q59199015","names":{"en":"group of stereoisomers","ru":"группа стереоизомеров","uk":"група стереоізомерів"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"10880539","atoms":27,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-2.944,"y":0.186,"z":-0.091,"el":"S"},{"x":-0.064,"y":0.863,"z":0.321,"el":"O"},{"x":0.604,"y":-2.688,"z":-0.279,"el":"O"},{"x":3.198,"y":-1.63,"z":0.435,"el":"O"},{"x":3.481,"y":1.142,"z":-0.522,"el":"O"},{"x":1.296,"y":2.759,"z":0.264,"el":"O"},{"x":-4.2,"y":-0.68,"z":0.488,"el":"O"},{"x":-3.024,"y":0.204,"z":-1.542,"el":"O"},{"x":-2.839,"y":1.417,"z":0.674,"el":"O"},{"x":0.821,"y":-1.393,"z":0.276,"el":"C"},{"x":-0.311,"y":-0.46,"z":-0.158,"el":"C"},{"x":2.174,"y":-0.861,"z":-0.198,"el":"C"},{"x":2.347,"y":0.614,"z":0.166,"el":"C"},{"x":1.12,"y":1.433,"z":-0.234,"el":"C"},{"x":-1.658,"y":-0.907,"z":0.402,"el":"C"},{"x":-0.381,"y":-0.434,"z":-1.254,"el":"H"},{"x":0.835,"y":-1.502,"z":1.367,"el":"H"},{"x":2.299,"y":-1.009,"z":-1.278,"el":"H"},{"x":2.554,"y":0.71,"z":1.238,"el":"H"},{"x":1.016,"y":
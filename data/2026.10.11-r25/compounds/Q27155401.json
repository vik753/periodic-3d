{"version":"2026.10.11-r25","id":"Q27155401","formula":"C₁₉H₂₈O₃","hill":"C19H28O3","elements":["H","C","O"],"composition":{"C":19.0,"H":28.0,"O":3.0},"names":{"en":"7α-hydroxydehydroepiandrosterone"},"descriptions":{"en":"7α-Hydroxydehydroepiandrosterone (7α-hydroxy-DHEA; 7α-OH-DHEA), also known as 3β,7α-dihydroxyandrost-5-ene-17-one, is an endogenous, naturally occurring steroid and a major metabolite of dehydroepiandrosterone (DHEA) that is formed by CYP7B1 (steroid 7α-hydroxylase) in tissues such as the prostate gland and by CYP3A4 in the liver. The major metabolic pathway of DHEA outside the liver is via 7-hydroxylation into 7α-OH-DHEA and 7β-OH-DHEA. 7α-OH-DHEA has weak estrogenic activity, selectively activating the estrogen receptor ERβ. In addition, 7α-OH-DHEA may be responsible for the known antiglucocorticoid effects of DHEA."},"fame":3,"pubchemCid":65517,"mass":304.4,"charge":0,"smiles":"C[C@]12CC[C@H]3[C@H]([C@@H]1CCC2=O)[C@@H](C=C4[C@@]3(CC[C@@H](C4)O)C)O","inchikey":"OLPSAOWBSPXZEA-JIEICEMKSA-N","iupac":"(3S,7S,8R,9S,10R,13S,14S)-3,7-dihydroxy-10,13-dimethyl-1,2,3,4,7,8,9,11,12,14,15,16-dodecahydrocyclopenta[a]phenanthren-17-one","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"65517","atoms":50,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":0.132,"y":-2.468,"z":-1.206,"el":"O"},{"x":5.053,"y":1.091,"z":-0.665,"el":"O"},{"x":-5.893,"y":0.027,"z":-0.147,"el":"O"},{"x":-0.151,"y":0.505,"z":-0.337,"el":"C"},{"x":0.636,"y":-0.645,"z":0.369,"el":"C"},{"x":2.088,"y":-0.639,"z":-0.123,"el":"C"},{"x":2.79,"y":0.707,"z":0.141,"el":"C"},{"x":-1.632,"y":0.609,"z":0.216,"el":"C"},{"x":0.609,"y":1.863,"z":-0.348,"el":"C"},{"x":2.097,"y":1.758,"z":-0.719,"el":"C"},{"x":-0.072,"y":-1.994,"z":0.123,"el":"C"},{"x":3.065,"y":-1.678,"z":0.418,"el":"C"},{"x":-2.265,"y":-0.781,"z":0.372,"el"
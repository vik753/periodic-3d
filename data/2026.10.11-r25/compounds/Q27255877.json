{"version":"2026.10.11-r25","id":"Q27255877","formula":"C₂₆H₃₉ClO₃","hill":"C26H39ClO3","elements":["H","C","O","Cl"],"composition":{"C":26.0,"H":39.0,"O":3.0,"Cl":1.0},"names":{"en":"Clostebol capronate"},"descriptions":{"en":"Clostebol caproate (brand name Macrobin-Depot), also known as clostebol hexanoate or chlorotestosterone caproate (JAN), as well as 4-chlorotestosterone 17β-caproate or as 4-chloroandrost-4-en-17β-ol-3-one 17β-caproate, is a synthetic, injected anabolic-androgenic steroid (AAS) and a derivative of testosterone. It is an androgen ester – specifically, the C17β caproate ester of clostebol (4-chlorotestosterone) – and acts as a prodrug of clostebol in the body. Clostebol acetate is administered via intramuscular injection."},"fame":3,"pubchemCid":92135912,"mass":435.0,"charge":0,"smiles":"CCCCCCC(=O)O[C@H]1CC[C@@H]2[C@@]1(CC[C@H]3[C@H]2CCC4=C(C(=O)CC[C@]34C)Cl)C","inchikey":"IADJORLUSZAXTG-ZSGDZNMQSA-N","iupac":"[(8R,9S,10R,13S,14S,17S)-4-chloro-10,13-dimethyl-3-oxo-1,2,6,7,8,9,11,12,14,15,16,17-dodecahydrocyclopenta[a]phenanthren-17-yl] heptanoate","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"rdkit","ref":"92135912","atoms":69,"license":"Computed with RDKit from SMILES (PubChem, Wikidata)"},"structure":{"kind":"molecule","atoms":[{"x":9.793,"y":0.878,"z":0.432,"el":"C"},{"x":8.535,"y":0.991,"z":1.278,"el":"C"},{"x":7.333,"y":0.243,"z":0.693,"el":"C"},{"x":6.825,"y":0.847,"z":-0.619,"el":"C"},{"x":5.627,"y":0.096,"z":-1.208,"el":"C"},{"x":4.364,"y":0.2,"z":-0.355,"el":"C"},{"x":3.171,"y":-0.429,"z":-1.038,"el":"C"},{"x":3.197,"y":-1.035,"z":-2.099,"el":"O"},{"x":2.058,"y":-0.223,"z":-0.277,"el":"O"},{"x":0.846,"y":-0.776,"z":-0.795,"el":"C"},{"x":0.763,"y":-2.305,"z":-0.585,"el":"C"},{"x":-0.706,"y":-2.618,"z":-0.244,"el":"C"},{"x":-1.429,"y":-1.294,"z":-0.474,"el":"C"},{"x":-0.392,"y":-0.24,"z":-0.041,"el":"C"},{"
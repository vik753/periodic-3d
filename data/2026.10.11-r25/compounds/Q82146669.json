{"version":"2026.10.11-r25","id":"Q82146669","formula":"C₁₈H₁₅NO₄","hill":"C18H15NO4","elements":["H","C","N","O"],"composition":{"C":18.0,"H":15.0,"N":1.0,"O":4.0},"names":{"en":"BQCA"},"descriptions":{"en":"BQCA (benzyl quinolone carboxylic acid) is an experimental drug that acts as a potent and selective positive allosteric modulator of the Muscarinic acetylcholine receptor M1. It was one of the first M1-selective positive allosteric modulators to be discovered, originally developed as a potential treatment agent for cognitive symptoms of schizophrenia, and while BQCA itself was not adopted for clinical use due to its poor side effect profile it is still used in research, and has led to the discovery of a wide range of structurally related M1 PAMs."},"fame":1,"pubchemCid":1476756,"mass":309.3,"charge":0,"smiles":"COC1=CC=C(C=C1)CN2C=C(C(=O)C3=CC=CC=C32)C(=O)O","inchikey":"BZBBTGCKPRSPGF-UHFFFAOYSA-N","iupac":"1-[(4-methoxyphenyl)methyl]-4-oxoquinoline-3-carboxylic acid","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"1476756","atoms":38,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-3.949,"y":0.093,"z":-1.242,"el":"O"},{"x":5.209,"y":0.851,"z":-1.309,"el":"O"},{"x":-4.332,"y":2.471,"z":-0.2,"el":"O"},{"x":-2.38,"y":3.648,"z":-0.007,"el":"O"},{"x":-0.574,"y":-0.021,"z":1.045,"el":"N"},{"x":0.633,"y":-0.048,"z":1.867,"el":"C"},{"x":-1.032,"y":-1.228,"z":0.467,"el":"C"},{"x":-2.2,"y":-1.22,"z":-0.331,"el":"C"},{"x":1.853,"y":0.192,"z":1.021,"el":"C"},{"x":-1.277,"y":1.149,"z":0.821,"el":"C"},{"x":-2.388,"y":1.273,"z":0.086,"el":"C"},{"x":-2.935,"y":0.053,"z":-0.556,"el":"C"},{"x":-0.382,"y":-2.463,"z":0.642,"el":"C"},{"x":-2.689,"y":-2.393,"z":-0.923,"el":"C"},{"x":1.842,"y":1.21,"z":0.076,"el":"C"},{"x":2.975,"y":-0.609,"z":1.194,"el":"C"},{"x":-0.871,"y":-3.633,"z":0.051,"el":"C"},
{"version":"2026.10.11-r25","id":"Q82463494","formula":"C₁₇H₁₅ClN₄O","hill":"C17H15ClN4O","elements":["H","C","N","O","Cl"],"composition":{"C":17.0,"H":15.0,"N":4.0,"O":1.0,"Cl":1.0},"names":{"en":"Alprazolam triazolobenzophenone"},"descriptions":{"en":"Alprazolam triazolobenzophenone is a chemical compound that is a prodrug for the benzodiazepine derivative alprazolam. At neutral pH it readily cyclizes to alprazolam, while in acidic conditions alprazolam undergoes a ring-opening reaction back to the ketone. A series of related acyl derivatives was researched in the 1980s as injectable water-soluble prodrugs of alprazolam, but were never developed for medical use."},"fame":3,"pubchemCid":15567865,"mass":326.8,"charge":0,"smiles":"CC1=NN=C(N1C2=C(C=C(C=C2)Cl)C(=O)C3=CC=CC=C3)CN","inchikey":"WWADXOXMCNJJKR-UHFFFAOYSA-N","iupac":"[2-[3-(aminomethyl)-5-methyl-1,2,4-triazol-4-yl]-5-chlorophenyl]-phenylmethanone","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"15567865","atoms":38,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-1.841,"y":-4.722,"z":-0.121,"el":"Cl"},{"x":0.513,"y":-0.054,"z":2.375,"el":"O"},{"x":-1.068,"y":1.115,"z":-0.423,"el":"N"},{"x":-1.241,"y":3.264,"z":-0.01,"el":"N"},{"x":-0.395,"y":3.095,"z":-1.087,"el":"N"},{"x":-3.932,"y":1.724,"z":1.055,"el":"N"},{"x":-1.234,"y":-0.258,"z":-0.34,"el":"C"},{"x":-0.402,"y":-1.047,"z":0.438,"el":"C"},{"x":-1.634,"y":2.07,"z":0.374,"el":"C"},{"x":-0.303,"y":1.806,"z":-1.32,"el":"C"},{"x":-2.268,"y":-0.858,"z":-1.059,"el":"C"},{"x":-2.546,"y":1.759,"z":1.491,"el":"C"},{"x":0.704,"y":-0.449,"z":1.215,"el":"C"},{"x":-0.576,"y":-2.42,"z":0.516,"el":"C"},{"x":-2.455,"y":-2.238,"z":-0.991,"el":"C"},{"x":0.492,"y":1.154,"z":-2.378,"el":"C"},{"x":2.028,"y":-0.298,"z":0.634,"el":"C"},{"x":-1.609,"y":-3.019,"z":-0.204,"el":"C"},{"x":2.273,"y":
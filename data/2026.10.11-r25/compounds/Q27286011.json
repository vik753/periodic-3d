{"version":"2026.10.11-r25","id":"Q27286011","formula":"C₁₉H₂₃ClO₂","hill":"C19H23ClO2","elements":["H","C","O","Cl"],"composition":{"C":19.0,"H":23.0,"O":2.0,"Cl":1.0},"names":{"en":"Clomestrone"},"descriptions":{"en":"Clomestrone (brand names Arterolo, Atheran, Colesterel, Iposclerone, Liprotene, Persclerol, and others; developmental code SC-8246; also known as 16α-chloroestrone 3-methyl ether) is a synthetic, steroidal, weak estrogen derived from estrone and used as an anticholesterolemic agent in the treatment of atherosclerosis. It is said to have beneficial effects on serum lipid profiles while producing minimal feminization, though some estrogenic side effects, including breast tenderness, loss of libido, and fatigue or avolition, were observed in most patients in clinical studies. The drug is a close analogue of mytatrienediol, and the two estrogens have similar drug profiles."},"fame":2,"pubchemCid":107501,"mass":318.8,"charge":0,"smiles":"C[C@]12CC[C@H]3[C@H]([C@@H]1C[C@H](C2=O)Cl)CCC4=C3C=CC(=C4)OC","inchikey":"UQIPVSBPFZSWGD-ILYVXUQDSA-N","iupac":"(8R,9S,13S,14S,16R)-16-chloro-3-methoxy-13-methyl-7,8,9,11,12,14,15,16-octahydro-6H-cyclopenta[a]phenanthren-17-one","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"107501","atoms":45,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-5.13,"y":1.268,"z":-1.471,"el":"Cl"},{"x":-4.916,"y":-1.544,"z":-0.12,"el":"O"},{"x":5.787,"y":0.255,"z":0.198,"el":"O"},{"x":-2.128,"y":0.531,"z":-0.089,"el":"C"},{"x":-2.652,"y":-0.834,"z":0.407,"el":"C"},{"x":-0.649,"y":0.71,"z":0.247,"el":"C"},{"x":0.16,"y":-0.39,"z":-0.51,"el":"C"},{"x":-1.929,"y":-1.923,"z":-0.378,"el":"C"},{"x":-3.157,"y":1.534,"z":0.427,"el":"C"},{"x":-0.401,"y":-1.809,"z":-0.217,"el":"C"},{"x":-0.11,"y":2.084,"z":-0.153,"el":"C"},{"x":-4.126,"y":-0.634,"z":0.099,"el":"C"},{"x"
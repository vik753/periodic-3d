{"version":"2026.10.11-r25","id":"Q410325","formula":"Fe₁₆H₂₉.6S₃.2O₄₈.4","hill":"Fe16H29.6O48.4S3.2","elements":["H","O","S","Fe"],"composition":{"H":29.6,"O":48.400000000000006,"S":3.2,"Fe":16.0},"names":{"en":"Schwertmannite","uk":"Швертманніт"},"descriptions":{"en":"Schwertmannite is an iron-oxyhydroxysulfate mineral with an ideal chemical formula of Fe8O8(OH)6(SO4) · n H2O or Fe3+16O16(OH,SO4)12–13·10–12 H2O. It is an opaque tetragonal mineral typically occurring as brownish yellow encrustations. It has a Mohs hardness of 2.5 – 3.5 and a specific gravity of 3.77 – 3.99. It was first described for an occurrence in Finland in 1994 and named for Udo Schwertmann (born 1927), a soil scientist at the Technical University of Munich, Munich, Germany.","uk":"Швертманніт — мінерал, оксигідроксилсульфат заліза."},"fame":10,"pubchemCid":null,"mass":null,"charge":0,"smiles":null,"inchikey":null,"iupac":null,"classes":[{"qid":"Q12089225","names":{"en":"mineral species","ru":"действительный вид минералов","uk":"мінеральний вид"}}],"structureInfo":null,"structure":null,"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q410325","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Schwertmannite","license":"CC BY-SA 4.0"},{"role":"description","name":"Wikipedia (uk)","url":"https://uk.wikipedia.org/wiki/%D0%A8%D0%B2%D0%B5%D1%80%D1%82%D0%BC%D0%B0%D0%BD%D0%BD%D1%96%D1%82","license":"CC BY-SA 4.0"},{"role":"photo","name":"Wikimedia Commons","url":"https://commons.wikimedia.org/wiki/File:Crosta_de_schwertmannita_obtinguda_de_zona_de_drenatge_%C3%A0cid_de_mines_prop_de_Corta_Atalaya,_Huelva,_Andalusia.jpg","license":"CC BY-SA 4.0"}],"similar":[{"id":"Q617097","formula":"Mn₃ZnH₆O₁₀","names":{"en":"Chalcophanite","ru":"Халькофанит","uk":"Халькофаніт"},"elements":["H","O","Mn","Zn"],"fame":10,"kind":null},{"id":"Q420570","formula":"Mn₅(AsO₄)₂(OH)₄·4H₂O","names":{"en":"Akrochordite","ru":"Акрохордит","u
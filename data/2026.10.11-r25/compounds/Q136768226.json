{"version":"2026.10.11-r25","id":"Q136768226","formula":"C₁₁H₁₄BrNO₂","hill":"C11H14BrNO2","elements":["H","C","N","O","Br"],"composition":{"C":11.0,"H":14.0,"N":1.0,"O":2.0,"Br":1.0},"names":{"en":"6-bromo-MDMA"},"descriptions":{"en":"6-Bromo-MDMA, also known as 6-bromo-3,4-methylenedioxy-N-methylamphetamine or as 2-bromo-4,5-methylenedioxymethamphetamine (2-Br-4,5-MDMA), is a psychoactive drug of the phenethylamine, amphetamine, and MDxx families related to MDMA. It does not appear to be a serotonin releasing agent like MDMA, but instead to be a serotonin reuptake inhibitor like citalopram, and with much greater serotonin transporter (SERT) affinity than MDMA. Relatedly, 6-bromo-MDMA lacked key MDMA-like behavioral effects in rodents, including hyperlocomotion, enhanced active avoidance conditioning, and increased social interaction. The drug was encountered as a novel designer drug in Europe in 2014."},"fame":1,"pubchemCid":132988792,"mass":272.14,"charge":0,"smiles":"CC(CC1=CC2=C(C=C1Br)OCO2)NC","inchikey":"ZIBHSZQEEWBQLW-UHFFFAOYSA-N","iupac":"1-(6-bromo-1,3-benzodioxol-5-yl)-N-methylpropan-2-amine","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"rdkit","ref":"132988792","atoms":29,"license":"Computed with RDKit from SMILES (PubChem, Wikidata)"},"structure":{"kind":"molecule","atoms":[{"x":-2.189,"y":-1.139,"z":-0.557,"el":"C"},{"x":-1.726,"y":-0.48,"z":0.747,"el":"C"},{"x":-0.876,"y":0.793,"z":0.508,"el":"C"},{"x":0.482,"y":0.515,"z":-0.112,"el":"C"},{"x":1.48,"y":-0.029,"z":0.724,"el":"C"},{"x":2.721,"y":-0.3,"z":0.188,"el":"C"},{"x":3.005,"y":-0.053,"z":-1.131,"el":"C"},{"x":2.067,"y":0.478,"z":-1.987,"el":"C"},{"x":0.794,"y":0.765,"z":-1.472,"el":"C"},{"x":-0.465,"y":1.498,"z":-2.694,"el":"Br"},{"x":4.281,"y":-0.39,"z":-1.46,"el":"O"},{"x":4.768,"y":-0.875,"z":-0.191,"el":"C"},{"x":3.78,"y":-0.824,"z":0.859,"el":"O"},{"x":-2.856
{"version":"2026.10.11-r25","id":"Q115111410","formula":"C₁₃H₁₅N₃","hill":"C13H15N3","elements":["H","C","N"],"composition":{"C":13.0,"H":15.0,"N":3.0},"names":{"en":"(R)-69"},"descriptions":{"en":"(R)-69 (3IQ) is a drug of the tetrahydropyridinylpyrrolopyridine family related to the psychedelic tryptamines which acts as a 5-HT2A receptor agonist, with 4.6-fold selectivity over 5-HT2B and 49-fold selectivity over 5-HT2C. It has a 5-HT2A Ki of 680 nM and an EC50 of 41 nM. (R)-69 is a biased agonist selective for activation of the Gq coupled signalling pathway, with much weaker activation of the β-arrestin 2 coupled pathway. In animal studies it produces antidepressant-like activity but without producing the head-twitch response associated with psychedelic effects."},"fame":2,"pubchemCid":164513426,"mass":213.28,"charge":0,"smiles":"C[C@H]1CNCC(=C1)C2=CNC3=C2C=CC=N3","inchikey":"HNDPIXZRQWKEFZ-SECBINFHSA-N","iupac":"3-[(3R)-3-methyl-1,2,3,6-tetrahydropyridin-5-yl]-1H-pyrrolo[2,3-b]pyridine","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"rdkit","ref":"164513426","atoms":31,"license":"Computed with RDKit from SMILES (PubChem, Wikidata)"},"structure":{"kind":"molecule","atoms":[{"x":-3.712,"y":-0.873,"z":0.886,"el":"C"},{"x":-2.927,"y":-0.434,"z":-0.35,"el":"C"},{"x":-2.986,"y":1.102,"z":-0.5,"el":"C"},{"x":-2.015,"y":1.594,"z":-1.486,"el":"N"},{"x":-0.646,"y":1.287,"z":-1.028,"el":"C"},{"x":-0.455,"y":-0.151,"z":-0.587,"el":"C"},{"x":-1.507,"y":-0.943,"z":-0.3,"el":"C"},{"x":0.902,"y":-0.608,"z":-0.574,"el":"C"},{"x":1.332,"y":-1.764,"z":-1.2,"el":"C"},{"x":2.683,"y":-1.878,"z":-0.995,"el":"N"},{"x":3.129,"y":-0.828,"z":-0.243,"el":"C"},{"x":2.041,"y":-0.009,"z":0.049,"el":"C"},{"x":2.297,"y":1.124,"z":0.843,"el":"C"},{"x":3.611,"y":1.347,"z":1.26,"el":"C"},{"x":4.599,"y":0.448,"z":0.882,"el":"C"},{"x":4.411,"y":-0.66,"z":0.131,"el":"N"},{"
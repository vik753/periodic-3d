{"version":"2026.10.11-r25","id":"Q3704572","formula":"Y₄Cu(CO₃)₄Cl(OH)₅·2H₂O","hill":"C4H9ClCuO19Y4","elements":["H","C","O","Cl","Cu","Y"],"composition":{"C":4.0,"H":9.0,"O":19.0,"Y":4.0,"Cl":1.0,"Cu":1.0},"names":{"en":"Decrespignyite-(Y)"},"descriptions":{"en":"Decrespignyite-(Y) is a copper yttrium rare earth carbonate chloride hydrate; With a simple formula of; Cu(Y, REE)4(CO3)4(OH)5Cl · 2H2O Usually found as single pseudohexagonal platelets, often curved, and regularly measuring 10-50μm in size. It appears as royal blue to turquoise blue in colour, with a pale blue streak, and a pearly to vitreous lustre. Regarded as a supergene mineral which is believed to be formed through by mildly carbonated ground waters precipitating through the ore body."},"fame":6,"pubchemCid":null,"mass":null,"charge":0,"smiles":null,"inchikey":null,"iupac":null,"classes":[{"qid":"Q12089225","names":{"en":"mineral species","ru":"действительный вид минералов","uk":"мінеральний вид"}}],"structureInfo":null,"structure":null,"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q3704572","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Decrespignyite-%28Y%29","license":"CC BY-SA 4.0"},{"role":"photo","name":"Wikimedia Commons","url":"https://commons.wikimedia.org/wiki/File:Decrespignyite-(Y)_and_minor_Kamphaugite-(Y).jpg","license":"CC BY-SA 4.0"}],"similar":[{"id":"Q3639889","formula":"Y₈(UO₂)₁₆(CO₃)₁₆O₈(OH)₈·39H₂O","names":{"en":"Bijvoetite-(Y)"},"elements":["H","C","O","Y","U"],"fame":5,"kind":null},{"id":"Q126204","formula":"PbAl₂(CO₃)₂(OH)₄·H₂O","names":{"en":"Dundasite","ru":"Дундазит","uk":"Дундазит"},"elements":["H","C","O","Al","Pb"],"fame":21,"kind":null},{"id":"Q3039376","formula":"Ba₂Al₄(CO₃)₄(OH)₈·3H₂O","names":{"en":"Dresserite"},"elements":["H","C","O","Al","Ba"],"fame":8,"kind":null},{"id":"Q26160641","formula":"K₂Ca(UO₂)(CO₃)₃·6H₂O","names":{"en":"Braunerite","uk":"Браунерит"},"elements
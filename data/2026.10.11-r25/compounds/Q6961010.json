{"version":"2026.10.11-r25","id":"Q6961010","formula":"C₁₉H₂₃N₃O₃","hill":"C19H23N3O3","elements":["H","C","N","O"],"composition":{"C":19.0,"H":23.0,"N":3.0,"O":3.0},"names":{"en":"Naloxazone"},"descriptions":{"en":"Naloxazone is an irreversible μ-opioid receptor antagonist which is selective for the μ1 receptor subtype. Naloxazone produces very long lasting antagonist effects as it forms a covalent bond to the active site of the μ-opioid receptor, thus making it impossible for the molecule to unbind and blocking the receptor permanently until the receptor is recycled by endocytosis. Naloxazone is the hydrazone analog of naloxone."},"fame":8,"pubchemCid":9576788,"mass":341.4,"charge":0,"smiles":"C=CCN1CC[C@]23[C@@H]4/C(=N/N)/CC[C@]2([C@H]1CC5=C3C(=C(C=C5)O)O4)O","inchikey":"XQQRNWNMEFUSMN-UTWDOOMRSA-N","iupac":"(4R,4aS,7E,7aR,12bS)-7-hydrazinylidene-3-prop-2-enyl-2,4,5,6,7a,13-hexahydro-1H-4,12-methanobenzofuro[3,2-e]isoquinoline-4a,9-diol","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"9576788","atoms":48,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":2.255,"y":-0.441,"z":1.398,"el":"O"},{"x":-0.752,"y":2.587,"z":-0.14,"el":"O"},{"x":3.253,"y":-3.118,"z":0.855,"el":"O"},{"x":-2.683,"y":0.612,"z":-0.074,"el":"N"},{"x":3.174,"y":2.513,"z":0.694,"el":"N"},{"x":3.844,"y":3.176,"z":-0.265,"el":"N"},{"x":0.143,"y":0.44,"z":0.567,"el":"C"},{"x":-0.366,"y":1.285,"z":-0.612,"el":"C"},{"x":-1.654,"y":0.558,"z":-1.143,"el":"C"},{"x":1.52,"y":0.792,"z":1.15,"el":"C"},{"x":-0.931,"y":0.355,"z":1.677,"el":"C"},{"x":0.464,"y":-0.918,"z":0.056,"el":"C"},{"x":0.684,"y":1.528,"z":-1.726,"el":"C"},{"x":-1.347,"y":-0.899,"z":-1.655,"el":"C"},{"x":-2.302,"y":-0.096,"z":1.151,"el":"C"},{"x":-0.228,"y":-1.601,"z":-0.928,"el":"C"},{"x":2.149,"y":1.488,"z":-1.28,"el":"C"},{"x":2.326,"y":1.668,"z":0.208,"el"
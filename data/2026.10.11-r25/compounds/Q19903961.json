{"version":"2026.10.11-r25","id":"Q19903961","formula":"C₁₃H₁₉NO₂","hill":"C13H19NO2","elements":["H","C","N","O"],"composition":{"C":13.0,"H":19.0,"N":1.0,"O":2.0},"names":{"en":"Dioscorine"},"descriptions":{"en":"Dioscorine is an alkaloid toxin isolated from the tubers of tropical yam on several continents. It has been used as a monkey poison in some African countries, and as an arrow poison to aid in hunting in several parts of Asia. It was first isolated from Dioscorea hirsute (synonymous with Dioscorea hirsuta) by Boorsma in 1894 and obtained in a crystalline form by Schutte in 1897, and has since been found in other Dioscorea species."},"fame":3,"pubchemCid":442635,"mass":221.29,"charge":0,"smiles":"CC1=CC(=O)O[C@@]2(C1)C[C@H]3CC[C@@H]2CN3C","inchikey":"YBQKKTNDAXVYGX-WZRBSPASSA-N","iupac":"(1R,4R,5S)-2,4'-dimethylspiro[2-azabicyclo[2.2.2]octane-5,2'-3H-pyran]-6'-one","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"442635","atoms":35,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-1.03,"y":1.232,"z":0.334,"el":"O"},{"x":-2.953,"y":2.143,"z":-0.443,"el":"O"},{"x":2.711,"y":-0.671,"z":-0.216,"el":"N"},{"x":-0.124,"y":0.094,"z":0.326,"el":"C"},{"x":1.068,"y":0.449,"z":1.265,"el":"C"},{"x":1.958,"y":0.209,"z":-1.13,"el":"C"},{"x":0.443,"y":-0.097,"z":-1.109,"el":"C"},{"x":1.701,"y":1.785,"z":0.818,"el":"C"},{"x":2.16,"y":-0.637,"z":1.151,"el":"C"},{"x":2.175,"y":1.653,"z":-0.635,"el":"C"},{"x":-0.893,"y":-1.14,"z":0.826,"el":"C"},{"x":2.872,"y":-2.031,"z":-0.713,"el":"C"},{"x":-2.204,"y":-1.278,"z":0.108,"el":"C"},{"x":-2.282,"y":1.15,"z":-0.185,"el":"C"},{"x":-2.826,"y":-0.203,"z":-0.392,"el":"C"},{"x":-2.775,"y":-2.658,"z":-0.005,"el":"C"},{"x":0.727,"y":0.549,"z":2.302,"el":"H"},{"x":2.345,"y":0.126,"z":-2.153,"el":"H"},{"x":-0.062,"y":0.568,"z":-1.82,"el":"H"},{"x":0.275,"y":-1.
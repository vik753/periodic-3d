{"version":"2026.10.11-r25","id":"Q13570332","formula":"C₁₇H₁₆N₂O","hill":"C17H16N2O","elements":["H","C","N","O"],"composition":{"C":17.0,"H":16.0,"N":2.0,"O":1.0},"names":{"en":"Methylmethaqualone"},"descriptions":{"en":"Methylmethaqualone (MMQ) is a quinazolinone and an analogue of methaqualone that has similar sedative and hypnotic properties to its parent compound (resulting from its agonist activity at the β subtype of the GABAA receptor) and is around 3 times as potent in animal models. Methylmethaqualone differs from methaqualone by 4-methylation on the phenyl ring. It was made illegal in Germany in 1999 and listed by the DEA as a \"drug of forensic interest\" at about the same time, but little other information is available."},"fame":8,"pubchemCid":63382,"mass":264.32,"charge":0,"smiles":"CC1=CC(=C(C=C1)N2C(=NC3=CC=CC=C3C2=O)C)C","inchikey":"MPMDMUROZIYIIM-UHFFFAOYSA-N","iupac":"3-(2,4-dimethylphenyl)-2-methylquinazolin-4-one","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"63382","atoms":36,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-0.366,"y":-2.04,"z":0.18,"el":"O"},{"x":0.067,"y":0.276,"z":0.183,"el":"N"},{"x":-1.767,"y":1.787,"z":0.073,"el":"N"},{"x":1.489,"y":0.064,"z":0.163,"el":"C"},{"x":2.172,"y":-0.027,"z":-1.044,"el":"C"},{"x":-0.493,"y":1.555,"z":0.161,"el":"C"},{"x":-0.752,"y":-0.873,"z":0.181,"el":"C"},{"x":-2.206,"y":-0.617,"z":0.111,"el":"C"},{"x":-2.65,"y":0.703,"z":0.035,"el":"C"},{"x":2.167,"y":-0.048,"z":1.372,"el":"C"},{"x":3.552,"y":-0.233,"z":-1.043,"el":"C"},{"x":4.239,"y":-0.346,"z":0.166,"el":"C"},{"x":3.546,"y":-0.253,"z":1.373,"el":"C"},{"x":1.462,"y":0.09,"z":-2.353,"el":"C"},{"x":0.391,"y":2.777,"z":0.304,"el":"C"},{"x":-3.118,"y":-1.679,"z":0.095,"el":"C"},{"x":-4.024,"y":0.952,"z":-0.057,"el":"C"},{"x":5.714,"y":-0.566,"z":0.168,"el":"C"},{
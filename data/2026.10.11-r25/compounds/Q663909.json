{"version":"2026.10.11-r25","id":"Q663909","formula":"C₈H₆O₃","hill":"C8H6O3","elements":["H","C","O"],"composition":{"C":8.0,"H":6.0,"O":3.0},"names":{"en":"Phenylglyoxylic acid"},"descriptions":{"en":"Phenylglyoxylic acid is the organic compound with the formula C6H5C(O)CO2H. The conjugate base, known as benzoylformate, is the substrate of benzoylformate decarboxylase, a thiamine diphosphate-dependent enzyme: benzoylformate + H+ ⇌ benzaldehyde + CO2 It is a colourless solid with a melting point of 64–66 °C and is moderately acidic (pKa = 2.15). Phenylglyoxylic acid can be synthesized by oxidation of mandelic acid with potassium permanganate. An alternative synthesis involves hydrolysis of benzoyl cyanide."},"fame":11,"pubchemCid":11915,"mass":150.13,"charge":0,"smiles":"C1=CC=C(C=C1)C(=O)C(=O)O","inchikey":"FAQJJMHZNSSFSM-UHFFFAOYSA-N","iupac":"2-oxo-2-phenylacetic acid","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"11915","atoms":17,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":1.559,"y":-1.693,"z":0.39,"el":"O"},{"x":3.368,"y":-0.074,"z":-0.036,"el":"O"},{"x":1.866,"y":1.626,"z":-0.416,"el":"O"},{"x":-0.314,"y":-0.26,"z":0.071,"el":"C"},{"x":-0.759,"y":1.026,"z":0.378,"el":"C"},{"x":-1.229,"y":-1.247,"z":-0.295,"el":"C"},{"x":-2.12,"y":1.325,"z":0.318,"el":"C"},{"x":-2.591,"y":-0.948,"z":-0.355,"el":"C"},{"x":1.105,"y":-0.573,"z":0.134,"el":"C"},{"x":-3.036,"y":0.338,"z":-0.048,"el":"C"},{"x":2.152,"y":0.479,"z":-0.14,"el":"C"},{"x":-0.098,"y":1.81,"z":0.727,"el":"H"},{"x":-0.899,"y":-2.253,"z":-0.54,"el":"H"},{"x":-2.47,"y":2.322,"z":0.57,"el":"H"},{"x":-3.304,"y":-1.716,"z":-0.64,"el":"H"},{"x":-4.096,"y":0.57,"z":-0.092,"el":"H"},{"x":4.085,"y":0.572,"z":-0.211,"el":"H"}],"bonds":[[0,8,2],[1,10,1],[1,16,1],[2,10,2],[3,4,2],[3,5,1],[3,8,1],[4,6,1],[4,11,1],[5,7,2],[5,12,1],[6
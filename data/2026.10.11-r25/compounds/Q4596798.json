{"version":"2026.10.11-r25","id":"Q4596798","formula":"C₆H₄O₅","hill":"C6H4O5","elements":["H","C","O"],"composition":{"C":6.0,"H":4.0,"O":5.0},"names":{"en":"Furan-2,5-dicarboxylic acid"},"descriptions":{"en":"2,5-Furandicarboxylic acid (FDCA) is an organic chemical compound consisting of two carboxylic acid groups attached to a central furan ring. It was first reported as dehydromucic acid by Rudolph Fittig and Heinzelmann in 1876, who produced it via the action of concentrated hydrobromic acid upon mucic acid. It can be produced from certain carbohydrates and as such is a renewable resource, it was identified by the US Department of Energy as one of 12 priority chemicals for establishing the \"green\" chemistry industry of the future."},"fame":11,"pubchemCid":76720,"mass":156.09,"charge":0,"smiles":"C1=C(OC(=C1)C(=O)O)C(=O)O","inchikey":"CHTHALBTIRVDBM-UHFFFAOYSA-N","iupac":"furan-2,5-dicarboxylic acid","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"76720","atoms":15,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":0.0,"y":0.585,"z":0.001,"el":"O"},{"x":-3.413,"y":-0.515,"z":-0.002,"el":"O"},{"x":3.413,"y":-0.515,"z":0.0,"el":"O"},{"x":-2.618,"y":1.614,"z":0.001,"el":"O"},{"x":2.618,"y":1.614,"z":-0.001,"el":"O"},{"x":-1.09,"y":-0.227,"z":0.001,"el":"C"},{"x":1.09,"y":-0.227,"z":0.0,"el":"C"},{"x":-0.708,"y":-1.548,"z":0.001,"el":"C"},{"x":0.708,"y":-1.548,"z":0.0,"el":"C"},{"x":-2.375,"y":0.384,"z":0.0,"el":"C"},{"x":2.375,"y":0.384,"z":-0.001,"el":"C"},{"x":-1.36,"y":-2.41,"z":0.001,"el":"H"},{"x":1.36,"y":-2.41,"z":0.0,"el":"H"},{"x":-4.283,"y":-0.062,"z":-0.003,"el":"H"},{"x":4.283,"y":-0.062,"z":0.0,"el":"H"}],"bonds":[[0,5,1],[0,6,1],[1,9,1],[1,13,1],[2,10,1],[2,14,1],[3,9,2],[4,10,2],[5,7,2],[5,9,1],[6,8,2],[6,10,1],[7,8,1],[7,11,1],[8,12,1]]},"sources":[{"role":"identity","n
{"version":"2026.10.11-r25","id":"Q7404461","formula":"C₇H₇NO₃","hill":"C7H7NO3","elements":["H","C","N","O"],"composition":{"C":7.0,"H":7.0,"N":1.0,"O":3.0},"names":{"en":"Salicylhydroxamic acid"},"descriptions":{"en":"Salicylhydroxamic acid (SHA or SHAM) is a drug that is a potent and irreversible enzyme inhibitor of the urease enzyme in various bacteria and plants; it is usually used for urinary tract infections. The molecule is similar to urea but is not hydrolyzable by urease; it thus disrupts the bacteria's metabolism through competitive inhibition. It is also a trypanocidal agent."},"fame":7,"pubchemCid":66644,"mass":153.14,"charge":0,"smiles":"C1=CC=C(C(=C1)C(=O)NO)O","inchikey":"HBROZNQEVUILML-UHFFFAOYSA-N","iupac":"N,2-dihydroxybenzamide","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"66644","atoms":18,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-0.494,"y":-2.243,"z":-0.223,"el":"O"},{"x":1.834,"y":-1.205,"z":0.589,"el":"O"},{"x":3.594,"y":0.648,"z":-0.25,"el":"O"},{"x":2.212,"y":0.877,"z":-0.326,"el":"N"},{"x":-0.05,"y":0.097,"z":0.07,"el":"C"},{"x":-0.943,"y":-0.961,"z":-0.105,"el":"C"},{"x":-0.53,"y":1.401,"z":0.188,"el":"C"},{"x":-2.314,"y":-0.714,"z":-0.162,"el":"C"},{"x":-1.901,"y":1.648,"z":0.131,"el":"C"},{"x":-2.794,"y":0.591,"z":-0.044,"el":"C"},{"x":1.386,"y":-0.139,"z":0.132,"el":"C"},{"x":0.133,"y":2.248,"z":0.347,"el":"H"},{"x":-3.021,"y":-1.528,"z":-0.298,"el":"H"},{"x":-2.276,"y":2.663,"z":0.227,"el":"H"},{"x":-3.862,"y":0.783,"z":-0.088,"el":"H"},{"x":1.922,"y":1.716,"z":-0.814,"el":"H"},{"x":-1.255,"y":-2.837,"z":-0.338,"el":"H"},{"x":3.791,"y":1.072,"z":0.602,"el":"H"}],"bonds":[[0,5,1],[0,16,1],[1,10,2],[2,3,1],[2,17,1],[3,10,1],[3,15,1],[4,5,1],[4,6,2],[4,10,1],[5,7,2],[6,8,1],[6,11,1],[7,9,1],[7,12,1],[8,9,2],[8,13,1],[9,14,1]]},"sources":[{"role":"
{"version":"2026.10.11-r25","id":"Q5514740","formula":"C₁₀H₁₆N₅O₁₃P₃S","hill":"C10H16N5O13P3S","elements":["H","C","N","O","P","S"],"composition":{"C":10.0,"H":16.0,"N":5.0,"O":13.0,"P":3.0,"S":1.0},"names":{"en":"Guanosine 5'-[gamma-thio]triphosphate"},"descriptions":{"en":"GTPgammaS (GTPγS, guanosine 5'-O-[gamma-thio]triphosphate) is a non-hydrolyzable or slowly hydrolyzable G-protein-activating analog of guanosine triphosphate (GTP). Many GTP binding proteins demonstrate activity when bound to GTP, and are inactivated via the hydrolysis of the phosphoanhydride bond that links the γ-phosphate to the remainder of the nucleotide, leaving a bound guanosine diphosphate (GDP) and releasing an inorganic phosphate. This usually occurs rapidly, and the GTP-binding protein can then only be activated by exchanging the GDP for a new GTP molecule."},"fame":6,"pubchemCid":37792,"mass":539.25,"charge":0,"smiles":"C1=NC2=C(N1[C@H]3[C@@H]([C@@H]([C@H](O3)COP(=O)(O)OP(=O)(O)OP(=S)(O)O)O)O)NC(=NC2=O)N","inchikey":"XOFLBQFBSOEHOG-UUOKFMHZSA-N","iupac":"[[(2R,3S,4R,5R)-5-(2-amino-6-oxo-3H-purin-9-yl)-3,4-dihydroxyoxolan-2-yl]methoxy-hydroxyphosphoryl] dihydroxyphosphinothioyl hydrogen phosphate","classes":[{"qid":"Q59199015","names":{"en":"group of stereoisomers","ru":"группа стереоизомеров","uk":"група стереоізомерів"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"37792","atoms":48,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":4.381,"y":4.414,"z":-1.945,"el":"S"},{"x":4.02,"y":-1.585,"z":1.202,"el":"P"},{"x":3.223,"y":1.245,"z":1.193,"el":"P"},{"x":3.667,"y":2.719,"z":-1.329,"el":"P"},{"x":-0.279,"y":-1.719,"z":0.579,"el":"O"},{"x":-2.11,"y":-3.763,"z":-1.082,"el":"O"},{"x":0.187,"y":-3.474,"z":-2.521,"el":"O"},{"x":2.501,"y":-2.091,"z":0.963,"el":"O"},{"x":3.994,"y":-0.067,"z":0.649,"el":"O"},{"x":4.864,"y":-2.373,"z":0.069,"el":"O"},{"x":4.536,"y":-1.745,"z":2.602,"el":"O"},{"x":-4.533,"y":3.494,"z":0.033,"el":"O"},{"x":3.803
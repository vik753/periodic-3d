{"version":"2026.10.11-r25","id":"Q5460495","formula":"C₂₀H₂₅FN₂O₃","hill":"C20H25FN2O3","elements":["H","C","N","O","F"],"composition":{"C":20.0,"F":1.0,"H":25.0,"N":2.0,"O":3.0},"names":{"en":"Florbetapir (18F)","ru":"Florbetapir (18F)"},"descriptions":{"en":"Florbetapir (18F), sold under the brand name Amyvid, is a PET scanning radiopharmaceutical compound containing the radionuclide fluorine-18 that was approved for use in the United States in 2012, as a diagnostic tool for Alzheimer's disease. Florbetapir, like Pittsburgh compound B (PiB), binds to beta-amyloid, however fluorine-18 has a half-life of 109.75 minutes, in contrast to PiB's radioactive half life of 20 minutes. The longer life allows the tracer to accumulate significantly more in the brains of people with AD, particularly in the regions known to be associated with beta-amyloid deposits.","ru":"Флорбетапир (18F) — радиофармацевтический препарат для диагностики болезни Альцгеймера. Одобрен для применения:США(2012)."},"fame":8,"pubchemCid":24822371,"mass":359.4,"charge":0,"smiles":"CNC1=CC=C(C=C1)/C=C/C2=CN=C(C=C2)OCCOCCOCC[18F]","inchikey":"YNDIAUKFXKEXSV-CRYLGTRXSA-N","iupac":"4-[(E)-2-[6-[2-[2-(2-(18F)fluoroethoxy)ethoxy]ethoxy]-3-pyridinyl]ethenyl]-N-methyl(18F)aniline","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"24822371","atoms":51,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":11.097,"y":0.672,"z":-1.052,"el":"F"},{"x":5.067,"y":-0.66,"z":-0.242,"el":"O"},{"x":2.448,"y":-0.829,"z":0.731,"el":"O"},{"x":8.512,"y":0.486,"z":-0.117,"el":"O"},{"x":-9.468,"y":0.541,"z":-0.37,"el":"N"},{"x":0.375,"y":-1.135,"z":-0.265,"el":"N"},{"x":4.423,"y":-1.917,"z":-0.072,"el":"C"},{"x":6.475,"y":-0.77,"z":-0.082,"el":"C"},{"x":2.929,"y":-1.736,"z":-0.253,"el":"C"},{"x":7.105,"y":0.592,"z":-0.297,"el":"C"},{"x":-5.342,"y":-0.216
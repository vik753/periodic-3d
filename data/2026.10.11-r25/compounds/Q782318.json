{"version":"2026.10.11-r25","id":"Q782318","formula":"C₁₆₄H₁₆₈N₁₆O₃₂","hill":"C164H168N16O32","elements":["H","C","N","O"],"composition":{"C":164.0,"H":168.0,"N":16.0,"O":32.0},"names":{"en":"Verteporfin"},"descriptions":{"en":"Verteporfin (trade name Visudyne), a benzoporphyrin derivative, is a medication used as a photosensitizer for photodynamic therapy to eliminate the abnormal blood vessels in the eye associated with conditions such as the wet form of macular degeneration. Verteporfin accumulates in these abnormal blood vessels and, when stimulated by nonthermal red light with a wavelength of 689 nm in the presence of oxygen, produces highly reactive short-lived singlet oxygen and other reactive oxygen radicals, resulting in local damage to the endothelium and blockage of the vessels. Verteporfin is also used off-label for the treatment of central serous retinopathy."},"fame":13,"pubchemCid":null,"mass":null,"charge":0,"smiles":null,"inchikey":null,"iupac":null,"classes":[{"qid":"Q119892838","names":{"en":"type of mixture of chemical entities","ru":"тип смеси химических соединений"}}],"structureInfo":null,"structure":null,"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q782318","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Verteporfin","license":"CC BY-SA 4.0"}],"similar":[{"id":"Q104219","formula":"C₃₃H₃₆N₄O₆","names":{"en":"Bilirubin","ru":"Билирубин","uk":"Білірубін"},"elements":["H","C","N","O"],"fame":66,"kind":"molecule"},{"id":"Q417897","formula":"C₁₆H₁₈FN₃O₃","names":{"en":"Norfloxacin","ru":"Норфлоксацин","uk":"Норфлоксацин"},"elements":["H","C","N","O","F"],"fame":25,"kind":"molecule"},{"id":"Q411697","formula":"C₁₃H₁₄N₂O₃","names":{"en":"Mephobarbital"},"elements":["H","C","N","O"],"fame":20,"kind":"molecule"},{"id":"Q267896","formula":"C₁₈H₁₆O₃","names":{"en":"Phenprocoumon"},"elements":["H","C","O"],"fame":19,"kind":"molecule"},{"id":"Q3992411","formula":
{"version":"2026.10.11-r25","id":"Q2823289","formula":"C₃H₂O₅","hill":"C3H2O5","elements":["H","C","O"],"composition":{"C":3.0,"H":2.0,"O":5.0},"names":{"en":"Mesoxalic acid"},"descriptions":{"en":"Mesoxalic acid, also called oxomalonic acid or ketomalonic acid, is an organic compound with formula C3H2O5 or HO−(C=O)3−OH. Mesoxalic acid is both a dicarboxylic acid and a ketonic acid. It readily loses two protons to yield the divalent anion C3O2−5, called mesoxalate, oxomalonate, or ketomalonate. These terms are also used for salts containing this anion, such as sodium mesoxalate, Na2C3O5; and for esters containing the −C3O5− or −O−(C=O)3−O− moiety, such as diethyl mesoxalate, (C2H5)2C3O5."},"fame":16,"pubchemCid":10132,"mass":118.04,"charge":0,"smiles":"C(=O)(C(=O)O)C(=O)O","inchikey":"XEEVLJKYYUVTRC-UHFFFAOYSA-N","iupac":"2-oxopropanedioic acid","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"10132","atoms":10,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":2.329,"y":0.654,"z":-0.01,"el":"O"},{"x":-2.319,"y":0.628,"z":-0.003,"el":"O"},{"x":-0.048,"y":1.682,"z":0.001,"el":"O"},{"x":1.426,"y":-1.449,"z":0.006,"el":"O"},{"x":-1.393,"y":-1.474,"z":-0.01,"el":"O"},{"x":-0.006,"y":0.461,"z":0.008,"el":"C"},{"x":1.33,"y":-0.239,"z":0.002,"el":"C"},{"x":-1.319,"y":-0.263,"z":0.006,"el":"C"},{"x":3.211,"y":0.226,"z":-0.015,"el":"H"},{"x":-3.2,"y":0.197,"z":-0.016,"el":"H"}],"bonds":[[0,6,1],[0,8,1],[1,7,1],[1,9,1],[2,5,2],[3,6,2],[4,7,2],[5,6,1],[5,7,1]]},"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q2823289","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Mesoxalic_acid","license":"CC BY-SA 4.0"},{"role":"properties","name":"PubChem","url":"https://pubchem.ncbi.nlm.nih.gov/compound/10132","license":
{"version":"2026.10.11-r25","id":"Q14521943","formula":"C₂₄H₃₈O₃","hill":"C24H38O3","elements":["H","C","O"],"composition":{"C":24.0,"H":38.0,"O":3.0},"names":{"en":"Canbisol"},"descriptions":{"en":"Canbisol (Nabidrox) is a synthetic cannabinoid derivative that is the dimethylheptyl homologue of 9-nor-9β-hydroxyhexahydrocannabinol (HHC). It is a potent agonist at both the CB1 and CB2 receptors, with a binding affinity of 0.1 nM at CB1 and 0.2 nM at CB2. It is mainly used in scientific research, in receptor binding studies to determine the structure and function of the cannabinoid receptors, but has been made illegal in some countries due to its possible abuse potential as a cannabinomimetic drug."},"fame":4,"pubchemCid":41969,"mass":374.6,"charge":0,"smiles":"CCCCCCC(C)(C)C1=CC(=C2C3CC(CCC3C(OC2=C1)(C)C)O)O","inchikey":"UEKGZFCGRQYMRM-UHFFFAOYSA-N","iupac":"6,6-dimethyl-3-(2-methyloctan-2-yl)-6a,7,8,9,10,10a-hexahydrobenzo[c]chromene-1,9-diol","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"41969","atoms":65,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-2.011,"y":-1.153,"z":-1.65,"el":"O"},{"x":-2.337,"y":3.91,"z":1.737,"el":"O"},{"x":-1.009,"y":0.005,"z":2.982,"el":"O"},{"x":-3.491,"y":0.567,"z":-0.663,"el":"C"},{"x":-2.928,"y":0.294,"z":0.755,"el":"C"},{"x":-3.378,"y":-0.721,"z":-1.528,"el":"C"},{"x":-2.8,"y":1.789,"z":-1.322,"el":"C"},{"x":-2.945,"y":1.581,"z":1.601,"el":"C"},{"x":-2.211,"y":2.74,"z":0.934,"el":"C"},{"x":-2.81,"y":3.027,"z":-0.434,"el":"C"},{"x":-1.593,"y":-0.422,"z":0.655,"el":"C"},{"x":-1.234,"y":-1.096,"z":-0.523,"el":"C"},{"x":-4.215,"y":-1.887,"z":-0.963,"el":"C"},{"x":-3.864,"y":-0.476,"z":-2.968,"el":"C"},{"x":-0.713,"y":-0.49,"z":1.748,"el":"C"},{"x":-0.004,"y":-1.757,"z":-0.623,"el":"C"},{"x":0.868,"y":-1.787,"z":0.462,"el":"C"},{"x":2.172,"y":-2.5,"z":0
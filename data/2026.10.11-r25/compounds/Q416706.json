{"version":"2026.10.11-r25","id":"Q416706","formula":"C₁₉H₁₇NO₇","hill":"C19H17NO7","elements":["H","C","N","O"],"composition":{"C":19.0,"H":17.0,"N":1.0,"O":7.0},"names":{"en":"Nedocromil"},"descriptions":{"en":"Nedocromil sodium is a medication considered a mast cell stabilizer which acts to prevent wheezing, shortness of breath, and other breathing problems caused by asthma. It is administered by an inhaler under the brand name Tilade, and as an eye drop under the brand name Alocril. The effects of nedocromil versus asthma are gradual rather than fast-acting and it is not indicated for acute respiratory distress compared to fast acting bronchodilators like albuterol or other well-known inhaler medications."},"fame":21,"pubchemCid":50294,"mass":371.3,"charge":0,"smiles":"CCCC1=C2C(=CC3=C1OC(=CC3=O)C(=O)O)C(=O)C=C(N2CC)C(=O)O","inchikey":"RQTOOFIXOKYGAN-UHFFFAOYSA-N","iupac":"9-ethyl-4,6-dioxo-10-propylpyrano[3,2-g]quinoline-2,8-dicarboxylic acid","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"50294","atoms":44,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":2.546,"y":0.669,"z":0.091,"el":"O"},{"x":-2.206,"y":-3.565,"z":-0.068,"el":"O"},{"x":2.856,"y":-3.39,"z":-0.116,"el":"O"},{"x":-5.011,"y":0.632,"z":-1.475,"el":"O"},{"x":-5.535,"y":0.583,"z":0.751,"el":"O"},{"x":4.601,"y":2.165,"z":0.151,"el":"O"},{"x":6.104,"y":0.444,"z":0.053,"el":"O"},{"x":-2.309,"y":0.506,"z":0.141,"el":"N"},{"x":-1.038,"y":-0.134,"z":0.087,"el":"C"},{"x":0.183,"y":0.568,"z":0.108,"el":"C"},{"x":-0.966,"y":-1.544,"z":0.0,"el":"C"},{"x":0.286,"y":2.056,"z":0.277,"el":"C"},{"x":1.41,"y":-0.104,"z":0.063,"el":"C"},{"x":1.447,"y":-1.492,"z":-0.008,"el":"C"},{"x":0.261,"y":-2.222,"z":-0.043,"el":"C"},{"x":-2.312,"y":1.948,"z":0.395,"el":"C"},{"x":-3.457,"y":-0.261,"z":-0.034,"el":"C"},{"x":0.255,"y":2.788,"z":-1.0
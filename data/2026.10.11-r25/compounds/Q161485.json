{"version":"2026.10.11-r25","id":"Q161485","formula":"C₂O₄","hill":"C2O4","elements":["C","O"],"composition":{"C":2.0,"O":4.0},"names":{"en":"1,2-dioxetanedione"},"descriptions":{"en":"The chemical compound 1,2-dioxetanedione, or 1,2-dioxacyclobutane-3,4-dione, often called peroxyacid ester, is an unstable oxide of carbon (an oxocarbon) with formula C2O4. It can be viewed as a double ketone of 1,2-dioxetane (1,2-dioxacyclobutane), or a cyclic dimer of carbon dioxide. In ordinary conditions, it quickly decomposes to carbon dioxide (CO2) even at 180 K (−93.1 °C), but can be detected by mass spectrometry and other techniques."},"fame":16,"pubchemCid":14833747,"mass":88.02,"charge":0,"smiles":"C1(=O)C(=O)OO1","inchikey":"WYNZXNXFHYJUTE-UHFFFAOYSA-N","iupac":"dioxetane-3,4-dione","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"14833747","atoms":6,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":0.747,"y":1.184,"z":0.0,"el":"O"},{"x":-0.746,"y":1.184,"z":0.0,"el":"O"},{"x":1.552,"y":-1.029,"z":0.0,"el":"O"},{"x":-1.552,"y":-1.029,"z":0.0,"el":"O"},{"x":0.735,"y":-0.155,"z":0.0,"el":"C"},{"x":-0.736,"y":-0.155,"z":0.001,"el":"C"}],"bonds":[[0,1,1],[0,4,1],[1,5,1],[2,4,2],[3,5,2],[4,5,1]]},"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q161485","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/1%2C2-Dioxetanedione","license":"CC BY-SA 4.0"},{"role":"properties","name":"PubChem","url":"https://pubchem.ncbi.nlm.nih.gov/compound/14833747","license":"PubChem (NIH), public data"},{"role":"structure","name":"PubChem 3D","url":"https://pubchem.ncbi.nlm.nih.gov/compound/14833747#section=3D-Conformer","license":"PubChem (NIH), public data"}],"similar":[{"id":"Q1997","formula":"CO₂","names":{"en":"Carbon dioxide",
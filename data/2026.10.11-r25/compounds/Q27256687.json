{"version":"2026.10.11-r25","id":"Q27256687","formula":"C₁₃H₁₅N","hill":"C13H15N","elements":["H","C","N"],"composition":{"C":13.0,"H":15.0,"N":1.0},"names":{"en":"N-methyl-N-2-propynyl-1-indanamine"},"descriptions":{"en":"SU-11739 (other developmental code names AGN-1133, J-508; also known as N-methyl-N-propargyl-1-aminoindane) is an experimental monoamine oxidase inhibitor (MAOI) that was never marketed. It is a dual or non-selective irreversible monoamine oxidase A (MAO-A) and monoamine oxidase B (MAO-B) inhibitor, with preference for inhibition of MAO-B over MAO-A. It is less selective for MAO-B inhibition than AGN-1135 (racemic rasagiline) or rasagiline. In addition to its MAOI activity, SU-11739 has been reported to have strong activity as a catecholamine releasing agent."},"fame":2,"pubchemCid":15179,"mass":185.26,"charge":0,"smiles":"CN(CC#C)C1CCC2=CC=CC=C12","inchikey":"CSVGVHNFFZWQJU-UHFFFAOYSA-N","iupac":"N-methyl-N-prop-2-ynyl-2,3-dihydro-1H-inden-1-amine","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"15179","atoms":29,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-1.407,"y":0.157,"z":-0.072,"el":"N"},{"x":-0.322,"y":-0.345,"z":-0.908,"el":"C"},{"x":-0.147,"y":-1.871,"z":-0.75,"el":"C"},{"x":0.844,"y":-2.092,"z":0.405,"el":"C"},{"x":1.026,"y":0.132,"z":-0.444,"el":"C"},{"x":1.685,"y":-0.86,"z":0.296,"el":"C"},{"x":1.608,"y":1.374,"z":-0.646,"el":"C"},{"x":2.93,"y":-0.627,"z":0.855,"el":"C"},{"x":-2.696,"y":-0.378,"z":-0.52,"el":"C"},{"x":-1.436,"y":1.621,"z":-0.084,"el":"C"},{"x":2.869,"y":1.613,"z":-0.096,"el":"C"},{"x":3.525,"y":0.62,"z":0.649,"el":"C"},{"x":-3.79,"y":0.124,"z":0.317,"el":"C"},{"x":-4.69,"y":0.532,"z":0.999,"el":"C"},{"x":-0.471,"y":-0.097,"z":-1.967,"el":"H"},{"x":0.317,"y":-2.252,"z":-1.673,"el":"H"},{"x":-1.048,"y":-2.471,"z":-0.618,"el":"H"},{"x":
{"version":"2026.10.11-r25","id":"Q7089956","formula":"C₂₀H₂₄FN₅O₃","hill":"C20H24FN5O3","elements":["H","C","N","O","F"],"composition":{"C":20.0,"F":1.0,"H":24.0,"N":5.0,"O":3.0},"names":{"en":"Omecamtiv mecarbil"},"descriptions":{"en":"Omecamtiv mecarbil (INNTooltip International Nonproprietary Name), previously referred to as CK-1827452, is a calcium sensitizer acting as a cardiac myosin activator. It is an experimental drug being studied for a potential role in the treatment of left ventricular systolic heart failure. Systolic heart failure involves a loss of effective actin-myosin cross bridges in the myocytes (heart muscle cells) of the left ventricle, which leads to a decreased ability of the heart to move blood through the body."},"fame":4,"pubchemCid":11689883,"mass":401.4,"charge":0,"smiles":"CC1=NC=C(C=C1)NC(=O)NC2=CC=CC(=C2F)CN3CCN(CC3)C(=O)OC","inchikey":"RFUBTTPMWSKEIW-UHFFFAOYSA-N","iupac":"methyl 4-[[2-fluoro-3-[(6-methyl-3-pyridinyl)carbamoylamino]phenyl]methyl]piperazine-1-carboxylate","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"11689883","atoms":53,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-0.206,"y":0.596,"z":-2.01,"el":"F"},{"x":-6.894,"y":-2.517,"z":0.753,"el":"O"},{"x":-8.196,"y":-1.204,"z":-0.592,"el":"O"},{"x":3.577,"y":0.703,"z":1.332,"el":"O"},{"x":-3.839,"y":1.205,"z":-0.362,"el":"N"},{"x":-6.127,"y":-0.436,"z":0.135,"el":"N"},{"x":2.087,"y":0.487,"z":-0.464,"el":"N"},{"x":4.268,"y":-0.239,"z":-0.694,"el":"N"},{"x":7.477,"y":-0.535,"z":1.081,"el":"N"},{"x":-5.038,"y":1.326,"z":-1.204,"el":"C"},{"x":-3.671,"y":-0.181,"z":0.1,"el":"C"},{"x":-6.287,"y":0.9,"z":-0.434,"el":"C"},{"x":-4.893,"y":-0.643,"z":0.896,"el":"C"},{"x":-2.652,"y":1.65,"z":-1.092,"el":"C"},{"x":-1.415,"y":1.599,"z":-0.236,"el":"C"},{"x":-7.158,"y":-1.374,"z":0.046,"el":"C"},{"x":-
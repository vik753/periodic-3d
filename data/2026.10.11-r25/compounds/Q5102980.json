{"version":"2026.10.11-r25","id":"Q5102980","formula":"C₂₃H₂₉ClO₄","hill":"C23H29ClO4","elements":["H","C","O","Cl"],"composition":{"C":23.0,"H":29.0,"O":4.0,"Cl":1.0},"names":{"en":"Chlormadinone acetate"},"descriptions":{"en":"Chlormadinone acetate (CMA), sold under the brand names Belara, Gynorelle, Lutéran, and Prostal among others, is a progestin and antiandrogen medication which is used in birth control pills to prevent pregnancy, as a component of menopausal hormone therapy, in the treatment of gynecological disorders, and in the treatment of androgen-dependent conditions like enlarged prostate and prostate cancer in men and acne and hirsutism in women. It is available both at a low dose in combination with an estrogen in birth control pills and, in a few countries like France and Japan, at low, moderate, and high doses alone for various indications. It is taken by mouth."},"fame":7,"pubchemCid":9324,"mass":404.9,"charge":0,"smiles":"CC(=O)[C@]1(CC[C@@H]2[C@@]1(CC[C@H]3[C@H]2C=C(C4=CC(=O)CC[C@]34C)Cl)C)OC(=O)C","inchikey":"QMBJSIBWORFWQT-DFXBJWIESA-N","iupac":"[(8R,9S,10R,13S,14S,17R)-17-acetyl-6-chloro-10,13-dimethyl-3-oxo-2,8,9,11,12,14,15,16-octahydro-1H-cyclopenta[a]phenanthren-17-yl] acetate","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"9324","atoms":57,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":3.485,"y":-3.427,"z":-0.324,"el":"Cl"},{"x":-3.156,"y":-0.038,"z":1.247,"el":"O"},{"x":-5.159,"y":0.406,"z":-1.288,"el":"O"},{"x":6.56,"y":0.372,"z":1.441,"el":"O"},{"x":-5.253,"y":-1.001,"z":1.136,"el":"O"},{"x":-1.707,"y":0.517,"z":-0.654,"el":"C"},{"x":-0.858,"y":-0.76,"z":-0.414,"el":"C"},{"x":0.597,"y":-0.592,"z":-0.875,"el":"C"},{"x":1.232,"y":0.56,"z":-0.042,"el":"C"},{"x":-3.087,"y":-0.001,"z":-0.176,"el":"C"},{"x":-1.08,"y":1.662,"z":0.161,"el":"C"},{"x":-1.712,"y":
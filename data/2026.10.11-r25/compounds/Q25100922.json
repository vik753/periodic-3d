{"version":"2026.10.11-r25","id":"Q25100922","formula":"C₁₅H₁₀O₅","hill":"C15H10O5","elements":["H","C","O"],"composition":{"C":15.0,"H":10.0,"O":5.0},"names":{"en":"7,8,3'-trihydroxyflavone"},"descriptions":{"en":"7,8,3′-Trihydroxyflavone (7,8,3'-THF) is a flavone and small-molecule agonist of TrkB, the main receptor of brain-derived neurotrophic factor (BDNF), that was derived from tropoflavin (7,8-DHF). Relative to tropoflavin, 7,8,3'-THF is 2–3-fold more potent in vitro as a TrkB agonist. 7,3'-Dihydroxyflavone (7,3'-DHF) is also more potent than tropoflavin in vitro, indicating that a 3'-hydroxy group on the B-ring enhances TrkB agonistic activity."},"fame":2,"pubchemCid":676310,"mass":270.24,"charge":0,"smiles":"C1=CC(=CC(=C1)O)C2=CC(=O)C3=C(O2)C(=C(C=C3)O)O","inchikey":"ZJZSQGDOCUHCCW-UHFFFAOYSA-N","iupac":"7,8-dihydroxy-2-(3-hydroxyphenyl)chromen-4-one","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"676310","atoms":30,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-0.129,"y":-0.434,"z":0.105,"el":"O"},{"x":-1.738,"y":-2.606,"z":0.308,"el":"O"},{"x":-1.626,"y":3.327,"z":-0.354,"el":"O"},{"x":-4.489,"y":-2.332,"z":0.207,"el":"O"},{"x":4.429,"y":-2.385,"z":-0.761,"el":"O"},{"x":-2.065,"y":1.018,"z":-0.109,"el":"C"},{"x":-1.486,"y":-0.24,"z":0.048,"el":"C"},{"x":0.701,"y":0.671,"z":-0.007,"el":"C"},{"x":2.14,"y":0.35,"z":0.072,"el":"C"},{"x":-1.187,"y":2.194,"z":-0.218,"el":"C"},{"x":0.265,"y":1.932,"z":-0.155,"el":"C"},{"x":-2.296,"y":-1.371,"z":0.155,"el":"C"},{"x":-3.454,"y":1.156,"z":-0.16,"el":"C"},{"x":-3.684,"y":-1.238,"z":0.104,"el":"C"},{"x":-4.261,"y":0.023,"z":-0.053,"el":"C"},{"x":2.612,"y":-0.881,"z":-0.389,"el":"C"},{"x":3.036,"y":1.277,"z":0.611,"el":"C"},{"x":3.972,"y":-1.183,"z":-0.313,"el":"C"},{"x":4.396,"y":0.975,"z":0.687,"el":"C"},{"x":4.864,"y":-0.255,"z":0.
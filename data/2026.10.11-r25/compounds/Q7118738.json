{"version":"2026.10.11-r25","id":"Q7118738","formula":"C₁₁H₁₉NO₂","hill":"C11H19NO2","elements":["H","C","N","O"],"composition":{"C":11.0,"H":19.0,"N":1.0,"O":2.0},"names":{"en":"Pd-217014"},"descriptions":{"en":"PD-217,014 is a drug developed by Pfizer and related to gabapentin, which similarly binds to the α2δ calcium channels (1 and 2). It was developed as a potentially more potent successor to gabapentin and pregabalin, along with several other analogues such as atagabalin and 4-methylpregabalin, but while PD-217,014 produces visceral analgesic effects in animal studies with higher potency and efficacy than gabapentin, it was not developed further for clinical use because of its comparatively more complex synthesis, compared to other related analogues."},"fame":4,"pubchemCid":10313401,"mass":183.25,"charge":0,"smiles":"C1C[C@@H]2[C@H]1CC(C2)(CC(=O)O)CN","inchikey":"NDDZVQRQVFTNSN-JWHQNHQBSA-N","iupac":"2-[(1S,5R)-3-(aminomethyl)-3-bicyclo[3.2.0]heptanyl]acetic acid","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":null,"structure":null,"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q7118738","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/PD-217%2C014","license":"CC BY-SA 4.0"},{"role":"properties","name":"PubChem","url":"https://pubchem.ncbi.nlm.nih.gov/compound/10313401","license":"PubChem (NIH), public data"}],"similar":[{"id":"Q409468","formula":"C₁₅H₂₅NO₃","names":{"en":"(RS)-metoprolol","ru":"Метопролол","uk":"Метопролол"},"elements":["H","C","N","O"],"fame":40,"kind":"molecule"},{"id":"Q794162","formula":"C₁₈H₂₉NO₃","names":{"en":"Betaxolol","ru":"Бетаксолол","uk":"Бетаксолол"},"elements":["H","C","N","O"],"fame":24,"kind":"molecule"},{"id":"Q414904","formula":"C₃₀H₅₃N₃O₆","names":{"en":"Aliskiren","uk":"Аліскірен"},"elements":["H","C","N","O"],"fame":23,"kind":"m
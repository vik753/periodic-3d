{"version":"2026.10.11-r25","id":"Q15410156","formula":"C₁₂H₁₄N₄O₃","hill":"C12H14N4O3","elements":["H","C","N","O"],"composition":{"C":12.0,"H":14.0,"N":4.0,"O":3.0},"names":{"en":"3-deazaneplanocin"},"descriptions":{"en":"3-Deazaneplanocin A (DZNep, C-c3Ado) is a drug which acts as both a S-adenosylhomocysteine synthesis inhibitor and also a histone methyltransferase EZH2 inhibitor. Studies have shown that it has effects in vitro against a variety of different tumor cell lines. In studies on mice, the drug was also found to be effective for the treatment of Ebola virus disease, apparently interfering with the Ebola viruses ability to block interferon production, thus restoring the ability of immune system to rid the body of ebolavirus."},"fame":5,"pubchemCid":73087,"mass":262.26,"charge":0,"smiles":"C1=CN=C(C2=C1N(C=N2)[C@@H]3C=C([C@H]([C@H]3O)O)CO)N","inchikey":"OMKHWTRUYNAGFG-IEBDPFPHSA-N","iupac":"(1S,2R,5R)-5-(4-aminoimidazo[4,5-c]pyridin-1-yl)-3-(hydroxymethyl)cyclopent-3-ene-1,2-diol","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"73087","atoms":33,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":2.159,"y":2.468,"z":0.806,"el":"O"},{"x":4.168,"y":0.815,"z":1.151,"el":"O"},{"x":4.328,"y":-2.222,"z":-0.51,"el":"O"},{"x":-0.355,"y":0.012,"z":0.027,"el":"N"},{"x":-1.619,"y":-1.634,"z":0.825,"el":"N"},{"x":-4.382,"y":0.501,"z":-0.412,"el":"N"},{"x":-4.617,"y":-1.613,"z":0.676,"el":"N"},{"x":0.855,"y":0.766,"z":-0.309,"el":"C"},{"x":1.755,"y":1.101,"z":0.899,"el":"C"},{"x":2.966,"y":0.155,"z":0.799,"el":"C"},{"x":2.944,"y":-0.284,"z":-0.637,"el":"C"},{"x":1.782,"y":0.024,"z":-1.227,"el":"C"},{"x":-1.65,"y":0.387,"z":-0.227,"el":"C"},{"x":4.069,"y":-1.038,"z":-1.25,"el":"C"},{"x":-0.39,"y":-1.202,"z":0.656,"el":"C"},{"x":-2.418,"y":-0.657,"z":0.28,"el":"C"},{"x":-2.2,"y":1.507,"z":-0.
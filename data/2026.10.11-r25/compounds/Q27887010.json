{"version":"2026.10.11-r25","id":"Q27887010","formula":"C₅H₇NO₃","hill":"C5H7NO3","elements":["H","C","N","O"],"composition":{"C":5.0,"H":7.0,"N":1.0,"O":3.0},"names":{"en":"(RS)-pyroglutamic acid"},"descriptions":{"en":"Pyroglutamic acid (also known as PCA, 5-oxoproline, pidolic acid) is a ubiquitous but understudied natural amino acid derivative in which the free amino group of glutamic acid or glutamine cyclizes to form a lactam. The names of pyroglutamic acid conjugate base, anion, salts, and esters are pyroglutamate, 5-oxoprolinate, or pidolate. It is a metabolite in the glutathione cycle that is converted to glutamate by 5-oxoprolinase."},"fame":21,"pubchemCid":499,"mass":129.11,"charge":0,"smiles":"C1CC(=O)NC1C(=O)O","inchikey":"ODHCTXKNWHHXJC-UHFFFAOYSA-N","iupac":"5-oxopyrrolidine-2-carboxylic acid","classes":[{"qid":"Q59199015","names":{"en":"group of stereoisomers","ru":"группа стереоизомеров","uk":"група стереоізомерів"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"499","atoms":16,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-2.694,"y":0.78,"z":0.178,"el":"O"},{"x":2.671,"y":-0.394,"z":0.17,"el":"O"},{"x":1.423,"y":1.479,"z":0.532,"el":"O"},{"x":-0.609,"y":0.537,"z":-0.859,"el":"N"},{"x":0.521,"y":-0.344,"z":-0.768,"el":"C"},{"x":-0.033,"y":-1.573,"z":-0.072,"el":"C"},{"x":-1.197,"y":-1.041,"z":0.763,"el":"C"},{"x":-1.638,"y":0.19,"z":0.01,"el":"C"},{"x":1.555,"y":0.366,"z":0.045,"el":"C"},{"x":0.907,"y":-0.543,"z":-1.772,"el":"H"},{"x":0.695,"y":-2.116,"z":0.538,"el":"H"},{"x":-0.425,"y":-2.271,"z":-0.823,"el":"H"},{"x":-0.868,"y":-0.743,"z":1.763,"el":"H"},{"x":-2.009,"y":-1.768,"z":0.837,"el":"H"},{"x":-0.642,"y":1.353,"z":-1.462,"el":"H"},{"x":3.362,"y":0.055,"z":0.702,"el":"H"}],"bonds":[[0,7,2],[1,8,1],[1,15,1],[2,8,2],[3,4,1],[3,7,1],[3,14,1],[4,5,1],[4,8,1],[4,9,1],[5,6,1],[5,10,1],[5,11,1],[6,7,1],[6,12,1],[6,13,1]]},"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikid
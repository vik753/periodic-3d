{"version":"2026.10.11-r25","id":"Q137662125","formula":"C₁₀H₁₃NOS","hill":"C10H13NOS","elements":["H","C","N","O","S"],"composition":{"C":10.0,"H":13.0,"N":1.0,"O":1.0,"S":1.0},"names":{"en":"SDA"},"descriptions":{"en":"SDA, also known as 3,4-methylenethiooxyamphetamine (3T-MDA), is a putative entactogen and psychedelic drug of the phenethylamine and amphetamine families related to 3,4-methylenedioxyamphetamine (MDA). It is the analogue of MDA in which the oxygen atom at the 3 position within the 3,4-methylenedioxy substitution has been replaced with a sulfur atom to give a 1,3-benzoxathiole rather than 1,3-benzodioxole ring system. The drug is also the N-desmethyl analogue of 3,4-methylenethiooxy-N-methylamphetamine (SDMA; 3T-MDMA)."},"fame":1,"pubchemCid":117285706,"mass":195.28,"charge":0,"smiles":"CC(CC1=CC2=C(C=C1)OCS2)N","inchikey":"OXGJJEZWSWXUNB-UHFFFAOYSA-N","iupac":"1-(1,3-benzoxathiol-5-yl)propan-2-amine","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"rdkit","ref":"117285706","atoms":26,"license":"Computed with RDKit from SMILES (PubChem, Wikidata)"},"structure":{"kind":"molecule","atoms":[{"x":-3.607,"y":1.098,"z":0.303,"el":"C"},{"x":-2.344,"y":0.237,"z":0.366,"el":"C"},{"x":-1.36,"y":0.641,"z":-0.753,"el":"C"},{"x":0.054,"y":0.155,"z":-0.521,"el":"C"},{"x":0.999,"y":0.996,"z":0.088,"el":"C"},{"x":2.287,"y":0.526,"z":0.296,"el":"C"},{"x":2.649,"y":-0.76,"z":-0.084,"el":"C"},{"x":1.732,"y":-1.609,"z":-0.681,"el":"C"},{"x":0.431,"y":-1.148,"z":-0.897,"el":"C"},{"x":3.938,"y":-1.168,"z":0.149,"el":"O"},{"x":4.654,"y":-0.088,"z":0.785,"el":"C"},{"x":3.631,"y":1.378,"z":1.026,"el":"S"},{"x":-2.728,"y":-1.177,"z":0.265,"el":"N"},{"x":-4.122,"y":0.986,"z":-0.657,"el":"H"},{"x":-4.309,"y":0.827,"z":1.099,"el":"H"},{"x":-3.358,"y":2.157,"z":0.431,"el":"H"},{"x":-1.87,"y":0.392,"z":1.343,"el":"H"},{"x":-1.335,"y":1.736,"z":-0.843,"e
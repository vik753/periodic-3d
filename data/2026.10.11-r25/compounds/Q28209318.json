{"version":"2026.10.11-r25","id":"Q28209318","formula":"C₁₈H₂₀O₂","hill":"C18H20O2","elements":["H","C","O"],"composition":{"C":18.0,"H":20.0,"O":2.0},"names":{"en":"17β-dihydroequilenin"},"descriptions":{"en":"17β-Dihydroequilenin, or β-dihydroequilenin, also known as δ6,8-17β-estradiol or 6,8-didehydro-17β-estradiol, as well as estra-1,3,5(10),6,8-pentaen-3,17β-diol, is a naturally occurring steroidal estrogen found in horses which is closely related to equilin, equilenin, and estradiol, and, as the 3-sulfate ester sodium salt, is a minor constituent (0.5%) of conjugated estrogens (Premarin). 17β-Dihydroequilenin has unexpectedly shown a selective estrogen receptor modulator (SERM)-like profile of estrogenic activity in studies with monkeys, in which beneficial effects on bone and the cardiovascular system were noted but proliferative responses in breast and endometrium were not observed."},"fame":1,"pubchemCid":3032407,"mass":268.3,"charge":0,"smiles":"C[C@]12CCC3=C([C@@H]1CC[C@@H]2O)C=CC4=C3C=CC(=C4)O","inchikey":"RYWZPRVUQHMJFF-BZSNNMDCSA-N","iupac":"(13S,14S,17S)-13-methyl-11,12,14,15,16,17-hexahydrocyclopenta[a]phenanthrene-3,17-diol","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"3032407","atoms":40,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-5.014,"y":-1.126,"z":0.41,"el":"O"},{"x":5.837,"y":-0.087,"z":0.311,"el":"O"},{"x":-2.623,"y":-0.575,"z":0.081,"el":"C"},{"x":-1.987,"y":0.709,"z":-0.487,"el":"C"},{"x":-4.095,"y":-0.321,"z":-0.303,"el":"C"},{"x":-2.914,"y":1.813,"z":0.029,"el":"C"},{"x":-1.97,"y":-1.751,"z":-0.65,"el":"C"},{"x":-4.314,"y":1.171,"z":0.013,"el":"C"},{"x":-0.501,"y":0.767,"z":-0.268,"el":"C"},{"x":-0.449,"y":-1.783,"z":-0.418,"el":"C"},{"x":-2.48,"y":-0.747,"z":1.614,"el":"C"},{"x":0.256,"y":-0.433,"z":-0.293,"el":"C"},{"x":0.151,"y":1.995,"z":-0.13,"e
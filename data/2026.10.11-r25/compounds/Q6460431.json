{"version":"2026.10.11-r25","id":"Q6460431","formula":"C₇H₉NO₆S","hill":"C7H9NO6S","elements":["H","C","N","O","S"],"composition":{"C":7.0,"H":9.0,"N":1.0,"O":6.0,"S":1.0},"names":{"en":"Pomaglumetad"},"descriptions":{"en":"Pomaglumetad (LY-404,039) is an amino acid analog drug that acts as a highly selective agonist for the metabotropic glutamate receptor group II subtypes mGluR2 and mGluR3. Pharmacological research has focused on its potential antipsychotic and anxiolytic effects. Pomaglumetad is intended as a treatment for schizophrenia and other psychotic and anxiety disorders by modulating glutamatergic activity and reducing presynaptic release of glutamate at synapses in limbic and forebrain areas relevant to these disorders."},"fame":5,"pubchemCid":9834591,"mass":235.22,"charge":0,"smiles":"C1[C@]([C@@H]2[C@H]([C@@H]2S1(=O)=O)C(=O)O)(C(=O)O)N","inchikey":"AVDUGNCTZRCAHH-MDASVERJSA-N","iupac":"(1R,4S,5S,6S)-4-amino-2,2-dioxo-2lambda6-thiabicyclo[3.1.0]hexane-4,6-dicarboxylic acid","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"9834591","atoms":24,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-0.393,"y":1.881,"z":0.074,"el":"S"},{"x":0.359,"y":2.822,"z":0.875,"el":"O"},{"x":-1.283,"y":2.295,"z":-0.99,"el":"O"},{"x":3.682,"y":0.277,"z":-0.507,"el":"O"},{"x":3.125,"y":-1.868,"z":0.026,"el":"O"},{"x":-3.359,"y":-0.941,"z":0.175,"el":"O"},{"x":-2.043,"y":-1.132,"z":-1.676,"el":"O"},{"x":-1.086,"y":-1.737,"z":1.456,"el":"N"},{"x":0.285,"y":-0.656,"z":-0.247,"el":"C"},{"x":0.785,"y":0.708,"z":-0.653,"el":"C"},{"x":1.542,"y":-0.089,"z":0.367,"el":"C"},{"x":-1.042,"y":-0.656,"z":0.478,"el":"C"},{"x":-1.245,"y":0.714,"z":1.142,"el":"C"},{"x":2.842,"y":-0.681,"z":-0.044,"el":"C"},{"x":-2.171,"y":-0.937,"z":-0.477,"el":"C"},{"x":0.405,"y":-1.481,"z":-0.941,"el":"H"},{"x":1.163,"y":0.859,"
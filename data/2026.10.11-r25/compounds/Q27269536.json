{"version":"2026.10.11-r25","id":"Q27269536","formula":"C₃₄H₅₅NO₃","hill":"C34H55NO3","elements":["H","C","N","O"],"composition":{"C":34.0,"H":55.0,"N":1.0,"O":3.0},"names":{"en":"ICI-164384"},"descriptions":{"en":"ICI-164384, also known as N-n-butyl-N-methyl-11-(3,17β-dihydroxyestra-1,3,5(10)-trien-7α-yl)undecanamide, is a steroidal antiestrogen and a synthetic derivative of estradiol which is closely related to fulvestrant and was never marketed. It is a silent antagonist of the estrogen receptor (ER) with no intrinsic estrogenic activity and hence is a pure antiestrogen, unlike selective estrogen receptor modulators (SERMs) like tamoxifen. The drug was under development by AstraZeneca for the treatment of breast cancer but was discontinued in favor of fulvestrant, which is very similar to ICI-164384 but is more potent in comparison."},"fame":2,"pubchemCid":104772,"mass":525.8,"charge":0,"smiles":"CCCCN(C)C(=O)CCCCCCCCCC[C@@H]1CC2=C(C=CC(=C2)O)[C@@H]3[C@@H]1[C@@H]4CC[C@@H]([C@]4(CC3)C)O","inchikey":"BVVFOLSZMQVDKV-KXQIQQEYSA-N","iupac":"N-butyl-11-[(7R,8R,9S,13S,14S,17S)-3,17-dihydroxy-13-methyl-6,7,8,9,11,12,14,15,16,17-decahydrocyclopenta[a]phenanthren-7-yl]-N-methylundecanamide","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"104772","atoms":93,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":6.202,"y":-4.501,"z":1.043,"el":"O"},{"x":3.537,"y":6.0,"z":-0.692,"el":"O"},{"x":-8.594,"y":0.852,"z":-0.337,"el":"O"},{"x":-7.329,"y":0.969,"z":1.604,"el":"N"},{"x":3.77,"y":-1.863,"z":0.391,"el":"C"},{"x":5.239,"y":-2.267,"z":0.635,"el":"C"},{"x":3.556,"y":-0.352,"z":0.514,"el":"C"},{"x":4.415,"y":0.359,"z":-0.577,"el":"C"},{"x":6.102,"y":-1.601,"z":-0.445,"el":"C"},{"x":5.101,"y":-3.796,"z":0.505,"el":"C"},{"x":2.988,"y":-2.807,"z":1.299,"el":"C"},{"x":2.08,"y":0.089,"z":0.443,"el":"C"},{"
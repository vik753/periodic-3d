{"version":"2026.10.11-r25","id":"Q3952187","formula":"NaCa₃(UO₂)(SO₄)(CO₃)₃F·10H₂O","hill":"C3H20Ca3FNaO25SU","elements":["H","C","O","F","Na","S","Ca","U"],"composition":{"C":3.0,"F":1.0,"H":20.0,"O":25.0,"S":1.0,"U":1.0,"Ca":3.0,"Na":1.0},"names":{"en":"Schröckingerite","ru":"Шрекингерит","uk":"Шрекінгерит"},"descriptions":{"en":"Schröckingerite is a radioactive yellow uranium-containing carbonate mineral, hydrated sodium calcium uranyl sulfate carbonate fluoride. Schröckingerite crystallizes in the orthorhombic system, occurring as globular clusters, and fluoresces yellow-green under ultraviolet light. Schröckingerite was first described in 1783 from an occurrence in Jáchymov, Bohemia, Czech Republic, and named for its discoverer, Julius Freiherr Schröckinger von Neudenberg (1814–1882).","ru":"Шрёкингери́т — ураносодержащий минерал класса карбонатов. Водный сульфаткарбонатфлуорит урана, натрия и кальция. Встречается в виде шаровых скоплений и налётов в непосредственной близости с другими урановыми минералами.","uk":"Шрекінгерит (рос. шрекингерит; англ. schroeckingerite; нім."},"fame":11,"pubchemCid":null,"mass":null,"charge":0,"smiles":null,"inchikey":null,"iupac":null,"classes":[{"qid":"Q12089225","names":{"en":"mineral species","ru":"действительный вид минералов","uk":"мінеральний вид"}}],"structureInfo":null,"structure":null,"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q3952187","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Schr%C3%B6ckingerite","license":"CC BY-SA 4.0"},{"role":"description","name":"Wikipedia (ru)","url":"https://ru.wikipedia.org/wiki/%D0%A8%D1%80%D0%B5%D0%BA%D0%B8%D0%BD%D0%B3%D0%B5%D1%80%D0%B8%D1%82","license":"CC BY-SA 4.0"},{"role":"description","name":"Wikipedia (uk)","url":"https://uk.wikipedia.org/wiki/%D0%A8%D1%80%D0%B5%D0%BA%D1%96%D0%BD%D0%B3%D0%B5%D1%80%D0%B8%D1%82","license":"CC BY-SA 4.0"},{"role":"photo","name":"Wikimedia Commons","u
{"version":"2026.10.11-r25","id":"Q6647963","formula":"C₅H₃LiN₂O₄","hill":"C5H3LiN2O4","elements":["H","Li","C","N","O"],"composition":{"C":5.0,"H":3.0,"N":2.0,"O":4.0,"Li":1.0},"names":{"en":"Lithium orotate"},"descriptions":{"en":"Lithium orotate (C5H3LiN2O4) is a salt of orotic acid and lithium. It is marketed as a dietary supplement, and was studied between 1973 and 1986 as a treatment for medical conditions such as alcoholism and Alzheimer's disease. It is available as the monohydrate, LiC5H3N2O4·H2O. In this compound, lithium is non-covalently bound to an orotate ion, rather than to a carbonate or other ion, and like other salts, dissolves in solution to produce free lithium ions."},"fame":8,"pubchemCid":23686432,"mass":162.1,"charge":0,"smiles":"[Li+].C1=C(NC(=O)NC1=O)C(=O)[O-]","inchikey":"IZJGDPULXXNWJP-UHFFFAOYSA-M","iupac":"lithium 2,4-dioxo-1H-pyrimidine-6-carboxylate","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"rdkit","ref":"23686432","atoms":15,"license":"Computed with RDKit from SMILES (PubChem, Wikidata)"},"structure":{"kind":"molecule","atoms":[{"x":-0.029,"y":1.324,"z":-0.133,"el":"C"},{"x":0.513,"y":0.103,"z":-0.068,"el":"C"},{"x":-0.295,"y":-0.999,"z":0.142,"el":"N"},{"x":-1.647,"y":-0.944,"z":0.293,"el":"C"},{"x":-2.347,"y":-1.936,"z":0.478,"el":"O"},{"x":-2.19,"y":0.31,"z":0.224,"el":"N"},{"x":-1.488,"y":1.466,"z":0.021,"el":"C"},{"x":-2.037,"y":2.563,"z":-0.031,"el":"O"},{"x":2.053,"y":-0.098,"z":-0.225,"el":"C"},{"x":2.737,"y":0.944,"z":-0.414,"el":"O"},{"x":2.407,"y":-1.313,"z":-0.138,"el":"O"},{"x":0.557,"y":2.22,"z":-0.295,"el":"H"},{"x":0.191,"y":-1.894,"z":0.18,"el":"H"},{"x":-3.186,"y":0.383,"z":0.332,"el":"H"},{"x":4.758,"y":-2.13,"z":-0.372,"el":"Li"}],"bonds":[[0,1,2.0],[1,2,1.0],[2,3,1.0],[3,4,2.0],[3,5,1.0],[5,6,1.0],[6,7,2.0],[1,8,1.0],[8,9,2.0],[8,10,1.0],[6,0,1.0],[0,11,1.0],[2,12,1.0],[5,13,1.0]
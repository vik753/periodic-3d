{"version":"2026.10.11-r25","id":"Q55318422","formula":"C₃H₈FO₂P","hill":"C3H8FO2P","elements":["H","C","O","F","P"],"composition":{"C":3.0,"F":1.0,"H":8.0,"O":2.0,"P":1.0},"names":{"en":"Ethyl methyl phosphonofluoridate","ru":"Этилзарин"},"descriptions":{"ru":"Этѝлзари́н — боевое отравляющее вещество нервно-паралитического действия. Входит в пункт 1 Список 1 Конвенции по запрещению химического оружия. Таким образом, государство, подписавшее Конвенцию, имеет право изготовлять и использовать этилзарин для исследовательских, медицинских и фармацевтических целях или проверки защиты от химического оружия, но производство более 100 граммов в год должно декларироваться в ОЗХО. Государство ограничено владением максимум одной тонной этилзарина."},"fame":2,"pubchemCid":160541,"mass":126.07,"charge":0,"smiles":"CCOP(=O)(C)F","inchikey":"RIYPSXBGLXRZNJ-UHFFFAOYSA-N","iupac":"1-[fluoro(methyl)phosphoryl]oxyethane","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"160541","atoms":15,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":0.972,"y":-0.056,"z":-0.047,"el":"P"},{"x":1.04,"y":-0.723,"z":1.376,"el":"F"},{"x":-0.574,"y":-0.287,"z":-0.471,"el":"O"},{"x":1.948,"y":-0.727,"z":-0.971,"el":"O"},{"x":-1.61,"y":0.214,"z":0.355,"el":"C"},{"x":1.172,"y":1.712,"z":0.023,"el":"C"},{"x":-2.947,"y":-0.134,"z":-0.265,"el":"C"},{"x":-1.525,"y":-0.23,"z":1.351,"el":"H"},{"x":-1.524,"y":1.3,"z":0.442,"el":"H"},{"x":0.918,"y":2.168,"z":-0.938,"el":"H"},{"x":0.546,"y":2.158,"z":0.8,"el":"H"},{"x":2.212,"y":1.959,"z":0.255,"el":"H"},{"x":-3.772,"y":0.238,"z":0.35,"el":"H"},{"x":-3.031,"y":0.296,"z":-1.268,"el":"H"},{"x":-3.05,"y":-1.219,"z":-0.374,"el":"H"}],"bonds":[[0,1,1],[0,2,1],[0,3,2],[0,5,1],[2,4,1],[4,6,1],[4,7,1],[4,8,1],[5,9,1],[5,10,1],[5,11,1],[6,12,1],[6,13,1],[6,14,1]]},"sources":[{"role":"identity","na
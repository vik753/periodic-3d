{"version":"2026.10.11-r25","id":"Q27155666","formula":"C₁₁H₁₃F₃N₄O₄","hill":"C11H13F3N4O4","elements":["H","C","N","O","F"],"composition":{"C":11.0,"F":3.0,"H":13.0,"N":4.0,"O":4.0},"names":{"en":"Dinitramine"},"descriptions":{"en":"Dinitramine is a preëmergent dinitroaniline herbicide incorporated into soil to control weeds for months after. It is no longer approved in the United States, and is not in the European Union, though in Iran it has been used to control annual grasses and broadleaf weeds in cotton and soybeans, as it was in the U.S. as of 1975, where it was also used on sunflower. Dinitramine is chemically similar to trifluralin and other dinitroanilines, with which it shares many characteristics, such as mode of action and resistance information."},"fame":4,"pubchemCid":34468,"mass":322.24,"charge":0,"smiles":"CCN(CC)C1=C(C=C(C(=C1[N+](=O)[O-])N)C(F)(F)F)[N+](=O)[O-]","inchikey":"OFDYMSKSGFSLLM-UHFFFAOYSA-N","iupac":"3-N,3-N-diethyl-2,4-dinitro-6-(trifluoromethyl)benzene-1,3-diamine","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"34468","atoms":35,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-3.832,"y":-1.729,"z":-0.035,"el":"F"},{"x":-4.037,"y":0.15,"z":1.029,"el":"F"},{"x":-4.021,"y":0.13,"z":-1.146,"el":"F"},{"x":-0.115,"y":3.433,"z":-0.101,"el":"O"},{"x":1.878,"y":2.512,"z":-0.095,"el":"O"},{"x":0.466,"y":-3.57,"z":-0.025,"el":"O"},{"x":2.289,"y":-2.346,"z":-0.043,"el":"O"},{"x":2.245,"y":0.116,"z":-0.069,"el":"N"},{"x":0.63,"y":2.427,"z":-0.091,"el":"N"},{"x":1.041,"y":-2.456,"z":-0.038,"el":"N"},{"x":-2.183,"y":2.158,"z":-0.081,"el":"N"},{"x":0.834,"y":-0.009,"z":-0.065,"el":"C"},{"x":0.031,"y":1.132,"z":-0.075,"el":"C"},{"x":2.967,"y":0.166,"z":-1.321,"el":"C"},{"x":2.971,"y":0.207,"z":1.179,"el":"C"},{"x":0.248,"y":-1.274,"z":-0.049,"el":"C"},{"x":-1.359,"y":1.
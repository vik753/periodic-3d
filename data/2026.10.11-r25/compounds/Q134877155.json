{"version":"2026.10.11-r25","id":"Q134877155","formula":"C₁₂H₁₈INO₂","hill":"C12H18INO2","elements":["H","C","N","O","I"],"composition":{"C":12.0,"H":18.0,"I":1.0,"N":1.0,"O":2.0},"names":{"en":"N-methyl-DOI"},"descriptions":{"en":"N-Methyl-DOI, also known as 2,5-dimethoxy-4-iodo-N-methylamphetamine (2,5-IDNA), is a serotonin receptor modulator of the phenethylamine, amphetamine, and DOx families related to the serotonergic psychedelic DOI. It is a potent agonist of the serotonin 5-HT2A receptor similarly to DOI. However, N-methyl-DOI was about 3.8-fold less potent than DOI as a serotonin 5-HT2A receptor agonist in terms of EC50Tooltip half-maximal effective concentration and showed reduced maximal efficacy compared to DOI (EmaxTooltip maximal efficacy = 64% vs. 83%). On the other hand, it showed similar efficacy in activating the serotonin 5-HT2A receptor to the psychedelic 2C-I (Emax = 68%)."},"fame":1,"pubchemCid":44267102,"mass":335.18,"charge":0,"smiles":"CC(CC1=CC(=C(C=C1OC)I)OC)NC","inchikey":"UFHCKYRPMINDBF-UHFFFAOYSA-N","iupac":"1-(4-iodo-2,5-dimethoxyphenyl)-N-methylpropan-2-amine","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"44267102","atoms":34,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":4.452,"y":0.506,"z":0.614,"el":"I"},{"x":-0.466,"y":2.447,"z":-0.398,"el":"O"},{"x":2.581,"y":-2.123,"z":0.108,"el":"O"},{"x":-3.928,"y":-0.825,"z":0.1,"el":"N"},{"x":-2.659,"y":-0.191,"z":0.47,"el":"C"},{"x":-1.756,"y":-0.084,"z":-0.773,"el":"C"},{"x":-0.289,"y":0.057,"z":-0.446,"el":"C"},{"x":-2.964,"y":1.171,"z":1.091,"el":"C"},{"x":0.285,"y":1.317,"z":-0.274,"el":"C"},{"x":0.494,"y":-1.09,"z":-0.315,"el":"C"},{"x":1.851,"y":-0.977,"z":-0.012,"el":"C"},{"x":1.642,"y":1.429,"z":0.029,"el":"C"},{"x":-3.756,"y":-2.26,"z":-0.059,"el":"C"},{"x":2.425,"y":0.283,"z":0.16,"el":"C"},{"x":0
{"version":"2026.10.11-r25","id":"Q2060696","formula":"C₁₂H₁₁NO","hill":"C12H11NO","elements":["H","C","N","O"],"composition":{"C":12.0,"H":11.0,"N":1.0,"O":1.0},"names":{"en":"Pirfenidone","uk":"Пірфенідон"},"descriptions":{"en":"Pirfenidone, sold under the brand name Esbriet among others, is a medication used for the treatment of idiopathic pulmonary fibrosis. It works by reducing lung fibrosis through downregulation of the production of growth factors and procollagens I and II. It was first approved in Japan for the treatment of people with idiopathic pulmonary fibrosis after clinical trials in 2008. It was approved for use in the European Union in 2011, in Canada in 2012, and in the United States in October 2014.","uk":"Пірфенідон (англ. Pirfenidone, лат. Pirfenidonum) — синтетичний препарат, який відноситься до групи імуносупресантів, та має антифібротичну дію."},"fame":23,"pubchemCid":40632,"mass":185.22,"charge":0,"smiles":"CC1=CN(C(=O)C=C1)C2=CC=CC=C2","inchikey":"ISWRGOKTTBVCFA-UHFFFAOYSA-N","iupac":"5-methyl-1-phenylpyridin-2-one","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"40632","atoms":25,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":0.315,"y":2.412,"z":-0.376,"el":"O"},{"x":0.39,"y":0.074,"z":-0.003,"el":"N"},{"x":-1.05,"y":-0.105,"z":0.014,"el":"C"},{"x":1.241,"y":-1.028,"z":0.116,"el":"C"},{"x":2.578,"y":-0.925,"z":0.117,"el":"C"},{"x":0.936,"y":1.371,"z":-0.165,"el":"C"},{"x":3.18,"y":0.378,"z":-0.003,"el":"C"},{"x":2.426,"y":1.472,"z":-0.126,"el":"C"},{"x":-1.603,"y":-1.286,"z":-0.469,"el":"C"},{"x":-1.863,"y":0.907,"z":0.512,"el":"C"},{"x":3.494,"y":-2.1,"z":0.26,"el":"C"},{"x":-2.987,"y":-1.458,"z":-0.452,"el":"C"},{"x":-3.248,"y":0.735,"z":0.529,"el":"C"},{"x":-3.809,"y":-0.448,"z":0.047,"el":"C"},{"x":0.784,"y":-2.002,"z":0.251,"el":"H"},{"x":4.262,"y":0.459
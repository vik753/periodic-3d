{"version":"2026.10.11-r25","id":"Q1061684","formula":"Pb₃(IO₄)Cl₃","hill":"Cl3IO4Pb3","elements":["O","Cl","I","Pb"],"composition":{"I":1.0,"O":4.0,"Cl":3.0,"Pb":3.0},"names":{"en":"Seeligerite"},"descriptions":{"en":"Seeligerite is a rare complex lead chloride iodate mineral with formula: Pb3Cl3(IO3)O. It is a yellow mineral crystallizing in the orthorhombic system. It has perfect to good cleavage in two directions and a quite high specific gravity of 6.83 due to the lead content. It is translucent to transparent with refractive indices of nα=2.120 nβ=2.320 nγ=2.320."},"fame":9,"pubchemCid":null,"mass":null,"charge":0,"smiles":null,"inchikey":null,"iupac":null,"classes":[{"qid":"Q12089225","names":{"en":"mineral species","ru":"действительный вид минералов","uk":"мінеральний вид"}}],"structureInfo":null,"structure":null,"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q1061684","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Seeligerite","license":"CC BY-SA 4.0"},{"role":"photo","name":"Wikimedia Commons","url":"https://commons.wikimedia.org/wiki/File:Seeligerite-101601.jpg","license":"CC BY-SA 3.0"}],"similar":[{"id":"Q3952202","formula":"Pb₅H₂IO₆Cl₃","names":{"en":"Schwartzembergite","uk":"Шварцембергіт"},"elements":["H","O","Cl","I","Pb"],"fame":5,"kind":null},{"id":"Q3775698","formula":"Pb₂(SO₄)F₂","names":{"en":"Grandreefite"},"elements":["O","F","S","Pb"],"fame":4,"kind":"crystal"},{"id":"Q416246","formula":"Br₂Mn","names":{"en":"Manganese bromide","ru":"Бромид марганца(II)"},"elements":["Mn","Br"],"fame":19,"kind":"crystal"},{"id":"Q417032","formula":"Pb₂CO₃Cl₂","names":{"en":"Phosgenite","ru":"Фосгенит","uk":"Фосгеніт"},"elements":["C","O","Cl","Pb"],"fame":17,"kind":"crystal"},{"id":"Q3855102","formula":"Pb₄₇Cl₂₅(OH)₁₃O₂₄(CO₃)(BO₃)₂","names":{"en":"Mereheadite"},"elements":["H","B","C","O","Cl","Pb"],"fame":6,"kind":null},{"id":"Q1056829","formula":"Pb₃(WO₄)OCl₂","n
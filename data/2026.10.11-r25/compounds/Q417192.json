{"version":"2026.10.11-r25","id":"Q417192","formula":"MgFe(SO₄)₂(OH)·7H₂O","hill":"FeH15MgO16S2","elements":["H","O","Mg","S","Fe"],"composition":{"H":15.0,"O":16.0,"S":2.0,"Fe":1.0,"Mg":1.0},"names":{"en":"Botryogen","uk":"Ботріоген"},"descriptions":{"en":"Botryogen is a hydrous magnesium sulfate mineral with formula: MgFe3+(SO4)2(OH)·7H2O. It is also known as quetenite. It crystallizes in the monoclinic prismatic system and typically occurs as vitreous bright yellow to red botryoidal to reniform masses and radiating crystal prisms. It has a specific gravity in the range 2 to 2.1 and Mohs hardness in the range of 2 to 2.5.","uk":"Ботріоген — мінерал, водний сульфат магнію та заліза."},"fame":13,"pubchemCid":null,"mass":null,"charge":0,"smiles":null,"inchikey":null,"iupac":null,"classes":[{"qid":"Q12089225","names":{"en":"mineral species","ru":"действительный вид минералов","uk":"мінеральний вид"}}],"structureInfo":null,"structure":null,"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q417192","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Botryogen","license":"CC BY-SA 4.0"},{"role":"description","name":"Wikipedia (uk)","url":"https://uk.wikipedia.org/wiki/%D0%91%D0%BE%D1%82%D1%80%D1%96%D0%BE%D0%B3%D0%B5%D0%BD","license":"CC BY-SA 4.0"},{"role":"photo","name":"Wikimedia Commons","url":"https://commons.wikimedia.org/wiki/File:Botryogen_mineralogisches_museum_bonn.jpg","license":"CC BY-SA 3.0"}],"similar":[{"id":"Q651700","formula":"Fe₅H₄₂S₆O₄₆","names":{"en":"Copiapite","uk":"Копіапіт"},"elements":["H","O","S","Fe"],"fame":18,"kind":null},{"id":"Q1067912","formula":"Fe₂(SO₄)₃·11H₂O","names":{"en":"Quenstedtite"},"elements":["H","O","S","Fe"],"fame":11,"kind":null},{"id":"Q3942089","formula":"FeSO₄*4H₂O","names":{"en":"Rozenite","uk":"Розеніт"},"elements":["H","O","S","Fe"],"fame":11,"kind":"crystal"},{"id":"Q3162933","formula":"Fe₂H₁₆S₂O₁₇","names":{"en":"Hohmannite","uk":"Г
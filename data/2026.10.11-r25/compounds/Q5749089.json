{"version":"2026.10.11-r25","id":"Q5749089","formula":"C₁₁H₂₁NO₃","hill":"C11H21NO3","elements":["H","C","N","O"],"composition":{"C":11.0,"H":21.0,"N":1.0,"O":3.0},"names":{"en":"Hexaminolevulinate"},"descriptions":{"en":"Hexaminolevulinate, sold under the brand name Cysview among others, is an imaging agent that lights up under blue light during a blue light cystoscopy. It is used to help detect non-muscle invasive bladder cancer (NMIBC), in particular papillary tumors and carcinoma in situ (CIS). Hexaminolevulinate is a structural analogue to 5-aminolevulinic acid (a precursor to the porphyrin ring of heme), and is internalized and processed into the photoactive protoporphyrin IX at a high rate by tumor cells."},"fame":2,"pubchemCid":6433083,"mass":215.29,"charge":0,"smiles":"CCCCCCOC(=O)CCC(=O)CN","inchikey":"RYQOILLJDKPETL-UHFFFAOYSA-N","iupac":"hexyl 5-amino-4-oxopentanoate","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"6433083","atoms":36,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":0.365,"y":0.075,"z":0.008,"el":"O"},{"x":-0.806,"y":-1.913,"z":0.015,"el":"O"},{"x":-4.428,"y":1.588,"z":0.003,"el":"O"},{"x":-6.934,"y":0.616,"z":-0.029,"el":"N"},{"x":4.105,"y":-0.371,"z":-0.03,"el":"C"},{"x":5.3,"y":0.587,"z":-0.005,"el":"C"},{"x":2.754,"y":0.342,"z":-0.006,"el":"C"},{"x":6.652,"y":-0.126,"z":-0.053,"el":"C"},{"x":1.599,"y":-0.651,"z":0.001,"el":"C"},{"x":7.803,"y":0.863,"z":0.047,"el":"C"},{"x":-1.974,"y":0.223,"z":0.031,"el":"C"},{"x":-3.294,"y":-0.543,"z":0.025,"el":"C"},{"x":-0.767,"y":-0.69,"z":0.015,"el":"C"},{"x":-4.52,"y":0.362,"z":-0.001,"el":"C"},{"x":-5.855,"y":-0.361,"z":-0.02,"el":"C"},{"x":4.173,"y":-1.047,"z":0.832,"el":"H"},{"x":4.167,"y":-0.997,"z":-0.929,"el":"H"},{"x":5.244,"y":1.198,"z":0.905,"el":"H"},{"x":5.225,"y":1.277,"z":-0.854,"el":"H"},{"x":2.661,"y
{"version":"2026.10.11-r25","id":"Q134528946","formula":"C₂₃H₁₉Cl₂F₄N₃O₄","hill":"C23H19Cl2F4N3O4","elements":["H","C","N","O","F","Cl"],"composition":{"C":23.0,"F":4.0,"H":19.0,"N":3.0,"O":4.0,"Cl":2.0},"names":{"en":"Isocycloseram"},"descriptions":{"en":"Isocycloseram is a chemical compound discovered by Syngenta which acts as an insecticide. It acts as a noncompetitive antagonist of invertebrate γ-aminobutyric acid (GABA)-gated chloride channels, producing uncontrolled neuronal excitation leading to paralysis and death in various species of insects, but with high selectivity over mammalian GABA receptors. Unwanted toxicity to desirable non targeted insects such as pollinators can be an issue, requiring strategic application and use."},"fame":3,"pubchemCid":87323565,"mass":548.3,"charge":0,"smiles":"CCN1C(=O)C(CO1)NC(=O)C2=C(C=C(C=C2)C3=NOC(C3)(C4=CC(=C(C(=C4)Cl)F)Cl)C(F)(F)F)C","inchikey":"WLSQDEYDCAGPIR-UHFFFAOYSA-N","iupac":"4-[5-(3,5-dichloro-4-fluorophenyl)-5-(trifluoromethyl)-4H-1,2-oxazol-3-yl]-N-(2-ethyl-3-oxo-1,2-oxazolidin-4-yl)-2-methylbenzamide","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"rdkit","ref":"87323565","atoms":55,"license":"Computed with RDKit from SMILES (PubChem, Wikidata)"},"structure":{"kind":"molecule","atoms":[{"x":-7.347,"y":0.237,"z":3.029,"el":"C"},{"x":-8.029,"y":-0.171,"z":1.732,"el":"C"},{"x":-7.231,"y":0.126,"z":0.556,"el":"N"},{"x":-6.051,"y":-0.529,"z":0.251,"el":"C"},{"x":-5.704,"y":-1.646,"z":0.612,"el":"O"},{"x":-5.252,"y":0.386,"z":-0.636,"el":"C"},{"x":-5.736,"y":1.72,"z":-0.1,"el":"C"},{"x":-7.104,"y":1.519,"z":0.288,"el":"O"},{"x":-3.829,"y":0.132,"z":-0.507,"el":"N"},{"x":-2.907,"y":0.877,"z":-1.196,"el":"C"},{"x":-3.19,"y":1.887,"z":-1.828,"el":"O"},{"x":-1.497,"y":0.432,"z":-1.082,"el":"C"},{"x":-1.077,"y":-0.882,"z":-1.358,"el":"C"},{"x":0.281,"y":-1.202,"z":-1.173,"el":"C"},{"x":1.21
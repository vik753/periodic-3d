{"version":"2026.10.11-r25","id":"Q15632905","formula":"N₄O₂","hill":"N4O2","elements":["N","O"],"composition":{"N":4.0,"O":2.0},"names":{"en":"Nitryl azide"},"descriptions":{"en":"Nitryl azide (tetranitrogen dioxide) is an inorganic compound with the chemical formula N3−NO2. It is an unstable nitrogen oxide consisting of a covalent nitrogen–nitrogen bond between a nitro group and an azide group. It has been detected by infrared spectroscopy as a short-lived product of the reaction between sodium azide and nitronium hexafluoroantimonate: It is also the product of nitryl chloride and silver azide."},"fame":7,"pubchemCid":22902439,"mass":88.03,"charge":0,"smiles":"[N-]=[N+]=N[N+](=O)[O-]","inchikey":"DYMRYCZRMAHYKE-UHFFFAOYSA-N","iupac":"N-diazonitramide","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"22902439","atoms":6,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-0.757,"y":1.278,"z":0.0,"el":"O"},{"x":-2.047,"y":-0.469,"z":-0.001,"el":"O"},{"x":-0.918,"y":0.045,"z":0.0,"el":"N"},{"x":0.145,"y":-0.803,"z":0.0,"el":"N"},{"x":1.275,"y":-0.275,"z":0.0,"el":"N"},{"x":2.302,"y":0.224,"z":0.0,"el":"N"}],"bonds":[[0,2,1],[1,2,2],[2,3,1],[3,4,2],[4,5,2]]},"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q15632905","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Nitryl_azide","license":"CC BY-SA 4.0"},{"role":"properties","name":"PubChem","url":"https://pubchem.ncbi.nlm.nih.gov/compound/22902439","license":"PubChem (NIH), public data"},{"role":"structure","name":"PubChem 3D","url":"https://pubchem.ncbi.nlm.nih.gov/compound/22902439#section=3D-Conformer","license":"PubChem (NIH), public data"}],"similar":[{"id":"Q905750","formula":"N₂O","names":{"en":"Nitrous oxide","ru":"Оксид азота(I)","uk":"Оксид а
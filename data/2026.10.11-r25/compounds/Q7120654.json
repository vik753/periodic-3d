{"version":"2026.10.11-r25","id":"Q7120654","formula":"C₁₀H₁₄FN₃O₄","hill":"C10H14FN3O4","elements":["H","C","N","O","F"],"composition":{"C":10.0,"F":1.0,"H":14.0,"N":3.0,"O":4.0},"names":{"en":"2'-deoxy-2'-fluoro-2'-C-methylcytidine"},"descriptions":{"en":"PSI-6130 is an experimental treatment for hepatitis C. PSI-6130 is a member of a class of antiviral drugs known as nucleoside polymerase inhibitors that was created by chemist Jeremy L. Clark. Specifically, PSI-6130 inhibits the hepatitis C virus RNA dependent RNA polymerase called NS5B. PSI-6130 is currently being developed by Hoffmann–La Roche as a 3',5'-diisobutyrl ester prodrug, R7128. R7128 is part of the combination of all-oral agents clinical trial known as INFORM-1."},"fame":1,"pubchemCid":6481236,"mass":259.23,"charge":0,"smiles":"C[C@]1([C@@H]([C@H](O[C@H]1N2C=CC(=NC2=O)N)CO)O)F","inchikey":"NYPIRLYMDJMKGW-VPCXQMTMSA-N","iupac":"4-amino-1-[(2R,3R,4R,5R)-3-fluoro-4-hydroxy-5-(hydroxymethyl)-3-methyloxolan-2-yl]pyrimidin-2-one","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"6481236","atoms":32,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":2.154,"y":2.155,"z":-0.448,"el":"F"},{"x":1.278,"y":-0.565,"z":-1.154,"el":"O"},{"x":3.131,"y":0.739,"z":1.63,"el":"O"},{"x":2.977,"y":-2.811,"z":-0.985,"el":"O"},{"x":-1.962,"y":1.931,"z":-1.3,"el":"O"},{"x":-0.817,"y":0.132,"z":-0.417,"el":"N"},{"x":-3.212,"y":0.36,"z":-0.242,"el":"N"},{"x":-4.487,"y":-1.252,"z":0.846,"el":"N"},{"x":1.244,"y":1.375,"z":0.213,"el":"C"},{"x":1.995,"y":0.272,"z":0.933,"el":"C"},{"x":0.475,"y":0.592,"z":-0.846,"el":"C"},{"x":2.382,"y":-0.623,"z":-0.233,"el":"C"},{"x":0.434,"y":2.292,"z":1.108,"el":"C"},{"x":2.635,"y":-2.064,"z":0.172,"el":"C"},{"x":-0.9,"y":-1.063,"z":0.279,"el":"C"},{"x":-2.001,"y":0.864,"z":-0.685,"el":"C"},{"x":-2.054,"y":-1.564,"z":0.7
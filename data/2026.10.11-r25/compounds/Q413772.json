{"version":"2026.10.11-r25","id":"Q413772","formula":"C₁₀H₁₂N₂","hill":"C10H12N2","elements":["H","C","N"],"composition":{"C":10.0,"H":12.0,"N":2.0},"names":{"en":"Tolazoline","ru":"Бендазол"},"descriptions":{"en":"Tolazoline is a non-selective competitive α2-adrenergic receptor antagonist. It is a vasodilator that is used to treat spasms of peripheral blood vessels (as in acrocyanosis). It has also been used (in conjunction with sodium nitroprusside) successfully as an antidote to reverse the severe peripheral vasoconstriction which can occur as a result of overdose with certain 5-HT2A receptor agonist drugs such as 25I-NBOMe, DOB, and Bromodragonfly."},"fame":13,"pubchemCid":5504,"mass":160.22,"charge":0,"smiles":"C1CN=C(N1)CC2=CC=CC=C2","inchikey":"JIVZKJJQOZQXQB-UHFFFAOYSA-N","iupac":"2-benzyl-4,5-dihydro-1H-imidazole","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"5504","atoms":24,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-2.097,"y":-1.103,"z":-0.118,"el":"N"},{"x":-2.11,"y":1.171,"z":-0.023,"el":"N"},{"x":-1.558,"y":0.087,"z":-0.505,"el":"C"},{"x":-3.188,"y":-0.878,"z":0.781,"el":"C"},{"x":-0.375,"y":0.139,"z":-1.415,"el":"C"},{"x":-3.233,"y":0.657,"z":0.821,"el":"C"},{"x":0.909,"y":0.06,"z":-0.64,"el":"C"},{"x":1.514,"y":1.229,"z":-0.192,"el":"C"},{"x":1.478,"y":-1.18,"z":-0.378,"el":"C"},{"x":2.706,"y":1.156,"z":0.529,"el":"C"},{"x":2.67,"y":-1.253,"z":0.343,"el":"C"},{"x":3.284,"y":-0.085,"z":0.796,"el":"C"},{"x":-2.981,"y":-1.297,"z":1.77,"el":"H"},{"x":-4.122,"y":-1.298,"z":0.397,"el":"H"},{"x":-0.41,"y":1.066,"z":-2.001,"el":"H"},{"x":-0.436,"y":-0.684,"z":-2.137,"el":"H"},{"x":-4.183,"y":1.031,"z":0.425,"el":"H"},{"x":-3.119,"y":1.026,"z":1.845,"el":"H"},{"x":-1.77,"y":-2.022,"z":-0.387,"el":"H"},{"x":1.071,"y":2.2,"z":-0.393,"el":"H"},{"x":1.009,"y":-2.096,"z":-0.7
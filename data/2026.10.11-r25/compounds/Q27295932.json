{"version":"2026.10.11-r25","id":"Q27295932","formula":"C₁₈H₂₄O₂","hill":"C18H24O2","elements":["H","C","O"],"composition":{"C":18.0,"H":24.0,"O":2.0},"names":{"en":"9(10)-dehydronandrolone"},"descriptions":{"en":"Dienolone (developmental code name RU-3118; online product names Trenazone, Dienazone), or nordienolone, also known as 19-nor-δ9(10)-testosterone, δ9(10)-nandrolone, or estra-4,9(10)-dien-17β-ol-3-one, is a synthetic anabolic-androgenic steroid (AAS) of the 19-nortestosterone group that was never marketed. It has been found to possess slightly lower affinity for the androgen receptor (AR) and progesterone receptor (PR) relative to nandrolone in rat and rabbit tissue bioassays, whereas trenbolone was found to possess the same affinity for the AR as dienolone but several-fold increased affinity for the PR."},"fame":1,"pubchemCid":11747706,"mass":272.4,"charge":0,"smiles":"C[C@]12CCC3=C4CCC(=O)C=C4CC[C@H]3[C@@H]1CC[C@@H]2O","inchikey":"PUQSDJZESAQGQS-OWSLCNJRSA-N","iupac":"(8S,13S,14S,17S)-17-hydroxy-13-methyl-2,6,7,8,11,12,14,15,16,17-decahydro-1H-cyclopenta[a]phenanthren-3-one","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"11747706","atoms":44,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-4.926,"y":1.098,"z":0.665,"el":"O"},{"x":5.492,"y":0.128,"z":1.057,"el":"O"},{"x":-2.633,"y":0.541,"z":-0.085,"el":"C"},{"x":-1.747,"y":-0.659,"z":0.303,"el":"C"},{"x":-0.538,"y":-0.843,"z":-0.622,"el":"C"},{"x":-3.742,"y":0.388,"z":0.974,"el":"C"},{"x":-2.747,"y":-1.805,"z":0.45,"el":"C"},{"x":-1.781,"y":1.809,"z":0.054,"el":"C"},{"x":-4.007,"y":-1.129,"z":1.02,"el":"C"},{"x":0.304,"y":0.449,"z":-0.605,"el":"C"},{"x":-0.503,"y":1.73,"z":-0.804,"el":"C"},{"x":0.252,"y":-2.099,"z":-0.22,"el":"C"},{"x":-3.233,"y":0.468,"z":-1.511,"el":"C"},{"x":1.652,"y":0.417,"z":-0.456,"el":"C"},{"x":1.6
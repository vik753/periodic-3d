{"version":"2026.10.11-r25","id":"Q27252731","formula":"C₂₀H₂₅N₃O₂","hill":"C20H25N3O2","elements":["H","C","N","O"],"composition":{"C":20.0,"H":25.0,"N":3.0,"O":2.0},"names":{"en":"Propisergide"},"descriptions":{"en":"Propisergide (INNTooltip International Nonproprietary Name; developmental code name PML-946), also known as ergalgin or as N-methylergometrine or 1-methylergometrine, is a serotonin receptor modulator and antimigraine agent of the ergoline and lysergamide families which was never marketed. It is the 1-methyl derivative of ergometrine (ergonovine) and is a close analogue of methylergonovine and methysergide (UML-491). Extensive metabolism of other 1-methylated lysergamides to their secondary amine derivatives, for instance methysergide (1-methylmethylergometrine) conversion into methylergometrine, has been observed."},"fame":1,"pubchemCid":20055549,"mass":339.4,"charge":0,"smiles":"C[C@@H](CO)NC(=O)[C@H]1CN([C@@H]2CC3=CN(C4=CC=CC(=C34)C2=C1)C)C","inchikey":"XUKAVPATXGYVKJ-WPKBUWHJSA-N","iupac":"(6aR,9R)-N-[(2S)-1-hydroxypropan-2-yl]-4,7-dimethyl-6,6a,8,9-tetrahydroindolo[4,3-fg]quinoline-9-carboxamide","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"20055549","atoms":50,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-2.854,"y":1.034,"z":-1.309,"el":"O"},{"x":-5.937,"y":1.636,"z":1.874,"el":"O"},{"x":-0.457,"y":-2.385,"z":0.136,"el":"N"},{"x":5.054,"y":-0.015,"z":0.21,"el":"N"},{"x":-4.302,"y":0.022,"z":0.207,"el":"N"},{"x":0.709,"y":-1.541,"z":-0.251,"el":"C"},{"x":0.467,"y":-0.02,"z":-0.015,"el":"C"},{"x":2.001,"y":-2.079,"z":0.47,"el":"C"},{"x":-1.955,"y":-0.437,"z":0.341,"el":"C"},{"x":-1.716,"y":-1.789,"z":-0.336,"el":"C"},{"x":3.13,"y":-1.12,"z":0.327,"el":"C"},{"x":2.865,"y":0.239,"z":0.062,"el":"C"},{"x":1.635,"y":0.884,"z":-0.112,"el":"C"},{"x":-0.753,"y":0.454,"
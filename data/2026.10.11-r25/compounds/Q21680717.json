{"version":"2026.10.11-r25","id":"Q21680717","formula":"K₀.₈Mn₀.₆[(UO₂)₂O₂(SO₄)]·3.5H₂O","hill":"H7K0.8Mn0.6O13.5SU2","elements":["H","O","S","K","Mn","U"],"composition":{"H":7.0,"K":0.8,"O":13.5,"S":1.0,"U":2.0,"Mn":0.6},"names":{"en":"Plavnoite"},"descriptions":{"en":"Plavnoite is a rare complex uranium sulfate mineral with the formula K0.8Mn0.6[(UO2)2O2(SO4)]•3.5H2O. Typically for the secondary uranium mineral, plavnoite contains uranyl groups. It was discovered in the Plavno mine in Jáchymov, Czech Republic. The Jáchymov site is known as a type locality for many rare and unique minerals."},"fame":5,"pubchemCid":null,"mass":null,"charge":0,"smiles":null,"inchikey":null,"iupac":null,"classes":[{"qid":"Q12089225","names":{"en":"mineral species","ru":"действительный вид минералов","uk":"мінеральний вид"}}],"structureInfo":null,"structure":null,"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q21680717","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Plavnoite","license":"CC BY-SA 4.0"},{"role":"photo","name":"Wikimedia Commons","url":"https://commons.wikimedia.org/wiki/File:Plavnoite.jpg","license":"CC BY 4.0"}],"similar":[{"id":"Q319661","formula":"K(UO₂)(AsO₄)·3H₂O","names":{"en":"Abernathyite","ru":"Абернатиит","uk":"Абернатіїт"},"elements":["H","O","K","As","U"],"fame":24,"kind":null},{"id":"Q3606883","formula":"K₂Ca[(UO₂)₃O₃(OH)₂]₂·5H₂O","names":{"en":"Agrinierite","ru":"Агриньерит","uk":"Агріньєрит"},"elements":["H","O","K","Ca","U"],"fame":12,"kind":null},{"id":"Q3749147","formula":"Pb(UO₂)₄O₃(OH)₄·4H₂O","names":{"en":"Fourmarierite","uk":"Фурмар'єрит"},"elements":["H","O","Pb","U"],"fame":12,"kind":null},{"id":"Q769232","formula":"Pb(UO₂)₃O₃(OH)₂*3H₂O","names":{"en":"Masuyite"},"elements":["H","O","Pb","U"],"fame":10,"kind":null},{"id":"Q4003542","formula":"(UO₂)(MoO₄)(H₂O)·H₂O","names":{"en":"Umohoite"},"elements":["H","O","Mo","U"],"fame":9,"kind":null},{"id":"Q3951
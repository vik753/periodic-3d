{"version":"2026.10.11-r25","id":"Q209290","formula":"C₁₄H₂₀O","hill":"C14H20O","elements":["H","C","O"],"composition":{"C":14.0,"H":20.0,"O":1.0},"names":{"en":"Butylphenyl methylpropional"},"descriptions":{"en":"Lilial (a trade name for lily aldehyde, also known as lysmeral or lilestralis) is an organic compound with the formula (CH3)3CC6H4CH2CH(CH3)CHO. It is an aromatic aldehyde, naturally occurring in crow-dipper and tomato plants. It was once produced synthetically in a multi-ton scale for use as a perfume in cosmetic preparations and laundry powders, often under the name butylphenyl methylpropional. It has been largely banned after being found to be harmful to fertility."},"fame":14,"pubchemCid":228987,"mass":204.31,"charge":0,"smiles":"CC(CC1=CC=C(C=C1)C(C)(C)C)C=O","inchikey":"SDQFDHOLCGWZPU-UHFFFAOYSA-N","iupac":"3-(4-tert-butylphenyl)-2-methylpropanal","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"228987","atoms":35,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":5.568,"y":0.095,"z":0.216,"el":"O"},{"x":-3.418,"y":-0.046,"z":0.211,"el":"C"},{"x":-1.908,"y":0.045,"z":-0.062,"el":"C"},{"x":-3.683,"y":-1.085,"z":1.322,"el":"C"},{"x":-4.154,"y":-0.479,"z":-1.075,"el":"C"},{"x":-4.052,"y":1.286,"z":0.672,"el":"C"},{"x":0.787,"y":0.209,"z":-0.549,"el":"C"},{"x":2.252,"y":0.299,"z":-0.815,"el":"C"},{"x":-1.251,"y":-1.085,"z":-0.478,"el":"C"},{"x":-1.285,"y":1.255,"z":0.123,"el":"C"},{"x":3.141,"y":-0.003,"z":0.412,"el":"C"},{"x":0.119,"y":-1.002,"z":-0.726,"el":"C"},{"x":0.085,"y":1.338,"z":-0.125,"el":"C"},{"x":3.313,"y":-1.502,"z":0.65,"el":"C"},{"x":4.487,"y":0.675,"z":0.223,"el":"C"},{"x":-4.751,"y":-1.139,"z":1.566,"el":"H"},{"x":-3.373,"y":-2.095,"z":1.032,"el":"H"},{"x":-3.145,"y":-0.827,"z":2.241,"el":"H"},{"x":-3.854,"y":-1.477,"z":-1.413,"el":"H"},{"x":-5.239,"y":-0.51,
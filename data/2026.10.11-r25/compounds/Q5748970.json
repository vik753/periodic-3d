{"version":"2026.10.11-r25","id":"Q5748970","formula":"N₆","hill":"N6","elements":["N"],"composition":{"N":6.0},"names":{"en":"Hexazine","ru":"Гексазин"},"descriptions":{"en":"Hexazine (also known as hexaazabenzene) is a hypothetical allotrope of nitrogen composed of 6 nitrogen atoms arranged in a ring-like structure analogous to that of benzene. As a neutrally charged species, hexazine would be the final member of the azabenzene (azine) series, in which all of the methine groups of the benzene molecule have been replaced with nitrogen atoms. The two last members of this series, hexazine and pentazine, have not been observed, although all other members of the azine series have (such as pyridine, pyrimidine, pyridazine, pyrazine, triazines, and tetrazines)."},"fame":23,"pubchemCid":11966278,"mass":84.04,"charge":0,"smiles":"N1=NN=NN=N1","inchikey":"YRBKSJIXFZPPGF-UHFFFAOYSA-N","iupac":"hexazine","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"11966278","atoms":6,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":0.861,"y":-0.925,"z":0.0,"el":"N"},{"x":1.232,"y":0.283,"z":0.0,"el":"N"},{"x":-0.371,"y":-1.208,"z":0.0,"el":"N"},{"x":0.371,"y":1.208,"z":0.0,"el":"N"},{"x":-1.232,"y":-0.283,"z":0.0,"el":"N"},{"x":-0.861,"y":0.925,"z":0.0,"el":"N"}],"bonds":[[0,1,2],[0,2,1],[1,3,1],[2,4,2],[3,5,2],[4,5,1]]},"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q5748970","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Hexazine","license":"CC BY-SA 4.0"},{"role":"properties","name":"PubChem","url":"https://pubchem.ncbi.nlm.nih.gov/compound/11966278","license":"PubChem (NIH), public data"},{"role":"structure","name":"PubChem 3D","url":"https://pubchem.ncbi.nlm.nih.gov/compound/11966278#section=3D-Conformer","lice
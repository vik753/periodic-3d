{"version":"2026.10.11-r25","id":"Q136995222","formula":"C₁₃H₁₉N","hill":"C13H19N","elements":["H","C","N"],"composition":{"C":13.0,"H":19.0,"N":1.0},"names":{"en":"MPEP"},"descriptions":{"en":"MPEP, also known as 1-(α-methylphenethyl)pyrrolidine, is a stimulant drug of the phenethylamine, amphetamine, and phenylethylpyrrolidine families. It is the α-methyl derivative of phenylethylpyrrolidine (PEP). Notable derivatives of MPEP include prolintane (the α-propyl homologue), α-PPP (the β-keto or cathinone derivative), α-PVP (the β-keto and α-propyl homologue), pyrovalerone (4-methyl-α-PVP), and MDPV (3,4-methylenedioxy-α-PVP), among others."},"fame":1,"pubchemCid":53665923,"mass":189.3,"charge":0,"smiles":"CC(CC1=CC=CC=C1)N2CCCC2","inchikey":"AWNZMWZMSDWFCV-UHFFFAOYSA-N","iupac":"1-(1-phenylpropan-2-yl)pyrrolidine","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"53665923","atoms":33,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-2.182,"y":0.23,"z":-0.202,"el":"N"},{"x":-0.805,"y":0.388,"z":0.242,"el":"C"},{"x":-3.141,"y":0.826,"z":0.728,"el":"C"},{"x":-2.578,"y":-1.174,"z":-0.307,"el":"C"},{"x":-4.465,"y":0.22,"z":0.286,"el":"C"},{"x":-4.095,"y":-1.096,"z":-0.39,"el":"C"},{"x":0.14,"y":-0.303,"z":-0.757,"el":"C"},{"x":-0.515,"y":1.882,"z":0.387,"el":"C"},{"x":1.596,"y":-0.23,"z":-0.362,"el":"C"},{"x":2.381,"y":0.841,"z":-0.79,"el":"C"},{"x":2.155,"y":-1.232,"z":0.43,"el":"C"},{"x":3.726,"y":0.909,"z":-0.425,"el":"C"},{"x":3.499,"y":-1.165,"z":0.794,"el":"C"},{"x":4.285,"y":-0.094,"z":0.367,"el":"C"},{"x":-0.666,"y":-0.075,"z":1.23,"el":"H"},{"x":-3.196,"y":1.917,"z":0.654,"el":"H"},{"x":-2.935,"y":0.547,"z":1.769,"el":"H"},{"x":-2.285,"y":-1.752,"z":0.579,"el":"H"},{"x":-2.188,"y":-1.669,"z":-1.201,"el":"H"},{"x":-5.138,"y":0.064,"z":1.135,"el":"H"},{"x":-4.975,"y":0.874,"z":-0.431,"el"
{"version":"2026.10.11-r25","id":"Q5931256","formula":"EuS","hill":"EuS","elements":["S","Eu"],"composition":{"S":1.0,"Eu":1.0},"names":{"en":"Europium(II) sulfide","ru":"Сульфид европия(II)"},"descriptions":{"en":"Europium(II) sulfide is the inorganic compound with the chemical formula EuS. It is a black, air-stable powder. Europium possesses an oxidation state of +II in europium sulfide, whereas the lanthanides exhibit a typical oxidation state of +III. Its Curie temperature (Tc) is 16.6 K. Below this temperature EuS behaves like a ferromagnetic compound, and above it exhibits simple paramagnetic properties. EuS is stable up to 500 °C in air, when it begins to show signs of oxidation.","ru":"Сульфид европия(II) — бинарное неорганическое соединение европия и серы с формулой EuS, чёрные кристаллы."},"fame":14,"pubchemCid":82809,"mass":184.03,"charge":0,"smiles":"S=[Eu]","inchikey":"RVKZDIDATLDTNR-UHFFFAOYSA-N","iupac":"sulfanylideneeuropium","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"crystal","source":"materialsproject","ref":"mp-20587","atoms":27,"license":"CC BY 4.0, Materials Project"},"structure":{"cell":[[5.882,0.0,0.0],[0.0,5.882,0.0],[0.0,0.0,5.882]],"kind":"crystal","atoms":[{"x":0.0,"y":0.0,"z":0.0,"el":"Eu"},{"x":0.0,"y":0.0,"z":5.882,"el":"Eu"},{"x":0.0,"y":5.882,"z":0.0,"el":"Eu"},{"x":0.0,"y":5.882,"z":5.882,"el":"Eu"},{"x":5.882,"y":0.0,"z":0.0,"el":"Eu"},{"x":5.882,"y":0.0,"z":5.882,"el":"Eu"},{"x":5.882,"y":5.882,"z":0.0,"el":"Eu"},{"x":5.882,"y":5.882,"z":5.882,"el":"Eu"},{"x":0.0,"y":2.941,"z":0.0,"el":"S"},{"x":0.0,"y":2.941,"z":5.882,"el":"S"},{"x":5.882,"y":2.941,"z":0.0,"el":"S"},{"x":5.882,"y":2.941,"z":5.882,"el":"S"},{"x":0.0,"y":2.941,"z":2.941,"el":"Eu"},{"x":5.882,"y":2.941,"z":2.941,"el":"Eu"},{"x":0.0,"y":0.0,"z":2.941,"el":"S"},{"x":0.0,"y":5.882,"z":2.941,"el":"S"},{"x":5.882,"y":0.0,"z":2.941,"el":"S"},{"x":5.882,"y":5.
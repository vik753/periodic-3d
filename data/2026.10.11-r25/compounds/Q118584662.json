{"version":"2026.10.11-r25","id":"Q118584662","formula":"C₁₆H₂₅N₃O₃","hill":"C16H25N3O3","elements":["H","C","N","O"],"composition":{"C":16.0,"H":25.0,"N":3.0,"O":3.0},"names":{"en":"Lys-MDA"},"descriptions":{"en":"Lys-MDA, or lysine-MDA, also known as N-(L-lysinamidyl)-MDA, is an entactogen of the phenethylamine, amphetamine, and MDxx families with entactogenic effects, which acts as a prodrug for MDA with a somewhat slower onset of effects and longer duration of action. Lys-MDA, along with the related derivative Lys-MDMA, are in early stage human clinical trials as potential treatments for treatment-resistant depression and post-traumatic stress disorder. New MDMA prodrugs are in the development phase at MiHKAL GmbH in Switzerland."},"fame":1,"pubchemCid":null,"mass":null,"charge":0,"smiles":"CC(Cc2ccc1OCOc1c2)NC(=O)C(N)CCCCN","inchikey":null,"iupac":null,"classes":[{"qid":"Q59199015","names":{"en":"group of stereoisomers","ru":"группа стереоизомеров","uk":"група стереоізомерів"}}],"structureInfo":{"kind":"molecule","source":"rdkit","ref":null,"atoms":47,"license":"Computed with RDKit from SMILES (PubChem, Wikidata)"},"structure":{"kind":"molecule","atoms":[{"x":-1.444,"y":-3.123,"z":-1.183,"el":"C"},{"x":-1.546,"y":-2.712,"z":0.286,"el":"C"},{"x":-2.886,"y":-2.025,"z":0.628,"el":"C"},{"x":-3.111,"y":-0.674,"z":-0.016,"el":"C"},{"x":-3.714,"y":-0.581,"z":-1.292,"el":"C"},{"x":-3.914,"y":0.66,"z":-1.906,"el":"C"},{"x":-3.509,"y":1.786,"z":-1.224,"el":"C"},{"x":-3.622,"y":3.067,"z":-1.665,"el":"O"},{"x":-3.062,"y":3.788,"z":-0.548,"el":"C"},{"x":-2.602,"y":2.93,"z":0.517,"el":"O"},{"x":-2.929,"y":1.708,"z":0.019,"el":"C"},{"x":-2.719,"y":0.5,"z":0.65,"el":"C"},{"x":-0.399,"y":-1.892,"z":0.663,"el":"N"},{"x":0.817,"y":-2.448,"z":1.004,"el":"C"},{"x":0.99,"y":-3.657,"z":1.146,"el":"O"},{"x":1.95,"y":-1.413,"z":1.209,"el":"C"},{"x":3.073,"y":-2.05,"z":1.927,"el":"N"},{"x":2.409,"y":-0.862,"z":-0.149,"el":"C"},{"x":3.495,"y":0.219,"z":-0.076,"el":"C"},{"x":3.011,"y":1.5
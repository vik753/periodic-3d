{"version":"2026.10.11-r25","id":"Q5014559","formula":"C₁₉H₁₃ClF₃N₃O","hill":"C19H13ClF3N3O","elements":["H","C","N","O","F","Cl"],"composition":{"C":19.0,"F":3.0,"H":13.0,"N":3.0,"O":1.0,"Cl":1.0},"names":{"en":"CTEP"},"descriptions":{"en":"CTEP (Ro4956371) is a research drug developed by Hoffmann-La Roche that acts as a selective allosteric antagonist of the metabotropic glutamate receptor subtype mGluR5, binding with nanomolar affinity and over 1000 times selectivity over all other receptor targets tested. In animal studies it was found to have a high oral bioavailability and a long duration of action, lasting 18 hours after a single dose, giving it considerably improved properties over older mGluR5 antagonists such as MPEP, MTEP and fenobam."},"fame":4,"pubchemCid":11646823,"mass":391.8,"charge":0,"smiles":"CC1=C(N=C(N1C2=CC=C(C=C2)OC(F)(F)F)C)C#CC3=CC(=NC=C3)Cl","inchikey":"GOHCTCOGYKAJLZ-UHFFFAOYSA-N","iupac":"2-chloro-4-[2-[2,5-dimethyl-1-[4-(trifluoromethoxy)phenyl]imidazol-4-yl]ethynyl]pyridine","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"11646823","atoms":40,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-8.663,"y":-0.764,"z":1.691,"el":"Cl"},{"x":6.722,"y":-0.86,"z":-0.409,"el":"F"},{"x":8.202,"y":0.321,"z":0.683,"el":"F"},{"x":7.321,"y":1.136,"z":-1.144,"el":"F"},{"x":6.048,"y":0.992,"z":0.751,"el":"O"},{"x":0.804,"y":-0.556,"z":-0.102,"el":"N"},{"x":-0.939,"y":-1.842,"z":-0.643,"el":"N"},{"x":-8.065,"y":0.909,"z":-0.196,"el":"N"},{"x":-0.319,"y":0.214,"z":0.082,"el":"C"},{"x":2.114,"y":-0.169,"z":0.111,"el":"C"},{"x":0.37,"y":-1.784,"z":-0.54,"el":"C"},{"x":-1.375,"y":-0.599,"z":-0.258,"el":"C"},{"x":-0.271,"y":1.614,"z":0.551,"el":"C"},{"x":2.702,"y":-0.355,"z":1.363,"el":"C"},{"x":2.849,"y":0.408,"z":-0.925,"el":"C"},{"x":1.305,"y":-2.888,"z":-0.848,"el":"C"},{"x":4
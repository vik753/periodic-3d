{"version":"2026.10.11-r25","id":"Q130442111","formula":"C₂₂H₂₈F₂N₂O₂S","hill":"C22H28F2N2O2S","elements":["H","C","N","O","F","S"],"composition":{"C":22.0,"F":2.0,"H":28.0,"N":2.0,"O":2.0,"S":1.0},"names":{"en":"JJC8-091"},"descriptions":{"en":"JJC8-091 is an atypical dopamine reuptake inhibitor (DRI) that was derived from modafinil. It is a lead compound for potential treatment of psychostimulant use disorder (PSUD) and is under development by Encepheal Therapeutics for use as a pharmaceutical drug. The affinity (Ki) of JJC8-091 for the dopamine transporter (DAT) is 230 to 289 nM. In another study however, its affinities for the monoamine transporters were 16.7 nM for the DAT, 17,800 nM for the norepinephrine transporter (NET) (1,066-fold lower than for the DAT), and 1,770 nM for the serotonin transporter (SERT) (106-fold lower than for the DAT)."},"fame":1,"pubchemCid":90389592,"mass":422.5,"charge":0,"smiles":"CC(CN1CCN(CC1)CCS(=O)C(C2=CC=C(C=C2)F)C3=CC=C(C=C3)F)O","inchikey":"PHGOEMMHIGVMIN-UHFFFAOYSA-N","iupac":"1-[4-[2-[bis(4-fluorophenyl)methylsulfinyl]ethyl]piperazin-1-yl]propan-2-ol","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"rdkit","ref":"90389592","atoms":57,"license":"Computed with RDKit from SMILES (PubChem, Wikidata)"},"structure":{"kind":"molecule","atoms":[{"x":6.538,"y":0.47,"z":0.568,"el":"C"},{"x":5.778,"y":-0.784,"z":0.971,"el":"C"},{"x":4.69,"y":-1.238,"z":-0.033,"el":"C"},{"x":3.587,"y":-0.353,"z":-0.398,"el":"N"},{"x":2.848,"y":0.228,"z":0.732,"el":"C"},{"x":1.894,"y":1.386,"z":0.324,"el":"C"},{"x":1.394,"y":1.341,"z":-1.07,"el":"N"},{"x":2.559,"y":1.283,"z":-1.989,"el":"C"},{"x":3.86,"y":0.63,"z":-1.44,"el":"C"},{"x":0.492,"y":0.189,"z":-1.283,"el":"C"},{"x":-0.868,"y":0.341,"z":-0.579,"el":"C"},{"x":-1.131,"y":-1.001,"z":0.626,"el":"S"},{"x":-0.387,"y":-0.65,"z":1.883,"el":"O"},{"x":-2.936,"y":-0.777,"z":0.
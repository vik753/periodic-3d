{"version":"2026.10.11-r25","id":"Q30694081","formula":"C₄₅H₄₈O₂₁","hill":"C45H48O21","elements":["H","C","O"],"composition":{"C":45.0,"H":48.0,"O":21.0},"names":{"en":"Hibarimicinone"},"descriptions":{"en":"Hibarimicinone is an organic atropisomeric small molecule, derived from hibarimicins, which are isolated from the microbial culture strain of Microbispora rosea from the Hibari region of Japan. Analysis of the bacteria identified a new class of molecule containing a dimeric-tetracyclic polyketide backbone, which are now known as the hibarimicins. Hibarimicinone and its derivatives were initially extracted for their potential inhibitory properties of various protein kinases, such as calmodulin-dependent protein kinase III (CAMKIII), protein kinase A (PKA), protein kinase C (PKC), and protein tyrosine kinase (PTK)."},"fame":2,"pubchemCid":101157796,"mass":924.8,"charge":0,"smiles":"CCC[C@@]1([C@H]([C@@H]([C@H]([C@@H]2[C@]1(C(=O)C3=C(C4=C(C=C3C2)C(=C(C(=C4O)C5=C(C(=O)C6=C(C7=C(C(=C6C5=O)O)C(=O)[C@@]8([C@H]9[C@H]7O[C@]8([C@H]([C@@H]([C@H]9O)O)O)CCC)O)O)OC)OC)OC)O)O)O)O)O)O","inchikey":"SSVUTDACAKUVQH-NAZDNXRUSA-N","iupac":"(2R,4S,5S,6R,7S,8R,9S)-15-[(6aR,7S,8R,9S,10S,10aS)-1,7,8,9,10,10a,12-heptahydroxy-3,4-dimethoxy-11-oxo-10-propyl-6a,7,8,9-tetrahydro-6H-tetracen-2-yl]-5,6,7,9,12,19-hexahydroxy-16-methoxy-4-propyl-3-oxapentacyclo[9.8.0.02,8.04,9.013,18]nonadeca-1(11),12,15,18-tetraene-10,14,17-trione","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"flat","source":"rdkit","ref":"101157796","atoms":114,"license":"Computed with RDKit from SMILES (PubChem, Wikidata)"},"structure":{"kind":"flat","atoms":[{"x":11.539,"y":4.612,"z":0.0,"el":"C"},{"x":10.784,"y":3.315,"z":0.0,"el":"C"},{"x":10.03,"y":2.019,"z":0.0,"el":"C"},{"x":9.275,"y":0.723,"z":0.0,"el":"C"},{"x":10.632,"y":0.084,"z":0.0,"el":"C"},{"x":10.758,"y":-1.411,"z":0.0,"el":"C"},{"x":9.526,"y":-2.267
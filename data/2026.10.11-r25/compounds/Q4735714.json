{"version":"2026.10.11-r25","id":"Q4735714","formula":"C₁₄H₉NO₄","hill":"C14H9NO4","elements":["H","C","N","O"],"composition":{"C":14.0,"H":9.0,"N":1.0,"O":4.0},"names":{"en":"Alrestatin"},"descriptions":{"en":"Alrestatin is an inhibitor of aldose reductase, an enzyme involved in the pathogenesis of complications of diabetes mellitus, including diabetic neuropathy. Alrestat was first synthesized in 1969 and was the first aldose reductase inhibitor (ARI) with oral bioavailability to undergo clinical trials, in the late 1970s and early 1980s. Low-quality trials and a high incidence of adverse effects (particularly hepatotoxicity) led to termination of its development, and it was never in clinical use."},"fame":5,"pubchemCid":2120,"mass":255.22,"charge":0,"smiles":"C1=CC2=C3C(=C1)C(=O)N(C(=O)C3=CC=C2)CC(=O)O","inchikey":"GCUCIFQCGJIRNT-UHFFFAOYSA-N","iupac":"2-(1,3-dioxobenzo[de]isoquinolin-2-yl)acetic acid","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"2120","atoms":28,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":1.343,"y":2.351,"z":-0.487,"el":"O"},{"x":1.419,"y":-2.315,"z":-0.422,"el":"O"},{"x":4.853,"y":-0.499,"z":0.366,"el":"O"},{"x":3.21,"y":0.602,"z":1.485,"el":"O"},{"x":1.433,"y":0.017,"z":-0.526,"el":"N"},{"x":-1.328,"y":-0.019,"z":-0.043,"el":"C"},{"x":-0.676,"y":1.216,"z":-0.17,"el":"C"},{"x":-0.638,"y":-1.236,"z":-0.134,"el":"C"},{"x":-2.727,"y":-0.037,"z":0.186,"el":"C"},{"x":0.784,"y":1.259,"z":-0.41,"el":"C"},{"x":0.822,"y":-1.242,"z":-0.373,"el":"C"},{"x":-1.391,"y":2.416,"z":-0.073,"el":"C"},{"x":-1.316,"y":-2.454,"z":0.0,"el":"C"},{"x":2.859,"y":0.034,"z":-0.831,"el":"C"},{"x":-3.429,"y":1.173,"z":0.28,"el":"C"},{"x":-3.391,"y":-1.266,"z":0.317,"el":"C"},{"x":-2.765,"y":2.391,"z":0.152,"el":"C"},{"x":-2.689,"y":-2.466,"z":0.224,"el":"C"},{"x":3.627,"y":0.075,"z":0.4
{"version":"2026.10.11-r25","id":"Q743705","formula":"C₁₀H₁₃N₂O₈P","hill":"C10H13N2O8P","elements":["H","C","N","O","P"],"composition":{"C":10.0,"H":13.0,"N":2.0,"O":8.0,"P":1.0},"names":{"en":"Thymidine monophosphate"},"descriptions":{"en":"Thymidine monophosphate (TMP), also known as thymidylic acid (conjugate base thymidylate), deoxythymidine monophosphate (dTMP), or deoxythymidylic acid (conjugate base deoxythymidylate), is a nucleotide that is used as a monomer in DNA. It is an ester of phosphoric acid with the nucleoside thymidine. dTMP consists of a phosphate group, the pentose sugar deoxyribose, and the nucleobase thymine. Unlike the other deoxyribonucleotides, thymidine monophosphate often does not contain the \"deoxy\" prefix in its name; nevertheless, its symbol often includes a \"d\" (\"dTMP\")."},"fame":22,"pubchemCid":16755631,"mass":320.19,"charge":0,"smiles":"CC1=CN(C(=O)NC1=O)[C@H]2C[C@@H]([C@H](O2)COP(=O)([O-])[O-])O","inchikey":"GYOZYWVXFNDGLU-XLPZGREQSA-L","iupac":"[(2R,3S,5R)-3-hydroxy-5-(5-methyl-2,4-dioxopyrimidin-1-yl)oxolan-2-yl]methyl phosphate","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"16755631","atoms":34,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-3.574,"y":-1.538,"z":0.058,"el":"P"},{"x":-0.452,"y":1.332,"z":1.002,"el":"O"},{"x":-0.9,"y":4.163,"z":-0.072,"el":"O"},{"x":-2.765,"y":-0.185,"z":0.553,"el":"O"},{"x":3.615,"y":1.743,"z":0.404,"el":"O"},{"x":3.835,"y":-2.804,"z":-0.248,"el":"O"},{"x":-3.939,"y":-2.236,"z":1.365,"el":"O"},{"x":-2.565,"y":-2.303,"z":-0.793,"el":"O"},{"x":-4.777,"y":-1.007,"z":-0.717,"el":"O"},{"x":1.609,"y":0.566,"z":0.201,"el":"N"},{"x":3.71,"y":-0.525,"z":0.078,"el":"N"},{"x":-0.993,"y":2.888,"z":-0.703,"el":"C"},{"x":-1.57,"y":1.869,"z":0.271,"el":"C"},{"x":0.768,"y":1.717,"z":0.353,"el":"C"},{"x":0.393,"y":2.353,"z":
{"version":"2026.10.11-r25","id":"Q27093084","formula":"C₂₇H₄₆O₄S","hill":"C27H46O4S","elements":["H","C","O","S"],"composition":{"C":27.0,"H":46.0,"O":4.0,"S":1.0},"names":{"en":"Cholesterol sulfate"},"descriptions":{"en":"Cholesterol sulfate, or cholest-5-en-3β-ol sulfate, is an endogenous steroid and the C3β sulfate ester of cholesterol. It is formed from cholesterol by steroid sulfotransferases (SSTs) such as SULT2B1b (also known as cholesterol sulfotransferase) and is converted back into cholesterol by steroid sulfatase (STS). Accumulation of cholesterol sulfate in the skin is implicated in the pathophysiology of X-linked ichthyosis, a congenital disorder in which STS is non-functional and the body cannot convert cholesterol sulfate back into cholesterol."},"fame":2,"pubchemCid":46936278,"mass":466.7,"charge":0,"smiles":"C[C@H](CCCC(C)C)[C@H]1CC[C@@H]2[C@@]1(CC[C@@H]3[C@H]2CC=C4[C@]3(CC[C@H](C4)OS(=O)(=O)O)C)C","inchikey":"BHYOQNUELFTYRT-MFYRMPRMSA-N","iupac":"[(3R,8S,9R,10S,13R,14S,17R)-10,13-dimethyl-17-[(2R)-6-methylheptan-2-yl]-2,3,4,7,8,9,11,12,14,15,16,17-dodecahydro-1H-cyclopenta[a]phenanthren-3-yl] hydrogen sulfate","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"46936278","atoms":78,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-6.848,"y":1.881,"z":-0.085,"el":"S"},{"x":-5.766,"y":1.245,"z":0.96,"el":"O"},{"x":-7.911,"y":2.651,"z":0.884,"el":"O"},{"x":-6.158,"y":2.891,"z":-0.866,"el":"O"},{"x":-7.553,"y":0.801,"z":-0.751,"el":"O"},{"x":1.9,"y":-1.851,"z":-0.089,"el":"C"},{"x":0.966,"y":-1.034,"z":-1.014,"el":"C"},{"x":-0.339,"y":-1.773,"z":-1.32,"el":"C"},{"x":-1.123,"y":-2.071,"z":-0.005,"el":"C"},{"x":3.101,"y":-0.876,"z":-0.03,"el":"C"},{"x":1.185,"y":-2.077,"z":1.25,"el":"C"},{"x":-2.039,"y":-0.886,"z":0.539,"el":"C"},{"x":1.885,"y":-0.625,"z":-2.164,"el":"C"},{"x":
{"version":"2026.10.11-r25","id":"Q426607","formula":"ClFO₃","hill":"ClFO3","elements":["O","F","Cl"],"composition":{"F":1.0,"O":3.0,"Cl":1.0},"names":{"en":"Perchloryl fluoride","ru":"Перхлорилфторид"},"descriptions":{"en":"Perchloryl fluoride is a reactive gas with the chemical formula ClO3F. It has a characteristic sweet odor that resembles gasoline and kerosene. It is toxic and is a powerful oxidizing and fluorinating agent. It is the acid fluoride of perchloric acid.","ru":"Перхлорилфторид (триоксид-фторид хлора(VII)) — неорганическое соединение семивалентного хлора с кислородом и фтором. Впервые получен Боде в 1951 году. Позже заменой ОН на F в хлорной кислоте он был получен Энгельбрехтом в 1952 году (при электролизе перхлората натрия, растворённого в жидком фтористом водороде)."},"fame":17,"pubchemCid":24258,"mass":102.45,"charge":0,"smiles":"O=Cl(=O)(=O)F","inchikey":"XHFXMNZYIKFCPN-UHFFFAOYSA-N","iupac":"perchloryl fluoride","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":null,"structure":null,"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q426607","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Perchloryl_fluoride","license":"CC BY-SA 4.0"},{"role":"description","name":"Wikipedia (ru)","url":"https://ru.wikipedia.org/wiki/%D0%9F%D0%B5%D1%80%D1%85%D0%BB%D0%BE%D1%80%D0%B8%D0%BB%D1%84%D1%82%D0%BE%D1%80%D0%B8%D0%B4","license":"CC BY-SA 4.0"},{"role":"properties","name":"PubChem","url":"https://pubchem.ncbi.nlm.nih.gov/compound/24258","license":"PubChem (NIH), public data"}],"similar":[{"id":"Q3375149","formula":"ClFO₄","names":{"en":"Fluorine perchlorate","ru":"Перхлорат фтора"},"elements":["O","F","Cl"],"fame":10,"kind":"molecule"},{"id":"Q422080","formula":"ClO₂","names":{"en":"Chlorine dioxide","ru":"Диоксид хлора"},"elements":["O","Cl"],"fame":40,"kind":"molecule"
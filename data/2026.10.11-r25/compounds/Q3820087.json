{"version":"2026.10.11-r25","id":"Q3820087","formula":"Cu·Fe·Zn","hill":"CuFeZn","elements":["Fe","Cu","Zn"],"composition":{"Cu":1.0,"Fe":1.0,"Zn":1.0},"names":{"en":"Muntz metal","ru":"Мунц-металл"},"descriptions":{"en":"Muntz metal (also known as yellow metal) is an alpha-beta brass alloy composed of approximately 60% copper, 40% zinc and a trace of iron. It is named after George Fredrick Muntz, a metal-roller of Birmingham, England, who commercialised the alloy following his patent of 1832. The alloy must be worked hot and is used today for corrosion-resistant machine parts.","ru":"Мунц-металл или мунцевая латунь — разновидность латуни, сплав медной основы с цинком (39—43 %), в который иногда добавлялся свинец (0,8—1,9 %). Выпускается в виде полуфабрикатов (труб, полос, проволоки, лент, прутков), применяется для массового производства деталей в приборо- и машиностроении. Мунц-металл был предложен в 1832 году британским промышленником и металлургом Дж."},"fame":7,"pubchemCid":null,"mass":null,"charge":0,"smiles":null,"inchikey":null,"iupac":null,"classes":[{"qid":"Q518350","names":{"en":"copper-based alloy","ru":"сплавы меди","uk":"сплави міді"}}],"structureInfo":null,"structure":null,"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q3820087","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Muntz_metal","license":"CC BY-SA 4.0"},{"role":"description","name":"Wikipedia (ru)","url":"https://ru.wikipedia.org/wiki/%D0%9C%D1%83%D0%BD%D1%86-%D0%BC%D0%B5%D1%82%D0%B0%D0%BB%D0%BB","license":"CC BY-SA 4.0"},{"role":"photo","name":"Wikimedia Commons","url":"https://commons.wikimedia.org/wiki/File:Cutty_Sark_stern.jpg","license":"CC BY-SA 3.0"}],"similar":[{"id":"Q3742035","formula":"Cu·Fe·Ni·Zn","names":{"en":"Melchior","ru":"Мельхиор","uk":"Мельхіор"},"elements":["Fe","Ni","Cu","Zn"],"fame":14,"kind":null},{"id":"Q4024339","formula":"CuZn","names":{"en":"Zhanghengite"},"elements":["Cu","Zn"],"fame":10,"kind":"crystal"},{"id":"Q204567","formula":"Cu·Zn","names":{"en":"Zinc-copper couple","ru":"Цинк-медная пара"},"elements":["Cu","Zn"],"fame":6,"kind":"crystal"},{"id":"Q1159281","formula":"CuZn₂","names":{"en":"Danbaite","uk":"Даньбаїт"},"elements":["Cu","Zn"],"fame":9,"kind":null},{"id":"Q898429","formula":"Cu·Mn·Ni","names":{"en":"Constantan","ru":"Константан","uk":"Константан"},"elements":["Mn","Ni","Cu"],"fame":32,"kind":null},{"id":"Q583365","formula":"Cu·Mn·Ni","names":{"en":"Manganin","ru":"Манганин","uk":"Манганин"},"elements":["Mn","Ni","Cu"],"fame":23,"kind":null},{"id":"Q4232296","formula":"Cu·Mn·Ni","names":{"en":"Kopel","ru":"Копель","uk":"Копель"},"elements":["Mn","Ni","Cu"],"fame":2,"kind":null},{"id":"Q66684598","formula":"Cu₂Mg","names":{"en":"MgCu2","ru":"Магнийдимеди"},"elements":["Mg","Cu"],"fame":5,"kind":"crystal"}],"photo":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/5a/Cutty_Sark_stern.jpg/960px-Cutty_Sark_stern.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Cutty_Sark_stern.jpg","license":"CC BY-SA 3.0","author":"Cmglee","licenseUrl":"https://creativecommons.org/licenses/by-sa/3.0"}}
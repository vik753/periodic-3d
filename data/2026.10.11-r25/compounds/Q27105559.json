{"version":"2026.10.11-r25","id":"Q27105559","formula":"C₉H₁₂FN₂O₈P","hill":"C9H12FN2O8P","elements":["H","C","N","O","F","P"],"composition":{"C":9.0,"F":1.0,"H":12.0,"N":2.0,"O":8.0,"P":1.0},"names":{"en":"5-fluorodeoxyuridine monophosphate"},"descriptions":{"en":"Fluorodeoxyuridylate (5-FdUMP), also known as 5-fluoro-2'-deoxyuridylate, and 5-fluoro-2'-deoxyuridine 5'-monophosphate, is the monophosphate ester of 5-fluorodeoxyuridine (5-FdU). It is formed in vivo from 5-fluorouracil (5-FU) and 5-FdU. FdUMP acts as a suicide inhibitor of thymidylate synthase (TS). By inhibiting the deoxynucleotide biosynthesis, FdUMP stops the rapidly proliferation of fast-growing tumors, and it is therefore widely used as a cancer treatment."},"fame":3,"pubchemCid":8642,"mass":326.17,"charge":0,"smiles":"C1[C@@H]([C@H](O[C@H]1N2C=C(C(=O)NC2=O)F)COP(=O)(O)O)O","inchikey":"HFEKDTCAMMOLQP-RRKCRQDMSA-N","iupac":"[(2R,3S,5R)-5-(5-fluoro-2,4-dioxopyrimidin-1-yl)-3-hydroxyoxolan-2-yl]methyl dihydrogen phosphate","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"8642","atoms":33,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-3.553,"y":-1.538,"z":0.156,"el":"P"},{"x":1.118,"y":-2.995,"z":-0.317,"el":"F"},{"x":-0.451,"y":1.329,"z":1.021,"el":"O"},{"x":-0.931,"y":4.146,"z":-0.076,"el":"O"},{"x":-2.761,"y":-0.205,"z":0.623,"el":"O"},{"x":3.607,"y":1.753,"z":0.392,"el":"O"},{"x":-2.546,"y":-2.231,"z":-0.902,"el":"O"},{"x":-4.73,"y":-0.947,"z":-0.782,"el":"O"},{"x":-4.018,"y":-2.424,"z":1.274,"el":"O"},{"x":3.829,"y":-2.812,"z":-0.254,"el":"O"},{"x":1.602,"y":0.566,"z":0.198,"el":"N"},{"x":3.717,"y":-0.519,"z":0.071,"el":"N"},{"x":-1.027,"y":2.864,"z":-0.692,"el":"C"},{"x":-1.583,"y":1.853,"z":0.301,"el":"C"},{"x":0.359,"y":2.333,"z":-0.98,"el":"C"},{"x":0.757,"y":1.714,"z":0.35,"el":"C"},{"x":-2.289,"y":0.684,"z":-
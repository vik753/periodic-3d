{"version":"2026.10.11-r25","id":"Q5119443","formula":"C₁₄H₁₂ClNO₂","hill":"C14H12ClNO2","elements":["H","C","N","O","Cl"],"composition":{"C":14.0,"H":12.0,"N":1.0,"O":2.0,"Cl":1.0},"names":{"en":"Cicletanine"},"descriptions":{"en":"Cicletanine is a furopyridine compound (i.e., has a pyridine ring fused to a furan ring) that is approved in France for the treatment of hypertension. The drug is most commonly known as a diuretic drug, but has a broader range of cardiovascular and metabolic activity characterized extensively in the literature (see \"Mechanism\" below). Cicletanine was originated and in 1986 launched in France by Paris-based Ipsen, who in 2005 licensed marketing rights in France to Milan-based Recordati for several years (at least until 2010)."},"fame":5,"pubchemCid":54910,"mass":261.7,"charge":0,"smiles":"CC1=NC=C2C(OCC2=C1O)C3=CC=C(C=C3)Cl","inchikey":"CVKNDPRBJVBDSS-UHFFFAOYSA-N","iupac":"3-(4-chlorophenyl)-6-methyl-1,3-dihydrofuro[3,4-c]pyridin-7-ol","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"54910","atoms":30,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-5.503,"y":0.962,"z":-1.168,"el":"Cl"},{"x":0.042,"y":-2.15,"z":0.583,"el":"O"},{"x":3.96,"y":-1.047,"z":-1.049,"el":"O"},{"x":2.319,"y":1.913,"z":0.358,"el":"N"},{"x":-0.24,"y":-0.821,"z":1.104,"el":"C"},{"x":0.918,"y":0.002,"z":0.668,"el":"C"},{"x":1.856,"y":-0.799,"z":0.044,"el":"C"},{"x":1.376,"y":-2.2,"z":0.022,"el":"C"},{"x":-1.544,"y":-0.378,"z":0.54,"el":"C"},{"x":3.035,"y":-0.27,"z":-0.438,"el":"C"},{"x":1.18,"y":1.344,"z":0.815,"el":"C"},{"x":3.213,"y":1.093,"z":-0.256,"el":"C"},{"x":-2.364,"y":0.488,"z":1.267,"el":"C"},{"x":-1.953,"y":-0.827,"z":-0.718,"el":"C"},{"x":4.462,"y":1.75,"z":-0.748,"el":"C"},{"x":-3.587,"y":0.902,"z":0.739,"el":"C"},{"x":-3.176,"y":-0.413,"z":-1.246,"el":"C"},{"x":-3.993,"y
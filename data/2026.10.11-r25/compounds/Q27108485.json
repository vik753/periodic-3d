{"version":"2026.10.11-r25","id":"Q27108485","formula":"C₃₂H₄₀N₂O₅S₂","hill":"C32H40N2O5S2","elements":["H","C","N","O","S"],"composition":{"C":32.0,"H":40.0,"N":2.0,"O":5.0,"S":2.0},"names":{"en":"Trimethaphan camsylate"},"descriptions":{"en":"Trimetaphan camsilate (INN) or trimethaphan camsylate (USAN), sold under the trade name Arfonad, is a sympatholytic drug that is infrequently used to lower blood pressure. Trimetaphan is a ganglionic blocker: it counteracts cholinergic transmission at α3β4 nicotinic acetylcholine receptors in the autonomic ganglia and, therefore, blocks both the sympathetic nervous system and the parasympathetic nervous system. It functions as a non-depolarizing competitive antagonist at the nicotinic receptor, has a short duration of action, and is administered intravenously."},"fame":8,"pubchemCid":44602409,"mass":596.8,"charge":0,"smiles":"CC1([C@@H]2CC[C@]1(C(=O)C2)CS(=O)(=O)[O-])C.C1CC2C3C(C[S+]2C1)N(C(=O)N3CC4=CC=CC=C4)CC5=CC=CC=C5","inchikey":"HALWUDBBYKMYPW-STOWLHSFSA-M","iupac":"3,5-dibenzyl-8-thionia-3,5-diazatricyclo[6.3.0.02,6]undecan-4-one;[(1S,4R)-7,7-dimethyl-2-oxo-1-bicyclo[2.2.1]heptanyl]methanesulfonate","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"rdkit","ref":"44602409","atoms":81,"license":"Computed with RDKit from SMILES (PubChem, Wikidata)"},"structure":{"kind":"molecule","atoms":[{"x":-0.521,"y":1.315,"z":1.405,"el":"C"},{"x":-0.622,"y":0.952,"z":-0.072,"el":"C"},{"x":0.649,"y":0.194,"z":-0.433,"el":"C"},{"x":0.769,"y":-1.199,"z":0.183,"el":"C"},{"x":2.256,"y":-1.392,"z":0.428,"el":"C"},{"x":2.609,"y":-0.265,"z":1.37,"el":"C"},{"x":2.029,"y":1.225,"z":0.417,"el":"S"},{"x":0.857,"y":1.914,"z":1.634,"el":"C"},{"x":2.302,"y":-2.78,"z":0.785,"el":"N"},{"x":1.311,"y":-3.433,"z":0.008,"el":"C"},{"x":1.2,"y":-4.635,"z":-0.165,"el":"O"},{"x":0.464,"y":-2.421,"z":-0.518,"el":"N"},{"x":-0.829,"y":
{"version":"2026.10.11-r25","id":"Q28209486","formula":"C₁₃H₁₄N₄O₄","hill":"C13H14N4O4","elements":["H","C","N","O"],"composition":{"C":13.0,"H":14.0,"N":4.0,"O":4.0},"names":{"en":"NITD008"},"descriptions":{"en":"NITD008 is an antiviral drug classified as an adenosine analog (a type of nucleoside analog). It was developed as a potential treatment for flavivirus infections and shows broad spectrum antiviral activity against many related viruses such as dengue virus, West Nile virus, yellow fever virus, Powassan virus, hepatitis C virus, Kyasanur Forest disease virus, Omsk hemorrhagic fever virus, and Zika virus. However, NITD008 proved too toxic in pre-clinical animal testing to be suitable for human trials, but it continues to be used in research to find improved treatments for emerging viral diseases."},"fame":4,"pubchemCid":44633776,"mass":290.27,"charge":0,"smiles":"C#C[C@]1([C@@H]([C@H](O[C@H]1N2C=CC3=C(N=CN=C32)N)CO)O)O","inchikey":"NKRAIOQPSBRMOV-NRMKKVEVSA-N","iupac":"(2R,3R,4R,5R)-2-(4-aminopyrrolo[2,3-d]pyrimidin-7-yl)-3-ethynyl-5-(hydroxymethyl)oxolane-3,4-diol","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"44633776","atoms":35,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-1.847,"y":-1.019,"z":0.904,"el":"O"},{"x":-2.17,"y":2.082,"z":1.086,"el":"O"},{"x":-3.855,"y":1.336,"z":-0.91,"el":"O"},{"x":-4.087,"y":-2.73,"z":0.715,"el":"O"},{"x":0.373,"y":-0.464,"z":0.139,"el":"N"},{"x":1.992,"y":0.851,"z":1.349,"el":"N"},{"x":4.285,"y":0.396,"z":0.669,"el":"N"},{"x":4.831,"y":-1.196,"z":-1.025,"el":"N"},{"x":-1.609,"y":1.226,"z":0.085,"el":"C"},{"x":-0.886,"y":0.062,"z":0.796,"el":"C"},{"x":-2.739,"y":0.508,"z":-0.642,"el":"C"},{"x":-3.097,"y":-0.588,"z":0.347,"el":"C"},{"x":-3.811,"y":-1.767,"z":-0.289,"el":"C"},{"x":1.652,"y":-0.069,"z":0.429,"el":"C"},{"x":-0.778,"y":2.028,"
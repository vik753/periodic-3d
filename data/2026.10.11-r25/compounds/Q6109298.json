{"version":"2026.10.11-r25","id":"Q6109298","formula":"C₂₇H₂₄N₂O₉","hill":"C27H24N2O9","elements":["H","C","N","O"],"composition":{"C":27.0,"H":24.0,"N":2.0,"O":9.0},"names":{"en":"JZL184"},"descriptions":{"en":"JZL184 is an irreversible inhibitor for monoacylglycerol lipase (MAGL), the primary enzyme responsible for degrading the endocannabinoid 2-arachidonoylglycerol (2-AG). It displays high selectivity for MAGL over other brain serine hydrolases, including the anandamide-degrading enzyme fatty acid amide hydrolase (FAAH), thereby making it a useful tool for studying the effects of endogenous 2-AG signaling, in vivo. Administration of JZL184 to mice was reported to cause dramatic elevation of brain 2-AG leading to several cannabinoid-related behavioral effects."},"fame":4,"pubchemCid":25021165,"mass":520.5,"charge":0,"smiles":"C1CN(CCC1C(C2=CC3=C(C=C2)OCO3)(C4=CC5=C(C=C4)OCO5)O)C(=O)OC6=CC=C(C=C6)[N+](=O)[O-]","inchikey":"SEGYOKHGGFKMCX-UHFFFAOYSA-N","iupac":"(4-nitrophenyl) 4-[bis(1,3-benzodioxol-5-yl)-hydroxymethyl]piperidine-1-carboxylate","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"25021165","atoms":62,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-1.716,"y":-0.021,"z":-1.513,"el":"O"},{"x":3.849,"y":-0.492,"z":0.675,"el":"O"},{"x":-4.801,"y":-3.966,"z":-1.793,"el":"O"},{"x":-4.635,"y":4.044,"z":-1.78,"el":"O"},{"x":-4.938,"y":-4.94,"z":0.407,"el":"O"},{"x":-5.804,"y":4.337,"z":0.307,"el":"O"},{"x":3.683,"y":1.809,"z":0.474,"el":"O"},{"x":10.102,"y":0.15,"z":0.096,"el":"O"},{"x":9.544,"y":-0.073,"z":-2.015,"el":"O"},{"x":1.823,"y":0.563,"z":1.099,"el":"N"},{"x":9.239,"y":-0.013,"z":-0.8,"el":"N"},{"x":-1.026,"y":0.206,"z":0.724,"el":"C"},{"x":-2.244,"y":-0.015,"z":-0.17,"el":"C"},{"x":-0.322,"y":1.525,"z":0.369,"el":"C"},{"x":-0.043,"y":-0.969,"z":0.608,"el":"C"},{"x":0.939
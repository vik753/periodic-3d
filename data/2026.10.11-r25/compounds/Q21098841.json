{"version":"2026.10.11-r25","id":"Q21098841","formula":"C₁₄H₁₂F₆N₂O","hill":"C14H12F6N2O","elements":["H","C","N","O","F"],"composition":{"C":14.0,"F":6.0,"H":12.0,"N":2.0,"O":1.0},"names":{"en":"LGD-4033"},"descriptions":{"en":"LGD-4033, also known by the developmental code name VK5211 and by the black-market name Ligandrol, is a selective androgen receptor modulator (SARM) which is under development for the treatment of muscle atrophy in people with hip fracture. It was also under development for the treatment of cachexia, hypogonadism, and osteoporosis, but development for these indications was discontinued. LGD-4033 has been reported to dose-dependently improve lean body mass and muscle strength in preliminary clinical trials, but is still being developed and has not been approved for medical use."},"fame":1,"pubchemCid":44137686,"mass":338.25,"charge":0,"smiles":"C1C[C@@H](N(C1)C2=CC(=C(C=C2)C#N)C(F)(F)F)[C@H](C(F)(F)F)O","inchikey":"OPSIVAKKLQRWKC-VXGBXAGGSA-N","iupac":"4-[(2R)-2-[(1R)-2,2,2-trifluoro-1-hydroxyethyl]pyrrolidin-1-yl]-2-(trifluoromethyl)benzonitrile","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"44137686","atoms":35,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-3.382,"y":-2.478,"z":1.442,"el":"F"},{"x":-4.398,"y":-1.351,"z":-0.121,"el":"F"},{"x":-2.567,"y":-2.446,"z":-0.582,"el":"F"},{"x":1.775,"y":-2.324,"z":-1.196,"el":"F"},{"x":3.706,"y":-1.383,"z":-1.531,"el":"F"},{"x":3.235,"y":-2.223,"z":0.412,"el":"F"},{"x":-3.066,"y":0.242,"z":1.734,"el":"O"},{"x":-1.155,"y":1.477,"z":-0.261,"el":"N"},{"x":5.424,"y":0.395,"z":0.866,"el":"N"},{"x":-2.18,"y":0.448,"z":-0.49,"el":"C"},{"x":-3.462,"y":1.263,"z":-0.742,"el":"C"},{"x":-2.946,"y":2.571,"z":-1.313,"el":"C"},{"x":-1.682,"y":2.821,"z":-0.499,"el":"C"},{"x":-2.376,"y":-0.469,"z":0.713,"el":"C"},{"x":0.187,"y":1.2
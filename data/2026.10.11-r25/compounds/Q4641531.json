{"version":"2026.10.11-r25","id":"Q4641531","formula":"C₁₃H₁₉N","hill":"C13H19N","elements":["H","C","N"],"composition":{"C":13.0,"H":19.0,"N":1.0},"names":{"en":"6-(2-aminopropyl)tetralin"},"descriptions":{"en":"6-(2-Aminopropyl)tetralin (6-APT), also sometimes called tetralinylaminopropane (TAP), is a drug of the amphetamine class which acts as a selective serotonin releasing agent (SSRA). It has IC50 values of 121 nM, 6,436 nM, and 3,371 nM for inhibiting the reuptake of serotonin, dopamine, and norepinephrine, respectively. Though it possesses an appreciable in vitro profile, in animal drug discrimination studies it was not found to substitute for MMAI or amphetamine and to only partially substitute for MBDB."},"fame":3,"pubchemCid":14964398,"mass":189.3,"charge":0,"smiles":"CC(CC1=CC2=C(CCCC2)C=C1)N","inchikey":"UTVKUFYOPJCDPE-UHFFFAOYSA-N","iupac":"1-(5,6,7,8-tetrahydronaphthalen-2-yl)propan-2-amine","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"14964398","atoms":33,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":4.798,"y":-0.139,"z":-0.204,"el":"N"},{"x":-1.142,"y":0.475,"z":0.247,"el":"C"},{"x":-2.079,"y":1.648,"z":0.391,"el":"C"},{"x":-3.413,"y":1.446,"z":-0.326,"el":"C"},{"x":-3.987,"y":0.072,"z":-0.005,"el":"C"},{"x":-3.052,"y":-1.027,"z":-0.507,"el":"C"},{"x":-1.608,"y":-0.796,"z":-0.138,"el":"C"},{"x":1.105,"y":-0.425,"z":0.468,"el":"C"},{"x":0.215,"y":0.645,"z":0.56,"el":"C"},{"x":2.546,"y":-0.228,"z":0.797,"el":"C"},{"x":-0.701,"y":-1.862,"z":-0.236,"el":"C"},{"x":0.647,"y":-1.677,"z":0.068,"el":"C"},{"x":3.406,"y":0.188,"z":-0.414,"el":"C"},{"x":3.267,"y":1.68,"z":-0.702,"el":"C"},{"x":-2.264,"y":1.806,"z":1.461,"el":"H"},{"x":-1.604,"y":2.555,"z":-0.001,"el":"H"},{"x":-4.116,"y":2.23,"z":-0.022,"el":"H"},{"x":-3.273,"y":1.541,"z":-1.41,"el":"H"},{"x":-4.973,"y":-0.04
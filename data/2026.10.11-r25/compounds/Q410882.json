{"version":"2026.10.11-r25","id":"Q410882","formula":"C₈H₄O₃","hill":"C8H4O3","elements":["H","C","O"],"composition":{"C":8.0,"H":4.0,"O":3.0},"names":{"en":"Phthalic anhydride","ru":"Фталевый ангидрид","uk":"Фталевий ангідрид"},"descriptions":{"en":"Phthalic anhydride is the organic compound with the formula C6H4(CO)2O. It is the anhydride of phthalic acid. Phthalic anhydride is a principal commercial form of phthalic acid. It was the first anhydride of a dicarboxylic acid to be used commercially.","ru":"Фталевый ангидрид — ангидрид о-фталевой кислоты.","uk":"Фта́левий ангідри́д — органічна сполука, ангідрид фталевої кислоти. Білі лускоподібні кристали. Його відносна молекулярна маса становить 148, температура плавлення — +130,8 °C, кипіння — +284,5 °C. Важко розчиняється у холодній, добре — у гарячій воді, утворюючи фталеву кислоту."},"fame":35,"pubchemCid":6811,"mass":148.11,"charge":0,"smiles":"C1=CC=C2C(=C1)C(=O)OC2=O","inchikey":"LGRFSURHDFAFJT-UHFFFAOYSA-N","iupac":"2-benzofuran-1,3-dione","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"6811","atoms":15,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-2.005,"y":0.0,"z":0.0,"el":"O"},{"x":-1.648,"y":2.29,"z":0.0,"el":"O"},{"x":-1.648,"y":-2.29,"z":0.0,"el":"O"},{"x":0.12,"y":0.685,"z":0.0,"el":"C"},{"x":0.12,"y":-0.685,"z":0.0,"el":"C"},{"x":1.291,"y":1.417,"z":0.0,"el":"C"},{"x":1.291,"y":-1.418,"z":0.0,"el":"C"},{"x":-1.252,"y":1.143,"z":0.0,"el":"C"},{"x":-1.252,"y":-1.143,"z":0.0,"el":"C"},{"x":2.492,"y":0.704,"z":0.0,"el":"C"},{"x":2.492,"y":-0.704,"z":0.0,"el":"C"},{"x":1.288,"y":2.501,"z":0.0,"el":"H"},{"x":1.288,"y":-2.501,"z":0.0,"el":"H"},{"x":3.438,"y":1.24,"z":0.0,"el":"H"},{"x":3.438,"y":-1.24,"z":0.001,"el":"H"}],"bonds":[[0,7,1],[0,8,1],[1,7,2],[2,8,2],[3,4,1],[3,5,2],[3,7,1],[4,6,2],[4,8,1],[5,9,1],[5,11,1],[6,10,
{"version":"2026.10.11-r25","id":"Q3639889","formula":"Y₈(UO₂)₁₆(CO₃)₁₆O₈(OH)₈·39H₂O","hill":"C16H86O135U16Y8","elements":["H","C","O","Y","U"],"composition":{"C":16.0,"H":86.0,"O":135.0,"U":16.0,"Y":8.0},"names":{"en":"Bijvoetite-(Y)"},"descriptions":{"en":"Bijvoetite-(Y) is a very rare rare-earth and uranium mineral with the formula (Y,REE)8(UO2)16(CO3)16O8(OH)8·39H2O. When compared to the original description, the formula of bijvoetite-(Y) was changed in the course of crystal structure redefinition. Bijvoetite-(Y) is an example of natural salts containing both uranium and yttrium, the other examples being kamotoite-(Y) and sejkoraite-(Y). Bijvoetite-(Y) comes from Shinkolobwe deposit in Republic of Congo, which is famous for rare uranium minerals."},"fame":5,"pubchemCid":null,"mass":null,"charge":0,"smiles":null,"inchikey":null,"iupac":null,"classes":[{"qid":"Q12089225","names":{"en":"mineral species","ru":"действительный вид минералов","uk":"мінеральний вид"}}],"structureInfo":null,"structure":null,"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q3639889","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Bijvoetite-%28Y%29","license":"CC BY-SA 4.0"}],"similar":[{"id":"Q1820045","formula":"CaGd₂(UO₂)₂₄(CO₃)₈Si₄O₂₈·60H₂O","names":{"en":"Lepersonnite-(Gd)","uk":"Леперсоніт-(Gd)"},"elements":["H","C","O","Si","Ca","Gd","U"],"fame":10,"kind":null},{"id":"Q58822285","formula":"[(UO₂)₂(C₂O₄)(OH)₂(H₂O)₂]·H₂O","names":{"en":"Uroxite"},"elements":["H","C","O","U"],"fame":5,"kind":null},{"id":"Q4008654","formula":"Al(UO₂)₂(VO₄)₂(OH)·8.5H₂O","names":{"en":"Vanuralite","ru":"Вануралит","uk":"Ванураніліт"},"elements":["H","O","Al","V","U"],"fame":11,"kind":null},{"id":"Q4024118","formula":"Ca(UO₂)(CO₃)₂*5H₂O","names":{"en":"Zellerite","uk":"Целерит"},"elements":["H","C","O","Ca","U"],"fame":10,"kind":null},{"id":"Q409662","formula":"HAl(UO₂)₄(PO₄)₄·16H₂O","names":{"en":"Sabugalite","ru"
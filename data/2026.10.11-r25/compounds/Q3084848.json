{"version":"2026.10.11-r25","id":"Q3084848","formula":"Ca₂FeB₂Si₂O₁₀","hill":"B2Ca2FeO10Si2","elements":["B","O","Si","Ca","Fe"],"composition":{"B":2.0,"O":10.0,"Ca":2.0,"Fe":1.0,"Si":2.0},"names":{"en":"Homilite"},"descriptions":{"en":"Homilite is a borosilicate mineral belonging to the gadolinite group of minerals with formula Ca2(Fe,Mg)B2Si2O10. It occurs as brown monoclinic crystals (space group P21/a) within feldspar masses in pegmatite and was discovered in 1876 in Stoko island, Langesundfiord, Norway. The name is from the Greek for to occur together, in allusion to its association with meliphanite and allanite."},"fame":10,"pubchemCid":null,"mass":null,"charge":0,"smiles":null,"inchikey":null,"iupac":null,"classes":[{"qid":"Q12089225","names":{"en":"mineral species","ru":"действительный вид минералов","uk":"мінеральний вид"}}],"structureInfo":null,"structure":null,"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q3084848","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Homilite","license":"CC BY-SA 4.0"}],"similar":[{"id":"Q1947524","formula":"CaFeAlSiO₆","names":{"en":"Esseneite"},"elements":["O","Al","Si","Ca","Fe"],"fame":8,"kind":null},{"id":"Q16062426","formula":"Ca₂(Fe₅Ti)O₂[Si₄Al₂O₁₈]","names":{"en":"Kuratite"},"elements":["O","Al","Si","Ca","Ti","Fe"],"fame":5,"kind":null},{"id":"Q3631339","formula":"Ca₂MnAl₂BSi₄O₁₅(OH)","names":{"en":"Axinite-(Mn)","uk":"Cевергініт"},"elements":["H","B","O","Al","Si","Ca","Mn"],"fame":5,"kind":null},{"id":"Q273663","formula":"Fe₃Al₂(SiO₄)₃","names":{"en":"Almandine","ru":"Альмандин","uk":"Альмандин"},"elements":["O","Al","Si","Fe"],"fame":47,"kind":"crystal"},{"id":"Q272844","formula":"{Ca₂}{Al₂Fe}(Si₂O₇)(SiO₄)O(OH)","names":{"en":"Epidote","ru":"Эпидот","uk":"Епідот"},"elements":["H","O","Al","Si","Ca","Fe"],"fame":43,"kind":"crystal"},{"id":"Q409071","formula":"CaMn₃Mn(Si₅O₁₅)","names":{"en":"Rhodonite","ru":"Родонит","uk":"
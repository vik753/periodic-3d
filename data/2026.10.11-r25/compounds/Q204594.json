{"version":"2026.10.11-r25","id":"Q204594","formula":"C₃₄H₃₂N₄O₄Zn","hill":"C34H32N4O4Zn","elements":["H","C","N","O","Zn"],"composition":{"C":34.0,"H":32.0,"N":4.0,"O":4.0,"Zn":1.0},"names":{"en":"Zinc protoporphyrin","ru":"Цинк-протопорфирин"},"descriptions":{"en":"Zinc protoporphyrin (ZPP) refers to coordination complexes of zinc and protoporphyrin IX. It is a red-purple solid that is soluble in water. The complex and related species are found in red blood cells when heme production is inhibited by lead and/or by lack of iron.","ru":"Цинк-протопорфирин (ЦПП) — соединение, обнаруживаемое в красных кровяных клетках, когда синтез гема ингибируется свинцом и/или недостатком ионов железа. Вместо слияния с ионом железа для формирования гема, протопорфирин IX, непосредственный предшественник гема, объединяется с ионом цинка, формируя ЦПП. Эта реакция катализируется ферментом феррохелатазой."},"fame":12,"pubchemCid":439935,"mass":626.0,"charge":0,"smiles":"CC1=C(C2=CC3=NC(=CC4=C(C(=C([N-]4)C=C5C(=C(C(=N5)C=C1[N-]2)C)C=C)C)C=C)C(=C3CCC(=O)O)C)CCC(=O)O.[Zn+2]","inchikey":"FUTVBRXUIKZACV-UHFFFAOYSA-L","iupac":"zinc 3-[18-(2-carboxyethyl)-8,13-bis(ethenyl)-3,7,12,17-tetramethylporphyrin-21,23-diid-2-yl]propanoic acid","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"rdkit","ref":"439935","atoms":75,"license":"Computed with RDKit from SMILES (PubChem, Wikidata)"},"structure":{"kind":"molecule","atoms":[{"x":-1.276,"y":3.685,"z":-2.164,"el":"C"},{"x":0.005,"y":3.27,"z":-1.559,"el":"C"},{"x":0.81,"y":2.156,"z":-1.937,"el":"C"},{"x":1.776,"y":2.089,"z":-0.943,"el":"C"},{"x":2.682,"y":0.833,"z":-0.598,"el":"C"},{"x":2.226,"y":-0.382,"z":-0.182,"el":"C"},{"x":0.965,"y":-0.886,"z":-0.045,"el":"N"},{"x":0.968,"y":-1.925,"z":0.845,"el":"C"},{"x":-0.035,"y":-2.537,"z":1.536,"el":"C"},{"x":-1.57,"y":-2.152,"z":1.493,"el":"C"},{"x":-2.533,"y":-2.624,"z":0.614
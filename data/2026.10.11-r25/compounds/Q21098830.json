{"version":"2026.10.11-r25","id":"Q21098830","formula":"C₂₄H₂₇NO₈S","hill":"C24H27NO8S","elements":["H","C","N","O","S"],"composition":{"C":24.0,"H":27.0,"N":1.0,"O":8.0,"S":1.0},"names":{"en":"RB-64"},"descriptions":{"en":"RB-64, also known as 22-thiocyanatosalvinorin A, is a semi-synthetic derivative of salvinorin A. It is an irreversible agonist, with a reactive thiocyanate group that forms a bond to the κ-opioid receptor (KOR), resulting in very high potency. It is functionally selective, activating G proteins more potently than β-arrestin-2. RB-64 has a bias factor of up to 96 and is analgesic with fewer of the side-effects associated with unbiased KOR agonists."},"fame":1,"pubchemCid":73347341,"mass":489.5,"charge":0,"smiles":"C[C@@]12CC[C@H]3C(=O)O[C@@H](C[C@@]3([C@H]1C(=O)[C@H](C[C@H]2C(=O)OC)OC(=O)CSC#N)C)C4=COC=C4","inchikey":"AZPUAKGNQXURGA-ZWLNRFIDSA-N","iupac":"methyl (2S,4aR,6aR,7R,9S,10aS,10bR)-2-(furan-3-yl)-6a,10b-dimethyl-4,10-dioxo-9-(2-thiocyanatoacetyl)oxy-2,4a,5,6,7,8,9,10a-octahydro-1H-benzo[f]isochromene-7-carboxylate","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"rdkit","ref":"73347341","atoms":61,"license":"Computed with RDKit from SMILES (PubChem, Wikidata)"},"structure":{"kind":"molecule","atoms":[{"x":-0.444,"y":-1.848,"z":-2.33,"el":"C"},{"x":-0.473,"y":-1.669,"z":-0.792,"el":"C"},{"x":0.412,"y":-2.767,"z":-0.144,"el":"C"},{"x":1.918,"y":-2.522,"z":-0.274,"el":"C"},{"x":2.31,"y":-1.153,"z":0.293,"el":"C"},{"x":3.812,"y":-0.955,"z":0.343,"el":"C"},{"x":4.613,"y":-1.858,"z":0.136,"el":"O"},{"x":4.225,"y":0.263,"z":0.76,"el":"O"},{"x":3.472,"y":1.475,"z":0.528,"el":"C"},{"x":1.956,"y":1.263,"z":0.407,"el":"C"},{"x":1.589,"y":0.008,"z":-0.425,"el":"C"},{"x":0.045,"y":-0.26,"z":-0.325,"el":"C"},{"x":-0.876,"y":0.836,"z":-0.881,"el":"C"},{"x":-0.464,"y":1.78,"z":-1.55,"el":"O"},{"x":-2.347,"y":0.703,"z":-0.475,"
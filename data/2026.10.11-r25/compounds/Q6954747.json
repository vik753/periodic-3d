{"version":"2026.10.11-r25","id":"Q6954747","formula":"C₂₃H₂₈N₂O","hill":"C23H28N2O","elements":["H","C","N","O"],"composition":{"C":23.0,"H":28.0,"N":2.0,"O":1.0},"names":{"en":"NMP-7"},"descriptions":{"en":"NMP-7 is a drug which acts as both a non-selective agonist of the CB1 and CB2 cannabinoid receptors, and also as a blocker of T-type calcium channels, the target of anticonvulsant drugs such as ethosuximide. NMP-7 has an agonist EC50 of 96.9nM at CB1 and 10.5nM at CB2, and an IC50 of 1.84μM for blocking Cav3.2 T-type calcium channels. In animal studies it produces potent analgesic effects in a variety of different tests."},"fame":4,"pubchemCid":46871949,"mass":348.5,"charge":0,"smiles":"CCCCCN1C2=C(C=C(C=C2)C(=O)N3CCCCC3)C4=CC=CC=C41","inchikey":"NZEVKZAEMSMLMC-UHFFFAOYSA-N","iupac":"(9-pentylcarbazol-3-yl)-piperidin-1-ylmethanone","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"46871949","atoms":54,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":3.753,"y":0.032,"z":2.351,"el":"O"},{"x":4.01,"y":0.894,"z":0.193,"el":"N"},{"x":-2.21,"y":-0.388,"z":0.599,"el":"N"},{"x":5.404,"y":0.829,"z":-2.334,"el":"C"},{"x":6.09,"y":0.413,"z":-1.032,"el":"C"},{"x":3.892,"y":0.627,"z":-2.249,"el":"C"},{"x":5.462,"y":1.115,"z":0.169,"el":"C"},{"x":3.308,"y":1.318,"z":-1.019,"el":"C"},{"x":-0.908,"y":-0.014,"z":0.835,"el":"C"},{"x":-0.096,"y":-1.085,"z":0.462,"el":"C"},{"x":-3.366,"y":0.449,"z":0.855,"el":"C"},{"x":-2.267,"y":-1.662,"z":0.086,"el":"C"},{"x":-0.955,"y":-2.127,"z":-0.011,"el":"C"},{"x":3.284,"y":0.378,"z":1.268,"el":"C"},{"x":1.83,"y":0.236,"z":1.117,"el":"C"},{"x":-3.61,"y":1.515,"z":-0.219,"el":"C"},{"x":1.301,"y":-0.955,"z":0.608,"el":"C"},{"x":-0.394,"y":1.183,"z":1.347,"el":"C"},{"x":-4.888,"y":2.324,"z":0.02,"el":"C"},{"x":0.993,"y":1.288,"z":1.48,"el":"C"},{"x":-3.373,"y":-2.43
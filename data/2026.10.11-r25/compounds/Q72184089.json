{"version":"2026.10.11-r25","id":"Q72184089","formula":"C₂₆H₃₄F₃N₇O₄S","hill":"C26H34F3N7O4S","elements":["H","C","N","O","F","S"],"composition":{"C":26.0,"F":3.0,"H":34.0,"N":7.0,"O":4.0,"S":1.0},"names":{"en":"Elexacaftor"},"descriptions":{"en":"Elexacaftor is a medication that acts as cystic fibrosis transmembrane conductance regulator (CFTR) corrector, which means that it helps the CFTR protein fold correctly, increasing the amount of CFTR protein sent to the cell surface. It also appears to work as a CFTR potentiator, which means that it helps open any CFTR channel that have made its way onto the cell surface. It is available in a single pill with ivacaftor and tezacaftor; the fixed-dose combination, elexacaftor/tezacaftor/ivacaftor (brand name Trikafta), is used to treat people with cystic fibrosis who are homozygous for the f508del mutation."},"fame":3,"pubchemCid":134587348,"mass":597.7,"charge":0,"smiles":"C[C@H]1CC(N(C1)C2=C(C=CC(=N2)N3C=CC(=N3)OCC(C)(C)C(F)(F)F)C(=O)NS(=O)(=O)C4=CN(N=C4C)C)(C)C","inchikey":"MVRHVFSOIWFBTE-INIZCTEOSA-N","iupac":"N-(1,3-dimethylpyrazol-4-yl)sulfonyl-6-[3-(3,3,3-trifluoro-2,2-dimethylpropoxy)pyrazol-1-yl]-2-[(4S)-2,2,4-trimethylpyrrolidin-1-yl]pyridine-3-carboxamide","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"rdkit","ref":"134587348","atoms":75,"license":"Computed with RDKit from SMILES (PubChem, Wikidata)"},"structure":{"kind":"molecule","atoms":[{"x":3.39,"y":4.26,"z":-0.005,"el":"C"},{"x":2.031,"y":4.069,"z":-0.67,"el":"C"},{"x":2.122,"y":3.348,"z":-2.013,"el":"C"},{"x":1.924,"y":1.835,"z":-1.708,"el":"C"},{"x":1.52,"y":1.793,"z":-0.256,"el":"N"},{"x":1.103,"y":3.159,"z":0.13,"el":"C"},{"x":0.559,"y":0.831,"z":0.111,"el":"C"},{"x":0.915,"y":-0.357,"z":0.77,"el":"C"},{"x":-0.093,"y":-1.296,"z":1.048,"el":"C"},{"x":-1.412,"y":-1.041,"z":0.69,"el":"C"},{"x":-1.696,"y":0.165,"z":0.069,"el":"C
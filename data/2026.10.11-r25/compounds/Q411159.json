159","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Famotidine","license":"CC BY-SA 4.0"},{"role":"description","name":"Wikipedia (ru)","url":"https://ru.wikipedia.org/wiki/%D0%A4%D0%B0%D0%BC%D0%BE%D1%82%D0%B8%D0%B4%D0%B8%D0%BD","license":"CC BY-SA 4.0"},{"role":"description","name":"Wikipedia (uk)","url":"https://uk.wikipedia.org/wiki/%D0%A4%D0%B0%D0%BC%D0%BE%D1%82%D0%B8%D0%B4%D0%B8%D0%BD","license":"CC BY-SA 4.0"},{"role":"properties","name":"PubChem","url":"https://pubchem.ncbi.nlm.nih.gov/compound/3325","license":"PubChem (NIH), public data"},{"role":"structure","name":"PubChem 3D","url":"https://pubchem.ncbi.nlm.nih.gov/compound/3325#section=3D-Conformer","license":"PubChem (NIH), public data"}],"similar":[{"id":"Q3976824","formula":"C₉H₁₀N₄O₂S₂","names":{"en":"Sulfamethizole"},"elements":["H","C","N","O","S"],"fame":17,"kind":"molecule"},{"id":"Q3009984","formula":"C₁₈H₂₃N₉O₄S₃","names":{"en":"Cefotiam"},"elements":["H","C","N","O","S"],"fame":15,"kind":"molecule"},{"id":"Q408427","formula":"C₉H₉N₃O₂S₂","names":{"en":"Sulfathiazole","uk":"Сульфатіазол"},"elements":["H","C","N","O","S"],"fame":15,"kind":"molecule"},{"id":"Q5010983","formula":"C₈H₁₂N₄OS₂","names":{"en":"CGP 52608"},"elements":["H","C","N","O","S"],"fame":8,"kind":"molecule"},{"id":"Q6577324","formula":"C₇H₉N₃O₂S₂","names":{"en":"Sulfathiourea"},"elements":["H","C","N","O","S"],"fame":8,"kind":"molecule"},{"id":"Q6824062","formula":"C₅H₆N₂OS","names":{"en":"Methylthiouracil"},"elements":["H","C","N","O","S"],"fame":8,"kind":"molecule"},{"id":"Q7636179","formula":"C₉H₁₀N₄O₃S₂","names":{"en":"Sulfametrole","uk":"Сульфаметрол"},"elements":["H","C","N","O","S"],"fame":8,"kind":"molecule"},{"id":"Q5332065","formula":"C₁₄H₁₇BrN₆O₂S₃","names":{"en":"Ebrotidine"},"elements":["H","C","N","O","S","Br"],"fame":7,"kind":"molecule"}],"photo":null}
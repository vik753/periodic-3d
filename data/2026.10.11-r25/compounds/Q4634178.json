{"version":"2026.10.11-r25","id":"Q4634178","formula":"C₁₉H₂₁NO₄","hill":"C19H21NO4","elements":["H","C","N","O"],"composition":{"C":19.0,"H":21.0,"N":1.0,"O":4.0},"names":{"en":"3-O-acetylmorphine"},"descriptions":{"en":"3-Monoacetylmorphine (3-MAM) or 3-acetylmorphine is a less active metabolite of heroin (diacetylmorphine), the other two being morphine and more active 6-monoacetylmorphine (6-MAM). Because of the acetyl-group in 3-position, 3-MAM has relatively weak affinity to μ-opioid receptors. As 3-O-acetylmorphine-6-O-sulfate (C19H23NO7S), where 6-OH is changed to 6-O-SO3, it can act as a potent, centrally acting morphine derivative and has important analgesic properties."},"fame":5,"pubchemCid":5462504,"mass":327.4,"charge":0,"smiles":"CC(=O)OC1=C2C3=C(C[C@@H]4[C@H]5[C@]3(CCN4C)[C@@H](O2)[C@H](C=C5)O)C=C1","inchikey":"GMLREHXYJDLZOU-LEPYJNQMSA-N","iupac":"[(4R,4aR,7S,7aR,12bS)-7-hydroxy-3-methyl-2,4,4a,7,7a,13-hexahydro-1H-4,12-methanobenzofuro[3,2-e]isoquinolin-9-yl] acetate","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"5462504","atoms":45,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-1.22,"y":-0.814,"z":1.309,"el":"O"},{"x":-1.749,"y":-2.951,"z":-0.095,"el":"O"},{"x":-3.201,"y":1.233,"z":0.744,"el":"O"},{"x":-3.751,"y":-0.028,"z":-1.15,"el":"O"},{"x":3.79,"y":0.42,"z":0.362,"el":"N"},{"x":1.13,"y":-0.698,"z":0.679,"el":"C"},{"x":2.087,"y":-1.142,"z":-0.438,"el":"C"},{"x":2.948,"y":0.106,"z":-0.818,"el":"C"},{"x":-0.036,"y":-1.645,"z":1.047,"el":"C"},{"x":1.949,"y":-0.254,"z":1.907,"el":"C"},{"x":0.308,"y":0.441,"z":0.17,"el":"C"},{"x":2.083,"y":1.301,"z":-1.348,"el":"C"},{"x":3.026,"y":0.787,"z":1.558,"el":"C"},{"x":0.723,"y":1.42,"z":-0.715,"el":"C"},{"x":-0.343,"y":-2.728,"z":-0.02,"el":"C"},{"x":1.342,"y":-1.767,"z":-1.591,"el":"C"},{"x":-0.991,"y":0.343,"z":0.614,"e
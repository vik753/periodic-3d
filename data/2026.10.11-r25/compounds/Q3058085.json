{"version":"2026.10.11-r25","id":"Q3058085","formula":"C₂₁H₂₃N₃O₄","hill":"C21H23N3O4","elements":["H","C","N","O"],"composition":{"C":21.0,"H":23.0,"N":3.0,"O":4.0},"names":{"en":"Esmirtazapine"},"descriptions":{"en":"Esmirtazapine (ORG-50,081) is a tetracyclic antidepressant drug that was under development by Organon for the treatment of insomnia, and for vasomotor symptoms associated with menopause (such as hot flashes) . Esmirtazapine is the (S)-(+)-enantiomer of mirtazapine; it has similar overall pharmacology as mirtazapine, including inverse agonist actions at H1 and 5-HT2 receptors, and antagonist actions at α2-adrenergic receptors. Notably, esmirtazapine has a shorter half life )around 10 hours), compared to R-mirtazapine and racemic mixture, which has a half-life of 18–40 hours."},"fame":6,"pubchemCid":3085218,"mass":265.35,"charge":0,"smiles":"CN1CCN2[C@H](C1)C3=CC=CC=C3CC4=C2N=CC=C4","inchikey":"RONZAEMNMFQXRA-MRXNPFEDSA-N","iupac":"(7S)-5-methyl-2,5,19-triazatetracyclo[13.4.0.02,7.08,13]nonadeca-1(15),8,10,12,16,18-hexaene","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":null,"structure":null,"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q3058085","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Esmirtazapine","license":"CC BY-SA 4.0"},{"role":"properties","name":"PubChem","url":"https://pubchem.ncbi.nlm.nih.gov/compound/3085218","license":"PubChem (NIH), public data"}],"similar":[{"id":"Q104219","formula":"C₃₃H₃₆N₄O₆","names":{"en":"Bilirubin","ru":"Билирубин","uk":"Білірубін"},"elements":["H","C","N","O"],"fame":66,"kind":"molecule"},{"id":"Q422964","formula":"C₃₃H₃₄N₄O₆","names":{"en":"Biliverdin","ru":"Биливердин"},"elements":["H","C","N","O"],"fame":37,"kind":"molecule"},{"id":"Q410789","formula":"C₂₂H₂₂N₂O₄","names":{"en":"Ambrisentan"},"elements":["H","C
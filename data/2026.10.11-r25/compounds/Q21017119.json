{"version":"2026.10.11-r25","id":"Q21017119","formula":"C₃₁H₃₉NO₄S","hill":"C31H39NO4S","elements":["H","C","N","O","S"],"composition":{"C":31.0,"H":39.0,"N":1.0,"O":4.0,"S":1.0},"names":{"en":"Thienorphine"},"descriptions":{"en":"Thienorphine is a very potent, extremely long-acting, orally-active opioid analgesic with mixed agonist–antagonist properties which was developed by the Beijing Institute of Pharmacology and Toxicology as a potential non-addictive analgesic and treatment for opioid dependence. It is a high-affinity, balanced ligand of the μ- (Ki = 0.22 nM), δ- (Ki = 0.69 nM), and κ-opioid receptors (Ki = 0.14 nM), behaving as a partial agonist of the μ- (Emax = 19%–28%) and κ-opioid receptors (Emax = 65–75%) and as an antagonist of the δ-opioid receptor. It also possesses relatively low affinity for the nociceptin receptor (Ki = 36.5 nM), where it acts as an antagonist."},"fame":1,"pubchemCid":102212421,"mass":521.7,"charge":0,"smiles":"C[C@@](CCC1=CC=CS1)(C2C[C@]34CC[C@@]2(C5[C@@]36CCN([C@@H]4CC7=C6C(=C(C=C7)O)O5)CC8CC8)OC)O","inchikey":"WTGSHWLSWVFVAH-HRHGHGIZSA-N","iupac":"(1R,2S,6R,15R)-5-(cyclopropylmethyl)-16-[(2R)-2-hydroxy-4-thiophen-2-ylbutan-2-yl]-15-methoxy-13-oxa-5-azahexacyclo[13.2.2.12,8.01,6.02,14.012,20]icosa-8(20),9,11-trien-11-ol","classes":[{"qid":"Q59199015","names":{"en":"group of stereoisomers","ru":"группа стереоизомеров","uk":"група стереоізомерів"}}],"structureInfo":{"kind":"flat","source":"rdkit","ref":"102212421","atoms":76,"license":"Computed with RDKit from SMILES (PubChem, Wikidata)"},"structure":{"kind":"flat","atoms":[{"x":-1.662,"y":-3.543,"z":0.0,"el":"C"},{"x":-2.511,"y":-2.307,"z":0.0,"el":"C"},{"x":-3.803,"y":-1.545,"z":0.0,"el":"C"},{"x":-5.095,"y":-0.783,"z":0.0,"el":"C"},{"x":-6.387,"y":-0.021,"z":0.0,"el":"C"},{"x":-6.53,"y":1.472,"z":0.0,"el":"C"},{"x":-7.995,"y":1.797,"z":0.0,"el":"C"},{"x":-8.757,"y":0.505,"z":0.0,"el":"C"},{"x":-7.763,"y":-0.619,"z":0.0,"el":"S"},{"x":-1.536,"y":-1.167,"z":0.0,"el":"C"},{"x":-0.
{"version":"2026.10.11-r25","id":"Q421375","formula":"C₂₀H₃₄O₅","hill":"C20H34O5","elements":["H","C","O"],"composition":{"C":20.0,"H":34.0,"O":5.0},"names":{"en":"Prostaglandin F2α"},"descriptions":{"en":"Prostaglandin F2α (PGF2α in prostanoid nomenclature), pharmaceutically termed carboprost , is a naturally occurring prostaglandin used in medicine to induce labor and as an abortifacient. Prostaglandins are lipids throughout the entire body that have a hormone-like function. In pregnancy, PGF2α is medically used to sustain contracture and provoke myometrial ischemia to accelerate labor and prevent significant blood loss in labor."},"fame":12,"pubchemCid":5280363,"mass":354.5,"charge":0,"smiles":"CCCCC[C@@H](/C=C/[C@H]1[C@@H](C[C@@H]([C@@H]1C/C=C\\CCCC(=O)O)O)O)O","inchikey":"PXGPLTODNUVGFL-YNNPMVKQSA-N","iupac":"(Z)-7-[(1R,2R,3R,5S)-3,5-dihydroxy-2-[(E,3S)-3-hydroxyoct-1-enyl]cyclopentyl]hept-5-enoic acid","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"5280363","atoms":59,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-4.015,"y":-0.417,"z":1.991,"el":"O"},{"x":-4.261,"y":2.232,"z":-0.396,"el":"O"},{"x":0.618,"y":4.449,"z":-1.371,"el":"O"},{"x":2.816,"y":-1.712,"z":-2.867,"el":"O"},{"x":0.613,"y":-1.373,"z":-2.442,"el":"O"},{"x":-2.101,"y":-0.487,"z":0.45,"el":"C"},{"x":-2.22,"y":1.003,"z":0.084,"el":"C"},{"x":-3.557,"y":-0.877,"z":0.725,"el":"C"},{"x":-3.516,"y":1.072,"z":-0.746,"el":"C"},{"x":-4.328,"y":-0.186,"z":-0.399,"el":"C"},{"x":-1.168,"y":-0.75,"z":1.627,"el":"C"},{"x":-1.041,"y":1.533,"z":-0.663,"el":"C"},{"x":-1.038,"y":-2.176,"z":2.083,"el":"C"},{"x":-0.294,"y":2.565,"z":-0.244,"el":"C"},{"x":0.891,"y":3.096,"z":-1.001,"el":"C"},{"x":-0.187,"y":-3.103,"z":1.618,"el":"C"},{"x":2.179,"y":3.098,"z":-0.167,"el":"C"},{"x":2.545,"y":1.716,"z":0.384,"el":"C"},{"x":0.807,"y":-2
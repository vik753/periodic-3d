{"version":"2026.10.11-r25","id":"Q3712675","formula":"{CaCe}{MgAlMg}(Si₂O₇)(SiO₄)(OH)F","hill":"AlCaCeFHMg2O12Si3","elements":["H","O","F","Mg","Al","Si","Ca","Ce"],"composition":{"F":1.0,"H":1.0,"O":12.0,"Al":1.0,"Ca":1.0,"Ce":1.0,"Mg":2.0,"Si":3.0},"names":{"en":"Dollaseite-(Ce)"},"descriptions":{"en":"Dollaseite-(Ce) is a sorosilicate end-member epidote rare-earth mineral which was discovered by Per Geijer (1927) in the Ostanmossa mine (Östanmossa gruva), Norberg district, Sweden. Dollaseite-(Ce), although not very well known, is part of a broad epidote group of minerals which are primarily silicates, the most abundant type of minerals on earth. Dollaseite-(Ce) forms as dark-brown subhedral crystals primarily in Swedish mines."},"fame":7,"pubchemCid":null,"mass":null,"charge":0,"smiles":null,"inchikey":null,"iupac":null,"classes":[{"qid":"Q12089225","names":{"en":"mineral species","ru":"действительный вид минералов","uk":"мінеральний вид"}}],"structureInfo":null,"structure":null,"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q3712675","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Dollaseite-%28Ce%29","license":"CC BY-SA 4.0"},{"role":"photo","name":"Wikimedia Commons","url":"https://commons.wikimedia.org/wiki/File:Dollaseite-(Ce).jpg","license":"CC BY-SA 4.0"}],"similar":[{"id":"Q2056968","formula":"NaCa₂(Mg₄Al)(Si₆Al₂)O₂₂(OH)₂","names":{"en":"Pargasite","uk":"Паргасит"},"elements":["H","O","Na","Mg","Al","Si","Ca"],"fame":16,"kind":null},{"id":"Q1372252","formula":"Na₂Be₂Si₆O₁₅·H₂O","names":{"en":"Eudidymite","ru":"Эвдидимит"},"elements":["H","Be","O","Na","Si"],"fame":8,"kind":"crystal"},{"id":"Q3613400","formula":"NaCaNa(Mg₃Al₂)Al₂Si₆O₂₂(OH)₂","names":{"en":"Taramite","ru":"Тарамит","uk":"Тараміт"},"elements":["H","O","Na","Mg","Al","Si","Ca"],"fame":7,"kind":null},{"id":"Q3614342","formula":"Ca₃(BeOH)₂Si₃O₁₀","names":{"en":"Aminoffite"},"elements":["H","Be","O","S
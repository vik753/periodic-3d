{"version":"2026.10.11-r25","id":"Q3643873","formula":"C₁₆H₁₄O₅","hill":"C16H14O5","elements":["H","C","O"],"composition":{"C":16.0,"H":14.0,"O":5.0},"names":{"en":"Brazilin"},"descriptions":{"en":"Brazilin is a naturally occurring, homoisoflavonoid, red dye obtained from the wood of Paubrasilia echinata, Biancaea sappan, Caesalpinia violacea, and Haematoxylum brasiletto (also known as Natural Red 24 and CI 75280). Brazilin has been used since at least the Middle Ages to dye fabric, and has been used to make paints and inks as well. The specific color produced by the pigment depends on its manner of preparation: in an acidic solution brazilin will appear yellow, but in an alkaline preparation it will appear red."},"fame":14,"pubchemCid":73384,"mass":286.28,"charge":0,"smiles":"C1C2=CC(=C(C=C2[C@H]3[C@@]1(COC4=C3C=CC(=C4)O)O)O)O","inchikey":"UWHUTZOCTZJUKC-JKSUJKDBSA-N","iupac":"(6aS,11bR)-7,11b-dihydro-6H-indeno[2,1-c]chromene-3,6a,9,10-tetrol","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"73384","atoms":35,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":0.454,"y":-2.996,"z":-1.396,"el":"O"},{"x":-2.188,"y":-1.768,"z":0.818,"el":"O"},{"x":3.664,"y":2.515,"z":-0.777,"el":"O"},{"x":4.714,"y":0.98,"z":1.283,"el":"O"},{"x":-4.682,"y":2.255,"z":0.833,"el":"O"},{"x":-0.102,"y":-2.104,"z":-0.424,"el":"C"},{"x":-0.166,"y":-0.665,"z":-1.014,"el":"C"},{"x":0.825,"y":-2.06,"z":0.815,"el":"C"},{"x":1.141,"y":-0.095,"z":-0.515,"el":"C"},{"x":1.688,"y":-0.877,"z":0.507,"el":"C"},{"x":-1.493,"y":-2.626,"z":-0.086,"el":"C"},{"x":-1.389,"y":0.09,"z":-0.547,"el":"C"},{"x":-2.306,"y":-0.486,"z":0.346,"el":"C"},{"x":1.804,"y":1.04,"z":-0.96,"el":"C"},{"x":2.878,"y":-0.526,"z":1.126,"el":"C"},{"x":-1.639,"y":1.393,"z":-1.005,"el":"C"},{"x":3.008,"y":1.399,"z":-0.35,"el":"C"},{"x":3.54,"y":0.622,"z":0.69,
{"version":"2026.10.11-r25","id":"Q82896529","formula":"C₁₁H₁₃N₃O₅","hill":"C11H13N3O5","elements":["H","C","N","O"],"composition":{"C":11.0,"H":13.0,"N":3.0,"O":5.0},"names":{"en":"5-ethynyl-1-pentofuranosyl-1H-imidazole-4-carboximidic acid"},"descriptions":{"en":"EICAR (5-ethynyl-1-β-D-ribofuranosylimidazole-4-carboxamide) is a nucleoside analogue which has both anti-cancer and antiviral effects, and was originally developed for the treatment of leukemia, but was unsuccessful in human clinical trials. It has broad spectrum antiviral effects with activity against pox viruses, Semliki forest virus, Junin virus, reovirus, influenza, measles virus and respiratory syncytial virus among others, although it is not active against coronaviridae such as SARS-CoV-1. This useful spectrum of activity means that EICAR and related derivatives continue to be investigated for the treatment of viral diseases."},"fame":2,"pubchemCid":453180,"mass":267.24,"charge":0,"smiles":"C#CC1=C(N=CN1[C@H]2[C@@H]([C@@H]([C@H](O2)CO)O)O)C(=O)N","inchikey":"SWQQELWGJDXCFT-PNHWDRBUSA-N","iupac":"1-[(2R,3R,4S,5R)-3,4-dihydroxy-5-(hydroxymethyl)oxolan-2-yl]-5-ethynylimidazole-4-carboxamide","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"453180","atoms":32,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":1.933,"y":-0.548,"z":-0.964,"el":"O"},{"x":1.239,"y":2.155,"z":1.301,"el":"O"},{"x":3.437,"y":2.018,"z":-0.291,"el":"O"},{"x":3.632,"y":-2.729,"z":-0.492,"el":"O"},{"x":-4.446,"y":0.523,"z":-0.097,"el":"O"},{"x":-0.274,"y":-0.238,"z":-0.149,"el":"N"},{"x":-1.754,"y":-1.84,"z":0.288,"el":"N"},{"x":-4.556,"y":-1.695,"z":0.417,"el":"N"},{"x":1.698,"y":0.876,"z":0.914,"el":"C"},{"x":3.158,"y":0.867,"z":0.507,"el":"C"},{"x":1.025,"y":0.395,"z":-0.363,"el":"C"},{"x":3.243,"y":-0.375,"z":-0.374,"el":"C"},{"x":3.588,"y":-1.635,"
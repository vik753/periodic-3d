{"version":"2026.10.11-r25","id":"Q4633072","formula":"C₁₂H₁₉NO₂","hill":"C12H19NO2","elements":["H","C","N","O"],"composition":{"C":12.0,"H":19.0,"N":1.0,"O":2.0},"names":{"en":"2CD-5EtO"},"descriptions":{"en":"2CD-5EtO, also known as 5-ethoxy-2-methoxy-4-methylphenethylamine, is a psychoactive drug of the phenethylamine, 2C, and TWEETIO families related to 2C-D. It is the analogue of 2C-D in which the methoxy group at the 5 position has been extended to an ethoxy group. In his book PiHKAL (Phenethylamines I Have Known and Loved) and other publications, Alexander Shulgin lists 2CD-5EtO's dose as 40 to 50 mg orally, its onset as slow and gradual, its time to peak or full effects as about 2 hours, and its duration as 12 hours."},"fame":3,"pubchemCid":57458864,"mass":209.28,"charge":0,"smiles":"CCOC1=CC(=C(C=C1C)OC)CCN","inchikey":"ZMQDQUPRBYFPSO-UHFFFAOYSA-N","iupac":"2-(5-ethoxy-2-methoxy-4-methylphenyl)ethanamine","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"rdkit","ref":"57458864","atoms":34,"license":"Computed with RDKit from SMILES (PubChem, Wikidata)"},"structure":{"kind":"molecule","atoms":[{"x":-4.196,"y":-2.334,"z":-0.682,"el":"C"},{"x":-2.733,"y":-1.93,"z":-0.688,"el":"C"},{"x":-2.643,"y":-0.601,"z":-0.179,"el":"O"},{"x":-1.402,"y":-0.024,"z":-0.122,"el":"C"},{"x":-0.208,"y":-0.653,"z":-0.483,"el":"C"},{"x":1.024,"y":0.021,"z":-0.393,"el":"C"},{"x":1.057,"y":1.345,"z":0.077,"el":"C"},{"x":-0.138,"y":1.972,"z":0.441,"el":"C"},{"x":-1.368,"y":1.299,"z":0.345,"el":"C"},{"x":-2.636,"y":2.004,"z":0.745,"el":"C"},{"x":2.296,"y":1.924,"z":0.146,"el":"O"},{"x":2.368,"y":3.275,"z":0.579,"el":"C"},{"x":2.293,"y":-0.71,"z":-0.782,"el":"C"},{"x":3.036,"y":-1.256,"z":0.443,"el":"C"},{"x":4.198,"y":-2.054,"z":0.05,"el":"N"},{"x":-4.788,"y":-1.649,"z":-1.298,"el":"H"},{"x":-4.606,"y":-2.285,"z":0.333,"el":"H"},{"x":-4.322,"y":-3.351,"z":-1.
{"version":"2026.10.11-r25","id":"Q19862033","formula":"NaCa₁₂(H₂O)₆₄(AsV₈.₅V₃.₅As₆O₅₁)₂·14H₂O","hill":"As14Ca12H156NaO180V24","elements":["H","O","Na","Ca","V","As"],"composition":{"H":156.0,"O":180.0,"V":24.0,"As":14.0,"Ca":12.0,"Na":1.0},"names":{"en":"Vanarsite"},"descriptions":{"en":"Vanarsite, NaCa12(As3+V4+3.5V5+8.5As5+6O51)2・78H2O, is a mineral that forms as very dark blue blades that are flattened on {100} and elongated on [010]. The crystals form in sub-parallel intergrowths in aggregates up to 5 mm long and are part of the cubic crystal system. The mineral is found in the Packrat mine in Colorado, USA in association with three mineral of similar composition, packratite, Ca11(As3+V4+2V5+10As5+6O51)2・83H2O, morrisonite, Ca6(As3+V4+2V5+10As5+6O51)2・78H2O, and gatewayite, Ca11(As3+V4+3V5+9As5+6O51)・31H2O. Vanarsite has been determined to be part of the vanadate, arsenite, and arsenate groups."},"fame":4,"pubchemCid":null,"mass":null,"charge":0,"smiles":null,"inchikey":null,"iupac":null,"classes":[{"qid":"Q12089225","names":{"en":"mineral species","ru":"действительный вид минералов","uk":"мінеральний вид"}}],"structureInfo":null,"structure":null,"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q19862033","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Vanarsite","license":"CC BY-SA 4.0"}],"similar":[{"id":"Q946311","formula":"Cu(UO₂)₂(PO₄)₂·8H₂O","names":{"en":"Metatorbernite","uk":"Метаторберніт"},"elements":["H","O","P","Cu","U"],"fame":12,"kind":"crystal"},{"id":"Q429570","formula":"Ba(UO₂)₂(AsO₄)₂·10H₂O","names":{"en":"Heinrichite","uk":"Гейнтрихіт"},"elements":["H","O","As","Ba","U"],"fame":11,"kind":null},{"id":"Q1067068","formula":"Cu(UO₂)₂(AsO₄)₂·8H₂O","names":{"en":"Metazeunerite","uk":"Метацейнерит"},"elements":["H","O","Cu","As","U"],"fame":9,"kind":"crystal"},{"id":"Q13098","formula":"Na₄Mg(V₁₀O₂₈)·24H₂O","names":{"en":"Huemulite","uk":"Х'юмаліт"},"elements"
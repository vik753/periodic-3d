{"version":"2026.10.11-r25","id":"Q19860990","formula":"Na₂Mn(SO₄)₂·4H₂O","hill":"H8MnNa2O12S2","elements":["H","O","Na","S","Mn"],"composition":{"H":8.0,"O":12.0,"S":2.0,"Mn":1.0,"Na":2.0},"names":{"en":"Manganoblödite"},"descriptions":{"en":"Manganoblödite is a rare manganese mineral with the formula Na2Mn(SO4)2·4H2O. Somewhat chemically similar mineral is D'Ansite-(Mn). Manganoblödite was found in the Blue Lizard mine, San Juan County, Utah, US, which is known for several relatively new secondary uranium minerals In the mine, manganoblödite occurs intimately intergrown with manganese-, cobalt- and nickel-enriched blödite and a yet another new mineral - cobaltoblödite. Manganoblödite, as suggested by its name is a manganese-analogue of blödite."},"fame":4,"pubchemCid":null,"mass":null,"charge":0,"smiles":null,"inchikey":null,"iupac":null,"classes":[{"qid":"Q12089225","names":{"en":"mineral species","ru":"действительный вид минералов","uk":"мінеральний вид"}}],"structureInfo":null,"structure":null,"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q19860990","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Manganobl%C3%B6dite","license":"CC BY-SA 4.0"},{"role":"photo","name":"Wikimedia Commons","url":"https://commons.wikimedia.org/wiki/File:Ottohahnite_%26_Manganobl%C3%B6dite_%26_Cobaltobl%C3%B6dite.jpg","license":"CC BY 4.0"}],"similar":[{"id":"Q82658","formula":"CaSO₄·2H₂O","names":{"en":"Gypsum","ru":"Гипс","uk":"Гіпс"},"elements":["H","O","S","Ca"],"fame":94,"kind":"crystal"},{"id":"Q429768","formula":"CaSO₄·2H₂O","names":{"en":"Selenite","ru":"Селенит","uk":"Селеніт"},"elements":["H","O","S","Ca"],"fame":30,"kind":"crystal"},{"id":"Q419103","formula":"Na₂Mg(SO₄)₂·4H₂O","names":{"en":"Blödite","ru":"Астраханит","uk":"Бльодит"},"elements":["H","O","Na","Mg","S"],"fame":17,"kind":"crystal"},{"id":"Q3666223","formula":"Na₂Zn(SO₄)₂·4H₂O","names":{"en":"Changoite","ru":"Чангоит"
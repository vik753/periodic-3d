{"version":"2026.10.11-r25","id":"Q408114","formula":"CaZnAsO₄(OH)","hill":"AsCaHO5Zn","elements":["H","O","Ca","Zn","As"],"composition":{"H":1.0,"O":5.0,"As":1.0,"Ca":1.0,"Zn":1.0},"names":{"en":"Austinite","uk":"Аустиніт"},"descriptions":{"en":"Austinite is a member of the adelite-descloizite group, adelite subgroup, the zinc (Zn) end member of the copper-Zn series with conichalcite. It is the zinc analogue of cobaltaustinite and nickelaustinite. At one time “brickerite” was thought to be a different species, but it is now considered to be identical to austinite.","uk":"Аустиніт є членом групи аделіту-деклуазиту, підгрупи аделіту, кінцевим (цинковим) членом Cu-Zn-ряду з коніхальцитом. Це цинковий аналог кобальто-аустиніту та нікело-аустиніту. У свій час «брикерит» вважався іншим видом, але тепер він вважається ідентичним аустиніту."},"fame":14,"pubchemCid":null,"mass":null,"charge":0,"smiles":null,"inchikey":null,"iupac":null,"classes":[{"qid":"Q12089225","names":{"en":"mineral species","ru":"действительный вид минералов","uk":"мінеральний вид"}}],"structureInfo":{"kind":"crystal","source":"materialsproject","ref":"mp-24018","atoms":36,"license":"CC BY 4.0, Materials Project"},"structure":{"cell":[[5.934,0.0,0.0],[0.0,7.489,0.0],[0.0,0.0,9.047]],"kind":"crystal","atoms":[{"x":0.143,"y":2.771,"z":7.484,"el":"Ca"},{"x":3.11,"y":0.973,"z":1.563,"el":"Ca"},{"x":5.791,"y":6.516,"z":6.086,"el":"Ca"},{"x":2.824,"y":4.718,"z":2.96,"el":"Ca"},{"x":1.528,"y":5.718,"z":8.991,"el":"Zn"},{"x":4.495,"y":5.515,"z":0.056,"el":"Zn"},{"x":4.405,"y":1.974,"z":4.579,"el":"Zn"},{"x":1.439,"y":1.771,"z":4.468,"el":"Zn"},{"x":5.836,"y":2.808,"z":1.591,"el":"As"},{"x":2.869,"y":0.937,"z":7.455,"el":"As"},{"x":0.098,"y":6.552,"z":2.932,"el":"As"},{"x":3.065,"y":4.681,"z":6.114,"el":"As"},{"x":5.809,"y":0.057,"z":8.874,"el":"H"},{"x":2.842,"y":3.688,"z":0.172,"el":"H"},{"x":0.124,"y":3.801,"z":4.696,"el":"H"},{"x":3.091,"y":7.432,"z":4.351,"el":"H"},{"x":5.888,"y":6.69,"z":8.396,"el":"O"},
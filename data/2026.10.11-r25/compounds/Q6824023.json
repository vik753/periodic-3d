{"version":"2026.10.11-r25","id":"Q6824023","formula":"C₁₄H₁₉NO₂","hill":"C14H19NO2","elements":["H","C","N","O"],"composition":{"C":14.0,"H":19.0,"N":1.0,"O":2.0},"names":{"en":"Methylketobemidone"},"descriptions":{"en":"Methylketobemidone is an opioid analgesic that is an analogue of ketobemidone. It was developed in the 1950s during research into analogues of pethidine and was assessed by the United Nations Office on Drugs and Crime but was not included on the list of drugs under international control, probably because it was not used in medicine or widely available. Methylketobemidone is so named because it is the methyl ketone analogue of bemidone (hydroxypethidine)."},"fame":3,"pubchemCid":47168,"mass":233.31,"charge":0,"smiles":"CC(=O)C1(CCN(CC1)C)C2=CC(=CC=C2)O","inchikey":"RNAGZQQIHXIDQH-UHFFFAOYSA-N","iupac":"1-[4-(3-hydroxyphenyl)-1-methylpiperidin-4-yl]ethanone","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"47168","atoms":36,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":1.166,"y":-2.308,"z":0.394,"el":"O"},{"x":-4.1,"y":-1.184,"z":-1.21,"el":"O"},{"x":3.277,"y":0.727,"z":-0.652,"el":"N"},{"x":0.495,"y":-0.018,"z":0.119,"el":"C"},{"x":1.074,"y":-0.202,"z":-1.307,"el":"C"},{"x":1.339,"y":1.062,"z":0.843,"el":"C"},{"x":2.597,"y":-0.379,"z":-1.331,"el":"C"},{"x":2.85,"y":0.819,"z":0.747,"el":"C"},{"x":-1.008,"y":0.301,"z":0.051,"el":"C"},{"x":0.645,"y":-1.312,"z":0.895,"el":"C"},{"x":4.728,"y":0.567,"z":-0.737,"el":"C"},{"x":-1.88,"y":-0.598,"z":-0.556,"el":"C"},{"x":-1.488,"y":1.489,"z":0.595,"el":"C"},{"x":0.129,"y":-1.317,"z":2.308,"el":"C"},{"x":-3.243,"y":-0.308,"z":-0.618,"el":"C"},{"x":-2.851,"y":1.78,"z":0.533,"el":"C"},{"x":-3.728,"y":0.881,"z":-0.073,"el":"C"},{"x":0.816,"y":0.677,"z":-1.915,"el":"H"},{"x":0.623,"y":-1.062,"z":-1.818,"el":"H"},{"x":1.066,"y":1.167
{"version":"2026.10.11-r25","id":"Q83039494","formula":"C₁₄H₁₆N₂","hill":"C14H16N2","elements":["H","C","N"],"composition":{"C":14.0,"H":16.0,"N":2.0},"names":{"en":"MTHPI"},"descriptions":{"en":"MTHPI, also known as 3-(1-methyl-1,2,3,6-tetrahydropyrid-4-yl)indole (3-MTPI), is a serotonin receptor modulator of the tetrahydropyridinylindole group related to the psychedelic drug dimethyltryptamine (DMT). Though it is not technically a tryptamine itself, MTHPI can be regarded as a constrained analogue of DMT. The drug shows affinity for the serotonin 5-HT1, 5-HT1A, and 5-HT2A receptors (Ki = 217 nM, 144 nM, and 71 nM, respectively). Its affinity for the serotonin 5-HT2A receptor was 8-fold higher than that of DMT. Besides serotonin receptors, MTHPI also shows affinity for the serotonin transporter (SERT) (IC50Tooltip half-maximal inhibitory concentration = 690 nM)."},"fame":1,"pubchemCid":152215,"mass":212.29,"charge":0,"smiles":"CN1CCC(=CC1)C2=CNC3=CC=CC=C32","inchikey":"IUENQRYBZHHPBN-UHFFFAOYSA-N","iupac":"3-(1-methyl-3,6-dihydro-2H-pyridin-4-yl)-1H-indole","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"152215","atoms":32,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":-3.866,"y":0.045,"z":-0.088,"el":"N"},{"x":2.169,"y":-1.993,"z":-0.116,"el":"N"},{"x":-1.709,"y":-0.097,"z":-1.263,"el":"C"},{"x":-1.058,"y":-0.395,"z":0.068,"el":"C"},{"x":-3.032,"y":0.672,"z":-1.118,"el":"C"},{"x":-3.212,"y":0.117,"z":1.228,"el":"C"},{"x":0.337,"y":-0.752,"z":0.009,"el":"C"},{"x":-1.76,"y":-0.275,"z":1.21,"el":"C"},{"x":1.46,"y":0.117,"z":0.032,"el":"C"},{"x":2.599,"y":-0.687,"z":-0.047,"el":"C"},{"x":0.801,"y":-2.042,"z":-0.082,"el":"C"},{"x":-5.193,"y":0.657,"z":-0.04,"el":"C"},{"x":1.621,"y":1.515,"z":0.112,"el":"C"},{"x":3.897,"y":-0.162,"z":-0.049,"el":"C"},{"x":2.913,"y":2.054,"z":0.112,"el":"C"
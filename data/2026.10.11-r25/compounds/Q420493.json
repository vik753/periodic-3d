{"version":"2026.10.11-r25","id":"Q420493","formula":"C₂H₃BrO","hill":"C2H3BrO","elements":["H","C","O","Br"],"composition":{"C":2.0,"H":3.0,"O":1.0,"Br":1.0},"names":{"en":"Acetyl bromide"},"descriptions":{"en":"Acetyl bromide is an acyl bromide compound. As is expected, it may be prepared by reaction between phosphorus tribromide and acetic acid: 3 CH3COOH + PBr3 → 3 CH3COBr + H3PO3 As usual for an acid halide, acetyl bromide hydrolyzes rapidly in water, forming acetic acid and hydrobromic acid. It also reacts with alcohols and amines to produce acetate esters and acetamides, respectively."},"fame":19,"pubchemCid":10482,"mass":122.95,"charge":0,"smiles":"CC(=O)Br","inchikey":"FXXACINHVKSMDR-UHFFFAOYSA-N","iupac":"acetyl bromide","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"10482","atoms":7,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":1.708,"y":-0.359,"z":0.0,"el":"Br"},{"x":-0.42,"y":1.284,"z":0.0,"el":"O"},{"x":-1.145,"y":-1.018,"z":0.0,"el":"C"},{"x":-0.142,"y":0.093,"z":0.001,"el":"C"},{"x":-1.022,"y":-1.626,"z":-0.899,"el":"H"},{"x":-2.155,"y":-0.599,"z":0.006,"el":"H"},{"x":-1.014,"y":-1.635,"z":0.892,"el":"H"}],"bonds":[[0,3,1],[1,3,2],[2,3,1],[2,4,1],[2,5,1],[2,6,1]]},"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q420493","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Acetyl_bromide","license":"CC BY-SA 4.0"},{"role":"properties","name":"PubChem","url":"https://pubchem.ncbi.nlm.nih.gov/compound/10482","license":"PubChem (NIH), public data"},{"role":"structure","name":"PubChem 3D","url":"https://pubchem.ncbi.nlm.nih.gov/compound/10482#section=3D-Conformer","license":"PubChem (NIH), public data"}],"similar":[{"id":"Q421152","formula":"C₂H₃IO","names":{"en":"Acetyl iodide"},"elem
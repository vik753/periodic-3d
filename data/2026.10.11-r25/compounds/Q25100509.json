{"version":"2026.10.11-r25","id":"Q25100509","formula":"C₂₇H₂₈N₂O₃","hill":"C27H28N2O3","elements":["H","C","N","O"],"composition":{"C":27.0,"H":28.0,"N":2.0,"O":3.0},"names":{"en":"AdipoRon"},"descriptions":{"en":"AdipoRon is a selective, orally active, synthetic small-molecule agonist of the adiponectin receptor 1 (AdipoR1) and adiponectin receptor 2 (AdipoR2) (Kd = 1.8 μM and 3.1 μM, respectively). It activates AMPK and PPARα signaling and ameliorates insulin resistance, dyslipidemia, and glucose intolerance in db/db mice (an animal model for type II diabetes and obesity). Moreover, AdipoRon has been found to extend the lifespans of db/db mice fed a high-fat diet, as well as improve exercise endurance."},"fame":1,"pubchemCid":16307093,"mass":428.5,"charge":0,"smiles":"C1CN(CCC1NC(=O)COC2=CC=C(C=C2)C(=O)C3=CC=CC=C3)CC4=CC=CC=C4","inchikey":"SHHUPGSHGSNPDB-UHFFFAOYSA-N","iupac":"2-(4-benzoylphenoxy)-N-(1-benzylpiperidin-4-yl)acetamide","classes":[{"qid":"Q113145171","names":{"en":"type of chemical entity","ru":"тип химического объекта","uk":"тип хімічної сутності"}}],"structureInfo":{"kind":"molecule","source":"pubchem","ref":"16307093","atoms":60,"license":"PubChem (NIH), public data"},"structure":{"kind":"molecule","atoms":[{"x":0.779,"y":-1.968,"z":-2.177,"el":"O"},{"x":-1.289,"y":-1.962,"z":-0.455,"el":"O"},{"x":-7.108,"y":-1.286,"z":1.958,"el":"O"},{"x":5.257,"y":0.893,"z":-0.366,"el":"N"},{"x":1.817,"y":-0.192,"z":-1.09,"el":"N"},{"x":2.982,"y":-0.099,"z":-1.941,"el":"C"},{"x":4.104,"y":-1.014,"z":-1.443,"el":"C"},{"x":3.484,"y":1.344,"z":-2.034,"el":"C"},{"x":4.764,"y":-0.477,"z":-0.17,"el":"C"},{"x":4.165,"y":1.802,"z":-0.742,"el":"C"},{"x":5.931,"y":1.373,"z":0.84,"el":"C"},{"x":7.338,"y":0.848,"z":0.942,"el":"C"},{"x":0.81,"y":-1.126,"z":-1.284,"el":"C"},{"x":7.588,"y":-0.358,"z":1.597,"el":"C"},{"x":8.394,"y":1.568,"z":0.382,"el":"C"},{"x":-0.283,"y":-0.994,"z":-0.245,"el":"C"},{"x":8.892,"y":-0.844,"z":1.691,"el":"C"},{"x":9.698,"y":1.082,"z":0.476,"el"
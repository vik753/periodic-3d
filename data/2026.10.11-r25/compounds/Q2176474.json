{"version":"2026.10.11-r25","id":"Q2176474","formula":"Fe₂Si₂O₅(OH)₄·2H₂O","hill":"Fe2H8O11Si2","elements":["H","O","Si","Fe"],"composition":{"H":8.0,"O":11.0,"Fe":2.0,"Si":2.0},"names":{"en":"Hisingerite","uk":"Гізингерит"},"descriptions":{"en":"Hisingerite is an iron(III) phyllosilicate mineral with formula FeIII2Si2O5(OH)4 · 2 H2O. A black or dark brown, lustrous secondary mineral, it is formed by the weathering or hydrothermal alteration of other iron silicate and sulfide minerals. It was first described in 1751 by A.F. Cronstedt from Väster Silvberg, Dalarna, Sweden (under the name “kolspeglande järnmalm”), and in 1810 by W. Hisinger from the Gillinge iron mine, Södermanland, Sweden (“svart stenart”, later “gillingit”). In 1828 it was found at an occurrence in Riddarhyttan, Vastmanland, Sweden.","uk":"Гізінгерит, гізінґерит (рос. гизингерит; англ. hisingerite; нім."},"fame":11,"pubchemCid":null,"mass":null,"charge":0,"smiles":null,"inchikey":null,"iupac":null,"classes":[{"qid":"Q12089225","names":{"en":"mineral species","ru":"действительный вид минералов","uk":"мінеральний вид"}}],"structureInfo":null,"structure":null,"sources":[{"role":"identity","name":"Wikidata","url":"https://www.wikidata.org/wiki/Q2176474","license":"CC0 1.0"},{"role":"description","name":"Wikipedia (en)","url":"https://en.wikipedia.org/wiki/Hisingerite","license":"CC BY-SA 4.0"},{"role":"description","name":"Wikipedia (uk)","url":"https://uk.wikipedia.org/wiki/%D0%93%D1%96%D0%B7%D1%96%D0%BD%D2%91%D0%B5%D1%80%D0%B8%D1%82","license":"CC BY-SA 4.0"},{"role":"photo","name":"Wikimedia Commons","url":"https://commons.wikimedia.org/wiki/File:Hisingerite-282352.jpg","license":"CC BY-SA 3.0"}],"similar":[{"id":"Q423458","formula":"Ca₂Fe(PO₄)₂·4H₂O","names":{"en":"Anapaite","ru":"Анапаит","uk":"Анапаїт"},"elements":["H","O","P","Ca","Fe"],"fame":16,"kind":"crystal"},{"id":"Q2251798","formula":"FePO₄*2H₂O","names":{"en":"Strengite","uk":"Штренгіт"},"elements":["H","O","P","Fe"],"fame":14,"kind":"cry